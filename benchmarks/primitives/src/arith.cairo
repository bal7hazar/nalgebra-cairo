    fn bench_arith_u512__u512_safe_div_rem_by_u256() {
        let a: u256 = black_box(
            0x400000000000000000000000000000400000000000000000000000000000063_u256,
        );
        let b: u256 = black_box(0x100000000000000000000000000000000010000000000000005_u256);
        let (q, r) = div_u512(
            black_box(
                u512 {
                    limb0: 0x6300000000000001ef,
                    limb1: 0x14000000000063040000000000000014,
                    limb2: 0x4000400000000000000,
                    limb3: 0x40000000000000000,
                },
            ),
            b,
        );
        let _ = a;
        assert!(
            q == u512 {
                limb0: 0x63, limb1: 0x4000000000000000000000000000004, limb2: 0x0, limb3: 0x0,
            },
        );
        assert!(r == 0x0_u256);
    }
