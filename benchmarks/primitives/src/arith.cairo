    #[test]
    #[inline(never)]
    fn bench_arith_u512__u256_wide_mul_then_div_rem_by_u256() {
        let a: u256 = black_box(
            0x400000000000000000000000000000400000000000000000000000000000063_u256,
        );
        let b: u256 = black_box(0x100000000000000000000000000000000010000000000000005_u256);
        let (q, r) = mul_div_u256(a, b, 0x20000000000000000000000000000004d_u256);
        assert!(
            q == u512 {
                limb0: 0x9fffffffffff0163300000000000008,
                limb1: 0x1b30200000000000000,
                limb2: 0x20000000000000000,
                limb3: 0x0,
            },
        );
        assert!(r == 0xfe0000000004c9b5a8ffffffffffff87_u256);
    }

