    fn bench_lookup_pow2__baseline() {
        let (a, b, c): (u32, u32, u32) = (black_box(3), black_box(31), black_box(63));
        assert!(a + b + c == 97);
    }

    #[test]
    #[inline(never)]
    fn bench_lookup_pow2__match_jump_table() {
        let (a, b, c): (u32, u32, u32) = (black_box(3), black_box(31), black_box(63));
        assert!(pow2_match(a) + pow2_match(b) + pow2_match(c) == EXPECTED);
    }

    #[test]
    #[inline(never)]
