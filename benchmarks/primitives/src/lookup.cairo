    let (k, b) = DivRem::div_rem(k, 2);
    if b == 1 {
        r *= 0x2;
    }
    let (k, b) = DivRem::div_rem(k, 2);
    if b == 1 {
        r *= 0x4;
    }
    let (k, b) = DivRem::div_rem(k, 2);
    if b == 1 {
        r *= 0x10;
    }
    let (k, b) = DivRem::div_rem(k, 2);
    if b == 1 {
        r *= 0x100;
    }
    let (k, b) = DivRem::div_rem(k, 2);
    if b == 1 {
        r *= 0x10000;
    }
    let (k, b) = DivRem::div_rem(k, 2);
    if b == 1 {
        r *= 0x100000000;
    }
    assert(k == 0, 'pow2 out of range');
    r.try_into().unwrap()
}

