fn matmul_n6_dynamic_full_result() {
    let a: Array<i64> = array![
        -3, 2, 0, -2, 3, 1, 0, -2, 3, 1, -1, -3, 3, 1, -1, -3, 2, 0, -1, -3, 2, 0, -2, 3, 2, 0, -2,
