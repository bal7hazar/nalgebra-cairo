#[test]
fn matmul_n4_dynamic_full_result() {
    let a: Array<i64> = array![-3, 2, 0, -2, 0, -2, 3, 1, 3, 1, -1, -3, -1, -3, 2, 0];
    let b: Array<i64> = array![-2, 1, -1, 2, 0, -2, 1, -1, 2, 0, -2, 1, -1, 2, 0, -2];
    let p: Array<i64> = array![8, -11, 5, -4, 5, 6, -8, 3, -5, -5, 0, 10, 6, 5, -6, 3];
    let idx = DMatIdx { data: a.span(), rows: 4, cols: 4 }
        .matmul(DMatIdx { data: b.span(), rows: 4, cols: 4 });
    let seq = DMatSeq { data: a.span(), rows: 4, cols: 4 }
        .matmul(DMatSeq { data: b.span(), rows: 4, cols: 4 });
    assert!(idx.data == p.span() && seq.data == p.span());
}

