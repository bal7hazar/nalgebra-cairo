fn to_h_matrix3(g: Matrix3<Fixed>) -> HMatrix3<Fixed> {
    HMatrix3 {
        m11: g.m11,
        m21: g.m21,
        m31: g.m31,
        m12: g.m12,
        m22: g.m22,
        m32: g.m32,
        m13: g.m13,
        m23: g.m23,
        m33: g.m33,
    }
}

