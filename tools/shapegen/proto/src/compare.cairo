/// Loser of the 2-D index: linear offset then one `match` (row checked first).
#[inline(always)]
fn alt_index_linear_matrix3(self: @Matrix3<Fixed>, index: (usize, usize)) -> Fixed {
    let (i, j) = index;
    if i >= 3 {
        core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS)
    }
    let index = i + j * 3;
    match index {
        0 => *self.m11,
        1 => *self.m21,
        2 => *self.m31,
        3 => *self.m12,
        4 => *self.m22,
        5 => *self.m32,
        6 => *self.m13,
        7 => *self.m23,
        8 => *self.m33,
        _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
    }
}

