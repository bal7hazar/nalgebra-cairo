#!/usr/bin/env bash
# Runs scripts/prepush.sh and blocks the push on failure. The owner sets core.hooksPath to .githooks (never set it from a script or an agent)
# git feeds "<local ref> <local sha> <remote ref> <remote sha>" lines on stdin. Deletion lines are skipped
# (a push of only deletions needs no check). The base the changes are compared against is the remote sha of
# the single pushed ref when it exists locally; when several refs are pushed, or the remote sha is unknown
# (a new branch), it is origin/main (the most conservative base: the widest set of changes is checked).
# The checks run on the working tree, so the hook refuses to run when it is not what is pushed: a pushed
# sha other than HEAD, or tracked files that differ from HEAD. A tag is compared by the commit it points at
# (an annotated tag has its own object sha); a tag whose commit is not HEAD is skipped with a message: a
# release tag points at an already-checked commit.
# Untracked files are refused too when they sit where they can change a build or a check (crates/, tests/,
# benchmarks/, tools/, scripts/, gas/, any Scarb.toml, Scarb.lock, .tool-versions): the build compiles them and
# CI, which does not have them, would fail (e.g. a never-added `.cairo` file behind a committed `mod foo;`).
# Files ignored by .gitignore are not listed by `git status` and stay allowed. Read-only: `git status` runs
# with --no-optional-locks, so it does not even refresh the index.
set -euo pipefail
cd "$(git rev-parse --show-toplevel)"
zero=0000000000000000000000000000000000000000
head=$(git rev-parse HEAD)
base=origin/main
refs=0
while read -r _ local_sha remote_ref remote_sha; do
    [[ "$local_sha" == "$zero" ]] && continue # a deletion
    peeled=$(git rev-parse --verify --quiet "$local_sha^{commit}" || echo "$local_sha")
    if [[ "$remote_ref" == refs/tags/* && "$peeled" != "$head" ]]; then
        echo "pre-push: $remote_ref points at $peeled, not HEAD: working-tree checks skipped for this tag" >&2
        continue
    fi
    refs=$((refs + 1))
    if [[ "$peeled" != "$head" ]]; then
        echo "pre-push: refusing: pushing $local_sha but HEAD is $head; the checks run on the working tree. Check out the branch you push." >&2
        exit 1
    fi
    if [[ "$refs" -eq 1 && "$remote_sha" != "$zero" ]] && git cat-file -e "$remote_sha^{commit}" 2> /dev/null; then
        base=$remote_sha
    else
        base=origin/main
    fi
done
[[ "$refs" -eq 0 ]] && exit 0 # only deletions
if ! git diff --quiet HEAD; then
    echo "pre-push: refusing: tracked files differ from HEAD; commit or stash, then push." >&2
    exit 1
fi
untracked=()
while IFS= read -r -d '' entry <&3; do
    [[ "$entry" == '?? '* ]] || continue
    path=${entry#'?? '}
    if [[ "$path" =~ ^(crates|tests|benchmarks|tools|scripts|gas)/ || "$path" =~ (^|/)Scarb\.toml$ || "$path" =~ ^(Scarb\.lock|\.tool-versions)$ ]]; then
        untracked+=("$path")
    fi
done 3< <(git --no-optional-locks status --porcelain --untracked-files=all -z)
if ! wait "$!"; then
    echo "pre-push: refusing: 'git status' failed, so untracked files cannot be checked." >&2
    exit 1
fi
if [[ ${#untracked[@]} -gt 0 ]]; then
    echo "pre-push: refusing: untracked files that can change a build or a check (CI will not have them):" >&2
    printf '  %s\n' "${untracked[@]}" >&2
    echo "pre-push: add or remove them, then push." >&2
    exit 1
fi
exec scripts/prepush.sh "$base"
