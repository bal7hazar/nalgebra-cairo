/// A singular matrix: not invertible, `solve` / `try_inverse` are `None`, `solve_mut` leaves its
/// argument unchanged, the determinant is exactly zero.
#[test]
fn test_full_piv_lu5_singular() {
    let z = black_box(
        mat5x5(
            [
                [0 * ONE, 1 * ONE, 2 * ONE, 3 * ONE, 4 * ONE],
                [1 * ONE, 2 * ONE, 3 * ONE, 4 * ONE, 5 * ONE],
                [2 * ONE, 3 * ONE, 4 * ONE, 5 * ONE, 6 * ONE],
                [3 * ONE, 4 * ONE, 5 * ONE, 6 * ONE, 7 * ONE],
                [4 * ONE, 5 * ONE, 6 * ONE, 7 * ONE, 8 * ONE],
            ],
        ),
    );
    let f = z.full_piv_lu();
    assert!(!f.is_invertible());
    assert!(f.try_inverse().is_none());
    assert!(f.solve(vec5((0 * ONE, 1 * ONE, 2 * ONE, 3 * ONE, 4 * ONE))).is_none());
    let mut b = vec5((0 * ONE, 1 * ONE, 2 * ONE, 3 * ONE, 4 * ONE));
    assert!(!f.solve_mut(ref b));
    assert!(b == vec5((0 * ONE, 1 * ONE, 2 * ONE, 3 * ONE, 4 * ONE)));
    assert!(f.determinant() == fx(0));
}

