/// `full_piv_lu1` (oracle): the packed factors within the oracle tolerance, the row and
/// column permutations EXACTLY upstream's (same pivots), `P A Q = L U` within the measured bound.
#[test]
fn test_oracle_full_piv_lu1() {
    let mut cases = oracle::full_piv_lu1_cases();
    let (mut ex, mut rec) = (0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, elu, ep, eq, tol) = *case;
        let a = black_box(mat1x1(a));
        let f = a.full_piv_lu();
        let (p, l, u, q) = f.unpack();
        assert!(p == f.p() && q == f.q() && l == f.l() && u == f.u() && f.lu_internal() == f.lu);
        let e = mat1x1(elu);
        ex = max(ex, excess(ulp_diff(f.lu.x, e.x), oracle_tol(abs_raw(e.x), tol)));
        let mut pv = vec1((0 * ONE,));
        p.permute_rows(ref pv);
        assert!(pv == vec1(ep), "row pivots");
        let mut qv = vec1((0 * ONE,));
        q.permute_rows(ref qv);
        assert!(qv == vec1(eq), "column pivots");
        let mut pa = a;
        p.permute_rows(ref pa);
        q.permute_columns(ref pa);
        rec = max(rec, max_ulp_1x1(l.mul_mat(u), pa) / amax_1x1(a));
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
    assert!(rec <= 0, "measured {}", rec);
}

