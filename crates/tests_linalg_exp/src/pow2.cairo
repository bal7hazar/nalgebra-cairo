/// `pow2` (oracle): every entry within the oracle tolerance; `pow_mut` agrees bit for bit.
#[test]
fn test_oracle_pow2() {
    let mut cases = oracle::pow2_cases();
    let mut ex = 0;
    while let Some(case) = cases.pop_front() {
        let (a, k, e, tol) = *case;
        let a = black_box(mat2x2(a));
