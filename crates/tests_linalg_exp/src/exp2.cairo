        let e = mat2x2(e);
        ex = max(ex, excess(ulp_diff(got.m11, e.m11), oracle_tol(abs_raw(e.m11), tol)));
        ex = max(ex, excess(ulp_diff(got.m12, e.m12), oracle_tol(abs_raw(e.m12), tol)));
        ex = max(ex, excess(ulp_diff(got.m21, e.m21), oracle_tol(abs_raw(e.m21), tol)));
        ex = max(ex, excess(ulp_diff(got.m22, e.m22), oracle_tol(abs_raw(e.m22), tol)));
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
}

