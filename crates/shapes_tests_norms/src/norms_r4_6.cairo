        a.try_normalize(fx(42414585895)).unwrap(),
        array![1976849923, 3337280033, 1292288997, -362036191, -1265025446].span(),
    );
    assert!(a.try_normalize(fx(42414585896)).is_none());
    assert_raws(
        a.cap_magnitude(fx(21207292949)),
