    assert_raws(
        a.normalize(),
        array![-1089586345, 38151232, -1662271258, -1361855067, 2667330940, -2350668171].span(),
    );
    assert_raws(
        a.try_normalize(fx(107546869556)).unwrap(),
        array![-1089586345, 38151232, -1662271258, -1361855067, 2667330940, -2350668171].span(),
    );
    assert!(a.try_normalize(fx(107546869557)).is_none());
    assert_raws(
        a.cap_magnitude(fx(53773434779)),
        array![-13641733738, 477657369, -20811808082, -17050566292, 33395259255, -29430608638]
            .span(),
    );
    assert_raws(
        a.cap_magnitude(fx(107546869557)),
        array![-27283467475, 955314739, -41623616163, -34101132583, 66790518511, -58861217275]
            .span(),
