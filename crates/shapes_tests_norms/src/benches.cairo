/// `Vector4::slerp` with upstream's angle, `acos(u · v)` and `sqrt(1 - (u · v)²)`, against the
/// library's Kahan half-angle form (`2 atan2(|u - v|, |u + v|)`).
fn alt_acos_slerp(a: Vector4<Fixed>, b: Vector4<Fixed>, t: Fixed) -> Vector4<Fixed> {
    let u = a.normalize();
    let v = b.normalize();
    let c = Real::sum_prod4(u.x, v.x, u.y, v.y, u.z, v.z, u.w, v.w);
    if c >= Real::one() {
        return u;
    }
    let hang = Transcendental::acos(c);
    let shang = Real::sqrt(Real::diff_prod(Real::one(), Real::one(), c, c));
    let ta = Real::div(Transcendental::sin((Real::one() - t) * hang), shang);
    let tb = Real::div(Transcendental::sin(t * hang), shang);
    Vector4 {
        x: Real::sum_prod2(u.x, ta, v.x, tb),
        y: Real::sum_prod2(u.y, ta, v.y, tb),
        z: Real::sum_prod2(u.z, ta, v.z, tb),
        w: Real::sum_prod2(u.w, ta, v.w, tb),
    }
}

/// `Matrix2x3::unscale` with one `Real::div` per component (the library: one `div6`).
fn alt_per_component_unscale(m: Matrix2x3<Fixed>, k: Fixed) -> Matrix2x3<Fixed> {
    Matrix2x3 {
        m11: Real::div(m.m11, k),
        m21: Real::div(m.m21, k),
        m12: Real::div(m.m12, k),
        m22: Real::div(m.m22, k),
        m13: Real::div(m.m13, k),
        m23: Real::div(m.m23, k),
    }
}

