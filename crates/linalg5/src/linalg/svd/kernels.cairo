                                    R::wide_zero(), if best == 3 {
                                        R::one()
                                    } else {
                                        R::zero()
                                    },
                                ),
                                a0,
                                u0.w,
                            ),
                            a1,
                            u1.w,
                        ),
                        a2,
                        u2.w,
                    ),
                    a3,
                    u3.w,
                ),
            ),
            a: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_add(
                                    R::wide_zero(), if best == 4 {
                                        R::one()
                                    } else {
                                        R::zero()
                                    },
                                ),
                                a0,
                                u0.a,
                            ),
                            a1,
                            u1.a,
                        ),
                        a2,
                        u2.a,
                    ),
                    a3,
                    u3.a,
                ),
            ),
        };
        {
            let (q0, q1, q2, q3, q4) = R::div5(
                r.x,
                r.y,
                r.z,
                r.w,
                r.a,
                R::wide_sqrt(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), r.x, r.x), r.y, r.y,
                                ),
                                r.z,
                                r.z,
                            ),
                            r.w,
                            r.w,
                        ),
                        r.a,
                        r.a,
                    ),
                ),
            );
            Vector5 { x: q0, y: q1, z: q2, w: q3, a: q4 }
        }
    }
}
