        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = uc2;
            let tmp2 = vr2;
            s2 = s3;
            uc2 = uc3;
            vr2 = vr3;
            s3 = tmp0;
            uc3 = tmp1;
            vr3 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = uc1;
            let tmp2 = vr1;
            s1 = s2;
            uc1 = uc2;
            vr1 = vr2;
            s2 = tmp0;
            uc2 = tmp1;
            vr2 = tmp2;
        }
        let u = Matrix4 {
            m11: uc0.x,
            m21: uc0.y,
            m31: uc0.z,
            m41: uc0.w,
            m12: uc1.x,
            m22: uc1.y,
            m32: uc1.z,
            m42: uc1.w,
            m13: uc2.x,
            m23: uc2.y,
            m33: uc2.z,
            m43: uc2.w,
            m14: uc3.x,
            m24: uc3.y,
            m34: uc3.z,
            m44: uc3.w,
        };
        let v_t = Matrix4x5 {
            m11: vr0.x,
            m21: vr1.x,
            m31: vr2.x,
            m41: vr3.x,
            m12: vr0.y,
            m22: vr1.y,
            m32: vr2.y,
            m42: vr3.y,
            m13: vr0.z,
            m23: vr1.z,
            m33: vr2.z,
            m43: vr3.z,
            m14: vr0.w,
            m24: vr1.w,
            m34: vr2.w,
            m44: vr3.w,
            m15: vr0.a,
            m25: vr1.a,
            m35: vr2.a,
            m45: vr3.a,
        };
        self =
            Svd4x5 {
                u: if has_u {
                    Some(u)
                } else {
                    None
                },
                singular_values: Vector4 { x: s0, y: s1, z: s2, w: s3 },
                v_t: if has_v {
                    Some(v_t)
                } else {
                    None
                },
            };
    }
}


/// Upstream's `Matrix` methods that go through the SVD, on `Matrix4x5`. Import `Matrix4x5SvdTrait`
/// to use them.
#[generate_trait]
pub impl Matrix4x5SvdImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix4x5SvdTrait<T> {
    /// The singular value decomposition, see `Svd4x5Trait::new`. Upstream: `Matrix::svd`.
    #[inline(always)]
    fn svd(self: Matrix4x5<T>, compute_u: bool, compute_v: bool) -> Svd4x5<T> {
        Svd4x5Trait::new(self, compute_u, compute_v)
    }

    /// `svd` (already sorted, see `Svd4x5Trait::new_unordered`). Upstream: `Matrix::svd_unordered`.
    #[inline(always)]
    fn svd_unordered(self: Matrix4x5<T>, compute_u: bool, compute_v: bool) -> Svd4x5<T> {
        Svd4x5Trait::new(self, compute_u, compute_v)
    }

    /// See `Svd4x5Trait::try_new`. Upstream: `Matrix::try_svd`.
    #[inline(always)]
    fn try_svd(
        self: Matrix4x5<T>, compute_u: bool, compute_v: bool, eps: T, max_niter: usize,
    ) -> Option<Svd4x5<T>> {
        Svd4x5Trait::try_new(self, compute_u, compute_v, eps, max_niter)
    }

    /// See `Svd4x5Trait::try_new_unordered`. Upstream: `Matrix::try_svd_unordered`.
    #[inline(always)]
    fn try_svd_unordered(
        self: Matrix4x5<T>, compute_u: bool, compute_v: bool, eps: T, max_niter: usize,
    ) -> Option<Svd4x5<T>> {
        Svd4x5Trait::try_new(self, compute_u, compute_v, eps, max_niter)
    }

    /// The singular values alone, DESCENDING: the decomposition without the left vectors
    /// (bit-identical to `svd(false, false).singular_values` and to the full decomposition's, and
    /// no dearer than the former: `bench_svd4x5_singular_values__*`). Upstream:
    /// `Matrix::singular_values`.
    fn singular_values(self: Matrix4x5<T>) -> Vector4<T> {
        {
            let t = Matrix5x4 {
                m11: self.m11,
                m21: self.m12,
                m31: self.m13,
                m41: self.m14,
                m51: self.m15,
                m12: self.m21,
                m22: self.m22,
                m32: self.m23,
                m42: self.m24,
                m52: self.m25,
                m13: self.m31,
                m23: self.m32,
                m33: self.m33,
                m43: self.m34,
                m53: self.m35,
                m14: self.m41,
                m24: self.m42,
                m34: self.m43,
                m44: self.m44,
                m54: self.m45,
            };
            Svd5x4InternalTrait::values_from_right(t, Svd5x4InternalTrait::right(t))
        }
    }

    /// `singular_values` (sorted; see `Svd4x5Trait::new_unordered`). Upstream:
    /// `Matrix::singular_values_unordered`.
    #[inline(always)]
    fn singular_values_unordered(self: Matrix4x5<T>) -> Vector4<T> {
        Self::singular_values(self)
    }

    /// The number of singular values strictly greater than `eps`, from `singular_values`.
    /// Upstream: `Matrix::rank` (which asserts `eps >= 0`; a negative `eps` counts every value
    /// here).
    fn rank(self: Matrix4x5<T>, eps: T) -> usize {
        let s = Self::singular_values(self);
        let mut n: usize = 0;
        if s.x > eps {
            n += 1;
        }
        if s.y > eps {
            n += 1;
        }
        if s.z > eps {
            n += 1;
        }
        if s.w > eps {
            n += 1;
        }
        n
    }

    /// The Moore-Penrose pseudo-inverse, see `Svd4x5Trait::pseudo_inverse`. Upstream:
    /// `Matrix::pseudo_inverse` (`Err` on a negative `eps`; `None` here).
    #[inline(always)]
    fn pseudo_inverse(self: Matrix4x5<T>, eps: T) -> Option<Matrix5x4<T>> {
        Svd4x5Trait::new(self, true, true).pseudo_inverse(eps)
    }

    /// The left polar decomposition `M = P · U`, see `Svd4x5Trait::to_polar`. Upstream:
    /// `Matrix::polar`.
    fn polar(self: Matrix4x5<T>) -> (Matrix4<T>, Matrix4x5<T>) {
        Svd4x5Trait::new(self, true, true).to_polar().unwrap()
    }

    /// `polar`, or `None` when the decomposition did not converge within `eps`, see
    /// `Svd4x5Trait::try_new`. Upstream: `Matrix::try_polar`.
    fn try_polar(
        self: Matrix4x5<T>, eps: T, max_niter: usize,
    ) -> Option<(Matrix4<T>, Matrix4x5<T>)> {
        match Svd4x5Trait::try_new(self, true, true, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
