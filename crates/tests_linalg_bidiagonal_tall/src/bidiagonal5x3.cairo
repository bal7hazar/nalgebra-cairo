        ex = max(ex, excess_all(vt, evt, tol));
        rec = max(rec, max_ulp_5x3(u.mul_mat(d).mul_mat(vt), a) / amax_5x3(a));
        orth = max(orth, max(orth_5x3(u), orth_3x3(vt)));
