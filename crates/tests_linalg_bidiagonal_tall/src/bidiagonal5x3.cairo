        let d1 = clear_column_unchecked(ref m, 1, 0, ref none);
        let e1 = clear_row_unchecked(ref m, ref packed, ref work, 1, 1);
        let d2 = clear_column_unchecked(ref m, 2, 0, ref none);
        assert!(
            m == bd.uv
