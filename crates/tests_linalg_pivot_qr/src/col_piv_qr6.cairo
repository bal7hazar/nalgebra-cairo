/// A singular matrix: not invertible, `solve` / `try_inverse` are `None`, `solve_mut` leaves its
/// argument unchanged.
#[test]
fn test_col_piv_qr6_singular() {
    let z = black_box(
        mat6x6(
            [
                [0 * ONE, 0, 0, 0, 0, 0], [1 * ONE, 0, 0, 0, 0, 0], [2 * ONE, 0, 0, 0, 0, 0],
                [3 * ONE, 0, 0, 0, 0, 0], [4 * ONE, 0, 0, 0, 0, 0], [5 * ONE, 0, 0, 0, 0, 0],
            ],
        ),
    );
    let f = z.col_piv_qr();
    assert!(!f.is_invertible());
    assert!(f.try_inverse().is_none());
    assert!(f.solve(vec6((0 * ONE, 1 * ONE, 2 * ONE, 3 * ONE, 4 * ONE, 5 * ONE))).is_none());
    let mut b = vec6((0 * ONE, 1 * ONE, 2 * ONE, 3 * ONE, 4 * ONE, 5 * ONE));
    assert!(!f.solve_mut(ref b));
    assert!(b == vec6((0 * ONE, 1 * ONE, 2 * ONE, 3 * ONE, 4 * ONE, 5 * ONE)));
}

