        assert!(f.col_piv_qr_internal() == f.col_piv_qr);
        let (eq, er) = (mat1x1(eq), mat1x1(er));
        ex = max(ex, excess(ulp_diff(q.x, eq.x), oracle_tol(abs_raw(eq.x), tol)));
        ex = max(ex, excess(ulp_diff(rr.x, er.x), oracle_tol(abs_raw(er.x), tol)));
