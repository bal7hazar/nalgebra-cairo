/// A singular matrix: not invertible, `solve` / `try_inverse` are `None`, `solve_mut` leaves its
/// argument unchanged.
#[test]
fn test_col_piv_qr1_singular() {
    let z = black_box(mat1x1([[0 * ONE]]));
    let f = z.col_piv_qr();
    assert!(!f.is_invertible());
    assert!(f.try_inverse().is_none());
    assert!(f.solve(vec1((0 * ONE,))).is_none());
    let mut b = vec1((0 * ONE,));
    assert!(!f.solve_mut(ref b));
    assert!(b == vec1((0 * ONE,)));
}

