                m44: R::zero(),
                m15: R::zero(),
                m25: R::zero(),
                m35: R::zero(),
                m45: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
