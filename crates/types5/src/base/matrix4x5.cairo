/// `iter.sum()` of an iterator of `Matrix4x5`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 4x5 matrix when empty. Upstream: `Sum for Matrix` (a fold
/// from `zero()`: the same result, one addition more).
pub impl Matrix4x5Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<Matrix4x5<T>> {
    fn sum<I, +Iterator<I>[Item: Matrix4x5<T>], +Destruct<I>, +Destruct<Matrix4x5<T>>>(
        mut iter: I,
    ) -> Matrix4x5<T> {
        let Option::Some(mut acc) = iter.next() else {
            return Matrix4x5 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m42: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m43: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
                m44: R::zero(),
                m15: R::zero(),
                m25: R::zero(),
                m35: R::zero(),
                m45: R::zero(),
            };
        };
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
        }
        acc
    }
}

