            m12: x01,
            m22: x11,
            m13: x02,
            m23: x12,
            m14: x03,
            m24: x13,
            m15: x04,
            m25: x14,
        }
    }

    #[inline(always)]
    fn nonzero_diagonal(self: Matrix2<T>) -> bool {
        self.m11 != R::zero() && self.m22 != R::zero()
    }

    #[inline(always)]
    fn is_zero(x: T) -> bool {
        x == R::zero()
    }

    #[inline(always)]
    fn tr_mul_rhs(self: Matrix2<T>, b: Matrix2x5<T>) -> Matrix2x5<T> {
