    }
}

/// `iter.sum()` of an iterator of `Matrix2x5`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 2x5 matrix when empty. Upstream: `Sum for Matrix` (a fold
/// from `zero()`: the same result, one addition more).
pub impl Matrix2x5Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<Matrix2x5<T>> {
    fn sum<I, +Iterator<I>[Item: Matrix2x5<T>], +Destruct<I>, +Destruct<Matrix2x5<T>>>(
        mut iter: I,
    ) -> Matrix2x5<T> {
        let Option::Some(mut acc) = iter.next() else {
            return Matrix2x5 {
                m11: R::zero(),
                m21: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m15: R::zero(),
                m25: R::zero(),
            };
        };
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
        }
        acc
    }
}

/// `*iter.sum()` of an iterator of snapshots `@Matrix2x5` (`span.into_iter()`): a snapshot of the
/// sum of the items, like `Sum<Matrix2x5>`. Upstream: `Sum<&Matrix> for Matrix` (references).
pub impl Matrix2x5SumSnapshot<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<@Matrix2x5<T>> {
    fn sum<I, +Iterator<I>[Item: @Matrix2x5<T>], +Destruct<I>, +Destruct<@Matrix2x5<T>>>(
        mut iter: I,
    ) -> @Matrix2x5<T> {
        let Option::Some(first) = iter.next() else {
            return @Matrix2x5 {
                m11: R::zero(),
                m21: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m15: R::zero(),
                m25: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
        }
        @acc
    }
}

