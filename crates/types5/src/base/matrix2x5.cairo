            m13: x02,
            m23: x12,
            m14: x03,
            m24: x13,
            m15: x04,
            m25: x14,
        }
    }

    fn lower_with_diag(self: Matrix2<T>, b: Matrix2x5<T>, diag: T) -> Matrix2x5<T> {
        let x00 = b.m11;
        let x01 = b.m12;
        let x02 = b.m13;
