    #[inline(always)]
    fn replace(self: Matrix3x5<T>, index: (usize, usize), v: T) -> Matrix3x5<T> {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => Matrix3x5 {
                    m11: v,
                    m21: self.m21,
                    m31: self.m31,
                    m12: self.m12,
                    m22: self.m22,
                    m32: self.m32,
                    m13: self.m13,
                    m23: self.m23,
                    m33: self.m33,
                    m14: self.m14,
                    m24: self.m24,
                    m34: self.m34,
                    m15: self.m15,
                    m25: self.m25,
                    m35: self.m35,
                },
                1 => Matrix3x5 {
                    m11: self.m11,
                    m21: v,
                    m31: self.m31,
                    m12: self.m12,
                    m22: self.m22,
                    m32: self.m32,
                    m13: self.m13,
                    m23: self.m23,
                    m33: self.m33,
                    m14: self.m14,
                    m24: self.m24,
                    m34: self.m34,
                    m15: self.m15,
                    m25: self.m25,
                    m35: self.m35,
                },
                2 => Matrix3x5 {
                    m11: self.m11,
                    m21: self.m21,
                    m31: v,
                    m12: self.m12,
                    m22: self.m22,
                    m32: self.m32,
                    m13: self.m13,
                    m23: self.m23,
                    m33: self.m33,
                    m14: self.m14,
                    m24: self.m24,
                    m34: self.m34,
                    m15: self.m15,
                    m25: self.m25,
                    m35: self.m35,
                },
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            1 => match i {
                0 => Matrix3x5 {
                    m11: self.m11,
                    m21: self.m21,
                    m31: self.m31,
                    m12: v,
                    m22: self.m22,
                    m32: self.m32,
                    m13: self.m13,
                    m23: self.m23,
                    m33: self.m33,
                    m14: self.m14,
                    m24: self.m24,
                    m34: self.m34,
                    m15: self.m15,
                    m25: self.m25,
                    m35: self.m35,
                },
                1 => Matrix3x5 {
                    m11: self.m11,
                    m21: self.m21,
                    m31: self.m31,
                    m12: self.m12,
                    m22: v,
                    m32: self.m32,
                    m13: self.m13,
                    m23: self.m23,
                    m33: self.m33,
                    m14: self.m14,
                    m24: self.m24,
                    m34: self.m34,
                    m15: self.m15,
                    m25: self.m25,
                    m35: self.m35,
                },
                2 => Matrix3x5 {
                    m11: self.m11,
                    m21: self.m21,
                    m31: self.m31,
                    m12: self.m12,
                    m22: self.m22,
                    m32: v,
                    m13: self.m13,
                    m23: self.m23,
                    m33: self.m33,
                    m14: self.m14,
                    m24: self.m24,
                    m34: self.m34,
                    m15: self.m15,
                    m25: self.m25,
                    m35: self.m35,
                },
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            2 => match i {
                0 => Matrix3x5 {
                    m11: self.m11,
                    m21: self.m21,
                    m31: self.m31,
                    m12: self.m12,
                    m22: self.m22,
                    m32: self.m32,
                    m13: v,
                    m23: self.m23,
                    m33: self.m33,
                    m14: self.m14,
                    m24: self.m24,
                    m34: self.m34,
                    m15: self.m15,
                    m25: self.m25,
                    m35: self.m35,
                },
                1 => Matrix3x5 {
                    m11: self.m11,
                    m21: self.m21,
                    m31: self.m31,
                    m12: self.m12,
                    m22: self.m22,
                    m32: self.m32,
                    m13: self.m13,
                    m23: v,
                    m33: self.m33,
                    m14: self.m14,
                    m24: self.m24,
                    m34: self.m34,
                    m15: self.m15,
                    m25: self.m25,
                    m35: self.m35,
                },
                2 => Matrix3x5 {
                    m11: self.m11,
                    m21: self.m21,
