//! Internal, no stability promise: the crate-private items of `base::matrix3x5` that the packages
//! above this one use (docs/SPLIT.md §12.3). Never re-exported by the facade `nalgebra`.

use nalgebra_core::base::errors;
use nalgebra_types3::base::vector3::Vector3;
use crate::base::matrix3x5::Matrix3x5;
use crate::base::row_vector5::RowVector5;

/// Private helpers of the `swap*` methods (runtime positions: one `match` each).
#[generate_trait]
