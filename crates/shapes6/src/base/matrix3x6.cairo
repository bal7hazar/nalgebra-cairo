/// `*iter.sum()` of an iterator of snapshots `@Matrix3x6` (`span.into_iter()`): a snapshot of the
/// sum of the items, like `Sum<Matrix3x6>`. Upstream: `Sum<&Matrix> for Matrix` (references).
pub impl Matrix3x6SumSnapshot<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<@Matrix3x6<T>> {
    fn sum<I, +Iterator<I>[Item: @Matrix3x6<T>], +Destruct<I>, +Destruct<@Matrix3x6<T>>>(
        mut iter: I,
    ) -> @Matrix3x6<T> {
        let Option::Some(first) = iter.next() else {
            return @Matrix3x6 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
                m15: R::zero(),
                m25: R::zero(),
                m35: R::zero(),
                m16: R::zero(),
                m26: R::zero(),
                m36: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
        }
        @acc
    }
}

