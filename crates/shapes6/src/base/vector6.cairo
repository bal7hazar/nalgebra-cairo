    ) -> @Vector6<T> {
        let Option::Some(first) = iter.next() else {
            return @Vector6 {
                x: R::zero(), y: R::zero(), z: R::zero(), w: R::zero(), a: R::zero(), b: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
        }
