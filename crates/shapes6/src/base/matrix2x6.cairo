/// The component-wise partial order: `a < b` when EVERY component of `a` is smaller than `b`'s
/// (likewise `<=`, `>`, `>=`), so two matrices may be unordered (`!(a < b) && !(a >= b)`).
/// Upstream: `PartialOrd for Matrix`.
pub impl Matrix2x6PartialOrd<T, +PartialOrd<T>, +Copy<T>, +Drop<T>> of PartialOrd<Matrix2x6<T>> {
    #[inline(always)]
    fn lt(lhs: Matrix2x6<T>, rhs: Matrix2x6<T>) -> bool {
        lhs.m11 < rhs.m11
            && lhs.m21 < rhs.m21
            && lhs.m12 < rhs.m12
            && lhs.m22 < rhs.m22
            && lhs.m13 < rhs.m13
            && lhs.m23 < rhs.m23
            && lhs.m14 < rhs.m14
            && lhs.m24 < rhs.m24
            && lhs.m15 < rhs.m15
            && lhs.m25 < rhs.m25
            && lhs.m16 < rhs.m16
            && lhs.m26 < rhs.m26
    }
    #[inline(always)]
    fn le(lhs: Matrix2x6<T>, rhs: Matrix2x6<T>) -> bool {
        lhs.m11 <= rhs.m11
            && lhs.m21 <= rhs.m21
            && lhs.m12 <= rhs.m12
            && lhs.m22 <= rhs.m22
            && lhs.m13 <= rhs.m13
            && lhs.m23 <= rhs.m23
            && lhs.m14 <= rhs.m14
            && lhs.m24 <= rhs.m24
            && lhs.m15 <= rhs.m15
            && lhs.m25 <= rhs.m25
            && lhs.m16 <= rhs.m16
            && lhs.m26 <= rhs.m26
    }
    #[inline(always)]
    fn gt(lhs: Matrix2x6<T>, rhs: Matrix2x6<T>) -> bool {
        lhs.m11 > rhs.m11
            && lhs.m21 > rhs.m21
            && lhs.m12 > rhs.m12
            && lhs.m22 > rhs.m22
