        let [v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15] = boxed.unbox();
        Matrix4 {
            m11: v0,
            m21: v4,
            m31: v8,
            m41: v12,
            m12: v1,
            m22: v5,
            m32: v9,
            m42: v13,
            m13: v2,
            m23: v6,
            m33: v10,
            m43: v14,
            m14: v3,
            m24: v7,
            m34: v11,
            m44: v15,
