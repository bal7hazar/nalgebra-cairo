    /// The 4x4 matrix whose first `data.len()` diagonal components are `data`, every other
    /// component zero. Panics with `nalgebra: diagonal too long` when `data.len() > 4`. Upstream:
    /// `Matrix4::from_partial_diagonal` (`&[T]`).
    #[inline(always)]
    fn from_partial_diagonal(data: Span<T>) -> Matrix4<T> {
        let len = data.len();
        if len > 4 {
            core::panic_with_felt252(errors::TOO_MANY_DIAGONAL);
        }
        Matrix4 {
            m11: if len > 0 {
                *data[0]
            } else {
                R::zero()
            },
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m12: R::zero(),
            m22: if len > 1 {
                *data[1]
            } else {
                R::zero()
            },
            m32: R::zero(),
            m42: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: if len > 2 {
                *data[2]
            } else {
                R::zero()
            },
            m43: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: if len > 3 {
                *data[3]
            } else {
                R::zero()
            },
        }
    }

