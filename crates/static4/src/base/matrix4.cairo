    #[inline]
    fn apply_metric_distance<N, +Drop<N>, impl Nm: Norm<N, Matrix4<T>, T>>(
        self: Matrix4<T>, rhs: Matrix4<T>, norm: N,
    ) -> T {
        Nm::metric_distance(@norm, self, rhs)
    }

