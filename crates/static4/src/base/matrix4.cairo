    /// Replaces the diagonal by `diag`, a `Vector4` (upstream requires the length `min(R, C)` = 4).
    /// Upstream: `set_diagonal`.
    #[inline(always)]
    fn set_diagonal(ref self: Matrix4<T>, diag: Vector4<T>) {
        self =
            Matrix4 {
                m11: diag.x,
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m12: self.m12,
                m22: diag.y,
                m32: self.m32,
                m42: self.m42,
                m13: self.m13,
                m23: self.m23,
                m33: diag.z,
                m43: self.m43,
                m14: self.m14,
                m24: self.m24,
                m34: self.m34,
                m44: diag.w,
            };
    }

    /// Replaces the first `min(diag.len(), 4)` diagonal components by the values of `diag` (the
    /// extra values are ignored, like upstream's `take`), the others unchanged. Upstream:
    /// `set_partial_diagonal` (an iterator; a `Span` here).
    #[inline(always)]
    fn set_partial_diagonal(ref self: Matrix4<T>, diag: Span<T>) {
        let len = diag.len();
        self =
            Matrix4 {
                m11: if len > 0 {
                    *diag[0]
                } else {
                    self.m11
                },
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m12: self.m12,
                m22: if len > 1 {
                    *diag[1]
                } else {
                    self.m22
                },
                m32: self.m32,
                m42: self.m42,
                m13: self.m13,
                m23: self.m23,
                m33: if len > 2 {
                    *diag[2]
                } else {
                    self.m33
                },
                m43: self.m43,
                m14: self.m14,
                m24: self.m24,
                m34: self.m34,
                m44: if len > 3 {
                    *diag[3]
                } else {
                    self.m44
                },
            };
    }

    /// Sets `self` to `other` (a `Matrix4`: upstream requires the same shape). Upstream:
    /// `copy_from`.
    #[inline(always)]
    fn copy_from(ref self: Matrix4<T>, other: Matrix4<T>) {
        self = other;
    }

    /// Sets `self` to the 16 values of `slice` in column-major order (`from_column_slice`). Panics
    /// with `nalgebra: wrong slice length` unless `slice.len() == 16`. Upstream: `copy_from_slice`
    /// (`&[T]`).
    #[inline(always)]
    fn copy_from_slice(ref self: Matrix4<T>, slice: Span<T>) {
        self = Self::from_column_slice(slice);
    }

    /// Sets `self` to the transpose of `other`, a `Matrix4`. Exact. Upstream: `tr_copy_from`.
    #[inline(always)]
    fn tr_copy_from(ref self: Matrix4<T>, other: Matrix4<T>) {
        self =
            Matrix4 {
                m11: other.m11,
                m21: other.m12,
                m31: other.m13,
                m41: other.m14,
                m12: other.m21,
                m22: other.m22,
                m32: other.m23,
                m42: other.m24,
                m13: other.m31,
                m23: other.m32,
                m33: other.m33,
                m43: other.m34,
                m14: other.m41,
                m24: other.m42,
                m34: other.m43,
                m44: other.m44,
