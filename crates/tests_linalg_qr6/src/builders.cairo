/// `Vector6` from a raw component tuple.
pub fn vec6(t: (i64, i64, i64, i64, i64, i64)) -> Vector6<Fixed> {
    let (a0, a1, a2, a3, a4, a5) = t;
    Vector6 { x: fx(a0), y: fx(a1), z: fx(a2), w: fx(a3), a: fx(a4), b: fx(a5) }
}

/// The raw value, widened.
fn w(a: Fixed) -> i128 {
    a.raw.into()
}

/// `|floor(p / 2^32) - target|` for an exact wide sum of raw products `p`.
fn dev(p: i128, target: i128) -> u128 {
    let q = if p >= 0 {
        p / 0x100000000
    } else {
        -((-p + 0xffffffff) / 0x100000000)
    };
    let d = q - target;
    let d = if d < 0 {
        -d
    } else {
        d
    };
    d.try_into().unwrap()
}
