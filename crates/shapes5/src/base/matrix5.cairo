    #[inline(always)]
    fn nonzero_diagonal(self: Matrix5<T>) -> bool {
        self.m11 != R::zero()
            && self.m22 != R::zero()
            && self.m33 != R::zero()
            && self.m44 != R::zero()
            && self.m55 != R::zero()
    }

    #[inline(always)]
    fn is_zero(x: T) -> bool {
        x == R::zero()
    }

    #[inline(always)]
    fn tr_mul_rhs(self: Matrix5<T>, b: Matrix5x3<T>) -> Matrix5x3<T> {
        MatrixTrMul::tr_mul(self, b)
    }
