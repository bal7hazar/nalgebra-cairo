/// The component-wise partial order: `a < b` when EVERY component of `a` is smaller than `b`'s
/// (likewise `<=`, `>`, `>=`), so two matrices may be unordered (`!(a < b) && !(a >= b)`).
/// Upstream: `PartialOrd for Matrix`.
pub impl Matrix5x2PartialOrd<T, +PartialOrd<T>, +Copy<T>, +Drop<T>> of PartialOrd<Matrix5x2<T>> {
    #[inline(always)]
    fn lt(lhs: Matrix5x2<T>, rhs: Matrix5x2<T>) -> bool {
        lhs.m11 < rhs.m11
            && lhs.m21 < rhs.m21
            && lhs.m31 < rhs.m31
            && lhs.m41 < rhs.m41
            && lhs.m51 < rhs.m51
            && lhs.m12 < rhs.m12
            && lhs.m22 < rhs.m22
            && lhs.m32 < rhs.m32
            && lhs.m42 < rhs.m42
            && lhs.m52 < rhs.m52
    }
    #[inline(always)]
    fn le(lhs: Matrix5x2<T>, rhs: Matrix5x2<T>) -> bool {
        lhs.m11 <= rhs.m11
            && lhs.m21 <= rhs.m21
            && lhs.m31 <= rhs.m31
            && lhs.m41 <= rhs.m41
            && lhs.m51 <= rhs.m51
            && lhs.m12 <= rhs.m12
            && lhs.m22 <= rhs.m22
            && lhs.m32 <= rhs.m32
            && lhs.m42 <= rhs.m42
            && lhs.m52 <= rhs.m52
    }
    #[inline(always)]
    fn gt(lhs: Matrix5x2<T>, rhs: Matrix5x2<T>) -> bool {
        lhs.m11 > rhs.m11
            && lhs.m21 > rhs.m21
            && lhs.m31 > rhs.m31
            && lhs.m41 > rhs.m41
            && lhs.m51 > rhs.m51
            && lhs.m12 > rhs.m12
            && lhs.m22 > rhs.m22
            && lhs.m32 > rhs.m32
            && lhs.m42 > rhs.m42
            && lhs.m52 > rhs.m52
    }
    #[inline(always)]
    fn ge(lhs: Matrix5x2<T>, rhs: Matrix5x2<T>) -> bool {
        lhs.m11 >= rhs.m11
            && lhs.m21 >= rhs.m21
            && lhs.m31 >= rhs.m31
            && lhs.m41 >= rhs.m41
            && lhs.m51 >= rhs.m51
            && lhs.m12 >= rhs.m12
            && lhs.m22 >= rhs.m22
            && lhs.m32 >= rhs.m32
            && lhs.m42 >= rhs.m42
            && lhs.m52 >= rhs.m52
    }
}

