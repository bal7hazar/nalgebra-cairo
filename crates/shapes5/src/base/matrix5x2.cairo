/// The 5x2 matrix of the given COLUMNS (`[[m11, m21, ..], [m12, ..], ..]`). Upstream: `From<[[T;
/// R]; C]>`.
pub impl Matrix5x2FromColumnArrays<T, +Drop<T>> of Into<[[T; 5]; 2], Matrix5x2<T>> {
    #[inline(always)]
    fn into(self: [[T; 5]; 2]) -> Matrix5x2<T> {
        let [c0, c1] = self;
        let [m11, m21, m31, m41, m51] = c0;
        let [m12, m22, m32, m42, m52] = c1;
        Matrix5x2 { m11, m21, m31, m41, m51, m12, m22, m32, m42, m52 }
    }
}

/// The columns of the 5x2 matrix as nested arrays (`[[m11, m21, ..], [m12, ..], ..]`). Upstream:
/// `Into<[[T; R]; C]>`.
pub impl Matrix5x2IntoColumnArrays<T, +Drop<T>> of Into<Matrix5x2<T>, [[T; 5]; 2]> {
    #[inline(always)]
