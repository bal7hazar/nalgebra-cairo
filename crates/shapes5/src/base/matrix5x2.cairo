        match j {
            0 => match i {
                0 => Option::Some(self.m11),
                1 => Option::Some(self.m21),
                2 => Option::Some(self.m31),
                3 => Option::Some(self.m41),
                4 => Option::Some(self.m51),
                _ => Option::None,
            },
            1 => match i {
                0 => Option::Some(self.m12),
                1 => Option::Some(self.m22),
                2 => Option::Some(self.m32),
                3 => Option::Some(self.m42),
                4 => Option::Some(self.m52),
                _ => Option::None,
            },
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: Matrix5x2<T>, index: (usize, usize)) -> T {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => self.m11,
                1 => self.m21,
                2 => self.m31,
                3 => self.m41,
                4 => self.m51,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            1 => match i {
                0 => self.m12,
                1 => self.m22,
                2 => self.m32,
                3 => self.m42,
                4 => self.m52,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

