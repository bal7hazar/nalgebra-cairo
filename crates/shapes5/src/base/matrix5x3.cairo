/// `iter.sum()` of an iterator of `Matrix5x3`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 5x3 matrix when empty. Upstream: `Sum for Matrix` (a fold
/// from `zero()`: the same result, one addition more).
pub impl Matrix5x3Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<Matrix5x3<T>> {
    fn sum<I, +Iterator<I>[Item: Matrix5x3<T>], +Destruct<I>, +Destruct<Matrix5x3<T>>>(
        mut iter: I,
    ) -> Matrix5x3<T> {
        let Option::Some(mut acc) = iter.next() else {
            return Matrix5x3 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m51: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m42: R::zero(),
                m52: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m43: R::zero(),
                m53: R::zero(),
            };
        };
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
        }
        acc
    }
}

/// `*iter.sum()` of an iterator of snapshots `@Matrix5x3` (`span.into_iter()`): a snapshot of the
/// sum of the items, like `Sum<Matrix5x3>`. Upstream: `Sum<&Matrix> for Matrix` (references).
pub impl Matrix5x3SumSnapshot<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<@Matrix5x3<T>> {
    fn sum<I, +Iterator<I>[Item: @Matrix5x3<T>], +Destruct<I>, +Destruct<@Matrix5x3<T>>>(
        mut iter: I,
    ) -> @Matrix5x3<T> {
        let Option::Some(first) = iter.next() else {
            return @Matrix5x3 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m51: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m42: R::zero(),
                m52: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m43: R::zero(),
                m53: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
        }
        @acc
    }
}

