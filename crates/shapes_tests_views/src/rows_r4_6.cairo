#[test]
fn test_vector5_rows_columns() {
    let a: Vector5<Fixed> = load(
        array![63344833218, -15715049207, -62446299219, -6349772173, 9502934065].span(),
    );
    assert!(a.nrows() == 5);
    assert!(a.ncols() == 1);
    assert!(a.shape() == (5, 1));
    assert!(a.is_square() == false);
    assert!(a.vector_to_matrix_index(4) == (4, 0));
    assert_raws(a.row(3), array![-6349772173].span());
    assert_raws(
        a.column(0),
        array![63344833218, -15715049207, -62446299219, -6349772173, 9502934065].span(),
    );
    assert_raws(a.upper_triangle(), array![63344833218, 0, 0, 0, 0].span());
    assert_raws(
        a.lower_triangle(),
        array![63344833218, -15715049207, -62446299219, -6349772173, 9502934065].span(),
    );
    let r0: Matrix1<Fixed> = load(array![63344833218].span());
    let r1: Matrix1<Fixed> = load(array![-15715049207].span());
    let r2: Matrix1<Fixed> = load(array![-62446299219].span());
    let r3: Matrix1<Fixed> = load(array![-6349772173].span());
    let r4: Matrix1<Fixed> = load(array![9502934065].span());
    assert_raws(
        Vector5Trait::from_rows(r0, r1, r2, r3, r4),
        array![63344833218, -15715049207, -62446299219, -6349772173, 9502934065].span(),
    );
    let c0: Vector5<Fixed> = load(
        array![63344833218, -15715049207, -62446299219, -6349772173, 9502934065].span(),
    );
    assert_raws(
        Vector5Trait::from_columns(c0),
        array![63344833218, -15715049207, -62446299219, -6349772173, 9502934065].span(),
    );
    let e = fx(-21803214865);
    assert_raws(
        a.insert_row(0, e),
        array![-21803214865, 63344833218, -15715049207, -62446299219, -6349772173, 9502934065]
            .span(),
    );
    assert_raws(
        a.insert_column(1, e),
        array![
            63344833218, -15715049207, -62446299219, -6349772173, 9502934065, -21803214865,
            -21803214865, -21803214865, -21803214865, -21803214865,
        ]
            .span(),
    );
    assert_raws(
        a.remove_row(0), array![-15715049207, -62446299219, -6349772173, 9502934065].span(),
    );
    assert!(!a.is_orthogonal(4));
    let q: Vector5<Fixed> = load(array![0, 4294967296, 0, 0, 0].span());
    assert!(q.is_orthogonal(0));
}

