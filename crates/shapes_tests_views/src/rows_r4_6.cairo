    assert!(a.nrows() == 6);
    assert!(a.ncols() == 1);
    assert!(a.shape() == (6, 1));
    assert!(a.is_square() == false);
    assert!(a.vector_to_matrix_index(0) == (0, 0));
    assert_raws(a.row(2), array![45543110386].span());
    assert_raws(
        a.column(0),
        array![6887352851, -40425199157, 45543110386, 14827856037, 25553541421, 2859797718].span(),
    );
    assert_raws(a.upper_triangle(), array![6887352851, 0, 0, 0, 0, 0].span());
    assert_raws(
        a.lower_triangle(),
        array![6887352851, -40425199157, 45543110386, 14827856037, 25553541421, 2859797718].span(),
    );
    let r0: Matrix1<Fixed> = load(array![6887352851].span());
    let r1: Matrix1<Fixed> = load(array![-40425199157].span());
    let r2: Matrix1<Fixed> = load(array![45543110386].span());
    let r3: Matrix1<Fixed> = load(array![14827856037].span());
    let r4: Matrix1<Fixed> = load(array![25553541421].span());
    let r5: Matrix1<Fixed> = load(array![2859797718].span());
    assert_raws(
        Vector6Trait::from_rows(r0, r1, r2, r3, r4, r5),
        array![6887352851, -40425199157, 45543110386, 14827856037, 25553541421, 2859797718].span(),
    );
    let c0: Vector6<Fixed> = load(
        array![6887352851, -40425199157, 45543110386, 14827856037, 25553541421, 2859797718].span(),
    );
    assert_raws(
        Vector6Trait::from_columns(c0),
        array![6887352851, -40425199157, 45543110386, 14827856037, 25553541421, 2859797718].span(),
    );
    let e = fx(4691923852);
    assert_raws(
        a.insert_column(1, e),
        array![
            6887352851, -40425199157, 45543110386, 14827856037, 25553541421, 2859797718, 4691923852,
            4691923852, 4691923852, 4691923852, 4691923852, 4691923852,
