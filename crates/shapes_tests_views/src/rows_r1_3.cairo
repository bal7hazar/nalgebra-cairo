#[test]
fn test_matrix2x4_rows_columns() {
    let a: Matrix2x4<Fixed> = load(
        array![
            42897629922, -31782655952, -16824117475, -52634059448, 26508296606, -34531116591,
            52427072183, -25380392509,
        ]
            .span(),
    );
    assert!(a.nrows() == 2);
    assert!(a.ncols() == 4);
    assert!(a.shape() == (2, 4));
    assert!(a.is_square() == false);
    assert!(a.vector_to_matrix_index(5) == (1, 2));
    assert_raws(a.row(0), array![42897629922, -16824117475, 26508296606, 52427072183].span());
    assert_raws(a.column(0), array![42897629922, -31782655952].span());
    assert_raws(
        a.upper_triangle(),
        array![
            42897629922, 0, -16824117475, -52634059448, 26508296606, -34531116591, 52427072183,
            -25380392509,
        ]
            .span(),
    );
    assert_raws(
        a.lower_triangle(), array![42897629922, -31782655952, 0, -52634059448, 0, 0, 0, 0].span(),
    );
    let r0: Vector4<Fixed> = load(
        array![42897629922, -16824117475, 26508296606, 52427072183].span(),
    );
    let r1: Vector4<Fixed> = load(
        array![-31782655952, -52634059448, -34531116591, -25380392509].span(),
    );
    assert_raws(
        Matrix2x4Trait::from_rows(r0, r1),
        array![
            42897629922, -31782655952, -16824117475, -52634059448, 26508296606, -34531116591,
            52427072183, -25380392509,
        ]
            .span(),
    );
    let c0: Vector2<Fixed> = load(array![42897629922, -31782655952].span());
    let c1: Vector2<Fixed> = load(array![-16824117475, -52634059448].span());
    let c2: Vector2<Fixed> = load(array![26508296606, -34531116591].span());
    let c3: Vector2<Fixed> = load(array![52427072183, -25380392509].span());
    assert_raws(
        Matrix2x4Trait::from_columns(c0, c1, c2, c3),
        array![
            42897629922, -31782655952, -16824117475, -52634059448, 26508296606, -34531116591,
            52427072183, -25380392509,
        ]
            .span(),
    );
    let e = fx(-5932626527);
    assert_raws(
        a.insert_row(1, e),
        array![
            42897629922, -5932626527, -31782655952, -16824117475, -5932626527, -52634059448,
            26508296606, -5932626527, -34531116591, 52427072183, -5932626527, -25380392509,
        ]
            .span(),
    );
    assert_raws(
        a.insert_column(1, e),
        array![
            42897629922, -31782655952, -5932626527, -5932626527, -16824117475, -52634059448,
            26508296606, -34531116591, 52427072183, -25380392509,
        ]
            .span(),
    );
    assert_raws(
        a.remove_row(0), array![-31782655952, -52634059448, -34531116591, -25380392509].span(),
    );
    assert_raws(
        a.remove_column(0),
        array![-16824117475, -52634059448, 26508296606, -34531116591, 52427072183, -25380392509]
            .span(),
    );
    assert!(!a.is_orthogonal(4));
}

