#[test]
fn test_vector3_rows_columns() {
    let a: Vector3<Fixed> = load(array![61571088290, -63474516173, -56802514716].span());
    assert!(a.nrows() == 3);
    assert!(a.ncols() == 1);
    assert!(a.shape() == (3, 1));
    assert!(a.is_square() == false);
    assert!(a.vector_to_matrix_index(0) == (0, 0));
    assert_raws(a.row(0), array![61571088290].span());
    assert_raws(a.column(0), array![61571088290, -63474516173, -56802514716].span());
    assert_raws(a.upper_triangle(), array![61571088290, 0, 0].span());
    assert_raws(a.lower_triangle(), array![61571088290, -63474516173, -56802514716].span());
    let r0: Matrix1<Fixed> = load(array![61571088290].span());
    let r1: Matrix1<Fixed> = load(array![-63474516173].span());
    let r2: Matrix1<Fixed> = load(array![-56802514716].span());
    assert_raws(
        Vector3Trait::from_rows(r0, r1, r2), array![61571088290, -63474516173, -56802514716].span(),
    );
    let c0: Vector3<Fixed> = load(array![61571088290, -63474516173, -56802514716].span());
    assert_raws(
        Vector3Trait::from_columns(c0), array![61571088290, -63474516173, -56802514716].span(),
    );
    let e = fx(-2821486445);
    assert_raws(
        a.insert_row(1, e), array![61571088290, -2821486445, -63474516173, -56802514716].span(),
    );
    assert_raws(
        a.insert_column(0, e),
        array![-2821486445, -2821486445, -2821486445, 61571088290, -63474516173, -56802514716]
            .span(),
    );
    assert_raws(a.remove_row(0), array![-63474516173, -56802514716].span());
    assert!(!a.is_orthogonal(4));
    let q: Vector3<Fixed> = load(array![0, -4294967296, 0].span());
    assert!(q.is_orthogonal(0));
}

