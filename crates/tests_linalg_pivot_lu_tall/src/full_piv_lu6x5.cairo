fn test_oracle_full_piv_lu6x5_rank() {
    let mut cases = oracle::full_piv_lu6x5_rank_cases();
    let (mut lo, mut hi, mut rec) = (0xffffffffffffffff_u128, 0_u128, 0);
    while let Some(case) = cases.pop_front() {
        let (a, k, _) = *case;
        let a = black_box(mat6x5(a));
        let f = a.full_piv_lu();
        let d = array![
            abs_raw(f.lu.m11), abs_raw(f.lu.m22), abs_raw(f.lu.m33), abs_raw(f.lu.m44),
            abs_raw(f.lu.m55),
