/// The building blocks reproduce the unrolled decomposition bit for bit: `clear_column_unchecked(m,
/// i, 1, Some(work))` for `i` = 0..2 gives `hess` and `subdiag`, `assemble_q` gives `q()`.
#[test]
fn test_hessenberg4_householder_steps() {
    let mut cases = oracle::hessenberg4_cases();
    while let Some(case) = cases.pop_front() {
        let (a, _, _, _) = *case;
        let a = black_box(mat4x4(a));
        let h = a.hessenberg();
        let mut m = a;
        let mut work: Option<Vector4<Fixed>> = Option::Some(
            Vector4 { x: fx(0), y: fx(0), z: fx(0), w: fx(0) },
        );
        let s0 = clear_column_unchecked(ref m, 0, 1, ref work);
        let s1 = clear_column_unchecked(ref m, 1, 1, ref work);
        let s2 = clear_column_unchecked(ref m, 2, 1, ref work);
        assert!(
            m == h.hess && Vector3 { x: s0, y: s1, z: s2 } == h.subdiag, "clear_column_unchecked",
        );
        assert!(assemble_q(m, array![s0, s1, s2].span()) == h.q(), "assemble_q");
        assert!(work.is_some());
    }
}

