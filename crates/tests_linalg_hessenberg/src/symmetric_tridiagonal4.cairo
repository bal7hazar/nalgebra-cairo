#[test]
fn test_oracle_symmetric_tridiagonal4() {
    let mut cases = oracle::symmetric_tridiagonal4_cases();
    let (mut ex, mut rec, mut orth) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, eq, ed, ee, tol) = *case;
        let a = black_box(mat4x4(a));
        let t = a.symmetric_tridiagonalize();
        let (q, d, e) = t.unpack();
        assert!(q == t.q() && d == t.diagonal() && t.internal_tri() == t.tri);
        assert!(t.unpack_tridiagonal() == (d, e) && t.off_diagonal() == e);
        let (eq, ed) = (mat4x4(eq), vec4(ed));
        ex = max(ex, excess_all(q, eq, tol));
        ex = max(ex, excess_all(d, ed, tol));
        let ee = vec3(ee);
        ex = max(ex, excess_all(e, ee, tol));
        rec = max(rec, max_ulp_4x4(t.recompose(), a) / amax_4x4(a));
        orth = max(orth, orth_4x4(q));
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
    assert!(rec <= 21 && orth <= 9, "measured {} {}", rec, orth);
