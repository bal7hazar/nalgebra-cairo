/// The building blocks reproduce the unrolled decomposition bit for bit: `clear_column_unchecked(m,
/// i, 1, Some(work))` for `i` = 0..0 gives `hess` and `subdiag`, `assemble_q` gives `q()`.
#[test]
fn test_hessenberg2_householder_steps() {
    let mut cases = oracle::hessenberg2_cases();
    while let Some(case) = cases.pop_front() {
        let (a, _, _, _) = *case;
        let a = black_box(mat2x2(a));
        let h = a.hessenberg();
        let mut m = a;
        let mut work: Option<Vector2<Fixed>> = Option::Some(Vector2 { x: fx(0), y: fx(0) });
        let s0 = clear_column_unchecked(ref m, 0, 1, ref work);
        assert!(m == h.hess && Matrix1 { x: s0 } == h.subdiag, "clear_column_unchecked");
        assert!(assemble_q(m, array![s0].span()) == h.q(), "assemble_q");
        assert!(work.is_some());
    }
}

