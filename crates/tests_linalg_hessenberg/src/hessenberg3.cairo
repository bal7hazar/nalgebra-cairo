/// The building blocks reproduce the unrolled decomposition bit for bit: `clear_column_unchecked(m,
/// i, 1, Some(work))` for `i` = 0..1 gives `hess` and `subdiag`, `assemble_q` gives `q()`.
#[test]
fn test_hessenberg3_householder_steps() {
    let mut cases = oracle::hessenberg3_cases();
    while let Some(case) = cases.pop_front() {
        let (a, _, _, _) = *case;
        let a = black_box(mat3x3(a));
        let h = a.hessenberg();
        let mut m = a;
        let mut work: Option<Vector3<Fixed>> = Option::Some(
            Vector3 { x: fx(0), y: fx(0), z: fx(0) },
        );
        let s0 = clear_column_unchecked(ref m, 0, 1, ref work);
        let s1 = clear_column_unchecked(ref m, 1, 1, ref work);
        assert!(m == h.hess && Vector2 { x: s0, y: s1 } == h.subdiag, "clear_column_unchecked");
        assert!(assemble_q(m, array![s0, s1].span()) == h.q(), "assemble_q");
        assert!(work.is_some());
    }
}

