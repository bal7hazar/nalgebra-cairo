        assert!(h2.hess == h.hess, "new_with_workspace");
        assert!(true, "Hessenberg form");
        let (eq, eh) = (mat1x1(eq), mat1x1(eh));
        ex = max(ex, excess(ulp_diff(q.x, eq.x), oracle_tol(abs_raw(eq.x), tol)));
