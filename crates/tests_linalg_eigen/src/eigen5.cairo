/// `(eigenvalue excess over the oracle tolerance, reconstruction error per unit, orthonormality
/// error)` of one case; also checks that `symmetric_eigenvalues` is bit-identical to `new`.
fn measure(a: Matrix5<Fixed>, expected: Vector5<Fixed>, tol: u64) -> (u128, u128, u128) {
    let e = SymmetricEigen5Trait::new(a);
    assert!(a.symmetric_eigenvalues() == e.eigenvalues, "eigenvalues differ from new");
    let mut ex = 0;
    ex =
        max(
            ex, excess(ulp_diff(e.eigenvalues.x, expected.x), oracle_tol(abs_raw(expected.x), tol)),
        );
    ex =
        max(
            ex, excess(ulp_diff(e.eigenvalues.y, expected.y), oracle_tol(abs_raw(expected.y), tol)),
        );
    ex =
        max(
            ex, excess(ulp_diff(e.eigenvalues.z, expected.z), oracle_tol(abs_raw(expected.z), tol)),
        );
    ex =
        max(
            ex, excess(ulp_diff(e.eigenvalues.w, expected.w), oracle_tol(abs_raw(expected.w), tol)),
        );
    ex =
        max(
            ex, excess(ulp_diff(e.eigenvalues.a, expected.a), oracle_tol(abs_raw(expected.a), tol)),
        );
    (ex, max_ulp_5x5(e.recompose(), a) / amax_5x5(a), orth_5x5(e.eigenvectors))
}

