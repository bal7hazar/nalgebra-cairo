#[test]
fn test_symmetric_eigen5_diagonal_is_exact() {
    // Distinct diagonal entries: the eigenvectors are the axes, sorted with their eigenvalue.
    let a = mat5x5(
        [
            [12884901888, 0, 0, 0, 0], [0, -4294967296, 0, 0, 0], [0, 0, 30064771072, 0, 0],
            [0, 0, 0, 8589934592, 0], [0, 0, 0, 0, -21474836480],
        ],
    );
    let e = SymmetricEigen5Trait::new(black_box(a));
    assert!(e.eigenvalues == vec5((-5 * ONE, -1 * ONE, 2 * ONE, 3 * ONE, 7 * ONE)));
    assert!(e.recompose() == a);
    assert!(orth_5x5(e.eigenvectors) == 0);
}

