#[test]
fn test_symmetric_eigen6_reads_the_lower_triangle() {
    // A 2x2 block [[2, 1], [1, 2]] (eigenvalues 1 and 3) and a diagonal; the upper entries -9
    // are ignored, like upstream.
    let a = mat6x6(
        [
            [8589934592, 4294967296, 0, 0, 0, 0], [4294967296, 8589934592, 0, 0, 0, 0],
            [0, 0, 30064771072, 0, 0, 0], [0, 0, 0, 34359738368, 0, 0],
            [0, 0, 0, 0, 38654705664, 0], [0, 0, 0, 0, 0, 42949672960],
        ],
    );
    let g = mat6x6(
        [
            [8589934592, -38654705664, -38654705664, -38654705664, -38654705664, -38654705664],
            [4294967296, 8589934592, -38654705664, -38654705664, -38654705664, -38654705664],
            [0, 0, 30064771072, -38654705664, -38654705664, -38654705664],
            [0, 0, 0, 34359738368, -38654705664, -38654705664],
            [0, 0, 0, 0, 38654705664, -38654705664], [0, 0, 0, 0, 0, 42949672960],
        ],
    );
    let e = SymmetricEigen6Trait::new(black_box(g));
    assert!(e.eigenvalues == SymmetricEigen6Trait::new(black_box(a)).eigenvalues);
    assert!(ulp_diff(e.eigenvalues.x, nalgebra_tests_utils::int(1)) <= 2);
    assert!(max_ulp_6x6(e.recompose(), a) <= 8);
}

