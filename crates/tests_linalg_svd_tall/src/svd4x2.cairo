const ONE: i64 = 0x100000000;
/// `round(1e-4 * 2^32)`: the oracle's `pseudo_inverse` / `rank` threshold.
const EPS: i64 = 429497;

/// `(singular-value excess over the oracle tolerance, reconstruction error per unit of
/// `max(1, max |a_ij|)`, orthonormality error of `U` and `V`)` of one case, in raw units; also
/// checks that `singular_values` is bit-identical to the decomposition's.
fn measure(a: Matrix4x2<Fixed>, expected: Vector2<Fixed>, tol: u64) -> (u128, u128, u128) {
    let d = a.svd();
    assert!(a.singular_values() == d.singular_values, "singular values differ from svd");
    let mut ex = 0;
    ex =
        max(
            ex,
            excess(ulp_diff(d.singular_values.x, expected.x), oracle_tol(abs_raw(expected.x), tol)),
        );
    ex =
        max(
            ex,
            excess(ulp_diff(d.singular_values.y, expected.y), oracle_tol(abs_raw(expected.y), tol)),
        );
    (ex, max_ulp_4x2(d.recompose(), a) / amax_4x2(a), max(orth_4x2(d.u), orth_2x2(d.v_t)))
}

/// The worst `measure` over `cases`.
fn run(cases: Span<([[i64; 2]; 4], (i64, i64), u64)>) -> (u128, u128, u128) {
