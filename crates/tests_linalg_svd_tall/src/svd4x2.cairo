    let (mut ex, mut rec, mut orth) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, expected, tol) = *case;
        let (e, r, o) = measure(black_box(mat4x2(a)), vec2(expected), tol);
        ex = max(ex, e);
        rec = max(rec, r);
        orth = max(orth, o);
    }
    (ex, rec, orth)
}

