        let Matrix4x2 { m11, m21, m31, m41, m12, m22, m32, m42 } = self;
        [[m11, m21, m31, m41], [m12, m22, m32, m42]]
    }
}

/// `self *= k` for a scalar `k`: `scale` in place, each component floored once. Panics on overflow.
/// Upstream: `MulAssign<T>`.
pub impl Matrix4x2MulAssignScalar<T, +Mul<T>, +Copy<T>, +Drop<T>> of MulAssign<Matrix4x2<T>, T> {
    #[inline(always)]
    fn mul_assign(ref self: Matrix4x2<T>, rhs: T) {
        self =
            Matrix4x2 {
                m11: self.m11 * rhs,
                m21: self.m21 * rhs,
                m31: self.m31 * rhs,
                m41: self.m41 * rhs,
                m12: self.m12 * rhs,
                m22: self.m22 * rhs,
                m32: self.m32 * rhs,
                m42: self.m42 * rhs,
            };
    }
}

/// `self /= k` for a scalar `k`: `unscale` in place, each component correctly rounded. Panics on a
/// zero `k` and on overflow. Upstream: `DivAssign<T>`.
pub impl Matrix4x2DivAssignScalar<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>,
> of DivAssign<Matrix4x2<T>, T> {
    fn div_assign(ref self: Matrix4x2<T>, rhs: T) {
        let (m11, m21, m31, m41, m12) = R::div5(
            self.m11, self.m21, self.m31, self.m41, self.m12, rhs,
        );
        let (m22, m32, m42) = R::div3(self.m22, self.m32, self.m42, rhs);
        self = Matrix4x2 { m11, m21, m31, m41, m12, m22, m32, m42 };
    }
}

/// `iter.sum()` of an iterator of `Matrix4x2`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 4x2 matrix when empty. Upstream: `Sum for Matrix` (a fold
/// from `zero()`: the same result, one addition more).
pub impl Matrix4x2Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<Matrix4x2<T>> {
    fn sum<I, +Iterator<I>[Item: Matrix4x2<T>], +Destruct<I>, +Destruct<Matrix4x2<T>>>(
        mut iter: I,
    ) -> Matrix4x2<T> {
        let Option::Some(mut acc) = iter.next() else {
            return Matrix4x2 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m42: R::zero(),
            };
        };
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
        }
        acc
    }
}

/// `*iter.sum()` of an iterator of snapshots `@Matrix4x2` (`span.into_iter()`): a snapshot of the
/// sum of the items, like `Sum<Matrix4x2>`. Upstream: `Sum<&Matrix> for Matrix` (references).
pub impl Matrix4x2SumSnapshot<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<@Matrix4x2<T>> {
    fn sum<I, +Iterator<I>[Item: @Matrix4x2<T>], +Destruct<I>, +Destruct<@Matrix4x2<T>>>(
        mut iter: I,
    ) -> @Matrix4x2<T> {
        let Option::Some(first) = iter.next() else {
            return @Matrix4x2 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m42: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
        }
        @acc
    }
}

impl Matrix4x2BlasTranspose<T> of BlasTranspose<Matrix4x2<T>> {
    type Output = Matrix2x4<T>;
    #[inline(always)]
    fn tr(self: Matrix4x2<T>) -> Matrix2x4<T> {
        Matrix2x4 {
            m11: self.m11,
            m21: self.m12,
            m12: self.m21,
            m22: self.m22,
            m13: self.m31,
            m23: self.m32,
            m14: self.m41,
            m24: self.m42,
        }
    }
}
