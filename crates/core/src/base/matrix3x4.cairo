pub impl Matrix3x4PartialOrd<T, +PartialOrd<T>, +Copy<T>, +Drop<T>> of PartialOrd<Matrix3x4<T>> {
    #[inline(always)]
    fn lt(lhs: Matrix3x4<T>, rhs: Matrix3x4<T>) -> bool {
        lhs.m11 < rhs.m11
            && lhs.m21 < rhs.m21
            && lhs.m31 < rhs.m31
            && lhs.m12 < rhs.m12
            && lhs.m22 < rhs.m22
            && lhs.m32 < rhs.m32
            && lhs.m13 < rhs.m13
            && lhs.m23 < rhs.m23
            && lhs.m33 < rhs.m33
            && lhs.m14 < rhs.m14
            && lhs.m24 < rhs.m24
            && lhs.m34 < rhs.m34
    }
    #[inline(always)]
    fn le(lhs: Matrix3x4<T>, rhs: Matrix3x4<T>) -> bool {
        lhs.m11 <= rhs.m11
            && lhs.m21 <= rhs.m21
            && lhs.m31 <= rhs.m31
            && lhs.m12 <= rhs.m12
            && lhs.m22 <= rhs.m22
            && lhs.m32 <= rhs.m32
            && lhs.m13 <= rhs.m13
            && lhs.m23 <= rhs.m23
            && lhs.m33 <= rhs.m33
            && lhs.m14 <= rhs.m14
            && lhs.m24 <= rhs.m24
            && lhs.m34 <= rhs.m34
    }
    #[inline(always)]
    fn gt(lhs: Matrix3x4<T>, rhs: Matrix3x4<T>) -> bool {
        lhs.m11 > rhs.m11
            && lhs.m21 > rhs.m21
            && lhs.m31 > rhs.m31
            && lhs.m12 > rhs.m12
            && lhs.m22 > rhs.m22
            && lhs.m32 > rhs.m32
            && lhs.m13 > rhs.m13
            && lhs.m23 > rhs.m23
            && lhs.m33 > rhs.m33
            && lhs.m14 > rhs.m14
            && lhs.m24 > rhs.m24
            && lhs.m34 > rhs.m34
    }
    #[inline(always)]
    fn ge(lhs: Matrix3x4<T>, rhs: Matrix3x4<T>) -> bool {
        lhs.m11 >= rhs.m11
            && lhs.m21 >= rhs.m21
            && lhs.m31 >= rhs.m31
            && lhs.m12 >= rhs.m12
            && lhs.m22 >= rhs.m22
            && lhs.m32 >= rhs.m32
            && lhs.m13 >= rhs.m13
            && lhs.m23 >= rhs.m23
            && lhs.m33 >= rhs.m33
            && lhs.m14 >= rhs.m14
            && lhs.m24 >= rhs.m24
            && lhs.m34 >= rhs.m34
    }
}

