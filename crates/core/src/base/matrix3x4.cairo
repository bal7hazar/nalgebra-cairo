/// The 3x4 matrix of the given COLUMNS (`[[m11, m21, ..], [m12, ..], ..]`). Upstream: `From<[[T;
/// R]; C]>`.
pub impl Matrix3x4FromColumnArrays<T, +Drop<T>> of Into<[[T; 3]; 4], Matrix3x4<T>> {
    #[inline(always)]
    fn into(self: [[T; 3]; 4]) -> Matrix3x4<T> {
        let [c0, c1, c2, c3] = self;
        let [m11, m21, m31] = c0;
        let [m12, m22, m32] = c1;
        let [m13, m23, m33] = c2;
        let [m14, m24, m34] = c3;
        Matrix3x4 { m11, m21, m31, m12, m22, m32, m13, m23, m33, m14, m24, m34 }
    }
}

/// The columns of the 3x4 matrix as nested arrays (`[[m11, m21, ..], [m12, ..], ..]`). Upstream:
/// `Into<[[T; R]; C]>`.
pub impl Matrix3x4IntoColumnArrays<T, +Drop<T>> of Into<Matrix3x4<T>, [[T; 3]; 4]> {
    #[inline(always)]
    fn into(self: Matrix3x4<T>) -> [[T; 3]; 4] {
        let Matrix3x4 { m11, m21, m31, m12, m22, m32, m13, m23, m33, m14, m24, m34 } = self;
        [[m11, m21, m31], [m12, m22, m32], [m13, m23, m33], [m14, m24, m34]]
    }
}

/// `self *= k` for a scalar `k`: `scale` in place, each component floored once. Panics on overflow.
/// Upstream: `MulAssign<T>`.
pub impl Matrix3x4MulAssignScalar<T, +Mul<T>, +Copy<T>, +Drop<T>> of MulAssign<Matrix3x4<T>, T> {
    #[inline(always)]
    fn mul_assign(ref self: Matrix3x4<T>, rhs: T) {
        self =
            Matrix3x4 {
                m11: self.m11 * rhs,
                m21: self.m21 * rhs,
                m31: self.m31 * rhs,
                m12: self.m12 * rhs,
                m22: self.m22 * rhs,
                m32: self.m32 * rhs,
                m13: self.m13 * rhs,
                m23: self.m23 * rhs,
                m33: self.m33 * rhs,
                m14: self.m14 * rhs,
                m24: self.m24 * rhs,
                m34: self.m34 * rhs,
            };
    }
}

/// `self /= k` for a scalar `k`: `unscale` in place, each component correctly rounded. Panics on a
/// zero `k` and on overflow. Upstream: `DivAssign<T>`.
pub impl Matrix3x4DivAssignScalar<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>,
> of DivAssign<Matrix3x4<T>, T> {
    fn div_assign(ref self: Matrix3x4<T>, rhs: T) {
        let (m11, m21, m31, m12, m22, m32, m13, m23, m33) = R::div9(
            self.m11,
            self.m21,
            self.m31,
            self.m12,
            self.m22,
            self.m32,
            self.m13,
            self.m23,
            self.m33,
            rhs,
        );
        let (m14, m24, m34) = R::div3(self.m14, self.m24, self.m34, rhs);
        self = Matrix3x4 { m11, m21, m31, m12, m22, m32, m13, m23, m33, m14, m24, m34 };
    }
}

/// `iter.sum()` of an iterator of `Matrix3x4`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 3x4 matrix when empty. Upstream: `Sum for Matrix` (a fold
/// from `zero()`: the same result, one addition more).
pub impl Matrix3x4Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<Matrix3x4<T>> {
    fn sum<I, +Iterator<I>[Item: Matrix3x4<T>], +Destruct<I>, +Destruct<Matrix3x4<T>>>(
        mut iter: I,
    ) -> Matrix3x4<T> {
        let Option::Some(mut acc) = iter.next() else {
            return Matrix3x4 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
            };
        };
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
        }
        acc
    }
}

/// `*iter.sum()` of an iterator of snapshots `@Matrix3x4` (`span.into_iter()`): a snapshot of the
/// sum of the items, like `Sum<Matrix3x4>`. Upstream: `Sum<&Matrix> for Matrix` (references).
pub impl Matrix3x4SumSnapshot<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<@Matrix3x4<T>> {
    fn sum<I, +Iterator<I>[Item: @Matrix3x4<T>], +Destruct<I>, +Destruct<@Matrix3x4<T>>>(
        mut iter: I,
    ) -> @Matrix3x4<T> {
        let Option::Some(first) = iter.next() else {
            return @Matrix3x4 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
        }
        @acc
    }
}

impl Matrix3x4BlasTranspose<T> of BlasTranspose<Matrix3x4<T>> {
    type Output = Matrix4x3<T>;
    #[inline(always)]
    fn tr(self: Matrix3x4<T>) -> Matrix4x3<T> {
        Matrix4x3 {
            m11: self.m11,
            m21: self.m12,
            m31: self.m13,
            m41: self.m14,
            m12: self.m21,
            m22: self.m22,
            m32: self.m23,
            m42: self.m24,
            m13: self.m31,
            m23: self.m32,
            m33: self.m33,
            m43: self.m34,
        }
    }
}
