/// The multiplicative identity (`identity()`), exactly. Upstream: `num::One for SquareMatrix`.
pub impl Matrix4One<T, impl R: Real<T>, +PartialEq<T>, +Copy<T>, +Drop<T>> of One<Matrix4<T>> {
    #[inline(always)]
    fn one() -> Matrix4<T> {
        Matrix4 {
            m11: R::one(),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m12: R::zero(),
            m22: R::one(),
            m32: R::zero(),
            m42: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: R::one(),
            m43: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: R::one(),
        }
    }
    #[inline(always)]
    fn is_one(self: @Matrix4<T>) -> bool {
        *self.m11 == R::one()
            && *self.m21 == R::zero()
            && *self.m31 == R::zero()
            && *self.m41 == R::zero()
            && *self.m12 == R::zero()
            && *self.m22 == R::one()
            && *self.m32 == R::zero()
            && *self.m42 == R::zero()
            && *self.m13 == R::zero()
            && *self.m23 == R::zero()
            && *self.m33 == R::one()
            && *self.m43 == R::zero()
            && *self.m14 == R::zero()
            && *self.m24 == R::zero()
            && *self.m34 == R::zero()
            && *self.m44 == R::one()
    }
    #[inline(always)]
    fn is_non_one(self: @Matrix4<T>) -> bool {
        !Self::is_one(self)
    }
}

