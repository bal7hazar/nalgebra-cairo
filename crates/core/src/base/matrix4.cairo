    fn product<I, +Iterator<I>[Item: @Matrix4<T>], +Destruct<I>, +Destruct<@Matrix4<T>>>(
        mut iter: I,
    ) -> @Matrix4<T> {
        let Option::Some(first) = iter.next() else {
            return @Matrix4 {
                m11: R::one(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m12: R::zero(),
                m22: R::one(),
                m32: R::zero(),
                m42: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::one(),
                m43: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
                m44: R::one(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc * *x;
            let Option::Some(x) = iter.next() else {
