impl Matrix4SolveKernelVector4<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Mul<T>, +Neg<T>, +PartialEq<T>,
> of SolveKernel<Matrix4<T>, Vector4<T>> {
    type Scalar = T;

    #[inline(always)]
    fn lower(self: Matrix4<T>, b: Vector4<T>) -> Vector4<T> {
        let x00 = R::div(b.x, self.m11);
        let n10 = -self.m21;
        let x10 = R::div(R::mul_add(n10, x00, b.y), self.m22);
        let x20 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m31, x00),
                    self.m32,
                    x10,
                ),
            ),
            self.m33,
        );
        let x30 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), b.w), self.m41, x00),
                        self.m42,
                        x10,
                    ),
                    self.m43,
                    x20,
                ),
            ),
            self.m44,
        );
        Vector4 { x: x00, y: x10, z: x20, w: x30 }
    }

    #[inline(always)]
    fn upper(self: Matrix4<T>, b: Vector4<T>) -> Vector4<T> {
        let x30 = R::div(b.w, self.m44);
        let n23 = -self.m34;
        let x20 = R::div(R::mul_add(n23, x30, b.z), self.m33);
        let x10 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.y), self.m24, x30),
                    self.m23,
                    x20,
                ),
            ),
            self.m22,
        );
        let x00 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), b.x), self.m14, x30),
                        self.m13,
                        x20,
                    ),
                    self.m12,
                    x10,
                ),
            ),
            self.m11,
        );
        Vector4 { x: x00, y: x10, z: x20, w: x30 }
    }

    #[inline(always)]
    fn lower_unit(self: Matrix4<T>, b: Vector4<T>) -> Vector4<T> {
        let x00 = b.x;
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, x00, b.y);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m31, x00), self.m32, x10,
            ),
        );
        let x30 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.w), self.m41, x00),
                    self.m42,
                    x10,
                ),
                self.m43,
                x20,
            ),
        );
        Vector4 { x: x00, y: x10, z: x20, w: x30 }
    }

    #[inline(always)]
    fn lower_with_diag(self: Matrix4<T>, b: Vector4<T>, diag: T) -> Vector4<T> {
        let x00 = b.x;
        let q00 = R::div(x00, diag);
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, q00, b.y);
        let q10 = R::div(x10, diag);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m31, q00), self.m32, q10,
            ),
        );
        let q20 = R::div(x20, diag);
        let x30 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.w), self.m41, q00),
                    self.m42,
                    q10,
                ),
                self.m43,
                q20,
            ),
        );
        Vector4 { x: x00, y: x10, z: x20, w: x30 }
    }

    #[inline(always)]
    fn nonzero_diagonal(self: Matrix4<T>) -> bool {
        self.m11 != R::zero()
            && self.m22 != R::zero()
            && self.m33 != R::zero()
            && self.m44 != R::zero()
    }

    #[inline(always)]
    fn is_zero(x: T) -> bool {
        x == R::zero()
    }

    #[inline(always)]
    fn tr_mul_rhs(self: Matrix4<T>, b: Vector4<T>) -> Vector4<T> {
        MatrixTrMul::tr_mul(self, b)
    }
