    #[inline(always)]
    fn le(lhs: Matrix4x3<T>, rhs: Matrix4x3<T>) -> bool {
        lhs.m11 <= rhs.m11
            && lhs.m21 <= rhs.m21
            && lhs.m31 <= rhs.m31
