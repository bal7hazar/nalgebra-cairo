/// The 4x3 matrix of the given COLUMNS (`[[m11, m21, ..], [m12, ..], ..]`). Upstream: `From<[[T;
/// R]; C]>`.
pub impl Matrix4x3FromColumnArrays<T, +Drop<T>> of Into<[[T; 4]; 3], Matrix4x3<T>> {
    #[inline(always)]
    fn into(self: [[T; 4]; 3]) -> Matrix4x3<T> {
        let [c0, c1, c2] = self;
        let [m11, m21, m31, m41] = c0;
        let [m12, m22, m32, m42] = c1;
        let [m13, m23, m33, m43] = c2;
        Matrix4x3 { m11, m21, m31, m41, m12, m22, m32, m42, m13, m23, m33, m43 }
    }
}

/// The columns of the 4x3 matrix as nested arrays (`[[m11, m21, ..], [m12, ..], ..]`). Upstream:
/// `Into<[[T; R]; C]>`.
pub impl Matrix4x3IntoColumnArrays<T, +Drop<T>> of Into<Matrix4x3<T>, [[T; 4]; 3]> {
    #[inline(always)]
    fn into(self: Matrix4x3<T>) -> [[T; 4]; 3] {
        let Matrix4x3 { m11, m21, m31, m41, m12, m22, m32, m42, m13, m23, m33, m43 } = self;
        [[m11, m21, m31, m41], [m12, m22, m32, m42], [m13, m23, m33, m43]]
    }
}

/// `self *= k` for a scalar `k`: `scale` in place, each component floored once. Panics on overflow.
/// Upstream: `MulAssign<T>`.
pub impl Matrix4x3MulAssignScalar<T, +Mul<T>, +Copy<T>, +Drop<T>> of MulAssign<Matrix4x3<T>, T> {
    #[inline(always)]
    fn mul_assign(ref self: Matrix4x3<T>, rhs: T) {
        self =
            Matrix4x3 {
                m11: self.m11 * rhs,
                m21: self.m21 * rhs,
                m31: self.m31 * rhs,
                m41: self.m41 * rhs,
                m12: self.m12 * rhs,
                m22: self.m22 * rhs,
                m32: self.m32 * rhs,
                m42: self.m42 * rhs,
                m13: self.m13 * rhs,
                m23: self.m23 * rhs,
                m33: self.m33 * rhs,
                m43: self.m43 * rhs,
            };
    }
}

/// `self /= k` for a scalar `k`: `unscale` in place, each component correctly rounded. Panics on a
/// zero `k` and on overflow. Upstream: `DivAssign<T>`.
pub impl Matrix4x3DivAssignScalar<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>,
> of DivAssign<Matrix4x3<T>, T> {
    fn div_assign(ref self: Matrix4x3<T>, rhs: T) {
        let (m11, m21, m31, m41, m12, m22, m32, m42, m13) = R::div9(
            self.m11,
            self.m21,
            self.m31,
            self.m41,
            self.m12,
            self.m22,
            self.m32,
            self.m42,
            self.m13,
            rhs,
        );
        let (m23, m33, m43) = R::div3(self.m23, self.m33, self.m43, rhs);
        self = Matrix4x3 { m11, m21, m31, m41, m12, m22, m32, m42, m13, m23, m33, m43 };
    }
}

/// `iter.sum()` of an iterator of `Matrix4x3`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 4x3 matrix when empty. Upstream: `Sum for Matrix` (a fold
/// from `zero()`: the same result, one addition more).
pub impl Matrix4x3Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<Matrix4x3<T>> {
    fn sum<I, +Iterator<I>[Item: Matrix4x3<T>], +Destruct<I>, +Destruct<Matrix4x3<T>>>(
        mut iter: I,
    ) -> Matrix4x3<T> {
        let Option::Some(mut acc) = iter.next() else {
            return Matrix4x3 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m42: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m43: R::zero(),
            };
        };
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
        }
        acc
    }
}

/// `*iter.sum()` of an iterator of snapshots `@Matrix4x3` (`span.into_iter()`): a snapshot of the
/// sum of the items, like `Sum<Matrix4x3>`. Upstream: `Sum<&Matrix> for Matrix` (references).
pub impl Matrix4x3SumSnapshot<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<@Matrix4x3<T>> {
    fn sum<I, +Iterator<I>[Item: @Matrix4x3<T>], +Destruct<I>, +Destruct<@Matrix4x3<T>>>(
        mut iter: I,
    ) -> @Matrix4x3<T> {
        let Option::Some(first) = iter.next() else {
            return @Matrix4x3 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m42: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m43: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
        }
        @acc
    }
}

