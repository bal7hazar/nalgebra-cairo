                    self.m43,
                ),
                self.m53,
            ),
        )
    }

    /// The product of all the components, left to right in column-major order (upstream's fold),
    /// each product floored. Panics on overflow. Upstream: `product`.
    #[inline(always)]
    fn product(self: Matrix5x3<T>) -> T {
        self.m11
            * self.m21
            * self.m31
            * self.m41
            * self.m51
            * self.m12
            * self.m22
            * self.m32
            * self.m42
            * self.m52
            * self.m13
            * self.m23
            * self.m33
            * self.m43
            * self.m53
    }

    /// The mean of all the components: their exact sum divided by 15, correctly rounded (to
    /// nearest, ties to even, like `f64 /`). Panics if the sum overflows. Upstream: `mean`.
    fn mean(self: Matrix5x3<T>) -> T {
        let n = R::from_int(15);
        R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(
                                                    R::wide_add(
                                                        R::wide_add(
                                                            R::wide_add(
                                                                R::wide_add(
                                                                    R::wide_add(
                                                                        R::wide_add(
                                                                            R::wide_zero(),
                                                                            self.m11,
                                                                        ),
                                                                        self.m21,
                                                                    ),
                                                                    self.m31,
                                                                ),
                                                                self.m41,
                                                            ),
                                                            self.m51,
                                                        ),
                                                        self.m12,
                                                    ),
                                                    self.m22,
                                                ),
                                                self.m32,
                                            ),
                                            self.m42,
                                        ),
                                        self.m52,
                                    ),
                                    self.m13,
                                ),
                                self.m23,
                            ),
                            self.m33,
                        ),
                        self.m43,
                    ),
                    self.m53,
                ),
            ),
            n,
        )
    }

    /// The population variance of all the components, upstream's two-pass formula `sum((x -
    /// mean)^2) / n`: the mean correctly rounded, the differences exact, their squares summed
    /// exactly and floored once, the quotient by 15 correctly rounded. Panics on overflow.
    /// Upstream: `variance`.
    fn variance(self: Matrix5x3<T>) -> T {
        let n = R::from_int(15);
        let m0 = R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(
                                                    R::wide_add(
                                                        R::wide_add(
                                                            R::wide_add(
                                                                R::wide_add(
                                                                    R::wide_add(
                                                                        R::wide_add(
                                                                            R::wide_zero(),
                                                                            self.m11,
                                                                        ),
                                                                        self.m21,
                                                                    ),
                                                                    self.m31,
                                                                ),
                                                                self.m41,
                                                            ),
                                                            self.m51,
                                                        ),
                                                        self.m12,
                                                    ),
                                                    self.m22,
                                                ),
                                                self.m32,
                                            ),
                                            self.m42,
                                        ),
                                        self.m52,
                                    ),
                                    self.m13,
                                ),
                                self.m23,
                            ),
                            self.m33,
                        ),
                        self.m43,
                    ),
                    self.m53,
                ),
            ),
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m41 - m0;
            let d4 = self.m51 - m0;
            let d5 = self.m12 - m0;
            let d6 = self.m22 - m0;
            let d7 = self.m32 - m0;
            let d8 = self.m42 - m0;
            let d9 = self.m52 - m0;
            let d10 = self.m13 - m0;
            let d11 = self.m23 - m0;
            let d12 = self.m33 - m0;
            let d13 = self.m43 - m0;
            let d14 = self.m53 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(
                                            R::wide_add_prod(
                                                R::wide_add_prod(
                                                    R::wide_add_prod(
                                                        R::wide_add_prod(
                                                            R::wide_add_prod(
                                                                R::wide_add_prod(
                                                                    R::wide_add_prod(
                                                                        R::wide_add_prod(
                                                                            R::wide_zero(), d0, d0,
                                                                        ),
                                                                        d1,
                                                                        d1,
                                                                    ),
                                                                    d2,
                                                                    d2,
                                                                ),
                                                                d3,
                                                                d3,
                                                            ),
                                                            d4,
                                                            d4,
                                                        ),
                                                        d5,
                                                        d5,
                                                    ),
                                                    d6,
                                                    d6,
                                                ),
                                                d7,
                                                d7,
                                            ),
                                            d8,
                                            d8,
                                        ),
                                        d9,
                                        d9,
                                    ),
                                    d10,
                                    d10,
                                ),
                                d11,
                                d11,
                            ),
                            d12,
                            d12,
                        ),
                        d13,
                        d13,
                    ),
                    d14,
                    d14,
                ),
            )
        };
        R::div(s0, n)
    }

    /// The sum of each column, exact (ONE `Real::Wide` accumulator each). Panics on overflow.
    /// Upstream: `row_sum`.
    fn row_sum(self: Matrix5x3<T>) -> RowVector3<T> {
        RowVector3 {
            x: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21), self.m31,
                        ),
                        self.m41,
                    ),
                    self.m51,
                ),
            ),
            y: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m12), self.m22), self.m32,
                        ),
                        self.m42,
                    ),
                    self.m52,
                ),
            ),
            z: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m13), self.m23), self.m33,
                        ),
                        self.m43,
                    ),
                    self.m53,
                ),
            ),
        }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Matrix5x3<T>) -> Vector3<T> {
        let r = Self::row_sum(self);
        Vector3 { x: r.x, y: r.y, z: r.z }
    }

    /// The sum of each row, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `column_sum`.
    fn column_sum(self: Matrix5x3<T>) -> Vector5<T> {
        Vector5 {
            x: self.m11 + self.m12 + self.m13,
            y: self.m21 + self.m22 + self.m23,
            z: self.m31 + self.m32 + self.m33,
            w: self.m41 + self.m42 + self.m43,
            a: self.m51 + self.m52 + self.m53,
        }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Matrix5x3<T>) -> RowVector3<T> {
        RowVector3 {
            x: self.m11 * self.m21 * self.m31 * self.m41 * self.m51,
            y: self.m12 * self.m22 * self.m32 * self.m42 * self.m52,
            z: self.m13 * self.m23 * self.m33 * self.m43 * self.m53,
        }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Matrix5x3<T>) -> Vector3<T> {
        let r = Self::row_product(self);
        Vector3 { x: r.x, y: r.y, z: r.z }
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Matrix5x3<T>) -> Vector5<T> {
        Vector5 {
            x: self.m11 * self.m12 * self.m13,
            y: self.m21 * self.m22 * self.m23,
            z: self.m31 * self.m32 * self.m33,
            w: self.m41 * self.m42 * self.m43,
            a: self.m51 * self.m52 * self.m53,
        }
    }

    /// The mean of each column: its exact sum divided by 5, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `row_mean`.
    fn row_mean(self: Matrix5x3<T>) -> RowVector3<T> {
        let n = R::from_int(5);
        let (m0, m1, m2) = R::div3(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21), self.m31,
                        ),
                        self.m41,
                    ),
                    self.m51,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m12), self.m22), self.m32,
                        ),
                        self.m42,
                    ),
                    self.m52,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m13), self.m23), self.m33,
                        ),
                        self.m43,
                    ),
                    self.m53,
                ),
            ),
            n,
        );
        RowVector3 { x: m0, y: m1, z: m2 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Matrix5x3<T>) -> Vector3<T> {
        let r = Self::row_mean(self);
        Vector3 { x: r.x, y: r.y, z: r.z }
    }

    /// The mean of each row: its exact sum divided by 3, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix5x3<T>) -> Vector5<T> {
        let n = R::from_int(3);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m12 + self.m13,
            self.m21 + self.m22 + self.m23,
            self.m31 + self.m32 + self.m33,
            self.m41 + self.m42 + self.m43,
            self.m51 + self.m52 + self.m53,
            n,
        );
        Vector5 { x: m0, y: m1, z: m2, w: m3, a: m4 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 5`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix5x3<T>) -> RowVector3<T> {
        let n = R::from_int(5);
        let (m0, m1, m2) = R::div3(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21), self.m31,
                        ),
                        self.m41,
                    ),
                    self.m51,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m12), self.m22), self.m32,
                        ),
                        self.m42,
                    ),
                    self.m52,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m13), self.m23), self.m33,
                        ),
                        self.m43,
                    ),
                    self.m53,
                ),
            ),
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m41 - m0;
            let d4 = self.m51 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            let d3 = self.m42 - m1;
            let d4 = self.m52 - m1;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s2 = {
            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m43 - m2;
            let d4 = self.m53 - m2;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let (v0, v1, v2) = R::div3(s0, s1, s2, n);
        RowVector3 { x: v0, y: v1, z: v2 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix5x3<T>) -> Vector3<T> {
        let r = Self::row_variance(self);
        Vector3 { x: r.x, y: r.y, z: r.z }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 3`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix5x3<T>) -> Vector5<T> {
        let n = R::from_int(3);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m12 + self.m13,
            self.m21 + self.m22 + self.m23,
            self.m31 + self.m32 + self.m33,
            self.m41 + self.m42 + self.m43,
            self.m51 + self.m52 + self.m53,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            R::norm_squared3(d0, d1, d2)
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            R::norm_squared3(d0, d1, d2)
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            let d2 = self.m33 - m2;
            R::norm_squared3(d0, d1, d2)
        };
        let s3 = {
            let d0 = self.m41 - m3;
            let d1 = self.m42 - m3;
            let d2 = self.m43 - m3;
            R::norm_squared3(d0, d1, d2)
        };
        let s4 = {
            let d0 = self.m51 - m4;
            let d1 = self.m52 - m4;
            let d2 = self.m53 - m4;
            R::norm_squared3(d0, d1, d2)
        };
        let (v0, v1, v2, v3, v4) = R::div5(s0, s1, s2, s3, s4, n);
        Vector5 { x: v0, y: v1, z: v2, w: v3, a: v4 }
    }
}

/// The statistics of `Matrix5x4<T>` (upstream `base/statistics.rs`): sums, products, means and
/// variances of all the components, of each column (`row_*`, `row_*_tr`) and of each row
/// (`column_*`). By value, unrolled, no loop.
#[generate_trait]
pub impl Matrix5x4StatisticsImpl<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Add<T>, +Sub<T>, +Mul<T>,
> of Matrix5x4StatisticsTrait<T> {
    /// The sum of all the components in column-major order (upstream's iteration order), exact: ONE
    /// `Real::Wide` accumulator (only the total can overflow, like upstream's f64 partial sums).
    /// Panics on overflow. Upstream: `sum`.
    #[inline(always)]
    fn sum(self: Matrix5x4<T>) -> T {
        R::wide_rescale(
            R::wide_add(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(
                                                    R::wide_add(
                                                        R::wide_add(
                                                            R::wide_add(
                                                                R::wide_add(
                                                                    R::wide_add(
                                                                        R::wide_add(
                                                                            R::wide_add(
                                                                                R::wide_add(
                                                                                    R::wide_add(
                                                                                        R::wide_add(
                                                                                            R::wide_zero(),
                                                                                            self
                                                                                                .m11,
                                                                                        ),
                                                                                        self.m21,
                                                                                    ),
                                                                                    self.m31,
                                                                                ),
                                                                                self.m41,
                                                                            ),
                                                                            self.m51,
                                                                        ),
                                                                        self.m12,
                                                                    ),
                                                                    self.m22,
                                                                ),
                                                                self.m32,
                                                            ),
                                                            self.m42,
                                                        ),
                                                        self.m52,
                                                    ),
                                                    self.m13,
                                                ),
                                                self.m23,
                                            ),
                                            self.m33,
                                        ),
                                        self.m43,
                                    ),
                                    self.m53,
                                ),
                                self.m14,
                            ),
                            self.m24,
                        ),
                        self.m34,
                    ),
                    self.m44,
                ),
                self.m54,
            ),
        )
    }

    /// The product of all the components, left to right in column-major order (upstream's fold),
    /// each product floored. Panics on overflow. Upstream: `product`.
    fn product(self: Matrix5x4<T>) -> T {
        self.m11
            * self.m21
            * self.m31
            * self.m41
            * self.m51
            * self.m12
            * self.m22
            * self.m32
            * self.m42
            * self.m52
            * self.m13
            * self.m23
            * self.m33
            * self.m43
            * self.m53
            * self.m14
            * self.m24
            * self.m34
            * self.m44
            * self.m54
    }

    /// The mean of all the components: their exact sum divided by 20, correctly rounded (to
    /// nearest, ties to even, like `f64 /`). Panics if the sum overflows. Upstream: `mean`.
    fn mean(self: Matrix5x4<T>) -> T {
        let n = R::from_int(20);
        R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(
                                                    R::wide_add(
                                                        R::wide_add(
                                                            R::wide_add(
                                                                R::wide_add(
                                                                    R::wide_add(
                                                                        R::wide_add(
                                                                            R::wide_add(
                                                                                R::wide_add(
                                                                                    R::wide_add(
                                                                                        R::wide_add(
                                                                                            R::wide_add(
                                                                                                R::wide_zero(),
                                                                                                self
                                                                                                    .m11,
                                                                                            ),
                                                                                            self
                                                                                                .m21,
                                                                                        ),
                                                                                        self.m31,
                                                                                    ),
                                                                                    self.m41,
                                                                                ),
                                                                                self.m51,
                                                                            ),
                                                                            self.m12,
                                                                        ),
                                                                        self.m22,
                                                                    ),
                                                                    self.m32,
                                                                ),
                                                                self.m42,
                                                            ),
                                                            self.m52,
                                                        ),
                                                        self.m13,
                                                    ),
                                                    self.m23,
                                                ),
                                                self.m33,
                                            ),
                                            self.m43,
                                        ),
                                        self.m53,
                                    ),
                                    self.m14,
                                ),
                                self.m24,
                            ),
                            self.m34,
                        ),
                        self.m44,
                    ),
                    self.m54,
                ),
            ),
            n,
        )
    }

    /// The population variance of all the components, upstream's two-pass formula `sum((x -
    /// mean)^2) / n`: the mean correctly rounded, the differences exact, their squares summed
    /// exactly and floored once, the quotient by 20 correctly rounded. Panics on overflow.
    /// Upstream: `variance`.
    fn variance(self: Matrix5x4<T>) -> T {
        let n = R::from_int(20);
        let m0 = R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(
                                                    R::wide_add(
                                                        R::wide_add(
                                                            R::wide_add(
                                                                R::wide_add(
                                                                    R::wide_add(
                                                                        R::wide_add(
                                                                            R::wide_add(
                                                                                R::wide_add(
                                                                                    R::wide_add(
                                                                                        R::wide_add(
                                                                                            R::wide_add(
                                                                                                R::wide_zero(),
                                                                                                self
                                                                                                    .m11,
                                                                                            ),
                                                                                            self
                                                                                                .m21,
                                                                                        ),
                                                                                        self.m31,
                                                                                    ),
                                                                                    self.m41,
                                                                                ),
                                                                                self.m51,
                                                                            ),
                                                                            self.m12,
                                                                        ),
                                                                        self.m22,
                                                                    ),
                                                                    self.m32,
                                                                ),
                                                                self.m42,
                                                            ),
                                                            self.m52,
                                                        ),
                                                        self.m13,
                                                    ),
                                                    self.m23,
                                                ),
                                                self.m33,
                                            ),
                                            self.m43,
                                        ),
                                        self.m53,
                                    ),
                                    self.m14,
                                ),
                                self.m24,
                            ),
                            self.m34,
                        ),
                        self.m44,
                    ),
                    self.m54,
                ),
            ),
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m41 - m0;
            let d4 = self.m51 - m0;
            let d5 = self.m12 - m0;
            let d6 = self.m22 - m0;
            let d7 = self.m32 - m0;
            let d8 = self.m42 - m0;
            let d9 = self.m52 - m0;
            let d10 = self.m13 - m0;
            let d11 = self.m23 - m0;
            let d12 = self.m33 - m0;
            let d13 = self.m43 - m0;
            let d14 = self.m53 - m0;
            let d15 = self.m14 - m0;
            let d16 = self.m24 - m0;
            let d17 = self.m34 - m0;
            let d18 = self.m44 - m0;
            let d19 = self.m54 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(
                                            R::wide_add_prod(
                                                R::wide_add_prod(
                                                    R::wide_add_prod(
                                                        R::wide_add_prod(
                                                            R::wide_add_prod(
                                                                R::wide_add_prod(
                                                                    R::wide_add_prod(
                                                                        R::wide_add_prod(
                                                                            R::wide_add_prod(
                                                                                R::wide_add_prod(
                                                                                    R::wide_add_prod(
                                                                                        R::wide_add_prod(
                                                                                            R::wide_add_prod(
                                                                                                R::wide_zero(),
                                                                                                d0,
                                                                                                d0,
                                                                                            ),
                                                                                            d1,
                                                                                            d1,
                                                                                        ),
                                                                                        d2,
                                                                                        d2,
                                                                                    ),
                                                                                    d3,
                                                                                    d3,
                                                                                ),
                                                                                d4,
                                                                                d4,
                                                                            ),
                                                                            d5,
                                                                            d5,
                                                                        ),
                                                                        d6,
                                                                        d6,
                                                                    ),
                                                                    d7,
                                                                    d7,
                                                                ),
                                                                d8,
                                                                d8,
                                                            ),
                                                            d9,
                                                            d9,
                                                        ),
                                                        d10,
                                                        d10,
                                                    ),
                                                    d11,
                                                    d11,
                                                ),
                                                d12,
                                                d12,
                                            ),
                                            d13,
                                            d13,
                                        ),
                                        d14,
                                        d14,
                                    ),
                                    d15,
                                    d15,
                                ),
                                d16,
                                d16,
                            ),
                            d17,
                            d17,
                        ),
                        d18,
                        d18,
                    ),
                    d19,
                    d19,
                ),
            )
        };
        R::div(s0, n)
    }

    /// The sum of each column, exact (ONE `Real::Wide` accumulator each). Panics on overflow.
    /// Upstream: `row_sum`.
    fn row_sum(self: Matrix5x4<T>) -> RowVector4<T> {
        RowVector4 {
            x: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21), self.m31,
                        ),
                        self.m41,
                    ),
                    self.m51,
                ),
            ),
            y: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m12), self.m22), self.m32,
                        ),
                        self.m42,
                    ),
                    self.m52,
                ),
            ),
            z: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m13), self.m23), self.m33,
                        ),
                        self.m43,
                    ),
                    self.m53,
                ),
            ),
            w: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m14), self.m24), self.m34,
                        ),
                        self.m44,
                    ),
                    self.m54,
                ),
            ),
        }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Matrix5x4<T>) -> Vector4<T> {
        let r = Self::row_sum(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The sum of each row, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `column_sum`.
    fn column_sum(self: Matrix5x4<T>) -> Vector5<T> {
        Vector5 {
            x: self.m11 + self.m12 + self.m13 + self.m14,
            y: self.m21 + self.m22 + self.m23 + self.m24,
            z: self.m31 + self.m32 + self.m33 + self.m34,
            w: self.m41 + self.m42 + self.m43 + self.m44,
            a: self.m51 + self.m52 + self.m53 + self.m54,
        }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Matrix5x4<T>) -> RowVector4<T> {
        RowVector4 {
            x: self.m11 * self.m21 * self.m31 * self.m41 * self.m51,
            y: self.m12 * self.m22 * self.m32 * self.m42 * self.m52,
            z: self.m13 * self.m23 * self.m33 * self.m43 * self.m53,
            w: self.m14 * self.m24 * self.m34 * self.m44 * self.m54,
        }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Matrix5x4<T>) -> Vector4<T> {
        let r = Self::row_product(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Matrix5x4<T>) -> Vector5<T> {
        Vector5 {
            x: self.m11 * self.m12 * self.m13 * self.m14,
            y: self.m21 * self.m22 * self.m23 * self.m24,
            z: self.m31 * self.m32 * self.m33 * self.m34,
            w: self.m41 * self.m42 * self.m43 * self.m44,
            a: self.m51 * self.m52 * self.m53 * self.m54,
        }
    }

    /// The mean of each column: its exact sum divided by 5, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `row_mean`.
    fn row_mean(self: Matrix5x4<T>) -> RowVector4<T> {
        let n = R::from_int(5);
        let (m0, m1, m2, m3) = R::div4(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21), self.m31,
                        ),
                        self.m41,
                    ),
                    self.m51,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m12), self.m22), self.m32,
                        ),
                        self.m42,
                    ),
                    self.m52,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m13), self.m23), self.m33,
                        ),
                        self.m43,
                    ),
                    self.m53,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m14), self.m24), self.m34,
                        ),
                        self.m44,
                    ),
                    self.m54,
                ),
            ),
            n,
        );
        RowVector4 { x: m0, y: m1, z: m2, w: m3 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Matrix5x4<T>) -> Vector4<T> {
        let r = Self::row_mean(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The mean of each row: its exact sum divided by 4, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix5x4<T>) -> Vector5<T> {
        let n = R::from_int(4);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m12 + self.m13 + self.m14,
            self.m21 + self.m22 + self.m23 + self.m24,
            self.m31 + self.m32 + self.m33 + self.m34,
            self.m41 + self.m42 + self.m43 + self.m44,
            self.m51 + self.m52 + self.m53 + self.m54,
            n,
        );
        Vector5 { x: m0, y: m1, z: m2, w: m3, a: m4 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 5`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix5x4<T>) -> RowVector4<T> {
        let n = R::from_int(5);
        let (m0, m1, m2, m3) = R::div4(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21), self.m31,
                        ),
                        self.m41,
                    ),
                    self.m51,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m12), self.m22), self.m32,
                        ),
                        self.m42,
                    ),
                    self.m52,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m13), self.m23), self.m33,
                        ),
                        self.m43,
                    ),
                    self.m53,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m14), self.m24), self.m34,
                        ),
                        self.m44,
                    ),
                    self.m54,
                ),
            ),
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m41 - m0;
            let d4 = self.m51 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            let d3 = self.m42 - m1;
            let d4 = self.m52 - m1;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s2 = {
            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m43 - m2;
            let d4 = self.m53 - m2;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s3 = {
            let d0 = self.m14 - m3;
            let d1 = self.m24 - m3;
            let d2 = self.m34 - m3;
            let d3 = self.m44 - m3;
            let d4 = self.m54 - m3;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let (v0, v1, v2, v3) = R::div4(s0, s1, s2, s3, n);
        RowVector4 { x: v0, y: v1, z: v2, w: v3 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix5x4<T>) -> Vector4<T> {
        let r = Self::row_variance(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 4`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix5x4<T>) -> Vector5<T> {
        let n = R::from_int(4);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m12 + self.m13 + self.m14,
            self.m21 + self.m22 + self.m23 + self.m24,
            self.m31 + self.m32 + self.m33 + self.m34,
            self.m41 + self.m42 + self.m43 + self.m44,
            self.m51 + self.m52 + self.m53 + self.m54,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            let d3 = self.m14 - m0;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            let d3 = self.m24 - m1;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m34 - m2;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s3 = {
            let d0 = self.m41 - m3;
            let d1 = self.m42 - m3;
            let d2 = self.m43 - m3;
            let d3 = self.m44 - m3;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s4 = {
            let d0 = self.m51 - m4;
            let d1 = self.m52 - m4;
            let d2 = self.m53 - m4;
            let d3 = self.m54 - m4;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let (v0, v1, v2, v3, v4) = R::div5(s0, s1, s2, s3, s4, n);
        Vector5 { x: v0, y: v1, z: v2, w: v3, a: v4 }
    }
}

/// The statistics of `Matrix5<T>` (upstream `base/statistics.rs`): sums, products, means and
/// variances of all the components, of each column (`row_*`, `row_*_tr`) and of each row
/// (`column_*`). By value, unrolled, no loop.
#[generate_trait]
pub impl Matrix5StatisticsImpl<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Add<T>, +Sub<T>, +Mul<T>,
> of Matrix5StatisticsTrait<T> {
    /// The sum of all the components in column-major order (upstream's iteration order), exact: ONE
    /// `Real::Wide` accumulator (only the total can overflow, like upstream's f64 partial sums).
    /// Panics on overflow. Upstream: `sum`.
    #[inline(always)]
    fn sum(self: Matrix5<T>) -> T {
        R::wide_rescale(
            R::wide_add(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(
                                                    R::wide_add(
                                                        R::wide_add(
                                                            R::wide_add(
                                                                R::wide_add(
                                                                    R::wide_add(
                                                                        R::wide_add(
                                                                            R::wide_add(
                                                                                R::wide_add(
                                                                                    R::wide_add(
                                                                                        R::wide_add(
                                                                                            R::wide_add(
                                                                                                R::wide_add(
                                                                                                    R::wide_add(
                                                                                                        R::wide_add(
                                                                                                            R::wide_add(
                                                                                                                R::wide_zero(),
                                                                                                                self
                                                                                                                    .m11,
                                                                                                            ),
                                                                                                            self
                                                                                                                .m21,
                                                                                                        ),
                                                                                                        self
                                                                                                            .m31,
                                                                                                    ),
                                                                                                    self
                                                                                                        .m41,
                                                                                                ),
                                                                                                self
                                                                                                    .m51,
                                                                                            ),
                                                                                            self
                                                                                                .m12,
                                                                                        ),
                                                                                        self.m22,
                                                                                    ),
                                                                                    self.m32,
                                                                                ),
                                                                                self.m42,
                                                                            ),
                                                                            self.m52,
                                                                        ),
                                                                        self.m13,
                                                                    ),
                                                                    self.m23,
                                                                ),
                                                                self.m33,
                                                            ),
                                                            self.m43,
                                                        ),
                                                        self.m53,
                                                    ),
                                                    self.m14,
                                                ),
                                                self.m24,
                                            ),
                                            self.m34,
                                        ),
                                        self.m44,
                                    ),
                                    self.m54,
                                ),
                                self.m15,
                            ),
                            self.m25,
                        ),
                        self.m35,
                    ),
                    self.m45,
                ),
                self.m55,
            ),
        )
    }

    /// The product of all the components, left to right in column-major order (upstream's fold),
    /// each product floored. Panics on overflow. Upstream: `product`.
    fn product(self: Matrix5<T>) -> T {
        self.m11
            * self.m21
            * self.m31
            * self.m41
            * self.m51
            * self.m12
            * self.m22
            * self.m32
            * self.m42
            * self.m52
            * self.m13
            * self.m23
            * self.m33
            * self.m43
            * self.m53
            * self.m14
            * self.m24
            * self.m34
            * self.m44
            * self.m54
            * self.m15
            * self.m25
            * self.m35
            * self.m45
            * self.m55
    }

    /// The mean of all the components: their exact sum divided by 25, correctly rounded (to
    /// nearest, ties to even, like `f64 /`). Panics if the sum overflows. Upstream: `mean`.
    fn mean(self: Matrix5<T>) -> T {
        let n = R::from_int(25);
        R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(
                                                    R::wide_add(
                                                        R::wide_add(
                                                            R::wide_add(
                                                                R::wide_add(
                                                                    R::wide_add(
                                                                        R::wide_add(
                                                                            R::wide_add(
                                                                                R::wide_add(
                                                                                    R::wide_add(
                                                                                        R::wide_add(
                                                                                            R::wide_add(
                                                                                                R::wide_add(
                                                                                                    R::wide_add(
                                                                                                        R::wide_add(
                                                                                                            R::wide_add(
                                                                                                                R::wide_add(
                                                                                                                    R::wide_zero(),
                                                                                                                    self
                                                                                                                        .m11,
                                                                                                                ),
                                                                                                                self
                                                                                                                    .m21,
                                                                                                            ),
                                                                                                            self
                                                                                                                .m31,
                                                                                                        ),
                                                                                                        self
                                                                                                            .m41,
                                                                                                    ),
                                                                                                    self
                                                                                                        .m51,
                                                                                                ),
                                                                                                self
                                                                                                    .m12,
                                                                                            ),
                                                                                            self
                                                                                                .m22,
                                                                                        ),
                                                                                        self.m32,
                                                                                    ),
                                                                                    self.m42,
                                                                                ),
                                                                                self.m52,
                                                                            ),
                                                                            self.m13,
                                                                        ),
                                                                        self.m23,
                                                                    ),
                                                                    self.m33,
                                                                ),
                                                                self.m43,
                                                            ),
                                                            self.m53,
                                                        ),
                                                        self.m14,
                                                    ),
                                                    self.m24,
                                                ),
                                                self.m34,
                                            ),
