    fn column_variance(self: Vector5<T>) -> Vector5<T> {
        let v0 = R::zero();
        let v1 = R::zero();
        let v2 = R::zero();
        let v3 = R::zero();
        let v4 = R::zero();
        Vector5 { x: v0, y: v1, z: v2, w: v3, a: v4 }
