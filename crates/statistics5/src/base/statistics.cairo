    #[inline(always)]
    fn product(self: Matrix3x5<T>) -> T {
        self.m11
            * self.m21
            * self.m31
            * self.m12
            * self.m22
            * self.m32
            * self.m13
            * self.m23
            * self.m33
            * self.m14
            * self.m24
            * self.m34
            * self.m15
            * self.m25
            * self.m35
    }

    /// The mean of all the components: their exact sum divided by 15, correctly rounded (to
