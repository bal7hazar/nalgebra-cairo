            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m13), self.m23), self.m33,
                        ),
                        self.m43,
                    ),
                    self.m53,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m14), self.m24), self.m34,
                        ),
