                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(
                                                    R::wide_add(
                                                        R::wide_add(
                                                            R::wide_add(
                                                                R::wide_add(
                                                                    R::wide_add(
                                                                        R::wide_add(
                                                                            R::wide_zero(),
                                                                            self.m11,
                                                                        ),
                                                                        self.m21,
                                                                    ),
                                                                    self.m31,
                                                                ),
                                                                self.m12,
                                                            ),
                                                            self.m22,
                                                        ),
                                                        self.m32,
                                                    ),
                                                    self.m13,
                                                ),
                                                self.m23,
                                            ),
                                            self.m33,
                                        ),
                                        self.m14,
                                    ),
                                    self.m24,
                                ),
                                self.m34,
                            ),
                            self.m15,
