                                        d9,
                                        d9,
                                    ),
                                    d10,
                                    d10,
                                ),
                                d11,
                                d11,
                            ),
                            d12,
                            d12,
                        ),
                        d13,
                        d13,
                    ),
                    d14,
                    d14,
                ),
            )
        };
        R::div(s0, n)
