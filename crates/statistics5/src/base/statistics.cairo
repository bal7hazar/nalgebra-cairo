        let (m0, m1, m2, m3, m4) = R::div5(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21), self.m31,
                        ),
                        self.m41,
                    ),
                    self.m51,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m12), self.m22), self.m32,
                        ),
                        self.m42,
                    ),
                    self.m52,
                ),
