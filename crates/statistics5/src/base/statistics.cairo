    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 5`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Vector5<T>) -> Matrix1<T> {
        let n = R::from_int(5);
        let m0 = R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.x), self.y), self.z,
