            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(
                                                    R::wide_add(
                                                        R::wide_add(
                                                            R::wide_add(
                                                                R::wide_add(
                                                                    R::wide_add(
                                                                        R::wide_add(
                                                                            R::wide_zero(),
                                                                            self.m11,
                                                                        ),
                                                                        self.m21,
                                                                    ),
                                                                    self.m31,
                                                                ),
                                                                self.m12,
                                                            ),
                                                            self.m22,
                                                        ),
