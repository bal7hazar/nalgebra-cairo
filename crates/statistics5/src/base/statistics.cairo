    /// The sum of each column, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `row_sum`.
    fn row_sum(self: Matrix3x5<T>) -> RowVector5<T> {
        RowVector5 {
            x: self.m11 + self.m21 + self.m31,
            y: self.m12 + self.m22 + self.m32,
            z: self.m13 + self.m23 + self.m33,
            w: self.m14 + self.m24 + self.m34,
            a: self.m15 + self.m25 + self.m35,
        }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Matrix3x5<T>) -> Vector5<T> {
        let r = Self::row_sum(self);
        Vector5 { x: r.x, y: r.y, z: r.z, w: r.w, a: r.a }
    }

    /// The sum of each row, exact (ONE `Real::Wide` accumulator each). Panics on overflow.
    /// Upstream: `column_sum`.
    fn column_sum(self: Matrix3x5<T>) -> Vector3<T> {
        Vector3 {
            x: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m12), self.m13,
                        ),
                        self.m14,
                    ),
                    self.m15,
                ),
            ),
            y: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m21), self.m22), self.m23,
                        ),
                        self.m24,
                    ),
                    self.m25,
                ),
            ),
            z: R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m31), self.m32), self.m33,
                        ),
                        self.m34,
                    ),
                    self.m35,
                ),
            ),
        }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Matrix3x5<T>) -> RowVector5<T> {
        RowVector5 {
            x: self.m11 * self.m21 * self.m31,
            y: self.m12 * self.m22 * self.m32,
            z: self.m13 * self.m23 * self.m33,
            w: self.m14 * self.m24 * self.m34,
            a: self.m15 * self.m25 * self.m35,
        }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Matrix3x5<T>) -> Vector5<T> {
        let r = Self::row_product(self);
        Vector5 { x: r.x, y: r.y, z: r.z, w: r.w, a: r.a }
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Matrix3x5<T>) -> Vector3<T> {
        Vector3 {
            x: self.m11 * self.m12 * self.m13 * self.m14 * self.m15,
            y: self.m21 * self.m22 * self.m23 * self.m24 * self.m25,
            z: self.m31 * self.m32 * self.m33 * self.m34 * self.m35,
        }
    }

    /// The mean of each column: its exact sum divided by 3, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `row_mean`.
    fn row_mean(self: Matrix3x5<T>) -> RowVector5<T> {
        let n = R::from_int(3);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m21 + self.m31,
            self.m12 + self.m22 + self.m32,
            self.m13 + self.m23 + self.m33,
            self.m14 + self.m24 + self.m34,
            self.m15 + self.m25 + self.m35,
            n,
        );
        RowVector5 { x: m0, y: m1, z: m2, w: m3, a: m4 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Matrix3x5<T>) -> Vector5<T> {
        let r = Self::row_mean(self);
        Vector5 { x: r.x, y: r.y, z: r.z, w: r.w, a: r.a }
    }

    /// The mean of each row: its exact sum divided by 5, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix3x5<T>) -> Vector3<T> {
        let n = R::from_int(5);
        let (m0, m1, m2) = R::div3(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m12), self.m13,
                        ),
                        self.m14,
                    ),
                    self.m15,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m21), self.m22), self.m23,
                        ),
                        self.m24,
                    ),
                    self.m25,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m31), self.m32), self.m33,
                        ),
                        self.m34,
                    ),
                    self.m35,
                ),
            ),
            n,
        );
        Vector3 { x: m0, y: m1, z: m2 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 3`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix3x5<T>) -> RowVector5<T> {
        let n = R::from_int(3);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m21 + self.m31,
            self.m12 + self.m22 + self.m32,
            self.m13 + self.m23 + self.m33,
            self.m14 + self.m24 + self.m34,
            self.m15 + self.m25 + self.m35,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            R::norm_squared3(d0, d1, d2)
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            R::norm_squared3(d0, d1, d2)
        };
        let s2 = {
            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            let d2 = self.m33 - m2;
            R::norm_squared3(d0, d1, d2)
        };
        let s3 = {
            let d0 = self.m14 - m3;
            let d1 = self.m24 - m3;
            let d2 = self.m34 - m3;
            R::norm_squared3(d0, d1, d2)
        };
        let s4 = {
            let d0 = self.m15 - m4;
            let d1 = self.m25 - m4;
            let d2 = self.m35 - m4;
            R::norm_squared3(d0, d1, d2)
        };
        let (v0, v1, v2, v3, v4) = R::div5(s0, s1, s2, s3, s4, n);
        RowVector5 { x: v0, y: v1, z: v2, w: v3, a: v4 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix3x5<T>) -> Vector5<T> {
        let r = Self::row_variance(self);
        Vector5 { x: r.x, y: r.y, z: r.z, w: r.w, a: r.a }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 5`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix3x5<T>) -> Vector3<T> {
        let n = R::from_int(5);
        let (m0, m1, m2) = R::div3(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m12), self.m13,
                        ),
                        self.m14,
                    ),
                    self.m15,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m21), self.m22), self.m23,
                        ),
                        self.m24,
                    ),
                    self.m25,
                ),
            ),
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m31), self.m32), self.m33,
                        ),
                        self.m34,
                    ),
                    self.m35,
                ),
            ),
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            let d3 = self.m14 - m0;
            let d4 = self.m15 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            let d3 = self.m24 - m1;
            let d4 = self.m25 - m1;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m34 - m2;
            let d4 = self.m35 - m2;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let (v0, v1, v2) = R::div3(s0, s1, s2, n);
        Vector3 { x: v0, y: v1, z: v2 }
    }
}

