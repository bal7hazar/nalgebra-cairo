            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m12 - m0;
            let d4 = self.m22 - m0;
            let d5 = self.m32 - m0;
            let d6 = self.m13 - m0;
            let d7 = self.m23 - m0;
            let d8 = self.m33 - m0;
            let d9 = self.m14 - m0;
            let d10 = self.m24 - m0;
            let d11 = self.m34 - m0;
            let d12 = self.m15 - m0;
            let d13 = self.m25 - m0;
            let d14 = self.m35 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(
                                            R::wide_add_prod(
                                                R::wide_add_prod(
                                                    R::wide_add_prod(
                                                        R::wide_add_prod(
                                                            R::wide_add_prod(
                                                                R::wide_add_prod(
                                                                    R::wide_add_prod(
                                                                        R::wide_add_prod(
                                                                            R::wide_zero(), d0, d0,
                                                                        ),
                                                                        d1,
                                                                        d1,
                                                                    ),
                                                                    d2,
                                                                    d2,
                                                                ),
                                                                d3,
                                                                d3,
                                                            ),
                                                            d4,
                                                            d4,
                                                        ),
                                                        d5,
                                                        d5,
                                                    ),
                                                    d6,
                                                    d6,
                                                ),
                                                d7,
                                                d7,
                                            ),
