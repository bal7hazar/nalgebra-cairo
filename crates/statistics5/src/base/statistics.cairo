                        self.w,
                    ),
                    self.a,
                ),
            ),
            n,
        );
        let s0 = {
            let d0 = self.x - m0;
            let d1 = self.y - m0;
            let d2 = self.z - m0;
            let d3 = self.w - m0;
            let d4 = self.a - m0;
            R::wide_rescale(
                R::wide_add_prod(
