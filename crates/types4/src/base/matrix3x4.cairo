/// `iter.sum()` of an iterator of `Matrix3x4`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 3x4 matrix when empty. Upstream: `Sum for Matrix` (a fold
/// from `zero()`: the same result, one addition more).
pub impl Matrix3x4Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<Matrix3x4<T>> {
    fn sum<I, +Iterator<I>[Item: Matrix3x4<T>], +Destruct<I>, +Destruct<Matrix3x4<T>>>(
        mut iter: I,
    ) -> Matrix3x4<T> {
        let Option::Some(mut acc) = iter.next() else {
            return Matrix3x4 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
            };
        };
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
        }
        acc
    }
}

/// `*iter.sum()` of an iterator of snapshots `@Matrix3x4` (`span.into_iter()`): a snapshot of the
/// sum of the items, like `Sum<Matrix3x4>`. Upstream: `Sum<&Matrix> for Matrix` (references).
pub impl Matrix3x4SumSnapshot<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<@Matrix3x4<T>> {
    fn sum<I, +Iterator<I>[Item: @Matrix3x4<T>], +Destruct<I>, +Destruct<@Matrix3x4<T>>>(
        mut iter: I,
    ) -> @Matrix3x4<T> {
        let Option::Some(first) = iter.next() else {
            return @Matrix3x4 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
        }
        @acc
    }
}

