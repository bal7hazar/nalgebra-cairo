impl Matrix3SolveKernelMatrix3x4<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Mul<T>, +Neg<T>, +PartialEq<T>,
> of SolveKernel<Matrix3<T>, Matrix3x4<T>> {
    type Scalar = T;

    fn lower(self: Matrix3<T>, b: Matrix3x4<T>) -> Matrix3x4<T> {
        let (x00, x01, x02, x03) = R::div4(b.m11, b.m12, b.m13, b.m14, self.m11);
        let n10 = -self.m21;
        let (x10, x11, x12, x13) = R::div4(
            R::mul_add(n10, x00, b.m21),
            R::mul_add(n10, x01, b.m22),
            R::mul_add(n10, x02, b.m23),
            R::mul_add(n10, x03, b.m24),
            self.m22,
        );
        let (x20, x21, x22, x23) = R::div4(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m31), self.m31, x00),
                    self.m32,
                    x10,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m32), self.m31, x01),
                    self.m32,
                    x11,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m33), self.m31, x02),
                    self.m32,
                    x12,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m34), self.m31, x03),
                    self.m32,
                    x13,
                ),
            ),
            self.m33,
        );
        Matrix3x4 {
            m11: x00,
            m21: x10,
            m31: x20,
            m12: x01,
            m22: x11,
            m32: x21,
            m13: x02,
            m23: x12,
            m33: x22,
            m14: x03,
            m24: x13,
            m34: x23,
        }
    }

    fn upper(self: Matrix3<T>, b: Matrix3x4<T>) -> Matrix3x4<T> {
        let (x20, x21, x22, x23) = R::div4(b.m31, b.m32, b.m33, b.m34, self.m33);
        let n12 = -self.m23;
        let (x10, x11, x12, x13) = R::div4(
            R::mul_add(n12, x20, b.m21),
            R::mul_add(n12, x21, b.m22),
            R::mul_add(n12, x22, b.m23),
            R::mul_add(n12, x23, b.m24),
            self.m22,
        );
        let (x00, x01, x02, x03) = R::div4(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m11), self.m13, x20),
                    self.m12,
                    x10,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m12), self.m13, x21),
                    self.m12,
                    x11,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m13), self.m13, x22),
                    self.m12,
                    x12,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m14), self.m13, x23),
                    self.m12,
                    x13,
                ),
            ),
            self.m11,
        );
        Matrix3x4 {
            m11: x00,
            m21: x10,
            m31: x20,
            m12: x01,
            m22: x11,
            m32: x21,
            m13: x02,
            m23: x12,
            m33: x22,
            m14: x03,
            m24: x13,
            m34: x23,
        }
    }

    fn lower_unit(self: Matrix3<T>, b: Matrix3x4<T>) -> Matrix3x4<T> {
        let x00 = b.m11;
        let x01 = b.m12;
        let x02 = b.m13;
        let x03 = b.m14;
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, x00, b.m21);
        let x11 = R::mul_add(n10, x01, b.m22);
        let x12 = R::mul_add(n10, x02, b.m23);
        let x13 = R::mul_add(n10, x03, b.m24);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m31), self.m31, x00), self.m32, x10,
            ),
        );
        let x21 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m32), self.m31, x01), self.m32, x11,
            ),
        );
        let x22 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m33), self.m31, x02), self.m32, x12,
