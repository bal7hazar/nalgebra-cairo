            return Self::complete1(u0);
        }
        let q = {
            let (q0, q1, q2, q3) = R::div4(g.x, g.y, g.z, g.w, n);
            Vector4 { x: q0, y: q1, z: q2, w: q3 }
        };
        let p0 = R::sum_prod4(u0.x, q.x, u0.y, q.y, u0.z, q.z, u0.w, q.w);
        let h = Vector4 {
            x: R::mul_add(-p0, u0.x, q.x),
            y: R::mul_add(-p0, u0.y, q.y),
            z: R::mul_add(-p0, u0.z, q.z),
            w: R::mul_add(-p0, u0.w, q.w),
        };
        let nh = R::norm4(h.x, h.y, h.z, h.w);
        if nh < R::HALF {
            return Self::complete1(u0);
        }
        {
            let (q0, q1, q2, q3) = R::div4(h.x, h.y, h.z, h.w, nh);
            Vector4 { x: q0, y: q1, z: q2, w: q3 }
        }
    }
    /// The left singular vector `u_2` from `w = M v_2` and the orthonormal `u_0 .. u_1`:
    /// classical Gram-Schmidt run TWICE, `g = w - Σ <u_l, w> u_l`, `q = g / |g|`, `h = q - Σ
    /// <u_l, q> u_l`, `u_2 = h / |h|` (one fused sum per dot product and per component), or
    /// `complete2` when `g` vanishes EXACTLY or when the second pass keeps less than half of
    /// `|q| >= 1` (the DGKS criterion: `q` then lies numerically in the span of the previous
    /// vectors — on a rank-deficient `M`, `w` is rounding noise of a few raw units and so is its
    /// direction; measured on the `Svd6` oracle: `|UᵀU - I|` of 1.4 without the test). Shared by
    /// every SVD with 4 rows.
    fn gs2(u0: Vector4<T>, u1: Vector4<T>, w: Vector4<T>) -> Vector4<T> {
        revoke_ap_tracking();
        let p0 = R::sum_prod4(u0.x, w.x, u0.y, w.y, u0.z, w.z, u0.w, w.w);
        let p1 = R::sum_prod4(u1.x, w.x, u1.y, w.y, u1.z, w.z, u1.w, w.w);
        let g = Vector4 {
            x: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), w.x), p0, u0.x), p1, u1.x,
                ),
            ),
            y: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), w.y), p0, u0.y), p1, u1.y,
                ),
            ),
            z: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), w.z), p0, u0.z), p1, u1.z,
                ),
            ),
            w: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), w.w), p0, u0.w), p1, u1.w,
                ),
            ),
        };
        let n = R::norm4(g.x, g.y, g.z, g.w);
        if n == R::zero() {
            return Self::complete2(u0, u1);
        }
        let q = {
            let (q0, q1, q2, q3) = R::div4(g.x, g.y, g.z, g.w, n);
            Vector4 { x: q0, y: q1, z: q2, w: q3 }
        };
        let p0 = R::sum_prod4(u0.x, q.x, u0.y, q.y, u0.z, q.z, u0.w, q.w);
        let p1 = R::sum_prod4(u1.x, q.x, u1.y, q.y, u1.z, q.z, u1.w, q.w);
        let h = Vector4 {
            x: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), q.x), p0, u0.x), p1, u1.x,
                ),
            ),
            y: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), q.y), p0, u0.y), p1, u1.y,
                ),
            ),
            z: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), q.z), p0, u0.z), p1, u1.z,
                ),
            ),
            w: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), q.w), p0, u0.w), p1, u1.w,
                ),
            ),
        };
        let nh = R::norm4(h.x, h.y, h.z, h.w);
        if nh < R::HALF {
            return Self::complete2(u0, u1);
        }
        {
            let (q0, q1, q2, q3) = R::div4(h.x, h.y, h.z, h.w, nh);
            Vector4 { x: q0, y: q1, z: q2, w: q3 }
        }
    }
    /// The left singular vector `u_3` from `w = M v_3` and the orthonormal `u_0 .. u_2`:
    /// classical Gram-Schmidt run TWICE, `g = w - Σ <u_l, w> u_l`, `q = g / |g|`, `h = q - Σ
    /// <u_l, q> u_l`, `u_3 = h / |h|` (one fused sum per dot product and per component), or
    /// `complete3` when `g` vanishes EXACTLY or when the second pass keeps less than half of
    /// `|q| >= 1` (the DGKS criterion: `q` then lies numerically in the span of the previous
    /// vectors — on a rank-deficient `M`, `w` is rounding noise of a few raw units and so is its
    /// direction; measured on the `Svd6` oracle: `|UᵀU - I|` of 1.4 without the test). Shared by
    /// every SVD with 4 rows.
    fn gs3(u0: Vector4<T>, u1: Vector4<T>, u2: Vector4<T>, w: Vector4<T>) -> Vector4<T> {
        revoke_ap_tracking();
        let p0 = R::sum_prod4(u0.x, w.x, u0.y, w.y, u0.z, w.z, u0.w, w.w);
        let p1 = R::sum_prod4(u1.x, w.x, u1.y, w.y, u1.z, w.z, u1.w, w.w);
        let p2 = R::sum_prod4(u2.x, w.x, u2.y, w.y, u2.z, w.z, u2.w, w.w);
        let g = Vector4 {
            x: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), w.x), p0, u0.x), p1, u1.x,
                    ),
                    p2,
                    u2.x,
                ),
            ),
            y: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), w.y), p0, u0.y), p1, u1.y,
                    ),
                    p2,
                    u2.y,
                ),
            ),
            z: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), w.z), p0, u0.z), p1, u1.z,
                    ),
                    p2,
                    u2.z,
                ),
            ),
            w: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), w.w), p0, u0.w), p1, u1.w,
                    ),
                    p2,
                    u2.w,
                ),
            ),
        };
        let n = R::norm4(g.x, g.y, g.z, g.w);
        if n == R::zero() {
            return Self::complete3(u0, u1, u2);
        }
        let q = {
            let (q0, q1, q2, q3) = R::div4(g.x, g.y, g.z, g.w, n);
            Vector4 { x: q0, y: q1, z: q2, w: q3 }
        };
        let p0 = R::sum_prod4(u0.x, q.x, u0.y, q.y, u0.z, q.z, u0.w, q.w);
        let p1 = R::sum_prod4(u1.x, q.x, u1.y, q.y, u1.z, q.z, u1.w, q.w);
        let p2 = R::sum_prod4(u2.x, q.x, u2.y, q.y, u2.z, q.z, u2.w, q.w);
        let h = Vector4 {
            x: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), q.x), p0, u0.x), p1, u1.x,
                    ),
                    p2,
                    u2.x,
                ),
            ),
            y: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), q.y), p0, u0.y), p1, u1.y,
                    ),
                    p2,
                    u2.y,
                ),
            ),
            z: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), q.z), p0, u0.z), p1, u1.z,
                    ),
                    p2,
                    u2.z,
                ),
            ),
            w: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), q.w), p0, u0.w), p1, u1.w,
                    ),
                    p2,
                    u2.w,
                ),
            ),
        };
        let nh = R::norm4(h.x, h.y, h.z, h.w);
        if nh < R::HALF {
            return Self::complete3(u0, u1, u2);
        }
        {
            let (q0, q1, q2, q3) = R::div4(h.x, h.y, h.z, h.w, nh);
            Vector4 { x: q0, y: q1, z: q2, w: q3 }
        }
    }
    /// A unit 4-vector orthogonal to the 1 orthonormal `u*`: the axis `e_i` whose squared
    /// projection `Σ u_l[i]²` onto their span is the SMALLEST (ties to the earlier axis; it is at
    /// most 1/4, so the residual has a squared norm of at least 3/4), stripped of that
    /// projection in one fused sum per component and normalised.
    #[inline(never)]
    fn complete1(u0: Vector4<T>) -> Vector4<T> {
        revoke_ap_tracking();
        let c0 = u0.x * u0.x;
        let c1 = u0.y * u0.y;
        let c2 = u0.z * u0.z;
        let c3 = u0.w * u0.w;
        let mut best: usize = 0;
        let mut cb = c0;
        if c1 < cb {
            best = 1;
            cb = c1;
        }
        if c2 < cb {
            best = 2;
            cb = c2;
        }
        if c3 < cb {
            best = 3;
            cb = c3;
        }
        let _ = cb;
        let a0 = if best == 0 {
            u0.x
        } else if best == 1 {
            u0.y
        } else if best == 2 {
            u0.z
        } else {
            u0.w
        };
        let r = Vector4 {
            x: R::mul_add(-a0, u0.x, if best == 0 {
                R::one()
            } else {
                R::zero()
            }),
            y: R::mul_add(-a0, u0.y, if best == 1 {
                R::one()
            } else {
                R::zero()
            }),
            z: R::mul_add(-a0, u0.z, if best == 2 {
                R::one()
            } else {
                R::zero()
            }),
            w: R::mul_add(-a0, u0.w, if best == 3 {
                R::one()
            } else {
                R::zero()
            }),
        };
        {
            let (q0, q1, q2, q3) = R::div4(r.x, r.y, r.z, r.w, R::norm4(r.x, r.y, r.z, r.w));
            Vector4 { x: q0, y: q1, z: q2, w: q3 }
        }
    }
    /// A unit 4-vector orthogonal to the 2 orthonormal `u*`: the axis `e_i` whose squared
    /// projection `Σ u_l[i]²` onto their span is the SMALLEST (ties to the earlier axis; it is at
    /// most 2/4, so the residual has a squared norm of at least 2/4), stripped of that
    /// projection in one fused sum per component and normalised.
    #[inline(never)]
    fn complete2(u0: Vector4<T>, u1: Vector4<T>) -> Vector4<T> {
        revoke_ap_tracking();
        let c0 = R::sum_prod2(u0.x, u0.x, u1.x, u1.x);
        let c1 = R::sum_prod2(u0.y, u0.y, u1.y, u1.y);
        let c2 = R::sum_prod2(u0.z, u0.z, u1.z, u1.z);
        let c3 = R::sum_prod2(u0.w, u0.w, u1.w, u1.w);
        let mut best: usize = 0;
        let mut cb = c0;
        if c1 < cb {
            best = 1;
            cb = c1;
        }
        if c2 < cb {
            best = 2;
            cb = c2;
        }
        if c3 < cb {
            best = 3;
            cb = c3;
        }
        let _ = cb;
        let a0 = if best == 0 {
            u0.x
        } else if best == 1 {
            u0.y
        } else if best == 2 {
            u0.z
        } else {
            u0.w
        };
        let a1 = if best == 0 {
            u1.x
        } else if best == 1 {
            u1.y
        } else if best == 2 {
            u1.z
        } else {
            u1.w
        };
        let r = Vector4 {
            x: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_add(R::wide_zero(), if best == 0 {
                            R::one()
                        } else {
                            R::zero()
                        }),
                        a0,
                        u0.x,
                    ),
                    a1,
                    u1.x,
                ),
            ),
            y: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_add(R::wide_zero(), if best == 1 {
                            R::one()
                        } else {
                            R::zero()
                        }),
                        a0,
                        u0.y,
                    ),
                    a1,
                    u1.y,
                ),
            ),
            z: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_add(R::wide_zero(), if best == 2 {
                            R::one()
                        } else {
                            R::zero()
                        }),
                        a0,
                        u0.z,
                    ),
                    a1,
                    u1.z,
                ),
            ),
            w: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_add(R::wide_zero(), if best == 3 {
                            R::one()
                        } else {
                            R::zero()
                        }),
                        a0,
                        u0.w,
                    ),
                    a1,
                    u1.w,
                ),
            ),
        };
        {
            let (q0, q1, q2, q3) = R::div4(r.x, r.y, r.z, r.w, R::norm4(r.x, r.y, r.z, r.w));
            Vector4 { x: q0, y: q1, z: q2, w: q3 }
        }
    }
    /// A unit 4-vector orthogonal to the 3 orthonormal `u*`: the axis `e_i` whose squared
    /// projection `Σ u_l[i]²` onto their span is the SMALLEST (ties to the earlier axis; it is at
    /// most 3/4, so the residual has a squared norm of at least 1/4), stripped of that
    /// projection in one fused sum per component and normalised.
    #[inline(never)]
    fn complete3(u0: Vector4<T>, u1: Vector4<T>, u2: Vector4<T>) -> Vector4<T> {
        revoke_ap_tracking();
        let c0 = R::sum_prod3(u0.x, u0.x, u1.x, u1.x, u2.x, u2.x);
        let c1 = R::sum_prod3(u0.y, u0.y, u1.y, u1.y, u2.y, u2.y);
        let c2 = R::sum_prod3(u0.z, u0.z, u1.z, u1.z, u2.z, u2.z);
        let c3 = R::sum_prod3(u0.w, u0.w, u1.w, u1.w, u2.w, u2.w);
        let mut best: usize = 0;
        let mut cb = c0;
        if c1 < cb {
            best = 1;
            cb = c1;
        }
        if c2 < cb {
            best = 2;
            cb = c2;
        }
        if c3 < cb {
            best = 3;
            cb = c3;
        }
        let _ = cb;
        let a0 = if best == 0 {
            u0.x
        } else if best == 1 {
            u0.y
        } else if best == 2 {
            u0.z
        } else {
            u0.w
        };
        let a1 = if best == 0 {
            u1.x
        } else if best == 1 {
            u1.y
        } else if best == 2 {
            u1.z
        } else {
            u1.w
        };
        let a2 = if best == 0 {
            u2.x
        } else if best == 1 {
            u2.y
        } else if best == 2 {
            u2.z
        } else {
            u2.w
        };
        let r = Vector4 {
            x: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_add(
                                R::wide_zero(), if best == 0 {
                                    R::one()
                                } else {
                                    R::zero()
                                },
                            ),
                            a0,
                            u0.x,
                        ),
                        a1,
                        u1.x,
                    ),
                    a2,
                    u2.x,
                ),
            ),
            y: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_add(
                                R::wide_zero(), if best == 1 {
                                    R::one()
                                } else {
                                    R::zero()
                                },
                            ),
                            a0,
                            u0.y,
                        ),
                        a1,
                        u1.y,
                    ),
                    a2,
                    u2.y,
                ),
            ),
            z: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_add(
                                R::wide_zero(), if best == 2 {
                                    R::one()
                                } else {
                                    R::zero()
                                },
                            ),
                            a0,
                            u0.z,
                        ),
                        a1,
                        u1.z,
                    ),
                    a2,
                    u2.z,
                ),
            ),
            w: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_add(
                                R::wide_zero(), if best == 3 {
                                    R::one()
                                } else {
                                    R::zero()
                                },
                            ),
                            a0,
                            u0.w,
                        ),
                        a1,
                        u1.w,
                    ),
                    a2,
                    u2.w,
                ),
            ),
        };
        {
            let (q0, q1, q2, q3) = R::div4(r.x, r.y, r.z, r.w, R::norm4(r.x, r.y, r.z, r.w));
            Vector4 { x: q0, y: q1, z: q2, w: q3 }
