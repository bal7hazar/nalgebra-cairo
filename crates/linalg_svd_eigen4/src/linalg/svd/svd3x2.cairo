        self: Matrix3x2<T>, compute_u: bool, compute_v: bool, eps: T, max_niter: usize,
    ) -> Option<Svd3x2<T>> {
        Svd3x2Trait::try_new(self, compute_u, compute_v, eps, max_niter)
    }

    /// The singular values alone, DESCENDING: the decomposition without the left vectors
    /// (bit-identical to `svd(false, false).singular_values` and to the full decomposition's, and
    /// no dearer than the former: `bench_svd3x2_singular_values__*`). Upstream:
    /// `Matrix::singular_values`.
    fn singular_values(self: Matrix3x2<T>) -> Vector2<T> {
        Svd3x2InternalTrait::values_from_right(self, Svd3x2InternalTrait::right(self))
    }

    /// `singular_values` (sorted; see `Svd3x2Trait::new_unordered`). Upstream:
    /// `Matrix::singular_values_unordered`.
    #[inline(always)]
    fn singular_values_unordered(self: Matrix3x2<T>) -> Vector2<T> {
        Self::singular_values(self)
    }

    /// The number of singular values strictly greater than `eps`, from `singular_values`.
    /// Upstream: `Matrix::rank` (which asserts `eps >= 0`; a negative `eps` counts every value
    /// here).
    fn rank(self: Matrix3x2<T>, eps: T) -> usize {
        let s = Self::singular_values(self);
        let mut n: usize = 0;
        if s.x > eps {
            n += 1;
        }
        if s.y > eps {
            n += 1;
        }
        n
    }

    /// The Moore-Penrose pseudo-inverse, see `Svd3x2Trait::pseudo_inverse`. Upstream:
    /// `Matrix::pseudo_inverse` (`Err` on a negative `eps`; `None` here).
    #[inline(always)]
    fn pseudo_inverse(self: Matrix3x2<T>, eps: T) -> Option<Matrix2x3<T>> {
        Svd3x2Trait::new(self, true, true).pseudo_inverse(eps)
    }

    /// The left polar decomposition `M = P · U`, see `Svd3x2Trait::to_polar`. Upstream:
    /// `Matrix::polar`.
    fn polar(self: Matrix3x2<T>) -> (Matrix3<T>, Matrix3x2<T>) {
        Svd3x2Trait::new(self, true, true).to_polar().unwrap()
    }

    /// `polar`, or `None` when the decomposition did not converge within `eps`, see
    /// `Svd3x2Trait::try_new`. Upstream: `Matrix::try_polar`.
    fn try_polar(
        self: Matrix3x2<T>, eps: T, max_niter: usize,
    ) -> Option<(Matrix3<T>, Matrix3x2<T>)> {
        match Svd3x2Trait::try_new(self, true, true, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
