#[test]
fn test_matrix6_transform_vector() {
    let a: Matrix6<Fixed> = load(
        array![
            8729526487, 11294489232, -9563235125, 8484446318, 4076664393, -4702467729, -3228806115,
            10282886558, 3132144476, -6374748292, -5285443222, -11468705136, 1459712333, 5240267706,
            -10145248256, 9049302788, 15801996116, 1861143477, -7344074749, 16961901953,
            -11904386234, 3114946987, 8690012587, 1641675705, 5230373408, -6720251801, 4331752264,
            10266759302, -4208346503, 8381484797, 1570267883, 7796593508, 2070178002, -3779801478,
            9881703219, 10578497505,
        ]
            .span(),
    );
    let b: Matrix6<Fixed> = load(
        array![
            8729526487, 11294489232, -9563235125, 8484446318, 4076664393, 0, -3228806115,
            10282886558, 3132144476, -6374748292, -5285443222, 0, 1459712333, 5240267706,
            -10145248256, 9049302788, 15801996116, 0, -7344074749, 16961901953, -11904386234,
            3114946987, 8690012587, 0, 5230373408, -6720251801, 4331752264, 10266759302,
            -4208346503, 0, 1570267883, 7796593508, 2070178002, -3779801478, 9881703219,
            10578497505,
        ]
            .span(),
    );
    let v: Vector5<Fixed> = load(
        array![-804375356, -14804525891, 15359332316, 11738235990, 6242203111].span(),
    );
    assert_raws(
        a.transform_vector(v),
        array![151277421, 1197465837, -4819815371, 5133518041, 6172491479].span(),
    );
    assert_raws(
        b.transform_vector(v),
        array![2244930990, 17770187767, -71525233844, 76180527695, 91598715429].span(),
    );
}
