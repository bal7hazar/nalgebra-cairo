/// `iter.sum()` of an iterator of `Matrix5x6`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 5x6 matrix when empty. Upstream: `Sum for Matrix` (a fold
/// from `zero()`: the same result, one addition more).
pub impl Matrix5x6Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<Matrix5x6<T>> {
    fn sum<I, +Iterator<I>[Item: Matrix5x6<T>], +Destruct<I>, +Destruct<Matrix5x6<T>>>(
        mut iter: I,
    ) -> Matrix5x6<T> {
        let Option::Some(mut acc) = iter.next() else {
            return Matrix5x6 {
                m11: R::zero(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m51: R::zero(),
                m12: R::zero(),
                m22: R::zero(),
                m32: R::zero(),
                m42: R::zero(),
                m52: R::zero(),
