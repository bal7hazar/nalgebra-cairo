    fn gt(lhs: RowVector6<T>, rhs: RowVector6<T>) -> bool {
        lhs.x > rhs.x
            && lhs.y > rhs.y
            && lhs.z > rhs.z
            && lhs.w > rhs.w
            && lhs.a > rhs.a
            && lhs.b > rhs.b
    }
    #[inline(always)]
    fn ge(lhs: RowVector6<T>, rhs: RowVector6<T>) -> bool {
        lhs.x >= rhs.x
            && lhs.y >= rhs.y
            && lhs.z >= rhs.z
            && lhs.w >= rhs.w
            && lhs.a >= rhs.a
            && lhs.b >= rhs.b
    }
