impl Matrix6SolveKernelVector6<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Mul<T>, +Neg<T>, +PartialEq<T>,
> of SolveKernel<Matrix6<T>, Vector6<T>> {
    type Scalar = T;

    #[inline(always)]
    fn lower(self: Matrix6<T>, b: Vector6<T>) -> Vector6<T> {
        let x00 = R::div(b.x, self.m11);
        let n10 = -self.m21;
        let x10 = R::div(R::mul_add(n10, x00, b.y), self.m22);
        let x20 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m31, x00),
                    self.m32,
                    x10,
                ),
            ),
            self.m33,
        );
        let x30 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), b.w), self.m41, x00),
                        self.m42,
                        x10,
                    ),
                    self.m43,
                    x20,
                ),
            ),
            self.m44,
        );
        let x40 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(R::wide_add(R::wide_zero(), b.a), self.m51, x00),
                            self.m52,
                            x10,
                        ),
                        self.m53,
                        x20,
                    ),
                    self.m54,
                    x30,
                ),
            ),
            self.m55,
        );
        let x50 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.b), self.m61, x00),
                                self.m62,
                                x10,
                            ),
                            self.m63,
                            x20,
                        ),
                        self.m64,
                        x30,
                    ),
                    self.m65,
                    x40,
                ),
            ),
            self.m66,
        );
        Vector6 { x: x00, y: x10, z: x20, w: x30, a: x40, b: x50 }
    }

    #[inline(always)]
    fn upper(self: Matrix6<T>, b: Vector6<T>) -> Vector6<T> {
        let x50 = R::div(b.b, self.m66);
        let n45 = -self.m56;
        let x40 = R::div(R::mul_add(n45, x50, b.a), self.m55);
        let x30 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.w), self.m46, x50),
                    self.m45,
                    x40,
                ),
            ),
            self.m44,
        );
        let x20 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m36, x50),
                        self.m35,
                        x40,
                    ),
                    self.m34,
                    x30,
                ),
            ),
            self.m33,
        );
        let x10 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(R::wide_add(R::wide_zero(), b.y), self.m26, x50),
                            self.m25,
                            x40,
                        ),
                        self.m24,
                        x30,
                    ),
                    self.m23,
                    x20,
                ),
            ),
            self.m22,
        );
        let x00 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.x), self.m16, x50),
                                self.m15,
                                x40,
                            ),
                            self.m14,
                            x30,
                        ),
                        self.m13,
                        x20,
                    ),
                    self.m12,
                    x10,
                ),
            ),
            self.m11,
        );
        Vector6 { x: x00, y: x10, z: x20, w: x30, a: x40, b: x50 }
    }

    #[inline(always)]
    fn lower_unit(self: Matrix6<T>, b: Vector6<T>) -> Vector6<T> {
        let x00 = b.x;
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, x00, b.y);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m31, x00), self.m32, x10,
            ),
        );
        let x30 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.w), self.m41, x00),
                    self.m42,
                    x10,
                ),
                self.m43,
                x20,
            ),
        );
        let x40 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), b.a), self.m51, x00),
                        self.m52,
                        x10,
                    ),
                    self.m53,
                    x20,
                ),
                self.m54,
                x30,
            ),
        );
        let x50 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(R::wide_add(R::wide_zero(), b.b), self.m61, x00),
                            self.m62,
                            x10,
                        ),
                        self.m63,
                        x20,
                    ),
                    self.m64,
                    x30,
                ),
                self.m65,
                x40,
            ),
        );
        Vector6 { x: x00, y: x10, z: x20, w: x30, a: x40, b: x50 }
    }

    #[inline(always)]
    fn lower_with_diag(self: Matrix6<T>, b: Vector6<T>, diag: T) -> Vector6<T> {
        let x00 = b.x;
        let q00 = R::div(x00, diag);
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, q00, b.y);
        let q10 = R::div(x10, diag);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m31, q00), self.m32, q10,
            ),
        );
        let q20 = R::div(x20, diag);
        let x30 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.w), self.m41, q00),
                    self.m42,
                    q10,
                ),
                self.m43,
                q20,
            ),
        );
        let q30 = R::div(x30, diag);
        let x40 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), b.a), self.m51, q00),
                        self.m52,
                        q10,
                    ),
                    self.m53,
                    q20,
                ),
                self.m54,
                q30,
            ),
        );
        let q40 = R::div(x40, diag);
        let x50 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(R::wide_add(R::wide_zero(), b.b), self.m61, q00),
                            self.m62,
                            q10,
                        ),
                        self.m63,
                        q20,
                    ),
                    self.m64,
                    q30,
                ),
                self.m65,
                q40,
            ),
        );
        Vector6 { x: x00, y: x10, z: x20, w: x30, a: x40, b: x50 }
    }

    #[inline(always)]
    fn nonzero_diagonal(self: Matrix6<T>) -> bool {
        self.m11 != R::zero()
            && self.m22 != R::zero()
            && self.m33 != R::zero()
            && self.m44 != R::zero()
            && self.m55 != R::zero()
            && self.m66 != R::zero()
    }

    #[inline(always)]
    fn is_zero(x: T) -> bool {
        x == R::zero()
    }

    #[inline(always)]
    fn tr_mul_rhs(self: Matrix6<T>, b: Vector6<T>) -> Vector6<T> {
        MatrixTrMul::tr_mul(self, b)
    }
}

