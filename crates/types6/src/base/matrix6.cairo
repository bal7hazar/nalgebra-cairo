        lhs.m11 < rhs.m11
            && lhs.m21 < rhs.m21
            && lhs.m31 < rhs.m31
            && lhs.m41 < rhs.m41
            && lhs.m51 < rhs.m51
            && lhs.m61 < rhs.m61
            && lhs.m12 < rhs.m12
            && lhs.m22 < rhs.m22
            && lhs.m32 < rhs.m32
            && lhs.m42 < rhs.m42
            && lhs.m52 < rhs.m52
            && lhs.m62 < rhs.m62
            && lhs.m13 < rhs.m13
            && lhs.m23 < rhs.m23
            && lhs.m33 < rhs.m33
