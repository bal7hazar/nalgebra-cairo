    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>,
> of MatrixTrMul<Matrix6<T>, Vector6<T>> {
    type Output = Vector6<T>;
    #[inline(always)]
    fn tr_mul(self: Matrix6<T>, rhs: Vector6<T>) -> Vector6<T> {
        MatrixMul::mul_mat(
