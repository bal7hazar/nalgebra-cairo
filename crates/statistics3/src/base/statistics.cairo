    fn sum(self: Matrix3x2<T>) -> T {
        R::wide_rescale(
            R::wide_add(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21), self.m31,
                        ),
                        self.m12,
                    ),
                    self.m22,
                ),
                self.m32,
            ),
        )
    }

    /// The product of all the components, left to right in column-major order (upstream's fold),
    /// each product floored. Panics on overflow. Upstream: `product`.
    #[inline(always)]
    fn product(self: Matrix3x2<T>) -> T {
        self.m11 * self.m21 * self.m31 * self.m12 * self.m22 * self.m32
    }

    /// The mean of all the components: their exact sum divided by 6, correctly rounded (to nearest,
    /// ties to even, like `f64 /`). Panics if the sum overflows. Upstream: `mean`.
    fn mean(self: Matrix3x2<T>) -> T {
        let n = R::from_int(6);
        R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21),
                                self.m31,
                            ),
                            self.m12,
                        ),
                        self.m22,
                    ),
                    self.m32,
                ),
            ),
            n,
        )
    }

    /// The population variance of all the components, upstream's two-pass formula `sum((x -
    /// mean)^2) / n`: the mean correctly rounded, the differences exact, their squares summed
    /// exactly and floored once, the quotient by 6 correctly rounded. Panics on overflow. Upstream:
    /// `variance`.
    fn variance(self: Matrix3x2<T>) -> T {
        let n = R::from_int(6);
        let m0 = R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(R::wide_add(R::wide_zero(), self.m11), self.m21),
                                self.m31,
                            ),
                            self.m12,
                        ),
                        self.m22,
                    ),
                    self.m32,
                ),
            ),
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m12 - m0;
            let d4 = self.m22 - m0;
            let d5 = self.m32 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        R::div(s0, n)
    }

    /// The sum of each column, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `row_sum`.
    fn row_sum(self: Matrix3x2<T>) -> RowVector2<T> {
        RowVector2 { x: self.m11 + self.m21 + self.m31, y: self.m12 + self.m22 + self.m32 }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Matrix3x2<T>) -> Vector2<T> {
        let r = Self::row_sum(self);
        Vector2 { x: r.x, y: r.y }
    }

    /// The sum of each row, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `column_sum`.
    fn column_sum(self: Matrix3x2<T>) -> Vector3<T> {
        Vector3 { x: self.m11 + self.m12, y: self.m21 + self.m22, z: self.m31 + self.m32 }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Matrix3x2<T>) -> RowVector2<T> {
        RowVector2 { x: self.m11 * self.m21 * self.m31, y: self.m12 * self.m22 * self.m32 }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Matrix3x2<T>) -> Vector2<T> {
        let r = Self::row_product(self);
        Vector2 { x: r.x, y: r.y }
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Matrix3x2<T>) -> Vector3<T> {
        Vector3 { x: self.m11 * self.m12, y: self.m21 * self.m22, z: self.m31 * self.m32 }
    }

    /// The mean of each column: its exact sum divided by 3, correctly rounded. Panics if a sum
    /// overflows. Upstream: `row_mean`.
    fn row_mean(self: Matrix3x2<T>) -> RowVector2<T> {
        let n = R::from_int(3);
        let m0 = R::div(self.m11 + self.m21 + self.m31, n);
        let m1 = R::div(self.m12 + self.m22 + self.m32, n);
        RowVector2 { x: m0, y: m1 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Matrix3x2<T>) -> Vector2<T> {
        let r = Self::row_mean(self);
        Vector2 { x: r.x, y: r.y }
    }

    /// The mean of each row: its exact sum divided by 2, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix3x2<T>) -> Vector3<T> {
        let n = R::from_int(2);
        let (m0, m1, m2) = R::div3(
            self.m11 + self.m12, self.m21 + self.m22, self.m31 + self.m32, n,
        );
        Vector3 { x: m0, y: m1, z: m2 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 3`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix3x2<T>) -> RowVector2<T> {
        let n = R::from_int(3);
        let m0 = R::div(self.m11 + self.m21 + self.m31, n);
        let m1 = R::div(self.m12 + self.m22 + self.m32, n);
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            R::norm_squared3(d0, d1, d2)
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            R::norm_squared3(d0, d1, d2)
        };
        let v0 = R::div(s0, n);
        let v1 = R::div(s1, n);
        RowVector2 { x: v0, y: v1 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix3x2<T>) -> Vector2<T> {
        let r = Self::row_variance(self);
        Vector2 { x: r.x, y: r.y }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 2`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix3x2<T>) -> Vector3<T> {
        let n = R::from_int(2);
        let (m0, m1, m2) = R::div3(
            self.m11 + self.m12, self.m21 + self.m22, self.m31 + self.m32, n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            R::norm_squared2(d0, d1)
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            R::norm_squared2(d0, d1)
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            R::norm_squared2(d0, d1)
        };
        let (v0, v1, v2) = R::div3(s0, s1, s2, n);
        Vector3 { x: v0, y: v1, z: v2 }
    }
}

/// The statistics of `Matrix3<T>` (upstream `base/statistics.rs`): sums, products, means and
/// variances of all the components, of each column (`row_*`, `row_*_tr`) and of each row
/// (`column_*`). By value, unrolled, no loop.
#[generate_trait]
pub impl Matrix3StatisticsImpl<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Add<T>, +Sub<T>, +Mul<T>,
> of Matrix3StatisticsTrait<T> {
    /// The sum of all the components in column-major order (upstream's iteration order), exact: ONE
    /// `Real::Wide` accumulator (only the total can overflow, like upstream's f64 partial sums).
    /// Panics on overflow. Upstream: `sum`.
    #[inline(always)]
    fn sum(self: Matrix3<T>) -> T {
        R::wide_rescale(
            R::wide_add(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(R::wide_zero(), self.m11), self.m21,
                                        ),
                                        self.m31,
                                    ),
                                    self.m12,
                                ),
                                self.m22,
                            ),
                            self.m32,
                        ),
                        self.m13,
                    ),
                    self.m23,
                ),
                self.m33,
            ),
        )
    }

    /// The product of all the components, left to right in column-major order (upstream's fold),
    /// each product floored. Panics on overflow. Upstream: `product`.
    #[inline(always)]
    fn product(self: Matrix3<T>) -> T {
        self.m11
            * self.m21
            * self.m31
            * self.m12
            * self.m22
            * self.m32
            * self.m13
            * self.m23
            * self.m33
    }

    /// The mean of all the components: their exact sum divided by 9, correctly rounded (to nearest,
    /// ties to even, like `f64 /`). Panics if the sum overflows. Upstream: `mean`.
    fn mean(self: Matrix3<T>) -> T {
        let n = R::from_int(9);
        R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(R::wide_zero(), self.m11), self.m21,
                                            ),
                                            self.m31,
                                        ),
                                        self.m12,
                                    ),
                                    self.m22,
                                ),
                                self.m32,
                            ),
                            self.m13,
                        ),
                        self.m23,
                    ),
                    self.m33,
                ),
            ),
            n,
        )
    }

    /// The population variance of all the components, upstream's two-pass formula `sum((x -
    /// mean)^2) / n`: the mean correctly rounded, the differences exact, their squares summed
    /// exactly and floored once, the quotient by 9 correctly rounded. Panics on overflow. Upstream:
    /// `variance`.
    fn variance(self: Matrix3<T>) -> T {
        let n = R::from_int(9);
        let m0 = R::div(
            R::wide_rescale(
                R::wide_add(
                    R::wide_add(
                        R::wide_add(
                            R::wide_add(
                                R::wide_add(
                                    R::wide_add(
                                        R::wide_add(
                                            R::wide_add(
                                                R::wide_add(R::wide_zero(), self.m11), self.m21,
                                            ),
                                            self.m31,
                                        ),
                                        self.m12,
                                    ),
                                    self.m22,
                                ),
                                self.m32,
                            ),
                            self.m13,
                        ),
                        self.m23,
                    ),
                    self.m33,
                ),
            ),
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m12 - m0;
            let d4 = self.m22 - m0;
            let d5 = self.m32 - m0;
            let d6 = self.m13 - m0;
            let d7 = self.m23 - m0;
            let d8 = self.m33 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(
                                            R::wide_add_prod(
                                                R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1,
                                            ),
                                            d2,
                                            d2,
                                        ),
                                        d3,
                                        d3,
                                    ),
                                    d4,
                                    d4,
                                ),
                                d5,
                                d5,
                            ),
                            d6,
                            d6,
                        ),
                        d7,
                        d7,
                    ),
                    d8,
                    d8,
                ),
            )
        };
        R::div(s0, n)
    }

    /// The sum of each column, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `row_sum`.
    fn row_sum(self: Matrix3<T>) -> RowVector3<T> {
        RowVector3 {
            x: self.m11 + self.m21 + self.m31,
            y: self.m12 + self.m22 + self.m32,
            z: self.m13 + self.m23 + self.m33,
        }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Matrix3<T>) -> Vector3<T> {
        let r = Self::row_sum(self);
        Vector3 { x: r.x, y: r.y, z: r.z }
    }

    /// The sum of each row, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `column_sum`.
    fn column_sum(self: Matrix3<T>) -> Vector3<T> {
        Vector3 {
            x: self.m11 + self.m12 + self.m13,
            y: self.m21 + self.m22 + self.m23,
            z: self.m31 + self.m32 + self.m33,
        }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Matrix3<T>) -> RowVector3<T> {
        RowVector3 {
            x: self.m11 * self.m21 * self.m31,
            y: self.m12 * self.m22 * self.m32,
            z: self.m13 * self.m23 * self.m33,
        }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Matrix3<T>) -> Vector3<T> {
        let r = Self::row_product(self);
        Vector3 { x: r.x, y: r.y, z: r.z }
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Matrix3<T>) -> Vector3<T> {
        Vector3 {
            x: self.m11 * self.m12 * self.m13,
            y: self.m21 * self.m22 * self.m23,
            z: self.m31 * self.m32 * self.m33,
        }
    }

    /// The mean of each column: its exact sum divided by 3, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `row_mean`.
    fn row_mean(self: Matrix3<T>) -> RowVector3<T> {
        let n = R::from_int(3);
        let (m0, m1, m2) = R::div3(
            self.m11 + self.m21 + self.m31,
            self.m12 + self.m22 + self.m32,
            self.m13 + self.m23 + self.m33,
            n,
        );
        RowVector3 { x: m0, y: m1, z: m2 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Matrix3<T>) -> Vector3<T> {
        let r = Self::row_mean(self);
        Vector3 { x: r.x, y: r.y, z: r.z }
    }

    /// The mean of each row: its exact sum divided by 3, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix3<T>) -> Vector3<T> {
        let n = R::from_int(3);
        let (m0, m1, m2) = R::div3(
            self.m11 + self.m12 + self.m13,
            self.m21 + self.m22 + self.m23,
            self.m31 + self.m32 + self.m33,
            n,
        );
        Vector3 { x: m0, y: m1, z: m2 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 3`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix3<T>) -> RowVector3<T> {
        let n = R::from_int(3);
        let (m0, m1, m2) = R::div3(
            self.m11 + self.m21 + self.m31,
            self.m12 + self.m22 + self.m32,
            self.m13 + self.m23 + self.m33,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            R::norm_squared3(d0, d1, d2)
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            R::norm_squared3(d0, d1, d2)
        };
        let s2 = {
            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            let d2 = self.m33 - m2;
            R::norm_squared3(d0, d1, d2)
        };
        let (v0, v1, v2) = R::div3(s0, s1, s2, n);
        RowVector3 { x: v0, y: v1, z: v2 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix3<T>) -> Vector3<T> {
        let r = Self::row_variance(self);
        Vector3 { x: r.x, y: r.y, z: r.z }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 3`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix3<T>) -> Vector3<T> {
        let n = R::from_int(3);
        let (m0, m1, m2) = R::div3(
            self.m11 + self.m12 + self.m13,
            self.m21 + self.m22 + self.m23,
            self.m31 + self.m32 + self.m33,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            R::norm_squared3(d0, d1, d2)
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            R::norm_squared3(d0, d1, d2)
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            let d2 = self.m33 - m2;
            R::norm_squared3(d0, d1, d2)
