#[test]
fn test_matrix2x3_componentwise() {
    let a: Matrix2x3<Fixed> = load(
        array![16680206568, 24044534118, 47790610280, 46021758311, -44351748689, -55554092825]
            .span(),
    );
    let b: Matrix2x3<Fixed> = load(
        array![4608263537, 2264022961, 9744987625, -4351005370, -8149806751, -11848499733].span(),
    );
    let c: Matrix2x3<Fixed> = load(
        array![59624425163, 15597685381, -52343430431, 47853202879, -60995230126, 22578897517]
            .span(),
    );
    assert_raws(
        a.component_mul(b),
        array![17896943659, 12674689602, 108433632592, -46622221719, 84158540909, 153256732505]
            .span(),
    );
    assert_raws(
        a.component_div(b),
        array![15546190257, 45613710401, 21063044522, -45429028475, 23373475710, 20137824806]
            .span(),
    );
    let mut m = a;
    m.component_mul_assign(b);
    assert_raws(
        m,
        array![17896943659, 12674689602, 108433632592, -46622221719, 84158540909, 153256732505]
            .span(),
    );
    let mut d = a;
    d.component_div_assign(b);
    assert_raws(
        d,
        array![15546190257, 45613710401, 21063044522, -45429028475, 23373475710, 20137824806]
            .span(),
    );
    assert_raws(
        a.inf(c),
        array![16680206568, 15597685381, -52343430431, 46021758311, -60995230126, -55554092825]
            .span(),
    );
    assert_raws(
        a.sup(c),
        array![59624425163, 24044534118, 47790610280, 47853202879, -44351748689, 22578897517]
            .span(),
    );
    let (lo, hi) = a.inf_sup(c);
    assert_raws(
        lo,
        array![16680206568, 15597685381, -52343430431, 46021758311, -60995230126, -55554092825]
            .span(),
    );
    assert_raws(
        hi,
        array![59624425163, 24044534118, 47790610280, 47853202879, -44351748689, 22578897517]
            .span(),
    );
    assert_raws(
        a.add_scalar(fx(34129639265)),
        array![50809845833, 58174173383, 81920249545, 80151397576, -10222109424, -21424453560]
            .span(),
    );
    let mut p = c;
    p.cmpy(fx(16918046531), a, b, fx(-3559310170));
    assert_raws(
        p,
        array![21085027310, 37000046171, 470502242907, -223303518279, 382051582913, 584972843566]
            .span(),
    );
    let mut q = c;
    q.cdpy(fx(16918046531), a, b, fx(-3559310170));
    assert_raws(
        q,
        array![11825316418, 166748155562, 126346031103, -218603482768, 142616800165, 60612186219]
            .span(),
    );
    let mut e = a;
    e *= fx(34129639265);
    assert_raws(
        e,
        array![132548025118, 191068108133, 379764542242, 365708491181, -352437883506, -441456480840]
            .span(),
    );
    let mut g = a;
    g /= fx(10223386478);
    assert_raws(
        g,
        array![7007554870, 10101397214, 20077408660, 19334292729, -18632701654, -23338940806]
            .span(),
    );
}

