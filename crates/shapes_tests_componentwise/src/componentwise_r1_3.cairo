#[test]
fn test_vector3_componentwise() {
    let a: Vector3<Fixed> = load(array![25768242698, 21112994377, -66499084169].span());
    let b: Vector3<Fixed> = load(array![10463132351, -8960467306, 4651235708].span());
    let c: Vector3<Fixed> = load(array![-32973717827, 48057341467, -40910262550].span());
    assert_raws(a.component_mul(b), array![62774991104, -44047435710, -72015196746].span());
    assert_raws(a.component_div(b), array![10577497823, -10119965541, -61405486552].span());
    let mut m = a;
    m.component_mul_assign(b);
    assert_raws(m, array![62774991104, -44047435710, -72015196746].span());
