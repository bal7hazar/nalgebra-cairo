/// `full_piv_lu4x6_rank` (oracle): on EXACTLY rank-deficient matrices of rank `k`, the first `k`
/// pivots are the large ones and the others are rounding noise (rank-revealing), `P A Q = L U`.
#[test]
fn test_oracle_full_piv_lu4x6_rank() {
    let mut cases = oracle::full_piv_lu4x6_rank_cases();
    let (mut lo, mut hi, mut rec) = (0xffffffffffffffff_u128, 0_u128, 0);
    while let Some(case) = cases.pop_front() {
        let (a, k, _) = *case;
        let a = black_box(mat4x6(a));
        let f = a.full_piv_lu();
        let d = array![abs_raw(f.lu.m11), abs_raw(f.lu.m22), abs_raw(f.lu.m33), abs_raw(f.lu.m44)];
        let k: u32 = (k / ONE).try_into().unwrap();
        let mut i: u32 = 0;
        let mut ds = d.span();
        while let Some(x) = ds.pop_front() {
            if i < k {
                lo = min(lo, *x);
            } else {
                hi = max(hi, *x);
            }
            i += 1;
        }
        let mut pa = a;
        f.p.permute_rows(ref pa);
        f.q.permute_columns(ref pa);
        rec = max(rec, max_ulp_4x6(f.l().mul_mat(f.u()), pa));
    }
    assert!(hi <= 2 && lo >= 17179869184 && rec <= 2, "measured {} {} {}", hi, lo, rec);
}

