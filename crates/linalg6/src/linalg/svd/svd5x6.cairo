                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a1_0, u.m21), a1_1, u.m22,
                        ),
                        a1_2,
                        u.m23,
                    ),
                    a1_3,
                    u.m24,
                ),
                a1_4,
                u.m25,
            ),
        );
        let p1_2 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a1_0, u.m31), a1_1, u.m32,
                        ),
                        a1_2,
                        u.m33,
                    ),
                    a1_3,
                    u.m34,
                ),
                a1_4,
                u.m35,
            ),
        );
        let p1_3 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a1_0, u.m41), a1_1, u.m42,
                        ),
                        a1_2,
                        u.m43,
                    ),
                    a1_3,
                    u.m44,
                ),
                a1_4,
                u.m45,
            ),
        );
        let p1_4 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a1_0, u.m51), a1_1, u.m52,
                        ),
                        a1_2,
                        u.m53,
                    ),
                    a1_3,
                    u.m54,
                ),
                a1_4,
                u.m55,
            ),
        );
        let p2_2 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a2_0, u.m31), a2_1, u.m32,
                        ),
                        a2_2,
                        u.m33,
                    ),
                    a2_3,
                    u.m34,
                ),
                a2_4,
                u.m35,
            ),
        );
        let p2_3 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a2_0, u.m41), a2_1, u.m42,
                        ),
                        a2_2,
                        u.m43,
                    ),
                    a2_3,
                    u.m44,
                ),
                a2_4,
                u.m45,
            ),
        );
        let p2_4 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a2_0, u.m51), a2_1, u.m52,
                        ),
                        a2_2,
                        u.m53,
                    ),
                    a2_3,
                    u.m54,
                ),
                a2_4,
                u.m55,
            ),
        );
        let p3_3 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a3_0, u.m41), a3_1, u.m42,
                        ),
                        a3_2,
                        u.m43,
                    ),
                    a3_3,
                    u.m44,
                ),
                a3_4,
                u.m45,
            ),
        );
        let p3_4 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a3_0, u.m51), a3_1, u.m52,
                        ),
                        a3_2,
                        u.m53,
                    ),
                    a3_3,
                    u.m54,
                ),
                a3_4,
                u.m55,
            ),
        );
        let p4_4 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), a4_0, u.m51), a4_1, u.m52,
                        ),
                        a4_2,
                        u.m53,
                    ),
                    a4_3,
                    u.m54,
                ),
                a4_4,
                u.m55,
            ),
        );
        Some(
            (
                Matrix5 {
                    m11: p0_0,
                    m21: p0_1,
                    m31: p0_2,
                    m41: p0_3,
                    m51: p0_4,
                    m12: p0_1,
                    m22: p1_1,
                    m32: p1_2,
                    m42: p1_3,
                    m52: p1_4,
                    m13: p0_2,
                    m23: p1_2,
                    m33: p2_2,
                    m43: p2_3,
                    m53: p2_4,
                    m14: p0_3,
                    m24: p1_3,
                    m34: p2_3,
                    m44: p3_3,
                    m54: p3_4,
                    m15: p0_4,
                    m25: p1_4,
                    m35: p2_4,
                    m45: p3_4,
                    m55: p4_4,
                },
                u.mul_mat(v_t),
            ),
        )
    }

    /// Sorts the singular values DESCENDING, permuting the columns of `u` and the rows of `v_t`
    /// (those that were computed) with them (stable odd-even transposition network, strict
    /// comparison: equal values keep their order). `new` already returns them sorted, so this
    /// only matters after the fields were edited. Upstream: `SVD::sort_by_singular_values`.
    fn sort_by_singular_values(ref self: Svd5x6<T>) {
        revoke_ap_tracking();
        let (has_u, has_v) = (self.u.is_some(), self.v_t.is_some());
        let u = self
            .u
            .unwrap_or_else(
                || Matrix5 {
                    m11: R::zero(),
                    m21: R::zero(),
                    m31: R::zero(),
                    m41: R::zero(),
                    m51: R::zero(),
                    m12: R::zero(),
                    m22: R::zero(),
                    m32: R::zero(),
                    m42: R::zero(),
                    m52: R::zero(),
                    m13: R::zero(),
                    m23: R::zero(),
                    m33: R::zero(),
                    m43: R::zero(),
                    m53: R::zero(),
                    m14: R::zero(),
                    m24: R::zero(),
                    m34: R::zero(),
                    m44: R::zero(),
                    m54: R::zero(),
                    m15: R::zero(),
                    m25: R::zero(),
                    m35: R::zero(),
                    m45: R::zero(),
                    m55: R::zero(),
                },
            );
        let v_t = self
            .v_t
            .unwrap_or_else(
                || Matrix5x6 {
                    m11: R::zero(),
                    m21: R::zero(),
                    m31: R::zero(),
                    m41: R::zero(),
                    m51: R::zero(),
                    m12: R::zero(),
                    m22: R::zero(),
                    m32: R::zero(),
                    m42: R::zero(),
                    m52: R::zero(),
                    m13: R::zero(),
                    m23: R::zero(),
                    m33: R::zero(),
                    m43: R::zero(),
                    m53: R::zero(),
                    m14: R::zero(),
                    m24: R::zero(),
                    m34: R::zero(),
                    m44: R::zero(),
                    m54: R::zero(),
                    m15: R::zero(),
                    m25: R::zero(),
                    m35: R::zero(),
                    m45: R::zero(),
                    m55: R::zero(),
                    m16: R::zero(),
                    m26: R::zero(),
                    m36: R::zero(),
                    m46: R::zero(),
                    m56: R::zero(),
                },
            );
        let mut s0 = self.singular_values.x;
        let mut s1 = self.singular_values.y;
        let mut s2 = self.singular_values.z;
        let mut s3 = self.singular_values.w;
        let mut s4 = self.singular_values.a;
        let mut uc0 = Vector5 { x: u.m11, y: u.m21, z: u.m31, w: u.m41, a: u.m51 };
        let mut uc1 = Vector5 { x: u.m12, y: u.m22, z: u.m32, w: u.m42, a: u.m52 };
        let mut uc2 = Vector5 { x: u.m13, y: u.m23, z: u.m33, w: u.m43, a: u.m53 };
        let mut uc3 = Vector5 { x: u.m14, y: u.m24, z: u.m34, w: u.m44, a: u.m54 };
        let mut uc4 = Vector5 { x: u.m15, y: u.m25, z: u.m35, w: u.m45, a: u.m55 };
        let mut vr0 = Vector6 {
            x: v_t.m11, y: v_t.m12, z: v_t.m13, w: v_t.m14, a: v_t.m15, b: v_t.m16,
        };
        let mut vr1 = Vector6 {
            x: v_t.m21, y: v_t.m22, z: v_t.m23, w: v_t.m24, a: v_t.m25, b: v_t.m26,
        };
        let mut vr2 = Vector6 {
            x: v_t.m31, y: v_t.m32, z: v_t.m33, w: v_t.m34, a: v_t.m35, b: v_t.m36,
        };
        let mut vr3 = Vector6 {
            x: v_t.m41, y: v_t.m42, z: v_t.m43, w: v_t.m44, a: v_t.m45, b: v_t.m46,
        };
        let mut vr4 = Vector6 {
            x: v_t.m51, y: v_t.m52, z: v_t.m53, w: v_t.m54, a: v_t.m55, b: v_t.m56,
        };
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = uc0;
            let tmp2 = vr0;
            s0 = s1;
            uc0 = uc1;
            vr0 = vr1;
            s1 = tmp0;
            uc1 = tmp1;
            vr1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = uc2;
            let tmp2 = vr2;
            s2 = s3;
            uc2 = uc3;
            vr2 = vr3;
            s3 = tmp0;
            uc3 = tmp1;
            vr3 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = uc1;
            let tmp2 = vr1;
            s1 = s2;
            uc1 = uc2;
            vr1 = vr2;
            s2 = tmp0;
            uc2 = tmp1;
            vr2 = tmp2;
        }
        if s4 > s3 {
            let tmp0 = s3;
            let tmp1 = uc3;
            let tmp2 = vr3;
            s3 = s4;
            uc3 = uc4;
            vr3 = vr4;
            s4 = tmp0;
            uc4 = tmp1;
            vr4 = tmp2;
        }
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = uc0;
            let tmp2 = vr0;
            s0 = s1;
            uc0 = uc1;
            vr0 = vr1;
            s1 = tmp0;
            uc1 = tmp1;
            vr1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = uc2;
            let tmp2 = vr2;
            s2 = s3;
            uc2 = uc3;
            vr2 = vr3;
            s3 = tmp0;
            uc3 = tmp1;
            vr3 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = uc1;
            let tmp2 = vr1;
            s1 = s2;
            uc1 = uc2;
            vr1 = vr2;
            s2 = tmp0;
            uc2 = tmp1;
            vr2 = tmp2;
        }
        if s4 > s3 {
            let tmp0 = s3;
            let tmp1 = uc3;
            let tmp2 = vr3;
            s3 = s4;
            uc3 = uc4;
            vr3 = vr4;
            s4 = tmp0;
            uc4 = tmp1;
            vr4 = tmp2;
        }
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = uc0;
            let tmp2 = vr0;
            s0 = s1;
            uc0 = uc1;
            vr0 = vr1;
            s1 = tmp0;
            uc1 = tmp1;
            vr1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = uc2;
            let tmp2 = vr2;
            s2 = s3;
            uc2 = uc3;
            vr2 = vr3;
            s3 = tmp0;
            uc3 = tmp1;
            vr3 = tmp2;
        }
        let u = Matrix5 {
            m11: uc0.x,
            m21: uc0.y,
            m31: uc0.z,
            m41: uc0.w,
            m51: uc0.a,
            m12: uc1.x,
            m22: uc1.y,
            m32: uc1.z,
            m42: uc1.w,
            m52: uc1.a,
            m13: uc2.x,
            m23: uc2.y,
            m33: uc2.z,
            m43: uc2.w,
            m53: uc2.a,
            m14: uc3.x,
            m24: uc3.y,
            m34: uc3.z,
            m44: uc3.w,
            m54: uc3.a,
            m15: uc4.x,
            m25: uc4.y,
            m35: uc4.z,
            m45: uc4.w,
            m55: uc4.a,
        };
        let v_t = Matrix5x6 {
            m11: vr0.x,
            m21: vr1.x,
            m31: vr2.x,
            m41: vr3.x,
            m51: vr4.x,
            m12: vr0.y,
            m22: vr1.y,
            m32: vr2.y,
            m42: vr3.y,
            m52: vr4.y,
            m13: vr0.z,
            m23: vr1.z,
            m33: vr2.z,
            m43: vr3.z,
            m53: vr4.z,
            m14: vr0.w,
            m24: vr1.w,
            m34: vr2.w,
            m44: vr3.w,
            m54: vr4.w,
            m15: vr0.a,
            m25: vr1.a,
            m35: vr2.a,
            m45: vr3.a,
            m55: vr4.a,
            m16: vr0.b,
            m26: vr1.b,
            m36: vr2.b,
            m46: vr3.b,
            m56: vr4.b,
        };
        self =
            Svd5x6 {
                u: if has_u {
                    Some(u)
                } else {
                    None
                },
                singular_values: Vector5 { x: s0, y: s1, z: s2, w: s3, a: s4 },
                v_t: if has_v {
                    Some(v_t)
                } else {
                    None
                },
            };
    }
}


/// Upstream's `Matrix` methods that go through the SVD, on `Matrix5x6`. Import `Matrix5x6SvdTrait`
/// to use them.
#[generate_trait]
pub impl Matrix5x6SvdImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5x6SvdTrait<T> {
    /// The singular value decomposition, see `Svd5x6Trait::new`. Upstream: `Matrix::svd`.
    #[inline(always)]
    fn svd(self: Matrix5x6<T>, compute_u: bool, compute_v: bool) -> Svd5x6<T> {
        Svd5x6Trait::new(self, compute_u, compute_v)
    }

    /// `svd` (already sorted, see `Svd5x6Trait::new_unordered`). Upstream: `Matrix::svd_unordered`.
    #[inline(always)]
    fn svd_unordered(self: Matrix5x6<T>, compute_u: bool, compute_v: bool) -> Svd5x6<T> {
        Svd5x6Trait::new(self, compute_u, compute_v)
    }

    /// See `Svd5x6Trait::try_new`. Upstream: `Matrix::try_svd`.
    #[inline(always)]
    fn try_svd(
        self: Matrix5x6<T>, compute_u: bool, compute_v: bool, eps: T, max_niter: usize,
    ) -> Option<Svd5x6<T>> {
        Svd5x6Trait::try_new(self, compute_u, compute_v, eps, max_niter)
    }

    /// See `Svd5x6Trait::try_new_unordered`. Upstream: `Matrix::try_svd_unordered`.
    #[inline(always)]
    fn try_svd_unordered(
        self: Matrix5x6<T>, compute_u: bool, compute_v: bool, eps: T, max_niter: usize,
    ) -> Option<Svd5x6<T>> {
        Svd5x6Trait::try_new(self, compute_u, compute_v, eps, max_niter)
    }

    /// The singular values alone, DESCENDING: the decomposition without the left vectors
    /// (bit-identical to `svd(false, false).singular_values` and to the full decomposition's, and
    /// no dearer than the former: `bench_svd5x6_singular_values__*`). Upstream:
    /// `Matrix::singular_values`.
    fn singular_values(self: Matrix5x6<T>) -> Vector5<T> {
        {
            let t = Matrix6x5 {
                m11: self.m11,
                m21: self.m12,
                m31: self.m13,
                m41: self.m14,
                m51: self.m15,
                m61: self.m16,
                m12: self.m21,
                m22: self.m22,
                m32: self.m23,
                m42: self.m24,
                m52: self.m25,
                m62: self.m26,
                m13: self.m31,
                m23: self.m32,
                m33: self.m33,
                m43: self.m34,
                m53: self.m35,
                m63: self.m36,
                m14: self.m41,
                m24: self.m42,
                m34: self.m43,
                m44: self.m44,
                m54: self.m45,
                m64: self.m46,
                m15: self.m51,
                m25: self.m52,
                m35: self.m53,
                m45: self.m54,
                m55: self.m55,
                m65: self.m56,
            };
            Svd6x5InternalTrait::values_from_right(t, Svd6x5InternalTrait::right(t))
        }
    }

    /// `singular_values` (sorted; see `Svd5x6Trait::new_unordered`). Upstream:
    /// `Matrix::singular_values_unordered`.
    #[inline(always)]
    fn singular_values_unordered(self: Matrix5x6<T>) -> Vector5<T> {
        Self::singular_values(self)
    }

    /// The number of singular values strictly greater than `eps`, from `singular_values`.
    /// Upstream: `Matrix::rank` (which asserts `eps >= 0`; a negative `eps` counts every value
    /// here).
    fn rank(self: Matrix5x6<T>, eps: T) -> usize {
        let s = Self::singular_values(self);
        let mut n: usize = 0;
        if s.x > eps {
            n += 1;
        }
        if s.y > eps {
            n += 1;
        }
        if s.z > eps {
            n += 1;
        }
        if s.w > eps {
            n += 1;
        }
        if s.a > eps {
            n += 1;
        }
        n
    }

    /// The Moore-Penrose pseudo-inverse, see `Svd5x6Trait::pseudo_inverse`. Upstream:
    /// `Matrix::pseudo_inverse` (`Err` on a negative `eps`; `None` here).
    #[inline(always)]
    fn pseudo_inverse(self: Matrix5x6<T>, eps: T) -> Option<Matrix6x5<T>> {
        Svd5x6Trait::new(self, true, true).pseudo_inverse(eps)
    }

    /// The left polar decomposition `M = P · U`, see `Svd5x6Trait::to_polar`. Upstream:
    /// `Matrix::polar`.
    fn polar(self: Matrix5x6<T>) -> (Matrix5<T>, Matrix5x6<T>) {
        Svd5x6Trait::new(self, true, true).to_polar().unwrap()
    }

    /// `polar`, or `None` when the decomposition did not converge within `eps`, see
    /// `Svd5x6Trait::try_new`. Upstream: `Matrix::try_polar`.
    fn try_polar(
        self: Matrix5x6<T>, eps: T, max_niter: usize,
    ) -> Option<(Matrix5<T>, Matrix5x6<T>)> {
        match Svd5x6Trait::try_new(self, true, true, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
