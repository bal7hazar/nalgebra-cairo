    fn column_mean(self: Vector4<T>) -> Vector4<T> {
        let m0 = self.x;
        let m1 = self.y;
        let m2 = self.z;
        let m3 = self.w;
        Vector4 { x: m0, y: m1, z: m2, w: m3 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 4`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Vector4<T>) -> Matrix1<T> {
        let n = R::from_int(4);
        let m0 = R::div(self.x + self.y + self.z + self.w, n);
        let s0 = {
            let d0 = self.x - m0;
            let d1 = self.y - m0;
            let d2 = self.z - m0;
