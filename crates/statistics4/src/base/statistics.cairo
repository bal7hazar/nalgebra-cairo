    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Vector4<T>) -> Matrix1<T> {
        Self::row_product(self)
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    #[inline(always)]
    fn column_product(self: Vector4<T>) -> Vector4<T> {
        Vector4 { x: self.x, y: self.y, z: self.z, w: self.w }
    }

    /// The mean of each column: its exact sum divided by 4, correctly rounded. Panics if a sum
    /// overflows. Upstream: `row_mean`.
    fn row_mean(self: Vector4<T>) -> Matrix1<T> {
        let n = R::from_int(4);
        let m0 = R::div(self.x + self.y + self.z + self.w, n);
