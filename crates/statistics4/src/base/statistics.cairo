                                        self.m13,
                                    ),
                                    self.m23,
                                ),
                                self.m33,
                            ),
                            self.m14,
                        ),
                        self.m24,
                    ),
                    self.m34,
                ),
            ),
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m12 - m0;
            let d4 = self.m22 - m0;
            let d5 = self.m32 - m0;
            let d6 = self.m13 - m0;
            let d7 = self.m23 - m0;
            let d8 = self.m33 - m0;
            let d9 = self.m14 - m0;
            let d10 = self.m24 - m0;
            let d11 = self.m34 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(
                                            R::wide_add_prod(
                                                R::wide_add_prod(
                                                    R::wide_add_prod(
                                                        R::wide_add_prod(
                                                            R::wide_add_prod(
                                                                R::wide_zero(), d0, d0,
                                                            ),
                                                            d1,
                                                            d1,
                                                        ),
                                                        d2,
                                                        d2,
                                                    ),
                                                    d3,
                                                    d3,
                                                ),
                                                d4,
                                                d4,
                                            ),
                                            d5,
                                            d5,
                                        ),
                                        d6,
                                        d6,
                                    ),
                                    d7,
                                    d7,
                                ),
                                d8,
                                d8,
                            ),
                            d9,
                            d9,
                        ),
                        d10,
                        d10,
                    ),
                    d11,
                    d11,
                ),
            )
        };
        R::div(s0, n)
    }

    /// The sum of each column, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `row_sum`.
    fn row_sum(self: Matrix3x4<T>) -> RowVector4<T> {
        RowVector4 {
            x: self.m11 + self.m21 + self.m31,
            y: self.m12 + self.m22 + self.m32,
            z: self.m13 + self.m23 + self.m33,
            w: self.m14 + self.m24 + self.m34,
        }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Matrix3x4<T>) -> Vector4<T> {
        let r = Self::row_sum(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The sum of each row, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `column_sum`.
    fn column_sum(self: Matrix3x4<T>) -> Vector3<T> {
        Vector3 {
            x: self.m11 + self.m12 + self.m13 + self.m14,
            y: self.m21 + self.m22 + self.m23 + self.m24,
            z: self.m31 + self.m32 + self.m33 + self.m34,
        }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Matrix3x4<T>) -> RowVector4<T> {
        RowVector4 {
            x: self.m11 * self.m21 * self.m31,
            y: self.m12 * self.m22 * self.m32,
            z: self.m13 * self.m23 * self.m33,
            w: self.m14 * self.m24 * self.m34,
        }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Matrix3x4<T>) -> Vector4<T> {
        let r = Self::row_product(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Matrix3x4<T>) -> Vector3<T> {
        Vector3 {
            x: self.m11 * self.m12 * self.m13 * self.m14,
            y: self.m21 * self.m22 * self.m23 * self.m24,
            z: self.m31 * self.m32 * self.m33 * self.m34,
        }
    }

    /// The mean of each column: its exact sum divided by 3, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `row_mean`.
    fn row_mean(self: Matrix3x4<T>) -> RowVector4<T> {
        let n = R::from_int(3);
        let (m0, m1, m2, m3) = R::div4(
            self.m11 + self.m21 + self.m31,
            self.m12 + self.m22 + self.m32,
            self.m13 + self.m23 + self.m33,
            self.m14 + self.m24 + self.m34,
            n,
        );
        RowVector4 { x: m0, y: m1, z: m2, w: m3 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Matrix3x4<T>) -> Vector4<T> {
        let r = Self::row_mean(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The mean of each row: its exact sum divided by 4, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix3x4<T>) -> Vector3<T> {
        let n = R::from_int(4);
        let (m0, m1, m2) = R::div3(
            self.m11 + self.m12 + self.m13 + self.m14,
            self.m21 + self.m22 + self.m23 + self.m24,
            self.m31 + self.m32 + self.m33 + self.m34,
            n,
        );
        Vector3 { x: m0, y: m1, z: m2 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 3`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix3x4<T>) -> RowVector4<T> {
        let n = R::from_int(3);
        let (m0, m1, m2, m3) = R::div4(
            self.m11 + self.m21 + self.m31,
            self.m12 + self.m22 + self.m32,
            self.m13 + self.m23 + self.m33,
            self.m14 + self.m24 + self.m34,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            R::norm_squared3(d0, d1, d2)
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            R::norm_squared3(d0, d1, d2)
        };
        let s2 = {
            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            let d2 = self.m33 - m2;
            R::norm_squared3(d0, d1, d2)
        };
        let s3 = {
            let d0 = self.m14 - m3;
            let d1 = self.m24 - m3;
            let d2 = self.m34 - m3;
            R::norm_squared3(d0, d1, d2)
        };
        let (v0, v1, v2, v3) = R::div4(s0, s1, s2, s3, n);
        RowVector4 { x: v0, y: v1, z: v2, w: v3 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix3x4<T>) -> Vector4<T> {
        let r = Self::row_variance(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 4`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix3x4<T>) -> Vector3<T> {
        let n = R::from_int(4);
        let (m0, m1, m2) = R::div3(
            self.m11 + self.m12 + self.m13 + self.m14,
            self.m21 + self.m22 + self.m23 + self.m24,
            self.m31 + self.m32 + self.m33 + self.m34,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            let d3 = self.m14 - m0;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            let d3 = self.m24 - m1;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m34 - m2;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let (v0, v1, v2) = R::div3(s0, s1, s2, n);
        Vector3 { x: v0, y: v1, z: v2 }
    }
}

/// The statistics of `Vector4<T>` (upstream `base/statistics.rs`): sums, products, means and
/// variances of all the components, of each column (`row_*`, `row_*_tr`) and of each row
/// (`column_*`). By value, unrolled, no loop.
#[generate_trait]
pub impl Vector4StatisticsImpl<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Add<T>, +Sub<T>, +Mul<T>,
> of Vector4StatisticsTrait<T> {
    /// The product of all the components, left to right in column-major order (upstream's fold),
    /// each product floored. Panics on overflow. Upstream: `product`.
    #[inline(always)]
    fn product(self: Vector4<T>) -> T {
        self.x * self.y * self.z * self.w
    }

    /// The mean of all the components: their exact sum divided by 4, correctly rounded (to nearest,
    /// ties to even, like `f64 /`). Panics if the sum overflows. Upstream: `mean`.
    #[inline(always)]
    fn mean(self: Vector4<T>) -> T {
        let n = R::from_int(4);
        R::div(self.x + self.y + self.z + self.w, n)
    }

    /// The population variance of all the components, upstream's two-pass formula `sum((x -
    /// mean)^2) / n`: the mean correctly rounded, the differences exact, their squares summed
    /// exactly and floored once, the quotient by 4 correctly rounded. Panics on overflow. Upstream:
    /// `variance`.
    #[inline(always)]
    fn variance(self: Vector4<T>) -> T {
        let n = R::from_int(4);
        let m0 = R::div(self.x + self.y + self.z + self.w, n);
        let s0 = {
            let d0 = self.x - m0;
            let d1 = self.y - m0;
            let d2 = self.z - m0;
            let d3 = self.w - m0;
            R::norm_squared4(d0, d1, d2, d3)
        };
        R::div(s0, n)
    }

    /// The sum of each column, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `row_sum`.
    #[inline(always)]
    fn row_sum(self: Vector4<T>) -> Matrix1<T> {
        Matrix1 { x: self.x + self.y + self.z + self.w }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Vector4<T>) -> Matrix1<T> {
        Self::row_sum(self)
    }

    /// The sum of each row, exact (checked `+` left to right). Panics on overflow. Upstream:
    /// `column_sum`.
    #[inline(always)]
    fn column_sum(self: Vector4<T>) -> Vector4<T> {
        Vector4 { x: self.x, y: self.y, z: self.z, w: self.w }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    #[inline(always)]
