            -57567372828, -24917709405, 45286559631, -59187235053, -4959444423, 29957038561,
            51937460782, 59935959600, -30592972817, -67996859508, -50290915479, -27642495250,
        ]
            .span(),
    );
    let c: Matrix6x2<Fixed> = a.columns_range(2..4);
    assert_raws(
        c,
        array![
            -57567372828, -24917709405, 45286559631, -59187235053, -4959444423, 29957038561,
            51937460782, 59935959600, -30592972817, -67996859508, -50290915479, -27642495250,
