            51937460782, 59935959600, -30592972817, -67996859508, -50290915479, -27642495250,
            66503793065, -47233802719, -15749754040, -39930535842, -19451146409, -18226182849,
            43397529843, -25762517458, 9893337388, -56727934180, -59812561824, -40779726266,
        ]
