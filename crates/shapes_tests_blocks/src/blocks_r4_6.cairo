            -47808738578, -43282717132, 57960445156, -46072409609, 20961864754, 49592401357,
            -59187235053, -4959444423, 29957038561, -67996859508, -50290915479, -27642495250,
            -39930535842, -19451146409, -18226182849, -56727934180, -59812561824, -40779726266,
