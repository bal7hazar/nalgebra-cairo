/// `qr2x4_q_r` (oracle): `q` and `r` entry by entry within the oracle tolerance (upstream's
/// unpacked factors: `diag(r) >= 0`), `q r = A` and the orthonormality of `q` within the
/// measured bounds.
#[test]
fn test_oracle_qr2x4_q_r() {
    let mut cases = oracle::qr2x4_q_r_cases();
    let (mut ex, mut rec, mut orth) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, eq, er, tol) = *case;
        let a = black_box(mat2x4(a));
        let f = a.qr();
        let (q, r) = f.unpack();
        let (q2, r2) = f.qr_internal();
        assert!(q2 == q && r2 == r && f.q() == q && f.r() == r && f.unpack_r() == r);
        let (eq, er) = (mat2x2(eq), mat2x4(er));
        ex = max(ex, excess(ulp_diff(q.m11, eq.m11), oracle_tol(abs_raw(eq.m11), tol)));
        ex = max(ex, excess(ulp_diff(q.m12, eq.m12), oracle_tol(abs_raw(eq.m12), tol)));
        ex = max(ex, excess(ulp_diff(q.m21, eq.m21), oracle_tol(abs_raw(eq.m21), tol)));
        ex = max(ex, excess(ulp_diff(q.m22, eq.m22), oracle_tol(abs_raw(eq.m22), tol)));
        ex = max(ex, excess(ulp_diff(r.m11, er.m11), oracle_tol(abs_raw(er.m11), tol)));
        ex = max(ex, excess(ulp_diff(r.m12, er.m12), oracle_tol(abs_raw(er.m12), tol)));
        ex = max(ex, excess(ulp_diff(r.m13, er.m13), oracle_tol(abs_raw(er.m13), tol)));
        ex = max(ex, excess(ulp_diff(r.m14, er.m14), oracle_tol(abs_raw(er.m14), tol)));
        ex = max(ex, excess(ulp_diff(r.m21, er.m21), oracle_tol(abs_raw(er.m21), tol)));
        ex = max(ex, excess(ulp_diff(r.m22, er.m22), oracle_tol(abs_raw(er.m22), tol)));
        ex = max(ex, excess(ulp_diff(r.m23, er.m23), oracle_tol(abs_raw(er.m23), tol)));
        ex = max(ex, excess(ulp_diff(r.m24, er.m24), oracle_tol(abs_raw(er.m24), tol)));
        rec = max(rec, max_ulp_2x4(q.mul_mat(r), a) / amax_2x4(a));
        orth = max(orth, orth_2x2(q));
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
    assert!(rec <= 4 && orth <= 18, "measured {} {}", rec, orth);
}

#[test]
fn test_qr2x4_q_tr_mul() {
    let (a, _, _, _) = *oracle::qr2x4_q_r_cases().at(0);
    let f = black_box(mat2x4(a)).qr();
    let mut b = Vector2 { x: fx(1 * ONE), y: fx(2 * ONE) };
    f.q_tr_mul(ref b);
    assert!(b == f.q.tr_mul(Vector2 { x: fx(1 * ONE), y: fx(2 * ONE) }));
}

