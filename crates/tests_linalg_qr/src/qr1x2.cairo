/// `qr1x2_q_r` (oracle): `q` and `r` entry by entry within the oracle tolerance (upstream's
/// unpacked factors: `diag(r) >= 0`), `q r = A` and the orthonormality of `q` within the
/// measured bounds.
#[test]
fn test_oracle_qr1x2_q_r() {
    let mut cases = oracle::qr1x2_q_r_cases();
    let (mut ex, mut rec, mut orth) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, eq, er, tol) = *case;
        let a = black_box(mat1x2(a));
        let f = a.qr();
        let (q, r) = f.unpack();
        let (q2, r2) = f.qr_internal();
        assert!(q2 == q && r2 == r && f.q() == q && f.r() == r && f.unpack_r() == r);
        let (eq, er) = (mat1x1(eq), mat1x2(er));
        ex = max(ex, excess(ulp_diff(q.x, eq.x), oracle_tol(abs_raw(eq.x), tol)));
        ex = max(ex, excess(ulp_diff(r.x, er.x), oracle_tol(abs_raw(er.x), tol)));
        ex = max(ex, excess(ulp_diff(r.y, er.y), oracle_tol(abs_raw(er.y), tol)));
        rec = max(rec, max_ulp_1x2(q.mul_mat(r), a) / amax_1x2(a));
        orth = max(orth, orth_1x1(q));
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
    assert!(rec <= 0 && orth <= 0, "measured {} {}", rec, orth);
}

