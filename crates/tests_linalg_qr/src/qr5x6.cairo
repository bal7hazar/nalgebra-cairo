#[test]
fn test_qr5x6_q_tr_mul() {
    let (a, _, _, _) = *oracle::qr5x6_q_r_cases().at(0);
    let f = black_box(mat5x6(a)).qr();
    let mut b = Vector5 {
        x: fx(1 * ONE), y: fx(2 * ONE), z: fx(3 * ONE), w: fx(4 * ONE), a: fx(5 * ONE),
    };
    f.q_tr_mul(ref b);
    assert!(
        b == f
            .q
            .tr_mul(
                Vector5 {
                    x: fx(1 * ONE), y: fx(2 * ONE), z: fx(3 * ONE), w: fx(4 * ONE), a: fx(5 * ONE),
                },
            ),
    );
}

