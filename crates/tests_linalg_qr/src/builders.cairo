                0x100000000,
            ),
        );
    e =
        core::cmp::max(
            e,
            dev(
                w(a.m21) * w(a.m31)
                    + w(a.m22) * w(a.m32)
                    + w(a.m23) * w(a.m33)
                    + w(a.m24) * w(a.m34)
                    + w(a.m25) * w(a.m35),
                0,
            ),
        );
    e =
        core::cmp::max(
            e,
            dev(
                w(a.m31) * w(a.m31)
                    + w(a.m32) * w(a.m32)
                    + w(a.m33) * w(a.m33)
                    + w(a.m34) * w(a.m34)
                    + w(a.m35) * w(a.m35),
                0x100000000,
            ),
        );
    e
}

/// `Matrix3x6` from raw ROW-major rows.
pub fn mat3x6(rows: [[i64; 6]; 3]) -> Matrix3x6<Fixed> {
    let [r0, r1, r2] = rows;
    let [a00, a01, a02, a03, a04, a05] = r0;
    let [a10, a11, a12, a13, a14, a15] = r1;
    let [a20, a21, a22, a23, a24, a25] = r2;
    Matrix3x6 {
        m11: fx(a00),
        m21: fx(a10),
        m31: fx(a20),
        m12: fx(a01),
        m22: fx(a11),
        m32: fx(a21),
        m13: fx(a02),
        m23: fx(a12),
        m33: fx(a22),
        m14: fx(a03),
        m24: fx(a13),
        m34: fx(a23),
        m15: fx(a04),
        m25: fx(a14),
        m35: fx(a24),
        m16: fx(a05),
        m26: fx(a15),
        m36: fx(a25),
    }
}

/// Largest component-wise `|a - b|` in raw units.
pub fn max_ulp_3x6(a: Matrix3x6<Fixed>, b: Matrix3x6<Fixed>) -> u128 {
    let mut e = ulp_diff(a.m11, b.m11);
    e = core::cmp::max(e, ulp_diff(a.m21, b.m21));
    e = core::cmp::max(e, ulp_diff(a.m31, b.m31));
    e = core::cmp::max(e, ulp_diff(a.m12, b.m12));
    e = core::cmp::max(e, ulp_diff(a.m22, b.m22));
    e = core::cmp::max(e, ulp_diff(a.m32, b.m32));
    e = core::cmp::max(e, ulp_diff(a.m13, b.m13));
    e = core::cmp::max(e, ulp_diff(a.m23, b.m23));
    e = core::cmp::max(e, ulp_diff(a.m33, b.m33));
    e = core::cmp::max(e, ulp_diff(a.m14, b.m14));
    e = core::cmp::max(e, ulp_diff(a.m24, b.m24));
    e = core::cmp::max(e, ulp_diff(a.m34, b.m34));
    e = core::cmp::max(e, ulp_diff(a.m15, b.m15));
    e = core::cmp::max(e, ulp_diff(a.m25, b.m25));
    e = core::cmp::max(e, ulp_diff(a.m35, b.m35));
    e = core::cmp::max(e, ulp_diff(a.m16, b.m16));
    e = core::cmp::max(e, ulp_diff(a.m26, b.m26));
    e = core::cmp::max(e, ulp_diff(a.m36, b.m36));
    e
}

/// `max(1, max |a_ij|)` in UNITS (raw >> 32): the scale of the relative bounds.
pub fn amax_3x6(a: Matrix3x6<Fixed>) -> u128 {
    let mut e = abs_raw(a.m11);
    e = core::cmp::max(e, abs_raw(a.m21));
    e = core::cmp::max(e, abs_raw(a.m31));
    e = core::cmp::max(e, abs_raw(a.m12));
    e = core::cmp::max(e, abs_raw(a.m22));
    e = core::cmp::max(e, abs_raw(a.m32));
    e = core::cmp::max(e, abs_raw(a.m13));
    e = core::cmp::max(e, abs_raw(a.m23));
    e = core::cmp::max(e, abs_raw(a.m33));
    e = core::cmp::max(e, abs_raw(a.m14));
    e = core::cmp::max(e, abs_raw(a.m24));
    e = core::cmp::max(e, abs_raw(a.m34));
    e = core::cmp::max(e, abs_raw(a.m15));
    e = core::cmp::max(e, abs_raw(a.m25));
    e = core::cmp::max(e, abs_raw(a.m35));
    e = core::cmp::max(e, abs_raw(a.m16));
    e = core::cmp::max(e, abs_raw(a.m26));
    e = core::cmp::max(e, abs_raw(a.m36));
    e = e / 0x100000000;
    if e == 0 {
        1
    } else {
        e
    }
}

/// `max |<x_i, x_j> - delta_ij|` over the columns (rows when wider than tall), exact
/// products floored once, in raw units.
pub fn orth_3x6(a: Matrix3x6<Fixed>) -> u128 {
    let mut e: u128 = 0;
    e =
        core::cmp::max(
            e,
            dev(
                w(a.m11) * w(a.m11)
                    + w(a.m12) * w(a.m12)
                    + w(a.m13) * w(a.m13)
                    + w(a.m14) * w(a.m14)
                    + w(a.m15) * w(a.m15)
                    + w(a.m16) * w(a.m16),
                0x100000000,
            ),
        );
    e =
        core::cmp::max(
            e,
            dev(
                w(a.m11) * w(a.m21)
                    + w(a.m12) * w(a.m22)
                    + w(a.m13) * w(a.m23)
                    + w(a.m14) * w(a.m24)
                    + w(a.m15) * w(a.m25)
                    + w(a.m16) * w(a.m26),
                0,
            ),
        );
    e =
        core::cmp::max(
            e,
            dev(
                w(a.m11) * w(a.m31)
                    + w(a.m12) * w(a.m32)
                    + w(a.m13) * w(a.m33)
                    + w(a.m14) * w(a.m34)
                    + w(a.m15) * w(a.m35)
                    + w(a.m16) * w(a.m36),
                0,
            ),
        );
    e =
        core::cmp::max(
            e,
            dev(
                w(a.m21) * w(a.m21)
                    + w(a.m22) * w(a.m22)
                    + w(a.m23) * w(a.m23)
                    + w(a.m24) * w(a.m24)
                    + w(a.m25) * w(a.m25)
                    + w(a.m26) * w(a.m26),
                0x100000000,
            ),
        );
    e =
        core::cmp::max(
            e,
            dev(
                w(a.m21) * w(a.m31)
                    + w(a.m22) * w(a.m32)
                    + w(a.m23) * w(a.m33)
                    + w(a.m24) * w(a.m34)
                    + w(a.m25) * w(a.m35)
                    + w(a.m26) * w(a.m36),
                0,
            ),
        );
    e =
        core::cmp::max(
            e,
            dev(
                w(a.m31) * w(a.m31)
                    + w(a.m32) * w(a.m32)
                    + w(a.m33) * w(a.m33)
                    + w(a.m34) * w(a.m34)
                    + w(a.m35) * w(a.m35)
                    + w(a.m36) * w(a.m36),
                0x100000000,
            ),
        );
    e
}

/// `Matrix1` from a raw component tuple.
pub fn vec1(t: (i64,)) -> Matrix1<Fixed> {
    let (a0,) = t;
    Matrix1 { x: fx(a0) }
}

/// `Vector2` from a raw component tuple.
pub fn vec2(t: (i64, i64)) -> Vector2<Fixed> {
    let (a0, a1) = t;
    Vector2 { x: fx(a0), y: fx(a1) }
}

/// `Vector3` from a raw component tuple.
pub fn vec3(t: (i64, i64, i64)) -> Vector3<Fixed> {
    let (a0, a1, a2) = t;
    Vector3 { x: fx(a0), y: fx(a1), z: fx(a2) }
}

/// The raw value, widened.
fn w(a: Fixed) -> i128 {
    a.raw.into()
}

/// `|floor(p / 2^32) - target|` for an exact wide sum of raw products `p`.
fn dev(p: i128, target: i128) -> u128 {
    let q = if p >= 0 {
        p / 0x100000000
    } else {
        -((-p + 0xffffffff) / 0x100000000)
    };
    let d = q - target;
    let d = if d < 0 {
        -d
    } else {
        d
    };
    d.try_into().unwrap()
}
