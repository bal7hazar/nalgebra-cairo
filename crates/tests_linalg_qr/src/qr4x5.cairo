#[test]
fn test_qr4x5_q_tr_mul() {
    let (a, _, _, _) = *oracle::qr4x5_q_r_cases().at(0);
    let f = black_box(mat4x5(a)).qr();
    let mut b = Vector4 { x: fx(1 * ONE), y: fx(2 * ONE), z: fx(3 * ONE), w: fx(4 * ONE) };
    f.q_tr_mul(ref b);
    assert!(
        b == f.q.tr_mul(Vector4 { x: fx(1 * ONE), y: fx(2 * ONE), z: fx(3 * ONE), w: fx(4 * ONE) }),
    );
}

