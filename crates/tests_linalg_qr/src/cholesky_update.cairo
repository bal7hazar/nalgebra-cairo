/// Column 0: the longest path (full forward substitution is empty, the whole trailing block is
/// downdated).
#[test]
#[inline(never)]
fn bench_cholesky3_insert_column__j0() {
    let (a, _, _, _, _) = *oracle::cholesky3_rank_one_update_cases().at(3);
    let f = black_box(mat3x3(a).cholesky().unwrap());
    let c = black_box(Vector4 { x: fx(64 * ONE), y: fx(ONE), z: fx(ONE), w: fx(ONE) });
    let e = black_box(true);
    let g = f.insert_column(0, c);
    assert!((g.l11 > fx(0)) == e);
}

/// `cholesky3_remove_column_j0` (oracle): the factor with row and column 0 removed.
#[test]
fn test_oracle_cholesky3_remove_column_j0() {
    let mut cases = oracle::cholesky3_remove_column_j0_cases();
    let mut ex = 0;
    while let Some(case) = cases.pop_front() {
        let (a, e, tol) = *case;
        let l = black_box(mat3x3(a)).cholesky().unwrap().remove_column(0).l();
        let e = mat2x2(e);
        ex = max(ex, excess(ulp_diff(l.m11, e.m11), oracle_tol(abs_raw(e.m11), tol)));
        ex = max(ex, excess(ulp_diff(l.m12, e.m12), oracle_tol(abs_raw(e.m12), tol)));
        ex = max(ex, excess(ulp_diff(l.m21, e.m21), oracle_tol(abs_raw(e.m21), tol)));
        ex = max(ex, excess(ulp_diff(l.m22, e.m22), oracle_tol(abs_raw(e.m22), tol)));
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
}

