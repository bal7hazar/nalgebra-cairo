/// `schur3_eigenvalues_real` (oracle): `eigenvalues()` of the matrix and of the decomposition
/// (equal) sorted and compared with upstream's; `Eigen3`: the same eigenvalues in the order of the
/// diagonal of `T`, unit eigenvectors with `|A v - λ v|` within the measured bound (per unit of
/// max |a_ij|).
#[test]
fn test_oracle_schur3_eigenvalues_real() {
    let mut cases = oracle::schur3_eigenvalues_real_cases();
    let (mut ex, mut res, mut unit) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, ev, tol) = *case;
        let a = black_box(mat3x3(a));
        let vals = a.eigenvalues().unwrap();
        let s = a.schur();
        let svals = s.eigenvalues().unwrap();
        assert!(svals == vals, "eigenvalues without Q");
        let got = sorted(array![vals.x, vals.y, vals.z]);
        let ev = {
            let (ev_0, ev_1, ev_2) = ev;
            array![ev_0, ev_1, ev_2]
        };
        let mut k = 0;
        while k < 3 {
            let e = fx(*ev[k]);
            ex = max(ex, excess(ulp_diff(fx(*got[k]), e), oracle_tol(abs_raw(e), tol)));
            k += 1;
        }
        let eig = Eigen3Trait::new(a).unwrap();
        assert!(eig.eigenvalues == svals, "Eigen order");
        let v = eig.eigenvectors;
        let av = a.mul_mat(v);
        res = max(res, ulp_diff(av.m11, v.m11 * svals.x) / amax_3x3(a));
        res = max(res, ulp_diff(av.m12, v.m12 * svals.y) / amax_3x3(a));
        res = max(res, ulp_diff(av.m13, v.m13 * svals.z) / amax_3x3(a));
        res = max(res, ulp_diff(av.m21, v.m21 * svals.x) / amax_3x3(a));
        res = max(res, ulp_diff(av.m22, v.m22 * svals.y) / amax_3x3(a));
        res = max(res, ulp_diff(av.m23, v.m23 * svals.z) / amax_3x3(a));
        res = max(res, ulp_diff(av.m31, v.m31 * svals.x) / amax_3x3(a));
        res = max(res, ulp_diff(av.m32, v.m32 * svals.y) / amax_3x3(a));
        res = max(res, ulp_diff(av.m33, v.m33 * svals.z) / amax_3x3(a));
        unit =
            max(
                unit,
                ulp_diff(
                    fixed::FixedTrait::sqrt(v.m11 * v.m11 + v.m21 * v.m21 + v.m31 * v.m31), fx(ONE),
                ),
            );
        unit =
            max(
                unit,
                ulp_diff(
                    fixed::FixedTrait::sqrt(v.m12 * v.m12 + v.m22 * v.m22 + v.m32 * v.m32), fx(ONE),
                ),
            );
        unit =
            max(
                unit,
                ulp_diff(
                    fixed::FixedTrait::sqrt(v.m13 * v.m13 + v.m23 * v.m23 + v.m33 * v.m33), fx(ONE),
                ),
            );
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
    assert!(res <= 18 && unit <= 2, "measured {} {}", res, unit);
}

/// The Schur iteration count (the smallest `max_niter` for which `try_schur` succeeds, minus
/// one) over the oracle's general, complex and non-normal inputs, printed for the report; `None`
/// below it, `Some` and the same decomposition as `schur()` from it on.
#[test]
fn test_schur3_iterations() {
    let mut cases = oracle::schur3_eigenvalues_cases();
    let (mut total, mut worst, mut count) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, _, _, _) = *case;
        let a = black_box(mat3x3(a));
        let k = iterations3(a);
        total += k;
        count += 1;
        if k > worst {
            worst = k;
        }
        if k > 0 {
            assert!(a.try_schur(fx(1), k).is_none(), "max_niter = iterations");
        }
        let s = a.try_schur(fx(1), k + 1).unwrap();
        let s2 = a.schur();
        assert!(s.q == s2.q && s.t == s2.t, "try_schur = schur");
    }
    println!("schur3: {} cases, {} iterations in total, at most {}", count, total, worst);
}

/// The number of passes of the Schur loop on `a` (exponential then binary search on `max_niter`).
fn iterations3(a: Matrix3<Fixed>) -> usize {
    let mut hi: usize = 1;
    while a.try_schur(fx(1), hi).is_none() {
        hi *= 2;
    }
    let mut lo: usize = hi / 2;
    // try_schur(lo) is None (or lo = 0), try_schur(hi) is Some
    while hi - lo > 1 {
        let mid = (lo + hi) / 2;
        if a.try_schur(fx(1), mid).is_none() {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    hi - 1
}

/// The identity and the zero matrix are already in Schur form (no iteration, `Q = I`), their
/// eigenvalues exact; `try_schur(eps, 1)` succeeds on them.
#[test]
fn test_schur3_trivial() {
    let i = black_box(
        Matrix3 {
            m11: fx(ONE),
            m21: fx(0),
            m31: fx(0),
            m12: fx(0),
            m22: fx(ONE),
            m32: fx(0),
            m13: fx(0),
            m23: fx(0),
            m33: fx(ONE),
        },
    );
    let s = i.try_schur(fx(1), 1).unwrap();
    assert!(s.t == i && s.q == i);
    assert!(i.eigenvalues().unwrap() == Vector3 { x: fx(ONE), y: fx(ONE), z: fx(ONE) });
    let z = black_box(
        Matrix3 {
            m11: fx(0),
            m21: fx(0),
            m31: fx(0),
            m12: fx(0),
            m22: fx(0),
            m32: fx(0),
            m13: fx(0),
            m23: fx(0),
            m33: fx(0),
        },
    );
    let s = z.try_schur(fx(1), 1).unwrap();
    assert!(s.t == z && s.q == i);
    let (re, im) = z.complex_eigenvalues();
    assert!(re == Vector3 { x: fx(0), y: fx(0), z: fx(0) } && im == re);
    let e = Eigen3Trait::new(i).unwrap();
    assert!(e.eigenvectors == i && e.eigenvalues == Vector3 { x: fx(ONE), y: fx(ONE), z: fx(ONE) });
}

