        },
    );
    let s = a.try_schur(fx(1), 1).unwrap();
    let vals = s.eigenvalues().unwrap();
    let got = sorted(array![vals.x, vals.y, vals.z]);
    let mut k = 0;
    while k < 3 {
        let kk: i64 = k.into();
        assert!(ulp_diff(fx(*got[k]), fx((kk + 1) * ONE)) <= 64, "diagonal");
        k += 1;
    }
}

/// A 2x2 rotation block `[[c, -s], [s, c]]` has the eigenvalues `c ± i s`: `eigenvalues()` is
/// `None`, `complex_eigenvalues()` gives the pair.
#[test]
fn test_schur3_rotation_block() {
    let a = black_box(
        Matrix3 {
            m11: fx(3 * ONE),
            m21: fx(4 * ONE),
            m31: fx(0),
            m12: fx(-4 * ONE),
            m22: fx(3 * ONE),
            m32: fx(0),
            m13: fx(0),
            m23: fx(0),
            m33: fx(128849018880),
        },
    );
    assert!(a.eigenvalues().is_none());
    let (re, im) = a.complex_eigenvalues();
    let got = sorted_pairs(array![re.x, re.y, re.z], array![im.x, im.y, im.z]);
    let (r0, i0) = *got[0];
    let (r1, i1) = *got[1];
    assert!(ulp_diff(fx(r0), fx(3 * ONE)) <= 256 && ulp_diff(fx(i0), fx(-4 * ONE)) <= 256, "pair");
    assert!(ulp_diff(fx(r1), fx(3 * ONE)) <= 256 && ulp_diff(fx(i1), fx(4 * ONE)) <= 256, "pair");
    assert!(Eigen3Trait::new(a).is_none(), "Eigen of complex eigenvalues");
}

/// The cyclic permutation matrix (eigenvalues: the 3-th roots of unity), the classic hard case
/// of the Francis iteration without exceptional shifts (upstream has none).
#[test]
fn test_schur3_cyclic_permutation() {
    let a = black_box(
        Matrix3 {
            m11: fx(0),
            m21: fx(ONE),
            m31: fx(0),
            m12: fx(0),
            m22: fx(0),
            m32: fx(ONE),
            m13: fx(ONE),
            m23: fx(0),
            m33: fx(0),
        },
    );
    let s = a.try_schur(fx(1), 200).unwrap();
    let (re, im) = s.complex_eigenvalues();
    // the 3-th roots of unity: |λ| = 1
    assert!(
        ulp_diff(fixed::FixedTrait::sqrt(re.x * re.x + im.x * im.x), fx(ONE)) <= 4096,
        "root of unity",
    );
    assert!(
        ulp_diff(fixed::FixedTrait::sqrt(re.y * re.y + im.y * im.y), fx(ONE)) <= 4096,
        "root of unity",
    );
    assert!(
        ulp_diff(fixed::FixedTrait::sqrt(re.z * re.z + im.z * im.z), fx(ONE)) <= 4096,
        "root of unity",
    );
}

