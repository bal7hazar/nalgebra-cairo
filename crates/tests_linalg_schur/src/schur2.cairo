/// `schur2_eigenvalues_real` (oracle): `eigenvalues()` of the matrix and of the decomposition
/// (equal) sorted and compared with upstream's; `Eigen2`: the same eigenvalues in the order of the
/// diagonal of `T`, unit eigenvectors with `|A v - λ v|` within the measured bound (per unit of
/// max |a_ij|).
#[test]
fn test_oracle_schur2_eigenvalues_real() {
    let mut cases = oracle::schur2_eigenvalues_real_cases();
    let (mut ex, mut res, mut unit) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, ev, tol) = *case;
        let a = black_box(mat2x2(a));
        let vals = a.eigenvalues().unwrap();
        let s = a.schur();
        let svals = s.eigenvalues().unwrap();
        // n = 2: the matrix method is upstream's closed form, not the diagonal of `T`
        let got = sorted(array![vals.x, vals.y]);
        let ev = {
            let (ev_0, ev_1) = ev;
            array![ev_0, ev_1]
        };
        let mut k = 0;
        while k < 2 {
            let e = fx(*ev[k]);
            ex = max(ex, excess(ulp_diff(fx(*got[k]), e), oracle_tol(abs_raw(e), tol)));
            k += 1;
        }
        let eig = Eigen2Trait::new(a).unwrap();
        assert!(eig.eigenvalues == svals, "Eigen order");
        let v = eig.eigenvectors;
        let av = a.mul_mat(v);
        res = max(res, ulp_diff(av.m11, v.m11 * svals.x) / amax_2x2(a));
        res = max(res, ulp_diff(av.m12, v.m12 * svals.y) / amax_2x2(a));
        res = max(res, ulp_diff(av.m21, v.m21 * svals.x) / amax_2x2(a));
        res = max(res, ulp_diff(av.m22, v.m22 * svals.y) / amax_2x2(a));
        unit = max(unit, ulp_diff(fixed::FixedTrait::sqrt(v.m11 * v.m11 + v.m21 * v.m21), fx(ONE)));
        unit = max(unit, ulp_diff(fixed::FixedTrait::sqrt(v.m12 * v.m12 + v.m22 * v.m22), fx(ONE)));
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
    assert!(res <= 1 && unit <= 2, "measured {} {}", res, unit);
}

/// The Schur iteration count (the smallest `max_niter` for which `try_schur` succeeds, minus
/// one) over the oracle's general, complex and non-normal inputs, printed for the report; `None`
/// below it, `Some` and the same decomposition as `schur()` from it on.
#[test]
fn test_schur2_iterations() {
    let mut cases = oracle::schur2_eigenvalues_cases();
    let (mut total, mut worst, mut count) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, _, _, _) = *case;
        let a = black_box(mat2x2(a));
        let k = iterations2(a);
        total += k;
        count += 1;
        if k > worst {
            worst = k;
        }
        if k > 0 {
            assert!(a.try_schur(fx(1), k).is_none(), "max_niter = iterations");
        }
        let s = a.try_schur(fx(1), k + 1).unwrap();
        let s2 = a.schur();
        assert!(s.q == s2.q && s.t == s2.t, "try_schur = schur");
    }
    println!("schur2: {} cases, {} iterations in total, at most {}", count, total, worst);
}

/// The number of passes of the Schur loop on `a` (exponential then binary search on `max_niter`).
fn iterations2(a: Matrix2<Fixed>) -> usize {
    let mut hi: usize = 1;
    while a.try_schur(fx(1), hi).is_none() {
        hi *= 2;
    }
    let mut lo: usize = hi / 2;
    // try_schur(lo) is None (or lo = 0), try_schur(hi) is Some
    while hi - lo > 1 {
        let mid = (lo + hi) / 2;
        if a.try_schur(fx(1), mid).is_none() {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    hi - 1
}

/// The identity and the zero matrix are already in Schur form (no iteration, `Q = I`), their
/// eigenvalues exact; `try_schur(eps, 1)` succeeds on them.
#[test]
fn test_schur2_trivial() {
    let i = black_box(Matrix2 { m11: fx(ONE), m21: fx(0), m12: fx(0), m22: fx(ONE) });
    let s = i.try_schur(fx(1), 1).unwrap();
    assert!(s.t == i && s.q == i);
    assert!(i.eigenvalues().unwrap() == Vector2 { x: fx(ONE), y: fx(ONE) });
    let z = black_box(Matrix2 { m11: fx(0), m21: fx(0), m12: fx(0), m22: fx(0) });
    let s = z.try_schur(fx(1), 1).unwrap();
    assert!(s.t == z && s.q == i);
    let (re, im) = z.complex_eigenvalues();
    assert!(re == Vector2 { x: fx(0), y: fx(0) } && im == re);
    let e = Eigen2Trait::new(i).unwrap();
    assert!(e.eigenvectors == i && e.eigenvalues == Vector2 { x: fx(ONE), y: fx(ONE) });
}

/// An upper triangular matrix is its own Schur form: `T = A` exactly (the scaling by the
/// largest entry and back is exact on these integers... up to one floor), the eigenvalues are the
/// diagonal.
#[test]
fn test_schur2_triangular() {
    let a = black_box(
        Matrix2 { m11: fx(4294967296), m21: fx(0), m12: fx(4294967296), m22: fx(8589934592) },
    );
    let s = a.try_schur(fx(1), 1).unwrap();
    let vals = s.eigenvalues().unwrap();
    let got = sorted(array![vals.x, vals.y]);
    let mut k = 0;
    while k < 2 {
        let kk: i64 = k.into();
        assert!(ulp_diff(fx(*got[k]), fx((kk + 1) * ONE)) <= 64, "diagonal");
        k += 1;
    }
}

/// A 2x2 rotation block `[[c, -s], [s, c]]` has the eigenvalues `c ± i s`: `eigenvalues()` is
/// `None`, `complex_eigenvalues()` gives the pair.
#[test]
fn test_schur2_rotation_block() {
    let a = black_box(
        Matrix2 { m11: fx(3 * ONE), m21: fx(4 * ONE), m12: fx(-4 * ONE), m22: fx(3 * ONE) },
    );
    assert!(a.eigenvalues().is_none());
    let (re, im) = a.complex_eigenvalues();
    let got = sorted_pairs(array![re.x, re.y], array![im.x, im.y]);
    let (r0, i0) = *got[0];
    let (r1, i1) = *got[1];
    assert!(ulp_diff(fx(r0), fx(3 * ONE)) <= 256 && ulp_diff(fx(i0), fx(-4 * ONE)) <= 256, "pair");
    assert!(ulp_diff(fx(r1), fx(3 * ONE)) <= 256 && ulp_diff(fx(i1), fx(4 * ONE)) <= 256, "pair");
    assert!(Eigen2Trait::new(a).is_none(), "Eigen of complex eigenvalues");
}

