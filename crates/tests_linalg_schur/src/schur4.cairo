/// `schur4_eigenvalues_real` (oracle): `eigenvalues()` of the matrix and of the decomposition
/// (equal) sorted and compared with upstream's; `Eigen4`: the same eigenvalues in the order of the
/// diagonal of `T`, unit eigenvectors with `|A v - λ v|` within the measured bound (per unit of
/// max |a_ij|).
#[test]
fn test_oracle_schur4_eigenvalues_real() {
    let mut cases = oracle::schur4_eigenvalues_real_cases();
    let (mut ex, mut res, mut unit) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, ev, tol) = *case;
        let a = black_box(mat4x4(a));
        let vals = a.eigenvalues().unwrap();
        let s = a.schur();
        let svals = s.eigenvalues().unwrap();
        assert!(svals == vals, "eigenvalues without Q");
        let got = sorted(array![vals.x, vals.y, vals.z, vals.w]);
        let ev = {
            let (ev_0, ev_1, ev_2, ev_3) = ev;
            array![ev_0, ev_1, ev_2, ev_3]
        };
        let mut k = 0;
        while k < 4 {
            let e = fx(*ev[k]);
            ex = max(ex, excess(ulp_diff(fx(*got[k]), e), oracle_tol(abs_raw(e), tol)));
            k += 1;
        }
        let eig = Eigen4Trait::new(a).unwrap();
        assert!(eig.eigenvalues == svals, "Eigen order");
        let v = eig.eigenvectors;
        let av = a.mul_mat(v);
        res = max(res, ulp_diff(av.m11, v.m11 * svals.x) / amax_4x4(a));
        res = max(res, ulp_diff(av.m12, v.m12 * svals.y) / amax_4x4(a));
        res = max(res, ulp_diff(av.m13, v.m13 * svals.z) / amax_4x4(a));
        res = max(res, ulp_diff(av.m14, v.m14 * svals.w) / amax_4x4(a));
        res = max(res, ulp_diff(av.m21, v.m21 * svals.x) / amax_4x4(a));
        res = max(res, ulp_diff(av.m22, v.m22 * svals.y) / amax_4x4(a));
        res = max(res, ulp_diff(av.m23, v.m23 * svals.z) / amax_4x4(a));
        res = max(res, ulp_diff(av.m24, v.m24 * svals.w) / amax_4x4(a));
        res = max(res, ulp_diff(av.m31, v.m31 * svals.x) / amax_4x4(a));
        res = max(res, ulp_diff(av.m32, v.m32 * svals.y) / amax_4x4(a));
        res = max(res, ulp_diff(av.m33, v.m33 * svals.z) / amax_4x4(a));
        res = max(res, ulp_diff(av.m34, v.m34 * svals.w) / amax_4x4(a));
        res = max(res, ulp_diff(av.m41, v.m41 * svals.x) / amax_4x4(a));
        res = max(res, ulp_diff(av.m42, v.m42 * svals.y) / amax_4x4(a));
        res = max(res, ulp_diff(av.m43, v.m43 * svals.z) / amax_4x4(a));
        res = max(res, ulp_diff(av.m44, v.m44 * svals.w) / amax_4x4(a));
        unit =
            max(
                unit,
                ulp_diff(
                    fixed::FixedTrait::sqrt(
                        v.m11 * v.m11 + v.m21 * v.m21 + v.m31 * v.m31 + v.m41 * v.m41,
                    ),
                    fx(ONE),
                ),
            );
        unit =
            max(
                unit,
                ulp_diff(
                    fixed::FixedTrait::sqrt(
                        v.m12 * v.m12 + v.m22 * v.m22 + v.m32 * v.m32 + v.m42 * v.m42,
                    ),
                    fx(ONE),
                ),
            );
        unit =
            max(
                unit,
                ulp_diff(
                    fixed::FixedTrait::sqrt(
                        v.m13 * v.m13 + v.m23 * v.m23 + v.m33 * v.m33 + v.m43 * v.m43,
                    ),
                    fx(ONE),
                ),
            );
        unit =
            max(
                unit,
                ulp_diff(
                    fixed::FixedTrait::sqrt(
                        v.m14 * v.m14 + v.m24 * v.m24 + v.m34 * v.m34 + v.m44 * v.m44,
                    ),
                    fx(ONE),
                ),
            );
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
    assert!(res <= 240 && unit <= 2, "measured {} {}", res, unit);
}

/// The Schur iteration count (the smallest `max_niter` for which `try_schur` succeeds, minus
/// one) over the oracle's general, complex and non-normal inputs, printed for the report; `None`
/// below it, `Some` and the same decomposition as `schur()` from it on.
#[test]
fn test_schur4_iterations() {
    let mut cases = oracle::schur4_eigenvalues_cases();
    let (mut total, mut worst, mut count) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, _, _, _) = *case;
        let a = black_box(mat4x4(a));
        let k = iterations4(a);
        total += k;
        count += 1;
        if k > worst {
            worst = k;
        }
        if k > 0 {
            assert!(a.try_schur(fx(1), k).is_none(), "max_niter = iterations");
        }
        let s = a.try_schur(fx(1), k + 1).unwrap();
        let s2 = a.schur();
        assert!(s.q == s2.q && s.t == s2.t, "try_schur = schur");
    }
    println!("schur4: {} cases, {} iterations in total, at most {}", count, total, worst);
}

/// The number of passes of the Schur loop on `a` (exponential then binary search on `max_niter`).
fn iterations4(a: Matrix4<Fixed>) -> usize {
    let mut hi: usize = 1;
    while a.try_schur(fx(1), hi).is_none() {
        hi *= 2;
    }
    let mut lo: usize = hi / 2;
    // try_schur(lo) is None (or lo = 0), try_schur(hi) is Some
    while hi - lo > 1 {
        let mid = (lo + hi) / 2;
        if a.try_schur(fx(1), mid).is_none() {
            lo = mid;
        } else {
            hi = mid;
        }
    }
    hi - 1
}

/// The identity and the zero matrix are already in Schur form (no iteration, `Q = I`), their
/// eigenvalues exact; `try_schur(eps, 1)` succeeds on them.
#[test]
fn test_schur4_trivial() {
    let i = black_box(
        Matrix4 {
            m11: fx(ONE),
            m21: fx(0),
            m31: fx(0),
            m41: fx(0),
            m12: fx(0),
            m22: fx(ONE),
            m32: fx(0),
            m42: fx(0),
            m13: fx(0),
            m23: fx(0),
            m33: fx(ONE),
            m43: fx(0),
            m14: fx(0),
            m24: fx(0),
            m34: fx(0),
            m44: fx(ONE),
        },
    );
    let s = i.try_schur(fx(1), 1).unwrap();
    assert!(s.t == i && s.q == i);
    assert!(i.eigenvalues().unwrap() == Vector4 { x: fx(ONE), y: fx(ONE), z: fx(ONE), w: fx(ONE) });
    let z = black_box(
        Matrix4 {
            m11: fx(0),
            m21: fx(0),
            m31: fx(0),
            m41: fx(0),
            m12: fx(0),
            m22: fx(0),
            m32: fx(0),
            m42: fx(0),
            m13: fx(0),
            m23: fx(0),
            m33: fx(0),
            m43: fx(0),
            m14: fx(0),
            m24: fx(0),
            m34: fx(0),
            m44: fx(0),
        },
    );
    let s = z.try_schur(fx(1), 1).unwrap();
    assert!(s.t == z && s.q == i);
    let (re, im) = z.complex_eigenvalues();
    assert!(re == Vector4 { x: fx(0), y: fx(0), z: fx(0), w: fx(0) } && im == re);
    let e = Eigen4Trait::new(i).unwrap();
    assert!(
        e.eigenvectors == i
            && e.eigenvalues == Vector4 { x: fx(ONE), y: fx(ONE), z: fx(ONE), w: fx(ONE) },
    );
}

/// An upper triangular matrix is its own Schur form: `T = A` exactly (the scaling by the
/// largest entry and back is exact on these integers... up to one floor), the eigenvalues are the
/// diagonal.
#[test]
fn test_schur4_triangular() {
    let a = black_box(
        Matrix4 {
            m11: fx(4294967296),
            m21: fx(0),
            m31: fx(0),
            m41: fx(0),
            m12: fx(4294967296),
            m22: fx(8589934592),
            m32: fx(0),
            m42: fx(0),
            m13: fx(6442450944),
            m23: fx(8589934592),
            m33: fx(12884901888),
            m43: fx(0),
            m14: fx(8589934592),
            m24: fx(10737418240),
            m34: fx(12884901888),
            m44: fx(17179869184),
        },
    );
    let s = a.try_schur(fx(1), 1).unwrap();
    let vals = s.eigenvalues().unwrap();
    let got = sorted(array![vals.x, vals.y, vals.z, vals.w]);
    let mut k = 0;
    while k < 4 {
        let kk: i64 = k.into();
        assert!(ulp_diff(fx(*got[k]), fx((kk + 1) * ONE)) <= 64, "diagonal");
        k += 1;
    }
}

/// A 2x2 rotation block `[[c, -s], [s, c]]` has the eigenvalues `c ± i s`: `eigenvalues()` is
/// `None`, `complex_eigenvalues()` gives the pair.
#[test]
fn test_schur4_rotation_block() {
    let a = black_box(
        Matrix4 {
            m11: fx(3 * ONE),
            m21: fx(4 * ONE),
            m31: fx(0),
            m41: fx(0),
            m12: fx(-4 * ONE),
            m22: fx(3 * ONE),
            m32: fx(0),
            m42: fx(0),
            m13: fx(0),
            m23: fx(0),
            m33: fx(128849018880),
            m43: fx(0),
            m14: fx(0),
            m24: fx(0),
            m34: fx(0),
            m44: fx(171798691840),
        },
    );
    assert!(a.eigenvalues().is_none());
    let (re, im) = a.complex_eigenvalues();
    let got = sorted_pairs(array![re.x, re.y, re.z, re.w], array![im.x, im.y, im.z, im.w]);
    let (r0, i0) = *got[0];
    let (r1, i1) = *got[1];
    assert!(ulp_diff(fx(r0), fx(3 * ONE)) <= 256 && ulp_diff(fx(i0), fx(-4 * ONE)) <= 256, "pair");
    assert!(ulp_diff(fx(r1), fx(3 * ONE)) <= 256 && ulp_diff(fx(i1), fx(4 * ONE)) <= 256, "pair");
    assert!(Eigen4Trait::new(a).is_none(), "Eigen of complex eigenvalues");
}

/// The cyclic permutation matrix (eigenvalues: the 4-th roots of unity), the classic hard case
/// of the Francis iteration without exceptional shifts (upstream has none).
#[test]
fn test_schur4_cyclic_permutation() {
    let a = black_box(
        Matrix4 {
            m11: fx(0),
            m21: fx(ONE),
            m31: fx(0),
            m41: fx(0),
            m12: fx(0),
            m22: fx(0),
            m32: fx(ONE),
            m42: fx(0),
            m13: fx(0),
            m23: fx(0),
            m33: fx(0),
            m43: fx(ONE),
            m14: fx(ONE),
            m24: fx(0),
            m34: fx(0),
            m44: fx(0),
        },
    );
    let s = a.try_schur(fx(1), 200).unwrap();
    let (re, im) = s.complex_eigenvalues();
    // the 4-th roots of unity: |λ| = 1
    assert!(
        ulp_diff(fixed::FixedTrait::sqrt(re.x * re.x + im.x * im.x), fx(ONE)) <= 4096,
        "root of unity",
    );
    assert!(
        ulp_diff(fixed::FixedTrait::sqrt(re.y * re.y + im.y * im.y), fx(ONE)) <= 4096,
        "root of unity",
    );
    assert!(
        ulp_diff(fixed::FixedTrait::sqrt(re.z * re.z + im.z * im.z), fx(ONE)) <= 4096,
        "root of unity",
    );
    assert!(
        ulp_diff(fixed::FixedTrait::sqrt(re.w * re.w + im.w * im.w), fx(ONE)) <= 4096,
        "root of unity",
    );
}

