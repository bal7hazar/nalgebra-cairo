        let a = black_box(mat1x1(a));
        let s = a.schur();
        let (q, t) = s.unpack();

        let qt = Matrix1 { x: q.x };
        rec = max(rec, max_ulp_1x1(q.mul_mat(t).mul_mat(qt), a) / amax_1x1(a));
        orth = max(orth, orth_1x1(q));
        let (re, im) = s.complex_eigenvalues();
        let (re2, im2) = a.complex_eigenvalues();
        assert!(re == re2 && im == im2, "complex_eigenvalues without Q");
        let got = sorted_pairs(array![re.x], array![im.x]);
        let ere = {
            let (ere_0,) = ere;
            array![ere_0]
        };
        let eim = {
            let (eim_0,) = eim;
            array![eim_0]
        };
        let mut k = 0;
        while k < 1 {
            let (gr, gi) = *got[k];
            let (er, ei) = (fx(*ere[k]), fx(*eim[k]));
            ex = max(ex, excess(ulp_diff(fx(gr), er), oracle_tol(abs_raw(er), tol)));
            ex = max(ex, excess(ulp_diff(fx(gi), ei), oracle_tol(abs_raw(ei), tol)));
            k += 1;
        }
    }
    (ex, rec, orth)
}

