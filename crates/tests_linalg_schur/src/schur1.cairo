/// `schur1_eigenvalues_real` (oracle): `eigenvalues()` of the matrix and of the decomposition
/// (equal) sorted and compared with upstream's; `Eigen1`: the same eigenvalues in the order of the
/// diagonal of `T`, unit eigenvectors with `|A v - λ v|` within the measured bound (per unit of
/// max |a_ij|).
#[test]
fn test_oracle_schur1_eigenvalues_real() {
    let mut cases = oracle::schur1_eigenvalues_real_cases();
    let (mut ex, mut res, mut unit) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, ev, tol) = *case;
        let a = black_box(mat1x1(a));
        let vals = a.eigenvalues().unwrap();
        let s = a.schur();
        let svals = s.eigenvalues().unwrap();
        assert!(svals == vals, "eigenvalues without Q");
        let got = sorted(array![vals.x]);
        let ev = {
            let (ev_0,) = ev;
            array![ev_0]
        };
        let mut k = 0;
        while k < 1 {
            let e = fx(*ev[k]);
            ex = max(ex, excess(ulp_diff(fx(*got[k]), e), oracle_tol(abs_raw(e), tol)));
            k += 1;
        }
        let eig = Eigen1Trait::new(a).unwrap();
        assert!(eig.eigenvalues == svals, "Eigen order");
        let v = eig.eigenvectors;
        let av = a.mul_mat(v);
        res = max(res, ulp_diff(av.x, v.x * svals.x) / amax_1x1(a));
        unit = max(unit, ulp_diff(fixed::FixedTrait::sqrt(v.x * v.x), fx(ONE)));
