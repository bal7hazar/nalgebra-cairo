#[test]
fn test_vector4_structure() {
    let a: Vector4<Fixed> = load(array![2563288577, 20300768495, 2592352720, 66593655715].span());
    assert_raws(a.transpose(), array![2563288577, 20300768495, 2592352720, 66593655715].span());
    assert_raws(
        a.transpose().transpose(), array![2563288577, 20300768495, 2592352720, 66593655715].span(),
    );
    let near: Vector4<Fixed> = load(
        array![2563288576, 20300768497, 2592352722, 66593655715].span(),
    );
    let far: Vector4<Fixed> = load(array![2563288576, 20300768497, 2592352722, 66593655719].span());
    assert!(a.abs_diff_eq(near, 3));
    assert!(!a.abs_diff_eq(far, 3));
    assert!(a.abs_diff_eq(far, 4));
    let b: Vector4<Fixed> = load(array![66208401098, 59092368074, 15003851033, 55530405330].span());
    assert_raws(
        a.lerp(b, fx(3975809742)),
        array![61478954507, 56209777547, 14081556829, 56352511690].span(),
    );
    assert_raws(a.lerp(b, fx(0)), array![2563288577, 20300768495, 2592352720, 66593655715].span());
    assert_raws(
        a.lerp(b, fx(4294967296)),
        array![66208401098, 59092368074, 15003851033, 55530405330].span(),
    );
    let v: Vector4<Fixed> = [fx(2563288577), fx(20300768495), fx(2592352720), fx(66593655715)]
        .into();
    assert_raws(v, array![2563288577, 20300768495, 2592352720, 66593655715].span());
    let arr: [Fixed; 4] = a.into();
    let back: Vector4<Fixed> = arr.into();
    assert_raws(back, array![2563288577, 20300768495, 2592352720, 66593655715].span());
}

