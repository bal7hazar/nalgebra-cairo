    assert_raws(
        a.lerp(b, fx(1821968831)),
        array![-5831193567, -16406873090, 6525516472, 16667614416, -8177091425, -20964331069]
            .span(),
    );
    assert_raws(
        a.lerp(b, fx(0)),
        array![-22124950192, 16660893943, 2037238658, 7917941510, -48790921722, -56208559508]
            .span(),
    );
    assert_raws(
        a.lerp(b, fx(4294967296)),
        array![16284681546, -61290482360, 12617554907, 28543738366, 46948955890, 26873437256]
            .span(),
    );
    let v: Vector6<Fixed> = [
        fx(-22124950192), fx(16660893943), fx(2037238658), fx(7917941510), fx(-48790921722),
