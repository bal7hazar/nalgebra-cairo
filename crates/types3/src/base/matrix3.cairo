impl Matrix3SolveKernelVector3<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Mul<T>, +Neg<T>, +PartialEq<T>,
> of SolveKernel<Matrix3<T>, Vector3<T>> {
    type Scalar = T;

    #[inline(always)]
    fn lower(self: Matrix3<T>, b: Vector3<T>) -> Vector3<T> {
        let x00 = R::div(b.x, self.m11);
        let n10 = -self.m21;
        let x10 = R::div(R::mul_add(n10, x00, b.y), self.m22);
        let x20 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m31, x00),
                    self.m32,
                    x10,
                ),
            ),
            self.m33,
        );
        Vector3 { x: x00, y: x10, z: x20 }
    }

    #[inline(always)]
    fn upper(self: Matrix3<T>, b: Vector3<T>) -> Vector3<T> {
        let x20 = R::div(b.z, self.m33);
        let n12 = -self.m23;
        let x10 = R::div(R::mul_add(n12, x20, b.y), self.m22);
        let x00 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.x), self.m13, x20),
                    self.m12,
                    x10,
                ),
            ),
            self.m11,
        );
        Vector3 { x: x00, y: x10, z: x20 }
    }

    #[inline(always)]
    fn lower_unit(self: Matrix3<T>, b: Vector3<T>) -> Vector3<T> {
        let x00 = b.x;
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, x00, b.y);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m31, x00), self.m32, x10,
            ),
        );
        Vector3 { x: x00, y: x10, z: x20 }
    }

    #[inline(always)]
    fn lower_with_diag(self: Matrix3<T>, b: Vector3<T>, diag: T) -> Vector3<T> {
        let x00 = b.x;
        let q00 = R::div(x00, diag);
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, q00, b.y);
        let q10 = R::div(x10, diag);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.z), self.m31, q00), self.m32, q10,
            ),
        );
        Vector3 { x: x00, y: x10, z: x20 }
    }

    #[inline(always)]
    fn nonzero_diagonal(self: Matrix3<T>) -> bool {
        self.m11 != R::zero() && self.m22 != R::zero() && self.m33 != R::zero()
    }

    #[inline(always)]
    fn is_zero(x: T) -> bool {
        x == R::zero()
    }

    #[inline(always)]
    fn tr_mul_rhs(self: Matrix3<T>, b: Vector3<T>) -> Vector3<T> {
        MatrixTrMul::tr_mul(self, b)
    }
}

impl Matrix3SolveKernelMatrix3x2<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Mul<T>, +Neg<T>, +PartialEq<T>,
> of SolveKernel<Matrix3<T>, Matrix3x2<T>> {
    type Scalar = T;

    fn lower(self: Matrix3<T>, b: Matrix3x2<T>) -> Matrix3x2<T> {
        let x00 = R::div(b.m11, self.m11);
        let x01 = R::div(b.m12, self.m11);
        let n10 = -self.m21;
        let x10 = R::div(R::mul_add(n10, x00, b.m21), self.m22);
        let x11 = R::div(R::mul_add(n10, x01, b.m22), self.m22);
        let x20 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m31), self.m31, x00),
                    self.m32,
                    x10,
                ),
            ),
            self.m33,
        );
        let x21 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m32), self.m31, x01),
                    self.m32,
                    x11,
                ),
            ),
            self.m33,
        );
        Matrix3x2 { m11: x00, m21: x10, m31: x20, m12: x01, m22: x11, m32: x21 }
    }

    fn upper(self: Matrix3<T>, b: Matrix3x2<T>) -> Matrix3x2<T> {
        let x20 = R::div(b.m31, self.m33);
        let x21 = R::div(b.m32, self.m33);
        let n12 = -self.m23;
        let x10 = R::div(R::mul_add(n12, x20, b.m21), self.m22);
        let x11 = R::div(R::mul_add(n12, x21, b.m22), self.m22);
        let x00 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m11), self.m13, x20),
                    self.m12,
                    x10,
                ),
            ),
            self.m11,
        );
        let x01 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m12), self.m13, x21),
                    self.m12,
                    x11,
                ),
            ),
            self.m11,
        );
        Matrix3x2 { m11: x00, m21: x10, m31: x20, m12: x01, m22: x11, m32: x21 }
    }

    fn lower_unit(self: Matrix3<T>, b: Matrix3x2<T>) -> Matrix3x2<T> {
        let x00 = b.m11;
        let x01 = b.m12;
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, x00, b.m21);
        let x11 = R::mul_add(n10, x01, b.m22);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m31), self.m31, x00), self.m32, x10,
            ),
        );
        let x21 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m32), self.m31, x01), self.m32, x11,
            ),
        );
        Matrix3x2 { m11: x00, m21: x10, m31: x20, m12: x01, m22: x11, m32: x21 }
    }

    fn lower_with_diag(self: Matrix3<T>, b: Matrix3x2<T>, diag: T) -> Matrix3x2<T> {
        let x00 = b.m11;
        let x01 = b.m12;
        let q00 = R::div(x00, diag);
        let q01 = R::div(x01, diag);
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, q00, b.m21);
        let x11 = R::mul_add(n10, q01, b.m22);
        let q10 = R::div(x10, diag);
        let q11 = R::div(x11, diag);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m31), self.m31, q00), self.m32, q10,
            ),
        );
        let x21 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m32), self.m31, q01), self.m32, q11,
            ),
        );
        Matrix3x2 { m11: x00, m21: x10, m31: x20, m12: x01, m22: x11, m32: x21 }
    }

    #[inline(always)]
    fn nonzero_diagonal(self: Matrix3<T>) -> bool {
        self.m11 != R::zero() && self.m22 != R::zero() && self.m33 != R::zero()
    }

    #[inline(always)]
    fn is_zero(x: T) -> bool {
        x == R::zero()
    }

    #[inline(always)]
    fn tr_mul_rhs(self: Matrix3<T>, b: Matrix3x2<T>) -> Matrix3x2<T> {
        MatrixTrMul::tr_mul(self, b)
    }
}

impl Matrix3SolveKernelMatrix3<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Mul<T>, +Neg<T>, +PartialEq<T>,
> of SolveKernel<Matrix3<T>, Matrix3<T>> {
    type Scalar = T;

    fn lower(self: Matrix3<T>, b: Matrix3<T>) -> Matrix3<T> {
        let (x00, x01, x02) = R::div3(b.m11, b.m12, b.m13, self.m11);
        let n10 = -self.m21;
        let (x10, x11, x12) = R::div3(
            R::mul_add(n10, x00, b.m21),
            R::mul_add(n10, x01, b.m22),
            R::mul_add(n10, x02, b.m23),
            self.m22,
        );
        let (x20, x21, x22) = R::div3(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m31), self.m31, x00),
                    self.m32,
                    x10,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m32), self.m31, x01),
                    self.m32,
                    x11,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m33), self.m31, x02),
                    self.m32,
                    x12,
                ),
            ),
            self.m33,
        );
        Matrix3 {
            m11: x00,
            m21: x10,
            m31: x20,
            m12: x01,
            m22: x11,
            m32: x21,
            m13: x02,
            m23: x12,
            m33: x22,
        }
    }

    fn upper(self: Matrix3<T>, b: Matrix3<T>) -> Matrix3<T> {
        let (x20, x21, x22) = R::div3(b.m31, b.m32, b.m33, self.m33);
        let n12 = -self.m23;
        let (x10, x11, x12) = R::div3(
            R::mul_add(n12, x20, b.m21),
            R::mul_add(n12, x21, b.m22),
            R::mul_add(n12, x22, b.m23),
            self.m22,
        );
        let (x00, x01, x02) = R::div3(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m11), self.m13, x20),
                    self.m12,
                    x10,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m12), self.m13, x21),
                    self.m12,
                    x11,
                ),
            ),
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m13), self.m13, x22),
                    self.m12,
                    x12,
                ),
            ),
            self.m11,
        );
        Matrix3 {
            m11: x00,
            m21: x10,
            m31: x20,
            m12: x01,
            m22: x11,
            m32: x21,
            m13: x02,
            m23: x12,
            m33: x22,
        }
    }

    fn lower_unit(self: Matrix3<T>, b: Matrix3<T>) -> Matrix3<T> {
        let x00 = b.m11;
        let x01 = b.m12;
        let x02 = b.m13;
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, x00, b.m21);
        let x11 = R::mul_add(n10, x01, b.m22);
        let x12 = R::mul_add(n10, x02, b.m23);
        let x20 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m31), self.m31, x00), self.m32, x10,
            ),
        );
        let x21 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m32), self.m31, x01), self.m32, x11,
            ),
        );
        let x22 = R::wide_rescale(
            R::wide_sub_prod(
                R::wide_sub_prod(R::wide_add(R::wide_zero(), b.m33), self.m31, x02), self.m32, x12,
            ),
        );
        Matrix3 {
            m11: x00,
            m21: x10,
            m31: x20,
            m12: x01,
            m22: x11,
            m32: x21,
            m13: x02,
            m23: x12,
            m33: x22,
        }
    }

    fn lower_with_diag(self: Matrix3<T>, b: Matrix3<T>, diag: T) -> Matrix3<T> {
        let x00 = b.m11;
        let x01 = b.m12;
