        let n10 = -self.m21;
        let x10 = R::mul_add(n10, q00, b.m21);
        let x11 = R::mul_add(n10, q01, b.m22);
        let x12 = R::mul_add(n10, q02, b.m23);
        Matrix2x3 { m11: x00, m21: x10, m12: x01, m22: x11, m13: x02, m23: x12 }
    }

    #[inline(always)]
    fn nonzero_diagonal(self: Matrix2<T>) -> bool {
        self.m11 != R::zero() && self.m22 != R::zero()
    }

    #[inline(always)]
    fn is_zero(x: T) -> bool {
        x == R::zero()
    }

    #[inline(always)]
    fn tr_mul_rhs(self: Matrix2<T>, b: Matrix2x3<T>) -> Matrix2x3<T> {
        MatrixTrMul::tr_mul(self, b)
    }
}

