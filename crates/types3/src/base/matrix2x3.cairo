    }

    fn upper(self: Matrix2<T>, b: Matrix2x3<T>) -> Matrix2x3<T> {
        let (x10, x11, x12) = R::div3(b.m21, b.m22, b.m23, self.m22);
        let n01 = -self.m12;
        let (x00, x01, x02) = R::div3(
            R::mul_add(n01, x10, b.m11),
            R::mul_add(n01, x11, b.m12),
            R::mul_add(n01, x12, b.m13),
            self.m11,
        );
        Matrix2x3 { m11: x00, m21: x10, m12: x01, m22: x11, m13: x02, m23: x12 }
    }

    fn lower_unit(self: Matrix2<T>, b: Matrix2x3<T>) -> Matrix2x3<T> {
        let x00 = b.m11;
        let x01 = b.m12;
        let x02 = b.m13;
        let n10 = -self.m21;
        let x10 = R::mul_add(n10, x00, b.m21);
        let x11 = R::mul_add(n10, x01, b.m22);
        let x12 = R::mul_add(n10, x02, b.m23);
        Matrix2x3 { m11: x00, m21: x10, m12: x01, m22: x11, m13: x02, m23: x12 }
    }

