        let (eq, er) = (mat5x1(eq), mat1x1(er));
        ex = max(ex, excess(ulp_diff(q.x, eq.x), oracle_tol(abs_raw(eq.x), tol)));
        ex = max(ex, excess(ulp_diff(q.y, eq.y), oracle_tol(abs_raw(eq.y), tol)));
