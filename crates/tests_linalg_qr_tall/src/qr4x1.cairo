/// `qr4x1_q_r` (oracle): `q` and `r` entry by entry within the oracle tolerance (upstream's
/// unpacked factors: `diag(r) >= 0`), `q r = A` and the orthonormality of `q` within the
/// measured bounds.
#[test]
fn test_oracle_qr4x1_q_r() {
    let mut cases = oracle::qr4x1_q_r_cases();
    let (mut ex, mut rec, mut orth) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, eq, er, tol) = *case;
        let a = black_box(mat4x1(a));
        let f = a.qr();
        let (q, r) = f.unpack();
        let (q2, r2) = f.qr_internal();
        assert!(q2 == q && r2 == r && f.q() == q && f.r() == r && f.unpack_r() == r);
        let (eq, er) = (mat4x1(eq), mat1x1(er));
        ex = max(ex, excess(ulp_diff(q.x, eq.x), oracle_tol(abs_raw(eq.x), tol)));
        ex = max(ex, excess(ulp_diff(q.y, eq.y), oracle_tol(abs_raw(eq.y), tol)));
        ex = max(ex, excess(ulp_diff(q.z, eq.z), oracle_tol(abs_raw(eq.z), tol)));
        ex = max(ex, excess(ulp_diff(q.w, eq.w), oracle_tol(abs_raw(eq.w), tol)));
        ex = max(ex, excess(ulp_diff(r.x, er.x), oracle_tol(abs_raw(er.x), tol)));
        rec = max(rec, max_ulp_4x1(q.mul_mat(r), a) / amax_4x1(a));
        orth = max(orth, orth_4x1(q));
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
    assert!(rec <= 1 && orth <= 1, "measured {} {}", rec, orth);
}

