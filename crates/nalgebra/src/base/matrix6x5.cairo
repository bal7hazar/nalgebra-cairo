/// `self += rhs`. Exact; panics on overflow. Upstream: `AddAssign`.
pub impl Matrix6x5AddAssign<
    T, +Add<T>, +Copy<T>, +Drop<T>,
> of AddAssign<Matrix6x5<T>, Matrix6x5<T>> {
    #[inline(always)]
    fn add_assign(ref self: Matrix6x5<T>, rhs: Matrix6x5<T>) {
        self = self + rhs;
    }
}

/// `self -= rhs`. Exact; panics on overflow. Upstream: `SubAssign`.
pub impl Matrix6x5SubAssign<
    T, +Sub<T>, +Copy<T>, +Drop<T>,
> of SubAssign<Matrix6x5<T>, Matrix6x5<T>> {
    #[inline(always)]
    fn sub_assign(ref self: Matrix6x5<T>, rhs: Matrix6x5<T>) {
        self = self - rhs;
    }
}

