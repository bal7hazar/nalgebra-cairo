/// `self * rhs`, a `Vector6`: the 5 products of each component accumulated exactly in `Real::Wide`
/// and rescaled once. Panics on overflow. Upstream: `Matrix6x5 * Vector5` (`Mul`).
pub impl Matrix6x5MulVector5<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>,
> of MatrixMul<Matrix6x5<T>, Vector5<T>> {
    type Output = Vector6<T>;
    fn mul_mat(self: Matrix6x5<T>, rhs: Vector5<T>) -> Vector6<T> {
        Vector6 {
            x: Fused::sum_prod5(
                self.m11, rhs.x, self.m12, rhs.y, self.m13, rhs.z, self.m14, rhs.w, self.m15, rhs.a,
            ),
            y: Fused::sum_prod5(
                self.m21, rhs.x, self.m22, rhs.y, self.m23, rhs.z, self.m24, rhs.w, self.m25, rhs.a,
            ),
            z: Fused::sum_prod5(
                self.m31, rhs.x, self.m32, rhs.y, self.m33, rhs.z, self.m34, rhs.w, self.m35, rhs.a,
            ),
            w: Fused::sum_prod5(
                self.m41, rhs.x, self.m42, rhs.y, self.m43, rhs.z, self.m44, rhs.w, self.m45, rhs.a,
            ),
            a: Fused::sum_prod5(
                self.m51, rhs.x, self.m52, rhs.y, self.m53, rhs.z, self.m54, rhs.w, self.m55, rhs.a,
            ),
            b: Fused::sum_prod5(
                self.m61, rhs.x, self.m62, rhs.y, self.m63, rhs.z, self.m64, rhs.w, self.m65, rhs.a,
            ),
        }
    }
}

