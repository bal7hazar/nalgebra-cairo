// --- iterator sums and products, crate-root functions (WP 8.6-P21) -------------------------------

/// `iter.sum()` of an iterator of `RowVector5`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 5-dimensional row vector when empty. Upstream: `Sum for Matrix` (a
/// fold from `zero()`: the same result, one addition more).
pub impl RowVector5Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<RowVector5<T>> {
    fn sum<I, +Iterator<I>[Item: RowVector5<T>], +Destruct<I>, +Destruct<RowVector5<T>>>(
        mut iter: I,
    ) -> RowVector5<T> {
        let Option::Some(mut acc) = iter.next() else {
            return RowVector5 {
                x: R::zero(), y: R::zero(), z: R::zero(), w: R::zero(), a: R::zero(),
            };
        };
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + x;
        }
        acc
    }
}

/// `*iter.sum()` of an iterator of snapshots `@RowVector5` (`span.into_iter()`): a snapshot of the
/// sum of the items, like `Sum<RowVector5>`. Upstream: `Sum<&Matrix> for Matrix` (references).
pub impl RowVector5SumSnapshot<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<@RowVector5<T>> {
    fn sum<I, +Iterator<I>[Item: @RowVector5<T>], +Destruct<I>, +Destruct<@RowVector5<T>>>(
        mut iter: I,
    ) -> @RowVector5<T> {
        let Option::Some(first) = iter.next() else {
            return @RowVector5 {
                x: R::zero(), y: R::zero(), z: R::zero(), w: R::zero(), a: R::zero(),
            };
        };
        let mut acc = *first;
        loop {
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
            let Option::Some(x) = iter.next() else {
                break;
            };
            acc = acc + *x;
        }
        @acc
    }
}

