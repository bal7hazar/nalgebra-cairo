    fn into(self: [[T; 1]; 1]) -> Matrix1<T> {
        let [c0] = self;
        let [x] = c0;
        Matrix1 { x }
    }
}

/// The columns of the 1x1 matrix as nested arrays (`[[m11, m21, ..], [m12, ..], ..]`). Upstream:
/// `Into<[[T; R]; C]>`.
pub impl Matrix1IntoColumnArrays<T, +Drop<T>> of Into<Matrix1<T>, [[T; 1]; 1]> {
    #[inline(always)]
    fn into(self: Matrix1<T>) -> [[T; 1]; 1] {
