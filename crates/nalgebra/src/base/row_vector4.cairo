    }

    /// `f(.. f(f(init, x0), x1) .., x3)` over the components in column-major order. The closure's
    /// output converts `Into<Acc>` (the identity included): Cairo cannot state `Output = Acc`
    /// without the `associated_item_constraints` experimental feature. `f` is any closure or `Fn`
    /// value; Cairo closures take their arguments by value and cannot mutate their captures.
    /// Upstream: `fold`.
    #[inline]
    fn fold<Acc, F, +Drop<F>, impl Func: core::ops::Fn<F, (Acc, T)>, +Into<Func::Output, Acc>>(
        self: RowVector4<T>, init: Acc, f: F,
    ) -> Acc {
        let acc: Acc = f(init, self.x).into();
        let acc: Acc = f(acc, self.y).into();
        let acc: Acc = f(acc, self.z).into();
        f(acc, self.w).into()
    }

    /// `init_f(Some(x0))`, then `f(acc, x)` over the other components in column-major order:
    /// upstream's `fold_with` (`init_f` receives the first component, `None` only for an empty
    /// matrix, which a static shape never is). The accumulator has the type of `init_f`'s output;
    /// `f`'s output converts `Into` it. The closures receive values instead of upstream's `&T`.
    /// Upstream: `fold_with`.
    #[inline]
    fn fold_with<
        G,
        +Drop<G>,
        impl Init: core::ops::Fn<G, (Option<T>,)>,
        +Drop<Init::Output>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Init::Output, T)>,
        +Into<Func::Output, Init::Output>,
    >(
        self: RowVector4<T>, init_f: G, f: F,
    ) -> Init::Output {
        let acc: Init::Output = init_f(Option::Some(self.x));
        let acc: Init::Output = f(acc, self.y).into();
        let acc: Init::Output = f(acc, self.z).into();
        f(acc, self.w).into()
    }

    /// `fold` over the pairs of components of `self` and `rhs` at the same position: `f(acc, a,
    /// b)`, column-major. `f` is any closure or `Fn` value; Cairo closures take their arguments by
    /// value and cannot mutate their captures. Upstream: `zip_fold`.
    #[inline]
    fn zip_fold<
        T2,
        +Copy<T2>,
        +Drop<T2>,
        Acc,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Acc, T, T2)>,
        +Into<Func::Output, Acc>,
    >(
        self: RowVector4<T>, rhs: RowVector4<T2>, init: Acc, f: F,
    ) -> Acc {
        let acc: Acc = f(init, self.x, rhs.x).into();
        let acc: Acc = f(acc, self.y, rhs.y).into();
        let acc: Acc = f(acc, self.z, rhs.z).into();
        f(acc, self.w, rhs.w).into()
    }

    /// Replaces every component `x` by `f(x)` (column-major order). Upstream's closure is
    /// `FnMut(&mut T)`, writing through the reference; a Cairo closure cannot, so it RETURNS the
    /// new component (its output converts `Into<T>`). Upstream: `apply`.
    #[inline]
    fn apply<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Into<Func::Output, T>>(
        ref self: RowVector4<T>, f: F,
    ) {
        self =
            RowVector4 {
                x: f(self.x).into(), y: f(self.y).into(), z: f(self.z).into(), w: f(self.w).into(),
            };
    }

    /// `self` with every component `x` replaced by `f(x)`: `apply` by value. Upstream's closure is
    /// `FnMut(&mut T)`, writing through the reference; a Cairo closure cannot, so it RETURNS the
    /// new component (its output converts `Into<T>`). Upstream: `apply_into`.
    #[inline]
    fn apply_into<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Into<Func::Output, T>>(
        self: RowVector4<T>, f: F,
    ) -> RowVector4<T> {
        RowVector4 {
            x: f(self.x).into(), y: f(self.y).into(), z: f(self.z).into(), w: f(self.w).into(),
        }
    }

    /// Replaces every component `a` by `f(a, b)`, `b` the component of `rhs` at the same position.
    /// Upstream's closure is `FnMut(&mut T)`, writing through the reference; a Cairo closure
    /// cannot, so it RETURNS the new component (its output converts `Into<T>`). Upstream:
    /// `zip_apply`.
    #[inline]
    fn zip_apply<
        T2,
        +Copy<T2>,
        +Drop<T2>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2)>,
        +Into<Func::Output, T>,
    >(
        ref self: RowVector4<T>, rhs: RowVector4<T2>, f: F,
    ) {
        self =
            RowVector4 {
                x: f(self.x, rhs.x).into(),
                y: f(self.y, rhs.y).into(),
                z: f(self.z, rhs.z).into(),
                w: f(self.w, rhs.w).into(),
            };
    }

    /// Replaces every component `a` by `f(a, b, c)`, `b` and `c` the components of `b` and `c` at
    /// the same position. Upstream's closure is `FnMut(&mut T)`, writing through the reference; a
    /// Cairo closure cannot, so it RETURNS the new component (its output converts `Into<T>`).
    /// Upstream: `zip_zip_apply`.
    #[inline]
    fn zip_zip_apply<
        T2,
        T3,
        +Copy<T2>,
        +Drop<T2>,
        +Copy<T3>,
        +Drop<T3>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2, T3)>,
        +Into<Func::Output, T>,
    >(
        ref self: RowVector4<T>, b: RowVector4<T2>, c: RowVector4<T3>, f: F,
    ) {
        self =
            RowVector4 {
                x: f(self.x, b.x, c.x).into(),
                y: f(self.y, b.y, c.y).into(),
                z: f(self.z, b.z, c.z).into(),
                w: f(self.w, b.w, c.w).into(),
            };
    }

    /// Sets every component to `f()` (one call per component, column-major). The closure's output
    /// converts `Into<T>`. Upstream: `fill_with` (`impl Fn() -> T`).
    #[inline]
    fn fill_with<F, +Drop<F>, impl Func: core::ops::Fn<F, ()>, +Into<Func::Output, T>>(
        ref self: RowVector4<T>, f: F,
    ) {
        self = RowVector4 { x: f().into(), y: f().into(), z: f().into(), w: f().into() };
    }

    /// Sets every component to `val`. Upstream: `fill`.
    #[inline(always)]
    fn fill(ref self: RowVector4<T>, val: T) {
        self = RowVector4 { x: val, y: val, z: val, w: val };
    }

    /// Sets the 1 diagonal components to `val`, the others unchanged. Upstream: `fill_diagonal`.
    #[inline(always)]
    fn fill_diagonal(ref self: RowVector4<T>, val: T) {
        self = RowVector4 { x: val, y: self.y, z: self.z, w: self.w };
    }

    /// Sets `self` to the identity: ones on the diagonal, zeros elsewhere (`fill(0)` then
    /// `fill_diagonal(1)`). Upstream: `fill_with_identity`.
    #[inline(always)]
    fn fill_with_identity(ref self: RowVector4<T>) {
        self = RowVector4 { x: R::one(), y: R::zero(), z: R::zero(), w: R::zero() };
    }

    /// Sets the 4 components of row `i` to `val`. Panics with `nalgebra: index out of bounds` for
    /// `i >= 1`. Upstream: `fill_row`.
    ///
    /// ONE `match` on `i` selects the literal: measured 2.1 times cheaper than one comparison per
    /// component (`bench_matrix4_fill_row__alt_per_component`).
    #[inline(always)]
    fn fill_row(ref self: RowVector4<T>, i: usize, val: T) {
        self = match i {
            0 => RowVector4 { x: val, y: val, z: val, w: val },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        };
    }

    /// Sets the 1 components of column `j` to `val`. Panics with `nalgebra: index out of bounds`
    /// for `j >= 4`. Upstream: `fill_column`.
    #[inline(always)]
    fn fill_column(ref self: RowVector4<T>, j: usize, val: T) {
        self = match j {
            0 => RowVector4 { x: val, y: self.y, z: self.z, w: self.w },
            1 => RowVector4 { x: self.x, y: val, z: self.z, w: self.w },
            2 => RowVector4 { x: self.x, y: self.y, z: val, w: self.w },
            3 => RowVector4 { x: self.x, y: self.y, z: self.z, w: val },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        };
    }

    /// Sets every component `(i, j)` with `i >= j + shift` to `val`: the lower triangle with the
    /// diagonal for `shift = 0`, without it for `shift = 1`, leaving `shift - 1` subdiagonals as
    /// well above; nothing changes for `shift >= 1`. ONE `match` on `shift` selects the literal:
    /// measured 2.7 times cheaper than one threshold test per component
    /// (`bench_matrix4_fill_lower_triangle__alt_per_component`). Upstream: `fill_lower_triangle`.
    #[inline(always)]
    fn fill_lower_triangle(ref self: RowVector4<T>, val: T, shift: usize) {
        self = match shift {
            0 => RowVector4 { x: val, y: self.y, z: self.z, w: self.w },
            _ => self,
        };
    }

    /// Sets every component `(i, j)` with `j >= i + shift` to `val`: the upper triangle with the
    /// diagonal for `shift = 0`, without it for `shift = 1`, leaving `shift - 1` superdiagonals as
    /// well below; nothing changes for `shift >= 4`. ONE `match` on `shift` selects the literal.
    /// Upstream: `fill_upper_triangle`.
    #[inline(always)]
    fn fill_upper_triangle(ref self: RowVector4<T>, val: T, shift: usize) {
        self = match shift {
            0 => RowVector4 { x: val, y: val, z: val, w: val },
            1 => RowVector4 { x: self.x, y: val, z: val, w: val },
            2 => RowVector4 { x: self.x, y: self.y, z: val, w: val },
            3 => RowVector4 { x: self.x, y: self.y, z: self.z, w: val },
            _ => self,
        };
    }

    /// Replaces row `i` by `row`, a `RowVector4`. Panics with `nalgebra: index out of bounds` for
    /// `i >= 1`. Upstream: `set_row`.
    #[inline(always)]
    fn set_row(ref self: RowVector4<T>, i: usize, row: RowVector4<T>) {
        self = match i {
            0 => RowVector4 { x: row.x, y: row.y, z: row.z, w: row.w },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        };
    }

    /// Replaces column `j` by `column`, a `Matrix1`. Panics with `nalgebra: index out of bounds`
    /// for `j >= 4`. Upstream: `set_column`.
    #[inline(always)]
    fn set_column(ref self: RowVector4<T>, j: usize, column: Matrix1<T>) {
        self = match j {
            0 => RowVector4 { x: column.x, y: self.y, z: self.z, w: self.w },
            1 => RowVector4 { x: self.x, y: column.x, z: self.z, w: self.w },
            2 => RowVector4 { x: self.x, y: self.y, z: column.x, w: self.w },
            3 => RowVector4 { x: self.x, y: self.y, z: self.z, w: column.x },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        };
    }

    /// Replaces the diagonal by `diag`, a `Matrix1` (upstream requires the length `min(R, C)` = 1).
    /// Upstream: `set_diagonal`.
    #[inline(always)]
    fn set_diagonal(ref self: RowVector4<T>, diag: Matrix1<T>) {
        self = RowVector4 { x: diag.x, y: self.y, z: self.z, w: self.w };
    }

    /// Replaces the first `min(diag.len(), 1)` diagonal components by the values of `diag` (the
    /// extra values are ignored, like upstream's `take`), the others unchanged. Upstream:
    /// `set_partial_diagonal` (an iterator; a `Span` here).
    #[inline(always)]
    fn set_partial_diagonal(ref self: RowVector4<T>, diag: Span<T>) {
        let len = diag.len();
        self =
            RowVector4 {
                x: if len > 0 {
                    *diag[0]
                } else {
                    self.x
                }, y: self.y, z: self.z, w: self.w,
            };
    }

    /// Sets `self` to `other` (a `RowVector4`: upstream requires the same shape). Upstream:
    /// `copy_from`.
    #[inline(always)]
    fn copy_from(ref self: RowVector4<T>, other: RowVector4<T>) {
        self = other;
    }

    /// Sets `self` to the 4 values of `slice` in column-major order (`from_column_slice`). Panics
    /// with `nalgebra: wrong slice length` unless `slice.len() == 4`. Upstream: `copy_from_slice`
    /// (`&[T]`).
    #[inline(always)]
    fn copy_from_slice(ref self: RowVector4<T>, slice: Span<T>) {
        self = Self::from_column_slice(slice);
    }

    /// Sets `self` to the transpose of `other`, a `Vector4`. Exact. Upstream: `tr_copy_from`.
    #[inline(always)]
    fn tr_copy_from(ref self: RowVector4<T>, other: Vector4<T>) {
        self = RowVector4 { x: other.x, y: other.y, z: other.z, w: other.w };
    }

    /// Exchanges the components at `row_cols1` and `row_cols2` (`(row, column)`). Panics with
    /// `nalgebra: index out of bounds` when either is out of the shape. Upstream: `swap`.
    #[inline]
    fn swap(ref self: RowVector4<T>, row_cols1: (usize, usize), row_cols2: (usize, usize)) {
        let a = MatrixIndex::index(self, row_cols1);
        let b = MatrixIndex::index(self, row_cols2);
        self =
            RowVector4EditTrait::replace(
                RowVector4EditTrait::replace(self, row_cols1, b), row_cols2, a,
            );
    }

    /// Exchanges rows `irow1` and `irow2`. Panics with `nalgebra: index out of bounds` when either
    /// is `>= 1`. Upstream: `swap_rows`.
    ///
    /// Two reads and two writes of a row (one `match` each). ONE nested `match` on both rows is 940
    /// gas (15%) cheaper on `Matrix3` (`bench_matrix3_swap_rows__alt_pair_match`) but generates R²
    /// whole-shape literals (about 40 000 lines over the 36 shapes, per method): kept as a
    /// benchmark.
    #[inline]
    fn swap_rows(ref self: RowVector4<T>, irow1: usize, irow2: usize) {
        let a = RowVector4EditTrait::row_at(self, irow1);
        let b = RowVector4EditTrait::row_at(self, irow2);
        Self::set_row(ref self, irow1, b);
        Self::set_row(ref self, irow2, a);
    }

    /// Exchanges columns `icol1` and `icol2`. Panics with `nalgebra: index out of bounds` when
    /// either is `>= 4`. Upstream: `swap_columns`.
    #[inline]
    fn swap_columns(ref self: RowVector4<T>, icol1: usize, icol2: usize) {
        let a = RowVector4EditTrait::column_at(self, icol1);
        let b = RowVector4EditTrait::column_at(self, icol2);
        Self::set_column(ref self, icol1, b);
        Self::set_column(ref self, icol2, a);
    }

    /// `self = -self`. Exact; panics on overflow (`-MIN`). Upstream: `neg_mut`.
    #[inline(always)]
    fn neg_mut(ref self: RowVector4<T>) {
        self = -self;
    }

    /// `self = self.scale(k)`, each component floored once. Panics on overflow. Upstream:
    /// `scale_mut`.
    #[inline(always)]
    fn scale_mut(ref self: RowVector4<T>, k: T) {
        self = Self::scale(self, k);
    }

    /// `self = self.unscale(k)`, each component correctly rounded. Panics on a zero `k` and on
    /// overflow. Upstream: `unscale_mut`.
    #[inline(always)]
    fn unscale_mut(ref self: RowVector4<T>, k: T) {
        self = Self::unscale(self, k);
    }

    /// Normalizes `self` in place (`self = self.normalize()`, bit-identical) and returns the norm
    /// it had. Panics with a division by zero when the norm is zero. Upstream: `normalize_mut`.
    #[inline(always)]
    fn normalize_mut(ref self: RowVector4<T>) -> T {
        let n = Self::norm(self);
        self = Self::unscale(self, n);
        n
    }

    /// Normalizes `self` in place and returns `Some` of the norm it had, or leaves it unchanged and
    /// returns `None` when that norm is `<= min_norm`. Upstream: `try_normalize_mut`.
    #[inline(always)]
    fn try_normalize_mut(ref self: RowVector4<T>, min_norm: T) -> Option<T> {
        let n = Self::norm(self);
        if n <= min_norm {
            return None;
        }
        self = Self::unscale(self, n);
        Some(n)
    }

    /// Scales `self` to the norm `magnitude`: `self.scale(magnitude / norm)`, the ratio rounded to
    /// nearest (like `try_set_magnitude`). Panics with a division by zero when the norm is zero
    /// (upstream's floats give NaN). Upstream: `set_magnitude`.
    #[inline(always)]
    fn set_magnitude(ref self: RowVector4<T>, magnitude: T) {
        let n = Self::norm(self);
        self = Self::scale(self, R::div(magnitude, n));
    }

    /// `self = self.add_scalar(k)`. Exact; panics on overflow. Upstream: `add_scalar_mut`.
    #[inline(always)]
    fn add_scalar_mut(ref self: RowVector4<T>, k: T) {
        self = Self::add_scalar(self, k);
    }

    /// Alias of `component_mul_assign` (deprecated upstream). Upstream: `component_mul_mut`.
    #[inline(always)]
    fn component_mul_mut(ref self: RowVector4<T>, rhs: RowVector4<T>) {
        Self::component_mul_assign(ref self, rhs);
    }

    /// Alias of `component_div_assign` (deprecated upstream). Upstream: `component_div_mut`.
    #[inline(always)]
    fn component_div_mut(ref self: RowVector4<T>, rhs: RowVector4<T>) {
        Self::component_div_assign(ref self, rhs);
    }

    /// Conjugates every component in place: nothing changes for a real scalar. Upstream:
    /// `conjugate_mut`.
    #[inline(always)]
    fn conjugate_mut(ref self: RowVector4<T>) {
        self = Self::conjugate(self);
    }

    /// Writes the transpose of `self` into `out`, a `Vector4`. Exact. Upstream: `transpose_to`.
    #[inline(always)]
    fn transpose_to(self: RowVector4<T>, ref out: Vector4<T>) {
        out = Self::transpose(self);
    }

    /// Writes the adjoint of `self` (its transpose for a real scalar) into `out`, a `Vector4`.
    /// Exact. Upstream: `adjoint_to`.
    #[inline(always)]
    fn adjoint_to(self: RowVector4<T>, ref out: Vector4<T>) {
        out = Self::transpose(self);
    }

    /// Writes the adjoint of `self` (deprecated upstream alias of `adjoint_to`) into `out`, a
    /// `Vector4`. Exact. Upstream: `conjugate_transpose_to`.
    #[inline(always)]
    fn conjugate_transpose_to(self: RowVector4<T>, ref out: Vector4<T>) {
        out = Self::transpose(self);
    }

    /// Writes the sum `self + rhs` into `out`. Exact; panics on overflow. Upstream: `add_to`.
    #[inline(always)]
    fn add_to(self: RowVector4<T>, rhs: RowVector4<T>, ref out: RowVector4<T>) {
        out = self + rhs;
    }

    /// Writes the difference `self - rhs` into `out`. Exact; panics on overflow. Upstream:
    /// `sub_to`.
    #[inline(always)]
    fn sub_to(self: RowVector4<T>, rhs: RowVector4<T>, ref out: RowVector4<T>) {
        out = self - rhs;
    }

    /// The norm `norm` of `self`: `EuclideanNorm {}` (`norm`), `LpNorm { p }` (`lp_norm(p)`),
    /// `OneNorm {}` (`one_norm`) or `UniformNorm {}` (`amax`), through their `Norm` impls (static
    /// dispatch). Upstream: `apply_norm` (`&impl Norm<T>`; the markers are `Copy` values here).
    #[inline]
    fn apply_norm<N, +Drop<N>, impl Nm: Norm<N, RowVector4<T>, T>>(
        self: RowVector4<T>, norm: N,
    ) -> T {
        Nm::norm(@norm, self)
    }

    /// The distance between `self` and `rhs` in the norm `norm` (see `apply_norm`; the Euclidean
    /// one is the fused `metric_distance`, the others the norm of the exact difference). Upstream:
    /// `apply_metric_distance`.
    #[inline]
    fn apply_metric_distance<N, +Drop<N>, impl Nm: Norm<N, RowVector4<T>, T>>(
        self: RowVector4<T>, rhs: RowVector4<T>, norm: N,
    ) -> T {
        Nm::metric_distance(@norm, self, rhs)
    }

    /// The number of rows, 1. Upstream: `nrows`.
    #[inline(always)]
    fn nrows(self: RowVector4<T>) -> usize {
        1
    }

    /// The number of columns, 4. Upstream: `ncols`.
    #[inline(always)]
    fn ncols(self: RowVector4<T>) -> usize {
        4
    }

    /// `(nrows, ncols)`, `(1, 4)`. Upstream: `shape`.
    #[inline(always)]
    fn shape(self: RowVector4<T>) -> (usize, usize) {
        (1, 4)
    }

    /// Whether the shape is square: `false`. Upstream: `is_square`.
    #[inline(always)]
    fn is_square(self: RowVector4<T>) -> bool {
        false
    }

    /// The `(row, column)` of the `i`-th component in column-major order: `(i % 1, i / 1)`, one
    /// `DivRem` (no bounds check, like upstream). Upstream: `vector_to_matrix_index`.
    #[inline(always)]
    fn vector_to_matrix_index(self: RowVector4<T>, i: usize) -> (usize, usize) {
        (0, i)
    }

    /// Row `i`, a `RowVector4` (an owned copy: Cairo has no borrowed views). Panics with `nalgebra:
    /// index out of bounds` for `i >= 1`. ONE `match` on `i` selects the literal (the private
    /// `row_at` of `swap_rows`). Upstream: `row` (a view).
    #[inline(always)]
    fn row(self: RowVector4<T>, i: usize) -> RowVector4<T> {
        RowVector4EditTrait::row_at(self, i)
    }

    /// Column `j`, a `Matrix1` (an owned copy: Cairo has no borrowed views). Panics with `nalgebra:
    /// index out of bounds` for `j >= 4`. ONE `match` on `j` selects the literal (the private
    /// `column_at` of `swap_columns`). Upstream: `column` (a view).
    #[inline(always)]
    fn column(self: RowVector4<T>, j: usize) -> Matrix1<T> {
        RowVector4EditTrait::column_at(self, j)
    }

    /// The upper triangle of `self` (the diagonal included), the components below the diagonal set
    /// to zero. Exact. Upstream: `upper_triangle`.
    #[inline(always)]
    fn upper_triangle(self: RowVector4<T>) -> RowVector4<T> {
        RowVector4 { x: self.x, y: self.y, z: self.z, w: self.w }
    }

    /// The lower triangle of `self` (the diagonal included), the components above the diagonal set
    /// to zero. Exact. Upstream: `lower_triangle`.
    #[inline(always)]
    fn lower_triangle(self: RowVector4<T>) -> RowVector4<T> {
        RowVector4 { x: self.x, y: R::zero(), z: R::zero(), w: R::zero() }
    }

    /// The 4-dimensional row vector whose 1 rows are the given vectors, each a `Vector4` of the
    /// row's 4 components (the argument form of the former `Matrix2/3/4::from_rows`, used by
    /// `linalg`). Exact. Upstream: `from_rows` (a slice of row vectors).
    #[inline(always)]
    fn from_rows(r1: Vector4<T>) -> RowVector4<T> {
        RowVector4 { x: r1.x, y: r1.y, z: r1.z, w: r1.w }
    }

    /// The 4-dimensional row vector whose 4 columns are the given `Matrix1`s. Exact. Upstream:
    /// `from_columns` (a slice of column vectors).
    #[inline(always)]
    fn from_columns(
        c1: Matrix1<T>, c2: Matrix1<T>, c3: Matrix1<T>, c4: Matrix1<T>,
    ) -> RowVector4<T> {
        RowVector4 { x: c1.x, y: c2.x, z: c3.x, w: c4.x }
    }

    /// Whether the columns of `self` are orthonormal: `selfᵀ * self` (fused `tr_mul`, one
    /// rounding per component) is the 4x4 identity within `ulps`. Upstream: `is_orthogonal` (`eps`:
    /// here a tolerance in ulp, DESIGN D3).
    #[inline(always)]
    fn is_orthogonal(self: RowVector4<T>, ulps: u64) -> bool {
        Matrix4Trait::is_identity(MatrixTrMul::tr_mul(self, self), ulps)
    }

    /// `self` with a row of `val` inserted at index `i` (`i <= 1`), a `Matrix2x4`. Panics with
    /// `nalgebra: index out of bounds` for `i > 1`. Upstream: `insert_row`.
    #[inline(always)]
    fn insert_row(self: RowVector4<T>, i: usize, val: T) -> Matrix2x4<T> {
        match i {
            0 => Matrix2x4 {
                m11: val,
                m21: self.x,
                m12: val,
                m22: self.y,
                m13: val,
                m23: self.z,
                m14: val,
                m24: self.w,
            },
            1 => Matrix2x4 {
                m11: self.x,
                m21: val,
                m12: self.y,
                m22: val,
                m13: self.z,
                m23: val,
                m14: self.w,
                m24: val,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// `self` with a column of `val` inserted at index `i` (`i <= 4`), a `RowVector5`. Panics with
    /// `nalgebra: index out of bounds` for `i > 4`. Upstream: `insert_column`.
    #[inline(always)]
    fn insert_column(self: RowVector4<T>, i: usize, val: T) -> RowVector5<T> {
        match i {
            0 => RowVector5 { x: val, y: self.x, z: self.y, w: self.z, a: self.w },
            1 => RowVector5 { x: self.x, y: val, z: self.y, w: self.z, a: self.w },
            2 => RowVector5 { x: self.x, y: self.y, z: val, w: self.z, a: self.w },
            3 => RowVector5 { x: self.x, y: self.y, z: self.z, w: val, a: self.w },
            4 => RowVector5 { x: self.x, y: self.y, z: self.z, w: self.w, a: val },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// `self` without its column `i`, a `RowVector3`. Panics with `nalgebra: index out of bounds`
    /// for `i >= 4`. Upstream: `remove_column`.
    #[inline(always)]
    fn remove_column(self: RowVector4<T>, i: usize) -> RowVector3<T> {
        match i {
            0 => RowVector3 { x: self.y, y: self.z, z: self.w },
            1 => RowVector3 { x: self.x, y: self.z, z: self.w },
            2 => RowVector3 { x: self.x, y: self.y, z: self.w },
            3 => RowVector3 { x: self.x, y: self.y, z: self.z },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// The operations of `RowVector4<T>` that need `Transcendental` (inverse trigonometry, `exp`,
/// `ln`):
/// a scalar may implement `Real` only.
#[generate_trait]
pub impl RowVector4AngleImpl<
    T,
    impl R: Real<T>,
    impl Tr: Transcendental<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of RowVector4AngleTrait<T> {
    /// The angle between `self` and `other` seen as vectors of the Frobenius inner product, in `[0,
    /// π]` (up to the rounding of `atan2`); `0` when one of them is zero. Computed as `2 *
    /// atan2(|u - v|, |u + v|)` on the normalized `u`, `v` (Kahan): unlike upstream's `acos(dot /
    /// (|a| *
    /// |b|))` it cannot overflow on long inputs and stays accurate for nearly parallel ones. Panics
    /// when a norm does not fit. Upstream: `angle`.
    fn angle(self: RowVector4<T>, other: RowVector4<T>) -> T {
        let n1 = RowVector4Trait::norm(self);
        let n2 = RowVector4Trait::norm(other);
        if n1 == R::zero() || n2 == R::zero() {
            return R::zero();
        }
        let u = RowVector4Trait::unscale(self, n1);
        let v = RowVector4Trait::unscale(other, n2);
        let half = Tr::atan2(RowVector4Trait::metric_distance(u, v), RowVector4Trait::norm(u + v));
        half + half
    }

    /// The entrywise Lp norm `(Σ |a|^p)^(1/p)`. `p = 1` is the exact sum of the absolute values
    /// and `p = 2` the fused `norm` (both exact up to their one rounding); above, the components
    /// are first divided by the largest absolute value `m` (so no power can overflow), `Σ (|a| /
    /// m)^p`
    /// is summed (`p` floored products each), and the root is `m * exp(ln(Σ) / p)`: a few ulp
    /// relative to the result, the rounding of `exp` / `ln`. Panics with `nalgebra: lp_norm needs p
    /// >= 1` for `p < 1` (upstream returns meaningless values: an infinite root for `p = 0`).
    /// Upstream: `lp_norm`.
    fn lp_norm(self: RowVector4<T>, p: i32) -> T {
        if p < 1 {
            core::panic_with_felt252(errors::LP_NORM_P);
        }
        if p == 1 {
            return R::abs(self.x) + R::abs(self.y) + R::abs(self.z) + R::abs(self.w);
        }
        if p == 2 {
            return RowVector4Trait::norm(self);
        }
        let m = RowVector4Trait::amax(self);
        if m == R::zero() {
            return R::zero();
        }
        let r = RowVector4Trait::unscale(RowVector4Trait::abs(self), m);
        let q: u32 = p.try_into().unwrap();
        let s = Powi::powi(r.x, q) + Powi::powi(r.y, q) + Powi::powi(r.z, q) + Powi::powi(r.w, q);
        m * Tr::exp(R::div(Tr::ln(s), R::from_int(p)))
    }
}

