            m34: self.m34 * scaling.w,
            m44: self.m44 * scaling.w,
            m54: self.m54 * scaling.w,
            m64: self.m64 * scaling.w,
            m15: self.m15 * scaling.a,
            m25: self.m25 * scaling.a,
            m35: self.m35 * scaling.a,
            m45: self.m45 * scaling.a,
            m55: self.m55 * scaling.a,
            m65: self.m65 * scaling.a,
            m16: self.m16,
            m26: self.m26,
            m36: self.m36,
            m46: self.m46,
            m56: self.m56,
            m66: self.m66,
        }
    }

    /// The transformation `self` followed by the translation `shift`: `m[j, i] + shift[j] * m[5,
    /// i]` for `j < 5`, one fused `R::mul_add` each (the bits of upstream's product then sum: the
    /// addend is exact), the last row untouched. Upstream: `append_translation`.
    fn append_translation(self: Matrix6<T>, shift: Vector5<T>) -> Matrix6<T> {
        Matrix6 {
            m11: R::mul_add(shift.x, self.m61, self.m11),
            m21: R::mul_add(shift.y, self.m61, self.m21),
            m31: R::mul_add(shift.z, self.m61, self.m31),
            m41: R::mul_add(shift.w, self.m61, self.m41),
            m51: R::mul_add(shift.a, self.m61, self.m51),
            m61: self.m61,
            m12: R::mul_add(shift.x, self.m62, self.m12),
            m22: R::mul_add(shift.y, self.m62, self.m22),
            m32: R::mul_add(shift.z, self.m62, self.m32),
            m42: R::mul_add(shift.w, self.m62, self.m42),
            m52: R::mul_add(shift.a, self.m62, self.m52),
            m62: self.m62,
            m13: R::mul_add(shift.x, self.m63, self.m13),
            m23: R::mul_add(shift.y, self.m63, self.m23),
            m33: R::mul_add(shift.z, self.m63, self.m33),
            m43: R::mul_add(shift.w, self.m63, self.m43),
            m53: R::mul_add(shift.a, self.m63, self.m53),
            m63: self.m63,
            m14: R::mul_add(shift.x, self.m64, self.m14),
            m24: R::mul_add(shift.y, self.m64, self.m24),
            m34: R::mul_add(shift.z, self.m64, self.m34),
            m44: R::mul_add(shift.w, self.m64, self.m44),
            m54: R::mul_add(shift.a, self.m64, self.m54),
            m64: self.m64,
            m15: R::mul_add(shift.x, self.m65, self.m15),
            m25: R::mul_add(shift.y, self.m65, self.m25),
            m35: R::mul_add(shift.z, self.m65, self.m35),
            m45: R::mul_add(shift.w, self.m65, self.m45),
            m55: R::mul_add(shift.a, self.m65, self.m55),
            m65: self.m65,
            m16: R::mul_add(shift.x, self.m66, self.m16),
            m26: R::mul_add(shift.y, self.m66, self.m26),
            m36: R::mul_add(shift.z, self.m66, self.m36),
            m46: R::mul_add(shift.w, self.m66, self.m46),
            m56: R::mul_add(shift.a, self.m66, self.m56),
            m66: self.m66,
        }
    }

    /// The translation `shift` followed by the transformation `self`: `m[j, 5] + m[j, :5] . shift`
    /// for every row `j`, each ONE fused sum of products (the bits of upstream's dot product then
    /// sum: the addend is exact), the other columns untouched. Upstream: `prepend_translation`.
    fn prepend_translation(self: Matrix6<T>, shift: Vector5<T>) -> Matrix6<T> {
        Matrix6 {
            m11: self.m11,
            m21: self.m21,
            m31: self.m31,
            m41: self.m41,
            m51: self.m51,
            m61: self.m61,
            m12: self.m12,
            m22: self.m22,
            m32: self.m32,
            m42: self.m42,
            m52: self.m52,
            m62: self.m62,
            m13: self.m13,
            m23: self.m23,
            m33: self.m33,
            m43: self.m43,
            m53: self.m53,
            m63: self.m63,
            m14: self.m14,
            m24: self.m24,
            m34: self.m34,
            m44: self.m44,
            m54: self.m54,
            m64: self.m64,
            m15: self.m15,
            m25: self.m25,
            m35: self.m35,
            m45: self.m45,
            m55: self.m55,
            m65: self.m65,
            m16: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), self.m11, shift.x),
                                    self.m12,
                                    shift.y,
                                ),
                                self.m13,
                                shift.z,
                            ),
                            self.m14,
                            shift.w,
                        ),
                        self.m15,
                        shift.a,
                    ),
                    self.m16,
                ),
            ),
            m26: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), self.m21, shift.x),
                                    self.m22,
                                    shift.y,
                                ),
                                self.m23,
                                shift.z,
                            ),
                            self.m24,
                            shift.w,
                        ),
                        self.m25,
                        shift.a,
                    ),
                    self.m26,
                ),
            ),
            m36: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), self.m31, shift.x),
                                    self.m32,
                                    shift.y,
                                ),
                                self.m33,
                                shift.z,
                            ),
                            self.m34,
                            shift.w,
                        ),
                        self.m35,
                        shift.a,
                    ),
                    self.m36,
                ),
            ),
            m46: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), self.m41, shift.x),
                                    self.m42,
                                    shift.y,
                                ),
                                self.m43,
                                shift.z,
                            ),
                            self.m44,
                            shift.w,
                        ),
                        self.m45,
                        shift.a,
                    ),
                    self.m46,
                ),
            ),
            m56: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), self.m51, shift.x),
                                    self.m52,
                                    shift.y,
                                ),
                                self.m53,
                                shift.z,
                            ),
                            self.m54,
                            shift.w,
                        ),
                        self.m55,
                        shift.a,
                    ),
                    self.m56,
                ),
            ),
            m66: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), self.m61, shift.x),
                                    self.m62,
                                    shift.y,
                                ),
                                self.m63,
                                shift.z,
                            ),
                            self.m64,
                            shift.w,
                        ),
                        self.m65,
                        shift.a,
                    ),
                    self.m66,
                ),
            ),
        }
    }

    /// `self = self.append_scaling(scaling)` (same rounding). Upstream: `append_scaling_mut`.
    #[inline(always)]
    fn append_scaling_mut(ref self: Matrix6<T>, scaling: T) {
        self = Self::append_scaling(self, scaling);
    }

    /// `self = self.prepend_scaling(scaling)` (same rounding). Upstream: `prepend_scaling_mut`.
    #[inline(always)]
    fn prepend_scaling_mut(ref self: Matrix6<T>, scaling: T) {
        self = Self::prepend_scaling(self, scaling);
    }

    /// `self = self.append_nonuniform_scaling(scaling)` (same rounding). Upstream:
    /// `append_nonuniform_scaling_mut`.
    #[inline(always)]
    fn append_nonuniform_scaling_mut(ref self: Matrix6<T>, scaling: Vector5<T>) {
        self = Self::append_nonuniform_scaling(self, scaling);
    }

    /// `self = self.prepend_nonuniform_scaling(scaling)` (same rounding). Upstream:
    /// `prepend_nonuniform_scaling_mut`.
    #[inline(always)]
    fn prepend_nonuniform_scaling_mut(ref self: Matrix6<T>, scaling: Vector5<T>) {
        self = Self::prepend_nonuniform_scaling(self, scaling);
    }

    /// `self = self.append_translation(shift)` (same rounding). Upstream: `append_translation_mut`.
    #[inline(always)]
    fn append_translation_mut(ref self: Matrix6<T>, shift: Vector5<T>) {
        self = Self::append_translation(self, shift);
    }

    /// `self = self.prepend_translation(shift)` (same rounding). Upstream:
    /// `prepend_translation_mut`.
    #[inline(always)]
    fn prepend_translation_mut(ref self: Matrix6<T>, shift: Vector5<T>) {
        self = Self::prepend_translation(self, shift);
    }

    /// `v` transformed by the homogeneous matrix `self`: with the normaliser `n = m[5, :5] . v`
    /// (one fused dot product), `m[:5, :5] * (v / n)` if `n != 0`, else `m[:5, :5] * v` (upstream's
    /// branch); each quotient correctly rounded, each output one fused dot product. Upstream's
    /// order (divide, then multiply) is kept: the half-ulp rounding of each quotient is multiplied
    /// by the matrix entries, an absolute error of up to `sum_k |m[i, k]| / 2` ulp. Panics on
    /// overflow. Upstream: `transform_vector`.
    fn transform_vector(self: Matrix6<T>, v: Vector5<T>) -> Vector5<T> {
        let n = Fused::sum_prod5(
            self.m61, v.x, self.m62, v.y, self.m63, v.z, self.m64, v.w, self.m65, v.a,
        );
        let w = if n != R::zero() {
            let (x, y, z, w, a) = R::div5(v.x, v.y, v.z, v.w, v.a, n);
            Vector5 { x, y, z, w, a }
        } else {
            v
        };
        Vector5 {
            x: Fused::sum_prod5(
                self.m11, w.x, self.m12, w.y, self.m13, w.z, self.m14, w.w, self.m15, w.a,
            ),
            y: Fused::sum_prod5(
                self.m21, w.x, self.m22, w.y, self.m23, w.z, self.m24, w.w, self.m25, w.a,
            ),
            z: Fused::sum_prod5(
                self.m31, w.x, self.m32, w.y, self.m33, w.z, self.m34, w.w, self.m35, w.a,
            ),
            w: Fused::sum_prod5(
                self.m41, w.x, self.m42, w.y, self.m43, w.z, self.m44, w.w, self.m45, w.a,
            ),
            a: Fused::sum_prod5(
                self.m51, w.x, self.m52, w.y, self.m53, w.z, self.m54, w.w, self.m55, w.a,
            ),
        }
    }
}
