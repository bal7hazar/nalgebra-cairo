            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m12: R::zero(),
            m22: scaling,
            m32: R::zero(),
            m42: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: scaling,
            m43: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: R::one(),
        }
    }

    /// The homogeneous matrix of the non-uniform scaling by the components of `scaling` (diagonal
    /// `scaling`, then 1; exact). Upstream: `new_nonuniform_scaling`.
    #[inline(always)]
    fn new_nonuniform_scaling(scaling: Vector3<T>) -> Matrix4<T> {
        Matrix4 {
            m11: scaling.x,
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m12: R::zero(),
            m22: scaling.y,
            m32: R::zero(),
            m42: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: scaling.z,
            m43: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: R::one(),
        }
    }

    /// The homogeneous matrix of the translation by `translation`: the identity whose last column
    /// starts with `translation` (exact). Upstream: `new_translation`.
    #[inline(always)]
    fn new_translation(translation: Vector3<T>) -> Matrix4<T> {
        Matrix4 {
            m11: R::one(),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m12: R::zero(),
            m22: R::one(),
            m32: R::zero(),
            m42: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: R::one(),
            m43: R::zero(),
            m14: translation.x,
            m24: translation.y,
            m34: translation.z,
            m44: R::one(),
        }
    }

    /// The transformation `self` followed by the uniform scaling `scaling`: the first 3 rows of
    /// `self` times `scaling`, each product floored once. Upstream: `append_scaling`.
    #[inline(always)]
    fn append_scaling(self: Matrix4<T>, scaling: T) -> Matrix4<T> {
        Matrix4 {
            m11: self.m11 * scaling,
            m21: self.m21 * scaling,
            m31: self.m31 * scaling,
            m41: self.m41,
            m12: self.m12 * scaling,
            m22: self.m22 * scaling,
            m32: self.m32 * scaling,
            m42: self.m42,
            m13: self.m13 * scaling,
            m23: self.m23 * scaling,
            m33: self.m33 * scaling,
            m43: self.m43,
            m14: self.m14 * scaling,
            m24: self.m24 * scaling,
            m34: self.m34 * scaling,
            m44: self.m44,
        }
    }

    /// The uniform scaling `scaling` followed by the transformation `self`: the first 3 columns of
    /// `self` times `scaling`, each product floored once. Upstream: `prepend_scaling`.
    #[inline(always)]
    fn prepend_scaling(self: Matrix4<T>, scaling: T) -> Matrix4<T> {
        Matrix4 {
            m11: self.m11 * scaling,
            m21: self.m21 * scaling,
            m31: self.m31 * scaling,
            m41: self.m41 * scaling,
            m12: self.m12 * scaling,
            m22: self.m22 * scaling,
            m32: self.m32 * scaling,
            m42: self.m42 * scaling,
            m13: self.m13 * scaling,
            m23: self.m23 * scaling,
            m33: self.m33 * scaling,
            m43: self.m43 * scaling,
            m14: self.m14,
            m24: self.m24,
            m34: self.m34,
            m44: self.m44,
        }
    }

    /// The transformation `self` followed by the non-uniform scaling `scaling`: row `i < 3` of
    /// `self` times `scaling[i]`, each product floored once. Upstream: `append_nonuniform_scaling`.
    #[inline(always)]
    fn append_nonuniform_scaling(self: Matrix4<T>, scaling: Vector3<T>) -> Matrix4<T> {
        Matrix4 {
            m11: self.m11 * scaling.x,
            m21: self.m21 * scaling.y,
            m31: self.m31 * scaling.z,
            m41: self.m41,
            m12: self.m12 * scaling.x,
            m22: self.m22 * scaling.y,
            m32: self.m32 * scaling.z,
            m42: self.m42,
            m13: self.m13 * scaling.x,
            m23: self.m23 * scaling.y,
            m33: self.m33 * scaling.z,
            m43: self.m43,
            m14: self.m14 * scaling.x,
            m24: self.m24 * scaling.y,
            m34: self.m34 * scaling.z,
            m44: self.m44,
        }
    }

    /// The non-uniform scaling `scaling` followed by the transformation `self`: column `j < 3` of
    /// `self` times `scaling[j]`, each product floored once. Upstream:
    /// `prepend_nonuniform_scaling`.
    #[inline(always)]
    fn prepend_nonuniform_scaling(self: Matrix4<T>, scaling: Vector3<T>) -> Matrix4<T> {
        Matrix4 {
            m11: self.m11 * scaling.x,
            m21: self.m21 * scaling.x,
            m31: self.m31 * scaling.x,
            m41: self.m41 * scaling.x,
            m12: self.m12 * scaling.y,
            m22: self.m22 * scaling.y,
            m32: self.m32 * scaling.y,
            m42: self.m42 * scaling.y,
            m13: self.m13 * scaling.z,
            m23: self.m23 * scaling.z,
            m33: self.m33 * scaling.z,
            m43: self.m43 * scaling.z,
            m14: self.m14,
            m24: self.m24,
            m34: self.m34,
            m44: self.m44,
        }
    }

    /// The transformation `self` followed by the translation `shift`: `m[j, i] + shift[j] * m[3,
    /// i]` for `j < 3`, one fused `R::mul_add` each (the bits of upstream's product then sum: the
    /// addend is exact), the last row untouched. Upstream: `append_translation`.
    #[inline(always)]
    fn append_translation(self: Matrix4<T>, shift: Vector3<T>) -> Matrix4<T> {
        Matrix4 {
            m11: R::mul_add(shift.x, self.m41, self.m11),
            m21: R::mul_add(shift.y, self.m41, self.m21),
            m31: R::mul_add(shift.z, self.m41, self.m31),
            m41: self.m41,
            m12: R::mul_add(shift.x, self.m42, self.m12),
            m22: R::mul_add(shift.y, self.m42, self.m22),
            m32: R::mul_add(shift.z, self.m42, self.m32),
            m42: self.m42,
            m13: R::mul_add(shift.x, self.m43, self.m13),
            m23: R::mul_add(shift.y, self.m43, self.m23),
            m33: R::mul_add(shift.z, self.m43, self.m33),
            m43: self.m43,
            m14: R::mul_add(shift.x, self.m44, self.m14),
            m24: R::mul_add(shift.y, self.m44, self.m24),
            m34: R::mul_add(shift.z, self.m44, self.m34),
            m44: self.m44,
        }
    }

    /// The translation `shift` followed by the transformation `self`: `m[j, 3] + m[j, :3] . shift`
    /// for every row `j`, each ONE fused sum of products (the bits of upstream's dot product then
    /// sum: the addend is exact), the other columns untouched. Upstream: `prepend_translation`.
    #[inline(always)]
    fn prepend_translation(self: Matrix4<T>, shift: Vector3<T>) -> Matrix4<T> {
        Matrix4 {
            m11: self.m11,
            m21: self.m21,
            m31: self.m31,
            m41: self.m41,
            m12: self.m12,
            m22: self.m22,
            m32: self.m32,
            m42: self.m42,
            m13: self.m13,
            m23: self.m23,
            m33: self.m33,
            m43: self.m43,
            m14: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.m11, shift.x), self.m12, shift.y,
                        ),
                        self.m13,
                        shift.z,
                    ),
                    self.m14,
                ),
            ),
            m24: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.m21, shift.x), self.m22, shift.y,
                        ),
                        self.m23,
                        shift.z,
                    ),
                    self.m24,
                ),
            ),
            m34: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.m31, shift.x), self.m32, shift.y,
                        ),
                        self.m33,
                        shift.z,
                    ),
                    self.m34,
                ),
            ),
            m44: R::wide_rescale(
                R::wide_add(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.m41, shift.x), self.m42, shift.y,
                        ),
                        self.m43,
                        shift.z,
                    ),
                    self.m44,
                ),
            ),
        }
    }

    /// `self = self.append_scaling(scaling)` (same rounding). Upstream: `append_scaling_mut`.
    #[inline(always)]
    fn append_scaling_mut(ref self: Matrix4<T>, scaling: T) {
        self = Self::append_scaling(self, scaling);
    }

    /// `self = self.prepend_scaling(scaling)` (same rounding). Upstream: `prepend_scaling_mut`.
    #[inline(always)]
    fn prepend_scaling_mut(ref self: Matrix4<T>, scaling: T) {
        self = Self::prepend_scaling(self, scaling);
    }

    /// `self = self.append_nonuniform_scaling(scaling)` (same rounding). Upstream:
    /// `append_nonuniform_scaling_mut`.
    #[inline(always)]
    fn append_nonuniform_scaling_mut(ref self: Matrix4<T>, scaling: Vector3<T>) {
        self = Self::append_nonuniform_scaling(self, scaling);
    }

    /// `self = self.prepend_nonuniform_scaling(scaling)` (same rounding). Upstream:
    /// `prepend_nonuniform_scaling_mut`.
    #[inline(always)]
    fn prepend_nonuniform_scaling_mut(ref self: Matrix4<T>, scaling: Vector3<T>) {
        self = Self::prepend_nonuniform_scaling(self, scaling);
    }

    /// `self = self.append_translation(shift)` (same rounding). Upstream: `append_translation_mut`.
    #[inline(always)]
    fn append_translation_mut(ref self: Matrix4<T>, shift: Vector3<T>) {
        self = Self::append_translation(self, shift);
    }

    /// `self = self.prepend_translation(shift)` (same rounding). Upstream:
    /// `prepend_translation_mut`.
    #[inline(always)]
    fn prepend_translation_mut(ref self: Matrix4<T>, shift: Vector3<T>) {
        self = Self::prepend_translation(self, shift);
    }

    /// `v` transformed by the homogeneous matrix `self`: with the normaliser `n = m[3, :3] . v`
    /// (one fused dot product), `m[:3, :3] * (v / n)` if `n != 0`, else `m[:3, :3] * v` (upstream's
    /// branch); each quotient correctly rounded, each output one fused dot product. Upstream's
    /// order (divide, then multiply) is kept: the half-ulp rounding of each quotient is multiplied
    /// by the matrix entries, an absolute error of up to `sum_k |m[i, k]| / 2` ulp. Panics on
    /// overflow. Upstream: `transform_vector`.
    #[inline(always)]
    fn transform_vector(self: Matrix4<T>, v: Vector3<T>) -> Vector3<T> {
        let n = R::sum_prod3(self.m41, v.x, self.m42, v.y, self.m43, v.z);
        let w = if n != R::zero() {
            let (x, y, z) = R::div3(v.x, v.y, v.z, n);
            Vector3 { x, y, z }
        } else {
            v
        };
        Vector3 {
            x: R::sum_prod3(self.m11, w.x, self.m12, w.y, self.m13, w.z),
            y: R::sum_prod3(self.m21, w.x, self.m22, w.y, self.m23, w.z),
            z: R::sum_prod3(self.m31, w.x, self.m32, w.y, self.m33, w.z),
        }
    }

    /// `pt` transformed by the homogeneous matrix `self`: `q = m[:3, :3] * pt + m[:3, 3]` and `n =
    /// m[3, :3] . pt + m[3, 3]` (one fused sum of products each, the bits of upstream's product
    /// then sum), then `q / n` correctly rounded if `n != 0`, else `q` (upstream's branch). Panics
    /// on overflow. Upstream: `transform_point`.
    fn transform_point(self: Matrix4<T>, pt: Point3<T>) -> Point3<T> {
        let n = R::wide_rescale(
            R::wide_add(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_zero(), self.m41, pt.x), self.m42, pt.y,
                    ),
                    self.m43,
                    pt.z,
                ),
                self.m44,
            ),
        );
        let qx = R::wide_rescale(
            R::wide_add(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_zero(), self.m11, pt.x), self.m12, pt.y,
                    ),
                    self.m13,
                    pt.z,
                ),
                self.m14,
            ),
        );
        let qy = R::wide_rescale(
            R::wide_add(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_zero(), self.m21, pt.x), self.m22, pt.y,
                    ),
                    self.m23,
                    pt.z,
                ),
                self.m24,
            ),
        );
        let qz = R::wide_rescale(
            R::wide_add(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_zero(), self.m31, pt.x), self.m32, pt.y,
                    ),
                    self.m33,
                    pt.z,
                ),
                self.m34,
            ),
        );
        if n != R::zero() {
            let (x, y, z) = R::div3(qx, qy, qz, n);
            Point3 { x, y, z }
        } else {
            Point3 { x: qx, y: qy, z: qz }
        }
    }

    /// The homogeneous matrix of the non-uniform scaling by `scaling` about the point `pt`:
    /// diagonal `scaling`, then 1, last column `pt - pt * scaling`, each ONE fused `R::mul_add(-pt,
    /// scaling, pt)` (the floor of the exact value, where upstream rounds the product then the
    /// difference). Upstream: `new_nonuniform_scaling_wrt_point`.
    #[inline(always)]
    fn new_nonuniform_scaling_wrt_point(scaling: Vector3<T>, pt: Point3<T>) -> Matrix4<T> {
        Matrix4 {
            m11: scaling.x,
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m12: R::zero(),
            m22: scaling.y,
            m32: R::zero(),
            m42: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: scaling.z,
            m43: R::zero(),
            m14: R::mul_add(-pt.x, scaling.x, pt.x),
            m24: R::mul_add(-pt.y, scaling.y, pt.y),
            m34: R::mul_add(-pt.z, scaling.z, pt.z),
            m44: R::one(),
        }
    }

    /// The local frame of an observer at `eye` looking towards `target` (the view direction mapped
    /// to `+z`, the origin to `eye`): `IsometryMatrix3::face_towards(eye, target,
    /// up).to_homogeneous()`, upstream's delegation (same rounding as
    /// `IsometryMatrix3::face_towards`). `up` must not be parallel to `target - eye`. Upstream:
    /// `Matrix4::face_towards`.
    fn face_towards(eye: Point3<T>, target: Point3<T>, up: Vector3<T>) -> Matrix4<T> {
        IsometryMatrix3Trait::face_towards(eye, target, up).to_homogeneous()
    }

    /// The right-handed look-at view matrix: `IsometryMatrix3::look_at_rh(eye, target,
    /// up).to_homogeneous()`, upstream's delegation (same rounding as
    /// `IsometryMatrix3::look_at_rh`). `up` must not be parallel to `target - eye`. Upstream:
    /// `Matrix4::look_at_rh`.
    fn look_at_rh(eye: Point3<T>, target: Point3<T>, up: Vector3<T>) -> Matrix4<T> {
        IsometryMatrix3Trait::look_at_rh(eye, target, up).to_homogeneous()
    }

    /// The left-handed look-at view matrix: `IsometryMatrix3::look_at_lh(eye, target,
    /// up).to_homogeneous()`, upstream's delegation (same rounding as
    /// `IsometryMatrix3::look_at_lh`). `up` must not be parallel to `target - eye`. Upstream:
    /// `Matrix4::look_at_lh`.
    fn look_at_lh(eye: Point3<T>, target: Point3<T>, up: Vector3<T>) -> Matrix4<T> {
        IsometryMatrix3Trait::look_at_lh(eye, target, up).to_homogeneous()
    }

    /// Deprecated upstream (renamed `face_towards`): `face_towards(eye, target, up)`. Upstream:
    /// `Matrix4::new_observer_frame`.
    #[inline(always)]
    fn new_observer_frame(eye: Point3<T>, target: Point3<T>, up: Vector3<T>) -> Matrix4<T> {
        Self::face_towards(eye, target, up)
    }
}

/// The rotation constructors of `Matrix4<T>` (upstream `base/cg.rs`), which need `Transcendental`:
/// a scalar may implement `Real` only.
#[generate_trait]
pub impl Matrix4CgAngleImpl<
    T,
    impl R: Real<T>,
    impl Tr: Transcendental<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix4CgAngleTrait<T> {
    /// The homogeneous matrix of the 3D rotation by the rotation vector `axisangle` (axis times
    /// angle; the identity for a zero vector): `Rotation3::new(axisangle).to_homogeneous()`.
    /// Upstream: `Matrix4::new_rotation`.
    #[inline(always)]
    fn new_rotation(axisangle: Vector3<T>) -> Matrix4<T> {
        Rotation3AngleTrait::new(axisangle).to_homogeneous()
    }

    /// The homogeneous matrix of the rotation by the rotation vector `axisangle` about the point
    /// `pt` (`pt` is invariant):
    /// `IsometryMatrix3::rotation_wrt_point(Rotation3::from_scaled_axis(axisangle),
    /// pt).to_homogeneous()`. Upstream: `Matrix4::new_rotation_wrt_point`.
    fn new_rotation_wrt_point(axisangle: Vector3<T>, pt: Point3<T>) -> Matrix4<T> {
        IsometryMatrix3Trait::rotation_wrt_point(
            Rotation3AngleTrait::from_scaled_axis(axisangle), pt,
        )
            .to_homogeneous()
    }

    /// The same as `new_rotation`: `Rotation3::from_scaled_axis(axisangle).to_homogeneous()`.
    /// Upstream: `Matrix4::from_scaled_axis`.
    #[inline(always)]
    fn from_scaled_axis(axisangle: Vector3<T>) -> Matrix4<T> {
        Rotation3AngleTrait::from_scaled_axis(axisangle).to_homogeneous()
    }

    /// The homogeneous matrix of the rotation of Euler angles `roll`, `pitch`, `yaw` (applied in
    /// this order): `Rotation3::from_euler_angles(roll, pitch, yaw).to_homogeneous()`. Upstream:
    /// `Matrix4::from_euler_angles`.
    #[inline(always)]
    fn from_euler_angles(roll: T, pitch: T, yaw: T) -> Matrix4<T> {
        Rotation3AngleTrait::from_euler_angles(roll, pitch, yaw).to_homogeneous()
    }

    /// The homogeneous matrix of the rotation of `angle` radians about the unit `axis`:
    /// `Rotation3::from_axis_angle(axis, angle).to_homogeneous()`. Upstream:
    /// `Matrix4::from_axis_angle`.
    #[inline(always)]
    fn from_axis_angle(axis: Unit<Vector3<T>>, angle: T) -> Matrix4<T> {
        Rotation3AngleTrait::from_axis_angle(axis, angle).to_homogeneous()
    }
}

/// The homogeneous-coordinates helpers of `Matrix5<T>` (upstream `base/cg.rs`) that need no
/// trigonometry, for any `Real` scalar. By value, unrolled, no loop.
#[generate_trait]
pub impl Matrix5CgImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5CgTrait<T> {
    /// The homogeneous matrix of the uniform scaling by `scaling`: `scaling` on the first 4
    /// diagonal entries, 1 on the last, 0 elsewhere (exact). Upstream: `new_scaling`.
    #[inline(always)]
    fn new_scaling(scaling: T) -> Matrix5<T> {
        Matrix5 {
            m11: scaling,
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: R::zero(),
            m22: scaling,
            m32: R::zero(),
            m42: R::zero(),
            m52: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: scaling,
            m43: R::zero(),
            m53: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: scaling,
            m54: R::zero(),
            m15: R::zero(),
            m25: R::zero(),
            m35: R::zero(),
            m45: R::zero(),
            m55: R::one(),
        }
    }

    /// The homogeneous matrix of the non-uniform scaling by the components of `scaling` (diagonal
    /// `scaling`, then 1; exact). Upstream: `new_nonuniform_scaling`.
    #[inline(always)]
    fn new_nonuniform_scaling(scaling: Vector4<T>) -> Matrix5<T> {
        Matrix5 {
            m11: scaling.x,
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: R::zero(),
            m22: scaling.y,
            m32: R::zero(),
            m42: R::zero(),
            m52: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: scaling.z,
            m43: R::zero(),
            m53: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: scaling.w,
            m54: R::zero(),
            m15: R::zero(),
            m25: R::zero(),
            m35: R::zero(),
            m45: R::zero(),
            m55: R::one(),
        }
    }

    /// The homogeneous matrix of the translation by `translation`: the identity whose last column
    /// starts with `translation` (exact). Upstream: `new_translation`.
    #[inline(always)]
    fn new_translation(translation: Vector4<T>) -> Matrix5<T> {
        Matrix5 {
            m11: R::one(),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: R::zero(),
            m22: R::one(),
            m32: R::zero(),
            m42: R::zero(),
            m52: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: R::one(),
            m43: R::zero(),
            m53: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: R::one(),
            m54: R::zero(),
            m15: translation.x,
            m25: translation.y,
            m35: translation.z,
            m45: translation.w,
            m55: R::one(),
        }
    }

    /// The transformation `self` followed by the uniform scaling `scaling`: the first 4 rows of
    /// `self` times `scaling`, each product floored once. Upstream: `append_scaling`.
    #[inline(always)]
    fn append_scaling(self: Matrix5<T>, scaling: T) -> Matrix5<T> {
        Matrix5 {
            m11: self.m11 * scaling,
            m21: self.m21 * scaling,
            m31: self.m31 * scaling,
            m41: self.m41 * scaling,
            m51: self.m51,
            m12: self.m12 * scaling,
            m22: self.m22 * scaling,
            m32: self.m32 * scaling,
            m42: self.m42 * scaling,
            m52: self.m52,
