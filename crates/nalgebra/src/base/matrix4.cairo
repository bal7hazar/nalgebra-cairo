        match i {
            0 => Matrix2x4 {
                m11: self.m11,
                m21: self.m21,
                m12: self.m12,
                m22: self.m22,
                m13: self.m13,
                m23: self.m23,
                m14: self.m14,
                m24: self.m24,
            },
            1 => Matrix2x4 {
                m11: self.m21,
                m21: self.m31,
                m12: self.m22,
                m22: self.m32,
                m13: self.m23,
                m23: self.m33,
                m14: self.m24,
                m24: self.m34,
            },
            2 => Matrix2x4 {
                m11: self.m31,
                m21: self.m41,
                m12: self.m32,
                m22: self.m42,
                m13: self.m33,
                m23: self.m43,
                m14: self.m34,
                m24: self.m44,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
