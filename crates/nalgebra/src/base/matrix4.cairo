/// The component-wise partial order: `a < b` when EVERY component of `a` is smaller than `b`'s
/// (likewise `<=`, `>`, `>=`), so two matrices may be unordered (`!(a < b) && !(a >= b)`).
/// Upstream: `PartialOrd for Matrix`.
pub impl Matrix4PartialOrd<T, +PartialOrd<T>, +Copy<T>, +Drop<T>> of PartialOrd<Matrix4<T>> {
    #[inline(always)]
    fn lt(lhs: Matrix4<T>, rhs: Matrix4<T>) -> bool {
        lhs.m11 < rhs.m11
            && lhs.m21 < rhs.m21
            && lhs.m31 < rhs.m31
            && lhs.m41 < rhs.m41
            && lhs.m12 < rhs.m12
            && lhs.m22 < rhs.m22
            && lhs.m32 < rhs.m32
            && lhs.m42 < rhs.m42
            && lhs.m13 < rhs.m13
            && lhs.m23 < rhs.m23
            && lhs.m33 < rhs.m33
            && lhs.m43 < rhs.m43
            && lhs.m14 < rhs.m14
            && lhs.m24 < rhs.m24
            && lhs.m34 < rhs.m34
            && lhs.m44 < rhs.m44
    }
    #[inline(always)]
    fn le(lhs: Matrix4<T>, rhs: Matrix4<T>) -> bool {
        lhs.m11 <= rhs.m11
            && lhs.m21 <= rhs.m21
            && lhs.m31 <= rhs.m31
            && lhs.m41 <= rhs.m41
            && lhs.m12 <= rhs.m12
            && lhs.m22 <= rhs.m22
            && lhs.m32 <= rhs.m32
            && lhs.m42 <= rhs.m42
            && lhs.m13 <= rhs.m13
            && lhs.m23 <= rhs.m23
            && lhs.m33 <= rhs.m33
            && lhs.m43 <= rhs.m43
            && lhs.m14 <= rhs.m14
            && lhs.m24 <= rhs.m24
            && lhs.m34 <= rhs.m34
            && lhs.m44 <= rhs.m44
    }
    #[inline(always)]
    fn gt(lhs: Matrix4<T>, rhs: Matrix4<T>) -> bool {
        lhs.m11 > rhs.m11
            && lhs.m21 > rhs.m21
            && lhs.m31 > rhs.m31
            && lhs.m41 > rhs.m41
            && lhs.m12 > rhs.m12
            && lhs.m22 > rhs.m22
            && lhs.m32 > rhs.m32
            && lhs.m42 > rhs.m42
            && lhs.m13 > rhs.m13
            && lhs.m23 > rhs.m23
            && lhs.m33 > rhs.m33
            && lhs.m43 > rhs.m43
            && lhs.m14 > rhs.m14
            && lhs.m24 > rhs.m24
            && lhs.m34 > rhs.m34
            && lhs.m44 > rhs.m44
    }
    #[inline(always)]
    fn ge(lhs: Matrix4<T>, rhs: Matrix4<T>) -> bool {
        lhs.m11 >= rhs.m11
            && lhs.m21 >= rhs.m21
            && lhs.m31 >= rhs.m31
            && lhs.m41 >= rhs.m41
            && lhs.m12 >= rhs.m12
            && lhs.m22 >= rhs.m22
            && lhs.m32 >= rhs.m32
            && lhs.m42 >= rhs.m42
            && lhs.m13 >= rhs.m13
            && lhs.m23 >= rhs.m23
            && lhs.m33 >= rhs.m33
            && lhs.m43 >= rhs.m43
            && lhs.m14 >= rhs.m14
            && lhs.m24 >= rhs.m24
            && lhs.m34 >= rhs.m34
            && lhs.m44 >= rhs.m44
    }
}

