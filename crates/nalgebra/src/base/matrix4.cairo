    /// `true` when every component is within `epsilon` ulp of `other`'s, or has the same sign and
    /// lies within `max_relative` times the larger magnitude of the two (`|a - b| <= max(|a|, |b|)
    /// · max_relative`). Panics on a component equal to the scalar's `MIN`, and on overflow of
    /// that product (only possible with `max_relative > 1`). Upstream:
    /// `approx::RelativeEq::relative_eq`, `epsilon` counted in ulp instead of a float epsilon
    /// (DESIGN D3).
    #[inline(always)]
    fn relative_eq(self: Matrix4<T>, other: Matrix4<T>, epsilon: u64, max_relative: T) -> bool {
        ApproxEqTrait::relative_eq(self.m11, other.m11, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m21, other.m21, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m31, other.m31, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m41, other.m41, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m12, other.m12, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m22, other.m22, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m32, other.m32, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m42, other.m42, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m13, other.m13, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m23, other.m23, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m33, other.m33, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m43, other.m43, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m14, other.m14, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m24, other.m24, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m34, other.m34, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m44, other.m44, epsilon, max_relative)
    }

    /// `true` when every component is within `epsilon` ulp of `other`'s, or has the same sign and
    /// lies within `max_ulps` ulp (in fixed point the distance in ulp IS the raw difference; the
    /// `max_ulps` budget does not cross zero, like upstream's float `ulps_eq`). Cannot overflow.
    /// Upstream: `approx::UlpsEq::ulps_eq`.
    #[inline(always)]
    fn ulps_eq(self: Matrix4<T>, other: Matrix4<T>, epsilon: u64, max_ulps: u32) -> bool {
        ApproxEqTrait::ulps_eq(self.m11, other.m11, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m21, other.m21, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m31, other.m31, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m41, other.m41, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m12, other.m12, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m22, other.m22, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m32, other.m32, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m42, other.m42, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m13, other.m13, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m23, other.m23, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m33, other.m33, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m43, other.m43, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m14, other.m14, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m24, other.m24, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m34, other.m34, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m44, other.m44, epsilon, max_ulps)
    }

    // --- functional and in-place variants (WP 8.2b) --------------------------------------------

    /// The 4x4 matrix of `f(x)` for every component `x` (called in column-major order). `f` is any
    /// closure or `Fn` value; Cairo closures take their arguments by value and cannot mutate their
    /// captures. Upstream: `map`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn map<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Drop<Func::Output>>(
        self: Matrix4<T>, f: F,
    ) -> Matrix4<Func::Output> {
        Matrix4 {
            m11: f(self.m11),
            m21: f(self.m21),
            m31: f(self.m31),
            m41: f(self.m41),
            m12: f(self.m12),
            m22: f(self.m22),
            m32: f(self.m32),
            m42: f(self.m42),
            m13: f(self.m13),
            m23: f(self.m23),
            m33: f(self.m33),
            m43: f(self.m43),
            m14: f(self.m14),
            m24: f(self.m24),
            m34: f(self.m34),
            m44: f(self.m44),
        }
    }

    /// The 4x4 matrix of `f(i, j, x)` for every component `x` at row `i`, column `j` (0-based,
    /// column-major order). `f` is any closure or `Fn` value; Cairo closures take their arguments
    /// by value and cannot mutate their captures. Upstream: `map_with_location`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn map_with_location<
        F, +Drop<F>, impl Func: core::ops::Fn<F, (usize, usize, T)>, +Drop<Func::Output>,
    >(
        self: Matrix4<T>, f: F,
    ) -> Matrix4<Func::Output> {
        Matrix4 {
            m11: f(0, 0, self.m11),
            m21: f(1, 0, self.m21),
            m31: f(2, 0, self.m31),
            m41: f(3, 0, self.m41),
            m12: f(0, 1, self.m12),
            m22: f(1, 1, self.m22),
            m32: f(2, 1, self.m32),
            m42: f(3, 1, self.m42),
            m13: f(0, 2, self.m13),
            m23: f(1, 2, self.m23),
            m33: f(2, 2, self.m33),
            m43: f(3, 2, self.m43),
            m14: f(0, 3, self.m14),
            m24: f(1, 3, self.m24),
            m34: f(2, 3, self.m34),
            m44: f(3, 3, self.m44),
        }
    }

    /// The 4x4 matrix of `f(a, b)` for the components `a` of `self` and `b` of `rhs` at the same
    /// position. `f` is any closure or `Fn` value; Cairo closures take their arguments by value and
    /// cannot mutate their captures. Upstream: `zip_map`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn zip_map<
        T2,
        +Copy<T2>,
        +Drop<T2>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2)>,
        +Drop<Func::Output>,
    >(
        self: Matrix4<T>, rhs: Matrix4<T2>, f: F,
    ) -> Matrix4<Func::Output> {
        Matrix4 {
            m11: f(self.m11, rhs.m11),
            m21: f(self.m21, rhs.m21),
            m31: f(self.m31, rhs.m31),
            m41: f(self.m41, rhs.m41),
            m12: f(self.m12, rhs.m12),
            m22: f(self.m22, rhs.m22),
            m32: f(self.m32, rhs.m32),
            m42: f(self.m42, rhs.m42),
            m13: f(self.m13, rhs.m13),
            m23: f(self.m23, rhs.m23),
            m33: f(self.m33, rhs.m33),
            m43: f(self.m43, rhs.m43),
            m14: f(self.m14, rhs.m14),
            m24: f(self.m24, rhs.m24),
            m34: f(self.m34, rhs.m34),
            m44: f(self.m44, rhs.m44),
        }
    }

    /// The 4x4 matrix of `f(a, b, c)` for the components of `self`, `b` and `c` at the same
    /// position. `f` is any closure or `Fn` value; Cairo closures take their arguments by value and
    /// cannot mutate their captures. Upstream: `zip_zip_map`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn zip_zip_map<
        T2,
        T3,
        +Copy<T2>,
        +Drop<T2>,
        +Copy<T3>,
        +Drop<T3>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2, T3)>,
        +Drop<Func::Output>,
    >(
        self: Matrix4<T>, b: Matrix4<T2>, c: Matrix4<T3>, f: F,
    ) -> Matrix4<Func::Output> {
        Matrix4 {
            m11: f(self.m11, b.m11, c.m11),
            m21: f(self.m21, b.m21, c.m21),
            m31: f(self.m31, b.m31, c.m31),
            m41: f(self.m41, b.m41, c.m41),
            m12: f(self.m12, b.m12, c.m12),
            m22: f(self.m22, b.m22, c.m22),
            m32: f(self.m32, b.m32, c.m32),
            m42: f(self.m42, b.m42, c.m42),
            m13: f(self.m13, b.m13, c.m13),
            m23: f(self.m23, b.m23, c.m23),
            m33: f(self.m33, b.m33, c.m33),
            m43: f(self.m43, b.m43, c.m43),
            m14: f(self.m14, b.m14, c.m14),
            m24: f(self.m24, b.m24, c.m24),
            m34: f(self.m34, b.m34, c.m34),
            m44: f(self.m44, b.m44, c.m44),
        }
    }

    /// `f(.. f(f(init, x0), x1) .., x15)` over the components in column-major order. The closure's
    /// output converts `Into<Acc>` (the identity included): Cairo cannot state `Output = Acc`
    /// without the `associated_item_constraints` experimental feature. `f` is any closure or `Fn`
    /// value; Cairo closures take their arguments by value and cannot mutate their captures.
    /// Upstream: `fold`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn fold<Acc, F, +Drop<F>, impl Func: core::ops::Fn<F, (Acc, T)>, +Into<Func::Output, Acc>>(
        self: Matrix4<T>, init: Acc, f: F,
    ) -> Acc {
        let acc: Acc = f(init, self.m11).into();
        let acc: Acc = f(acc, self.m21).into();
        let acc: Acc = f(acc, self.m31).into();
        let acc: Acc = f(acc, self.m41).into();
        let acc: Acc = f(acc, self.m12).into();
        let acc: Acc = f(acc, self.m22).into();
        let acc: Acc = f(acc, self.m32).into();
        let acc: Acc = f(acc, self.m42).into();
        let acc: Acc = f(acc, self.m13).into();
        let acc: Acc = f(acc, self.m23).into();
        let acc: Acc = f(acc, self.m33).into();
        let acc: Acc = f(acc, self.m43).into();
        let acc: Acc = f(acc, self.m14).into();
        let acc: Acc = f(acc, self.m24).into();
        let acc: Acc = f(acc, self.m34).into();
        f(acc, self.m44).into()
    }

    /// `init_f(Some(x0))`, then `f(acc, x)` over the other components in column-major order:
    /// upstream's `fold_with` (`init_f` receives the first component, `None` only for an empty
    /// matrix, which a static shape never is). The accumulator has the type of `init_f`'s output;
    /// `f`'s output converts `Into` it. The closures receive values instead of upstream's `&T`.
    /// Upstream: `fold_with`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn fold_with<
        G,
        +Drop<G>,
        impl Init: core::ops::Fn<G, (Option<T>,)>,
        +Drop<Init::Output>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Init::Output, T)>,
        +Into<Func::Output, Init::Output>,
    >(
        self: Matrix4<T>, init_f: G, f: F,
    ) -> Init::Output {
        let acc: Init::Output = init_f(Option::Some(self.m11));
        let acc: Init::Output = f(acc, self.m21).into();
        let acc: Init::Output = f(acc, self.m31).into();
        let acc: Init::Output = f(acc, self.m41).into();
        let acc: Init::Output = f(acc, self.m12).into();
        let acc: Init::Output = f(acc, self.m22).into();
        let acc: Init::Output = f(acc, self.m32).into();
        let acc: Init::Output = f(acc, self.m42).into();
        let acc: Init::Output = f(acc, self.m13).into();
        let acc: Init::Output = f(acc, self.m23).into();
        let acc: Init::Output = f(acc, self.m33).into();
        let acc: Init::Output = f(acc, self.m43).into();
        let acc: Init::Output = f(acc, self.m14).into();
        let acc: Init::Output = f(acc, self.m24).into();
        let acc: Init::Output = f(acc, self.m34).into();
        f(acc, self.m44).into()
    }

    /// `fold` over the pairs of components of `self` and `rhs` at the same position: `f(acc, a,
    /// b)`, column-major. `f` is any closure or `Fn` value; Cairo closures take their arguments by
    /// value and cannot mutate their captures. Upstream: `zip_fold`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn zip_fold<
        T2,
        +Copy<T2>,
        +Drop<T2>,
        Acc,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Acc, T, T2)>,
        +Into<Func::Output, Acc>,
    >(
        self: Matrix4<T>, rhs: Matrix4<T2>, init: Acc, f: F,
    ) -> Acc {
        let acc: Acc = f(init, self.m11, rhs.m11).into();
        let acc: Acc = f(acc, self.m21, rhs.m21).into();
        let acc: Acc = f(acc, self.m31, rhs.m31).into();
        let acc: Acc = f(acc, self.m41, rhs.m41).into();
        let acc: Acc = f(acc, self.m12, rhs.m12).into();
        let acc: Acc = f(acc, self.m22, rhs.m22).into();
        let acc: Acc = f(acc, self.m32, rhs.m32).into();
        let acc: Acc = f(acc, self.m42, rhs.m42).into();
        let acc: Acc = f(acc, self.m13, rhs.m13).into();
        let acc: Acc = f(acc, self.m23, rhs.m23).into();
        let acc: Acc = f(acc, self.m33, rhs.m33).into();
        let acc: Acc = f(acc, self.m43, rhs.m43).into();
        let acc: Acc = f(acc, self.m14, rhs.m14).into();
        let acc: Acc = f(acc, self.m24, rhs.m24).into();
        let acc: Acc = f(acc, self.m34, rhs.m34).into();
        f(acc, self.m44, rhs.m44).into()
    }

    /// Replaces every component `x` by `f(x)` (column-major order). Upstream's closure is
    /// `FnMut(&mut T)`, writing through the reference; a Cairo closure cannot, so it RETURNS the
    /// new component (its output converts `Into<T>`). Upstream: `apply`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn apply<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Into<Func::Output, T>>(
        ref self: Matrix4<T>, f: F,
    ) {
        self =
            Matrix4 {
                m11: f(self.m11).into(),
                m21: f(self.m21).into(),
                m31: f(self.m31).into(),
                m41: f(self.m41).into(),
                m12: f(self.m12).into(),
                m22: f(self.m22).into(),
                m32: f(self.m32).into(),
                m42: f(self.m42).into(),
                m13: f(self.m13).into(),
                m23: f(self.m23).into(),
                m33: f(self.m33).into(),
                m43: f(self.m43).into(),
                m14: f(self.m14).into(),
                m24: f(self.m24).into(),
                m34: f(self.m34).into(),
                m44: f(self.m44).into(),
            };
    }

    /// `self` with every component `x` replaced by `f(x)`: `apply` by value. Upstream's closure is
    /// `FnMut(&mut T)`, writing through the reference; a Cairo closure cannot, so it RETURNS the
    /// new component (its output converts `Into<T>`). Upstream: `apply_into`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn apply_into<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Into<Func::Output, T>>(
        self: Matrix4<T>, f: F,
    ) -> Matrix4<T> {
        Matrix4 {
            m11: f(self.m11).into(),
            m21: f(self.m21).into(),
            m31: f(self.m31).into(),
            m41: f(self.m41).into(),
            m12: f(self.m12).into(),
            m22: f(self.m22).into(),
            m32: f(self.m32).into(),
            m42: f(self.m42).into(),
            m13: f(self.m13).into(),
            m23: f(self.m23).into(),
            m33: f(self.m33).into(),
            m43: f(self.m43).into(),
            m14: f(self.m14).into(),
            m24: f(self.m24).into(),
            m34: f(self.m34).into(),
            m44: f(self.m44).into(),
        }
    }

    /// Replaces every component `a` by `f(a, b)`, `b` the component of `rhs` at the same position.
    /// Upstream's closure is `FnMut(&mut T)`, writing through the reference; a Cairo closure
    /// cannot, so it RETURNS the new component (its output converts `Into<T>`). Upstream:
    /// `zip_apply`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn zip_apply<
        T2,
        +Copy<T2>,
        +Drop<T2>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2)>,
        +Into<Func::Output, T>,
    >(
        ref self: Matrix4<T>, rhs: Matrix4<T2>, f: F,
    ) {
        self =
            Matrix4 {
                m11: f(self.m11, rhs.m11).into(),
                m21: f(self.m21, rhs.m21).into(),
                m31: f(self.m31, rhs.m31).into(),
                m41: f(self.m41, rhs.m41).into(),
                m12: f(self.m12, rhs.m12).into(),
                m22: f(self.m22, rhs.m22).into(),
                m32: f(self.m32, rhs.m32).into(),
                m42: f(self.m42, rhs.m42).into(),
                m13: f(self.m13, rhs.m13).into(),
                m23: f(self.m23, rhs.m23).into(),
                m33: f(self.m33, rhs.m33).into(),
                m43: f(self.m43, rhs.m43).into(),
                m14: f(self.m14, rhs.m14).into(),
                m24: f(self.m24, rhs.m24).into(),
                m34: f(self.m34, rhs.m34).into(),
                m44: f(self.m44, rhs.m44).into(),
            };
    }

    /// Replaces every component `a` by `f(a, b, c)`, `b` and `c` the components of `b` and `c` at
    /// the same position. Upstream's closure is `FnMut(&mut T)`, writing through the reference; a
    /// Cairo closure cannot, so it RETURNS the new component (its output converts `Into<T>`).
    /// Upstream: `zip_zip_apply`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn zip_zip_apply<
        T2,
        T3,
        +Copy<T2>,
        +Drop<T2>,
        +Copy<T3>,
        +Drop<T3>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2, T3)>,
        +Into<Func::Output, T>,
    >(
        ref self: Matrix4<T>, b: Matrix4<T2>, c: Matrix4<T3>, f: F,
    ) {
        self =
            Matrix4 {
                m11: f(self.m11, b.m11, c.m11).into(),
                m21: f(self.m21, b.m21, c.m21).into(),
                m31: f(self.m31, b.m31, c.m31).into(),
                m41: f(self.m41, b.m41, c.m41).into(),
                m12: f(self.m12, b.m12, c.m12).into(),
                m22: f(self.m22, b.m22, c.m22).into(),
                m32: f(self.m32, b.m32, c.m32).into(),
                m42: f(self.m42, b.m42, c.m42).into(),
                m13: f(self.m13, b.m13, c.m13).into(),
                m23: f(self.m23, b.m23, c.m23).into(),
                m33: f(self.m33, b.m33, c.m33).into(),
                m43: f(self.m43, b.m43, c.m43).into(),
                m14: f(self.m14, b.m14, c.m14).into(),
                m24: f(self.m24, b.m24, c.m24).into(),
                m34: f(self.m34, b.m34, c.m34).into(),
                m44: f(self.m44, b.m44, c.m44).into(),
            };
    }

    /// Sets every component to `f()` (one call per component, column-major). The closure's output
    /// converts `Into<T>`. Upstream: `fill_with` (`impl Fn() -> T`).
    #[cfg(feature: 'closures')]
    #[inline]
    fn fill_with<F, +Drop<F>, impl Func: core::ops::Fn<F, ()>, +Into<Func::Output, T>>(
        ref self: Matrix4<T>, f: F,
    ) {
        self =
            Matrix4 {
                m11: f().into(),
                m21: f().into(),
                m31: f().into(),
                m41: f().into(),
                m12: f().into(),
                m22: f().into(),
                m32: f().into(),
                m42: f().into(),
                m13: f().into(),
                m23: f().into(),
                m33: f().into(),
                m43: f().into(),
                m14: f().into(),
                m24: f().into(),
                m34: f().into(),
                m44: f().into(),
            };
    }

    /// The `Vector4` of `f(d)` for every diagonal component `d` (top to bottom):
    /// `self.diagonal().map(f)`. `f` is any closure or `Fn` value; Cairo closures take their
    /// arguments by value and cannot mutate their captures. Upstream: `map_diagonal`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn map_diagonal<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Drop<Func::Output>>(
        self: Matrix4<T>, f: F,
    ) -> Vector4<Func::Output> {
        Vector4 { x: f(self.m11), y: f(self.m22), z: f(self.m33), w: f(self.m44) }
    }

    /// Sets every component to `val`. Upstream: `fill`.
    #[inline(always)]
    fn fill(ref self: Matrix4<T>, val: T) {
        self =
            Matrix4 {
                m11: val,
                m21: val,
                m31: val,
                m41: val,
                m12: val,
                m22: val,
                m32: val,
                m42: val,
                m13: val,
                m23: val,
                m33: val,
                m43: val,
                m14: val,
                m24: val,
                m34: val,
                m44: val,
            };
    }

    /// Sets the 4 diagonal components to `val`, the others unchanged. Upstream: `fill_diagonal`.
    #[inline(always)]
    fn fill_diagonal(ref self: Matrix4<T>, val: T) {
        self =
            Matrix4 {
                m11: val,
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m12: self.m12,
                m22: val,
                m32: self.m32,
                m42: self.m42,
                m13: self.m13,
                m23: self.m23,
                m33: val,
                m43: self.m43,
                m14: self.m14,
                m24: self.m24,
                m34: self.m34,
                m44: val,
            };
    }

    /// Sets `self` to the identity: ones on the diagonal, zeros elsewhere (`fill(0)` then
    /// `fill_diagonal(1)`). Upstream: `fill_with_identity`.
    #[inline(always)]
    fn fill_with_identity(ref self: Matrix4<T>) {
        self =
            Matrix4 {
                m11: R::one(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m12: R::zero(),
                m22: R::one(),
                m32: R::zero(),
                m42: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::one(),
                m43: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
                m44: R::one(),
            };
    }

    /// Sets the 4 components of row `i` to `val`. Panics with `nalgebra: index out of bounds` for
    /// `i >= 4`. Upstream: `fill_row`.
    ///
    /// ONE `match` on `i` selects the literal: measured 2.1 times cheaper than one comparison per
    /// component (`bench_matrix4_fill_row__alt_per_component`).
    #[inline(always)]
    fn fill_row(ref self: Matrix4<T>, i: usize, val: T) {
        self = match i {
            0 => Matrix4 {
                m11: val,
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m12: val,
                m22: self.m22,
                m32: self.m32,
                m42: self.m42,
                m13: val,
                m23: self.m23,
                m33: self.m33,
                m43: self.m43,
                m14: val,
                m24: self.m24,
                m34: self.m34,
                m44: self.m44,
            },
            1 => Matrix4 {
                m11: self.m11,
                m21: val,
                m31: self.m31,
                m41: self.m41,
                m12: self.m12,
                m22: val,
                m32: self.m32,
                m42: self.m42,
                m13: self.m13,
                m23: val,
                m33: self.m33,
                m43: self.m43,
                m14: self.m14,
                m24: val,
                m34: self.m34,
                m44: self.m44,
            },
            2 => Matrix4 {
                m11: self.m11,
                m21: self.m21,
                m31: val,
                m41: self.m41,
                m12: self.m12,
                m22: self.m22,
                m32: val,
                m42: self.m42,
                m13: self.m13,
                m23: self.m23,
                m33: val,
                m43: self.m43,
                m14: self.m14,
