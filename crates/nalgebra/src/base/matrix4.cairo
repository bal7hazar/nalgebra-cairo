pub impl Matrix4MatrixIndexLinear<T, +Copy<T>, +Drop<T>> of MatrixIndex<Matrix4<T>, usize> {
    type Output = T;
    #[inline(always)]
    fn get(self: Matrix4<T>, index: usize) -> Option<T> {
        match index {
            0 => Option::Some(self.m11),
            1 => Option::Some(self.m21),
            2 => Option::Some(self.m31),
            3 => Option::Some(self.m41),
            4 => Option::Some(self.m12),
            5 => Option::Some(self.m22),
            6 => Option::Some(self.m32),
            7 => Option::Some(self.m42),
            8 => Option::Some(self.m13),
            9 => Option::Some(self.m23),
            10 => Option::Some(self.m33),
            11 => Option::Some(self.m43),
            12 => Option::Some(self.m14),
            13 => Option::Some(self.m24),
            14 => Option::Some(self.m34),
            15 => Option::Some(self.m44),
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: Matrix4<T>, index: usize) -> T {
        match index {
            0 => self.m11,
            1 => self.m21,
            2 => self.m31,
            3 => self.m41,
            4 => self.m12,
            5 => self.m22,
            6 => self.m32,
            7 => self.m42,
            8 => self.m13,
            9 => self.m23,
            10 => self.m33,
            11 => self.m43,
            12 => self.m14,
            13 => self.m24,
            14 => self.m34,
            15 => self.m44,
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
