    /// The 4x4 matrix whose component `(i, j)` (row, column, 0-based) is `f(i, j)`, `f` being
    /// called in column-major order like upstream. `f` is any closure or `Fn` value of `(usize,
    /// usize)` whose output converts `Into<T>` (the identity included): Cairo cannot state `Output
    /// = T` on the closure without the `associated_item_constraints` experimental feature.
    /// Upstream: `Matrix4::from_fn`.
    fn from_fn<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (usize, usize)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        f: F,
    ) -> Matrix4<T> {
        Matrix4 {
            m11: f(0, 0).into(),
            m21: f(1, 0).into(),
            m31: f(2, 0).into(),
            m41: f(3, 0).into(),
            m12: f(0, 1).into(),
            m22: f(1, 1).into(),
            m32: f(2, 1).into(),
            m42: f(3, 1).into(),
            m13: f(0, 2).into(),
            m23: f(1, 2).into(),
            m33: f(2, 2).into(),
            m43: f(3, 2).into(),
            m14: f(0, 3).into(),
            m24: f(1, 3).into(),
            m34: f(2, 3).into(),
            m44: f(3, 3).into(),
        }
    }

    /// The 4x4 matrix of the 16 values of `data`, in row-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 16`. Upstream: `Matrix4::from_row_slice` (`&[T]`).
    ///
    /// `data` is read as ONE fixed-size array (`Span -> @Box<[T; 16]>`, one length check): measured
    /// about 5 times cheaper than a bounds-checked `*data[k]` per component
    /// (`bench_matrix3_from_row_slice__alt_span_index`).
    #[inline(always)]
    fn from_row_slice(data: Span<T>) -> Matrix4<T> {
        let boxed: @Box<[T; 16]> = data.try_into().expect(errors::SLICE_LENGTH);
        let [v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15] = boxed.unbox();
        Matrix4 {
            m11: v0,
            m21: v4,
            m31: v8,
            m41: v12,
            m12: v1,
            m22: v5,
            m32: v9,
            m42: v13,
            m13: v2,
            m23: v6,
            m33: v10,
            m43: v14,
            m14: v3,
            m24: v7,
            m34: v11,
            m44: v15,
        }
    }

    /// The 4x4 matrix of the 16 values of `data`, in column-major order. Panics with `nalgebra:
    /// wrong slice length` unless `data.len() == 16`. Upstream: `Matrix4::from_column_slice`
    /// (`&[T]`).
    ///
    /// `data` is read as ONE fixed-size array (`Span -> @Box<[T; 16]>`, one length check): measured
    /// about 5 times cheaper than a bounds-checked `*data[k]` per component
    /// (`bench_matrix3_from_row_slice__alt_span_index`).
    #[inline(always)]
    fn from_column_slice(data: Span<T>) -> Matrix4<T> {
        let boxed: @Box<[T; 16]> = data.try_into().expect(errors::SLICE_LENGTH);
        let [v0, v1, v2, v3, v4, v5, v6, v7, v8, v9, v10, v11, v12, v13, v14, v15] = boxed.unbox();
        Matrix4 {
            m11: v0,
            m21: v1,
            m31: v2,
            m41: v3,
            m12: v4,
            m22: v5,
            m32: v6,
            m42: v7,
            m13: v8,
            m23: v9,
            m33: v10,
            m43: v11,
            m14: v12,
            m24: v13,
            m34: v14,
            m44: v15,
        }
    }

    /// The 4x4 matrix whose first `data.len()` diagonal components are `data`, every other
    /// component zero. Panics with `nalgebra: diagonal too long` when `data.len() > 4`. Upstream:
    /// `Matrix4::from_partial_diagonal` (`&[T]`).
    #[inline(always)]
    fn from_partial_diagonal(data: Span<T>) -> Matrix4<T> {
        let len = data.len();
        if len > 4 {
            core::panic_with_felt252(errors::TOO_MANY_DIAGONAL);
        }
        Matrix4 {
            m11: if len > 0 {
                *data[0]
            } else {
                R::zero()
            },
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m12: R::zero(),
            m22: if len > 1 {
                *data[1]
            } else {
                R::zero()
            },
            m32: R::zero(),
            m42: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: if len > 2 {
                *data[2]
            } else {
                R::zero()
            },
            m43: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: if len > 3 {
                *data[3]
            } else {
                R::zero()
            },
        }
    }

