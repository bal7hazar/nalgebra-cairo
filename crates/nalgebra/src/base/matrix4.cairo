    #[inline(always)]
    fn set_partial_diagonal(ref self: Matrix4<T>, diag: Span<T>) {
        let len = diag.len();
        self =
            Matrix4 {
                m11: if len > 0 {
                    *diag[0]
                } else {
                    self.m11
                },
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m12: self.m12,
                m22: if len > 1 {
                    *diag[1]
                } else {
                    self.m22
                },
                m32: self.m32,
                m42: self.m42,
                m13: self.m13,
                m23: self.m23,
                m33: if len > 2 {
