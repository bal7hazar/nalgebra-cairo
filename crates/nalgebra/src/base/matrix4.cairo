    /// The number of rows, 4. Upstream: `nrows`.
    #[inline(always)]
    fn nrows(self: Matrix4<T>) -> usize {
        4
    }

    /// The number of columns, 4. Upstream: `ncols`.
    #[inline(always)]
    fn ncols(self: Matrix4<T>) -> usize {
        4
    }

    /// `(nrows, ncols)`, `(4, 4)`. Upstream: `shape`.
    #[inline(always)]
    fn shape(self: Matrix4<T>) -> (usize, usize) {
