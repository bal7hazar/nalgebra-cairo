    /// `(self + selfᵀ) / 2`: each off-diagonal pair is ONE `sum_prod2` by `1/2` (floored once, no
    /// intermediate overflow), the diagonal is copied exactly. Upstream: `symmetric_part`.
    #[inline(always)]
    fn symmetric_part(self: Matrix4<T>) -> Matrix4<T> {
        let a21 = R::sum_prod2(self.m21, R::HALF, self.m12, R::HALF);
        let a31 = R::sum_prod2(self.m31, R::HALF, self.m13, R::HALF);
        let a41 = R::sum_prod2(self.m41, R::HALF, self.m14, R::HALF);
        let a32 = R::sum_prod2(self.m32, R::HALF, self.m23, R::HALF);
        let a42 = R::sum_prod2(self.m42, R::HALF, self.m24, R::HALF);
        let a43 = R::sum_prod2(self.m43, R::HALF, self.m34, R::HALF);
        Matrix4 {
            m11: self.m11,
            m21: a21,
            m31: a31,
            m41: a41,
            m12: a21,
            m22: self.m22,
            m32: a32,
            m42: a42,
            m13: a31,
            m23: a32,
            m33: self.m33,
            m43: a43,
            m14: a41,
            m24: a42,
            m34: a43,
            m44: self.m44,
        }
    }

