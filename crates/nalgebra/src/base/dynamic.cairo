//! Dynamically sized matrices (upstream `DMatrix`, `DVector`, `RowDVector` and the partially
//! dynamic aliases `Matrix1xX..Matrix6xX`, `MatrixXx1..MatrixXx6`), DESIGN D5. Behind the Scarb
//! feature `dynamic` (in `default`, DESIGN D9): nothing ungated in the crate uses them.
//!
//! - `dmatrix`, `dvector`, `row_dvector`: the three types and their methods;
//! - `ops`: operators, indexing, products and conversions between them;
//! - `shapes` (generated by `tools/shapegen`): the conversions from the 36 static shapes and the
//!   edition forms of the static shapes whose result is dynamic or has another static shape
//!   (`insert_columns`, `remove_fixed_rows`...);
//! - `kernels`: the loops on column-major spans.

pub mod dmatrix;
pub mod dvector;
mod kernels;
pub mod ops;
pub mod row_dvector;
pub mod shapes;

pub use dmatrix::{
    DMatrix, DMatrixTrait, Matrix2xX, Matrix3xX, Matrix4xX, Matrix5xX, Matrix6xX, MatrixXx2,
    MatrixXx3, MatrixXx4, MatrixXx5, MatrixXx6,
};
pub use dvector::{DVector, DVectorTrait, MatrixXx1};
pub use row_dvector::{Matrix1xX, RowDVector, RowDVectorTrait};
