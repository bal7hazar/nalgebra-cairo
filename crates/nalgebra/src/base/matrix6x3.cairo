/// `lhs + rhs`, component-wise. Exact; panics on overflow. Upstream: `Add`.
pub impl Matrix6x3Add<T, +Add<T>, +Copy<T>, +Drop<T>> of Add<Matrix6x3<T>> {
    #[inline(always)]
    fn add(lhs: Matrix6x3<T>, rhs: Matrix6x3<T>) -> Matrix6x3<T> {
        Matrix6x3 {
            m11: lhs.m11 + rhs.m11,
            m21: lhs.m21 + rhs.m21,
            m31: lhs.m31 + rhs.m31,
            m41: lhs.m41 + rhs.m41,
            m51: lhs.m51 + rhs.m51,
            m61: lhs.m61 + rhs.m61,
            m12: lhs.m12 + rhs.m12,
            m22: lhs.m22 + rhs.m22,
            m32: lhs.m32 + rhs.m32,
            m42: lhs.m42 + rhs.m42,
            m52: lhs.m52 + rhs.m52,
            m62: lhs.m62 + rhs.m62,
            m13: lhs.m13 + rhs.m13,
            m23: lhs.m23 + rhs.m23,
            m33: lhs.m33 + rhs.m33,
            m43: lhs.m43 + rhs.m43,
            m53: lhs.m53 + rhs.m53,
            m63: lhs.m63 + rhs.m63,
        }
