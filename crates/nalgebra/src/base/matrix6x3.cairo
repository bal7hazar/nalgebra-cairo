            m31: f(2, 0, self.m31),
            m41: f(3, 0, self.m41),
            m51: f(4, 0, self.m51),
            m61: f(5, 0, self.m61),
            m12: f(0, 1, self.m12),
            m22: f(1, 1, self.m22),
            m32: f(2, 1, self.m32),
            m42: f(3, 1, self.m42),
            m52: f(4, 1, self.m52),
