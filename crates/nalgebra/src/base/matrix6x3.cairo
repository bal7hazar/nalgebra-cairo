    }

    /// The 6x3 matrix of `f(x)` for every component `x` (called in column-major order). `f` is any
    /// closure or `Fn` value; Cairo closures take their arguments by value and cannot mutate their
    /// captures. Upstream: `map`.
    #[inline]
    fn map<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Drop<Func::Output>>(
        self: Matrix6x3<T>, f: F,
    ) -> Matrix6x3<Func::Output> {
        Matrix6x3 {
            m11: f(self.m11),
            m21: f(self.m21),
            m31: f(self.m31),
            m41: f(self.m41),
            m51: f(self.m51),
            m61: f(self.m61),
            m12: f(self.m12),
            m22: f(self.m22),
