    fn tr_mul(self: Matrix3<T>, rhs: Vector3<T>) -> Vector3<T> {
        MatrixMul::mul_mat(
            Matrix3 {
                m11: self.m11,
                m21: self.m12,
                m31: self.m13,
                m12: self.m21,
                m22: self.m22,
                m32: self.m23,
                m13: self.m31,
                m23: self.m32,
                m33: self.m33,
            },
            rhs,
        )
    }
}

