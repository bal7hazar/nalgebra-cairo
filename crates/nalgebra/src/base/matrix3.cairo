    }

    /// Sets the 3 components of column `j` to `val`. Panics with `nalgebra: index out of bounds`
    /// for `j >= 3`. Upstream: `fill_column`.
    #[inline(always)]
    fn fill_column(ref self: Matrix3<T>, j: usize, val: T) {
        self = match j {
            0 => Matrix3 {
                m11: val,
                m21: val,
                m31: val,
                m12: self.m12,
                m22: self.m22,
                m32: self.m32,
                m13: self.m13,
                m23: self.m23,
                m33: self.m33,
            },
            1 => Matrix3 {
                m11: self.m11,
                m21: self.m21,
                m31: self.m31,
                m12: val,
                m22: val,
                m32: val,
                m13: self.m13,
                m23: self.m23,
                m33: self.m33,
            },
            2 => Matrix3 {
                m11: self.m11,
                m21: self.m21,
                m31: self.m31,
                m12: self.m12,
                m22: self.m22,
                m32: self.m32,
                m13: val,
                m23: val,
