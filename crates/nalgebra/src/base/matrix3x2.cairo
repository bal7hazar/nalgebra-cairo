/// The component-wise partial order: `a < b` when EVERY component of `a` is smaller than `b`'s
/// (likewise `<=`, `>`, `>=`), so two matrices may be unordered (`!(a < b) && !(a >= b)`).
/// Upstream: `PartialOrd for Matrix`.
pub impl Matrix3x2PartialOrd<T, +PartialOrd<T>, +Copy<T>, +Drop<T>> of PartialOrd<Matrix3x2<T>> {
    #[inline(always)]
    fn lt(lhs: Matrix3x2<T>, rhs: Matrix3x2<T>) -> bool {
        lhs.m11 < rhs.m11
            && lhs.m21 < rhs.m21
            && lhs.m31 < rhs.m31
            && lhs.m12 < rhs.m12
            && lhs.m22 < rhs.m22
            && lhs.m32 < rhs.m32
    }
    #[inline(always)]
    fn le(lhs: Matrix3x2<T>, rhs: Matrix3x2<T>) -> bool {
        lhs.m11 <= rhs.m11
            && lhs.m21 <= rhs.m21
            && lhs.m31 <= rhs.m31
            && lhs.m12 <= rhs.m12
            && lhs.m22 <= rhs.m22
            && lhs.m32 <= rhs.m32
    }
    #[inline(always)]
    fn gt(lhs: Matrix3x2<T>, rhs: Matrix3x2<T>) -> bool {
        lhs.m11 > rhs.m11
            && lhs.m21 > rhs.m21
            && lhs.m31 > rhs.m31
            && lhs.m12 > rhs.m12
            && lhs.m22 > rhs.m22
            && lhs.m32 > rhs.m32
    }
    #[inline(always)]
    fn ge(lhs: Matrix3x2<T>, rhs: Matrix3x2<T>) -> bool {
        lhs.m11 >= rhs.m11
            && lhs.m21 >= rhs.m21
            && lhs.m31 >= rhs.m31
            && lhs.m12 >= rhs.m12
            && lhs.m22 >= rhs.m22
            && lhs.m32 >= rhs.m32
    }
}

