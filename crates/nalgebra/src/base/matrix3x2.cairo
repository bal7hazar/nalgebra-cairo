        let w = R::wide_add_prod(w, self.m22 - rhs.m22, self.m22 - rhs.m22);
        R::wide_sqrt(R::wide_add_prod(w, self.m32 - rhs.m32, self.m32 - rhs.m32))
    }

    /// `self / k`, each component the correctly rounded quotient (nearest, ties to even), through 1
    /// prepared-divisor `Real::divN` call(s), bit-identical to one `Real::div` per component.
    /// Panics on a zero `k` and on overflow. Upstream: `unscale` (`self / k`).
    #[inline(always)]
    fn unscale(self: Matrix3x2<T>, k: T) -> Matrix3x2<T> {
        let (m11, m21, m31, m12, m22, m32) = R::div6(
            self.m11, self.m21, self.m31, self.m12, self.m22, self.m32, k,
        );
        Matrix3x2 { m11, m21, m31, m12, m22, m32 }
    }

    /// `self / self.norm()`: the floored norm, then `unscale`. Panics with a division by zero when
    /// the norm is zero, and on overflow when the norm does not fit. Upstream: `normalize`.
    #[inline(always)]
    fn normalize(self: Matrix3x2<T>) -> Matrix3x2<T> {
        Self::unscale(self, Self::norm(self))
    }

    /// `Some(self.normalize())`, or `None` when the norm is `<= min_norm` (never divides by zero
    /// for `min_norm >= 0`). Upstream: `try_normalize`.
    #[inline(always)]
    fn try_normalize(self: Matrix3x2<T>, min_norm: T) -> Option<Matrix3x2<T>> {
        let n = Self::norm(self);
        if n <= min_norm {
            None
        } else {
            Some(Self::unscale(self, n))
        }
    }

    /// `self` when its norm is `<= max`, otherwise `self.scale(max / norm)` (the ratio rounded to
    /// nearest, like upstream's `max / n`). Panics only when the norm does not fit. Upstream:
    /// `cap_magnitude`.
    #[inline(always)]
    fn cap_magnitude(self: Matrix3x2<T>, max: T) -> Matrix3x2<T> {
        let n = Self::norm(self);
        if n <= max {
            self
        } else {
            Self::scale(self, R::div(max, n))
        }
    }

    /// Scales `self` to the norm `magnitude` (`self.scale(magnitude / norm)`, the ratio rounded to
    /// nearest) when its norm is `> min_magnitude`, leaves it unchanged otherwise. Upstream:
    /// `try_set_magnitude` (`&mut self`).
    #[inline(always)]
    fn try_set_magnitude(ref self: Matrix3x2<T>, magnitude: T, min_magnitude: T) {
        let n = Self::norm(self);
        if n > min_magnitude {
            self = Self::scale(self, R::div(magnitude, n));
        }
    }

    /// The induced 1-norm: the largest absolute column sum (the L1 norm of a column vector, the
    /// largest absolute value of a row vector). Exact; panics on overflow. Upstream: `one_norm`.
    #[inline(always)]
    fn one_norm(self: Matrix3x2<T>) -> T {
        R::max(
            R::abs(self.m11) + R::abs(self.m21) + R::abs(self.m31),
            R::abs(self.m12) + R::abs(self.m22) + R::abs(self.m32),
        )
    }

    /// The conjugate transpose, a `Matrix2x3`: the transpose for a real scalar. Exact. Upstream:
    /// `adjoint`.
    #[inline(always)]
    fn adjoint(self: Matrix3x2<T>) -> Matrix2x3<T> {
        Self::transpose(self)
    }

    /// Alias of `adjoint` (deprecated upstream). Upstream: `conjugate_transpose`.
    #[inline(always)]
    fn conjugate_transpose(self: Matrix3x2<T>) -> Matrix2x3<T> {
        Self::transpose(self)
    }

    /// The component-wise conjugate: `self` for a real scalar. Upstream: `conjugate`.
    #[inline(always)]
    fn conjugate(self: Matrix3x2<T>) -> Matrix3x2<T> {
        self
    }

    /// `self / r` = `self * rᵀ` (the inverse of a rotation is its transpose), a `Matrix3x2`: each
    /// component one fused `sum_prod2` (floored once). Panics on overflow. Upstream:
    /// `Div<Rotation2> for Matrix` (`m / r`; Cairo's `Div` is homogeneous, so the heterogeneous
    /// operator is a named method, like `UnitQuaternion::div_rotation`).
    fn div_rotation(self: Matrix3x2<T>, r: Rotation2<T>) -> Matrix3x2<T> {
        Matrix3x2 {
            m11: R::sum_prod2(self.m11, r.matrix.m11, self.m12, r.matrix.m12),
            m21: R::sum_prod2(self.m21, r.matrix.m11, self.m22, r.matrix.m12),
            m31: R::sum_prod2(self.m31, r.matrix.m11, self.m32, r.matrix.m12),
            m12: R::sum_prod2(self.m11, r.matrix.m21, self.m12, r.matrix.m22),
            m22: R::sum_prod2(self.m21, r.matrix.m21, self.m22, r.matrix.m22),
            m32: R::sum_prod2(self.m31, r.matrix.m21, self.m32, r.matrix.m22),
        }
    }

    /// The same shape with every component converted by `Into<T, U>`. With the single scalar of
    /// this library (`Fixed`) it is the identity; it exists for scalar-generic code. Upstream:
    /// `cast` (and `SubsetOf<Matrix<U>>`, the `nalgebra::convert` it goes through).
    fn cast<U, +Into<T, U>, +Drop<U>>(self: Matrix3x2<T>) -> Matrix3x2<U> {
        Matrix3x2 {
            m11: self.m11.into(),
            m21: self.m21.into(),
            m31: self.m31.into(),
            m12: self.m12.into(),
            m22: self.m22.into(),
            m32: self.m32.into(),
        }
    }

    /// `Some` of the shape with every component converted by `TryInto<T, U>`, `None` as soon as one
    /// conversion fails. Upstream: `try_cast`.
    fn try_cast<U, +TryInto<T, U>, +Drop<U>>(self: Matrix3x2<T>) -> Option<Matrix3x2<U>> {
        let m11: U = self.m11.try_into()?;
        let m21: U = self.m21.try_into()?;
        let m31: U = self.m31.try_into()?;
        let m12: U = self.m12.try_into()?;
        let m22: U = self.m22.try_into()?;
        let m32: U = self.m32.try_into()?;
        Option::Some(Matrix3x2 { m11, m21, m31, m12, m22, m32 })
    }

    /// `true` when every component is within `epsilon` ulp of `other`'s, or has the same sign and
    /// lies within `max_relative` times the larger magnitude of the two (`|a - b| <= max(|a|, |b|)
    /// · max_relative`). Panics on a component equal to the scalar's `MIN`, and on overflow of
    /// that product (only possible with `max_relative > 1`). Upstream:
    /// `approx::RelativeEq::relative_eq`, `epsilon` counted in ulp instead of a float epsilon
    /// (DESIGN D3).
    #[inline(always)]
    fn relative_eq(self: Matrix3x2<T>, other: Matrix3x2<T>, epsilon: u64, max_relative: T) -> bool {
        ApproxEqTrait::relative_eq(self.m11, other.m11, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m21, other.m21, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m31, other.m31, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m12, other.m12, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m22, other.m22, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.m32, other.m32, epsilon, max_relative)
    }

    /// `true` when every component is within `epsilon` ulp of `other`'s, or has the same sign and
    /// lies within `max_ulps` ulp (in fixed point the distance in ulp IS the raw difference; the
    /// `max_ulps` budget does not cross zero, like upstream's float `ulps_eq`). Cannot overflow.
    /// Upstream: `approx::UlpsEq::ulps_eq`.
    #[inline(always)]
    fn ulps_eq(self: Matrix3x2<T>, other: Matrix3x2<T>, epsilon: u64, max_ulps: u32) -> bool {
        ApproxEqTrait::ulps_eq(self.m11, other.m11, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m21, other.m21, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m31, other.m31, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m12, other.m12, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m22, other.m22, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.m32, other.m32, epsilon, max_ulps)
    }

    /// The 3x2 matrix of `f(x)` for every component `x` (called in column-major order). `f` is any
    /// closure or `Fn` value; Cairo closures take their arguments by value and cannot mutate their
    /// captures. Upstream: `map`.
    #[inline]
    fn map<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Drop<Func::Output>>(
        self: Matrix3x2<T>, f: F,
    ) -> Matrix3x2<Func::Output> {
        Matrix3x2 {
            m11: f(self.m11),
            m21: f(self.m21),
            m31: f(self.m31),
            m12: f(self.m12),
            m22: f(self.m22),
            m32: f(self.m32),
        }
    }

    /// The 3x2 matrix of `f(i, j, x)` for every component `x` at row `i`, column `j` (0-based,
    /// column-major order). `f` is any closure or `Fn` value; Cairo closures take their arguments
    /// by value and cannot mutate their captures. Upstream: `map_with_location`.
    #[inline]
    fn map_with_location<
        F, +Drop<F>, impl Func: core::ops::Fn<F, (usize, usize, T)>, +Drop<Func::Output>,
    >(
        self: Matrix3x2<T>, f: F,
    ) -> Matrix3x2<Func::Output> {
        Matrix3x2 {
            m11: f(0, 0, self.m11),
            m21: f(1, 0, self.m21),
            m31: f(2, 0, self.m31),
            m12: f(0, 1, self.m12),
            m22: f(1, 1, self.m22),
            m32: f(2, 1, self.m32),
        }
    }

    /// The 3x2 matrix of `f(a, b)` for the components `a` of `self` and `b` of `rhs` at the same
    /// position. `f` is any closure or `Fn` value; Cairo closures take their arguments by value and
    /// cannot mutate their captures. Upstream: `zip_map`.
    #[inline]
    fn zip_map<
        T2,
        +Copy<T2>,
        +Drop<T2>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2)>,
        +Drop<Func::Output>,
    >(
        self: Matrix3x2<T>, rhs: Matrix3x2<T2>, f: F,
    ) -> Matrix3x2<Func::Output> {
        Matrix3x2 {
            m11: f(self.m11, rhs.m11),
            m21: f(self.m21, rhs.m21),
            m31: f(self.m31, rhs.m31),
            m12: f(self.m12, rhs.m12),
            m22: f(self.m22, rhs.m22),
            m32: f(self.m32, rhs.m32),
        }
    }

    /// The 3x2 matrix of `f(a, b, c)` for the components of `self`, `b` and `c` at the same
    /// position. `f` is any closure or `Fn` value; Cairo closures take their arguments by value and
    /// cannot mutate their captures. Upstream: `zip_zip_map`.
    #[inline]
    fn zip_zip_map<
        T2,
        T3,
        +Copy<T2>,
        +Drop<T2>,
        +Copy<T3>,
        +Drop<T3>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2, T3)>,
        +Drop<Func::Output>,
    >(
        self: Matrix3x2<T>, b: Matrix3x2<T2>, c: Matrix3x2<T3>, f: F,
    ) -> Matrix3x2<Func::Output> {
        Matrix3x2 {
            m11: f(self.m11, b.m11, c.m11),
            m21: f(self.m21, b.m21, c.m21),
            m31: f(self.m31, b.m31, c.m31),
            m12: f(self.m12, b.m12, c.m12),
            m22: f(self.m22, b.m22, c.m22),
            m32: f(self.m32, b.m32, c.m32),
        }
    }

    /// `f(.. f(f(init, x0), x1) .., x5)` over the components in column-major order. The closure's
    /// output converts `Into<Acc>` (the identity included): Cairo cannot state `Output = Acc`
    /// without the `associated_item_constraints` experimental feature. `f` is any closure or `Fn`
    /// value; Cairo closures take their arguments by value and cannot mutate their captures.
    /// Upstream: `fold`.
    #[inline]
    fn fold<Acc, F, +Drop<F>, impl Func: core::ops::Fn<F, (Acc, T)>, +Into<Func::Output, Acc>>(
        self: Matrix3x2<T>, init: Acc, f: F,
    ) -> Acc {
        let acc: Acc = f(init, self.m11).into();
        let acc: Acc = f(acc, self.m21).into();
        let acc: Acc = f(acc, self.m31).into();
        let acc: Acc = f(acc, self.m12).into();
        let acc: Acc = f(acc, self.m22).into();
        f(acc, self.m32).into()
    }

    /// `init_f(Some(x0))`, then `f(acc, x)` over the other components in column-major order:
    /// upstream's `fold_with` (`init_f` receives the first component, `None` only for an empty
    /// matrix, which a static shape never is). The accumulator has the type of `init_f`'s output;
    /// `f`'s output converts `Into` it. The closures receive values instead of upstream's `&T`.
    /// Upstream: `fold_with`.
    #[inline]
    fn fold_with<
        G,
        +Drop<G>,
        impl Init: core::ops::Fn<G, (Option<T>,)>,
        +Drop<Init::Output>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Init::Output, T)>,
        +Into<Func::Output, Init::Output>,
    >(
        self: Matrix3x2<T>, init_f: G, f: F,
    ) -> Init::Output {
        let acc: Init::Output = init_f(Option::Some(self.m11));
        let acc: Init::Output = f(acc, self.m21).into();
        let acc: Init::Output = f(acc, self.m31).into();
        let acc: Init::Output = f(acc, self.m12).into();
        let acc: Init::Output = f(acc, self.m22).into();
        f(acc, self.m32).into()
    }

    /// `fold` over the pairs of components of `self` and `rhs` at the same position: `f(acc, a,
    /// b)`, column-major. `f` is any closure or `Fn` value; Cairo closures take their arguments by
    /// value and cannot mutate their captures. Upstream: `zip_fold`.
    #[inline]
    fn zip_fold<
        T2,
        +Copy<T2>,
        +Drop<T2>,
        Acc,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Acc, T, T2)>,
        +Into<Func::Output, Acc>,
    >(
        self: Matrix3x2<T>, rhs: Matrix3x2<T2>, init: Acc, f: F,
    ) -> Acc {
        let acc: Acc = f(init, self.m11, rhs.m11).into();
        let acc: Acc = f(acc, self.m21, rhs.m21).into();
        let acc: Acc = f(acc, self.m31, rhs.m31).into();
        let acc: Acc = f(acc, self.m12, rhs.m12).into();
        let acc: Acc = f(acc, self.m22, rhs.m22).into();
        f(acc, self.m32, rhs.m32).into()
    }

    /// Replaces every component `x` by `f(x)` (column-major order). Upstream's closure is
    /// `FnMut(&mut T)`, writing through the reference; a Cairo closure cannot, so it RETURNS the
    /// new component (its output converts `Into<T>`). Upstream: `apply`.
    #[inline]
    fn apply<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Into<Func::Output, T>>(
        ref self: Matrix3x2<T>, f: F,
    ) {
        self =
            Matrix3x2 {
                m11: f(self.m11).into(),
                m21: f(self.m21).into(),
                m31: f(self.m31).into(),
                m12: f(self.m12).into(),
                m22: f(self.m22).into(),
                m32: f(self.m32).into(),
            };
    }

    /// `self` with every component `x` replaced by `f(x)`: `apply` by value. Upstream's closure is
    /// `FnMut(&mut T)`, writing through the reference; a Cairo closure cannot, so it RETURNS the
    /// new component (its output converts `Into<T>`). Upstream: `apply_into`.
    #[inline]
    fn apply_into<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Into<Func::Output, T>>(
        self: Matrix3x2<T>, f: F,
    ) -> Matrix3x2<T> {
        Matrix3x2 {
            m11: f(self.m11).into(),
            m21: f(self.m21).into(),
            m31: f(self.m31).into(),
            m12: f(self.m12).into(),
            m22: f(self.m22).into(),
            m32: f(self.m32).into(),
        }
    }

    /// Replaces every component `a` by `f(a, b)`, `b` the component of `rhs` at the same position.
    /// Upstream's closure is `FnMut(&mut T)`, writing through the reference; a Cairo closure
    /// cannot, so it RETURNS the new component (its output converts `Into<T>`). Upstream:
    /// `zip_apply`.
    #[inline]
    fn zip_apply<
        T2,
        +Copy<T2>,
        +Drop<T2>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2)>,
        +Into<Func::Output, T>,
    >(
        ref self: Matrix3x2<T>, rhs: Matrix3x2<T2>, f: F,
    ) {
        self =
            Matrix3x2 {
                m11: f(self.m11, rhs.m11).into(),
                m21: f(self.m21, rhs.m21).into(),
                m31: f(self.m31, rhs.m31).into(),
                m12: f(self.m12, rhs.m12).into(),
                m22: f(self.m22, rhs.m22).into(),
                m32: f(self.m32, rhs.m32).into(),
            };
    }

    /// Replaces every component `a` by `f(a, b, c)`, `b` and `c` the components of `b` and `c` at
    /// the same position. Upstream's closure is `FnMut(&mut T)`, writing through the reference; a
    /// Cairo closure cannot, so it RETURNS the new component (its output converts `Into<T>`).
    /// Upstream: `zip_zip_apply`.
    #[inline]
    fn zip_zip_apply<
        T2,
        T3,
        +Copy<T2>,
        +Drop<T2>,
        +Copy<T3>,
        +Drop<T3>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2, T3)>,
        +Into<Func::Output, T>,
    >(
        ref self: Matrix3x2<T>, b: Matrix3x2<T2>, c: Matrix3x2<T3>, f: F,
    ) {
        self =
            Matrix3x2 {
                m11: f(self.m11, b.m11, c.m11).into(),
                m21: f(self.m21, b.m21, c.m21).into(),
                m31: f(self.m31, b.m31, c.m31).into(),
                m12: f(self.m12, b.m12, c.m12).into(),
                m22: f(self.m22, b.m22, c.m22).into(),
                m32: f(self.m32, b.m32, c.m32).into(),
            };
    }

    /// Sets every component to `f()` (one call per component, column-major). The closure's output
    /// converts `Into<T>`. Upstream: `fill_with` (`impl Fn() -> T`).
    #[inline]
    fn fill_with<F, +Drop<F>, impl Func: core::ops::Fn<F, ()>, +Into<Func::Output, T>>(
        ref self: Matrix3x2<T>, f: F,
    ) {
        self =
            Matrix3x2 {
                m11: f().into(),
                m21: f().into(),
                m31: f().into(),
                m12: f().into(),
                m22: f().into(),
                m32: f().into(),
            };
    }

    /// Sets every component to `val`. Upstream: `fill`.
    #[inline(always)]
    fn fill(ref self: Matrix3x2<T>, val: T) {
        self = Matrix3x2 { m11: val, m21: val, m31: val, m12: val, m22: val, m32: val };
    }

    /// Sets the 2 diagonal components to `val`, the others unchanged. Upstream: `fill_diagonal`.
    #[inline(always)]
    fn fill_diagonal(ref self: Matrix3x2<T>, val: T) {
        self =
            Matrix3x2 {
                m11: val, m21: self.m21, m31: self.m31, m12: self.m12, m22: val, m32: self.m32,
            };
    }

    /// Sets `self` to the identity: ones on the diagonal, zeros elsewhere (`fill(0)` then
    /// `fill_diagonal(1)`). Upstream: `fill_with_identity`.
    #[inline(always)]
    fn fill_with_identity(ref self: Matrix3x2<T>) {
        self =
            Matrix3x2 {
                m11: R::one(),
                m21: R::zero(),
                m31: R::zero(),
                m12: R::zero(),
                m22: R::one(),
                m32: R::zero(),
            };
    }

    /// Sets the 2 components of row `i` to `val`. Panics with `nalgebra: index out of bounds` for
    /// `i >= 3`. Upstream: `fill_row`.
    ///
    /// ONE `match` on `i` selects the literal: measured 2.1 times cheaper than one comparison per
    /// component (`bench_matrix4_fill_row__alt_per_component`).
    #[inline(always)]
    fn fill_row(ref self: Matrix3x2<T>, i: usize, val: T) {
        self = match i {
            0 => Matrix3x2 {
                m11: val, m21: self.m21, m31: self.m31, m12: val, m22: self.m22, m32: self.m32,
            },
            1 => Matrix3x2 {
                m11: self.m11, m21: val, m31: self.m31, m12: self.m12, m22: val, m32: self.m32,
            },
            2 => Matrix3x2 {
                m11: self.m11, m21: self.m21, m31: val, m12: self.m12, m22: self.m22, m32: val,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        };
    }

    /// Sets the 3 components of column `j` to `val`. Panics with `nalgebra: index out of bounds`
    /// for `j >= 2`. Upstream: `fill_column`.
    #[inline(always)]
    fn fill_column(ref self: Matrix3x2<T>, j: usize, val: T) {
        self = match j {
            0 => Matrix3x2 {
                m11: val, m21: val, m31: val, m12: self.m12, m22: self.m22, m32: self.m32,
            },
            1 => Matrix3x2 {
                m11: self.m11, m21: self.m21, m31: self.m31, m12: val, m22: val, m32: val,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        };
    }

    /// Sets every component `(i, j)` with `i >= j + shift` to `val`: the lower triangle with the
    /// diagonal for `shift = 0`, without it for `shift = 1`, leaving `shift - 1` subdiagonals as
    /// well above; nothing changes for `shift >= 3`. ONE `match` on `shift` selects the literal:
    /// measured 2.7 times cheaper than one threshold test per component
    /// (`bench_matrix4_fill_lower_triangle__alt_per_component`). Upstream: `fill_lower_triangle`.
    #[inline(always)]
    fn fill_lower_triangle(ref self: Matrix3x2<T>, val: T, shift: usize) {
        self = match shift {
            0 => Matrix3x2 { m11: val, m21: val, m31: val, m12: self.m12, m22: val, m32: val },
            1 => Matrix3x2 {
                m11: self.m11, m21: val, m31: val, m12: self.m12, m22: self.m22, m32: val,
            },
            2 => Matrix3x2 {
                m11: self.m11, m21: self.m21, m31: val, m12: self.m12, m22: self.m22, m32: self.m32,
            },
            _ => self,
        };
    }

    /// Sets every component `(i, j)` with `j >= i + shift` to `val`: the upper triangle with the
    /// diagonal for `shift = 0`, without it for `shift = 1`, leaving `shift - 1` superdiagonals as
    /// well below; nothing changes for `shift >= 2`. ONE `match` on `shift` selects the literal.
    /// Upstream: `fill_upper_triangle`.
    #[inline(always)]
    fn fill_upper_triangle(ref self: Matrix3x2<T>, val: T, shift: usize) {
        self = match shift {
            0 => Matrix3x2 {
                m11: val, m21: self.m21, m31: self.m31, m12: val, m22: val, m32: self.m32,
            },
            1 => Matrix3x2 {
                m11: self.m11, m21: self.m21, m31: self.m31, m12: val, m22: self.m22, m32: self.m32,
            },
            _ => self,
        };
    }

    /// Replaces row `i` by `row`, a `RowVector2`. Panics with `nalgebra: index out of bounds` for
    /// `i >= 3`. Upstream: `set_row`.
    #[inline(always)]
    fn set_row(ref self: Matrix3x2<T>, i: usize, row: RowVector2<T>) {
        self = match i {
            0 => Matrix3x2 {
                m11: row.x, m21: self.m21, m31: self.m31, m12: row.y, m22: self.m22, m32: self.m32,
            },
            1 => Matrix3x2 {
                m11: self.m11, m21: row.x, m31: self.m31, m12: self.m12, m22: row.y, m32: self.m32,
            },
            2 => Matrix3x2 {
                m11: self.m11, m21: self.m21, m31: row.x, m12: self.m12, m22: self.m22, m32: row.y,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        };
    }

    /// Replaces column `j` by `column`, a `Vector3`. Panics with `nalgebra: index out of bounds`
    /// for `j >= 2`. Upstream: `set_column`.
    #[inline(always)]
    fn set_column(ref self: Matrix3x2<T>, j: usize, column: Vector3<T>) {
        self = match j {
            0 => Matrix3x2 {
                m11: column.x,
                m21: column.y,
                m31: column.z,
                m12: self.m12,
                m22: self.m22,
                m32: self.m32,
            },
            1 => Matrix3x2 {
                m11: self.m11,
                m21: self.m21,
                m31: self.m31,
                m12: column.x,
                m22: column.y,
                m32: column.z,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        };
    }

    /// Replaces the diagonal by `diag`, a `Vector2` (upstream requires the length `min(R, C)` = 2).
    /// Upstream: `set_diagonal`.
    #[inline(always)]
    fn set_diagonal(ref self: Matrix3x2<T>, diag: Vector2<T>) {
        self =
            Matrix3x2 {
                m11: diag.x,
                m21: self.m21,
                m31: self.m31,
                m12: self.m12,
                m22: diag.y,
                m32: self.m32,
            };
    }

    /// Replaces the first `min(diag.len(), 2)` diagonal components by the values of `diag` (the
    /// extra values are ignored, like upstream's `take`), the others unchanged. Upstream:
    /// `set_partial_diagonal` (an iterator; a `Span` here).
    #[inline(always)]
    fn set_partial_diagonal(ref self: Matrix3x2<T>, diag: Span<T>) {
        let len = diag.len();
        self =
            Matrix3x2 {
                m11: if len > 0 {
                    *diag[0]
                } else {
                    self.m11
                },
                m21: self.m21,
                m31: self.m31,
                m12: self.m12,
                m22: if len > 1 {
                    *diag[1]
                } else {
                    self.m22
                },
                m32: self.m32,
            };
    }

    /// Sets `self` to `other` (a `Matrix3x2`: upstream requires the same shape). Upstream:
    /// `copy_from`.
    #[inline(always)]
    fn copy_from(ref self: Matrix3x2<T>, other: Matrix3x2<T>) {
        self = other;
    }

    /// Sets `self` to the 6 values of `slice` in column-major order (`from_column_slice`). Panics
    /// with `nalgebra: wrong slice length` unless `slice.len() == 6`. Upstream: `copy_from_slice`
    /// (`&[T]`).
    #[inline(always)]
    fn copy_from_slice(ref self: Matrix3x2<T>, slice: Span<T>) {
        self = Self::from_column_slice(slice);
    }

    /// Sets `self` to the transpose of `other`, a `Matrix2x3`. Exact. Upstream: `tr_copy_from`.
    #[inline(always)]
    fn tr_copy_from(ref self: Matrix3x2<T>, other: Matrix2x3<T>) {
        self =
            Matrix3x2 {
                m11: other.m11,
                m21: other.m12,
                m31: other.m13,
                m12: other.m21,
                m22: other.m22,
                m32: other.m23,
            };
    }

    /// Exchanges the components at `row_cols1` and `row_cols2` (`(row, column)`). Panics with
    /// `nalgebra: index out of bounds` when either is out of the shape. Upstream: `swap`.
    #[inline]
    fn swap(ref self: Matrix3x2<T>, row_cols1: (usize, usize), row_cols2: (usize, usize)) {
        let a = MatrixIndex::index(self, row_cols1);
        let b = MatrixIndex::index(self, row_cols2);
        self =
            Matrix3x2EditTrait::replace(
                Matrix3x2EditTrait::replace(self, row_cols1, b), row_cols2, a,
            );
    }

    /// Exchanges rows `irow1` and `irow2`. Panics with `nalgebra: index out of bounds` when either
    /// is `>= 3`. Upstream: `swap_rows`.
    ///
    /// Two reads and two writes of a row (one `match` each). ONE nested `match` on both rows is 940
    /// gas (15%) cheaper on `Matrix3` (`bench_matrix3_swap_rows__alt_pair_match`) but generates R²
    /// whole-shape literals (about 40 000 lines over the 36 shapes, per method): kept as a
    /// benchmark.
    #[inline]
    fn swap_rows(ref self: Matrix3x2<T>, irow1: usize, irow2: usize) {
        let a = Matrix3x2EditTrait::row_at(self, irow1);
        let b = Matrix3x2EditTrait::row_at(self, irow2);
        Self::set_row(ref self, irow1, b);
        Self::set_row(ref self, irow2, a);
    }

    /// Exchanges columns `icol1` and `icol2`. Panics with `nalgebra: index out of bounds` when
    /// either is `>= 2`. Upstream: `swap_columns`.
    #[inline]
    fn swap_columns(ref self: Matrix3x2<T>, icol1: usize, icol2: usize) {
        let a = Matrix3x2EditTrait::column_at(self, icol1);
        let b = Matrix3x2EditTrait::column_at(self, icol2);
        Self::set_column(ref self, icol1, b);
        Self::set_column(ref self, icol2, a);
    }

    /// `self = -self`. Exact; panics on overflow (`-MIN`). Upstream: `neg_mut`.
    #[inline(always)]
    fn neg_mut(ref self: Matrix3x2<T>) {
        self = -self;
    }

    /// `self = self.scale(k)`, each component floored once. Panics on overflow. Upstream:
    /// `scale_mut`.
    #[inline(always)]
    fn scale_mut(ref self: Matrix3x2<T>, k: T) {
        self = Self::scale(self, k);
    }

    /// `self = self.unscale(k)`, each component correctly rounded. Panics on a zero `k` and on
    /// overflow. Upstream: `unscale_mut`.
    #[inline(always)]
    fn unscale_mut(ref self: Matrix3x2<T>, k: T) {
        self = Self::unscale(self, k);
    }

    /// Normalizes `self` in place (`self = self.normalize()`, bit-identical) and returns the norm
    /// it had. Panics with a division by zero when the norm is zero. Upstream: `normalize_mut`.
    #[inline(always)]
    fn normalize_mut(ref self: Matrix3x2<T>) -> T {
        let n = Self::norm(self);
        self = Self::unscale(self, n);
        n
    }

    /// Normalizes `self` in place and returns `Some` of the norm it had, or leaves it unchanged and
    /// returns `None` when that norm is `<= min_norm`. Upstream: `try_normalize_mut`.
    #[inline(always)]
    fn try_normalize_mut(ref self: Matrix3x2<T>, min_norm: T) -> Option<T> {
        let n = Self::norm(self);
        if n <= min_norm {
            return None;
        }
        self = Self::unscale(self, n);
        Some(n)
    }

    /// Scales `self` to the norm `magnitude`: `self.scale(magnitude / norm)`, the ratio rounded to
    /// nearest (like `try_set_magnitude`). Panics with a division by zero when the norm is zero
    /// (upstream's floats give NaN). Upstream: `set_magnitude`.
    #[inline(always)]
    fn set_magnitude(ref self: Matrix3x2<T>, magnitude: T) {
        let n = Self::norm(self);
        self = Self::scale(self, R::div(magnitude, n));
    }

    /// `self = self.add_scalar(k)`. Exact; panics on overflow. Upstream: `add_scalar_mut`.
    #[inline(always)]
    fn add_scalar_mut(ref self: Matrix3x2<T>, k: T) {
        self = Self::add_scalar(self, k);
    }

    /// Alias of `component_mul_assign` (deprecated upstream). Upstream: `component_mul_mut`.
    #[inline(always)]
    fn component_mul_mut(ref self: Matrix3x2<T>, rhs: Matrix3x2<T>) {
        Self::component_mul_assign(ref self, rhs);
    }

    /// Alias of `component_div_assign` (deprecated upstream). Upstream: `component_div_mut`.
    #[inline(always)]
    fn component_div_mut(ref self: Matrix3x2<T>, rhs: Matrix3x2<T>) {
        Self::component_div_assign(ref self, rhs);
    }

    /// Conjugates every component in place: nothing changes for a real scalar. Upstream:
    /// `conjugate_mut`.
    #[inline(always)]
    fn conjugate_mut(ref self: Matrix3x2<T>) {
        self = Self::conjugate(self);
    }

    /// Writes the transpose of `self` into `out`, a `Matrix2x3`. Exact. Upstream: `transpose_to`.
    #[inline(always)]
    fn transpose_to(self: Matrix3x2<T>, ref out: Matrix2x3<T>) {
        out = Self::transpose(self);
    }

    /// Writes the adjoint of `self` (its transpose for a real scalar) into `out`, a `Matrix2x3`.
    /// Exact. Upstream: `adjoint_to`.
    #[inline(always)]
    fn adjoint_to(self: Matrix3x2<T>, ref out: Matrix2x3<T>) {
        out = Self::transpose(self);
    }

    /// Writes the adjoint of `self` (deprecated upstream alias of `adjoint_to`) into `out`, a
    /// `Matrix2x3`. Exact. Upstream: `conjugate_transpose_to`.
    #[inline(always)]
    fn conjugate_transpose_to(self: Matrix3x2<T>, ref out: Matrix2x3<T>) {
        out = Self::transpose(self);
    }

    /// Writes the sum `self + rhs` into `out`. Exact; panics on overflow. Upstream: `add_to`.
    #[inline(always)]
    fn add_to(self: Matrix3x2<T>, rhs: Matrix3x2<T>, ref out: Matrix3x2<T>) {
        out = self + rhs;
    }

    /// Writes the difference `self - rhs` into `out`. Exact; panics on overflow. Upstream:
    /// `sub_to`.
    #[inline(always)]
    fn sub_to(self: Matrix3x2<T>, rhs: Matrix3x2<T>, ref out: Matrix3x2<T>) {
        out = self - rhs;
    }

    /// The norm `norm` of `self`: `EuclideanNorm {}` (`norm`), `LpNorm { p }` (`lp_norm(p)`),
    /// `OneNorm {}` (`one_norm`) or `UniformNorm {}` (`amax`), through their `Norm` impls (static
    /// dispatch). Upstream: `apply_norm` (`&impl Norm<T>`; the markers are `Copy` values here).
    #[inline]
    fn apply_norm<N, +Drop<N>, impl Nm: Norm<N, Matrix3x2<T>, T>>(
        self: Matrix3x2<T>, norm: N,
    ) -> T {
        Nm::norm(@norm, self)
    }

    /// The distance between `self` and `rhs` in the norm `norm` (see `apply_norm`; the Euclidean
    /// one is the fused `metric_distance`, the others the norm of the exact difference). Upstream:
    /// `apply_metric_distance`.
    #[inline]
    fn apply_metric_distance<N, +Drop<N>, impl Nm: Norm<N, Matrix3x2<T>, T>>(
        self: Matrix3x2<T>, rhs: Matrix3x2<T>, norm: N,
    ) -> T {
        Nm::metric_distance(@norm, self, rhs)
    }

    /// The number of rows, 3. Upstream: `nrows`.
    #[inline(always)]
    fn nrows(self: Matrix3x2<T>) -> usize {
        3
    }

    /// The number of columns, 2. Upstream: `ncols`.
    #[inline(always)]
    fn ncols(self: Matrix3x2<T>) -> usize {
        2
    }

    /// `(nrows, ncols)`, `(3, 2)`. Upstream: `shape`.
    #[inline(always)]
    fn shape(self: Matrix3x2<T>) -> (usize, usize) {
        (3, 2)
    }

    /// Whether the shape is square: `false`. Upstream: `is_square`.
    #[inline(always)]
    fn is_square(self: Matrix3x2<T>) -> bool {
        false
    }

    /// The `(row, column)` of the `i`-th component in column-major order: `(i % 3, i / 3)`, one
    /// `DivRem` (no bounds check, like upstream). Upstream: `vector_to_matrix_index`.
    #[inline(always)]
    fn vector_to_matrix_index(self: Matrix3x2<T>, i: usize) -> (usize, usize) {
        let (j, i) = DivRem::div_rem(i, 3);
        (i, j)
    }

    /// Row `i`, a `RowVector2` (an owned copy: Cairo has no borrowed views). Panics with `nalgebra:
    /// index out of bounds` for `i >= 3`. ONE `match` on `i` selects the literal (the private
    /// `row_at` of `swap_rows`). Upstream: `row` (a view).
    #[inline(always)]
    fn row(self: Matrix3x2<T>, i: usize) -> RowVector2<T> {
        Matrix3x2EditTrait::row_at(self, i)
    }

    /// Column `j`, a `Vector3` (an owned copy: Cairo has no borrowed views). Panics with `nalgebra:
    /// index out of bounds` for `j >= 2`. ONE `match` on `j` selects the literal (the private
    /// `column_at` of `swap_columns`). Upstream: `column` (a view).
    #[inline(always)]
    fn column(self: Matrix3x2<T>, j: usize) -> Vector3<T> {
        Matrix3x2EditTrait::column_at(self, j)
    }

    /// The upper triangle of `self` (the diagonal included), the components below the diagonal set
    /// to zero. Exact. Upstream: `upper_triangle`.
    #[inline(always)]
    fn upper_triangle(self: Matrix3x2<T>) -> Matrix3x2<T> {
        Matrix3x2 {
            m11: self.m11,
            m21: R::zero(),
            m31: R::zero(),
            m12: self.m12,
            m22: self.m22,
            m32: R::zero(),
        }
    }

    /// The lower triangle of `self` (the diagonal included), the components above the diagonal set
    /// to zero. Exact. Upstream: `lower_triangle`.
    #[inline(always)]
    fn lower_triangle(self: Matrix3x2<T>) -> Matrix3x2<T> {
        Matrix3x2 {
            m11: self.m11,
            m21: self.m21,
            m31: self.m31,
            m12: R::zero(),
            m22: self.m22,
            m32: self.m32,
        }
    }

    /// The 3x2 matrix whose 3 rows are the given vectors, each a `Vector2` of the row's 2
    /// components (the argument form of the former `Matrix2/3/4::from_rows`, used by `linalg`).
    /// Exact. Upstream: `from_rows` (a slice of row vectors).
    #[inline(always)]
    fn from_rows(r1: Vector2<T>, r2: Vector2<T>, r3: Vector2<T>) -> Matrix3x2<T> {
        Matrix3x2 { m11: r1.x, m21: r2.x, m31: r3.x, m12: r1.y, m22: r2.y, m32: r3.y }
    }

    /// The 3x2 matrix whose 2 columns are the given `Vector3`s. Exact. Upstream: `from_columns` (a
    /// slice of column vectors).
    #[inline(always)]
    fn from_columns(c1: Vector3<T>, c2: Vector3<T>) -> Matrix3x2<T> {
        Matrix3x2 { m11: c1.x, m21: c1.y, m31: c1.z, m12: c2.x, m22: c2.y, m32: c2.z }
    }

    /// Whether the columns of `self` are orthonormal: `selfᵀ * self` (fused `tr_mul`, one
    /// rounding per component) is the 2x2 identity within `ulps`. Upstream: `is_orthogonal` (`eps`:
    /// here a tolerance in ulp, DESIGN D3).
    #[inline(always)]
    fn is_orthogonal(self: Matrix3x2<T>, ulps: u64) -> bool {
        Matrix2Trait::is_identity(MatrixTrMul::tr_mul(self, self), ulps)
    }

    /// `self` with a row of `val` inserted at index `i` (`i <= 3`), a `Matrix4x2`. Panics with
    /// `nalgebra: index out of bounds` for `i > 3`. Upstream: `insert_row`.
    #[inline(always)]
    fn insert_row(self: Matrix3x2<T>, i: usize, val: T) -> Matrix4x2<T> {
        match i {
            0 => Matrix4x2 {
                m11: val,
                m21: self.m11,
                m31: self.m21,
                m41: self.m31,
                m12: val,
                m22: self.m12,
                m32: self.m22,
                m42: self.m32,
            },
            1 => Matrix4x2 {
                m11: self.m11,
                m21: val,
                m31: self.m21,
                m41: self.m31,
                m12: self.m12,
                m22: val,
                m32: self.m22,
                m42: self.m32,
            },
            2 => Matrix4x2 {
                m11: self.m11,
                m21: self.m21,
                m31: val,
                m41: self.m31,
                m12: self.m12,
                m22: self.m22,
                m32: val,
                m42: self.m32,
            },
            3 => Matrix4x2 {
                m11: self.m11,
                m21: self.m21,
                m31: self.m31,
                m41: val,
                m12: self.m12,
                m22: self.m22,
                m32: self.m32,
                m42: val,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// `self` with a column of `val` inserted at index `i` (`i <= 2`), a `Matrix3`. Panics with
    /// `nalgebra: index out of bounds` for `i > 2`. Upstream: `insert_column`.
    #[inline(always)]
    fn insert_column(self: Matrix3x2<T>, i: usize, val: T) -> Matrix3<T> {
        match i {
            0 => Matrix3 {
                m11: val,
                m21: val,
                m31: val,
                m12: self.m11,
                m22: self.m21,
                m32: self.m31,
                m13: self.m12,
                m23: self.m22,
                m33: self.m32,
            },
            1 => Matrix3 {
                m11: self.m11,
                m21: self.m21,
                m31: self.m31,
                m12: val,
                m22: val,
                m32: val,
                m13: self.m12,
                m23: self.m22,
                m33: self.m32,
            },
            2 => Matrix3 {
                m11: self.m11,
                m21: self.m21,
                m31: self.m31,
                m12: self.m12,
                m22: self.m22,
                m32: self.m32,
                m13: val,
                m23: val,
                m33: val,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// `self` without its row `i`, a `Matrix2`. Panics with `nalgebra: index out of bounds` for `i
    /// >= 3`. Upstream: `remove_row`.
    #[inline(always)]
    fn remove_row(self: Matrix3x2<T>, i: usize) -> Matrix2<T> {
        match i {
            0 => Matrix2 { m11: self.m21, m21: self.m31, m12: self.m22, m22: self.m32 },
            1 => Matrix2 { m11: self.m11, m21: self.m31, m12: self.m12, m22: self.m32 },
            2 => Matrix2 { m11: self.m11, m21: self.m21, m12: self.m12, m22: self.m22 },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// `self` without its column `i`, a `Vector3`. Panics with `nalgebra: index out of bounds` for
    /// `i >= 2`. Upstream: `remove_column`.
    #[inline(always)]
    fn remove_column(self: Matrix3x2<T>, i: usize) -> Vector3<T> {
        match i {
            0 => Vector3 { x: self.m12, y: self.m22, z: self.m32 },
            1 => Vector3 { x: self.m11, y: self.m21, z: self.m31 },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// The operations of `Matrix3x2<T>` that need `Transcendental` (inverse trigonometry, `exp`, `ln`):
/// a scalar may implement `Real` only.
#[generate_trait]
pub impl Matrix3x2AngleImpl<
    T,
    impl R: Real<T>,
    impl Tr: Transcendental<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix3x2AngleTrait<T> {
    /// The angle between `self` and `other` seen as vectors of the Frobenius inner product, in `[0,
    /// π]` (up to the rounding of `atan2`); `0` when one of them is zero. Computed as `2 *
    /// atan2(|u - v|, |u + v|)` on the normalized `u`, `v` (Kahan): unlike upstream's `acos(dot /
    /// (|a| *
    /// |b|))` it cannot overflow on long inputs and stays accurate for nearly parallel ones. Panics
    /// when a norm does not fit. Upstream: `angle`.
    fn angle(self: Matrix3x2<T>, other: Matrix3x2<T>) -> T {
        let n1 = Matrix3x2Trait::norm(self);
        let n2 = Matrix3x2Trait::norm(other);
        if n1 == R::zero() || n2 == R::zero() {
            return R::zero();
        }
        let u = Matrix3x2Trait::unscale(self, n1);
        let v = Matrix3x2Trait::unscale(other, n2);
        let half = Tr::atan2(Matrix3x2Trait::metric_distance(u, v), Matrix3x2Trait::norm(u + v));
        half + half
    }

    /// The entrywise Lp norm `(Σ |a|^p)^(1/p)`. `p = 1` is the exact sum of the absolute values
    /// and `p = 2` the fused `norm` (both exact up to their one rounding); above, the components
    /// are first divided by the largest absolute value `m` (so no power can overflow), `Σ (|a| /
    /// m)^p`
    /// is summed (`p` floored products each), and the root is `m * exp(ln(Σ) / p)`: a few ulp
    /// relative to the result, the rounding of `exp` / `ln`. Panics with `nalgebra: lp_norm needs p
    /// >= 1` for `p < 1` (upstream returns meaningless values: an infinite root for `p = 0`).
    /// Upstream: `lp_norm`.
    fn lp_norm(self: Matrix3x2<T>, p: i32) -> T {
        if p < 1 {
            core::panic_with_felt252(errors::LP_NORM_P);
        }
        if p == 1 {
            return R::abs(self.m11)
                + R::abs(self.m21)
                + R::abs(self.m31)
                + R::abs(self.m12)
                + R::abs(self.m22)
                + R::abs(self.m32);
        }
        if p == 2 {
            return Matrix3x2Trait::norm(self);
        }
        let m = Matrix3x2Trait::amax(self);
        if m == R::zero() {
            return R::zero();
        }
        let r = Matrix3x2Trait::unscale(Matrix3x2Trait::abs(self), m);
        let q: u32 = p.try_into().unwrap();
        let s = Powi::powi(r.m11, q)
            + Powi::powi(r.m21, q)
            + Powi::powi(r.m31, q)
            + Powi::powi(r.m12, q)
            + Powi::powi(r.m22, q)
            + Powi::powi(r.m32, q);
        m * Tr::exp(R::div(Tr::ln(s), R::from_int(p)))
    }
}

