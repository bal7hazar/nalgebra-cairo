    T, +Mul<T>, +Copy<T>, +Drop<T>,
> of MatrixKronecker<Matrix3x2<T>, Matrix1<T>> {
    type Output = Matrix3x2<T>;
    #[inline(always)]
    fn kronecker(self: Matrix3x2<T>, rhs: Matrix1<T>) -> Matrix3x2<T> {
        Matrix3x2 {
            m11: self.m11 * rhs.x,
            m21: self.m21 * rhs.x,
            m31: self.m31 * rhs.x,
            m12: self.m12 * rhs.x,
            m22: self.m22 * rhs.x,
            m32: self.m32 * rhs.x,
        }
    }
}

