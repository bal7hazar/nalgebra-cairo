    type Output = T;
    #[inline(always)]
    fn get(self: Matrix3x2<T>, index: (usize, usize)) -> Option<T> {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => Option::Some(self.m11),
                1 => Option::Some(self.m21),
                2 => Option::Some(self.m31),
