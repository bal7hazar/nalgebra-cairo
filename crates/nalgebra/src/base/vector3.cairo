        self =
            Vector3 {
                x: R::mul_add(beta, self.x, R::div(alpha * a.x, b.x)),
                y: R::mul_add(beta, self.y, R::div(alpha * a.y, b.y)),
                z: R::mul_add(beta, self.z, R::div(alpha * a.z, b.z)),
            };
