    }

    #[inline(always)]
    fn iamax_full(self: Vector3<T>) -> (usize, usize) {
        let mut best: (usize, usize) = (0, 0);
        let mut m = R::abs(self.x);
        let v = R::abs(self.y);
        if v > m {
            m = v;
            best = (1, 0);
        }
        let v = R::abs(self.z);
        if v > m {
            best = (2, 0);
        }
        best
    }

    #[inline(always)]
    fn icamax_full(self: Vector3<T>) -> (usize, usize) {
        Self::iamax_full(self)
    }

    #[inline(always)]
    fn argmin(self: Vector3<T>) -> (usize, T) {
        let mut i: usize = 0;
        let mut m = self.x;
        if self.y < m {
            m = self.y;
            i = 1;
        }
        if self.z < m {
            m = self.z;
            i = 2;
        }
        (i, m)
    }

    #[inline(always)]
    fn argmax(self: Vector3<T>) -> (usize, T) {
        let mut i: usize = 0;
        let mut m = self.x;
        if self.y > m {
            m = self.y;
            i = 1;
        }
        if self.z > m {
            m = self.z;
            i = 2;
        }
        (i, m)
    }

