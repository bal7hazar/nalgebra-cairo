    #[inline(always)]
    fn imin(self: Vector3<T>) -> usize {
        let (i, m): (usize, T) = if self.x <= self.y {
            (0, self.x)
        } else {
            (1, self.y)
        };
        if m <= self.z {
            i
        } else {
            2
        }
    }

    #[inline(always)]
    fn imax(self: Vector3<T>) -> usize {
        let (i, m): (usize, T) = if self.x >= self.y {
            (0, self.x)
        } else {
            (1, self.y)
        };
        if m >= self.z {
            i
        } else {
            2
        }
    }

