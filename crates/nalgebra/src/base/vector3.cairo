    fn cross(self: Vector3<T>, rhs: Vector3<T>) -> Vector3<T> {
        Vector3 {
            x: R::diff_prod(self.y, rhs.z, self.z, rhs.y),
            y: R::diff_prod(self.z, rhs.x, self.x, rhs.z),
            z: R::diff_prod(self.x, rhs.y, self.y, rhs.x),
