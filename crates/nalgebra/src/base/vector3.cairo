/// `self * rhs`, a `Vector3`: one floored product per component. Panics on overflow. Upstream:
/// `Vector3 * Matrix1` (`Mul`).
pub impl Vector3MulMatrix1<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>,
> of MatrixMul<Vector3<T>, Matrix1<T>> {
    type Output = Vector3<T>;
    #[inline(always)]
    fn mul_mat(self: Vector3<T>, rhs: Matrix1<T>) -> Vector3<T> {
        Vector3 { x: self.x * rhs.x, y: self.y * rhs.x, z: self.z * rhs.x }
    }
}

/// `self * rhs`, a `Matrix3x2`: one floored product per component. Panics on overflow. Upstream:
/// `Vector3 * RowVector2` (`Mul`).
pub impl Vector3MulRowVector2<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>,
> of MatrixMul<Vector3<T>, RowVector2<T>> {
    type Output = Matrix3x2<T>;
    fn mul_mat(self: Vector3<T>, rhs: RowVector2<T>) -> Matrix3x2<T> {
        Matrix3x2 {
            m11: self.x * rhs.x,
            m21: self.y * rhs.x,
            m31: self.z * rhs.x,
            m12: self.x * rhs.y,
            m22: self.y * rhs.y,
            m32: self.z * rhs.y,
        }
    }
}

/// `self * rhs`, a `Matrix3`: one floored product per component. Panics on overflow. Upstream:
/// `Vector3 * RowVector3` (`Mul`).
pub impl Vector3MulRowVector3<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>,
> of MatrixMul<Vector3<T>, RowVector3<T>> {
    type Output = Matrix3<T>;
    fn mul_mat(self: Vector3<T>, rhs: RowVector3<T>) -> Matrix3<T> {
        Matrix3 {
            m11: self.x * rhs.x,
            m21: self.y * rhs.x,
            m31: self.z * rhs.x,
            m12: self.x * rhs.y,
            m22: self.y * rhs.y,
            m32: self.z * rhs.y,
            m13: self.x * rhs.z,
            m23: self.y * rhs.z,
            m33: self.z * rhs.z,
        }
    }
}

/// `self * rhs`, a `Matrix3x4`: one floored product per component. Panics on overflow. Upstream:
/// `Vector3 * RowVector4` (`Mul`).
pub impl Vector3MulRowVector4<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>,
> of MatrixMul<Vector3<T>, RowVector4<T>> {
    type Output = Matrix3x4<T>;
    fn mul_mat(self: Vector3<T>, rhs: RowVector4<T>) -> Matrix3x4<T> {
        Matrix3x4 {
            m11: self.x * rhs.x,
            m21: self.y * rhs.x,
            m31: self.z * rhs.x,
            m12: self.x * rhs.y,
            m22: self.y * rhs.y,
            m32: self.z * rhs.y,
            m13: self.x * rhs.z,
            m23: self.y * rhs.z,
            m33: self.z * rhs.z,
            m14: self.x * rhs.w,
            m24: self.y * rhs.w,
            m34: self.z * rhs.w,
        }
    }
}

