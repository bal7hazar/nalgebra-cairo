// --- indexing, comparisons, conversions ----------------------------------------------------------

/// `m.get(i)` / `m.index(..)`: the component `index` in column-major (storage) order. `get` is
/// `None` out of bounds, `index` panics with `nalgebra: index out of bounds`. Upstream:
/// `Matrix::get` / `Matrix::index` (their `MatrixIndex` argument).
pub impl Matrix2MatrixIndexLinear<T, +Copy<T>, +Drop<T>> of MatrixIndex<Matrix2<T>, usize> {
    type Output = T;
    #[inline(always)]
    fn get(self: Matrix2<T>, index: usize) -> Option<T> {
        match index {
            0 => Option::Some(self.m11),
            1 => Option::Some(self.m21),
            2 => Option::Some(self.m12),
            3 => Option::Some(self.m22),
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: Matrix2<T>, index: usize) -> T {
        match index {
            0 => self.m11,
            1 => self.m21,
            2 => self.m12,
            3 => self.m22,
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m[i]`: the component `index` in column-major (storage) order. Panics with `nalgebra: index out
/// of bounds`. Upstream: `Index<usize>`.
pub impl Matrix2IndexLinear<T, +Copy<T>, +Drop<T>> of IndexView<Matrix2<T>, usize> {
    type Target = T;
    #[inline(always)]
    fn index(self: @Matrix2<T>, index: usize) -> T {
        match index {
            0 => *self.m11,
            1 => *self.m21,
            2 => *self.m12,
            3 => *self.m22,
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m.get((i, j))` / `m.index(..)`: the component at `(row, column)`. `get` is `None` out of
/// bounds, `index` panics with `nalgebra: index out of bounds`. Upstream: `Matrix::get` /
/// `Matrix::index` (their `MatrixIndex` argument).
pub impl Matrix2MatrixIndexPair<T, +Copy<T>, +Drop<T>> of MatrixIndex<Matrix2<T>, (usize, usize)> {
    type Output = T;
    #[inline(always)]
    fn get(self: Matrix2<T>, index: (usize, usize)) -> Option<T> {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => Option::Some(self.m11),
                1 => Option::Some(self.m21),
                _ => Option::None,
            },
            1 => match i {
                0 => Option::Some(self.m12),
                1 => Option::Some(self.m22),
                _ => Option::None,
            },
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: Matrix2<T>, index: (usize, usize)) -> T {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => self.m11,
                1 => self.m21,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            1 => match i {
                0 => self.m12,
                1 => self.m22,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m[(i, j)]`: the component at `(row, column)`. Panics with `nalgebra: index out of bounds`.
/// Upstream: `Index<(usize, usize)>`.
pub impl Matrix2IndexPair<T, +Copy<T>, +Drop<T>> of IndexView<Matrix2<T>, (usize, usize)> {
    type Target = T;
    #[inline(always)]
    fn index(self: @Matrix2<T>, index: (usize, usize)) -> T {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => *self.m11,
                1 => *self.m21,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            1 => match i {
                0 => *self.m12,
                1 => *self.m22,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// The component-wise partial order: `a < b` when EVERY component of `a` is smaller than `b`'s
/// (likewise `<=`, `>`, `>=`), so two matrices may be unordered (`!(a < b) && !(a >= b)`).
/// Upstream: `PartialOrd for Matrix`.
pub impl Matrix2PartialOrd<T, +PartialOrd<T>, +Copy<T>, +Drop<T>> of PartialOrd<Matrix2<T>> {
    #[inline(always)]
    fn lt(lhs: Matrix2<T>, rhs: Matrix2<T>) -> bool {
        lhs.m11 < rhs.m11 && lhs.m21 < rhs.m21 && lhs.m12 < rhs.m12 && lhs.m22 < rhs.m22
    }
    #[inline(always)]
    fn le(lhs: Matrix2<T>, rhs: Matrix2<T>) -> bool {
        lhs.m11 <= rhs.m11 && lhs.m21 <= rhs.m21 && lhs.m12 <= rhs.m12 && lhs.m22 <= rhs.m22
    }
    #[inline(always)]
    fn gt(lhs: Matrix2<T>, rhs: Matrix2<T>) -> bool {
        lhs.m11 > rhs.m11 && lhs.m21 > rhs.m21 && lhs.m12 > rhs.m12 && lhs.m22 > rhs.m22
    }
    #[inline(always)]
    fn ge(lhs: Matrix2<T>, rhs: Matrix2<T>) -> bool {
        lhs.m11 >= rhs.m11 && lhs.m21 >= rhs.m21 && lhs.m12 >= rhs.m12 && lhs.m22 >= rhs.m22
    }
}

/// The component-wise bounds: every component `Bounded::<T>::MIN` / `MAX`. Upstream: `num::Bounded
/// for Matrix`.
pub impl Matrix2Bounded<T, +Bounded<T>, +Drop<T>> of Bounded<Matrix2<T>> {
    const MIN: Matrix2<T> = Matrix2 {
        m11: Bounded::<T>::MIN,
        m21: Bounded::<T>::MIN,
        m12: Bounded::<T>::MIN,
        m22: Bounded::<T>::MIN,
    };
    const MAX: Matrix2<T> = Matrix2 {
        m11: Bounded::<T>::MAX,
        m21: Bounded::<T>::MAX,
        m12: Bounded::<T>::MAX,
        m22: Bounded::<T>::MAX,
    };
}

/// The multiplicative identity (`identity()`), exactly. Upstream: `num::One for SquareMatrix`.
pub impl Matrix2One<T, impl R: Real<T>, +PartialEq<T>, +Copy<T>, +Drop<T>> of One<Matrix2<T>> {
    #[inline(always)]
    fn one() -> Matrix2<T> {
        Matrix2 { m11: R::one(), m21: R::zero(), m12: R::zero(), m22: R::one() }
    }
    #[inline(always)]
    fn is_one(self: @Matrix2<T>) -> bool {
        *self.m11 == R::one()
            && *self.m21 == R::zero()
            && *self.m12 == R::zero()
            && *self.m22 == R::one()
    }
    #[inline(always)]
    fn is_non_one(self: @Matrix2<T>) -> bool {
        !Self::is_one(self)
    }
}

/// The 2x2 matrix of the given COLUMNS (`[[m11, m21, ..], [m12, ..], ..]`). Upstream: `From<[[T;
/// R]; C]>`.
pub impl Matrix2FromColumnArrays<T, +Drop<T>> of Into<[[T; 2]; 2], Matrix2<T>> {
    #[inline(always)]
    fn into(self: [[T; 2]; 2]) -> Matrix2<T> {
        let [c0, c1] = self;
        let [m11, m21] = c0;
        let [m12, m22] = c1;
        Matrix2 { m11, m21, m12, m22 }
    }
}

/// The columns of the 2x2 matrix as nested arrays (`[[m11, m21, ..], [m12, ..], ..]`). Upstream:
/// `Into<[[T; R]; C]>`.
