/// The operations of `Matrix5x6<T>` that need `Transcendental` (inverse trigonometry, `exp`, `ln`):
/// a scalar may implement `Real` only.
#[generate_trait]
pub impl Matrix5x6AngleImpl<
    T,
    impl R: Real<T>,
    impl Tr: Transcendental<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5x6AngleTrait<T> {
    /// The angle between `self` and `other` seen as vectors of the Frobenius inner product, in `[0,
    /// π]` (up to the rounding of `atan2`); `0` when one of them is zero. Computed as `2 *
    /// atan2(|u - v|, |u + v|)` on the normalized `u`, `v` (Kahan): unlike upstream's `acos(dot /
    /// (|a| *
    /// |b|))` it cannot overflow on long inputs and stays accurate for nearly parallel ones. Panics
    /// when a norm does not fit. Upstream: `angle`.
    fn angle(self: Matrix5x6<T>, other: Matrix5x6<T>) -> T {
        let n1 = Matrix5x6Trait::norm(self);
        let n2 = Matrix5x6Trait::norm(other);
        if n1 == R::zero() || n2 == R::zero() {
            return R::zero();
        }
        let u = Matrix5x6Trait::unscale(self, n1);
        let v = Matrix5x6Trait::unscale(other, n2);
        let half = Tr::atan2(Matrix5x6Trait::metric_distance(u, v), Matrix5x6Trait::norm(u + v));
        half + half
    }

    /// The entrywise Lp norm `(Σ |a|^p)^(1/p)`. `p = 1` is the exact sum of the absolute values
    /// and `p = 2` the fused `norm` (both exact up to their one rounding); above, the components
    /// are first divided by the largest absolute value `m` (so no power can overflow), `Σ (|a| /
    /// m)^p`
    /// is summed (`p` floored products each), and the root is `m * exp(ln(Σ) / p)`: a few ulp
    /// relative to the result, the rounding of `exp` / `ln`. Panics with `nalgebra: lp_norm needs p
    /// >= 1` for `p < 1` (upstream returns meaningless values: an infinite root for `p = 0`).
    /// Upstream: `lp_norm`.
    fn lp_norm(self: Matrix5x6<T>, p: i32) -> T {
        if p < 1 {
            core::panic_with_felt252(errors::LP_NORM_P);
        }
        if p == 1 {
            return R::abs(self.m11)
                + R::abs(self.m21)
                + R::abs(self.m31)
                + R::abs(self.m41)
                + R::abs(self.m51)
                + R::abs(self.m12)
                + R::abs(self.m22)
                + R::abs(self.m32)
                + R::abs(self.m42)
                + R::abs(self.m52)
                + R::abs(self.m13)
                + R::abs(self.m23)
                + R::abs(self.m33)
                + R::abs(self.m43)
                + R::abs(self.m53)
                + R::abs(self.m14)
                + R::abs(self.m24)
                + R::abs(self.m34)
                + R::abs(self.m44)
                + R::abs(self.m54)
                + R::abs(self.m15)
                + R::abs(self.m25)
                + R::abs(self.m35)
                + R::abs(self.m45)
                + R::abs(self.m55)
                + R::abs(self.m16)
                + R::abs(self.m26)
                + R::abs(self.m36)
                + R::abs(self.m46)
                + R::abs(self.m56);
        }
        if p == 2 {
            return Matrix5x6Trait::norm(self);
        }
        let m = Matrix5x6Trait::amax(self);
        if m == R::zero() {
            return R::zero();
        }
        let r = Matrix5x6Trait::unscale(Matrix5x6Trait::abs(self), m);
        let q: u32 = p.try_into().unwrap();
        let s = Powi::powi(r.m11, q)
            + Powi::powi(r.m21, q)
            + Powi::powi(r.m31, q)
            + Powi::powi(r.m41, q)
            + Powi::powi(r.m51, q)
            + Powi::powi(r.m12, q)
            + Powi::powi(r.m22, q)
            + Powi::powi(r.m32, q)
            + Powi::powi(r.m42, q)
            + Powi::powi(r.m52, q)
            + Powi::powi(r.m13, q)
            + Powi::powi(r.m23, q)
            + Powi::powi(r.m33, q)
            + Powi::powi(r.m43, q)
            + Powi::powi(r.m53, q)
            + Powi::powi(r.m14, q)
            + Powi::powi(r.m24, q)
            + Powi::powi(r.m34, q)
            + Powi::powi(r.m44, q)
            + Powi::powi(r.m54, q)
            + Powi::powi(r.m15, q)
            + Powi::powi(r.m25, q)
            + Powi::powi(r.m35, q)
            + Powi::powi(r.m45, q)
            + Powi::powi(r.m55, q)
            + Powi::powi(r.m16, q)
            + Powi::powi(r.m26, q)
            + Powi::powi(r.m36, q)
            + Powi::powi(r.m46, q)
            + Powi::powi(r.m56, q);
        m * Tr::exp(R::div(Tr::ln(s), R::from_int(p)))
    }
}

