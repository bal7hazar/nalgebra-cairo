    #[inline(always)]
    fn component_mul_mut(ref self: Matrix5x6<T>, rhs: Matrix5x6<T>) {
        Self::component_mul_assign(ref self, rhs);
    }

    /// Alias of `component_div_assign` (deprecated upstream). Upstream: `component_div_mut`.
    #[inline(always)]
    fn component_div_mut(ref self: Matrix5x6<T>, rhs: Matrix5x6<T>) {
