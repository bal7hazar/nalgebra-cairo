    #[inline(always)]
    fn conjugate_mut(ref self: Matrix5x6<T>) {
        self = Self::conjugate(self);
    }

    /// Writes the transpose of `self` into `out`, a `Matrix6x5`. Exact. Upstream: `transpose_to`.
    #[inline(always)]
    fn transpose_to(self: Matrix5x6<T>, ref out: Matrix6x5<T>) {
        out = Self::transpose(self);
