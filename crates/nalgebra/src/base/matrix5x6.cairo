    /// Replaces the first `min(diag.len(), 5)` diagonal components by the values of `diag` (the
    /// extra values are ignored, like upstream's `take`), the others unchanged. Upstream:
    /// `set_partial_diagonal` (an iterator; a `Span` here).
    fn set_partial_diagonal(ref self: Matrix5x6<T>, diag: Span<T>) {
        let len = diag.len();
        self =
            Matrix5x6 {
                m11: if len > 0 {
                    *diag[0]
                } else {
                    self.m11
                },
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m51: self.m51,
                m12: self.m12,
                m22: if len > 1 {
                    *diag[1]
                } else {
                    self.m22
                },
                m32: self.m32,
                m42: self.m42,
                m52: self.m52,
                m13: self.m13,
                m23: self.m23,
                m33: if len > 2 {
                    *diag[2]
                } else {
                    self.m33
                },
                m43: self.m43,
                m53: self.m53,
                m14: self.m14,
                m24: self.m24,
                m34: self.m34,
                m44: if len > 3 {
                    *diag[3]
                } else {
                    self.m44
                },
                m54: self.m54,
                m15: self.m15,
                m25: self.m25,
                m35: self.m35,
                m45: self.m45,
                m55: if len > 4 {
