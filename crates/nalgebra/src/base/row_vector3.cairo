/// The component-wise partial order: `a < b` when EVERY component of `a` is smaller than `b`'s
/// (likewise `<=`, `>`, `>=`), so two matrices may be unordered (`!(a < b) && !(a >= b)`).
/// Upstream: `PartialOrd for Matrix`.
pub impl RowVector3PartialOrd<T, +PartialOrd<T>, +Copy<T>, +Drop<T>> of PartialOrd<RowVector3<T>> {
    #[inline(always)]
    fn lt(lhs: RowVector3<T>, rhs: RowVector3<T>) -> bool {
        lhs.x < rhs.x && lhs.y < rhs.y && lhs.z < rhs.z
    }
    #[inline(always)]
    fn le(lhs: RowVector3<T>, rhs: RowVector3<T>) -> bool {
        lhs.x <= rhs.x && lhs.y <= rhs.y && lhs.z <= rhs.z
    }
    #[inline(always)]
    fn gt(lhs: RowVector3<T>, rhs: RowVector3<T>) -> bool {
        lhs.x > rhs.x && lhs.y > rhs.y && lhs.z > rhs.z
    }
    #[inline(always)]
    fn ge(lhs: RowVector3<T>, rhs: RowVector3<T>) -> bool {
        lhs.x >= rhs.x && lhs.y >= rhs.y && lhs.z >= rhs.z
    }
}

/// The component-wise bounds: every component `Bounded::<T>::MIN` / `MAX`. Upstream: `num::Bounded
/// for Matrix`.
pub impl RowVector3Bounded<T, +Bounded<T>, +Drop<T>> of Bounded<RowVector3<T>> {
    const MIN: RowVector3<T> = RowVector3 {
        x: Bounded::<T>::MIN, y: Bounded::<T>::MIN, z: Bounded::<T>::MIN,
    };
    const MAX: RowVector3<T> = RowVector3 {
        x: Bounded::<T>::MAX, y: Bounded::<T>::MAX, z: Bounded::<T>::MAX,
    };
}

