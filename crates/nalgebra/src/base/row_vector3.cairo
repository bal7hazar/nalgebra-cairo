// --- indexing, comparisons, conversions ----------------------------------------------------------

/// `m.get(i)` / `m.index(..)`: the component `index` in column-major (storage) order. `get` is
/// `None` out of bounds, `index` panics with `nalgebra: index out of bounds`. Upstream:
/// `Matrix::get` / `Matrix::index` (their `MatrixIndex` argument).
pub impl RowVector3MatrixIndexLinear<T, +Copy<T>, +Drop<T>> of MatrixIndex<RowVector3<T>, usize> {
    type Output = T;
    #[inline(always)]
    fn get(self: RowVector3<T>, index: usize) -> Option<T> {
        match index {
            0 => Option::Some(self.x),
            1 => Option::Some(self.y),
            2 => Option::Some(self.z),
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: RowVector3<T>, index: usize) -> T {
        match index {
            0 => self.x,
            1 => self.y,
            2 => self.z,
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m[i]`: the component `index` in column-major (storage) order. Panics with `nalgebra: index out
/// of bounds`. Upstream: `Index<usize>`.
pub impl RowVector3IndexLinear<T, +Copy<T>, +Drop<T>> of IndexView<RowVector3<T>, usize> {
    type Target = T;
    #[inline(always)]
    fn index(self: @RowVector3<T>, index: usize) -> T {
        match index {
            0 => *self.x,
            1 => *self.y,
            2 => *self.z,
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m.get((i, j))` / `m.index(..)`: the component at `(row, column)`. `get` is `None` out of
/// bounds, `index` panics with `nalgebra: index out of bounds`. Upstream: `Matrix::get` /
/// `Matrix::index` (their `MatrixIndex` argument).
pub impl RowVector3MatrixIndexPair<
    T, +Copy<T>, +Drop<T>,
> of MatrixIndex<RowVector3<T>, (usize, usize)> {
    type Output = T;
    #[inline(always)]
    fn get(self: RowVector3<T>, index: (usize, usize)) -> Option<T> {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => Option::Some(self.x),
                _ => Option::None,
            },
            1 => match i {
                0 => Option::Some(self.y),
                _ => Option::None,
            },
            2 => match i {
                0 => Option::Some(self.z),
                _ => Option::None,
            },
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: RowVector3<T>, index: (usize, usize)) -> T {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => self.x,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            1 => match i {
                0 => self.y,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            2 => match i {
                0 => self.z,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

