        T2,
        T3,
        +Copy<T2>,
        +Drop<T2>,
        +Copy<T3>,
        +Drop<T3>,
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (T, T2, T3)>,
        +Into<Func::Output, T>,
