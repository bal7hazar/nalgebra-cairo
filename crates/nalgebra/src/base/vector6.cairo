/// Private helpers of the `swap*` methods (runtime positions: one `match` each).
#[generate_trait]
impl Vector6EditImpl<T, +Copy<T>, +Drop<T>> of Vector6EditTrait<T> {
    /// `self` with the component at `index` (`(row, column)`) replaced by `v`; panics out of
    /// bounds.
    #[inline(always)]
    fn replace(self: Vector6<T>, index: (usize, usize), v: T) -> Vector6<T> {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => Vector6 { x: v, y: self.y, z: self.z, w: self.w, a: self.a, b: self.b },
                1 => Vector6 { x: self.x, y: v, z: self.z, w: self.w, a: self.a, b: self.b },
                2 => Vector6 { x: self.x, y: self.y, z: v, w: self.w, a: self.a, b: self.b },
                3 => Vector6 { x: self.x, y: self.y, z: self.z, w: v, a: self.a, b: self.b },
                4 => Vector6 { x: self.x, y: self.y, z: self.z, w: self.w, a: v, b: self.b },
                5 => Vector6 { x: self.x, y: self.y, z: self.z, w: self.w, a: self.a, b: v },
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// Row `i`, a `Matrix1`; panics out of bounds.
    #[inline(always)]
    fn row_at(self: Vector6<T>, i: usize) -> Matrix1<T> {
        match i {
            0 => Matrix1 { x: self.x },
            1 => Matrix1 { x: self.y },
            2 => Matrix1 { x: self.z },
            3 => Matrix1 { x: self.w },
            4 => Matrix1 { x: self.a },
            5 => Matrix1 { x: self.b },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// Column `j`, a `Vector6`; panics out of bounds.
    #[inline(always)]
    fn column_at(self: Vector6<T>, j: usize) -> Vector6<T> {
        match j {
            0 => Vector6 { x: self.x, y: self.y, z: self.z, w: self.w, a: self.a, b: self.b },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

