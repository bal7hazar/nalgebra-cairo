    #[inline(always)]
    fn nonzero_diagonal(self: Matrix4<T>) -> bool {
        self.m11 != R::zero()
            && self.m22 != R::zero()
            && self.m33 != R::zero()
            && self.m44 != R::zero()
    }

    #[inline(always)]
