/// `m.get(i)` / `m.index(..)`: the component `index` in column-major (storage) order. `get` is
/// `None` out of bounds, `index` panics with `nalgebra: index out of bounds`. Upstream:
/// `Matrix::get` / `Matrix::index` (their `MatrixIndex` argument).
pub impl Matrix2x3MatrixIndexLinear<T, +Copy<T>, +Drop<T>> of MatrixIndex<Matrix2x3<T>, usize> {
    type Output = T;
    #[inline(always)]
    fn get(self: Matrix2x3<T>, index: usize) -> Option<T> {
        match index {
            0 => Option::Some(self.m11),
            1 => Option::Some(self.m21),
            2 => Option::Some(self.m12),
            3 => Option::Some(self.m22),
            4 => Option::Some(self.m13),
            5 => Option::Some(self.m23),
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: Matrix2x3<T>, index: usize) -> T {
        match index {
            0 => self.m11,
            1 => self.m21,
            2 => self.m12,
            3 => self.m22,
            4 => self.m13,
            5 => self.m23,
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m[i]`: the component `index` in column-major (storage) order. Panics with `nalgebra: index out
/// of bounds`. Upstream: `Index<usize>`.
pub impl Matrix2x3IndexLinear<T, +Copy<T>, +Drop<T>> of IndexView<Matrix2x3<T>, usize> {
    type Target = T;
    #[inline(always)]
    fn index(self: @Matrix2x3<T>, index: usize) -> T {
        match index {
            0 => *self.m11,
            1 => *self.m21,
            2 => *self.m12,
            3 => *self.m22,
            4 => *self.m13,
            5 => *self.m23,
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m.get((i, j))` / `m.index(..)`: the component at `(row, column)`. `get` is `None` out of
/// bounds, `index` panics with `nalgebra: index out of bounds`. Upstream: `Matrix::get` /
/// `Matrix::index` (their `MatrixIndex` argument).
pub impl Matrix2x3MatrixIndexPair<
    T, +Copy<T>, +Drop<T>,
> of MatrixIndex<Matrix2x3<T>, (usize, usize)> {
    type Output = T;
    #[inline(always)]
    fn get(self: Matrix2x3<T>, index: (usize, usize)) -> Option<T> {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => Option::Some(self.m11),
                1 => Option::Some(self.m21),
                _ => Option::None,
            },
            1 => match i {
                0 => Option::Some(self.m12),
                1 => Option::Some(self.m22),
                _ => Option::None,
            },
            2 => match i {
                0 => Option::Some(self.m13),
                1 => Option::Some(self.m23),
                _ => Option::None,
            },
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: Matrix2x3<T>, index: (usize, usize)) -> T {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => self.m11,
                1 => self.m21,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            1 => match i {
                0 => self.m12,
                1 => self.m22,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            2 => match i {
                0 => self.m13,
                1 => self.m23,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

