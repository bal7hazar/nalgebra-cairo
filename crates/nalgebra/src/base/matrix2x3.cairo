// --- indexing, comparisons, conversions ----------------------------------------------------------

/// `m.get(i)` / `m.index(..)`: the component `index` in column-major (storage) order. `get` is
/// `None` out of bounds, `index` panics with `nalgebra: index out of bounds`. Upstream:
/// `Matrix::get` / `Matrix::index` (their `MatrixIndex` argument).
pub impl Matrix2x3MatrixIndexLinear<T, +Copy<T>, +Drop<T>> of MatrixIndex<Matrix2x3<T>, usize> {
    type Output = T;
    #[inline(always)]
    fn get(self: Matrix2x3<T>, index: usize) -> Option<T> {
        match index {
            0 => Option::Some(self.m11),
            1 => Option::Some(self.m21),
            2 => Option::Some(self.m12),
            3 => Option::Some(self.m22),
            4 => Option::Some(self.m13),
            5 => Option::Some(self.m23),
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: Matrix2x3<T>, index: usize) -> T {
        match index {
            0 => self.m11,
            1 => self.m21,
            2 => self.m12,
            3 => self.m22,
            4 => self.m13,
            5 => self.m23,
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m[i]`: the component `index` in column-major (storage) order. Panics with `nalgebra: index out
/// of bounds`. Upstream: `Index<usize>`.
pub impl Matrix2x3IndexLinear<T, +Copy<T>, +Drop<T>> of IndexView<Matrix2x3<T>, usize> {
    type Target = T;
    #[inline(always)]
    fn index(self: @Matrix2x3<T>, index: usize) -> T {
        match index {
            0 => *self.m11,
            1 => *self.m21,
            2 => *self.m12,
            3 => *self.m22,
            4 => *self.m13,
            5 => *self.m23,
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m.get((i, j))` / `m.index(..)`: the component at `(row, column)`. `get` is `None` out of
/// bounds, `index` panics with `nalgebra: index out of bounds`. Upstream: `Matrix::get` /
/// `Matrix::index` (their `MatrixIndex` argument).
pub impl Matrix2x3MatrixIndexPair<
    T, +Copy<T>, +Drop<T>,
> of MatrixIndex<Matrix2x3<T>, (usize, usize)> {
    type Output = T;
    #[inline(always)]
    fn get(self: Matrix2x3<T>, index: (usize, usize)) -> Option<T> {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => Option::Some(self.m11),
                1 => Option::Some(self.m21),
                _ => Option::None,
            },
            1 => match i {
                0 => Option::Some(self.m12),
                1 => Option::Some(self.m22),
                _ => Option::None,
            },
            2 => match i {
                0 => Option::Some(self.m13),
                1 => Option::Some(self.m23),
                _ => Option::None,
            },
            _ => Option::None,
        }
    }
    #[inline(always)]
    fn index(self: Matrix2x3<T>, index: (usize, usize)) -> T {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => self.m11,
                1 => self.m21,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            1 => match i {
                0 => self.m12,
                1 => self.m22,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            2 => match i {
                0 => self.m13,
                1 => self.m23,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// `m[(i, j)]`: the component at `(row, column)`. Panics with `nalgebra: index out of bounds`.
/// Upstream: `Index<(usize, usize)>`.
pub impl Matrix2x3IndexPair<T, +Copy<T>, +Drop<T>> of IndexView<Matrix2x3<T>, (usize, usize)> {
    type Target = T;
    #[inline(always)]
    fn index(self: @Matrix2x3<T>, index: (usize, usize)) -> T {
        let (i, j) = index;
        match j {
            0 => match i {
                0 => *self.m11,
                1 => *self.m21,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            1 => match i {
                0 => *self.m12,
                1 => *self.m22,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            2 => match i {
                0 => *self.m13,
                1 => *self.m23,
                _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// The component-wise partial order: `a < b` when EVERY component of `a` is smaller than `b`'s
/// (likewise `<=`, `>`, `>=`), so two matrices may be unordered (`!(a < b) && !(a >= b)`).
/// Upstream: `PartialOrd for Matrix`.
pub impl Matrix2x3PartialOrd<T, +PartialOrd<T>, +Copy<T>, +Drop<T>> of PartialOrd<Matrix2x3<T>> {
    #[inline(always)]
    fn lt(lhs: Matrix2x3<T>, rhs: Matrix2x3<T>) -> bool {
        lhs.m11 < rhs.m11
            && lhs.m21 < rhs.m21
            && lhs.m12 < rhs.m12
            && lhs.m22 < rhs.m22
            && lhs.m13 < rhs.m13
            && lhs.m23 < rhs.m23
    }
    #[inline(always)]
    fn le(lhs: Matrix2x3<T>, rhs: Matrix2x3<T>) -> bool {
        lhs.m11 <= rhs.m11
            && lhs.m21 <= rhs.m21
            && lhs.m12 <= rhs.m12
            && lhs.m22 <= rhs.m22
            && lhs.m13 <= rhs.m13
            && lhs.m23 <= rhs.m23
    }
    #[inline(always)]
    fn gt(lhs: Matrix2x3<T>, rhs: Matrix2x3<T>) -> bool {
        lhs.m11 > rhs.m11
            && lhs.m21 > rhs.m21
            && lhs.m12 > rhs.m12
            && lhs.m22 > rhs.m22
            && lhs.m13 > rhs.m13
            && lhs.m23 > rhs.m23
    }
    #[inline(always)]
    fn ge(lhs: Matrix2x3<T>, rhs: Matrix2x3<T>) -> bool {
        lhs.m11 >= rhs.m11
            && lhs.m21 >= rhs.m21
            && lhs.m12 >= rhs.m12
            && lhs.m22 >= rhs.m22
            && lhs.m13 >= rhs.m13
            && lhs.m23 >= rhs.m23
    }
}

/// The component-wise bounds: every component `Bounded::<T>::MIN` / `MAX`. Upstream: `num::Bounded
/// for Matrix`.
pub impl Matrix2x3Bounded<T, +Bounded<T>, +Drop<T>> of Bounded<Matrix2x3<T>> {
    const MIN: Matrix2x3<T> = Matrix2x3 {
        m11: Bounded::<T>::MIN,
        m21: Bounded::<T>::MIN,
        m12: Bounded::<T>::MIN,
        m22: Bounded::<T>::MIN,
        m13: Bounded::<T>::MIN,
        m23: Bounded::<T>::MIN,
    };
    const MAX: Matrix2x3<T> = Matrix2x3 {
        m11: Bounded::<T>::MAX,
        m21: Bounded::<T>::MAX,
        m12: Bounded::<T>::MAX,
        m22: Bounded::<T>::MAX,
        m13: Bounded::<T>::MAX,
        m23: Bounded::<T>::MAX,
    };
}

/// The 2x3 matrix of the given COLUMNS (`[[m11, m21, ..], [m12, ..], ..]`). Upstream: `From<[[T;
/// R]; C]>`.
pub impl Matrix2x3FromColumnArrays<T, +Drop<T>> of Into<[[T; 2]; 3], Matrix2x3<T>> {
    #[inline(always)]
    fn into(self: [[T; 2]; 3]) -> Matrix2x3<T> {
        let [c0, c1, c2] = self;
        let [m11, m21] = c0;
        let [m12, m22] = c1;
        let [m13, m23] = c2;
        Matrix2x3 { m11, m21, m12, m22, m13, m23 }
    }
}

/// The columns of the 2x3 matrix as nested arrays (`[[m11, m21, ..], [m12, ..], ..]`). Upstream:
/// `Into<[[T; R]; C]>`.
pub impl Matrix2x3IntoColumnArrays<T, +Drop<T>> of Into<Matrix2x3<T>, [[T; 2]; 3]> {
    #[inline(always)]
    fn into(self: Matrix2x3<T>) -> [[T; 2]; 3] {
        let Matrix2x3 { m11, m21, m12, m22, m13, m23 } = self;
        [[m11, m21], [m12, m22], [m13, m23]]
    }
}

/// `self *= k` for a scalar `k`: `scale` in place, each component floored once. Panics on overflow.
/// Upstream: `MulAssign<T>`.
pub impl Matrix2x3MulAssignScalar<T, +Mul<T>, +Copy<T>, +Drop<T>> of MulAssign<Matrix2x3<T>, T> {
    #[inline(always)]
    fn mul_assign(ref self: Matrix2x3<T>, rhs: T) {
        self =
            Matrix2x3 {
                m11: self.m11 * rhs,
                m21: self.m21 * rhs,
                m12: self.m12 * rhs,
                m22: self.m22 * rhs,
                m13: self.m13 * rhs,
                m23: self.m23 * rhs,
            };
    }
}

/// `self /= k` for a scalar `k`: `unscale` in place, each component correctly rounded. Panics on a
/// zero `k` and on overflow. Upstream: `DivAssign<T>`.
pub impl Matrix2x3DivAssignScalar<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>,
> of DivAssign<Matrix2x3<T>, T> {
    #[inline(always)]
    fn div_assign(ref self: Matrix2x3<T>, rhs: T) {
        let (m11, m21, m12, m22, m13, m23) = R::div6(
            self.m11, self.m21, self.m12, self.m22, self.m13, self.m23, rhs,
        );
        self = Matrix2x3 { m11, m21, m12, m22, m13, m23 };
    }
}

/// `self * r`, a `Matrix2x3`: the product with the rotation matrix of `r`, each component one fused
/// `sum_prod3` (floored once). Panics on overflow. Upstream: `Mul<Rotation3> for Matrix` (`m * r`).
pub impl Matrix2x3MulRotation3<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>,
> of MatrixMul<Matrix2x3<T>, Rotation3<T>> {
    type Output = Matrix2x3<T>;

    fn mul_mat(self: Matrix2x3<T>, rhs: Rotation3<T>) -> Matrix2x3<T> {
        Matrix2x3 {
            m11: R::sum_prod3(
                self.m11, rhs.matrix.m11, self.m12, rhs.matrix.m21, self.m13, rhs.matrix.m31,
            ),
            m21: R::sum_prod3(
                self.m21, rhs.matrix.m11, self.m22, rhs.matrix.m21, self.m23, rhs.matrix.m31,
            ),
            m12: R::sum_prod3(
                self.m11, rhs.matrix.m12, self.m12, rhs.matrix.m22, self.m13, rhs.matrix.m32,
            ),
            m22: R::sum_prod3(
                self.m21, rhs.matrix.m12, self.m22, rhs.matrix.m22, self.m23, rhs.matrix.m32,
            ),
            m13: R::sum_prod3(
                self.m11, rhs.matrix.m13, self.m12, rhs.matrix.m23, self.m13, rhs.matrix.m33,
            ),
            m23: R::sum_prod3(
                self.m21, rhs.matrix.m13, self.m22, rhs.matrix.m23, self.m23, rhs.matrix.m33,
            ),
        }
    }
}

/// `self * p`, a `Point2`: the linear map applied to the coordinates of `p`, each coordinate one
/// fused `sum_prod3` (floored once). Panics on overflow. Upstream: `Mul<Point> for Matrix` (`m *
/// p`).
pub impl Matrix2x3MulPoint<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>,
> of MatrixMul<Matrix2x3<T>, Point3<T>> {
    type Output = Point2<T>;
    #[inline(always)]
    fn mul_mat(self: Matrix2x3<T>, rhs: Point3<T>) -> Point2<T> {
        Point2 {
            x: R::sum_prod3(self.m11, rhs.x, self.m12, rhs.y, self.m13, rhs.z),
            y: R::sum_prod3(self.m21, rhs.x, self.m22, rhs.y, self.m23, rhs.z),
        }
    }
}
