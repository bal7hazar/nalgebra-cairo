> of MatrixTrMul<Matrix2x3<T>, Matrix2x3<T>> {
    type Output = Matrix3<T>;
    #[inline(always)]
    fn tr_mul(self: Matrix2x3<T>, rhs: Matrix2x3<T>) -> Matrix3<T> {
        MatrixMul::mul_mat(
            Matrix3x2 {
                m11: self.m11,
                m21: self.m12,
                m31: self.m13,
                m12: self.m21,
                m22: self.m22,
                m32: self.m23,
            },
            rhs,
        )
    }
}

