                m31: self.m31,
                m41: self.m51,
                m51: self.m61,
                m12: self.m12,
                m22: self.m22,
                m32: self.m32,
                m42: self.m52,
                m52: self.m62,
            },
            4 => Matrix5x2 {
                m11: self.m11,
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m51: self.m61,
                m12: self.m12,
                m22: self.m22,
                m32: self.m32,
                m42: self.m42,
                m52: self.m62,
            },
            5 => Matrix5x2 {
