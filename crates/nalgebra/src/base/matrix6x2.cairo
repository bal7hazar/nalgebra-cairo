    /// Upstream: `set_diagonal`.
    #[inline(always)]
    fn set_diagonal(ref self: Matrix6x2<T>, diag: Vector2<T>) {
        self =
            Matrix6x2 {
                m11: diag.x,
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m51: self.m51,
                m61: self.m61,
