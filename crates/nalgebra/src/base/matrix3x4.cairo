    fn tr_mul(self: Matrix3x4<T>, rhs: Matrix3x5<T>) -> Matrix4x5<T> {
        MatrixMul::mul_mat(
            Matrix4x3 {
                m11: self.m11,
                m21: self.m12,
                m31: self.m13,
                m41: self.m14,
                m12: self.m21,
                m22: self.m22,
                m32: self.m23,
                m42: self.m24,
                m13: self.m31,
                m23: self.m32,
                m33: self.m33,
                m43: self.m34,
            },
            rhs,
        )
    }
}

