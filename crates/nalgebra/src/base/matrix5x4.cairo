/// The 5x4 matrix of the given COLUMNS (`[[m11, m21, ..], [m12, ..], ..]`). Upstream: `From<[[T;
/// R]; C]>`.
pub impl Matrix5x4FromColumnArrays<T, +Drop<T>> of Into<[[T; 5]; 4], Matrix5x4<T>> {
    #[inline(always)]
    fn into(self: [[T; 5]; 4]) -> Matrix5x4<T> {
        let [c0, c1, c2, c3] = self;
        let [m11, m21, m31, m41, m51] = c0;
        let [m12, m22, m32, m42, m52] = c1;
        let [m13, m23, m33, m43, m53] = c2;
        let [m14, m24, m34, m44, m54] = c3;
        Matrix5x4 {
            m11,
            m21,
            m31,
            m41,
            m51,
            m12,
            m22,
            m32,
            m42,
            m52,
            m13,
            m23,
            m33,
            m43,
            m53,
            m14,
            m24,
            m34,
            m44,
            m54,
        }
    }
}

/// The columns of the 5x4 matrix as nested arrays (`[[m11, m21, ..], [m12, ..], ..]`). Upstream:
/// `Into<[[T; R]; C]>`.
pub impl Matrix5x4IntoColumnArrays<T, +Drop<T>> of Into<Matrix5x4<T>, [[T; 5]; 4]> {
    #[inline(always)]
    fn into(self: Matrix5x4<T>) -> [[T; 5]; 4] {
        let Matrix5x4 {
            m11,
            m21,
            m31,
            m41,
            m51,
            m12,
            m22,
            m32,
            m42,
            m52,
            m13,
            m23,
            m33,
            m43,
            m53,
            m14,
            m24,
            m34,
            m44,
            m54,
        } = self;
        [
            [m11, m21, m31, m41, m51], [m12, m22, m32, m42, m52], [m13, m23, m33, m43, m53],
            [m14, m24, m34, m44, m54],
        ]
    }
}

/// `self *= k` for a scalar `k`: `scale` in place, each component floored once. Panics on overflow.
/// Upstream: `MulAssign<T>`.
pub impl Matrix5x4MulAssignScalar<T, +Mul<T>, +Copy<T>, +Drop<T>> of MulAssign<Matrix5x4<T>, T> {
    #[inline(always)]
    fn mul_assign(ref self: Matrix5x4<T>, rhs: T) {
        self =
            Matrix5x4 {
                m11: self.m11 * rhs,
                m21: self.m21 * rhs,
                m31: self.m31 * rhs,
                m41: self.m41 * rhs,
                m51: self.m51 * rhs,
                m12: self.m12 * rhs,
                m22: self.m22 * rhs,
                m32: self.m32 * rhs,
                m42: self.m42 * rhs,
                m52: self.m52 * rhs,
                m13: self.m13 * rhs,
                m23: self.m23 * rhs,
                m33: self.m33 * rhs,
                m43: self.m43 * rhs,
                m53: self.m53 * rhs,
                m14: self.m14 * rhs,
                m24: self.m24 * rhs,
                m34: self.m34 * rhs,
                m44: self.m44 * rhs,
                m54: self.m54 * rhs,
            };
    }
}

/// `self /= k` for a scalar `k`: `unscale` in place, each component correctly rounded. Panics on a
/// zero `k` and on overflow. Upstream: `DivAssign<T>`.
pub impl Matrix5x4DivAssignScalar<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>,
> of DivAssign<Matrix5x4<T>, T> {
    fn div_assign(ref self: Matrix5x4<T>, rhs: T) {
        let (m11, m21, m31, m41, m51, m12, m22, m32, m42, m52, m13, m23, m33, m43, m53, m14) =
            R::div16(
            self.m11,
            self.m21,
            self.m31,
            self.m41,
            self.m51,
            self.m12,
            self.m22,
            self.m32,
            self.m42,
            self.m52,
            self.m13,
            self.m23,
            self.m33,
            self.m43,
            self.m53,
            self.m14,
            rhs,
        );
        let (m24, m34, m44, m54) = R::div4(self.m24, self.m34, self.m44, self.m54, rhs);
        self =
            Matrix5x4 {
                m11,
                m21,
                m31,
                m41,
                m51,
                m12,
                m22,
                m32,
                m42,
                m52,
                m13,
                m23,
                m33,
                m43,
                m53,
                m14,
                m24,
                m34,
                m44,
                m54,
            };
    }
}
