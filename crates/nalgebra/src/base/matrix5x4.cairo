            && lhs.m43 < rhs.m43
            && lhs.m53 < rhs.m53
            && lhs.m14 < rhs.m14
            && lhs.m24 < rhs.m24
            && lhs.m34 < rhs.m34
            && lhs.m44 < rhs.m44
            && lhs.m54 < rhs.m54
    }
