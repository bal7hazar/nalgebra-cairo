        lhs.m11 < rhs.m11
            && lhs.m21 < rhs.m21
            && lhs.m31 < rhs.m31
            && lhs.m41 < rhs.m41
            && lhs.m51 < rhs.m51
            && lhs.m12 < rhs.m12
            && lhs.m22 < rhs.m22
