/// The statistics of `Vector6<T>` (upstream `base/statistics.rs`): sums, products, means and
/// variances of all the components, of each column (`row_*`, `row_*_tr`) and of each row
/// (`column_*`). By value, unrolled, no loop.
#[generate_trait]
pub impl Vector6StatisticsImpl<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Add<T>, +Sub<T>, +Mul<T>,
> of Vector6StatisticsTrait<T> {
    /// The product of all the components, left to right in column-major order (upstream's fold),
    /// each product floored. Panics on overflow. Upstream: `product`.
    #[inline(always)]
    fn product(self: Vector6<T>) -> T {
        self.x * self.y * self.z * self.w * self.a * self.b
    }

    /// The mean of all the components: their exact sum divided by 6, correctly rounded (to nearest,
    /// ties to even, like `f64 /`). Panics if the sum overflows. Upstream: `mean`.
    fn mean(self: Vector6<T>) -> T {
        let n = R::from_int(6);
        R::div(self.x + self.y + self.z + self.w + self.a + self.b, n)
    }

    /// The population variance of all the components, upstream's two-pass formula `sum((x -
    /// mean)^2) / n`: the mean correctly rounded, the differences exact, their squares summed
    /// exactly and floored once, the quotient by 6 correctly rounded. Panics on overflow. Upstream:
    /// `variance`.
    fn variance(self: Vector6<T>) -> T {
        let n = R::from_int(6);
        let m0 = R::div(self.x + self.y + self.z + self.w + self.a + self.b, n);
        let s0 = {
            let d0 = self.x - m0;
            let d1 = self.y - m0;
            let d2 = self.z - m0;
            let d3 = self.w - m0;
            let d4 = self.a - m0;
            let d5 = self.b - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        R::div(s0, n)
    }

    /// The sum of each column, exact, left to right. Panics on overflow. Upstream: `row_sum`.
    fn row_sum(self: Vector6<T>) -> Matrix1<T> {
        Matrix1 { x: self.x + self.y + self.z + self.w + self.a + self.b }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Vector6<T>) -> Matrix1<T> {
        Self::row_sum(self)
    }

    /// The sum of each row, exact, left to right. Panics on overflow. Upstream: `column_sum`.
    fn column_sum(self: Vector6<T>) -> Vector6<T> {
        Vector6 { x: self.x, y: self.y, z: self.z, w: self.w, a: self.a, b: self.b }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Vector6<T>) -> Matrix1<T> {
        Matrix1 { x: self.x * self.y * self.z * self.w * self.a * self.b }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Vector6<T>) -> Matrix1<T> {
        Self::row_product(self)
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Vector6<T>) -> Vector6<T> {
        Vector6 { x: self.x, y: self.y, z: self.z, w: self.w, a: self.a, b: self.b }
    }

    /// The mean of each column: its exact sum divided by 6, correctly rounded. Panics if a sum
    /// overflows. Upstream: `row_mean`.
    fn row_mean(self: Vector6<T>) -> Matrix1<T> {
        let n = R::from_int(6);
        let m0 = R::div(self.x + self.y + self.z + self.w + self.a + self.b, n);
        Matrix1 { x: m0 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Vector6<T>) -> Matrix1<T> {
        Self::row_mean(self)
    }

    /// The mean of each row: its exact sum divided by 1, correctly rounded. Panics if a sum
    /// overflows. Upstream: `column_mean` (computed as `sum(x / n)`: the same value mathematically,
    /// without the rounded reciprocal).
    fn column_mean(self: Vector6<T>) -> Vector6<T> {
        let m0 = self.x;
        let m1 = self.y;
        let m2 = self.z;
        let m3 = self.w;
        let m4 = self.a;
        let m5 = self.b;
        Vector6 { x: m0, y: m1, z: m2, w: m3, a: m4, b: m5 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 6`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Vector6<T>) -> Matrix1<T> {
        let n = R::from_int(6);
        let m0 = R::div(self.x + self.y + self.z + self.w + self.a + self.b, n);
        let s0 = {
            let d0 = self.x - m0;
            let d1 = self.y - m0;
            let d2 = self.z - m0;
            let d3 = self.w - m0;
            let d4 = self.a - m0;
            let d5 = self.b - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let v0 = R::div(s0, n);
