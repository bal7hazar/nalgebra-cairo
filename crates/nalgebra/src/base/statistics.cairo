    /// The mean of each row: its exact sum divided by 3, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix6x3<T>) -> Vector6<T> {
        let n = R::from_int(3);
        let (m0, m1, m2, m3, m4, m5) = R::div6(
            self.m11 + self.m12 + self.m13,
            self.m21 + self.m22 + self.m23,
            self.m31 + self.m32 + self.m33,
            self.m41 + self.m42 + self.m43,
            self.m51 + self.m52 + self.m53,
            self.m61 + self.m62 + self.m63,
            n,
        );
        Vector6 { x: m0, y: m1, z: m2, w: m3, a: m4, b: m5 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 6`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix6x3<T>) -> RowVector3<T> {
        let n = R::from_int(6);
        let (m0, m1, m2) = R::div3(
            self.m11 + self.m21 + self.m31 + self.m41 + self.m51 + self.m61,
            self.m12 + self.m22 + self.m32 + self.m42 + self.m52 + self.m62,
            self.m13 + self.m23 + self.m33 + self.m43 + self.m53 + self.m63,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m41 - m0;
            let d4 = self.m51 - m0;
            let d5 = self.m61 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            let d3 = self.m42 - m1;
            let d4 = self.m52 - m1;
            let d5 = self.m62 - m1;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let s2 = {
            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m43 - m2;
            let d4 = self.m53 - m2;
            let d5 = self.m63 - m2;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let (v0, v1, v2) = R::div3(s0, s1, s2, n);
