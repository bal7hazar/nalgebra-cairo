    #[inline(always)]
    fn row_mean_tr(self: Matrix5x2<T>) -> Vector2<T> {
        let r = Self::row_mean(self);
        Vector2 { x: r.x, y: r.y }
    }

    /// The mean of each row: its exact sum divided by 2, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix5x2<T>) -> Vector5<T> {
        let n = R::from_int(2);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m12,
            self.m21 + self.m22,
            self.m31 + self.m32,
            self.m41 + self.m42,
            self.m51 + self.m52,
            n,
        );
        Vector5 { x: m0, y: m1, z: m2, w: m3, a: m4 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 5`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix5x2<T>) -> RowVector2<T> {
        let n = R::from_int(5);
        let m0 = R::div(self.m11 + self.m21 + self.m31 + self.m41 + self.m51, n);
        let m1 = R::div(self.m12 + self.m22 + self.m32 + self.m42 + self.m52, n);
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m41 - m0;
            let d4 = self.m51 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            let d3 = self.m42 - m1;
            let d4 = self.m52 - m1;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let v0 = R::div(s0, n);
        let v1 = R::div(s1, n);
        RowVector2 { x: v0, y: v1 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix5x2<T>) -> Vector2<T> {
        let r = Self::row_variance(self);
        Vector2 { x: r.x, y: r.y }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 2`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix5x2<T>) -> Vector5<T> {
        let n = R::from_int(2);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m12,
            self.m21 + self.m22,
            self.m31 + self.m32,
            self.m41 + self.m42,
            self.m51 + self.m52,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            R::norm_squared2(d0, d1)
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            R::norm_squared2(d0, d1)
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            R::norm_squared2(d0, d1)
        };
        let s3 = {
            let d0 = self.m41 - m3;
            let d1 = self.m42 - m3;
            R::norm_squared2(d0, d1)
        };
        let s4 = {
            let d0 = self.m51 - m4;
            let d1 = self.m52 - m4;
            R::norm_squared2(d0, d1)
        };
        let (v0, v1, v2, v3, v4) = R::div5(s0, s1, s2, s3, s4, n);
        Vector5 { x: v0, y: v1, z: v2, w: v3, a: v4 }
    }
}

