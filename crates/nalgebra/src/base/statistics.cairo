            self.m11 + self.m21,
            self.m12 + self.m22,
            self.m13 + self.m23,
            self.m14 + self.m24,
            self.m15 + self.m25,
            self.m16 + self.m26,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            R::norm_squared2(d0, d1)
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            R::norm_squared2(d0, d1)
        };
        let s2 = {
            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            R::norm_squared2(d0, d1)
        };
        let s3 = {
            let d0 = self.m14 - m3;
            let d1 = self.m24 - m3;
            R::norm_squared2(d0, d1)
        };
        let s4 = {
            let d0 = self.m15 - m4;
            let d1 = self.m25 - m4;
            R::norm_squared2(d0, d1)
        };
        let s5 = {
            let d0 = self.m16 - m5;
            let d1 = self.m26 - m5;
            R::norm_squared2(d0, d1)
        };
        let (v0, v1, v2, v3, v4, v5) = R::div6(s0, s1, s2, s3, s4, s5, n);
