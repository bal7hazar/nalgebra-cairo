    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix6x3<T>) -> Vector3<T> {
        let r = Self::row_variance(self);
        Vector3 { x: r.x, y: r.y, z: r.z }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 3`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix6x3<T>) -> Vector6<T> {
        let n = R::from_int(3);
        let (m0, m1, m2, m3, m4, m5) = R::div6(
            self.m11 + self.m12 + self.m13,
            self.m21 + self.m22 + self.m23,
            self.m31 + self.m32 + self.m33,
            self.m41 + self.m42 + self.m43,
            self.m51 + self.m52 + self.m53,
            self.m61 + self.m62 + self.m63,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            R::norm_squared3(d0, d1, d2)
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            R::norm_squared3(d0, d1, d2)
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            let d2 = self.m33 - m2;
            R::norm_squared3(d0, d1, d2)
        };
        let s3 = {
            let d0 = self.m41 - m3;
            let d1 = self.m42 - m3;
            let d2 = self.m43 - m3;
            R::norm_squared3(d0, d1, d2)
        };
        let s4 = {
            let d0 = self.m51 - m4;
            let d1 = self.m52 - m4;
            let d2 = self.m53 - m4;
            R::norm_squared3(d0, d1, d2)
        };
        let s5 = {
            let d0 = self.m61 - m5;
            let d1 = self.m62 - m5;
            let d2 = self.m63 - m5;
            R::norm_squared3(d0, d1, d2)
        };
        let (v0, v1, v2, v3, v4, v5) = R::div6(s0, s1, s2, s3, s4, s5, n);
        Vector6 { x: v0, y: v1, z: v2, w: v3, a: v4, b: v5 }
    }
