    fn row_product_tr(self: Matrix5x2<T>) -> Vector2<T> {
        let r = Self::row_product(self);
        Vector2 { x: r.x, y: r.y }
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Matrix5x2<T>) -> Vector5<T> {
        Vector5 {
            x: self.m11 * self.m12,
            y: self.m21 * self.m22,
            z: self.m31 * self.m32,
            w: self.m41 * self.m42,
