            y: self.m12 + self.m22 + self.m32 + self.m42,
            z: self.m13 + self.m23 + self.m33 + self.m43,
            w: self.m14 + self.m24 + self.m34 + self.m44,
            a: self.m15 + self.m25 + self.m35 + self.m45,
            b: self.m16 + self.m26 + self.m36 + self.m46,
        }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Matrix4x6<T>) -> Vector6<T> {
        let r = Self::row_sum(self);
        Vector6 { x: r.x, y: r.y, z: r.z, w: r.w, a: r.a, b: r.b }
    }

    /// The sum of each row, exact, left to right. Panics on overflow. Upstream: `column_sum`.
    fn column_sum(self: Matrix4x6<T>) -> Vector4<T> {
        Vector4 {
            x: self.m11 + self.m12 + self.m13 + self.m14 + self.m15 + self.m16,
            y: self.m21 + self.m22 + self.m23 + self.m24 + self.m25 + self.m26,
            z: self.m31 + self.m32 + self.m33 + self.m34 + self.m35 + self.m36,
            w: self.m41 + self.m42 + self.m43 + self.m44 + self.m45 + self.m46,
        }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Matrix4x6<T>) -> RowVector6<T> {
        RowVector6 {
            x: self.m11 * self.m21 * self.m31 * self.m41,
            y: self.m12 * self.m22 * self.m32 * self.m42,
            z: self.m13 * self.m23 * self.m33 * self.m43,
            w: self.m14 * self.m24 * self.m34 * self.m44,
            a: self.m15 * self.m25 * self.m35 * self.m45,
            b: self.m16 * self.m26 * self.m36 * self.m46,
        }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Matrix4x6<T>) -> Vector6<T> {
        let r = Self::row_product(self);
        Vector6 { x: r.x, y: r.y, z: r.z, w: r.w, a: r.a, b: r.b }
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Matrix4x6<T>) -> Vector4<T> {
        Vector4 {
            x: self.m11 * self.m12 * self.m13 * self.m14 * self.m15 * self.m16,
            y: self.m21 * self.m22 * self.m23 * self.m24 * self.m25 * self.m26,
            z: self.m31 * self.m32 * self.m33 * self.m34 * self.m35 * self.m36,
            w: self.m41 * self.m42 * self.m43 * self.m44 * self.m45 * self.m46,
        }
    }

    /// The mean of each column: its exact sum divided by 4, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `row_mean`.
    fn row_mean(self: Matrix4x6<T>) -> RowVector6<T> {
        let n = R::from_int(4);
        let (m0, m1, m2, m3, m4, m5) = R::div6(
            self.m11 + self.m21 + self.m31 + self.m41,
            self.m12 + self.m22 + self.m32 + self.m42,
            self.m13 + self.m23 + self.m33 + self.m43,
            self.m14 + self.m24 + self.m34 + self.m44,
            self.m15 + self.m25 + self.m35 + self.m45,
            self.m16 + self.m26 + self.m36 + self.m46,
            n,
        );
        RowVector6 { x: m0, y: m1, z: m2, w: m3, a: m4, b: m5 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Matrix4x6<T>) -> Vector6<T> {
        let r = Self::row_mean(self);
        Vector6 { x: r.x, y: r.y, z: r.z, w: r.w, a: r.a, b: r.b }
    }

    /// The mean of each row: its exact sum divided by 6, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix4x6<T>) -> Vector4<T> {
        let n = R::from_int(6);
        let (m0, m1, m2, m3) = R::div4(
            self.m11 + self.m12 + self.m13 + self.m14 + self.m15 + self.m16,
            self.m21 + self.m22 + self.m23 + self.m24 + self.m25 + self.m26,
            self.m31 + self.m32 + self.m33 + self.m34 + self.m35 + self.m36,
            self.m41 + self.m42 + self.m43 + self.m44 + self.m45 + self.m46,
            n,
        );
        Vector4 { x: m0, y: m1, z: m2, w: m3 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 4`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix4x6<T>) -> RowVector6<T> {
        let n = R::from_int(4);
        let (m0, m1, m2, m3, m4, m5) = R::div6(
            self.m11 + self.m21 + self.m31 + self.m41,
            self.m12 + self.m22 + self.m32 + self.m42,
            self.m13 + self.m23 + self.m33 + self.m43,
            self.m14 + self.m24 + self.m34 + self.m44,
            self.m15 + self.m25 + self.m35 + self.m45,
            self.m16 + self.m26 + self.m36 + self.m46,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m41 - m0;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            let d3 = self.m42 - m1;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s2 = {
            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m43 - m2;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s3 = {
            let d0 = self.m14 - m3;
            let d1 = self.m24 - m3;
            let d2 = self.m34 - m3;
            let d3 = self.m44 - m3;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s4 = {
            let d0 = self.m15 - m4;
            let d1 = self.m25 - m4;
            let d2 = self.m35 - m4;
            let d3 = self.m45 - m4;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s5 = {
            let d0 = self.m16 - m5;
            let d1 = self.m26 - m5;
            let d2 = self.m36 - m5;
            let d3 = self.m46 - m5;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let (v0, v1, v2, v3, v4, v5) = R::div6(s0, s1, s2, s3, s4, s5, n);
        RowVector6 { x: v0, y: v1, z: v2, w: v3, a: v4, b: v5 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix4x6<T>) -> Vector6<T> {
        let r = Self::row_variance(self);
        Vector6 { x: r.x, y: r.y, z: r.z, w: r.w, a: r.a, b: r.b }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 6`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix4x6<T>) -> Vector4<T> {
        let n = R::from_int(6);
        let (m0, m1, m2, m3) = R::div4(
            self.m11 + self.m12 + self.m13 + self.m14 + self.m15 + self.m16,
            self.m21 + self.m22 + self.m23 + self.m24 + self.m25 + self.m26,
            self.m31 + self.m32 + self.m33 + self.m34 + self.m35 + self.m36,
            self.m41 + self.m42 + self.m43 + self.m44 + self.m45 + self.m46,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            let d3 = self.m14 - m0;
            let d4 = self.m15 - m0;
            let d5 = self.m16 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            let d3 = self.m24 - m1;
            let d4 = self.m25 - m1;
            let d5 = self.m26 - m1;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m34 - m2;
            let d4 = self.m35 - m2;
            let d5 = self.m36 - m2;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let s3 = {
            let d0 = self.m41 - m3;
            let d1 = self.m42 - m3;
            let d2 = self.m43 - m3;
            let d3 = self.m44 - m3;
            let d4 = self.m45 - m3;
            let d5 = self.m46 - m3;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let (v0, v1, v2, v3) = R::div4(s0, s1, s2, s3, n);
        Vector4 { x: v0, y: v1, z: v2, w: v3 }
    }
}

/// The statistics of `Vector5<T>` (upstream `base/statistics.rs`): sums, products, means and
/// variances of all the components, of each column (`row_*`, `row_*_tr`) and of each row
/// (`column_*`). By value, unrolled, no loop.
#[generate_trait]
pub impl Vector5StatisticsImpl<
    T, impl R: Real<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>, +Add<T>, +Sub<T>, +Mul<T>,
> of Vector5StatisticsTrait<T> {
    /// The sum of all the components, left to right in column-major order (upstream's iteration
    /// order), exact. Panics on overflow (of any partial sum). Upstream: `sum`.
    #[inline(always)]
    fn sum(self: Vector5<T>) -> T {
        self.x + self.y + self.z + self.w + self.a
    }

    /// The product of all the components, left to right in column-major order (upstream's fold),
    /// each product floored. Panics on overflow. Upstream: `product`.
    #[inline(always)]
    fn product(self: Vector5<T>) -> T {
        self.x * self.y * self.z * self.w * self.a
    }

    /// The mean of all the components: their exact sum divided by 5, correctly rounded (to nearest,
    /// ties to even, like `f64 /`). Panics if the sum overflows. Upstream: `mean`.
    fn mean(self: Vector5<T>) -> T {
        let n = R::from_int(5);
        R::div(self.x + self.y + self.z + self.w + self.a, n)
    }

    /// The population variance of all the components, upstream's two-pass formula `sum((x -
    /// mean)^2) / n`: the mean correctly rounded, the differences exact, their squares summed
    /// exactly and floored once, the quotient by 5 correctly rounded. Panics on overflow. Upstream:
    /// `variance`.
    fn variance(self: Vector5<T>) -> T {
        let n = R::from_int(5);
        let m0 = R::div(self.x + self.y + self.z + self.w + self.a, n);
        let s0 = {
            let d0 = self.x - m0;
            let d1 = self.y - m0;
            let d2 = self.z - m0;
            let d3 = self.w - m0;
            let d4 = self.a - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        R::div(s0, n)
    }

    /// The sum of each column, exact, left to right. Panics on overflow. Upstream: `row_sum`.
    fn row_sum(self: Vector5<T>) -> Matrix1<T> {
        Matrix1 { x: self.x + self.y + self.z + self.w + self.a }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Vector5<T>) -> Matrix1<T> {
        Self::row_sum(self)
    }

    /// The sum of each row, exact, left to right. Panics on overflow. Upstream: `column_sum`.
    fn column_sum(self: Vector5<T>) -> Vector5<T> {
        Vector5 { x: self.x, y: self.y, z: self.z, w: self.w, a: self.a }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Vector5<T>) -> Matrix1<T> {
        Matrix1 { x: self.x * self.y * self.z * self.w * self.a }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Vector5<T>) -> Matrix1<T> {
        Self::row_product(self)
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Vector5<T>) -> Vector5<T> {
        Vector5 { x: self.x, y: self.y, z: self.z, w: self.w, a: self.a }
    }

    /// The mean of each column: its exact sum divided by 5, correctly rounded. Panics if a sum
    /// overflows. Upstream: `row_mean`.
    fn row_mean(self: Vector5<T>) -> Matrix1<T> {
        let n = R::from_int(5);
        let m0 = R::div(self.x + self.y + self.z + self.w + self.a, n);
        Matrix1 { x: m0 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Vector5<T>) -> Matrix1<T> {
        Self::row_mean(self)
    }

    /// The mean of each row: its exact sum divided by 1, correctly rounded. Panics if a sum
    /// overflows. Upstream: `column_mean` (computed as `sum(x / n)`: the same value mathematically,
    /// without the rounded reciprocal).
    fn column_mean(self: Vector5<T>) -> Vector5<T> {
        let m0 = self.x;
        let m1 = self.y;
        let m2 = self.z;
        let m3 = self.w;
        let m4 = self.a;
        Vector5 { x: m0, y: m1, z: m2, w: m3, a: m4 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 5`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Vector5<T>) -> Matrix1<T> {
        let n = R::from_int(5);
        let m0 = R::div(self.x + self.y + self.z + self.w + self.a, n);
        let s0 = {
            let d0 = self.x - m0;
            let d1 = self.y - m0;
            let d2 = self.z - m0;
            let d3 = self.w - m0;
            let d4 = self.a - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let v0 = R::div(s0, n);
        Matrix1 { x: v0 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Vector5<T>) -> Matrix1<T> {
        Self::row_variance(self)
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 1`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Vector5<T>) -> Vector5<T> {
        let v0 = R::zero();
        let v1 = R::zero();
        let v2 = R::zero();
        let v3 = R::zero();
        let v4 = R::zero();
        Vector5 { x: v0, y: v1, z: v2, w: v3, a: v4 }
    }
}

