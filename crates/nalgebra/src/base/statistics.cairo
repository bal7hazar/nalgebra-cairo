    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix2x6<T>) -> Vector6<T> {
        let r = Self::row_variance(self);
        Vector6 { x: r.x, y: r.y, z: r.z, w: r.w, a: r.a, b: r.b }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 6`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix2x6<T>) -> Vector2<T> {
        let n = R::from_int(6);
        let m0 = R::div(self.m11 + self.m12 + self.m13 + self.m14 + self.m15 + self.m16, n);
        let m1 = R::div(self.m21 + self.m22 + self.m23 + self.m24 + self.m25 + self.m26, n);
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            let d3 = self.m14 - m0;
            let d4 = self.m15 - m0;
            let d5 = self.m16 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            let d3 = self.m24 - m1;
            let d4 = self.m25 - m1;
            let d5 = self.m26 - m1;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                                d2,
                                d2,
                            ),
                            d3,
                            d3,
                        ),
                        d4,
                        d4,
                    ),
                    d5,
                    d5,
                ),
            )
        };
        let v0 = R::div(s0, n);
        let v1 = R::div(s1, n);
        Vector2 { x: v0, y: v1 }
    }
}

