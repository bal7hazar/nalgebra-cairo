            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            R::norm_squared3(d0, d1, d2)
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            R::norm_squared3(d0, d1, d2)
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            let d2 = self.m33 - m2;
            R::norm_squared3(d0, d1, d2)
        };
        let s3 = {
            let d0 = self.m41 - m3;
            let d1 = self.m42 - m3;
            let d2 = self.m43 - m3;
