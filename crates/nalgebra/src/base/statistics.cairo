    /// The sum of each column, exact, left to right. Panics on overflow. Upstream: `row_sum`.
    fn row_sum(self: Matrix5x4<T>) -> RowVector4<T> {
        RowVector4 {
            x: self.m11 + self.m21 + self.m31 + self.m41 + self.m51,
            y: self.m12 + self.m22 + self.m32 + self.m42 + self.m52,
            z: self.m13 + self.m23 + self.m33 + self.m43 + self.m53,
            w: self.m14 + self.m24 + self.m34 + self.m44 + self.m54,
        }
    }

    /// `row_sum` as a column vector (the same values, bit-identical). Upstream: `row_sum_tr`.
    #[inline(always)]
    fn row_sum_tr(self: Matrix5x4<T>) -> Vector4<T> {
        let r = Self::row_sum(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The sum of each row, exact, left to right. Panics on overflow. Upstream: `column_sum`.
    fn column_sum(self: Matrix5x4<T>) -> Vector5<T> {
        Vector5 {
            x: self.m11 + self.m12 + self.m13 + self.m14,
            y: self.m21 + self.m22 + self.m23 + self.m24,
            z: self.m31 + self.m32 + self.m33 + self.m34,
            w: self.m41 + self.m42 + self.m43 + self.m44,
            a: self.m51 + self.m52 + self.m53 + self.m54,
        }
    }

    /// The product of each column, left to right, each product floored. Panics on overflow.
    /// Upstream: `row_product`.
    fn row_product(self: Matrix5x4<T>) -> RowVector4<T> {
        RowVector4 {
            x: self.m11 * self.m21 * self.m31 * self.m41 * self.m51,
            y: self.m12 * self.m22 * self.m32 * self.m42 * self.m52,
            z: self.m13 * self.m23 * self.m33 * self.m43 * self.m53,
            w: self.m14 * self.m24 * self.m34 * self.m44 * self.m54,
        }
    }

    /// `row_product` as a column vector (the same values, bit-identical). Upstream:
    /// `row_product_tr`.
    #[inline(always)]
    fn row_product_tr(self: Matrix5x4<T>) -> Vector4<T> {
        let r = Self::row_product(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The product of each row, left to right, each product floored. Panics on overflow. Upstream:
    /// `column_product`.
    fn column_product(self: Matrix5x4<T>) -> Vector5<T> {
        Vector5 {
            x: self.m11 * self.m12 * self.m13 * self.m14,
            y: self.m21 * self.m22 * self.m23 * self.m24,
            z: self.m31 * self.m32 * self.m33 * self.m34,
            w: self.m41 * self.m42 * self.m43 * self.m44,
            a: self.m51 * self.m52 * self.m53 * self.m54,
        }
    }

    /// The mean of each column: its exact sum divided by 5, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `row_mean`.
    fn row_mean(self: Matrix5x4<T>) -> RowVector4<T> {
        let n = R::from_int(5);
        let (m0, m1, m2, m3) = R::div4(
            self.m11 + self.m21 + self.m31 + self.m41 + self.m51,
            self.m12 + self.m22 + self.m32 + self.m42 + self.m52,
            self.m13 + self.m23 + self.m33 + self.m43 + self.m53,
            self.m14 + self.m24 + self.m34 + self.m44 + self.m54,
            n,
        );
        RowVector4 { x: m0, y: m1, z: m2, w: m3 }
    }

    /// `row_mean` as a column vector (the same values, bit-identical). Upstream: `row_mean_tr`.
    #[inline(always)]
    fn row_mean_tr(self: Matrix5x4<T>) -> Vector4<T> {
        let r = Self::row_mean(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The mean of each row: its exact sum divided by 4, correctly rounded (one prepared divisor
    /// for all, `Real::divN`, bit-identical to `/`). Panics if a sum overflows. Upstream:
    /// `column_mean` (computed as `sum(x / n)`: the same value mathematically, without the rounded
    /// reciprocal).
    fn column_mean(self: Matrix5x4<T>) -> Vector5<T> {
        let n = R::from_int(4);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m12 + self.m13 + self.m14,
            self.m21 + self.m22 + self.m23 + self.m24,
            self.m31 + self.m32 + self.m33 + self.m34,
            self.m41 + self.m42 + self.m43 + self.m44,
            self.m51 + self.m52 + self.m53 + self.m54,
            n,
        );
        Vector5 { x: m0, y: m1, z: m2, w: m3, a: m4 }
    }

    /// The population variance of each column, upstream's two-pass formula `sum((x - mean)^2) / 5`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `row_variance`.
    fn row_variance(self: Matrix5x4<T>) -> RowVector4<T> {
        let n = R::from_int(5);
        let (m0, m1, m2, m3) = R::div4(
            self.m11 + self.m21 + self.m31 + self.m41 + self.m51,
            self.m12 + self.m22 + self.m32 + self.m42 + self.m52,
            self.m13 + self.m23 + self.m33 + self.m43 + self.m53,
            self.m14 + self.m24 + self.m34 + self.m44 + self.m54,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m21 - m0;
            let d2 = self.m31 - m0;
            let d3 = self.m41 - m0;
            let d4 = self.m51 - m0;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s1 = {
            let d0 = self.m12 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m32 - m1;
            let d3 = self.m42 - m1;
            let d4 = self.m52 - m1;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s2 = {
            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m43 - m2;
            let d4 = self.m53 - m2;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let s3 = {
            let d0 = self.m14 - m3;
            let d1 = self.m24 - m3;
            let d2 = self.m34 - m3;
            let d3 = self.m44 - m3;
            let d4 = self.m54 - m3;
            R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d0, d0), d1, d1),
                            d2,
                            d2,
                        ),
                        d3,
                        d3,
                    ),
                    d4,
                    d4,
                ),
            )
        };
        let (v0, v1, v2, v3) = R::div4(s0, s1, s2, s3, n);
        RowVector4 { x: v0, y: v1, z: v2, w: v3 }
    }

    /// `row_variance` as a column vector (the same values, bit-identical). Upstream:
    /// `row_variance_tr`.
    #[inline(always)]
    fn row_variance_tr(self: Matrix5x4<T>) -> Vector4<T> {
        let r = Self::row_variance(self);
        Vector4 { x: r.x, y: r.y, z: r.z, w: r.w }
    }

    /// The population variance of each row, upstream's two-pass formula `sum((x - mean)^2) / 4`
    /// (see `variance`: mean and quotient correctly rounded, squares summed exactly and floored
    /// once). Panics on overflow. Upstream: `column_variance` (computed there as `sum(x^2 / n) -
    /// mean^2`: the same value mathematically, whose cancellation would cost several ulp in fixed
    /// point).
    fn column_variance(self: Matrix5x4<T>) -> Vector5<T> {
        let n = R::from_int(4);
        let (m0, m1, m2, m3, m4) = R::div5(
            self.m11 + self.m12 + self.m13 + self.m14,
            self.m21 + self.m22 + self.m23 + self.m24,
            self.m31 + self.m32 + self.m33 + self.m34,
            self.m41 + self.m42 + self.m43 + self.m44,
            self.m51 + self.m52 + self.m53 + self.m54,
            n,
        );
        let s0 = {
            let d0 = self.m11 - m0;
            let d1 = self.m12 - m0;
            let d2 = self.m13 - m0;
            let d3 = self.m14 - m0;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s1 = {
            let d0 = self.m21 - m1;
            let d1 = self.m22 - m1;
            let d2 = self.m23 - m1;
            let d3 = self.m24 - m1;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s2 = {
            let d0 = self.m31 - m2;
            let d1 = self.m32 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m34 - m2;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s3 = {
            let d0 = self.m41 - m3;
            let d1 = self.m42 - m3;
            let d2 = self.m43 - m3;
            let d3 = self.m44 - m3;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let s4 = {
            let d0 = self.m51 - m4;
            let d1 = self.m52 - m4;
            let d2 = self.m53 - m4;
            let d3 = self.m54 - m4;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let (v0, v1, v2, v3, v4) = R::div5(s0, s1, s2, s3, s4, n);
        Vector5 { x: v0, y: v1, z: v2, w: v3, a: v4 }
    }
}

