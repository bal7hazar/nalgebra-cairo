                                                        R::wide_add_prod(
                                                            R::wide_add_prod(
                                                                R::wide_add_prod(
                                                                    R::wide_add_prod(
                                                                        R::wide_add_prod(
                                                                            R::wide_add_prod(
                                                                                R::wide_add_prod(
                                                                                    R::wide_add_prod(
                                                                                        R::wide_zero(),
                                                                                        d0,
                                                                                        d0,
                                                                                    ),
                                                                                    d1,
                                                                                    d1,
                                                                                ),
                                                                                d2,
                                                                                d2,
                                                                            ),
                                                                            d3,
                                                                            d3,
                                                                        ),
                                                                        d4,
                                                                        d4,
                                                                    ),
