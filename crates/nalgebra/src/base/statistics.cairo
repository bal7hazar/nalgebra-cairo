            let d0 = self.m13 - m2;
            let d1 = self.m23 - m2;
            let d2 = self.m33 - m2;
            let d3 = self.m43 - m2;
            R::norm_squared4(d0, d1, d2, d3)
        };
        let (v0, v1, v2) = R::div3(s0, s1, s2, n);
