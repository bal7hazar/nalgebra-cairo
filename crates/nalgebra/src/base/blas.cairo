            };
    }

    /// `ger` with `y` conjugated: `ger` for a real scalar (bit-identical). Upstream: `gerc`.
    #[inline(always)]
    fn gerc(ref self: Matrix6<T>, alpha: T, x: Vector6<T>, y: Vector6<T>, beta: T) {
        Self::ger(ref self, alpha, x, y, beta);
    }

    /// The symmetric rank-one update of the LOWER triangle, like upstream: `self[i, j] = alpha *
    /// x[i] * y[j] + beta * self[i, j]` for `i >= j` (see `ger`), the strict upper triangle
    /// untouched. Panics on overflow. Upstream: `syger`.
    fn syger(ref self: Matrix6<T>, alpha: T, x: Vector6<T>, y: Vector6<T>, beta: T) {
        self =
            Matrix6 {
                m11: BlasKernels::scaled_dot1(alpha, x.x, y.x, beta, self.m11),
                m21: BlasKernels::scaled_dot1(alpha, x.y, y.x, beta, self.m21),
                m31: BlasKernels::scaled_dot1(alpha, x.z, y.x, beta, self.m31),
                m41: BlasKernels::scaled_dot1(alpha, x.w, y.x, beta, self.m41),
                m51: BlasKernels::scaled_dot1(alpha, x.a, y.x, beta, self.m51),
                m61: BlasKernels::scaled_dot1(alpha, x.b, y.x, beta, self.m61),
                m12: self.m12,
                m22: BlasKernels::scaled_dot1(alpha, x.y, y.y, beta, self.m22),
                m32: BlasKernels::scaled_dot1(alpha, x.z, y.y, beta, self.m32),
                m42: BlasKernels::scaled_dot1(alpha, x.w, y.y, beta, self.m42),
                m52: BlasKernels::scaled_dot1(alpha, x.a, y.y, beta, self.m52),
                m62: BlasKernels::scaled_dot1(alpha, x.b, y.y, beta, self.m62),
                m13: self.m13,
                m23: self.m23,
                m33: BlasKernels::scaled_dot1(alpha, x.z, y.z, beta, self.m33),
                m43: BlasKernels::scaled_dot1(alpha, x.w, y.z, beta, self.m43),
                m53: BlasKernels::scaled_dot1(alpha, x.a, y.z, beta, self.m53),
                m63: BlasKernels::scaled_dot1(alpha, x.b, y.z, beta, self.m63),
                m14: self.m14,
                m24: self.m24,
                m34: self.m34,
                m44: BlasKernels::scaled_dot1(alpha, x.w, y.w, beta, self.m44),
                m54: BlasKernels::scaled_dot1(alpha, x.a, y.w, beta, self.m54),
                m64: BlasKernels::scaled_dot1(alpha, x.b, y.w, beta, self.m64),
                m15: self.m15,
                m25: self.m25,
                m35: self.m35,
                m45: self.m45,
                m55: BlasKernels::scaled_dot1(alpha, x.a, y.a, beta, self.m55),
                m65: BlasKernels::scaled_dot1(alpha, x.b, y.a, beta, self.m65),
                m16: self.m16,
                m26: self.m26,
                m36: self.m36,
                m46: self.m46,
                m56: self.m56,
                m66: BlasKernels::scaled_dot1(alpha, x.b, y.b, beta, self.m66),
            };
    }

    /// The hermitian rank-one update of the lower triangle: `syger` for a real scalar
    /// (bit-identical). Upstream: `hegerc`.
    #[inline(always)]
    fn hegerc(ref self: Matrix6<T>, alpha: T, x: Vector6<T>, y: Vector6<T>, beta: T) {
        Self::syger(ref self, alpha, x, y, beta);
    }

    /// Deprecated upstream (renamed `syger`): `syger` (bit-identical). Upstream: `ger_symm`.
    #[inline(always)]
    fn ger_symm(ref self: Matrix6<T>, alpha: T, x: Vector6<T>, y: Vector6<T>, beta: T) {
        Self::syger(ref self, alpha, x, y, beta);
    }
}

/// The transpose of a shape (the operand of the `_tr` forms): struct moves only, free once
/// inlined.
pub(crate) trait BlasTranspose<M> {
    type Output;
    fn tr(self: M) -> Self::Output;
}

/// The last column of a shape (the workspace left by upstream's `quadform*_with_workspace`).
pub(crate) trait BlasLastColumn<M> {
    type Output;
    fn last_column(self: M) -> Self::Output;
}

/// `gemv` is `gemm` with a one-column `self` and `x` (the same kernel, bit-identical); `self`
/// must be a column vector, like upstream's `Vector`.
pub impl MatrixGemvImpl<
    T, Y, A, X, impl G: MatrixGemm<T, Y, A, X>, +ColumnVectorLen<Y>,
> of MatrixGemv<T, Y, A, X> {
    #[inline(always)]
    fn gemv(ref self: Y, alpha: T, a: A, x: X, beta: T) {
        G::gemm(ref self, alpha, a, x, beta);
    }
}

/// `gemv_tr` is `gemv` of the transpose of `a` (the transpose only relabels values:
/// bit-identical, the same gas once inlined).
pub impl MatrixGemvTrImpl<
    T,
    Y,
    A,
    X,
    impl Tr: BlasTranspose<A>,
    impl G: MatrixGemv<T, Y, Tr::Output, X>,
    +Drop<T>,
    +Drop<Y>,
    +Drop<X>,
> of MatrixGemvTr<T, Y, A, X> {
    #[inline(always)]
    fn gemv_tr(ref self: Y, alpha: T, a: A, x: X, beta: T) {
        G::gemv(ref self, alpha, Tr::tr(a), x, beta);
    }
}

/// `gemm_tr` is `gemm` of the transpose of `a` (bit-identical, the same gas once inlined).
pub impl MatrixGemmTrImpl<
    T,
    S,
    A,
    B,
    impl Tr: BlasTranspose<A>,
    impl G: MatrixGemm<T, S, Tr::Output, B>,
    +Drop<T>,
    +Drop<S>,
    +Drop<B>,
> of MatrixGemmTr<T, S, A, B> {
    #[inline(always)]
    fn gemm_tr(ref self: S, alpha: T, a: A, b: B, beta: T) {
        G::gemm(ref self, alpha, Tr::tr(a), b, beta);
    }
}

/// `quadform*` is `w = mid.mul_mat(rhs)` (one fused sum of products per entry, floored once: the
/// columns of upstream's workspace) then `self.gemm_tr(alpha, rhs, w, beta)`.
pub impl MatrixQuadformImpl<
    T,
    S,
    M,
    Rhs,
    impl Mu: MatrixMul<M, Rhs>,
    impl G: MatrixGemmTr<T, S, Rhs, Mu::Output>,
    impl Lc: BlasLastColumn<Mu::Output>,
    +Copy<Rhs>,
    +Copy<Mu::Output>,
    +Drop<Mu::Output>,
    +Drop<Lc::Output>,
    +Drop<T>,
    +Drop<S>,
    +Drop<Rhs>,
    +Drop<M>,
> of MatrixQuadform<T, S, M, Rhs> {
    type Workspace = Lc::Output;

    #[inline(always)]
    fn quadform(ref self: S, alpha: T, mid: M, rhs: Rhs, beta: T) {
        G::gemm_tr(ref self, alpha, rhs, Mu::mul_mat(mid, rhs), beta);
    }

    #[inline(always)]
    fn quadform_with_workspace(
        ref self: S, ref work: Lc::Output, alpha: T, mid: M, rhs: Rhs, beta: T,
    ) {
        let w = Mu::mul_mat(mid, rhs);
        G::gemm_tr(ref self, alpha, rhs, w, beta);
        work = Lc::last_column(w);
    }
}

/// `quadform_tr*` is `w = lhs.mul_mat(mid)` (one fused sum of products per entry, floored once:
/// the columns of upstream's workspace) then `self.gemm(alpha, w, lhsᵀ, beta)`.
pub impl MatrixQuadformTrImpl<
    T,
    S,
    L,
    M,
    impl Mu: MatrixMul<L, M>,
    impl Tr: BlasTranspose<L>,
    impl G: MatrixGemm<T, S, Mu::Output, Tr::Output>,
    impl Lc: BlasLastColumn<Mu::Output>,
    +Copy<L>,
    +Copy<Mu::Output>,
    +Drop<Mu::Output>,
    +Drop<Lc::Output>,
    +Drop<T>,
    +Drop<S>,
    +Drop<L>,
    +Drop<M>,
> of MatrixQuadformTr<T, S, L, M> {
    type Workspace = Lc::Output;

    #[inline(always)]
    fn quadform_tr(ref self: S, alpha: T, lhs: L, mid: M, beta: T) {
        G::gemm(ref self, alpha, Mu::mul_mat(lhs, mid), Tr::tr(lhs), beta);
    }

    #[inline(always)]
    fn quadform_tr_with_workspace(
        ref self: S, ref work: Lc::Output, alpha: T, lhs: L, mid: M, beta: T,
    ) {
        let w = Mu::mul_mat(lhs, mid);
        G::gemm(ref self, alpha, w, Tr::tr(lhs), beta);
        work = Lc::last_column(w);
    }
}

