/// `self * rhs` through `MatrixMul`: the `*` operator (same kernel, same gas), for code written
/// over every conformable shape. Upstream: `Mul`.
pub impl Matrix6MulMatrix6<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>,
> of MatrixMul<Matrix6<T>, Matrix6<T>> {
    type Output = Matrix6<T>;
    #[inline(always)]
    fn mul_mat(self: Matrix6<T>, rhs: Matrix6<T>) -> Matrix6<T> {
        self * rhs
    }
}

