            3 => Vector4 { x: self.x, y: self.y, z: self.z, w: self.a },
            4 => Vector4 { x: self.x, y: self.y, z: self.z, w: self.w },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

