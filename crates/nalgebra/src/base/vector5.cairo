            3 => Matrix1 { x: self.w },
            4 => Matrix1 { x: self.a },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// Column `j`, a `Vector5`; panics out of bounds.
