            m24: self.y * rhs.w,
            m34: self.z * rhs.w,
            m44: self.w * rhs.w,
            m54: self.a * rhs.w,
            m15: self.x * rhs.a,
            m25: self.y * rhs.a,
            m35: self.z * rhs.a,
            m45: self.w * rhs.a,
            m55: self.a * rhs.a,
            m16: self.x * rhs.b,
            m26: self.y * rhs.b,
            m36: self.z * rhs.b,
            m46: self.w * rhs.b,
            m56: self.a * rhs.b,
        }
    }
}

