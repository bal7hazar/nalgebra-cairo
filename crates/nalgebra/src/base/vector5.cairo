// --- iterator sums and products, crate-root functions (WP 8.6-P21) -------------------------------

/// `iter.sum()` of an iterator of `Vector5`s: the first item plus the others, in order (exact;
/// panics on overflow); the zero 5-dimensional column vector when empty. Upstream: `Sum for Matrix`
/// (a fold from `zero()`: the same result, one addition more).
pub impl Vector5Sum<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<Vector5<T>> {
    fn sum<I, +Iterator<I>[Item: Vector5<T>], +Destruct<I>, +Destruct<Vector5<T>>>(
        mut iter: I,
    ) -> Vector5<T> {
        let Option::Some(mut acc) = iter.next() else {
            return Vector5 { x: R::zero(), y: R::zero(), z: R::zero(), w: R::zero(), a: R::zero() };
        };
        while let Option::Some(x) = iter.next() {
            acc = acc + x;
        }
        acc
    }
}

/// `*iter.sum()` of an iterator of snapshots `@Vector5` (`span.into_iter()`): a snapshot of the
/// sum of the items, like `Sum<Vector5>`. Upstream: `Sum<&Matrix> for Matrix` (references).
pub impl Vector5SumSnapshot<
    T, impl R: Real<T>, +Add<T>, +Copy<T>, +Drop<T>,
> of core::iter::Sum<@Vector5<T>> {
    fn sum<I, +Iterator<I>[Item: @Vector5<T>], +Destruct<I>, +Destruct<@Vector5<T>>>(
        mut iter: I,
    ) -> @Vector5<T> {
        let Option::Some(first) = iter.next() else {
            return @Vector5 {
                x: R::zero(), y: R::zero(), z: R::zero(), w: R::zero(), a: R::zero(),
            };
        };
        let mut acc = *first;
        while let Option::Some(x) = iter.next() {
            acc = acc + *x;
        }
        @acc
    }
}

