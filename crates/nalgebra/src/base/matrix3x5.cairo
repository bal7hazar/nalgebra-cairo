/// `lhs + rhs`, component-wise. Exact; panics on overflow. Upstream: `Add`.
pub impl Matrix3x5Add<T, +Add<T>, +Copy<T>, +Drop<T>> of Add<Matrix3x5<T>> {
    #[inline(always)]
    fn add(lhs: Matrix3x5<T>, rhs: Matrix3x5<T>) -> Matrix3x5<T> {
        Matrix3x5 {
            m11: lhs.m11 + rhs.m11,
            m21: lhs.m21 + rhs.m21,
            m31: lhs.m31 + rhs.m31,
            m12: lhs.m12 + rhs.m12,
            m22: lhs.m22 + rhs.m22,
            m32: lhs.m32 + rhs.m32,
