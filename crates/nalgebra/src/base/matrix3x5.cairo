    fn map_with_location<
        F, +Drop<F>, impl Func: core::ops::Fn<F, (usize, usize, T)>, +Drop<Func::Output>,
    >(
        self: Matrix3x5<T>, f: F,
    ) -> Matrix3x5<Func::Output> {
        Matrix3x5 {
            m11: f(0, 0, self.m11),
            m21: f(1, 0, self.m21),
            m31: f(2, 0, self.m31),
            m12: f(0, 1, self.m12),
            m22: f(1, 1, self.m22),
            m32: f(2, 1, self.m32),
            m13: f(0, 2, self.m13),
            m23: f(1, 2, self.m23),
            m33: f(2, 2, self.m33),
            m14: f(0, 3, self.m14),
            m24: f(1, 3, self.m24),
            m34: f(2, 3, self.m34),
            m15: f(0, 4, self.m15),
            m25: f(1, 4, self.m25),
            m35: f(2, 4, self.m35),
        }
    }

    /// The 3x5 matrix of `f(a, b)` for the components `a` of `self` and `b` of `rhs` at the same
