    fn map<F, +Drop<F>, impl Func: core::ops::Fn<F, (T,)>, +Drop<Func::Output>>(
        self: Matrix3x5<T>, f: F,
    ) -> Matrix3x5<Func::Output> {
        Matrix3x5 {
            m11: f(self.m11),
            m21: f(self.m21),
            m31: f(self.m31),
            m12: f(self.m12),
            m22: f(self.m22),
            m32: f(self.m32),
            m13: f(self.m13),
            m23: f(self.m23),
            m33: f(self.m33),
            m14: f(self.m14),
            m24: f(self.m24),
            m34: f(self.m34),
            m15: f(self.m15),
            m25: f(self.m25),
            m35: f(self.m35),
        }
    }

    /// The 3x5 matrix of `f(i, j, x)` for every component `x` at row `i`, column `j` (0-based,
    /// column-major order). `f` is any closure or `Fn` value; Cairo closures take their arguments
    /// by value and cannot mutate their captures. Upstream: `map_with_location`.
    #[cfg(feature: 'closures')]
