    fn swap_columns(ref self: Matrix3x5<T>, icol1: usize, icol2: usize) {
        let a = Matrix3x5EditTrait::column_at(self, icol1);
        let b = Matrix3x5EditTrait::column_at(self, icol2);
        Self::set_column(ref self, icol1, b);
        Self::set_column(ref self, icol2, a);
    }

