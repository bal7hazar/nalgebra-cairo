    /// `set_partial_diagonal` (an iterator; a `Span` here).
    #[inline(always)]
    fn set_partial_diagonal(ref self: Matrix3x5<T>, diag: Span<T>) {
        let len = diag.len();
        self =
            Matrix3x5 {
                m11: if len > 0 {
                    *diag[0]
                } else {
                    self.m11
                },
                m21: self.m21,
                m31: self.m31,
                m12: self.m12,
                m22: if len > 1 {
                    *diag[1]
                } else {
                    self.m22
                },
                m32: self.m32,
                m13: self.m13,
                m23: self.m23,
                m33: if len > 2 {
                    *diag[2]
                } else {
                    self.m33
                },
                m14: self.m14,
                m24: self.m24,
                m34: self.m34,
                m15: self.m15,
                m25: self.m25,
                m35: self.m35,
            };
    }

