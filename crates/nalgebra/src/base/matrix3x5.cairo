        self = Self::conjugate(self);
    }

    /// Writes the transpose of `self` into `out`, a `Matrix5x3`. Exact. Upstream: `transpose_to`.
    #[inline(always)]
    fn transpose_to(self: Matrix3x5<T>, ref out: Matrix5x3<T>) {
        out = Self::transpose(self);
    }

    /// Writes the adjoint of `self` (its transpose for a real scalar) into `out`, a `Matrix5x3`.
    /// Exact. Upstream: `adjoint_to`.
    #[inline(always)]
    fn adjoint_to(self: Matrix3x5<T>, ref out: Matrix5x3<T>) {
        out = Self::transpose(self);
    }

    /// Writes the adjoint of `self` (deprecated upstream alias of `adjoint_to`) into `out`, a
    /// `Matrix5x3`. Exact. Upstream: `conjugate_transpose_to`.
    #[inline(always)]
    fn conjugate_transpose_to(self: Matrix3x5<T>, ref out: Matrix5x3<T>) {
        out = Self::transpose(self);
    }

    /// Writes the sum `self + rhs` into `out`. Exact; panics on overflow. Upstream: `add_to`.
    #[inline(always)]
    fn add_to(self: Matrix3x5<T>, rhs: Matrix3x5<T>, ref out: Matrix3x5<T>) {
        out = self + rhs;
    }

    /// Writes the difference `self - rhs` into `out`. Exact; panics on overflow. Upstream:
    /// `sub_to`.
    #[inline(always)]
    fn sub_to(self: Matrix3x5<T>, rhs: Matrix3x5<T>, ref out: Matrix3x5<T>) {
        out = self - rhs;
    }

    /// The norm `norm` of `self`: `EuclideanNorm {}` (`norm`), `LpNorm { p }` (`lp_norm(p)`),
    /// `OneNorm {}` (`one_norm`) or `UniformNorm {}` (`amax`), through their `Norm` impls (static
    /// dispatch). Upstream: `apply_norm` (`&impl Norm<T>`; the markers are `Copy` values here).
    #[inline]
    fn apply_norm<N, +Drop<N>, impl Nm: Norm<N, Matrix3x5<T>, T>>(
        self: Matrix3x5<T>, norm: N,
    ) -> T {
        Nm::norm(@norm, self)
    }

    /// The distance between `self` and `rhs` in the norm `norm` (see `apply_norm`; the Euclidean
    /// one is the fused `metric_distance`, the others the norm of the exact difference). Upstream:
    /// `apply_metric_distance`.
    #[inline]
    fn apply_metric_distance<N, +Drop<N>, impl Nm: Norm<N, Matrix3x5<T>, T>>(
        self: Matrix3x5<T>, rhs: Matrix3x5<T>, norm: N,
    ) -> T {
        Nm::metric_distance(@norm, self, rhs)
    }

    /// The number of rows, 3. Upstream: `nrows`.
    #[inline(always)]
    fn nrows(self: Matrix3x5<T>) -> usize {
        3
    }

    /// The number of columns, 5. Upstream: `ncols`.
    #[inline(always)]
    fn ncols(self: Matrix3x5<T>) -> usize {
        5
    }

    /// `(nrows, ncols)`, `(3, 5)`. Upstream: `shape`.
    #[inline(always)]
    fn shape(self: Matrix3x5<T>) -> (usize, usize) {
        (3, 5)
    }

    /// Whether the shape is square: `false`. Upstream: `is_square`.
    #[inline(always)]
    fn is_square(self: Matrix3x5<T>) -> bool {
        false
    }

    /// The `(row, column)` of the `i`-th component in column-major order: `(i % 3, i / 3)`, one
    /// `DivRem` (no bounds check, like upstream). Upstream: `vector_to_matrix_index`.
    #[inline(always)]
    fn vector_to_matrix_index(self: Matrix3x5<T>, i: usize) -> (usize, usize) {
        let (j, i) = DivRem::div_rem(i, 3);
