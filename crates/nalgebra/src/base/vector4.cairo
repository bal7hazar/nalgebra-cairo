        Vector4 { x: self.x * rhs.x, y: self.y * rhs.y, z: self.z * rhs.z, w: self.w * rhs.w }
    }

    #[inline(always)]
    fn component_div(self: Vector4<T>, rhs: Vector4<T>) -> Vector4<T> {
        Vector4 {
            x: R::div(self.x, rhs.x),
            y: R::div(self.y, rhs.y),
            z: R::div(self.z, rhs.z),
            w: R::div(self.w, rhs.w),
        }
    }

    #[inline(always)]
    fn abs(self: Vector4<T>) -> Vector4<T> {
        Vector4 { x: R::abs(self.x), y: R::abs(self.y), z: R::abs(self.z), w: R::abs(self.w) }
    }

    #[inline(always)]
    fn inf(self: Vector4<T>, other: Vector4<T>) -> Vector4<T> {
        Vector4 {
            x: R::min(self.x, other.x),
            y: R::min(self.y, other.y),
            z: R::min(self.z, other.z),
            w: R::min(self.w, other.w),
        }
    }

    #[inline(always)]
    fn sup(self: Vector4<T>, other: Vector4<T>) -> Vector4<T> {
        Vector4 {
            x: R::max(self.x, other.x),
            y: R::max(self.y, other.y),
            z: R::max(self.z, other.z),
            w: R::max(self.w, other.w),
        }
    }

    #[inline(always)]
    fn inf_sup(self: Vector4<T>, other: Vector4<T>) -> (Vector4<T>, Vector4<T>) {
        (Self::inf(self, other), Self::sup(self, other))
    }

    #[inline(always)]
    fn min(self: Vector4<T>) -> T {
        R::min(R::min(R::min(self.x, self.y), self.z), self.w)
    }

    #[inline(always)]
    fn max(self: Vector4<T>) -> T {
        R::max(R::max(R::max(self.x, self.y), self.z), self.w)
    }

    #[inline(always)]
    fn amin(self: Vector4<T>) -> T {
        R::min(R::min(R::min(R::abs(self.x), R::abs(self.y)), R::abs(self.z)), R::abs(self.w))
    }

    #[inline(always)]
    fn amax(self: Vector4<T>) -> T {
        R::max(R::max(R::max(R::abs(self.x), R::abs(self.y)), R::abs(self.z)), R::abs(self.w))
    }

    #[inline(always)]
    fn imin(self: Vector4<T>) -> usize {
        let (i, m): (usize, T) = if self.x <= self.y {
            (0, self.x)
        } else {
            (1, self.y)
        };
        let (j, p): (usize, T) = if self.z <= self.w {
            (2, self.z)
        } else {
            (3, self.w)
        };
        if m <= p {
            i
        } else {
            j
        }
    }

    #[inline(always)]
    fn imax(self: Vector4<T>) -> usize {
        let (i, m): (usize, T) = if self.x >= self.y {
            (0, self.x)
        } else {
            (1, self.y)
        };
        let (j, p): (usize, T) = if self.z >= self.w {
            (2, self.z)
        } else {
            (3, self.w)
        };
        if m >= p {
            i
        } else {
            j
        }
    }

    #[inline(always)]
    fn iamin(self: Vector4<T>) -> usize {
        Self::imin(Self::abs(self))
    }

    #[inline(always)]
    fn iamax(self: Vector4<T>) -> usize {
        Self::imax(Self::abs(self))
    }

    #[inline(always)]
    fn sum(self: Vector4<T>) -> T {
        self.x + self.y + self.z + self.w
    }

    #[inline(always)]
    fn is_zero(self: Vector4<T>) -> bool {
        self.x == R::zero() && self.y == R::zero() && self.z == R::zero() && self.w == R::zero()
    }

    #[inline(always)]
    fn abs_diff_eq(self: Vector4<T>, other: Vector4<T>, ulps: u64) -> bool {
        R::abs_diff_eq(self.x, other.x, ulps)
            && R::abs_diff_eq(self.y, other.y, ulps)
            && R::abs_diff_eq(self.z, other.z, ulps)
            && R::abs_diff_eq(self.w, other.w, ulps)
    }

    #[inline(always)]
    fn dot(self: Vector4<T>, rhs: Vector4<T>) -> T {
        R::sum_prod4(self.x, rhs.x, self.y, rhs.y, self.z, rhs.z, self.w, rhs.w)
    }

    #[inline(always)]
    fn norm_squared(self: Vector4<T>) -> T {
        R::norm_squared4(self.x, self.y, self.z, self.w)
    }

    #[inline(always)]
    fn norm(self: Vector4<T>) -> T {
        R::norm4(self.x, self.y, self.z, self.w)
    }

    #[inline(always)]
    fn magnitude_squared(self: Vector4<T>) -> T {
        R::norm_squared4(self.x, self.y, self.z, self.w)
    }

    #[inline(always)]
    fn magnitude(self: Vector4<T>) -> T {
        R::norm4(self.x, self.y, self.z, self.w)
    }

    #[inline(always)]
    fn metric_distance(self: Vector4<T>, rhs: Vector4<T>) -> T {
        R::norm4(self.x - rhs.x, self.y - rhs.y, self.z - rhs.z, self.w - rhs.w)
    }

    #[inline(always)]
    fn normalize(self: Vector4<T>) -> Vector4<T> {
        Self::unscale(self, R::norm4(self.x, self.y, self.z, self.w))
    }

    #[inline(always)]
    fn try_normalize(self: Vector4<T>, min_norm: T) -> Option<Vector4<T>> {
        let n = R::norm4(self.x, self.y, self.z, self.w);
        if n <= min_norm {
            None
        } else {
            Some(Self::unscale(self, n))
        }
    }

    #[inline(always)]
    fn cap_magnitude(self: Vector4<T>, max: T) -> Vector4<T> {
        let n = R::norm4(self.x, self.y, self.z, self.w);
        if n <= max {
            self
        } else {
            Self::scale(self, R::div(max, n))
        }
    }

    #[inline(always)]
    fn lerp(self: Vector4<T>, rhs: Vector4<T>, t: T) -> Vector4<T> {
        Vector4 {
            x: R::lerp(self.x, rhs.x, t),
            y: R::lerp(self.y, rhs.y, t),
            z: R::lerp(self.z, rhs.z, t),
            w: R::lerp(self.w, rhs.w, t),
        }
    }

    fn from_fn<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (usize, usize)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        f: F,
    ) -> Vector4<T> {
        Vector4 { x: f(0, 0).into(), y: f(1, 0).into(), z: f(2, 0).into(), w: f(3, 0).into() }
    }

    #[inline(always)]
    fn from_row_slice(data: Span<T>) -> Vector4<T> {
        let boxed: @Box<[T; 4]> = data.try_into().expect(errors::SLICE_LENGTH);
        let [v0, v1, v2, v3] = boxed.unbox();
        Vector4 { x: v0, y: v1, z: v2, w: v3 }
    }

    #[inline(always)]
    fn from_column_slice(data: Span<T>) -> Vector4<T> {
        let boxed: @Box<[T; 4]> = data.try_into().expect(errors::SLICE_LENGTH);
        let [v0, v1, v2, v3] = boxed.unbox();
        Vector4 { x: v0, y: v1, z: v2, w: v3 }
    }

    #[inline(always)]
    fn from_partial_diagonal(data: Span<T>) -> Vector4<T> {
        let len = data.len();
        if len > 1 {
            core::panic_with_felt252(errors::TOO_MANY_DIAGONAL);
        }
        Vector4 {
            x: if len > 0 {
                *data[0]
            } else {
                R::zero()
            }, y: R::zero(), z: R::zero(), w: R::zero(),
        }
    }

    #[inline(always)]
    fn ith(i: usize, val: T) -> Vector4<T> {
        match i {
            0 => Vector4 { x: val, y: R::zero(), z: R::zero(), w: R::zero() },
            1 => Vector4 { x: R::zero(), y: val, z: R::zero(), w: R::zero() },
            2 => Vector4 { x: R::zero(), y: R::zero(), z: val, w: R::zero() },
            3 => Vector4 { x: R::zero(), y: R::zero(), z: R::zero(), w: val },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    #[inline(always)]
    fn ith_axis(i: usize) -> Unit<Vector4<T>> {
        Unit { value: Self::ith(i, R::one()) }
    }

    #[inline(always)]
    fn component_mul_assign(ref self: Vector4<T>, rhs: Vector4<T>) {
        self =
            Vector4 { x: self.x * rhs.x, y: self.y * rhs.y, z: self.z * rhs.z, w: self.w * rhs.w };
    }

    #[inline(always)]
    fn component_div_assign(ref self: Vector4<T>, rhs: Vector4<T>) {
        self =
            Vector4 {
                x: R::div(self.x, rhs.x),
                y: R::div(self.y, rhs.y),
                z: R::div(self.z, rhs.z),
                w: R::div(self.w, rhs.w),
            };
    }

    #[inline(always)]
    fn add_scalar(self: Vector4<T>, k: T) -> Vector4<T> {
        Vector4 { x: self.x + k, y: self.y + k, z: self.z + k, w: self.w + k }
    }

    #[inline(always)]
    fn cmpy(ref self: Vector4<T>, alpha: T, a: Vector4<T>, b: Vector4<T>, beta: T) {
        self =
            Vector4 {
                x: R::sum_prod2(alpha * a.x, b.x, beta, self.x),
                y: R::sum_prod2(alpha * a.y, b.y, beta, self.y),
                z: R::sum_prod2(alpha * a.z, b.z, beta, self.z),
                w: R::sum_prod2(alpha * a.w, b.w, beta, self.w),
            };
    }

    #[inline(always)]
    fn cdpy(ref self: Vector4<T>, alpha: T, a: Vector4<T>, b: Vector4<T>, beta: T) {
        self =
            Vector4 {
                x: R::mul_add(beta, self.x, R::div(alpha * a.x, b.x)),
                y: R::mul_add(beta, self.y, R::div(alpha * a.y, b.y)),
                z: R::mul_add(beta, self.z, R::div(alpha * a.z, b.z)),
                w: R::mul_add(beta, self.w, R::div(alpha * a.w, b.w)),
            };
    }

    #[inline(always)]
    fn camin(self: Vector4<T>) -> T {
        R::min(R::min(R::min(R::abs(self.x), R::abs(self.y)), R::abs(self.z)), R::abs(self.w))
    }

    #[inline(always)]
    fn camax(self: Vector4<T>) -> T {
        R::max(R::max(R::max(R::abs(self.x), R::abs(self.y)), R::abs(self.z)), R::abs(self.w))
    }

    #[inline(always)]
    fn iamax_full(self: Vector4<T>) -> (usize, usize) {
        let mut best: (usize, usize) = (0, 0);
        let mut m = R::abs(self.x);
        let v = R::abs(self.y);
        if v > m {
            m = v;
            best = (1, 0);
        }
        let v = R::abs(self.z);
        if v > m {
            m = v;
            best = (2, 0);
        }
        let v = R::abs(self.w);
        if v > m {
            best = (3, 0);
        }
        best
    }

    #[inline(always)]
    fn icamax_full(self: Vector4<T>) -> (usize, usize) {
        Self::iamax_full(self)
    }

    #[inline(always)]
    fn argmin(self: Vector4<T>) -> (usize, T) {
        let mut i: usize = 0;
        let mut m = self.x;
        if self.y < m {
            m = self.y;
            i = 1;
        }
        if self.z < m {
            m = self.z;
            i = 2;
        }
        if self.w < m {
            m = self.w;
            i = 3;
        }
        (i, m)
    }

    #[inline(always)]
    fn argmax(self: Vector4<T>) -> (usize, T) {
        let mut i: usize = 0;
        let mut m = self.x;
        if self.y > m {
            m = self.y;
            i = 1;
        }
        if self.z > m {
            m = self.z;
            i = 2;
        }
        if self.w > m {
            m = self.w;
            i = 3;
        }
        (i, m)
    }

    #[inline(always)]
    fn icamax(self: Vector4<T>) -> usize {
        Self::iamax(self)
    }

    #[inline(always)]
    fn try_set_magnitude(ref self: Vector4<T>, magnitude: T, min_magnitude: T) {
        let n = Self::norm(self);
        if n > min_magnitude {
            self = Self::scale(self, R::div(magnitude, n));
        }
    }

    #[inline(always)]
    fn one_norm(self: Vector4<T>) -> T {
        R::abs(self.x) + R::abs(self.y) + R::abs(self.z) + R::abs(self.w)
    }

    #[inline(always)]
    fn adjoint(self: Vector4<T>) -> RowVector4<T> {
        Self::transpose(self)
    }

    #[inline(always)]
    fn conjugate_transpose(self: Vector4<T>) -> RowVector4<T> {
        Self::transpose(self)
    }

    #[inline(always)]
    fn conjugate(self: Vector4<T>) -> Vector4<T> {
        self
    }

    #[inline(always)]
    fn push(self: Vector4<T>, val: T) -> Vector5<T> {
        Vector5 { x: self.x, y: self.y, z: self.z, w: self.w, a: val }
    }

    #[inline(always)]
    fn to_homogeneous(self: Vector4<T>) -> Vector5<T> {
        Vector5 { x: self.x, y: self.y, z: self.z, w: self.w, a: R::zero() }
    }

    #[inline(always)]
    fn from_homogeneous(v: Vector5<T>) -> Option<Vector4<T>> {
        if v.a == R::zero() {
            Some(Vector4 { x: v.x, y: v.y, z: v.z, w: v.w })
        } else {
            None
        }
    }

    fn orthonormalize(ref vs: Array<Vector4<T>>) -> usize {
        let mut basis: Array<Vector4<T>> = array![];
        let mut deps: Array<Vector4<T>> = array![];
        let mut rest = vs.span();
        let mut nb: usize = 0;
        while nb < 4 {
            let v = match rest.pop_front() {
                Option::Some(v) => *v,
                Option::None => { break; },
            };
            let mut elt = v;
            for b in basis.span() {
                let b = *b;
                let d = Self::dot(elt, b);
                elt =
                    Vector4 {
                        x: R::diff_prod(elt.x, R::one(), b.x, d),
                        y: R::diff_prod(elt.y, R::one(), b.y, d),
                        z: R::diff_prod(elt.z, R::one(), b.z, d),
                        w: R::diff_prod(elt.w, R::one(), b.w, d),
                    };
            }
            let n = Self::norm(elt);
            if n > R::zero() {
                basis.append(Self::unscale(elt, n));
                nb += 1;
                if let Option::Some(first) = deps.pop_front() {
                    deps.append(first);
                }
            } else {
                deps.append(elt);
            }
        }
        for d in deps.span() {
            basis.append(*d);
        }
        for r in rest {
            basis.append(*r);
        }
        vs = basis;
        nb
    }

    fn cast<U, +Into<T, U>, +Drop<U>>(self: Vector4<T>) -> Vector4<U> {
        Vector4 { x: self.x.into(), y: self.y.into(), z: self.z.into(), w: self.w.into() }
    }

    fn try_cast<U, +TryInto<T, U>, +Drop<U>>(self: Vector4<T>) -> Option<Vector4<U>> {
        let x: U = self.x.try_into()?;
        let y: U = self.y.try_into()?;
        let z: U = self.z.try_into()?;
        let w: U = self.w.try_into()?;
        Option::Some(Vector4 { x, y, z, w })
    }

    #[inline(always)]
    fn relative_eq(self: Vector4<T>, other: Vector4<T>, epsilon: u64, max_relative: T) -> bool {
        ApproxEqTrait::relative_eq(self.x, other.x, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.y, other.y, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.z, other.z, epsilon, max_relative)
            && ApproxEqTrait::relative_eq(self.w, other.w, epsilon, max_relative)
    }

    #[inline(always)]
    fn ulps_eq(self: Vector4<T>, other: Vector4<T>, epsilon: u64, max_ulps: u32) -> bool {
        ApproxEqTrait::ulps_eq(self.x, other.x, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.y, other.y, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.z, other.z, epsilon, max_ulps)
            && ApproxEqTrait::ulps_eq(self.w, other.w, epsilon, max_ulps)
    }
}

pub impl Vector4AngleImpl<
    T,
    impl R: Real<T>,
    impl Tr: Transcendental<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Vector4AngleTrait<T> {
    fn angle(self: Vector4<T>, other: Vector4<T>) -> T {
        let n1 = R::norm4(self.x, self.y, self.z, self.w);
        let n2 = R::norm4(other.x, other.y, other.z, other.w);
        if n1 == R::zero() || n2 == R::zero() {
            return R::zero();
        }
        let (ux, uy, uz, uw) = R::div4(self.x, self.y, self.z, self.w, n1);
        let (vx, vy, vz, vw) = R::div4(other.x, other.y, other.z, other.w, n2);
        let u = Vector4 { x: ux, y: uy, z: uz, w: uw };
        let v = Vector4 { x: vx, y: vy, z: vz, w: vw };
        let d = R::norm4(u.x - v.x, u.y - v.y, u.z - v.z, u.w - v.w);
        let s = R::norm4(u.x + v.x, u.y + v.y, u.z + v.z, u.w + v.w);
        let half = Tr::atan2(d, s);
        half + half
    }

    fn lp_norm(self: Vector4<T>, p: i32) -> T {
        if p < 1 {
            core::panic_with_felt252(errors::LP_NORM_P);
        }
        if p == 1 {
            return R::abs(self.x) + R::abs(self.y) + R::abs(self.z) + R::abs(self.w);
        }
        if p == 2 {
            return Vector4Trait::norm(self);
        }
        let m = Vector4Trait::amax(self);
        if m == R::zero() {
            return R::zero();
        }
        let r = Vector4Trait::unscale(Vector4Trait::abs(self), m);
        let q: u32 = p.try_into().unwrap();
        let s = Powi::powi(r.x, q) + Powi::powi(r.y, q) + Powi::powi(r.z, q) + Powi::powi(r.w, q);
        m * Tr::exp(R::div(Tr::ln(s), R::from_int(p)))
    }

    fn slerp(self: Vector4<T>, rhs: Vector4<T>, t: T) -> Vector4<T> {
        let me = Vector4Trait::normalize(self);
        let other = Vector4Trait::normalize(rhs);
        slerp_unit(me, other, t, R::default_epsilon()).unwrap_or(me)
    }
}

