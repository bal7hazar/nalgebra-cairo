        self: RowVector6<T>, init: Matrix1<T>, f: F,
    ) -> Matrix1<T> {
        f(
            f(
                f(
                    f(
                        f(f(init, Matrix1 { x: self.x }).into(), Matrix1 { x: self.y }).into(),
                        Matrix1 { x: self.z },
                    )
                        .into(),
                    Matrix1 { x: self.w },
                )
                    .into(),
                Matrix1 { x: self.a },
            )
                .into(),
            Matrix1 { x: self.b },
        )
            .into()
    }
}

