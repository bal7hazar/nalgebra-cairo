/// The members of the static `Matrix3x5` that come with the dynamic matrices (DESIGN D5, feature
/// `dynamic`): the edition forms with a dynamic result, `from_vec`, `from_iterator`,
/// `from_row_iterator`, `len`, `is_empty`, `compress_*`.
#[generate_trait]
pub impl Matrix3x5DynamicImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix3x5DynamicTrait<T> {
    /// The 3x5 matrix of the 15 values of `data` in COLUMN-major order. Panics with `nalgebra:
    /// wrong slice length` unless `data.len() == 15`. Upstream: `Matrix3x5::from_vec(Vec<T>)`.
    #[inline]
    fn from_vec(data: Array<T>) -> Matrix3x5<T> {
        Matrix3x5Trait::from_column_slice(data.span())
    }

    /// The 3x5 matrix of the values of `data` in COLUMN-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 15`. Upstream: `Matrix3x5::from_iterator(iter)` (a
    /// `Span` of exactly the length here).
    #[inline]
    fn from_iterator(data: Span<T>) -> Matrix3x5<T> {
        Matrix3x5Trait::from_column_slice(data)
    }

    /// The 3x5 matrix of the values of `data` in ROW-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 15`. Upstream: `Matrix3x5::from_row_iterator(iter)` (a
    /// `Span` here).
    #[inline]
    fn from_row_iterator(data: Span<T>) -> Matrix3x5<T> {
        Matrix3x5Trait::from_row_slice(data)
    }

    /// The number of components, 15. Upstream: `len`.
    #[inline(always)]
    fn len(self: Matrix3x5<T>) -> usize {
        15
    }

    /// `false`: a static shape has at least one component. Upstream: `is_empty`.
    #[inline(always)]
    fn is_empty(self: Matrix3x5<T>) -> bool {
        false
    }

    /// `self` with `n` columns of `val` inserted at index `i` (`i <= 5`; panics with `nalgebra:
    /// index out of bounds` otherwise), a `Matrix3xX` (`DMatrix`). Upstream: `insert_columns`
    /// (`OMatrix<U3, Dyn>`).
    #[inline]
    fn insert_columns(self: Matrix3x5<T>, i: usize, n: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.insert_columns(i, n, val)
    }

    /// `self` with `n` rows of `val` inserted at index `i` (`i <= 3`; panics with `nalgebra: index
    /// out of bounds` otherwise), a `MatrixXx5` (`DMatrix`). Upstream: `insert_rows` (`OMatrix<U3,
    /// Dyn>`).
    #[inline]
    fn insert_rows(self: Matrix3x5<T>, i: usize, n: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.insert_rows(i, n, val)
    }

    /// `self` without the columns `i .. i + n` (`i + n <= 5`; panics with `nalgebra: index out of
    /// bounds` otherwise), a `Matrix3xX` (`DMatrix`). Upstream: `remove_columns` (`OMatrix<U3,
    /// Dyn>`).
    #[inline]
    fn remove_columns(self: Matrix3x5<T>, i: usize, n: usize) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_columns(i, n)
    }

    /// `self` without the rows `i .. i + n` (`i + n <= 3`; panics with `nalgebra: index out of
    /// bounds` otherwise), a `MatrixXx5` (`DMatrix`). Upstream: `remove_rows` (`OMatrix<U3, Dyn>`).
    #[inline]
    fn remove_rows(self: Matrix3x5<T>, i: usize, n: usize) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_rows(i, n)
    }

    /// `self` without the columns whose index is in `indices` (repeated or out of range indices are
    /// ignored), a `Matrix3xX` (`DMatrix`). Upstream: `remove_columns_at` (`OMatrix<U3, Dyn>`).
    #[inline]
    fn remove_columns_at(self: Matrix3x5<T>, indices: Span<usize>) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_columns_at(indices)
    }

    /// `self` without the rows whose index is in `indices` (repeated or out of range indices are
    /// ignored), a `MatrixXx5` (`DMatrix`). Upstream: `remove_rows_at` (`OMatrix<U3, Dyn>`).
    #[inline]
    fn remove_rows_at(self: Matrix3x5<T>, indices: Span<usize>) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_rows_at(indices)
    }

    /// `self` with `new_ncols` columns, the common columns kept, the new components `val`, a
    /// `Matrix3xX` (`DMatrix`). Upstream: `resize_horizontally` (`OMatrix<U3, Dyn>`).
    #[inline]
    fn resize_horizontally(self: Matrix3x5<T>, new_ncols: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.resize_horizontally(new_ncols, val)
    }

    /// `self` with `new_nrows` rows, the common rows kept, the new components `val`, a `MatrixXx5`
    /// (`DMatrix`). Upstream: `resize_vertically` (`OMatrix<U3, Dyn>`).
    #[inline]
    fn resize_vertically(self: Matrix3x5<T>, new_nrows: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.resize_vertically(new_nrows, val)
    }

    /// The row vector of `f(column)` for the 5 columns (a `Vector3` each). `f`'s output converts
    /// `Into<T>`. Upstream: `compress_rows` (`f` takes a column view).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_rows<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector3<T>,)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        self: Matrix3x5<T>, f: F,
    ) -> RowVector5<T> {
        RowVector5 {
            x: f(Vector3 { x: self.m11, y: self.m21, z: self.m31 }).into(),
            y: f(Vector3 { x: self.m12, y: self.m22, z: self.m32 }).into(),
            z: f(Vector3 { x: self.m13, y: self.m23, z: self.m33 }).into(),
            w: f(Vector3 { x: self.m14, y: self.m24, z: self.m34 }).into(),
            a: f(Vector3 { x: self.m15, y: self.m25, z: self.m35 }).into(),
        }
    }

    /// The column vector of `f(column)` for the 5 columns. Upstream: `compress_rows_tr`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_rows_tr<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector3<T>,)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        self: Matrix3x5<T>, f: F,
    ) -> Vector5<T> {
        Vector5 {
            x: f(Vector3 { x: self.m11, y: self.m21, z: self.m31 }).into(),
            y: f(Vector3 { x: self.m12, y: self.m22, z: self.m32 }).into(),
            z: f(Vector3 { x: self.m13, y: self.m23, z: self.m33 }).into(),
            w: f(Vector3 { x: self.m14, y: self.m24, z: self.m34 }).into(),
            a: f(Vector3 { x: self.m15, y: self.m25, z: self.m35 }).into(),
        }
    }

    /// `init` folded with every column, `acc = f(acc, column)` from the first to the last. `f`'s
    /// output converts `Into<Vector3>`. Upstream: `compress_columns(init, f)` (`f` mutates `&mut
    /// acc`; Cairo closures take and return it by value).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_columns<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector3<T>, Vector3<T>)>,
        +Into<Func::Output, Vector3<T>>,
        +Drop<Func::Output>,
    >(
        self: Matrix3x5<T>, init: Vector3<T>, f: F,
    ) -> Vector3<T> {
        f(
            f(
                f(
                    f(
                        f(init, Vector3 { x: self.m11, y: self.m21, z: self.m31 }).into(),
                        Vector3 { x: self.m12, y: self.m22, z: self.m32 },
                    )
                        .into(),
                    Vector3 { x: self.m13, y: self.m23, z: self.m33 },
                )
                    .into(),
                Vector3 { x: self.m14, y: self.m24, z: self.m34 },
            )
                .into(),
            Vector3 { x: self.m15, y: self.m25, z: self.m35 },
        )
            .into()
    }
}

