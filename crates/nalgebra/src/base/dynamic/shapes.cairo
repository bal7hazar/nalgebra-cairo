    /// The 4x6 matrix of the 24 values of `data` in COLUMN-major order. Panics with `nalgebra:
    /// wrong slice length` unless `data.len() == 24`. Upstream: `Matrix4x6::from_vec(Vec<T>)`.
    #[inline]
    fn from_vec(data: Array<T>) -> Matrix4x6<T> {
        Matrix4x6Trait::from_column_slice(data.span())
    }

    /// The 4x6 matrix of the values of `data` in COLUMN-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 24`. Upstream: `Matrix4x6::from_iterator(iter)` (a
    /// `Span` of exactly the length here).
    #[inline]
