        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        self: RowVector6<T>, f: F,
    ) -> Vector6<T> {
        Vector6 {
            x: f(Matrix1 { x: self.x }).into(),
            y: f(Matrix1 { x: self.y }).into(),
            z: f(Matrix1 { x: self.z }).into(),
            w: f(Matrix1 { x: self.w }).into(),
            a: f(Matrix1 { x: self.a }).into(),
            b: f(Matrix1 { x: self.b }).into(),
