/// The members of the static `Matrix5x3` that come with the dynamic matrices (DESIGN D5, feature
/// `dynamic`): the edition forms with a dynamic result, `from_vec`, `from_iterator`,
/// `from_row_iterator`, `len`, `is_empty`, `compress_*`.
#[generate_trait]
pub impl Matrix5x3DynamicImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5x3DynamicTrait<T> {
    /// The 5x3 matrix of the 15 values of `data` in COLUMN-major order. Panics with `nalgebra:
    /// wrong slice length` unless `data.len() == 15`. Upstream: `Matrix5x3::from_vec(Vec<T>)`.
    #[inline]
    fn from_vec(data: Array<T>) -> Matrix5x3<T> {
        Matrix5x3Trait::from_column_slice(data.span())
    }

    /// The 5x3 matrix of the values of `data` in COLUMN-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 15`. Upstream: `Matrix5x3::from_iterator(iter)` (a
    /// `Span` of exactly the length here).
    #[inline]
    fn from_iterator(data: Span<T>) -> Matrix5x3<T> {
        Matrix5x3Trait::from_column_slice(data)
    }

    /// The 5x3 matrix of the values of `data` in ROW-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 15`. Upstream: `Matrix5x3::from_row_iterator(iter)` (a
    /// `Span` here).
    #[inline]
    fn from_row_iterator(data: Span<T>) -> Matrix5x3<T> {
        Matrix5x3Trait::from_row_slice(data)
    }

    /// The number of components, 15. Upstream: `len`.
    #[inline(always)]
    fn len(self: Matrix5x3<T>) -> usize {
        15
    }

    /// `false`: a static shape has at least one component. Upstream: `is_empty`.
    #[inline(always)]
    fn is_empty(self: Matrix5x3<T>) -> bool {
        false
    }

    /// `self` with `n` columns of `val` inserted at index `i` (`i <= 3`; panics with `nalgebra:
    /// index out of bounds` otherwise), a `Matrix5xX` (`DMatrix`). Upstream: `insert_columns`
    /// (`OMatrix<U5, Dyn>`).
    #[inline]
    fn insert_columns(self: Matrix5x3<T>, i: usize, n: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.insert_columns(i, n, val)
    }

    /// `self` with `n` rows of `val` inserted at index `i` (`i <= 5`; panics with `nalgebra: index
    /// out of bounds` otherwise), a `MatrixXx3` (`DMatrix`). Upstream: `insert_rows` (`OMatrix<U5,
    /// Dyn>`).
    #[inline]
    fn insert_rows(self: Matrix5x3<T>, i: usize, n: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.insert_rows(i, n, val)
    }

    /// `self` without the columns `i .. i + n` (`i + n <= 3`; panics with `nalgebra: index out of
    /// bounds` otherwise), a `Matrix5xX` (`DMatrix`). Upstream: `remove_columns` (`OMatrix<U5,
    /// Dyn>`).
    #[inline]
    fn remove_columns(self: Matrix5x3<T>, i: usize, n: usize) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_columns(i, n)
    }

    /// `self` without the rows `i .. i + n` (`i + n <= 5`; panics with `nalgebra: index out of
    /// bounds` otherwise), a `MatrixXx3` (`DMatrix`). Upstream: `remove_rows` (`OMatrix<U5, Dyn>`).
    #[inline]
    fn remove_rows(self: Matrix5x3<T>, i: usize, n: usize) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_rows(i, n)
    }

    /// `self` without the columns whose index is in `indices` (repeated or out of range indices are
    /// ignored), a `Matrix5xX` (`DMatrix`). Upstream: `remove_columns_at` (`OMatrix<U5, Dyn>`).
    #[inline]
    fn remove_columns_at(self: Matrix5x3<T>, indices: Span<usize>) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_columns_at(indices)
    }

    /// `self` without the rows whose index is in `indices` (repeated or out of range indices are
    /// ignored), a `MatrixXx3` (`DMatrix`). Upstream: `remove_rows_at` (`OMatrix<U5, Dyn>`).
    #[inline]
    fn remove_rows_at(self: Matrix5x3<T>, indices: Span<usize>) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_rows_at(indices)
    }

    /// `self` with `new_ncols` columns, the common columns kept, the new components `val`, a
    /// `Matrix5xX` (`DMatrix`). Upstream: `resize_horizontally` (`OMatrix<U5, Dyn>`).
    #[inline]
    fn resize_horizontally(self: Matrix5x3<T>, new_ncols: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.resize_horizontally(new_ncols, val)
    }

    /// `self` with `new_nrows` rows, the common rows kept, the new components `val`, a `MatrixXx3`
    /// (`DMatrix`). Upstream: `resize_vertically` (`OMatrix<U5, Dyn>`).
    #[inline]
    fn resize_vertically(self: Matrix5x3<T>, new_nrows: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.resize_vertically(new_nrows, val)
    }

    /// The row vector of `f(column)` for the 3 columns (a `Vector5` each). `f`'s output converts
    /// `Into<T>`. Upstream: `compress_rows` (`f` takes a column view).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_rows<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector5<T>,)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        self: Matrix5x3<T>, f: F,
    ) -> RowVector3<T> {
        RowVector3 {
            x: f(Vector5 { x: self.m11, y: self.m21, z: self.m31, w: self.m41, a: self.m51 })
                .into(),
            y: f(Vector5 { x: self.m12, y: self.m22, z: self.m32, w: self.m42, a: self.m52 })
                .into(),
            z: f(Vector5 { x: self.m13, y: self.m23, z: self.m33, w: self.m43, a: self.m53 })
                .into(),
        }
    }

    /// The column vector of `f(column)` for the 3 columns. Upstream: `compress_rows_tr`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_rows_tr<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector5<T>,)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        self: Matrix5x3<T>, f: F,
    ) -> Vector3<T> {
        Vector3 {
            x: f(Vector5 { x: self.m11, y: self.m21, z: self.m31, w: self.m41, a: self.m51 })
                .into(),
            y: f(Vector5 { x: self.m12, y: self.m22, z: self.m32, w: self.m42, a: self.m52 })
                .into(),
            z: f(Vector5 { x: self.m13, y: self.m23, z: self.m33, w: self.m43, a: self.m53 })
                .into(),
        }
    }

    /// `init` folded with every column, `acc = f(acc, column)` from the first to the last. `f`'s
    /// output converts `Into<Vector5>`. Upstream: `compress_columns(init, f)` (`f` mutates `&mut
    /// acc`; Cairo closures take and return it by value).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_columns<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector5<T>, Vector5<T>)>,
        +Into<Func::Output, Vector5<T>>,
        +Drop<Func::Output>,
    >(
        self: Matrix5x3<T>, init: Vector5<T>, f: F,
    ) -> Vector5<T> {
        f(
            f(
                f(init, Vector5 { x: self.m11, y: self.m21, z: self.m31, w: self.m41, a: self.m51 })
                    .into(),
                Vector5 { x: self.m12, y: self.m22, z: self.m32, w: self.m42, a: self.m52 },
            )
                .into(),
            Vector5 { x: self.m13, y: self.m23, z: self.m33, w: self.m43, a: self.m53 },
        )
            .into()
    }
}

