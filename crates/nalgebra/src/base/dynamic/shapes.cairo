    /// output converts `Into<Matrix1>`. Upstream: `compress_columns(init, f)` (`f` mutates `&mut
    /// acc`; Cairo closures take and return it by value).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_columns<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Matrix1<T>, Matrix1<T>)>,
        +Into<Func::Output, Matrix1<T>>,
        +Drop<Func::Output>,
