    fn remove_rows_at(self: Vector4<T>, indices: Span<usize>) -> DVector<T> {
        let d: DVector<T> = self.into();
        d.remove_rows_at(indices)
    }

    /// `self` with `new_ncols` columns, the common columns kept, the new components `val`, a
    /// `Matrix4xX` (`DMatrix`). Upstream: `resize_horizontally` (`OMatrix<U4, Dyn>`).
