            data: array![
                self.m11, self.m21, self.m31, self.m41, self.m12, self.m22, self.m32, self.m42,
                self.m13, self.m23, self.m33, self.m43, self.m14, self.m24, self.m34, self.m44,
                self.m15, self.m25, self.m35, self.m45, self.m16, self.m26, self.m36, self.m46,
            ]
                .span(),
            nrows: 4,
            ncols: 6,
        }
    }
}

/// The members of the static `Matrix4x6` that come with the dynamic matrices (DESIGN D5, feature
/// `dynamic`): the edition forms with a dynamic result, `from_vec`, `from_iterator`,
/// `from_row_iterator`, `len`, `is_empty`, `compress_*`.
#[generate_trait]
pub impl Matrix4x6DynamicImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
