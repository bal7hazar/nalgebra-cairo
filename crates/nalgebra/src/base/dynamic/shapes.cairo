    /// output converts `Into<Vector5>`. Upstream: `compress_columns(init, f)` (`f` mutates `&mut
    /// acc`; Cairo closures take and return it by value).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_columns<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector5<T>, Vector5<T>)>,
        +Into<Func::Output, Vector5<T>>,
        +Drop<Func::Output>,
    >(
        self: Matrix5x6<T>, init: Vector5<T>, f: F,
    ) -> Vector5<T> {
        f(
            f(
                f(
                    f(
                        f(
                            f(
                                init,
                                Vector5 {
                                    x: self.m11, y: self.m21, z: self.m31, w: self.m41, a: self.m51,
                                },
                            )
                                .into(),
                            Vector5 {
                                x: self.m12, y: self.m22, z: self.m32, w: self.m42, a: self.m52,
                            },
                        )
                            .into(),
                        Vector5 { x: self.m13, y: self.m23, z: self.m33, w: self.m43, a: self.m53 },
                    )
                        .into(),
                    Vector5 { x: self.m14, y: self.m24, z: self.m34, w: self.m44, a: self.m54 },
                )
                    .into(),
                Vector5 { x: self.m15, y: self.m25, z: self.m35, w: self.m45, a: self.m55 },
            )
                .into(),
            Vector5 { x: self.m16, y: self.m26, z: self.m36, w: self.m46, a: self.m56 },
