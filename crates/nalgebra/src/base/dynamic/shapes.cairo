/// The members of the static `Matrix4` that come with the dynamic matrices (DESIGN D5, feature
/// `dynamic`): the edition forms with a dynamic result, `from_vec`, `from_iterator`,
/// `from_row_iterator`, `len`, `is_empty`, `compress_*`.
#[generate_trait]
pub impl Matrix4DynamicImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix4DynamicTrait<T> {
    /// The 4x4 matrix of the 16 values of `data` in COLUMN-major order. Panics with `nalgebra:
    /// wrong slice length` unless `data.len() == 16`. Upstream: `Matrix4::from_vec(Vec<T>)`.
    #[inline]
    fn from_vec(data: Array<T>) -> Matrix4<T> {
        Matrix4Trait::from_column_slice(data.span())
    }

    /// The 4x4 matrix of the values of `data` in COLUMN-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 16`. Upstream: `Matrix4::from_iterator(iter)` (a `Span`
    /// of exactly the length here).
    #[inline]
    fn from_iterator(data: Span<T>) -> Matrix4<T> {
        Matrix4Trait::from_column_slice(data)
    }

    /// The 4x4 matrix of the values of `data` in ROW-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 16`. Upstream: `Matrix4::from_row_iterator(iter)` (a
    /// `Span` here).
    #[inline]
    fn from_row_iterator(data: Span<T>) -> Matrix4<T> {
        Matrix4Trait::from_row_slice(data)
    }

    /// The number of components, 16. Upstream: `len`.
    #[inline(always)]
    fn len(self: Matrix4<T>) -> usize {
        16
    }

    /// `false`: a static shape has at least one component. Upstream: `is_empty`.
    #[inline(always)]
    fn is_empty(self: Matrix4<T>) -> bool {
        false
    }

    /// `self` with `n` columns of `val` inserted at index `i` (`i <= 4`; panics with `nalgebra:
    /// index out of bounds` otherwise), a `Matrix4xX` (`DMatrix`). Upstream: `insert_columns`
    /// (`OMatrix<U4, Dyn>`).
    #[inline]
    fn insert_columns(self: Matrix4<T>, i: usize, n: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.insert_columns(i, n, val)
    }

    /// `self` with `n` rows of `val` inserted at index `i` (`i <= 4`; panics with `nalgebra: index
    /// out of bounds` otherwise), a `MatrixXx4` (`DMatrix`). Upstream: `insert_rows` (`OMatrix<U4,
    /// Dyn>`).
    #[inline]
    fn insert_rows(self: Matrix4<T>, i: usize, n: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.insert_rows(i, n, val)
    }

    /// `self` without the columns `i .. i + n` (`i + n <= 4`; panics with `nalgebra: index out of
    /// bounds` otherwise), a `Matrix4xX` (`DMatrix`). Upstream: `remove_columns` (`OMatrix<U4,
    /// Dyn>`).
    #[inline]
    fn remove_columns(self: Matrix4<T>, i: usize, n: usize) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_columns(i, n)
    }

    /// `self` without the rows `i .. i + n` (`i + n <= 4`; panics with `nalgebra: index out of
    /// bounds` otherwise), a `MatrixXx4` (`DMatrix`). Upstream: `remove_rows` (`OMatrix<U4, Dyn>`).
    #[inline]
    fn remove_rows(self: Matrix4<T>, i: usize, n: usize) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_rows(i, n)
    }

    /// `self` without the columns whose index is in `indices` (repeated or out of range indices are
    /// ignored), a `Matrix4xX` (`DMatrix`). Upstream: `remove_columns_at` (`OMatrix<U4, Dyn>`).
    #[inline]
    fn remove_columns_at(self: Matrix4<T>, indices: Span<usize>) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_columns_at(indices)
    }

    /// `self` without the rows whose index is in `indices` (repeated or out of range indices are
    /// ignored), a `MatrixXx4` (`DMatrix`). Upstream: `remove_rows_at` (`OMatrix<U4, Dyn>`).
    #[inline]
    fn remove_rows_at(self: Matrix4<T>, indices: Span<usize>) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_rows_at(indices)
    }

    /// `self` with `new_ncols` columns, the common columns kept, the new components `val`, a
    /// `Matrix4xX` (`DMatrix`). Upstream: `resize_horizontally` (`OMatrix<U4, Dyn>`).
    #[inline]
    fn resize_horizontally(self: Matrix4<T>, new_ncols: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.resize_horizontally(new_ncols, val)
    }

    /// `self` with `new_nrows` rows, the common rows kept, the new components `val`, a `MatrixXx4`
    /// (`DMatrix`). Upstream: `resize_vertically` (`OMatrix<U4, Dyn>`).
    #[inline]
    fn resize_vertically(self: Matrix4<T>, new_nrows: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.resize_vertically(new_nrows, val)
    }

    /// The row vector of `f(column)` for the 4 columns (a `Vector4` each). `f`'s output converts
    /// `Into<T>`. Upstream: `compress_rows` (`f` takes a column view).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_rows<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector4<T>,)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        self: Matrix4<T>, f: F,
    ) -> RowVector4<T> {
        RowVector4 {
            x: f(Vector4 { x: self.m11, y: self.m21, z: self.m31, w: self.m41 }).into(),
            y: f(Vector4 { x: self.m12, y: self.m22, z: self.m32, w: self.m42 }).into(),
            z: f(Vector4 { x: self.m13, y: self.m23, z: self.m33, w: self.m43 }).into(),
            w: f(Vector4 { x: self.m14, y: self.m24, z: self.m34, w: self.m44 }).into(),
        }
    }

    /// The column vector of `f(column)` for the 4 columns. Upstream: `compress_rows_tr`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_rows_tr<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector4<T>,)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        self: Matrix4<T>, f: F,
    ) -> Vector4<T> {
        Vector4 {
            x: f(Vector4 { x: self.m11, y: self.m21, z: self.m31, w: self.m41 }).into(),
            y: f(Vector4 { x: self.m12, y: self.m22, z: self.m32, w: self.m42 }).into(),
            z: f(Vector4 { x: self.m13, y: self.m23, z: self.m33, w: self.m43 }).into(),
            w: f(Vector4 { x: self.m14, y: self.m24, z: self.m34, w: self.m44 }).into(),
        }
    }

    /// `init` folded with every column, `acc = f(acc, column)` from the first to the last. `f`'s
    /// output converts `Into<Vector4>`. Upstream: `compress_columns(init, f)` (`f` mutates `&mut
    /// acc`; Cairo closures take and return it by value).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_columns<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector4<T>, Vector4<T>)>,
        +Into<Func::Output, Vector4<T>>,
        +Drop<Func::Output>,
    >(
        self: Matrix4<T>, init: Vector4<T>, f: F,
    ) -> Vector4<T> {
        f(
            f(
                f(
                    f(init, Vector4 { x: self.m11, y: self.m21, z: self.m31, w: self.m41 }).into(),
                    Vector4 { x: self.m12, y: self.m22, z: self.m32, w: self.m42 },
                )
                    .into(),
                Vector4 { x: self.m13, y: self.m23, z: self.m33, w: self.m43 },
            )
                .into(),
            Vector4 { x: self.m14, y: self.m24, z: self.m34, w: self.m44 },
        )
            .into()
    }
}

