    /// slice length` unless `data.len() == 24`. Upstream: `Matrix4x6::from_row_iterator(iter)` (a
    /// `Span` here).
    #[inline]
    fn from_row_iterator(data: Span<T>) -> Matrix4x6<T> {
        Matrix4x6Trait::from_row_slice(data)
    }

    /// The number of components, 24. Upstream: `len`.
    #[inline(always)]
    fn len(self: Matrix4x6<T>) -> usize {
        24
    }

    /// `false`: a static shape has at least one component. Upstream: `is_empty`.
    #[inline(always)]
    fn is_empty(self: Matrix4x6<T>) -> bool {
        false
    }

    /// `self` with `n` columns of `val` inserted at index `i` (`i <= 6`; panics with `nalgebra:
