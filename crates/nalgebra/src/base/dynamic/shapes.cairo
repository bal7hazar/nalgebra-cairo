                .into(),
            y: f(Vector5 { x: self.m12, y: self.m22, z: self.m32, w: self.m42, a: self.m52 })
                .into(),
            z: f(Vector5 { x: self.m13, y: self.m23, z: self.m33, w: self.m43, a: self.m53 })
                .into(),
            w: f(Vector5 { x: self.m14, y: self.m24, z: self.m34, w: self.m44, a: self.m54 })
                .into(),
            a: f(Vector5 { x: self.m15, y: self.m25, z: self.m35, w: self.m45, a: self.m55 })
                .into(),
            b: f(Vector5 { x: self.m16, y: self.m26, z: self.m36, w: self.m46, a: self.m56 })
                .into(),
        }
    }

