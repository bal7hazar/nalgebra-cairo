/// The `2x6` `DMatrix` of the components of a `Matrix2x6` (column-major copy). Upstream:
/// `From<Matrix> for DMatrix`.
pub impl Matrix2x6IntoDMatrix<T, +Copy<T>, +Drop<T>> of Into<Matrix2x6<T>, DMatrix<T>> {
    #[inline]
    fn into(self: Matrix2x6<T>) -> DMatrix<T> {
        DMatrix {
            data: array![
                self.m11, self.m21, self.m12, self.m22, self.m13, self.m23, self.m14, self.m24,
                self.m15, self.m25, self.m16, self.m26,
            ]
                .span(),
            nrows: 2,
            ncols: 6,
        }
    }
}

/// The members of the static `Matrix2x6` that come with the dynamic matrices (DESIGN D5, feature
/// `dynamic`): the edition forms with a dynamic result, `from_vec`, `from_iterator`,
/// `from_row_iterator`, `len`, `is_empty`, `compress_*`.
#[generate_trait]
pub impl Matrix2x6DynamicImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix2x6DynamicTrait<T> {
    /// The 2x6 matrix of the 12 values of `data` in COLUMN-major order. Panics with `nalgebra:
    /// wrong slice length` unless `data.len() == 12`. Upstream: `Matrix2x6::from_vec(Vec<T>)`.
    #[inline]
    fn from_vec(data: Array<T>) -> Matrix2x6<T> {
        Matrix2x6Trait::from_column_slice(data.span())
    }

    /// The 2x6 matrix of the values of `data` in COLUMN-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 12`. Upstream: `Matrix2x6::from_iterator(iter)` (a
    /// `Span` of exactly the length here).
    #[inline]
    fn from_iterator(data: Span<T>) -> Matrix2x6<T> {
        Matrix2x6Trait::from_column_slice(data)
    }

    /// The 2x6 matrix of the values of `data` in ROW-major order. Panics with `nalgebra: wrong
    /// slice length` unless `data.len() == 12`. Upstream: `Matrix2x6::from_row_iterator(iter)` (a
    /// `Span` here).
    #[inline]
    fn from_row_iterator(data: Span<T>) -> Matrix2x6<T> {
        Matrix2x6Trait::from_row_slice(data)
    }

    /// The number of components, 12. Upstream: `len`.
    #[inline(always)]
    fn len(self: Matrix2x6<T>) -> usize {
        12
    }

    /// `false`: a static shape has at least one component. Upstream: `is_empty`.
    #[inline(always)]
    fn is_empty(self: Matrix2x6<T>) -> bool {
        false
    }

    /// `self` with `n` columns of `val` inserted at index `i` (`i <= 6`; panics with `nalgebra:
    /// index out of bounds` otherwise), a `Matrix2xX` (`DMatrix`). Upstream: `insert_columns`
    /// (`OMatrix<U2, Dyn>`).
    #[inline]
    fn insert_columns(self: Matrix2x6<T>, i: usize, n: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.insert_columns(i, n, val)
    }

    /// `self` with `n` rows of `val` inserted at index `i` (`i <= 2`; panics with `nalgebra: index
    /// out of bounds` otherwise), a `MatrixXx6` (`DMatrix`). Upstream: `insert_rows` (`OMatrix<U2,
    /// Dyn>`).
    #[inline]
    fn insert_rows(self: Matrix2x6<T>, i: usize, n: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.insert_rows(i, n, val)
    }

    /// `self` without the columns `i .. i + n` (`i + n <= 6`; panics with `nalgebra: index out of
    /// bounds` otherwise), a `Matrix2xX` (`DMatrix`). Upstream: `remove_columns` (`OMatrix<U2,
    /// Dyn>`).
    #[inline]
    fn remove_columns(self: Matrix2x6<T>, i: usize, n: usize) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_columns(i, n)
    }

    /// `self` without the rows `i .. i + n` (`i + n <= 2`; panics with `nalgebra: index out of
    /// bounds` otherwise), a `MatrixXx6` (`DMatrix`). Upstream: `remove_rows` (`OMatrix<U2, Dyn>`).
    #[inline]
    fn remove_rows(self: Matrix2x6<T>, i: usize, n: usize) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_rows(i, n)
    }

    /// `self` without the columns whose index is in `indices` (repeated or out of range indices are
    /// ignored), a `Matrix2xX` (`DMatrix`). Upstream: `remove_columns_at` (`OMatrix<U2, Dyn>`).
    #[inline]
    fn remove_columns_at(self: Matrix2x6<T>, indices: Span<usize>) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_columns_at(indices)
    }

    /// `self` without the rows whose index is in `indices` (repeated or out of range indices are
    /// ignored), a `MatrixXx6` (`DMatrix`). Upstream: `remove_rows_at` (`OMatrix<U2, Dyn>`).
    #[inline]
    fn remove_rows_at(self: Matrix2x6<T>, indices: Span<usize>) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.remove_rows_at(indices)
    }

    /// `self` with `new_ncols` columns, the common columns kept, the new components `val`, a
    /// `Matrix2xX` (`DMatrix`). Upstream: `resize_horizontally` (`OMatrix<U2, Dyn>`).
    #[inline]
    fn resize_horizontally(self: Matrix2x6<T>, new_ncols: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.resize_horizontally(new_ncols, val)
    }

    /// `self` with `new_nrows` rows, the common rows kept, the new components `val`, a `MatrixXx6`
    /// (`DMatrix`). Upstream: `resize_vertically` (`OMatrix<U2, Dyn>`).
    #[inline]
    fn resize_vertically(self: Matrix2x6<T>, new_nrows: usize, val: T) -> DMatrix<T> {
        let d: DMatrix<T> = self.into();
        d.resize_vertically(new_nrows, val)
    }

    /// The row vector of `f(column)` for the 6 columns (a `Vector2` each). `f`'s output converts
    /// `Into<T>`. Upstream: `compress_rows` (`f` takes a column view).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_rows<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector2<T>,)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        self: Matrix2x6<T>, f: F,
    ) -> RowVector6<T> {
        RowVector6 {
            x: f(Vector2 { x: self.m11, y: self.m21 }).into(),
            y: f(Vector2 { x: self.m12, y: self.m22 }).into(),
            z: f(Vector2 { x: self.m13, y: self.m23 }).into(),
            w: f(Vector2 { x: self.m14, y: self.m24 }).into(),
            a: f(Vector2 { x: self.m15, y: self.m25 }).into(),
            b: f(Vector2 { x: self.m16, y: self.m26 }).into(),
        }
    }

    /// The column vector of `f(column)` for the 6 columns. Upstream: `compress_rows_tr`.
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_rows_tr<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector2<T>,)>,
        +Into<Func::Output, T>,
        +Drop<Func::Output>,
    >(
        self: Matrix2x6<T>, f: F,
    ) -> Vector6<T> {
        Vector6 {
            x: f(Vector2 { x: self.m11, y: self.m21 }).into(),
            y: f(Vector2 { x: self.m12, y: self.m22 }).into(),
            z: f(Vector2 { x: self.m13, y: self.m23 }).into(),
            w: f(Vector2 { x: self.m14, y: self.m24 }).into(),
            a: f(Vector2 { x: self.m15, y: self.m25 }).into(),
            b: f(Vector2 { x: self.m16, y: self.m26 }).into(),
        }
    }

    /// `init` folded with every column, `acc = f(acc, column)` from the first to the last. `f`'s
    /// output converts `Into<Vector2>`. Upstream: `compress_columns(init, f)` (`f` mutates `&mut
    /// acc`; Cairo closures take and return it by value).
    #[cfg(feature: 'closures')]
    #[inline]
    fn compress_columns<
        F,
        +Drop<F>,
        impl Func: core::ops::Fn<F, (Vector2<T>, Vector2<T>)>,
        +Into<Func::Output, Vector2<T>>,
        +Drop<Func::Output>,
    >(
        self: Matrix2x6<T>, init: Vector2<T>, f: F,
    ) -> Vector2<T> {
        f(
            f(
                f(
                    f(
                        f(
                            f(init, Vector2 { x: self.m11, y: self.m21 }).into(),
                            Vector2 { x: self.m12, y: self.m22 },
                        )
                            .into(),
                        Vector2 { x: self.m13, y: self.m23 },
                    )
                        .into(),
                    Vector2 { x: self.m14, y: self.m24 },
                )
                    .into(),
                Vector2 { x: self.m15, y: self.m25 },
            )
                .into(),
            Vector2 { x: self.m16, y: self.m26 },
        )
            .into()
    }
}

