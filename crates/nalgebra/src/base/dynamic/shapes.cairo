                .into(),
            w: f(Vector5 { x: self.m14, y: self.m24, z: self.m34, w: self.m44, a: self.m54 })
                .into(),
            a: f(Vector5 { x: self.m15, y: self.m25, z: self.m35, w: self.m45, a: self.m55 })
                .into(),
