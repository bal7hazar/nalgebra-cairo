/// `self * rhs`, a `Vector4`: one `sum_prod2` per component (one rounding each). Panics on
/// overflow. Upstream: `Matrix4x2 * Vector2` (`Mul`).
pub impl Matrix4x2MulVector2<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>,
> of MatrixMul<Matrix4x2<T>, Vector2<T>> {
    type Output = Vector4<T>;
    #[inline(always)]
    fn mul_mat(self: Matrix4x2<T>, rhs: Vector2<T>) -> Vector4<T> {
        Vector4 {
            x: R::sum_prod2(self.m11, rhs.x, self.m12, rhs.y),
            y: R::sum_prod2(self.m21, rhs.x, self.m22, rhs.y),
            z: R::sum_prod2(self.m31, rhs.x, self.m32, rhs.y),
            w: R::sum_prod2(self.m41, rhs.x, self.m42, rhs.y),
        }
    }
}

