        Matrix4x2 {
            m11: lhs.m11 - rhs.m11,
            m21: lhs.m21 - rhs.m21,
            m31: lhs.m31 - rhs.m31,
            m41: lhs.m41 - rhs.m41,
            m12: lhs.m12 - rhs.m12,
            m22: lhs.m22 - rhs.m22,
            m32: lhs.m32 - rhs.m32,
