/// `lhs + rhs`, component-wise. Exact; panics on overflow. Upstream: `Add`.
pub impl Matrix4x2Add<T, +Add<T>, +Copy<T>, +Drop<T>> of Add<Matrix4x2<T>> {
    #[inline(always)]
    fn add(lhs: Matrix4x2<T>, rhs: Matrix4x2<T>) -> Matrix4x2<T> {
        Matrix4x2 {
            m11: lhs.m11 + rhs.m11,
            m21: lhs.m21 + rhs.m21,
            m31: lhs.m31 + rhs.m31,
            m41: lhs.m41 + rhs.m41,
            m12: lhs.m12 + rhs.m12,
            m22: lhs.m22 + rhs.m22,
            m32: lhs.m32 + rhs.m32,
            m42: lhs.m42 + rhs.m42,
        }
    }
}

/// `lhs - rhs`, component-wise. Exact; panics on overflow. Upstream: `Sub`.
pub impl Matrix4x2Sub<T, +Sub<T>, +Copy<T>, +Drop<T>> of Sub<Matrix4x2<T>> {
    #[inline(always)]
