    #[inline(always)]
    fn mul_assign(ref self: Matrix4x2<T>, rhs: T) {
        self =
            Matrix4x2 {
                m11: self.m11 * rhs,
                m21: self.m21 * rhs,
                m31: self.m31 * rhs,
                m41: self.m41 * rhs,
                m12: self.m12 * rhs,
