}

/// `-a`, component-wise. Exact; panics on overflow (`-MIN`). Upstream: `Neg`.
pub impl Matrix4x2Neg<T, +Neg<T>, +Copy<T>, +Drop<T>> of Neg<Matrix4x2<T>> {
    #[inline(always)]
