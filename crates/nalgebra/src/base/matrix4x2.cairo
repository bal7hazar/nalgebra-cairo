/// overflow. Upstream: `Matrix4x2 * Matrix2x4` (`Mul`).
pub impl Matrix4x2MulMatrix2x4<
    T, impl R: Real<T>, +Mul<T>, +Copy<T>, +Drop<T>, +Drop<R::Wide>,
> of MatrixMul<Matrix4x2<T>, Matrix2x4<T>> {
    type Output = Matrix4<T>;
    fn mul_mat(self: Matrix4x2<T>, rhs: Matrix2x4<T>) -> Matrix4<T> {
        Matrix4 {
            m11: R::sum_prod2(self.m11, rhs.m11, self.m12, rhs.m21),
            m21: R::sum_prod2(self.m21, rhs.m11, self.m22, rhs.m21),
