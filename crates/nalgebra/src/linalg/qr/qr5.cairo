    fn q(self: Qr5<T>) -> Matrix5<T> {
        self.q
    }

    /// The upper triangular factor. Exact: a move. Upstream: `QR::r`.
    #[inline(always)]
    fn r(self: Qr5<T>) -> Matrix5<T> {
        self.r
    }

    /// `(q, r)`. Exact: moves. Upstream: `QR::unpack`.
    #[inline(always)]
    fn unpack(self: Qr5<T>) -> (Matrix5<T>, Matrix5<T>) {
        (self.q, self.r)
    }

    /// The upper triangular factor, consuming the factorisation. Exact. Upstream: `QR::unpack_r`.
    #[inline(always)]
    fn unpack_r(self: Qr5<T>) -> Matrix5<T> {
        self.r
    }

    /// The factors as stored, `(q, r)` (modified Gram-Schmidt keeps both; upstream packs the
    /// reflectors). Exact. Upstream: `QR::qr_internal` (`#[doc(hidden)]`).
    #[inline(always)]
    fn qr_internal(self: Qr5<T>) -> (Matrix5<T>, Matrix5<T>) {
        (self.q, self.r)
    }

    /// `rhs = Qᵀ * rhs` in place, for any `rhs` with 5 rows (a vector or a matrix): ONE fused
    /// sum of products per entry, floored once. Upstream: `QR::q_tr_mul` (the Householder
    /// reflections one after the other, a rounding each).
    fn q_tr_mul<B, impl K: SolveKernel<Matrix5<T>, B>, +Drop<B>>(self: Qr5<T>, ref rhs: B) {
        rhs = K::tr_mul_rhs(self.q, rhs);
    }

    /// Overwrites `b` (any shape with 5 rows) with the solution of `A * x = b` and returns
    /// `true`, or returns `false` and leaves `b` unchanged when a diagonal entry of `R` is exactly
    /// zero (upstream returns `false` after overwriting `b` with `Qᵀ b`). `x = R⁻¹ (Qᵀ b)`:
    /// one fused `tr_mul`, then back substitution. Panics on overflow. Upstream: `QR::solve_mut`.
    fn solve_mut<B, impl K: SolveKernel<Matrix5<T>, B>, +Drop<B>>(self: Qr5<T>, ref b: B) -> bool {
        if !Self::is_invertible(self) {
            return false;
        }
        b = K::upper(self.r, K::tr_mul_rhs(self.q, b));
        true
    }

    /// Whether every diagonal entry of `R` is EXACTLY nonzero (no epsilon), like upstream's
    /// `QR::is_invertible`. Equivalently, `Q` is orthonormal.
    #[inline(always)]
    fn is_invertible(self: Qr5<T>) -> bool {
        self.r.m11 != R::zero()
            && self.r.m22 != R::zero()
            && self.r.m33 != R::zero()
            && self.r.m44 != R::zero()
            && self.r.m55 != R::zero()
    }

    /// The solution of `A * x = b`, or `None` when `R` has an exactly zero diagonal entry.
    /// `Qᵀ b` (one fused sum per component), then back substitution (one fused numerator and one
    /// correctly rounded division per component). Panics on overflow. Upstream: `QR::solve`.
    fn solve(self: Qr5<T>, b: Vector5<T>) -> Option<Vector5<T>> {
        if !Self::is_invertible(self) {
            return None;
        }
        let y0 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.q.m11, b.x), self.q.m21, b.y,
                        ),
                        self.q.m31,
                        b.z,
                    ),
                    self.q.m41,
                    b.w,
                ),
                self.q.m51,
                b.a,
            ),
        );
        let y1 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.q.m12, b.x), self.q.m22, b.y,
                        ),
                        self.q.m32,
                        b.z,
                    ),
                    self.q.m42,
                    b.w,
                ),
                self.q.m52,
                b.a,
            ),
        );
        let y2 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.q.m13, b.x), self.q.m23, b.y,
                        ),
                        self.q.m33,
                        b.z,
                    ),
                    self.q.m43,
                    b.w,
                ),
                self.q.m53,
                b.a,
            ),
        );
        let y3 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.q.m14, b.x), self.q.m24, b.y,
                        ),
                        self.q.m34,
                        b.z,
                    ),
                    self.q.m44,
                    b.w,
                ),
                self.q.m54,
                b.a,
            ),
        );
        let y4 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.q.m15, b.x), self.q.m25, b.y,
                        ),
                        self.q.m35,
                        b.z,
                    ),
                    self.q.m45,
                    b.w,
                ),
                self.q.m55,
                b.a,
            ),
        );
        Some(Qr5InternalTrait::back_substitute(self, Vector5 { x: y0, y: y1, z: y2, w: y3, a: y4 }))
    }

    /// The inverse `R⁻¹ Qᵀ`, or `None` when `R` has an exactly zero diagonal entry: the back
    /// substitution of each row of `Q`. Two roundings per entry. Panics on overflow. Upstream:
    /// `QR::try_inverse`.
    fn try_inverse(self: Qr5<T>) -> Option<Matrix5<T>> {
        revoke_ap_tracking();
        if !Self::is_invertible(self) {
            return None;
        }
        let c0 = Qr5InternalTrait::back_substitute(
            self,
            Vector5 { x: self.q.m11, y: self.q.m12, z: self.q.m13, w: self.q.m14, a: self.q.m15 },
        );
        let c1 = Qr5InternalTrait::back_substitute(
            self,
            Vector5 { x: self.q.m21, y: self.q.m22, z: self.q.m23, w: self.q.m24, a: self.q.m25 },
        );
        let c2 = Qr5InternalTrait::back_substitute(
            self,
            Vector5 { x: self.q.m31, y: self.q.m32, z: self.q.m33, w: self.q.m34, a: self.q.m35 },
        );
        let c3 = Qr5InternalTrait::back_substitute(
            self,
            Vector5 { x: self.q.m41, y: self.q.m42, z: self.q.m43, w: self.q.m44, a: self.q.m45 },
        );
        let c4 = Qr5InternalTrait::back_substitute(
            self,
            Vector5 { x: self.q.m51, y: self.q.m52, z: self.q.m53, w: self.q.m54, a: self.q.m55 },
        );
        Some(
            Matrix5 {
                m11: c0.x,
                m21: c0.y,
                m31: c0.z,
                m41: c0.w,
                m51: c0.a,
                m12: c1.x,
                m22: c1.y,
                m32: c1.z,
                m42: c1.w,
                m52: c1.a,
                m13: c2.x,
                m23: c2.y,
                m33: c2.z,
                m43: c2.w,
                m53: c2.a,
                m14: c3.x,
                m24: c3.y,
                m34: c3.z,
                m44: c3.w,
                m54: c3.a,
                m15: c4.x,
                m25: c4.y,
                m35: c4.z,
                m45: c4.w,
                m55: c4.a,
            },
        )
    }
}

/// Crate-internal kernel of `Qr5<T>`: the back substitution shared by `solve` and `try_inverse`.
#[generate_trait]
pub(crate) impl Qr5InternalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Qr5InternalTrait<T> {
    /// `R⁻¹ y` (the caller guarantees a nonzero diagonal).
    #[inline(always)]
    fn back_substitute(self: Qr5<T>, y: Vector5<T>) -> Vector5<T> {
        let x4 = R::div(R::wide_rescale(R::wide_add(R::wide_zero(), y.a)), self.r.m55);
        let x3 = R::div(R::mul_add(-self.r.m45, x4, y.w), self.r.m44);
        let x2 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), y.z), self.r.m34, x3),
                    self.r.m35,
                    x4,
                ),
            ),
            self.r.m33,
        );
        let x1 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), y.y), self.r.m23, x2),
                        self.r.m24,
                        x3,
                    ),
                    self.r.m25,
                    x4,
                ),
            ),
            self.r.m22,
        );
        let x0 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(R::wide_add(R::wide_zero(), y.x), self.r.m12, x1),
                            self.r.m13,
                            x2,
                        ),
                        self.r.m14,
                        x3,
                    ),
                    self.r.m15,
                    x4,
                ),
            ),
            self.r.m11,
        );
        Vector5 { x: x0, y: x1, z: x2, w: x3, a: x4 }
    }
}

/// `Matrix5` methods that go through the QR factorisation. Import `Matrix5QrTrait` to use them.
#[generate_trait]
pub impl Matrix5QrImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5QrTrait<T> {
    /// The QR factorisation. Upstream: `Matrix::qr`.
    #[inline(always)]
    fn qr(self: Matrix5<T>) -> Qr5<T> {
        Qr5Trait::new(self)
    }
}
