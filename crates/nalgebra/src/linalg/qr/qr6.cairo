                        a4.w,
                        a4.w,
                    ),
                    a4.a,
                    a4.a,
                ),
                a4.b,
                a4.b,
            ),
        );
        let q4 = if r4_4 == R::zero() {
            Vector6 {
                x: R::zero(), y: R::zero(), z: R::zero(), w: R::zero(), a: R::zero(), b: R::zero(),
            }
        } else {
            {
                let (q0, q1, q2, q3, q4, q5) = R::div6(a4.x, a4.y, a4.z, a4.w, a4.a, a4.b, r4_4);
                Vector6 { x: q0, y: q1, z: q2, w: q3, a: q4, b: q5 }
            }
        };
        let r4_5 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), q4.x, a5.x), q4.y, a5.y,
                            ),
                            q4.z,
                            a5.z,
                        ),
                        q4.w,
                        a5.w,
                    ),
                    q4.a,
                    a5.a,
                ),
                q4.b,
                a5.b,
            ),
        );
        let a5 = Vector6 {
            x: R::mul_add(-r4_5, q4.x, a5.x),
            y: R::mul_add(-r4_5, q4.y, a5.y),
            z: R::mul_add(-r4_5, q4.z, a5.z),
            w: R::mul_add(-r4_5, q4.w, a5.w),
            a: R::mul_add(-r4_5, q4.a, a5.a),
            b: R::mul_add(-r4_5, q4.b, a5.b),
        };
        let r5_5 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), a5.x, a5.x), a5.y, a5.y,
                            ),
                            a5.z,
                            a5.z,
                        ),
                        a5.w,
                        a5.w,
                    ),
                    a5.a,
                    a5.a,
                ),
                a5.b,
                a5.b,
            ),
        );
        let q5 = if r5_5 == R::zero() {
            Vector6 {
                x: R::zero(), y: R::zero(), z: R::zero(), w: R::zero(), a: R::zero(), b: R::zero(),
            }
        } else {
            {
                let (q0, q1, q2, q3, q4, q5) = R::div6(a5.x, a5.y, a5.z, a5.w, a5.a, a5.b, r5_5);
                Vector6 { x: q0, y: q1, z: q2, w: q3, a: q4, b: q5 }
            }
        };
        Qr6 {
            q: Matrix6 {
                m11: q0.x,
                m21: q0.y,
                m31: q0.z,
                m41: q0.w,
                m51: q0.a,
                m61: q0.b,
                m12: q1.x,
                m22: q1.y,
                m32: q1.z,
                m42: q1.w,
                m52: q1.a,
                m62: q1.b,
                m13: q2.x,
                m23: q2.y,
                m33: q2.z,
                m43: q2.w,
                m53: q2.a,
                m63: q2.b,
                m14: q3.x,
                m24: q3.y,
                m34: q3.z,
                m44: q3.w,
                m54: q3.a,
                m64: q3.b,
                m15: q4.x,
                m25: q4.y,
                m35: q4.z,
                m45: q4.w,
                m55: q4.a,
                m65: q4.b,
                m16: q5.x,
                m26: q5.y,
                m36: q5.z,
                m46: q5.w,
                m56: q5.a,
                m66: q5.b,
            },
            r: Matrix6 {
                m11: r0_0,
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m51: R::zero(),
                m61: R::zero(),
                m12: r0_1,
                m22: r1_1,
                m32: R::zero(),
                m42: R::zero(),
                m52: R::zero(),
                m62: R::zero(),
                m13: r0_2,
                m23: r1_2,
                m33: r2_2,
                m43: R::zero(),
                m53: R::zero(),
                m63: R::zero(),
                m14: r0_3,
                m24: r1_3,
                m34: r2_3,
                m44: r3_3,
                m54: R::zero(),
                m64: R::zero(),
                m15: r0_4,
                m25: r1_4,
                m35: r2_4,
                m45: r3_4,
                m55: r4_4,
                m65: R::zero(),
                m16: r0_5,
                m26: r1_5,
                m36: r2_5,
                m46: r3_5,
                m56: r4_5,
                m66: r5_5,
            },
        }
    }

    /// The orthonormal factor. Exact: a move. Upstream: `QR::q`.
    #[inline(always)]
    fn q(self: Qr6<T>) -> Matrix6<T> {
        self.q
    }

    /// The upper triangular factor. Exact: a move. Upstream: `QR::r`.
    #[inline(always)]
    fn r(self: Qr6<T>) -> Matrix6<T> {
        self.r
    }

    /// `(q, r)`. Exact: moves. Upstream: `QR::unpack`.
    #[inline(always)]
    fn unpack(self: Qr6<T>) -> (Matrix6<T>, Matrix6<T>) {
        (self.q, self.r)
    }

    /// The upper triangular factor, consuming the factorisation. Exact. Upstream: `QR::unpack_r`.
    #[inline(always)]
    fn unpack_r(self: Qr6<T>) -> Matrix6<T> {
        self.r
    }

    /// The factors as stored, `(q, r)` (modified Gram-Schmidt keeps both; upstream packs the
    /// reflectors). Exact. Upstream: `QR::qr_internal` (`#[doc(hidden)]`).
    #[inline(always)]
    fn qr_internal(self: Qr6<T>) -> (Matrix6<T>, Matrix6<T>) {
        (self.q, self.r)
    }

    /// `rhs = Qᵀ * rhs` in place, for any `rhs` with 6 rows (a vector or a matrix): ONE fused
    /// sum of products per entry, floored once. Upstream: `QR::q_tr_mul` (the Householder
    /// reflections one after the other, a rounding each).
    fn q_tr_mul<B, impl K: SolveKernel<Matrix6<T>, B>, +Drop<B>>(self: Qr6<T>, ref rhs: B) {
        rhs = K::tr_mul_rhs(self.q, rhs);
    }

    /// Overwrites `b` (any shape with 6 rows) with the solution of `A * x = b` and returns
    /// `true`, or returns `false` and leaves `b` unchanged when a diagonal entry of `R` is exactly
    /// zero (upstream returns `false` after overwriting `b` with `Qᵀ b`). `x = R⁻¹ (Qᵀ b)`:
    /// one fused `tr_mul`, then back substitution. Panics on overflow. Upstream: `QR::solve_mut`.
    fn solve_mut<B, impl K: SolveKernel<Matrix6<T>, B>, +Drop<B>>(self: Qr6<T>, ref b: B) -> bool {
        if !Self::is_invertible(self) {
            return false;
        }
        b = K::upper(self.r, K::tr_mul_rhs(self.q, b));
        true
    }

    /// Whether every diagonal entry of `R` is EXACTLY nonzero (no epsilon), like upstream's
    /// `QR::is_invertible`. Equivalently, `Q` is orthonormal.
    #[inline(always)]
    fn is_invertible(self: Qr6<T>) -> bool {
        self.r.m11 != R::zero()
            && self.r.m22 != R::zero()
            && self.r.m33 != R::zero()
            && self.r.m44 != R::zero()
            && self.r.m55 != R::zero()
            && self.r.m66 != R::zero()
    }

    /// The solution of `A * x = b`, or `None` when `R` has an exactly zero diagonal entry.
    /// `Qᵀ b` (one fused sum per component), then back substitution (one fused numerator and one
    /// correctly rounded division per component). Panics on overflow. Upstream: `QR::solve`.
    fn solve(self: Qr6<T>, b: Vector6<T>) -> Option<Vector6<T>> {
        if !Self::is_invertible(self) {
            return None;
        }
        let y0 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), self.q.m11, b.x), self.q.m21, b.y,
                            ),
                            self.q.m31,
                            b.z,
                        ),
                        self.q.m41,
                        b.w,
                    ),
                    self.q.m51,
                    b.a,
                ),
                self.q.m61,
                b.b,
            ),
        );
        let y1 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), self.q.m12, b.x), self.q.m22, b.y,
                            ),
                            self.q.m32,
                            b.z,
                        ),
                        self.q.m42,
                        b.w,
                    ),
                    self.q.m52,
                    b.a,
                ),
                self.q.m62,
                b.b,
            ),
        );
        let y2 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), self.q.m13, b.x), self.q.m23, b.y,
                            ),
                            self.q.m33,
                            b.z,
                        ),
                        self.q.m43,
                        b.w,
                    ),
                    self.q.m53,
                    b.a,
                ),
                self.q.m63,
                b.b,
            ),
        );
        let y3 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), self.q.m14, b.x), self.q.m24, b.y,
                            ),
                            self.q.m34,
                            b.z,
                        ),
                        self.q.m44,
                        b.w,
                    ),
                    self.q.m54,
                    b.a,
                ),
                self.q.m64,
                b.b,
            ),
        );
        let y4 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), self.q.m15, b.x), self.q.m25, b.y,
                            ),
                            self.q.m35,
                            b.z,
                        ),
                        self.q.m45,
                        b.w,
                    ),
                    self.q.m55,
                    b.a,
                ),
                self.q.m65,
                b.b,
            ),
        );
        let y5 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), self.q.m16, b.x), self.q.m26, b.y,
                            ),
                            self.q.m36,
                            b.z,
                        ),
                        self.q.m46,
                        b.w,
                    ),
                    self.q.m56,
                    b.a,
                ),
                self.q.m66,
                b.b,
            ),
        );
        Some(
            Qr6InternalTrait::back_substitute(
                self, Vector6 { x: y0, y: y1, z: y2, w: y3, a: y4, b: y5 },
            ),
        )
    }

    /// The inverse `R⁻¹ Qᵀ`, or `None` when `R` has an exactly zero diagonal entry: the back
    /// substitution of each row of `Q`. Two roundings per entry. Panics on overflow. Upstream:
    /// `QR::try_inverse`.
    fn try_inverse(self: Qr6<T>) -> Option<Matrix6<T>> {
        revoke_ap_tracking();
        if !Self::is_invertible(self) {
            return None;
        }
        let c0 = Qr6InternalTrait::back_substitute(
            self,
            Vector6 {
                x: self.q.m11,
                y: self.q.m12,
                z: self.q.m13,
                w: self.q.m14,
                a: self.q.m15,
                b: self.q.m16,
            },
        );
        let c1 = Qr6InternalTrait::back_substitute(
            self,
            Vector6 {
                x: self.q.m21,
                y: self.q.m22,
                z: self.q.m23,
                w: self.q.m24,
                a: self.q.m25,
                b: self.q.m26,
            },
        );
        let c2 = Qr6InternalTrait::back_substitute(
            self,
            Vector6 {
                x: self.q.m31,
                y: self.q.m32,
                z: self.q.m33,
                w: self.q.m34,
                a: self.q.m35,
                b: self.q.m36,
            },
        );
        let c3 = Qr6InternalTrait::back_substitute(
            self,
            Vector6 {
                x: self.q.m41,
                y: self.q.m42,
                z: self.q.m43,
                w: self.q.m44,
                a: self.q.m45,
                b: self.q.m46,
            },
        );
        let c4 = Qr6InternalTrait::back_substitute(
            self,
            Vector6 {
                x: self.q.m51,
                y: self.q.m52,
                z: self.q.m53,
                w: self.q.m54,
                a: self.q.m55,
                b: self.q.m56,
            },
        );
        let c5 = Qr6InternalTrait::back_substitute(
            self,
            Vector6 {
                x: self.q.m61,
                y: self.q.m62,
                z: self.q.m63,
                w: self.q.m64,
                a: self.q.m65,
                b: self.q.m66,
            },
        );
        Some(
            Matrix6 {
                m11: c0.x,
                m21: c0.y,
                m31: c0.z,
                m41: c0.w,
                m51: c0.a,
                m61: c0.b,
                m12: c1.x,
                m22: c1.y,
                m32: c1.z,
                m42: c1.w,
                m52: c1.a,
                m62: c1.b,
                m13: c2.x,
                m23: c2.y,
                m33: c2.z,
                m43: c2.w,
                m53: c2.a,
                m63: c2.b,
                m14: c3.x,
                m24: c3.y,
                m34: c3.z,
                m44: c3.w,
                m54: c3.a,
                m64: c3.b,
                m15: c4.x,
                m25: c4.y,
                m35: c4.z,
                m45: c4.w,
                m55: c4.a,
                m65: c4.b,
                m16: c5.x,
                m26: c5.y,
                m36: c5.z,
                m46: c5.w,
                m56: c5.a,
                m66: c5.b,
            },
        )
    }
}

/// Crate-internal kernel of `Qr6<T>`: the back substitution shared by `solve` and `try_inverse`.
#[generate_trait]
pub(crate) impl Qr6InternalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Qr6InternalTrait<T> {
    /// `R⁻¹ y` (the caller guarantees a nonzero diagonal).
    #[inline(always)]
    fn back_substitute(self: Qr6<T>, y: Vector6<T>) -> Vector6<T> {
        let x5 = R::div(R::wide_rescale(R::wide_add(R::wide_zero(), y.b)), self.r.m66);
        let x4 = R::div(R::mul_add(-self.r.m56, x5, y.a), self.r.m55);
        let x3 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(R::wide_add(R::wide_zero(), y.w), self.r.m45, x4),
                    self.r.m46,
                    x5,
                ),
            ),
            self.r.m44,
        );
        let x2 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(R::wide_add(R::wide_zero(), y.z), self.r.m34, x3),
                        self.r.m35,
                        x4,
                    ),
                    self.r.m36,
                    x5,
                ),
            ),
            self.r.m33,
        );
        let x1 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(R::wide_add(R::wide_zero(), y.y), self.r.m23, x2),
                            self.r.m24,
                            x3,
                        ),
                        self.r.m25,
                        x4,
                    ),
                    self.r.m26,
                    x5,
                ),
            ),
            self.r.m22,
        );
        let x0 = R::div(
            R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(R::wide_add(R::wide_zero(), y.x), self.r.m12, x1),
                                self.r.m13,
                                x2,
                            ),
                            self.r.m14,
                            x3,
                        ),
                        self.r.m15,
                        x4,
                    ),
                    self.r.m16,
                    x5,
                ),
            ),
            self.r.m11,
        );
        Vector6 { x: x0, y: x1, z: x2, w: x3, a: x4, b: x5 }
    }
}

/// `Matrix6` methods that go through the QR factorisation. Import `Matrix6QrTrait` to use them.
#[generate_trait]
pub impl Matrix6QrImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix6QrTrait<T> {
    /// The QR factorisation. Upstream: `Matrix::qr`.
    #[inline(always)]
    fn qr(self: Matrix6<T>) -> Qr6<T> {
        Qr6Trait::new(self)
    }
}
