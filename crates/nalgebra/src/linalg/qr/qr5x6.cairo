                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(R::wide_add(R::wide_zero(), q4.z), t0, q0.z),
                                t1,
                                q1.z,
                            ),
                            t2,
                            q2.z,
                        ),
                        t3,
                        q3.z,
                    ),
                ),
                w: R::wide_rescale(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(R::wide_add(R::wide_zero(), q4.w), t0, q0.w),
                                t1,
                                q1.w,
                            ),
                            t2,
                            q2.w,
                        ),
                        t3,
                        q3.w,
                    ),
                ),
                a: R::wide_rescale(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(R::wide_add(R::wide_zero(), q4.a), t0, q0.a),
                                t1,
                                q1.a,
                            ),
                            t2,
                            q2.a,
                        ),
                        t3,
                        q3.a,
                    ),
                ),
            };
            {
                let (q0, q1, q2, q3, q4) = R::div5(
                    h.x,
                    h.y,
                    h.z,
                    h.w,
                    h.a,
                    R::wide_sqrt(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(R::wide_zero(), h.x, h.x), h.y, h.y,
                                    ),
                                    h.z,
                                    h.z,
                                ),
                                h.w,
                                h.w,
                            ),
                            h.a,
                            h.a,
                        ),
                    ),
                );
                Vector5 { x: q0, y: q1, z: q2, w: q3, a: q4 }
            }
        };
        let r4_5 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), q4.x, a5.x), q4.y, a5.y),
                        q4.z,
                        a5.z,
                    ),
                    q4.w,
                    a5.w,
                ),
                q4.a,
                a5.a,
            ),
        );
        Qr5x6 {
            q: Matrix5 {
                m11: q0.x,
                m21: q0.y,
                m31: q0.z,
                m41: q0.w,
                m51: q0.a,
                m12: q1.x,
                m22: q1.y,
                m32: q1.z,
                m42: q1.w,
                m52: q1.a,
                m13: q2.x,
                m23: q2.y,
                m33: q2.z,
                m43: q2.w,
                m53: q2.a,
                m14: q3.x,
                m24: q3.y,
                m34: q3.z,
                m44: q3.w,
                m54: q3.a,
                m15: q4.x,
                m25: q4.y,
                m35: q4.z,
                m45: q4.w,
                m55: q4.a,
            },
            r: Matrix5x6 {
                m11: r0_0,
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m51: R::zero(),
                m12: r0_1,
                m22: r1_1,
                m32: R::zero(),
                m42: R::zero(),
                m52: R::zero(),
                m13: r0_2,
                m23: r1_2,
                m33: r2_2,
                m43: R::zero(),
                m53: R::zero(),
                m14: r0_3,
                m24: r1_3,
                m34: r2_3,
                m44: r3_3,
                m54: R::zero(),
                m15: r0_4,
                m25: r1_4,
                m35: r2_4,
                m45: r3_4,
                m55: r4_4,
                m16: r0_5,
                m26: r1_5,
                m36: r2_5,
                m46: r3_5,
                m56: r4_5,
            },
        }
    }

    /// The orthonormal factor. Exact: a move. Upstream: `QR::q`.
    #[inline(always)]
    fn q(self: Qr5x6<T>) -> Matrix5<T> {
        self.q
    }

    /// The upper triangular factor. Exact: a move. Upstream: `QR::r`.
    #[inline(always)]
    fn r(self: Qr5x6<T>) -> Matrix5x6<T> {
        self.r
    }

    /// `(q, r)`. Exact: moves. Upstream: `QR::unpack`.
    #[inline(always)]
    fn unpack(self: Qr5x6<T>) -> (Matrix5<T>, Matrix5x6<T>) {
        (self.q, self.r)
    }

    /// The upper triangular factor, consuming the factorisation. Exact. Upstream: `QR::unpack_r`.
    #[inline(always)]
    fn unpack_r(self: Qr5x6<T>) -> Matrix5x6<T> {
        self.r
    }

    /// The factors as stored, `(q, r)` (modified Gram-Schmidt keeps both; upstream packs the
    /// reflectors). Exact. Upstream: `QR::qr_internal` (`#[doc(hidden)]`).
    #[inline(always)]
    fn qr_internal(self: Qr5x6<T>) -> (Matrix5<T>, Matrix5x6<T>) {
        (self.q, self.r)
    }

    /// `rhs = Qᵀ * rhs` in place, for any `rhs` with 5 rows (a vector or a matrix): ONE fused
    /// sum of products per entry, floored once. Upstream: `QR::q_tr_mul` (the Householder
    /// reflections one after the other, a rounding each).
    fn q_tr_mul<B, impl K: SolveKernel<Matrix5<T>, B>, +Drop<B>>(self: Qr5x6<T>, ref rhs: B) {
        rhs = K::tr_mul_rhs(self.q, rhs);
    }
}

/// `Matrix5x6` methods that go through the QR factorisation. Import `Matrix5x6QrTrait` to use them.
#[generate_trait]
pub impl Matrix5x6QrImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5x6QrTrait<T> {
    /// The QR factorisation. Upstream: `Matrix::qr`.
    #[inline(always)]
    fn qr(self: Matrix5x6<T>) -> Qr5x6<T> {
        Qr5x6Trait::new(self)
    }
}
