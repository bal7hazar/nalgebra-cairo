/// `Matrix6` methods that go through the symmetric tridiagonalisation. Import
/// `Matrix6SymmetricTridiagonalTrait`.
#[generate_trait]
pub impl Matrix6SymmetricTridiagonalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix6SymmetricTridiagonalTrait<T> {
    /// The tridiagonalisation of this symmetric matrix (its lower triangle is read). Upstream:
    /// `SquareMatrix::symmetric_tridiagonalize`.
    #[inline(always)]
    fn symmetric_tridiagonalize(self: Matrix6<T>) -> SymmetricTridiagonal6<T> {
        SymmetricTridiagonal6Trait::new(self)
    }
}
