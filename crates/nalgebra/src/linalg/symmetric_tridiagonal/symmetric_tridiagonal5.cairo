/// `Matrix5` methods that go through the symmetric tridiagonalisation. Import
/// `Matrix5SymmetricTridiagonalTrait`.
#[generate_trait]
pub impl Matrix5SymmetricTridiagonalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5SymmetricTridiagonalTrait<T> {
    /// The tridiagonalisation of this symmetric matrix (its lower triangle is read). Upstream:
    /// `SquareMatrix::symmetric_tridiagonalize`.
    #[inline(always)]
    fn symmetric_tridiagonalize(self: Matrix5<T>) -> SymmetricTridiagonal5<T> {
        SymmetricTridiagonal5Trait::new(self)
    }
}
