#[generate_trait]
pub impl Cholesky4UpdateImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Cholesky4UpdateTrait<T> {
    /// Updates the factor in place into the factor of `A + sigma x xᵀ` (a downdate when
    /// `sigma < 0`), see the module doc for the formulas, rounding and panics. Upstream:
    /// `Cholesky::rank_one_update`.
    fn rank_one_update(ref self: Cholesky4<T>, x: Vector4<T>, sigma: T) {
        let mut l0_0 = self.l11;
        let mut l1_0 = self.l21;
        let mut l2_0 = self.l31;
        let mut l3_0 = self.l41;
        let mut l1_1 = self.l22;
        let mut l2_1 = self.l32;
        let mut l3_1 = self.l42;
        let mut l2_2 = self.l33;
        let mut l3_2 = self.l43;
        let mut l3_3 = self.l44;
        let mut x0 = x.x;
        let mut x1 = x.y;
        let mut x2 = x.z;
        let mut x3 = x.w;
        if x0 != R::zero() {
            let d = l0_0;
            let sx = sigma * x0;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x0));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            let n1 = R::sum_prod2(d, l1_0, sx, x1);
            let n2 = R::sum_prod2(d, l2_0, sx, x2);
            let n3 = R::sum_prod2(d, l3_0, sx, x3);
            let (t1, t2, t3) = R::div3(n1, n2, n3, rr);
            l1_0 = t1;
            l2_0 = t2;
            l3_0 = t3;
            let m1 = R::diff_prod(rr, x1, x0, l1_0);
            let m2 = R::diff_prod(rr, x2, x0, l2_0);
            let m3 = R::diff_prod(rr, x3, x0, l3_0);
            let (y1, y2, y3) = R::div3(m1, m2, m3, d);
            x1 = y1;
            x2 = y2;
            x3 = y3;
            l0_0 = rr;
        }
        if x1 != R::zero() {
            let d = l1_1;
            let sx = sigma * x1;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x1));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            let n2 = R::sum_prod2(d, l2_1, sx, x2);
            let n3 = R::sum_prod2(d, l3_1, sx, x3);
            let (t2, t3) = (R::div(n2, rr), R::div(n3, rr));
            l2_1 = t2;
            l3_1 = t3;
            let m2 = R::diff_prod(rr, x2, x1, l2_1);
            let m3 = R::diff_prod(rr, x3, x1, l3_1);
            let (y2, y3) = (R::div(m2, d), R::div(m3, d));
            x2 = y2;
            x3 = y3;
            l1_1 = rr;
        }
        if x2 != R::zero() {
            let d = l2_2;
            let sx = sigma * x2;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x2));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            let n3 = R::sum_prod2(d, l3_2, sx, x3);
            l3_2 = R::div(n3, rr);
            let m3 = R::diff_prod(rr, x3, x2, l3_2);
            x3 = R::div(m3, d);
            l2_2 = rr;
        }
        if x3 != R::zero() {
            let d = l3_3;
            let sx = sigma * x3;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x3));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            l3_3 = rr;
        }
        self =
            Cholesky4 {
                l11: l0_0,
                l21: l1_0,
                l31: l2_0,
                l41: l3_0,
                l22: l1_1,
                l32: l2_1,
                l42: l3_1,
                l33: l2_2,
                l43: l3_2,
                l44: l3_3,
            };
    }
    /// The factor of the 3x3 matrix with the column and the row `j` removed (`0 <= j <
    /// 4`): the rows and columns around `j` are moved, and the trailing block is updated by
    /// the removed column below the diagonal (`sigma = +1`, see the module doc). Panics with
    /// `nalgebra: index out of bounds` when `j >= 4`. Upstream: `Cholesky::remove_column`.
    fn remove_column(self: Cholesky4<T>, j: usize) -> Cholesky3<T> {
        match j {
            0 => {
                let mut z0_0 = self.l22;
                let mut z1_0 = self.l32;
                let mut z2_0 = self.l42;
                let mut z1_1 = self.l33;
                let mut z2_1 = self.l43;
                let mut z2_2 = self.l44;
                let mut u0 = self.l21;
                let mut u1 = self.l31;
                let mut u2 = self.l41;
                if u0 != R::zero() {
                    let d = z0_0;
                    let sx = u0;
                    let rr = R::wide_sqrt(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, u0),
                    );
                    if rr == R::zero() {
                        core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
                    }
                    let n1 = R::sum_prod2(d, z1_0, sx, u1);
                    let n2 = R::sum_prod2(d, z2_0, sx, u2);
                    let (t1, t2) = (R::div(n1, rr), R::div(n2, rr));
                    z1_0 = t1;
                    z2_0 = t2;
                    let m1 = R::diff_prod(rr, u1, u0, z1_0);
                    let m2 = R::diff_prod(rr, u2, u0, z2_0);
                    let (y1, y2) = (R::div(m1, d), R::div(m2, d));
                    u1 = y1;
                    u2 = y2;
                    z0_0 = rr;
                }
                if u1 != R::zero() {
                    let d = z1_1;
                    let sx = u1;
                    let rr = R::wide_sqrt(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, u1),
                    );
                    if rr == R::zero() {
                        core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
                    }
                    let n2 = R::sum_prod2(d, z2_1, sx, u2);
                    z2_1 = R::div(n2, rr);
                    let m2 = R::diff_prod(rr, u2, u1, z2_1);
                    u2 = R::div(m2, d);
                    z1_1 = rr;
                }
                if u2 != R::zero() {
                    let d = z2_2;
                    let sx = u2;
                    let rr = R::wide_sqrt(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, u2),
                    );
                    if rr == R::zero() {
                        core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
                    }
                    z2_2 = rr;
                }
                Cholesky3 { l11: z0_0, l21: z1_0, l31: z2_0, l22: z1_1, l32: z2_1, l33: z2_2 }
            },
            1 => {
                let mut z0_0 = self.l33;
                let mut z1_0 = self.l43;
                let mut z1_1 = self.l44;
                let mut u0 = self.l32;
                let mut u1 = self.l42;
                if u0 != R::zero() {
                    let d = z0_0;
                    let sx = u0;
                    let rr = R::wide_sqrt(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, u0),
                    );
                    if rr == R::zero() {
                        core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
                    }
                    let n1 = R::sum_prod2(d, z1_0, sx, u1);
                    z1_0 = R::div(n1, rr);
                    let m1 = R::diff_prod(rr, u1, u0, z1_0);
                    u1 = R::div(m1, d);
                    z0_0 = rr;
                }
                if u1 != R::zero() {
                    let d = z1_1;
                    let sx = u1;
                    let rr = R::wide_sqrt(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, u1),
                    );
                    if rr == R::zero() {
                        core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
                    }
                    z1_1 = rr;
                }
                Cholesky3 {
                    l11: self.l11, l21: self.l31, l31: self.l41, l22: z0_0, l32: z1_0, l33: z1_1,
                }
            },
            2 => {
                let mut z0_0 = self.l44;
                let mut u0 = self.l43;
                if u0 != R::zero() {
                    let d = z0_0;
                    let sx = u0;
                    let rr = R::wide_sqrt(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, u0),
                    );
                    if rr == R::zero() {
                        core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
                    }
                    z0_0 = rr;
                }
                Cholesky3 {
                    l11: self.l11,
                    l21: self.l21,
                    l31: self.l41,
                    l22: self.l22,
                    l32: self.l42,
                    l33: z0_0,
                }
            },
            3 => {
                Cholesky3 {
                    l11: self.l11,
                    l21: self.l21,
                    l31: self.l31,
                    l22: self.l22,
                    l32: self.l32,
                    l33: self.l33,
                }
            },
            _ => core::panic_with_felt252(INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// The in-place updates of `Cholesky6<T>`. Import `Cholesky6UpdateTrait` to use them.
#[generate_trait]
pub impl Cholesky6UpdateImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Cholesky6UpdateTrait<T> {
    /// Updates the factor in place into the factor of `A + sigma x xᵀ` (a downdate when
    /// `sigma < 0`), see the module doc for the formulas, rounding and panics. Upstream:
    /// `Cholesky::rank_one_update`.
    fn rank_one_update(ref self: Cholesky6<T>, x: Vector6<T>, sigma: T) {
        let mut l0_0 = self.l11;
        let mut l1_0 = self.l21;
        let mut l2_0 = self.l31;
        let mut l3_0 = self.l41;
        let mut l4_0 = self.l51;
        let mut l5_0 = self.l61;
        let mut l1_1 = self.l22;
        let mut l2_1 = self.l32;
        let mut l3_1 = self.l42;
        let mut l4_1 = self.l52;
        let mut l5_1 = self.l62;
        let mut l2_2 = self.l33;
        let mut l3_2 = self.l43;
        let mut l4_2 = self.l53;
        let mut l5_2 = self.l63;
        let mut l3_3 = self.l44;
        let mut l4_3 = self.l54;
        let mut l5_3 = self.l64;
        let mut l4_4 = self.l55;
        let mut l5_4 = self.l65;
        let mut l5_5 = self.l66;
        let mut x0 = x.x;
        let mut x1 = x.y;
        let mut x2 = x.z;
        let mut x3 = x.w;
        let mut x4 = x.a;
        let mut x5 = x.b;
        if x0 != R::zero() {
            let d = l0_0;
            let sx = sigma * x0;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x0));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            let n1 = R::sum_prod2(d, l1_0, sx, x1);
            let n2 = R::sum_prod2(d, l2_0, sx, x2);
            let n3 = R::sum_prod2(d, l3_0, sx, x3);
            let n4 = R::sum_prod2(d, l4_0, sx, x4);
            let n5 = R::sum_prod2(d, l5_0, sx, x5);
            let (t1, t2, t3, t4, t5) = R::div5(n1, n2, n3, n4, n5, rr);
            l1_0 = t1;
            l2_0 = t2;
            l3_0 = t3;
            l4_0 = t4;
            l5_0 = t5;
            let m1 = R::diff_prod(rr, x1, x0, l1_0);
            let m2 = R::diff_prod(rr, x2, x0, l2_0);
            let m3 = R::diff_prod(rr, x3, x0, l3_0);
            let m4 = R::diff_prod(rr, x4, x0, l4_0);
            let m5 = R::diff_prod(rr, x5, x0, l5_0);
            let (y1, y2, y3, y4, y5) = R::div5(m1, m2, m3, m4, m5, d);
            x1 = y1;
            x2 = y2;
            x3 = y3;
            x4 = y4;
            x5 = y5;
            l0_0 = rr;
        }
        if x1 != R::zero() {
            let d = l1_1;
            let sx = sigma * x1;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x1));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            let n2 = R::sum_prod2(d, l2_1, sx, x2);
            let n3 = R::sum_prod2(d, l3_1, sx, x3);
            let n4 = R::sum_prod2(d, l4_1, sx, x4);
            let n5 = R::sum_prod2(d, l5_1, sx, x5);
            let (t2, t3, t4, t5) = R::div4(n2, n3, n4, n5, rr);
            l2_1 = t2;
            l3_1 = t3;
            l4_1 = t4;
            l5_1 = t5;
            let m2 = R::diff_prod(rr, x2, x1, l2_1);
            let m3 = R::diff_prod(rr, x3, x1, l3_1);
            let m4 = R::diff_prod(rr, x4, x1, l4_1);
            let m5 = R::diff_prod(rr, x5, x1, l5_1);
            let (y2, y3, y4, y5) = R::div4(m2, m3, m4, m5, d);
            x2 = y2;
            x3 = y3;
            x4 = y4;
            x5 = y5;
            l1_1 = rr;
        }
        if x2 != R::zero() {
            let d = l2_2;
            let sx = sigma * x2;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x2));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            let n3 = R::sum_prod2(d, l3_2, sx, x3);
            let n4 = R::sum_prod2(d, l4_2, sx, x4);
            let n5 = R::sum_prod2(d, l5_2, sx, x5);
            let (t3, t4, t5) = R::div3(n3, n4, n5, rr);
            l3_2 = t3;
            l4_2 = t4;
            l5_2 = t5;
            let m3 = R::diff_prod(rr, x3, x2, l3_2);
            let m4 = R::diff_prod(rr, x4, x2, l4_2);
            let m5 = R::diff_prod(rr, x5, x2, l5_2);
            let (y3, y4, y5) = R::div3(m3, m4, m5, d);
            x3 = y3;
            x4 = y4;
            x5 = y5;
            l2_2 = rr;
        }
        if x3 != R::zero() {
            let d = l3_3;
            let sx = sigma * x3;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x3));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            let n4 = R::sum_prod2(d, l4_3, sx, x4);
            let n5 = R::sum_prod2(d, l5_3, sx, x5);
            let (t4, t5) = (R::div(n4, rr), R::div(n5, rr));
            l4_3 = t4;
            l5_3 = t5;
            let m4 = R::diff_prod(rr, x4, x3, l4_3);
            let m5 = R::diff_prod(rr, x5, x3, l5_3);
            let (y4, y5) = (R::div(m4, d), R::div(m5, d));
            x4 = y4;
            x5 = y5;
            l3_3 = rr;
        }
        if x4 != R::zero() {
            let d = l4_4;
            let sx = sigma * x4;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x4));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            let n5 = R::sum_prod2(d, l5_4, sx, x5);
            l5_4 = R::div(n5, rr);
            let m5 = R::diff_prod(rr, x5, x4, l5_4);
            x5 = R::div(m5, d);
            l4_4 = rr;
        }
        if x5 != R::zero() {
            let d = l5_5;
            let sx = sigma * x5;
            let rr = R::wide_sqrt(R::wide_add_prod(R::wide_add_prod(R::wide_zero(), d, d), sx, x5));
            if rr == R::zero() {
                core::panic_with_felt252(NOT_POSITIVE_DEFINITE);
            }
            l5_5 = rr;
        }
        self =
            Cholesky6 {
                l11: l0_0,
                l21: l1_0,
                l31: l2_0,
                l41: l3_0,
                l51: l4_0,
                l61: l5_0,
                l22: l1_1,
                l32: l2_1,
                l42: l3_1,
                l52: l4_1,
                l62: l5_1,
                l33: l2_2,
                l43: l3_2,
                l53: l4_2,
                l63: l5_2,
                l44: l3_3,
                l54: l4_3,
                l64: l5_3,
                l55: l4_4,
                l65: l5_4,
                l66: l5_5,
            };
    }
}
