/// `Matrix6` methods that go through the Schur decomposition. Import `Matrix6SchurTrait`.
#[generate_trait]
pub impl Matrix6SchurImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix6SchurTrait<T> {
    /// The real Schur decomposition. Upstream: `SquareMatrix::schur`.
    #[inline(always)]
    fn schur(self: Matrix6<T>) -> Schur6<T> {
        Schur6Trait::new(self)
    }

    /// The real Schur decomposition, or `None` when `max_niter` iterations (`0`: no limit) do not
    /// converge (see `Schur6Trait::try_new`). Upstream: `SquareMatrix::try_schur`.
    #[inline(always)]
    fn try_schur(self: Matrix6<T>, eps: T, max_niter: usize) -> Option<Schur6<T>> {
        Schur6Trait::try_new(self, eps, max_niter)
    }

    /// The eigenvalues when they are all real, `None` otherwise: the Schur iteration without `Q`
    /// (`compute_q` false: the `q` updates are skipped), `None` when `T` has a 2x2 block. Upstream:
    /// `SquareMatrix::eigenvalues`.
    fn eigenvalues(self: Matrix6<T>) -> Option<Vector6<T>> {
        let (q, t) = Schur6KernelTrait::decompose(self, R::default_epsilon(), 0, false).unwrap();
        Schur6Trait::eigenvalues(Schur6 { q, t })
    }

    /// The complex eigenvalues `(re, im)` (see `Schur6Trait::complex_eigenvalues`) of the Schur
    /// iteration without `Q`.
    /// Upstream: `SquareMatrix::complex_eigenvalues`.
    fn complex_eigenvalues(self: Matrix6<T>) -> (Vector6<T>, Vector6<T>) {
        let (q, t) = Schur6KernelTrait::decompose(self, R::default_epsilon(), 0, false).unwrap();
        Schur6Trait::complex_eigenvalues(Schur6 { q, t })
    }
}
