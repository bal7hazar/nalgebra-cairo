        let mut q41 = q.m52;
        let mut q02 = q.m13;
        let mut q12 = q.m23;
        let mut q22 = q.m33;
        let mut q32 = q.m43;
        let mut q42 = q.m53;
        let mut q03 = q.m14;
        let mut q13 = q.m24;
        let mut q23 = q.m34;
        let mut q33 = q.m44;
        let mut q43 = q.m54;
        let mut q04 = q.m15;
