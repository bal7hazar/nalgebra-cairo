        let mut nn: usize = 2;
        if (R::abs(t.m32) <= thr || R::abs(t.m32) <= eps * (R::abs(t.m33) + R::abs(t.m22))) {
            t.m32 = R::zero();
            if (R::abs(t.m21) <= thr || R::abs(t.m21) <= eps * (R::abs(t.m22) + R::abs(t.m11))) {
                t.m21 = R::zero();
                nn = 0;
            } else {
                nn = 1;
            }
        } else {
            nn = 2;
        }
