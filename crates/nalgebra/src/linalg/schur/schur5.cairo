    /// on the rows 1, 2; each reflection is applied to the entries of the window only (no `Q`: see
    /// `try_new`). `exceptional`: the shifts are those of LAPACK `dlahqr`'s exceptional 2x2 block
    /// instead (see `try_new`). Branch-free: a zero axis is an exact no-op.
    fn francis0_2_t(ref t: Matrix5<T>, exceptional: bool) {
        revoke_ap_tracking();
        let mut t00 = t.m11;
        let mut t10 = t.m21;
        let mut t20 = t.m31;
        let mut t30 = t.m41;
        let mut t40 = t.m51;
        let mut t01 = t.m12;
        let mut t11 = t.m22;
        let mut t21 = t.m32;
        let mut t31 = t.m42;
        let mut t41 = t.m52;
        let mut t02 = t.m13;
        let mut t12 = t.m23;
        let mut t22 = t.m33;
        let mut t32 = t.m43;
        let mut t42 = t.m53;
        let mut t03 = t.m14;
        let mut t13 = t.m24;
        let mut t23 = t.m34;
        let mut t33 = t.m44;
        let mut t43 = t.m54;
        let mut t04 = t.m15;
        let mut t14 = t.m25;
        let mut t24 = t.m35;
        let mut t34 = t.m45;
        let mut t44 = t.m55;
        let h11 = t00;
        let h12 = t01;
        let h21 = t10;
        let h22 = t11;
        let h32 = t21;
        let (hnn, hmm, hnm, hmn) = if exceptional {
            let sx = R::abs(t21) + R::abs(t10);
            let d = sx * R::from_ratio(3, 4) + t22;
            (d, d, sx, -(sx * R::from_ratio(7, 16)))
        } else {
