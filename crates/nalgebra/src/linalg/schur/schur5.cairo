            return (0, 0);
        }
        let mut start: usize = 0;
        if nn == 1 {
            start = 0;
        } else if nn == 2 {
            if (R::abs(t.m21) <= thr || R::abs(t.m21) <= eps * (R::abs(t.m22) + R::abs(t.m11))) {
