        let nv_u1 = -(u1 + u1);
        let h = HouseholderKernelTrait::<T>::rsum2(u0, t11, u1, t21, hf, ep);
        t11 = HouseholderKernelTrait::<T>::rmul_add(h, nv_u0, t11, hf, ep);
        t21 = HouseholderKernelTrait::<T>::rmul_add(h, nv_u1, t21, hf, ep);
