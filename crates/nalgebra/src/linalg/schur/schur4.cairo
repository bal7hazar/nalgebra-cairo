    /// One implicit double-shift (Francis) QR step on the active window 0..=2, upstream's
    /// `subdim > 2` branch: the bulge made by the first column of `(H - σ1)(H - σ2)` (`σ` the
    /// eigenvalues of the trailing 2x2 block) is chased down by 3-reflections, then a 2-reflection
    /// on the rows 1, 2; each reflection is applied to `t` from both sides (the whole rows /
    /// columns of the quasi-triangular form) and to the columns of `q`.
    fn francis0_2(ref t: Matrix4<T>, ref q: Matrix4<T>, compute_q: bool) {
        revoke_ap_tracking();
        let mut t00 = t.m11;
        let mut t10 = t.m21;
        let mut t20 = t.m31;
        let mut t30 = t.m41;
        let mut t01 = t.m12;
        let mut t11 = t.m22;
        let mut t21 = t.m32;
        let mut t31 = t.m42;
        let mut t02 = t.m13;
        let mut t12 = t.m23;
        let mut t22 = t.m33;
        let mut t32 = t.m43;
        let mut t03 = t.m14;
        let mut t13 = t.m24;
        let mut t23 = t.m34;
        let mut t33 = t.m44;
        let mut q00 = q.m11;
        let mut q10 = q.m21;
        let mut q20 = q.m31;
        let mut q30 = q.m41;
        let mut q01 = q.m12;
        let mut q11 = q.m22;
        let mut q21 = q.m32;
        let mut q31 = q.m42;
        let mut q02 = q.m13;
        let mut q12 = q.m23;
        let mut q22 = q.m33;
        let mut q32 = q.m43;
        let mut q03 = q.m14;
        let mut q13 = q.m24;
        let mut q23 = q.m34;
        let mut q33 = q.m44;
        let h11 = t00;
        let h12 = t01;
        let h21 = t10;
        let h22 = t11;
        let h32 = t21;
        let hnn = t22;
        let hmm = t11;
        let hnm = t21;
        let hmn = t12;
        let tra = hnn + hmm;
        let d1 = h11 - hmm;
        let d2 = h11 - hnn;
        let sc = R::abs(h21) + R::abs(d1) + R::abs(d2) + R::abs(hnm);
        let (p, r, g) = R::div3(d1, hnm, h21, sc);
        let mut ax = R::wide_rescale(
            R::wide_add_prod(
                R::wide_sub_prod(R::wide_add_prod(R::wide_zero(), p, d2), hmn, r), h12, g,
            ),
        );
        let mut ay = g * (h11 + h22 - tra);
        let mut az = g * h32;
        // bulge at column 0
        let (nrm, nz, u0, u1, u2) = HouseholderKernelTrait::<T>::axis3(ax, ay, az);
        if nz {
            let _ = nrm;
            let h = R::sum_prod3(u0, t00, u1, t10, u2, t20);
            let w = h + h;
            let nw = -w;
            t00 = R::mul_add(nw, u0, t00);
            t10 = R::mul_add(nw, u1, t10);
            t20 = R::mul_add(nw, u2, t20);
            let h = R::sum_prod3(u0, t01, u1, t11, u2, t21);
            let w = h + h;
            let nw = -w;
            t01 = R::mul_add(nw, u0, t01);
            t11 = R::mul_add(nw, u1, t11);
            t21 = R::mul_add(nw, u2, t21);
            let h = R::sum_prod3(u0, t02, u1, t12, u2, t22);
            let w = h + h;
            let nw = -w;
            t02 = R::mul_add(nw, u0, t02);
            t12 = R::mul_add(nw, u1, t12);
            t22 = R::mul_add(nw, u2, t22);
            let h = R::sum_prod3(u0, t03, u1, t13, u2, t23);
            let w = h + h;
            let nw = -w;
            t03 = R::mul_add(nw, u0, t03);
            t13 = R::mul_add(nw, u1, t13);
            t23 = R::mul_add(nw, u2, t23);
            let h = R::sum_prod3(t00, u0, t01, u1, t02, u2);
            let w = h + h;
            let nw = -w;
            t00 = R::mul_add(nw, u0, t00);
            t01 = R::mul_add(nw, u1, t01);
            t02 = R::mul_add(nw, u2, t02);
            let h = R::sum_prod3(t10, u0, t11, u1, t12, u2);
            let w = h + h;
            let nw = -w;
            t10 = R::mul_add(nw, u0, t10);
            t11 = R::mul_add(nw, u1, t11);
            t12 = R::mul_add(nw, u2, t12);
            let h = R::sum_prod3(t20, u0, t21, u1, t22, u2);
            let w = h + h;
            let nw = -w;
            t20 = R::mul_add(nw, u0, t20);
            t21 = R::mul_add(nw, u1, t21);
            t22 = R::mul_add(nw, u2, t22);
            if compute_q {
                let h = R::sum_prod3(q00, u0, q01, u1, q02, u2);
                let w = h + h;
                let nw = -w;
                q00 = R::mul_add(nw, u0, q00);
                q01 = R::mul_add(nw, u1, q01);
                q02 = R::mul_add(nw, u2, q02);
                let h = R::sum_prod3(q10, u0, q11, u1, q12, u2);
                let w = h + h;
                let nw = -w;
                q10 = R::mul_add(nw, u0, q10);
                q11 = R::mul_add(nw, u1, q11);
                q12 = R::mul_add(nw, u2, q12);
                let h = R::sum_prod3(q20, u0, q21, u1, q22, u2);
                let w = h + h;
                let nw = -w;
                q20 = R::mul_add(nw, u0, q20);
                q21 = R::mul_add(nw, u1, q21);
                q22 = R::mul_add(nw, u2, q22);
                let h = R::sum_prod3(q30, u0, q31, u1, q32, u2);
                let w = h + h;
                let nw = -w;
                q30 = R::mul_add(nw, u0, q30);
                q31 = R::mul_add(nw, u1, q31);
                q32 = R::mul_add(nw, u2, q32);
            }
        }
        ax = t10;
        ay = t20;
        let _ = az;
        let (nrm, nz, u0, u1) = HouseholderKernelTrait::<T>::axis2(ax, ay);
        if nz {
            t10 = nrm;
            t20 = R::zero();
            let h = R::sum_prod2(u0, t11, u1, t21);
            let w = h + h;
            let nw = -w;
            t11 = R::mul_add(nw, u0, t11);
            t21 = R::mul_add(nw, u1, t21);
            let h = R::sum_prod2(u0, t12, u1, t22);
            let w = h + h;
            let nw = -w;
            t12 = R::mul_add(nw, u0, t12);
            t22 = R::mul_add(nw, u1, t22);
            let h = R::sum_prod2(u0, t13, u1, t23);
            let w = h + h;
            let nw = -w;
            t13 = R::mul_add(nw, u0, t13);
            t23 = R::mul_add(nw, u1, t23);
            let h = R::sum_prod2(t01, u0, t02, u1);
            let w = h + h;
            let nw = -w;
            t01 = R::mul_add(nw, u0, t01);
            t02 = R::mul_add(nw, u1, t02);
            let h = R::sum_prod2(t11, u0, t12, u1);
            let w = h + h;
            let nw = -w;
            t11 = R::mul_add(nw, u0, t11);
            t12 = R::mul_add(nw, u1, t12);
            let h = R::sum_prod2(t21, u0, t22, u1);
            let w = h + h;
            let nw = -w;
            t21 = R::mul_add(nw, u0, t21);
            t22 = R::mul_add(nw, u1, t22);
            if compute_q {
                let h = R::sum_prod2(q01, u0, q02, u1);
                let w = h + h;
                let nw = -w;
                q01 = R::mul_add(nw, u0, q01);
                q02 = R::mul_add(nw, u1, q02);
                let h = R::sum_prod2(q11, u0, q12, u1);
                let w = h + h;
                let nw = -w;
                q11 = R::mul_add(nw, u0, q11);
                q12 = R::mul_add(nw, u1, q12);
                let h = R::sum_prod2(q21, u0, q22, u1);
                let w = h + h;
                let nw = -w;
                q21 = R::mul_add(nw, u0, q21);
                q22 = R::mul_add(nw, u1, q22);
                let h = R::sum_prod2(q31, u0, q32, u1);
                let w = h + h;
                let nw = -w;
                q31 = R::mul_add(nw, u0, q31);
                q32 = R::mul_add(nw, u1, q32);
            }
        }
        t =
            Matrix4 {
                m11: t00,
                m21: t10,
                m31: t20,
                m41: t30,
                m12: t01,
                m22: t11,
                m32: t21,
                m42: t31,
                m13: t02,
                m23: t12,
                m33: t22,
                m43: t32,
                m14: t03,
                m24: t13,
                m34: t23,
                m44: t33,
            };
        q =
            Matrix4 {
                m11: q00,
                m21: q10,
                m31: q20,
                m41: q30,
                m12: q01,
                m22: q11,
                m32: q21,
                m42: q31,
                m13: q02,
                m23: q12,
                m33: q22,
                m43: q32,
                m14: q03,
                m24: q13,
                m34: q23,
                m44: q33,
            };
    }

    /// One implicit double-shift (Francis) QR step on the active window 0..=3, upstream's
    /// `subdim > 2` branch: the bulge made by the first column of `(H - σ1)(H - σ2)` (`σ` the
    /// eigenvalues of the trailing 2x2 block) is chased down by 3-reflections, then a 2-reflection
    /// on the rows 2, 3; each reflection is applied to `t` from both sides (the whole rows /
    /// columns of the quasi-triangular form) and to the columns of `q`.
    fn francis0_3(ref t: Matrix4<T>, ref q: Matrix4<T>, compute_q: bool) {
        revoke_ap_tracking();
        let mut t00 = t.m11;
        let mut t10 = t.m21;
        let mut t20 = t.m31;
        let mut t30 = t.m41;
        let mut t01 = t.m12;
        let mut t11 = t.m22;
        let mut t21 = t.m32;
        let mut t31 = t.m42;
        let mut t02 = t.m13;
        let mut t12 = t.m23;
        let mut t22 = t.m33;
        let mut t32 = t.m43;
        let mut t03 = t.m14;
        let mut t13 = t.m24;
        let mut t23 = t.m34;
        let mut t33 = t.m44;
        let mut q00 = q.m11;
        let mut q10 = q.m21;
        let mut q20 = q.m31;
        let mut q30 = q.m41;
        let mut q01 = q.m12;
        let mut q11 = q.m22;
        let mut q21 = q.m32;
        let mut q31 = q.m42;
        let mut q02 = q.m13;
        let mut q12 = q.m23;
        let mut q22 = q.m33;
        let mut q32 = q.m43;
        let mut q03 = q.m14;
        let mut q13 = q.m24;
        let mut q23 = q.m34;
        let mut q33 = q.m44;
        let h11 = t00;
        let h12 = t01;
        let h21 = t10;
        let h22 = t11;
        let h32 = t21;
        let hnn = t33;
        let hmm = t22;
        let hnm = t32;
        let hmn = t23;
        let tra = hnn + hmm;
        let d1 = h11 - hmm;
        let d2 = h11 - hnn;
        let sc = R::abs(h21) + R::abs(d1) + R::abs(d2) + R::abs(hnm);
        let (p, r, g) = R::div3(d1, hnm, h21, sc);
        let mut ax = R::wide_rescale(
            R::wide_add_prod(
                R::wide_sub_prod(R::wide_add_prod(R::wide_zero(), p, d2), hmn, r), h12, g,
            ),
        );
        let mut ay = g * (h11 + h22 - tra);
        let mut az = g * h32;
        // bulge at column 0
        let (nrm, nz, u0, u1, u2) = HouseholderKernelTrait::<T>::axis3(ax, ay, az);
        if nz {
            let _ = nrm;
            let h = R::sum_prod3(u0, t00, u1, t10, u2, t20);
            let w = h + h;
            let nw = -w;
            t00 = R::mul_add(nw, u0, t00);
            t10 = R::mul_add(nw, u1, t10);
            t20 = R::mul_add(nw, u2, t20);
            let h = R::sum_prod3(u0, t01, u1, t11, u2, t21);
            let w = h + h;
            let nw = -w;
            t01 = R::mul_add(nw, u0, t01);
            t11 = R::mul_add(nw, u1, t11);
            t21 = R::mul_add(nw, u2, t21);
            let h = R::sum_prod3(u0, t02, u1, t12, u2, t22);
            let w = h + h;
            let nw = -w;
            t02 = R::mul_add(nw, u0, t02);
            t12 = R::mul_add(nw, u1, t12);
            t22 = R::mul_add(nw, u2, t22);
            let h = R::sum_prod3(u0, t03, u1, t13, u2, t23);
            let w = h + h;
            let nw = -w;
            t03 = R::mul_add(nw, u0, t03);
            t13 = R::mul_add(nw, u1, t13);
            t23 = R::mul_add(nw, u2, t23);
            let h = R::sum_prod3(t00, u0, t01, u1, t02, u2);
            let w = h + h;
            let nw = -w;
            t00 = R::mul_add(nw, u0, t00);
            t01 = R::mul_add(nw, u1, t01);
            t02 = R::mul_add(nw, u2, t02);
            let h = R::sum_prod3(t10, u0, t11, u1, t12, u2);
            let w = h + h;
            let nw = -w;
            t10 = R::mul_add(nw, u0, t10);
            t11 = R::mul_add(nw, u1, t11);
            t12 = R::mul_add(nw, u2, t12);
            let h = R::sum_prod3(t20, u0, t21, u1, t22, u2);
            let w = h + h;
            let nw = -w;
            t20 = R::mul_add(nw, u0, t20);
            t21 = R::mul_add(nw, u1, t21);
            t22 = R::mul_add(nw, u2, t22);
            let h = R::sum_prod3(t30, u0, t31, u1, t32, u2);
            let w = h + h;
            let nw = -w;
            t30 = R::mul_add(nw, u0, t30);
            t31 = R::mul_add(nw, u1, t31);
            t32 = R::mul_add(nw, u2, t32);
            if compute_q {
                let h = R::sum_prod3(q00, u0, q01, u1, q02, u2);
                let w = h + h;
                let nw = -w;
                q00 = R::mul_add(nw, u0, q00);
                q01 = R::mul_add(nw, u1, q01);
                q02 = R::mul_add(nw, u2, q02);
                let h = R::sum_prod3(q10, u0, q11, u1, q12, u2);
                let w = h + h;
                let nw = -w;
                q10 = R::mul_add(nw, u0, q10);
                q11 = R::mul_add(nw, u1, q11);
                q12 = R::mul_add(nw, u2, q12);
                let h = R::sum_prod3(q20, u0, q21, u1, q22, u2);
                let w = h + h;
                let nw = -w;
                q20 = R::mul_add(nw, u0, q20);
                q21 = R::mul_add(nw, u1, q21);
                q22 = R::mul_add(nw, u2, q22);
                let h = R::sum_prod3(q30, u0, q31, u1, q32, u2);
                let w = h + h;
                let nw = -w;
                q30 = R::mul_add(nw, u0, q30);
                q31 = R::mul_add(nw, u1, q31);
                q32 = R::mul_add(nw, u2, q32);
            }
        }
        ax = t10;
        ay = t20;
        az = t30;
        // bulge at column 1
        let (nrm, nz, u0, u1, u2) = HouseholderKernelTrait::<T>::axis3(ax, ay, az);
        if nz {
            t10 = nrm;
            t20 = R::zero();
            t30 = R::zero();
            let h = R::sum_prod3(u0, t11, u1, t21, u2, t31);
            let w = h + h;
            let nw = -w;
            t11 = R::mul_add(nw, u0, t11);
            t21 = R::mul_add(nw, u1, t21);
            t31 = R::mul_add(nw, u2, t31);
            let h = R::sum_prod3(u0, t12, u1, t22, u2, t32);
            let w = h + h;
            let nw = -w;
            t12 = R::mul_add(nw, u0, t12);
            t22 = R::mul_add(nw, u1, t22);
            t32 = R::mul_add(nw, u2, t32);
            let h = R::sum_prod3(u0, t13, u1, t23, u2, t33);
            let w = h + h;
            let nw = -w;
            t13 = R::mul_add(nw, u0, t13);
            t23 = R::mul_add(nw, u1, t23);
            t33 = R::mul_add(nw, u2, t33);
            let h = R::sum_prod3(t01, u0, t02, u1, t03, u2);
            let w = h + h;
            let nw = -w;
            t01 = R::mul_add(nw, u0, t01);
            t02 = R::mul_add(nw, u1, t02);
            t03 = R::mul_add(nw, u2, t03);
            let h = R::sum_prod3(t11, u0, t12, u1, t13, u2);
            let w = h + h;
            let nw = -w;
            t11 = R::mul_add(nw, u0, t11);
            t12 = R::mul_add(nw, u1, t12);
            t13 = R::mul_add(nw, u2, t13);
            let h = R::sum_prod3(t21, u0, t22, u1, t23, u2);
            let w = h + h;
            let nw = -w;
            t21 = R::mul_add(nw, u0, t21);
            t22 = R::mul_add(nw, u1, t22);
            t23 = R::mul_add(nw, u2, t23);
            let h = R::sum_prod3(t31, u0, t32, u1, t33, u2);
            let w = h + h;
            let nw = -w;
            t31 = R::mul_add(nw, u0, t31);
            t32 = R::mul_add(nw, u1, t32);
            t33 = R::mul_add(nw, u2, t33);
            if compute_q {
                let h = R::sum_prod3(q01, u0, q02, u1, q03, u2);
                let w = h + h;
                let nw = -w;
                q01 = R::mul_add(nw, u0, q01);
                q02 = R::mul_add(nw, u1, q02);
                q03 = R::mul_add(nw, u2, q03);
                let h = R::sum_prod3(q11, u0, q12, u1, q13, u2);
                let w = h + h;
                let nw = -w;
                q11 = R::mul_add(nw, u0, q11);
                q12 = R::mul_add(nw, u1, q12);
                q13 = R::mul_add(nw, u2, q13);
                let h = R::sum_prod3(q21, u0, q22, u1, q23, u2);
                let w = h + h;
                let nw = -w;
                q21 = R::mul_add(nw, u0, q21);
                q22 = R::mul_add(nw, u1, q22);
                q23 = R::mul_add(nw, u2, q23);
                let h = R::sum_prod3(q31, u0, q32, u1, q33, u2);
                let w = h + h;
                let nw = -w;
                q31 = R::mul_add(nw, u0, q31);
                q32 = R::mul_add(nw, u1, q32);
                q33 = R::mul_add(nw, u2, q33);
            }
        }
        ax = t21;
        ay = t31;
        let _ = az;
        let (nrm, nz, u0, u1) = HouseholderKernelTrait::<T>::axis2(ax, ay);
        if nz {
            t21 = nrm;
            t31 = R::zero();
            let h = R::sum_prod2(u0, t22, u1, t32);
            let w = h + h;
            let nw = -w;
            t22 = R::mul_add(nw, u0, t22);
            t32 = R::mul_add(nw, u1, t32);
            let h = R::sum_prod2(u0, t23, u1, t33);
            let w = h + h;
            let nw = -w;
            t23 = R::mul_add(nw, u0, t23);
            t33 = R::mul_add(nw, u1, t33);
            let h = R::sum_prod2(t02, u0, t03, u1);
            let w = h + h;
            let nw = -w;
            t02 = R::mul_add(nw, u0, t02);
            t03 = R::mul_add(nw, u1, t03);
            let h = R::sum_prod2(t12, u0, t13, u1);
            let w = h + h;
            let nw = -w;
            t12 = R::mul_add(nw, u0, t12);
            t13 = R::mul_add(nw, u1, t13);
            let h = R::sum_prod2(t22, u0, t23, u1);
            let w = h + h;
            let nw = -w;
            t22 = R::mul_add(nw, u0, t22);
            t23 = R::mul_add(nw, u1, t23);
            let h = R::sum_prod2(t32, u0, t33, u1);
            let w = h + h;
            let nw = -w;
            t32 = R::mul_add(nw, u0, t32);
            t33 = R::mul_add(nw, u1, t33);
            if compute_q {
                let h = R::sum_prod2(q02, u0, q03, u1);
                let w = h + h;
                let nw = -w;
                q02 = R::mul_add(nw, u0, q02);
                q03 = R::mul_add(nw, u1, q03);
                let h = R::sum_prod2(q12, u0, q13, u1);
                let w = h + h;
                let nw = -w;
                q12 = R::mul_add(nw, u0, q12);
                q13 = R::mul_add(nw, u1, q13);
                let h = R::sum_prod2(q22, u0, q23, u1);
                let w = h + h;
                let nw = -w;
                q22 = R::mul_add(nw, u0, q22);
                q23 = R::mul_add(nw, u1, q23);
                let h = R::sum_prod2(q32, u0, q33, u1);
                let w = h + h;
                let nw = -w;
                q32 = R::mul_add(nw, u0, q32);
                q33 = R::mul_add(nw, u1, q33);
            }
        }
        t =
            Matrix4 {
                m11: t00,
                m21: t10,
                m31: t20,
                m41: t30,
                m12: t01,
                m22: t11,
                m32: t21,
                m42: t31,
                m13: t02,
                m23: t12,
                m33: t22,
                m43: t32,
                m14: t03,
                m24: t13,
                m34: t23,
                m44: t33,
            };
        q =
            Matrix4 {
                m11: q00,
                m21: q10,
                m31: q20,
                m41: q30,
                m12: q01,
                m22: q11,
                m32: q21,
                m42: q31,
                m13: q02,
                m23: q12,
                m33: q22,
                m43: q32,
                m14: q03,
                m24: q13,
                m34: q23,
                m44: q33,
            };
    }

    /// One implicit double-shift (Francis) QR step on the active window 1..=3, upstream's
    /// `subdim > 2` branch: the bulge made by the first column of `(H - σ1)(H - σ2)` (`σ` the
    /// eigenvalues of the trailing 2x2 block) is chased down by 3-reflections, then a 2-reflection
    /// on the rows 2, 3; each reflection is applied to `t` from both sides (the whole rows /
    /// columns of the quasi-triangular form) and to the columns of `q`.
    fn francis1_3(ref t: Matrix4<T>, ref q: Matrix4<T>, compute_q: bool) {
        revoke_ap_tracking();
        let mut t00 = t.m11;
        let mut t10 = t.m21;
        let mut t20 = t.m31;
        let mut t30 = t.m41;
        let mut t01 = t.m12;
        let mut t11 = t.m22;
        let mut t21 = t.m32;
        let mut t31 = t.m42;
        let mut t02 = t.m13;
        let mut t12 = t.m23;
        let mut t22 = t.m33;
        let mut t32 = t.m43;
        let mut t03 = t.m14;
        let mut t13 = t.m24;
        let mut t23 = t.m34;
        let mut t33 = t.m44;
        let mut q00 = q.m11;
        let mut q10 = q.m21;
        let mut q20 = q.m31;
        let mut q30 = q.m41;
        let mut q01 = q.m12;
        let mut q11 = q.m22;
        let mut q21 = q.m32;
        let mut q31 = q.m42;
        let mut q02 = q.m13;
        let mut q12 = q.m23;
        let mut q22 = q.m33;
        let mut q32 = q.m43;
        let mut q03 = q.m14;
        let mut q13 = q.m24;
        let mut q23 = q.m34;
        let mut q33 = q.m44;
        let h11 = t11;
        let h12 = t12;
        let h21 = t21;
        let h22 = t22;
        let h32 = t32;
        let hnn = t33;
        let hmm = t22;
        let hnm = t32;
        let hmn = t23;
        let tra = hnn + hmm;
        let d1 = h11 - hmm;
        let d2 = h11 - hnn;
        let sc = R::abs(h21) + R::abs(d1) + R::abs(d2) + R::abs(hnm);
        let (p, r, g) = R::div3(d1, hnm, h21, sc);
        let mut ax = R::wide_rescale(
            R::wide_add_prod(
                R::wide_sub_prod(R::wide_add_prod(R::wide_zero(), p, d2), hmn, r), h12, g,
            ),
        );
        let mut ay = g * (h11 + h22 - tra);
        let mut az = g * h32;
        // bulge at column 1
        let (nrm, nz, u0, u1, u2) = HouseholderKernelTrait::<T>::axis3(ax, ay, az);
        if nz {
            let _ = nrm;
            let h = R::sum_prod3(u0, t11, u1, t21, u2, t31);
            let w = h + h;
            let nw = -w;
            t11 = R::mul_add(nw, u0, t11);
            t21 = R::mul_add(nw, u1, t21);
            t31 = R::mul_add(nw, u2, t31);
            let h = R::sum_prod3(u0, t12, u1, t22, u2, t32);
            let w = h + h;
            let nw = -w;
            t12 = R::mul_add(nw, u0, t12);
            t22 = R::mul_add(nw, u1, t22);
            t32 = R::mul_add(nw, u2, t32);
            let h = R::sum_prod3(u0, t13, u1, t23, u2, t33);
            let w = h + h;
            let nw = -w;
            t13 = R::mul_add(nw, u0, t13);
            t23 = R::mul_add(nw, u1, t23);
            t33 = R::mul_add(nw, u2, t33);
            let h = R::sum_prod3(t01, u0, t02, u1, t03, u2);
            let w = h + h;
            let nw = -w;
            t01 = R::mul_add(nw, u0, t01);
            t02 = R::mul_add(nw, u1, t02);
            t03 = R::mul_add(nw, u2, t03);
            let h = R::sum_prod3(t11, u0, t12, u1, t13, u2);
            let w = h + h;
            let nw = -w;
            t11 = R::mul_add(nw, u0, t11);
            t12 = R::mul_add(nw, u1, t12);
            t13 = R::mul_add(nw, u2, t13);
            let h = R::sum_prod3(t21, u0, t22, u1, t23, u2);
            let w = h + h;
            let nw = -w;
            t21 = R::mul_add(nw, u0, t21);
            t22 = R::mul_add(nw, u1, t22);
            t23 = R::mul_add(nw, u2, t23);
            let h = R::sum_prod3(t31, u0, t32, u1, t33, u2);
            let w = h + h;
            let nw = -w;
            t31 = R::mul_add(nw, u0, t31);
            t32 = R::mul_add(nw, u1, t32);
            t33 = R::mul_add(nw, u2, t33);
            if compute_q {
                let h = R::sum_prod3(q01, u0, q02, u1, q03, u2);
                let w = h + h;
                let nw = -w;
                q01 = R::mul_add(nw, u0, q01);
                q02 = R::mul_add(nw, u1, q02);
                q03 = R::mul_add(nw, u2, q03);
                let h = R::sum_prod3(q11, u0, q12, u1, q13, u2);
                let w = h + h;
                let nw = -w;
                q11 = R::mul_add(nw, u0, q11);
                q12 = R::mul_add(nw, u1, q12);
                q13 = R::mul_add(nw, u2, q13);
                let h = R::sum_prod3(q21, u0, q22, u1, q23, u2);
                let w = h + h;
                let nw = -w;
                q21 = R::mul_add(nw, u0, q21);
                q22 = R::mul_add(nw, u1, q22);
                q23 = R::mul_add(nw, u2, q23);
                let h = R::sum_prod3(q31, u0, q32, u1, q33, u2);
                let w = h + h;
                let nw = -w;
                q31 = R::mul_add(nw, u0, q31);
                q32 = R::mul_add(nw, u1, q32);
                q33 = R::mul_add(nw, u2, q33);
            }
        }
        ax = t21;
        ay = t31;
        let _ = az;
        let (nrm, nz, u0, u1) = HouseholderKernelTrait::<T>::axis2(ax, ay);
        if nz {
            t21 = nrm;
            t31 = R::zero();
            let h = R::sum_prod2(u0, t22, u1, t32);
            let w = h + h;
            let nw = -w;
            t22 = R::mul_add(nw, u0, t22);
            t32 = R::mul_add(nw, u1, t32);
            let h = R::sum_prod2(u0, t23, u1, t33);
            let w = h + h;
            let nw = -w;
            t23 = R::mul_add(nw, u0, t23);
            t33 = R::mul_add(nw, u1, t33);
            let h = R::sum_prod2(t02, u0, t03, u1);
            let w = h + h;
            let nw = -w;
            t02 = R::mul_add(nw, u0, t02);
            t03 = R::mul_add(nw, u1, t03);
            let h = R::sum_prod2(t12, u0, t13, u1);
            let w = h + h;
            let nw = -w;
            t12 = R::mul_add(nw, u0, t12);
            t13 = R::mul_add(nw, u1, t13);
            let h = R::sum_prod2(t22, u0, t23, u1);
            let w = h + h;
            let nw = -w;
            t22 = R::mul_add(nw, u0, t22);
            t23 = R::mul_add(nw, u1, t23);
            let h = R::sum_prod2(t32, u0, t33, u1);
            let w = h + h;
            let nw = -w;
            t32 = R::mul_add(nw, u0, t32);
            t33 = R::mul_add(nw, u1, t33);
            if compute_q {
                let h = R::sum_prod2(q02, u0, q03, u1);
                let w = h + h;
                let nw = -w;
                q02 = R::mul_add(nw, u0, q02);
                q03 = R::mul_add(nw, u1, q03);
                let h = R::sum_prod2(q12, u0, q13, u1);
                let w = h + h;
                let nw = -w;
                q12 = R::mul_add(nw, u0, q12);
                q13 = R::mul_add(nw, u1, q13);
                let h = R::sum_prod2(q22, u0, q23, u1);
                let w = h + h;
                let nw = -w;
                q22 = R::mul_add(nw, u0, q22);
                q23 = R::mul_add(nw, u1, q23);
                let h = R::sum_prod2(q32, u0, q33, u1);
                let w = h + h;
                let nw = -w;
                q32 = R::mul_add(nw, u0, q32);
                q33 = R::mul_add(nw, u1, q33);
            }
        }
        t =
            Matrix4 {
                m11: t00,
                m21: t10,
                m31: t20,
                m41: t30,
                m12: t01,
                m22: t11,
                m32: t21,
                m42: t31,
                m13: t02,
                m23: t12,
                m33: t22,
                m43: t32,
                m14: t03,
                m24: t13,
                m34: t23,
                m44: t33,
            };
        q =
            Matrix4 {
                m11: q00,
                m21: q10,
                m31: q20,
                m41: q30,
                m12: q01,
                m22: q11,
                m32: q21,
                m42: q31,
                m13: q02,
                m23: q12,
                m33: q22,
                m43: q32,
                m14: q03,
                m24: q13,
                m34: q23,
                m44: q33,
            };
    }
}

/// `Matrix4` methods that go through the Schur decomposition. Import `Matrix4SchurTrait`.
#[generate_trait]
pub impl Matrix4SchurImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix4SchurTrait<T> {
    /// The real Schur decomposition. Upstream: `SquareMatrix::schur`.
    #[inline(always)]
    fn schur(self: Matrix4<T>) -> Schur4<T> {
        Schur4Trait::new(self)
    }

    /// The real Schur decomposition, or `None` when `max_niter` iterations (`0`: no limit) do not
    /// converge (see `Schur4Trait::try_new`). Upstream: `SquareMatrix::try_schur`.
    #[inline(always)]
    fn try_schur(self: Matrix4<T>, eps: T, max_niter: usize) -> Option<Schur4<T>> {
        Schur4Trait::try_new(self, eps, max_niter)
    }

    /// The eigenvalues when they are all real, `None` otherwise: the Schur iteration without `Q`
    /// (`compute_q` false: the `q` updates are skipped), `None` when `T` has a 2x2 block. Upstream:
    /// `SquareMatrix::eigenvalues`.
    fn eigenvalues(self: Matrix4<T>) -> Option<Vector4<T>> {
        let (q, t) = Schur4KernelTrait::decompose(self, R::default_epsilon(), 0, false).unwrap();
        Schur4Trait::eigenvalues(Schur4 { q, t })
    }

    /// The complex eigenvalues `(re, im)` (see `Schur4Trait::complex_eigenvalues`) of the Schur
    /// iteration without `Q`.
    /// Upstream: `SquareMatrix::complex_eigenvalues`.
    fn complex_eigenvalues(self: Matrix4<T>) -> (Vector4<T>, Vector4<T>) {
        let (q, t) = Schur4KernelTrait::decompose(self, R::default_epsilon(), 0, false).unwrap();
        Schur4Trait::complex_eigenvalues(Schur4 { q, t })
    }
}
