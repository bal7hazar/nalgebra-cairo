            Matrix4 {
                m11: q00,
                m21: q10,
                m31: q20,
                m41: q30,
                m12: q01,
                m22: q11,
                m32: q21,
                m42: q31,
                m13: q02,
                m23: q12,
                m33: q22,
                m43: q32,
                m14: q03,
                m24: q13,
                m34: q23,
                m44: q33,
