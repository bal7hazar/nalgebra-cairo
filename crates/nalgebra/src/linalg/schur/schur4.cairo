                let a = t02;
                let b = t12;
                t02 = R::sum_prod2(a, c, sn, b);
                t12 = R::diff_prod(c, b, sn, a);
                let a = t03;
                let b = t13;
                t03 = R::sum_prod2(a, c, sn, b);
                t13 = R::diff_prod(c, b, sn, a);
                let a = t00;
                let b = t01;
                t00 = R::sum_prod2(a, c, sn, b);
                t01 = R::diff_prod(c, b, sn, a);
                let a = t10;
                let b = t11;
                t10 = R::sum_prod2(a, c, sn, b);
                t11 = R::diff_prod(c, b, sn, a);
