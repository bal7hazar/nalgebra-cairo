    /// The 2x2 block at rows / columns 1, 2 (upstream's `compute_2x2_basis` branch): when
    /// its eigenvalues are real, the Givens rotation that upper-triangulates it is applied to the
    /// rows 1, 2 of `t` (columns 1..), to its columns 1, 2 (rows ..=2) and to the
    /// columns of `q`, and the entry (2, 1) is set to zero.
    fn block1(ref t: Matrix4<T>, ref q: Matrix4<T>, compute_q: bool) {
        let mut t00 = t.m11;
        let mut t10 = t.m21;
        let mut t20 = t.m31;
        let mut t30 = t.m41;
        let mut t01 = t.m12;
        let mut t11 = t.m22;
        let mut t21 = t.m32;
        let mut t31 = t.m42;
        let mut t02 = t.m13;
        let mut t12 = t.m23;
        let mut t22 = t.m33;
        let mut t32 = t.m43;
        let mut t03 = t.m14;
        let mut t13 = t.m24;
        let mut t23 = t.m34;
        let mut t33 = t.m44;
        let mut q00 = q.m11;
        let mut q10 = q.m21;
        let mut q20 = q.m31;
        let mut q30 = q.m41;
        let mut q01 = q.m12;
        let mut q11 = q.m22;
        let mut q21 = q.m32;
        let mut q31 = q.m42;
        let mut q02 = q.m13;
        let mut q12 = q.m23;
        let mut q22 = q.m33;
        let mut q32 = q.m43;
        let mut q03 = q.m14;
        let mut q13 = q.m24;
        let mut q23 = q.m34;
        let mut q33 = q.m44;
        let h00 = t11;
        let h01 = t12;
        let h10 = t21;
        let h11 = t22;
        if h10 != R::zero() {
            let half = R::from_ratio(1, 2);
            let dd = h00 - h11;
            let d4 = HouseholderKernelTrait::<T>::disc4(h00, h01, h10, h11);
            if d4 >= R::zero() {
                let sq = HouseholderKernelTrait::<T>::sqrt_disc4(h00, h01, h10, h11);
                let x1 = (dd + sq) * half;
                let x2 = (dd - sq) * half;
                let x = if R::abs(x1) > R::abs(x2) {
                    x1
                } else {
                    x2
                };
                let (c, sn) = HouseholderKernelTrait::<T>::givens(x, h10);
                let a = t11;
                let b = t21;
                t11 = R::sum_prod2(a, c, sn, b);
                t21 = R::diff_prod(c, b, sn, a);
                let a = t12;
                let b = t22;
                t12 = R::sum_prod2(a, c, sn, b);
                t22 = R::diff_prod(c, b, sn, a);
                let a = t13;
                let b = t23;
                t13 = R::sum_prod2(a, c, sn, b);
                t23 = R::diff_prod(c, b, sn, a);
                let a = t01;
                let b = t02;
                t01 = R::sum_prod2(a, c, sn, b);
                t02 = R::diff_prod(c, b, sn, a);
                let a = t11;
                let b = t12;
                t11 = R::sum_prod2(a, c, sn, b);
                t12 = R::diff_prod(c, b, sn, a);
                let a = t21;
                let b = t22;
                t21 = R::sum_prod2(a, c, sn, b);
                t22 = R::diff_prod(c, b, sn, a);
                t21 = R::zero();
                t11 = h11 + x;
                t22 = h00 - x;
                if compute_q {
                    let a = q01;
                    let b = q02;
                    q01 = R::sum_prod2(a, c, sn, b);
                    q02 = R::diff_prod(c, b, sn, a);
                    let a = q11;
                    let b = q12;
                    q11 = R::sum_prod2(a, c, sn, b);
                    q12 = R::diff_prod(c, b, sn, a);
                    let a = q21;
                    let b = q22;
                    q21 = R::sum_prod2(a, c, sn, b);
                    q22 = R::diff_prod(c, b, sn, a);
                    let a = q31;
                    let b = q32;
                    q31 = R::sum_prod2(a, c, sn, b);
                    q32 = R::diff_prod(c, b, sn, a);
                }
            }
        }
        t =
            Matrix4 {
                m11: t00,
                m21: t10,
                m31: t20,
                m41: t30,
                m12: t01,
                m22: t11,
                m32: t21,
                m42: t31,
                m13: t02,
                m23: t12,
                m33: t22,
                m43: t32,
                m14: t03,
                m24: t13,
                m34: t23,
                m44: t33,
            };
        q =
            Matrix4 {
                m11: q00,
                m21: q10,
                m31: q20,
                m41: q30,
                m12: q01,
                m22: q11,
                m32: q21,
                m42: q31,
                m13: q02,
                m23: q12,
                m33: q22,
                m43: q32,
                m14: q03,
                m24: q13,
                m34: q23,
                m44: q33,
            };
    }

    /// The 2x2 block at rows / columns 2, 3 (upstream's `compute_2x2_basis` branch): when
    /// its eigenvalues are real, the Givens rotation that upper-triangulates it is applied to the
    /// rows 2, 3 of `t` (columns 2..), to its columns 2, 3 (rows ..=3) and to the
    /// columns of `q`, and the entry (3, 2) is set to zero.
    fn block2(ref t: Matrix4<T>, ref q: Matrix4<T>, compute_q: bool) {
        let mut t00 = t.m11;
        let mut t10 = t.m21;
        let mut t20 = t.m31;
        let mut t30 = t.m41;
        let mut t01 = t.m12;
        let mut t11 = t.m22;
        let mut t21 = t.m32;
        let mut t31 = t.m42;
        let mut t02 = t.m13;
        let mut t12 = t.m23;
        let mut t22 = t.m33;
        let mut t32 = t.m43;
        let mut t03 = t.m14;
        let mut t13 = t.m24;
        let mut t23 = t.m34;
        let mut t33 = t.m44;
        let mut q00 = q.m11;
        let mut q10 = q.m21;
        let mut q20 = q.m31;
        let mut q30 = q.m41;
        let mut q01 = q.m12;
        let mut q11 = q.m22;
        let mut q21 = q.m32;
        let mut q31 = q.m42;
        let mut q02 = q.m13;
        let mut q12 = q.m23;
        let mut q22 = q.m33;
        let mut q32 = q.m43;
        let mut q03 = q.m14;
        let mut q13 = q.m24;
        let mut q23 = q.m34;
        let mut q33 = q.m44;
        let h00 = t22;
        let h01 = t23;
        let h10 = t32;
        let h11 = t33;
        if h10 != R::zero() {
            let half = R::from_ratio(1, 2);
            let dd = h00 - h11;
            let d4 = HouseholderKernelTrait::<T>::disc4(h00, h01, h10, h11);
            if d4 >= R::zero() {
                let sq = HouseholderKernelTrait::<T>::sqrt_disc4(h00, h01, h10, h11);
                let x1 = (dd + sq) * half;
                let x2 = (dd - sq) * half;
                let x = if R::abs(x1) > R::abs(x2) {
                    x1
                } else {
                    x2
                };
                let (c, sn) = HouseholderKernelTrait::<T>::givens(x, h10);
                let a = t22;
                let b = t32;
                t22 = R::sum_prod2(a, c, sn, b);
                t32 = R::diff_prod(c, b, sn, a);
                let a = t23;
                let b = t33;
                t23 = R::sum_prod2(a, c, sn, b);
                t33 = R::diff_prod(c, b, sn, a);
                let a = t02;
                let b = t03;
                t02 = R::sum_prod2(a, c, sn, b);
                t03 = R::diff_prod(c, b, sn, a);
                let a = t12;
                let b = t13;
                t12 = R::sum_prod2(a, c, sn, b);
                t13 = R::diff_prod(c, b, sn, a);
                let a = t22;
                let b = t23;
                t22 = R::sum_prod2(a, c, sn, b);
                t23 = R::diff_prod(c, b, sn, a);
                let a = t32;
                let b = t33;
                t32 = R::sum_prod2(a, c, sn, b);
                t33 = R::diff_prod(c, b, sn, a);
                t32 = R::zero();
                t22 = h11 + x;
                t33 = h00 - x;
                if compute_q {
                    let a = q02;
                    let b = q03;
                    q02 = R::sum_prod2(a, c, sn, b);
                    q03 = R::diff_prod(c, b, sn, a);
                    let a = q12;
                    let b = q13;
                    q12 = R::sum_prod2(a, c, sn, b);
                    q13 = R::diff_prod(c, b, sn, a);
                    let a = q22;
                    let b = q23;
                    q22 = R::sum_prod2(a, c, sn, b);
                    q23 = R::diff_prod(c, b, sn, a);
                    let a = q32;
                    let b = q33;
                    q32 = R::sum_prod2(a, c, sn, b);
                    q33 = R::diff_prod(c, b, sn, a);
                }
            }
        }
        t =
            Matrix4 {
                m11: t00,
                m21: t10,
                m31: t20,
                m41: t30,
                m12: t01,
                m22: t11,
                m32: t21,
                m42: t31,
                m13: t02,
                m23: t12,
                m33: t22,
                m43: t32,
                m14: t03,
                m24: t13,
                m34: t23,
                m44: t33,
