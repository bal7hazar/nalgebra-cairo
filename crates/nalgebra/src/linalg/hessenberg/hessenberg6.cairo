    /// `(Q, H)`: `(q(), unpack_h())`. Upstream: `Hessenberg::unpack`.
    #[inline(always)]
    fn unpack(self: Hessenberg6<T>) -> (Matrix6<T>, Matrix6<T>) {
        (Self::q(self), Self::unpack_h(self))
    }

    /// The upper Hessenberg matrix `H`: `hess` with zeros below the first subdiagonal and
    /// `|subdiag|` on it. Exact (moves and absolute values). Upstream: `Hessenberg::unpack_h`.
    #[inline(always)]
    fn unpack_h(self: Hessenberg6<T>) -> Matrix6<T> {
        Matrix6 {
            m11: self.hess.m11,
            m21: R::abs(self.subdiag.x),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m61: R::zero(),
            m12: self.hess.m12,
            m22: self.hess.m22,
            m32: R::abs(self.subdiag.y),
            m42: R::zero(),
            m52: R::zero(),
            m62: R::zero(),
            m13: self.hess.m13,
            m23: self.hess.m23,
            m33: self.hess.m33,
            m43: R::abs(self.subdiag.z),
            m53: R::zero(),
            m63: R::zero(),
            m14: self.hess.m14,
            m24: self.hess.m24,
            m34: self.hess.m34,
            m44: self.hess.m44,
            m54: R::abs(self.subdiag.w),
            m64: R::zero(),
            m15: self.hess.m15,
            m25: self.hess.m25,
            m35: self.hess.m35,
            m45: self.hess.m45,
            m55: self.hess.m55,
            m65: R::abs(self.subdiag.a),
            m16: self.hess.m16,
            m26: self.hess.m26,
            m36: self.hess.m36,
            m46: self.hess.m46,
            m56: self.hess.m56,
            m66: self.hess.m66,
        }
    }

    /// `H`, like `unpack_h` (upstream's `h` borrows, `unpack_h` consumes: Cairo copies). Upstream:
    /// `Hessenberg::h`.
    #[inline(always)]
    fn h(self: Hessenberg6<T>) -> Matrix6<T> {
        Self::unpack_h(self)
    }

    /// The orthogonal factor `Q`: upstream's `householder::assemble_q`, the 5 signed
    /// reflections applied in reverse order to the identity on symbolic entries (its static zeros
    /// and ones cost nothing): one fused dot product per column and reflection (doubled exactly),
    /// one `Real::mul_add` per entry. Upstream: `Hessenberg::q`.
    fn q(self: Hessenberg6<T>) -> Matrix6<T> {
        revoke_ap_tracking();
        let sq4 = self.subdiag.a < R::zero();
        let q4_v0 = self.hess.m65 + self.hess.m65;
        let q4_nv0 = -q4_v0;
        let h = self.hess.m65;
        let q4_55 = if sq4 {
            R::mul_add(h, q4_v0, -R::one())
        } else {
            R::mul_add(h, q4_nv0, R::one())
        };
        let sq3 = self.subdiag.w < R::zero();
        let q3_v0 = self.hess.m54 + self.hess.m54;
        let q3_nv0 = -q3_v0;
        let q3_v1 = self.hess.m64 + self.hess.m64;
        let q3_nv1 = -q3_v1;
        let h = self.hess.m54;
        let q3_44 = if sq3 {
            R::mul_add(h, q3_v0, -R::one())
        } else {
            R::mul_add(h, q3_nv0, R::one())
        };
        let q3_54 = if sq3 {
            h * q3_v1
        } else {
            h * q3_nv1
        };
