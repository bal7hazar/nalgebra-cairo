            let h = u3_0 * a44;
            a44 = if neg {
                R::mul_add(h, v_u3_0, -a44)
            } else {
                R::mul_add(h, nv_u3_0, a44)
            };
            a43 = u3_0;
        }
        Hessenberg5 {
            hess: Matrix5 {
                m11: a00,
                m21: a10,
                m31: a20,
                m41: a30,
                m51: a40,
                m12: a01,
                m22: a11,
                m32: a21,
                m42: a31,
                m52: a41,
                m13: a02,
                m23: a12,
                m33: a22,
                m43: a32,
                m53: a42,
                m14: a03,
                m24: a13,
                m34: a23,
                m44: a33,
                m54: a43,
                m15: a04,
                m25: a14,
                m35: a24,
                m45: a34,
                m55: a44,
            },
            subdiag: Vector4 { x: s0, y: s1, z: s2, w: s3 },
        }
    }

    /// `(Q, H)`: `(q(), unpack_h())`. Upstream: `Hessenberg::unpack`.
    #[inline(always)]
    fn unpack(self: Hessenberg5<T>) -> (Matrix5<T>, Matrix5<T>) {
        (Self::q(self), Self::unpack_h(self))
    }

    /// The upper Hessenberg matrix `H`: `hess` with zeros below the first subdiagonal and
    /// `|subdiag|` on it. Exact (moves and absolute values). Upstream: `Hessenberg::unpack_h`.
    #[inline(always)]
    fn unpack_h(self: Hessenberg5<T>) -> Matrix5<T> {
        Matrix5 {
            m11: self.hess.m11,
            m21: R::abs(self.subdiag.x),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: self.hess.m12,
            m22: self.hess.m22,
            m32: R::abs(self.subdiag.y),
            m42: R::zero(),
            m52: R::zero(),
            m13: self.hess.m13,
            m23: self.hess.m23,
            m33: self.hess.m33,
            m43: R::abs(self.subdiag.z),
            m53: R::zero(),
            m14: self.hess.m14,
            m24: self.hess.m24,
            m34: self.hess.m34,
            m44: self.hess.m44,
            m54: R::abs(self.subdiag.w),
            m15: self.hess.m15,
            m25: self.hess.m25,
            m35: self.hess.m35,
            m45: self.hess.m45,
            m55: self.hess.m55,
        }
    }

    /// `H`, like `unpack_h` (upstream's `h` borrows, `unpack_h` consumes: Cairo copies). Upstream:
    /// `Hessenberg::h`.
    #[inline(always)]
    fn h(self: Hessenberg5<T>) -> Matrix5<T> {
        Self::unpack_h(self)
    }

    /// The orthogonal factor `Q`: upstream's `householder::assemble_q`, the 4 signed
    /// reflections applied in reverse order to the identity on symbolic entries (its static zeros
    /// and ones cost nothing): one fused dot product per column and reflection (doubled exactly),
    /// one `Real::mul_add` per entry. Upstream: `Hessenberg::q`.
    fn q(self: Hessenberg5<T>) -> Matrix5<T> {
        revoke_ap_tracking();
        let sq3 = self.subdiag.w < R::zero();
        let q3_v0 = self.hess.m54 + self.hess.m54;
        let q3_nv0 = -q3_v0;
        let h = self.hess.m54;
        let q3_44 = if sq3 {
            R::mul_add(h, q3_v0, -R::one())
        } else {
            R::mul_add(h, q3_nv0, R::one())
        };
        let sq2 = self.subdiag.z < R::zero();
        let q2_v0 = self.hess.m43 + self.hess.m43;
        let q2_nv0 = -q2_v0;
        let q2_v1 = self.hess.m53 + self.hess.m53;
        let q2_nv1 = -q2_v1;
        let h = self.hess.m43;
        let q2_33 = if sq2 {
            R::mul_add(h, q2_v0, -R::one())
        } else {
            R::mul_add(h, q2_nv0, R::one())
        };
        let q2_43 = if sq2 {
            h * q2_v1
        } else {
            h * q2_nv1
        };
        let h = self.hess.m53 * q3_44;
        let q2_34 = if sq2 {
            h * q2_v0
        } else {
            h * q2_nv0
        };
        let q2_44 = if sq2 {
            R::mul_add(h, q2_v1, -q3_44)
        } else {
            R::mul_add(h, q2_nv1, q3_44)
        };
        let sq1 = self.subdiag.y < R::zero();
        let q1_v0 = self.hess.m32 + self.hess.m32;
        let q1_nv0 = -q1_v0;
        let q1_v1 = self.hess.m42 + self.hess.m42;
        let q1_nv1 = -q1_v1;
        let q1_v2 = self.hess.m52 + self.hess.m52;
        let q1_nv2 = -q1_v2;
        let h = self.hess.m32;
        let q1_22 = if sq1 {
            R::mul_add(h, q1_v0, -R::one())
        } else {
            R::mul_add(h, q1_nv0, R::one())
        };
        let q1_32 = if sq1 {
            h * q1_v1
        } else {
            h * q1_nv1
        };
        let q1_42 = if sq1 {
            h * q1_v2
        } else {
            h * q1_nv2
        };
        let h = R::sum_prod2(self.hess.m42, q2_33, self.hess.m52, q2_43);
        let q1_23 = if sq1 {
            h * q1_v0
        } else {
            h * q1_nv0
        };
        let q1_33 = if sq1 {
            R::mul_add(h, q1_v1, -q2_33)
        } else {
            R::mul_add(h, q1_nv1, q2_33)
        };
        let q1_43 = if sq1 {
            R::mul_add(h, q1_v2, -q2_43)
        } else {
            R::mul_add(h, q1_nv2, q2_43)
        };
        let h = R::sum_prod2(self.hess.m42, q2_34, self.hess.m52, q2_44);
        let q1_24 = if sq1 {
            h * q1_v0
        } else {
            h * q1_nv0
        };
        let q1_34 = if sq1 {
            R::mul_add(h, q1_v1, -q2_34)
        } else {
            R::mul_add(h, q1_nv1, q2_34)
        };
        let q1_44 = if sq1 {
            R::mul_add(h, q1_v2, -q2_44)
        } else {
            R::mul_add(h, q1_nv2, q2_44)
        };
        let sq0 = self.subdiag.x < R::zero();
        let q0_v0 = self.hess.m21 + self.hess.m21;
        let q0_nv0 = -q0_v0;
        let q0_v1 = self.hess.m31 + self.hess.m31;
        let q0_nv1 = -q0_v1;
        let q0_v2 = self.hess.m41 + self.hess.m41;
        let q0_nv2 = -q0_v2;
        let q0_v3 = self.hess.m51 + self.hess.m51;
        let q0_nv3 = -q0_v3;
        let h = self.hess.m21;
        let q0_11 = if sq0 {
            R::mul_add(h, q0_v0, -R::one())
        } else {
            R::mul_add(h, q0_nv0, R::one())
        };
        let q0_21 = if sq0 {
            h * q0_v1
        } else {
            h * q0_nv1
        };
        let q0_31 = if sq0 {
            h * q0_v2
        } else {
            h * q0_nv2
        };
        let q0_41 = if sq0 {
            h * q0_v3
        } else {
            h * q0_nv3
        };
        let h = R::sum_prod3(self.hess.m31, q1_22, self.hess.m41, q1_32, self.hess.m51, q1_42);
        let q0_12 = if sq0 {
            h * q0_v0
        } else {
            h * q0_nv0
        };
        let q0_22 = if sq0 {
            R::mul_add(h, q0_v1, -q1_22)
        } else {
            R::mul_add(h, q0_nv1, q1_22)
        };
        let q0_32 = if sq0 {
            R::mul_add(h, q0_v2, -q1_32)
        } else {
            R::mul_add(h, q0_nv2, q1_32)
        };
        let q0_42 = if sq0 {
            R::mul_add(h, q0_v3, -q1_42)
        } else {
            R::mul_add(h, q0_nv3, q1_42)
        };
        let h = R::sum_prod3(self.hess.m31, q1_23, self.hess.m41, q1_33, self.hess.m51, q1_43);
        let q0_13 = if sq0 {
            h * q0_v0
        } else {
            h * q0_nv0
        };
        let q0_23 = if sq0 {
            R::mul_add(h, q0_v1, -q1_23)
        } else {
            R::mul_add(h, q0_nv1, q1_23)
        };
        let q0_33 = if sq0 {
            R::mul_add(h, q0_v2, -q1_33)
        } else {
            R::mul_add(h, q0_nv2, q1_33)
        };
        let q0_43 = if sq0 {
            R::mul_add(h, q0_v3, -q1_43)
        } else {
            R::mul_add(h, q0_nv3, q1_43)
        };
        let h = R::sum_prod3(self.hess.m31, q1_24, self.hess.m41, q1_34, self.hess.m51, q1_44);
        let q0_14 = if sq0 {
            h * q0_v0
        } else {
            h * q0_nv0
        };
        let q0_24 = if sq0 {
            R::mul_add(h, q0_v1, -q1_24)
        } else {
            R::mul_add(h, q0_nv1, q1_24)
        };
        let q0_34 = if sq0 {
            R::mul_add(h, q0_v2, -q1_34)
        } else {
            R::mul_add(h, q0_nv2, q1_34)
        };
        let q0_44 = if sq0 {
            R::mul_add(h, q0_v3, -q1_44)
        } else {
            R::mul_add(h, q0_nv3, q1_44)
        };
        Matrix5 {
            m11: R::one(),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: R::zero(),
            m22: q0_11,
            m32: q0_21,
            m42: q0_31,
            m52: q0_41,
            m13: R::zero(),
            m23: q0_12,
            m33: q0_22,
            m43: q0_32,
            m53: q0_42,
            m14: R::zero(),
            m24: q0_13,
            m34: q0_23,
            m44: q0_33,
            m54: q0_43,
            m15: R::zero(),
            m25: q0_14,
            m35: q0_24,
            m45: q0_34,
            m55: q0_44,
        }
    }

    /// The packed storage (`H` and the Householder axes). Exact. Upstream:
    /// `Hessenberg::hess_internal` (`#[doc(hidden)]`).
    #[inline(always)]
    fn hess_internal(self: Hessenberg5<T>) -> Matrix5<T> {
        self.hess
    }
}

/// `Matrix5` methods that go through the Hessenberg decomposition. Import `Matrix5HessenbergTrait`.
#[generate_trait]
pub impl Matrix5HessenbergImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5HessenbergTrait<T> {
    /// The Hessenberg decomposition. Upstream: `SquareMatrix::hessenberg`.
    #[inline(always)]
    fn hessenberg(self: Matrix5<T>) -> Hessenberg5<T> {
        Hessenberg5Trait::new(self)
    }
}
