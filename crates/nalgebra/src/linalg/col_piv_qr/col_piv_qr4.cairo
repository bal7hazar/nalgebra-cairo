            R::mul_add(nw, self.col_piv_qr.m31, q22_1)
        };
        let q32_0 = if s0 {
            R::mul_add(w, self.col_piv_qr.m41, -q32_1)
        } else {
            R::mul_add(nw, self.col_piv_qr.m41, q32_1)
        };
        let h = R::sum_prod3(
            self.col_piv_qr.m21, q13_1, self.col_piv_qr.m31, q23_1, self.col_piv_qr.m41, q33_1,
        );
        let w = h + h;
        let nw = -w;
        let q03_0 = if s0 {
            w * self.col_piv_qr.m11
        } else {
            nw * self.col_piv_qr.m11
        };
        let q13_0 = if s0 {
            R::mul_add(w, self.col_piv_qr.m21, -q13_1)
        } else {
            R::mul_add(nw, self.col_piv_qr.m21, q13_1)
        };
        let q23_0 = if s0 {
            R::mul_add(w, self.col_piv_qr.m31, -q23_1)
        } else {
            R::mul_add(nw, self.col_piv_qr.m31, q23_1)
        };
        let q33_0 = if s0 {
            R::mul_add(w, self.col_piv_qr.m41, -q33_1)
        } else {
            R::mul_add(nw, self.col_piv_qr.m41, q33_1)
        };
        Matrix4 {
            m11: q00_0,
            m21: q10_0,
            m31: q20_0,
            m41: q30_0,
            m12: q01_0,
            m22: q11_0,
            m32: q21_0,
            m42: q31_0,
            m13: q02_0,
            m23: q12_0,
            m33: q22_0,
            m43: q32_0,
            m14: q03_0,
            m24: q13_0,
            m34: q23_0,
            m44: q33_0,
        }
    }

    /// The column permutation. Upstream: `ColPivQR::p`.
    #[inline(always)]
    fn p(self: ColPivQr4<T>) -> Perm4 {
        self.p
    }

    /// `(Q, R, P)`: `(q(), r(), p())`. Upstream: `ColPivQR::unpack`.
    #[inline(always)]
    fn unpack(self: ColPivQr4<T>) -> (Matrix4<T>, Matrix4<T>, Perm4) {
        (Self::q(self), Self::r(self), self.p)
    }

    /// The packed storage (axes and strict upper triangle of `R`). Exact. Upstream:
    /// `ColPivQR::col_piv_qr_internal` (`#[doc(hidden)]`).
    #[inline(always)]
    fn col_piv_qr_internal(self: ColPivQr4<T>) -> Matrix4<T> {
        self.col_piv_qr
    }

    /// `rhs = Qᵀ rhs` in place, `Q` the FULL 4x4 product of the reflections (upstream applies
    /// them one after the other to `rhs`), for any `rhs` with 4 rows: the product is formed
    /// once, then ONE fused sum per entry. Upstream: `ColPivQR::q_tr_mul`.
    fn q_tr_mul<B, impl K: SolveKernel<Matrix4<T>, B>, +Drop<B>>(self: ColPivQr4<T>, ref rhs: B) {
        rhs = K::tr_mul_rhs(Self::q(self), rhs);
    }

    /// Whether every Householder norm (`diag`, the signed diagonal of `R`) is EXACTLY nonzero,
    /// like upstream's `ColPivQR::is_invertible`.
    #[inline(always)]
    fn is_invertible(self: ColPivQr4<T>) -> bool {
        self.diag.x != R::zero()
            && self.diag.y != R::zero()
            && self.diag.z != R::zero()
            && self.diag.w != R::zero()
    }

    /// The determinant: `sign(P)` times the product of the SIGNED Householder norms (upstream's
    /// `diag`, not `|r_ii|`), the sign on the first factor (exact), then one floor per product.
    /// Panics on overflow of a partial product. Upstream: `ColPivQR::determinant`.
    fn determinant(self: ColPivQr4<T>) -> T {
        let mut neg = false;
        if self.p.p1 != 1 {
            neg = !neg;
        }
        if self.p.p2 != 2 {
            neg = !neg;
        }
        if self.p.p3 != 3 {
            neg = !neg;
        }
        let d = if neg {
            -self.diag.x
        } else {
            self.diag.x
        };
        let d = d * self.diag.y;
        let d = d * self.diag.z;
        let d = d * self.diag.w;
        d
    }

    /// Overwrites `b` (any shape with 4 rows) with the solution of `A x = b` and returns
    /// `true`, or returns `false` and leaves `b` unchanged when `R` has an exactly zero diagonal
    /// entry (upstream leaves `Qᵀ b` behind). `x = P (R⁻¹ (Qᵀ b))`: `Qᵀ b` as one fused
    /// sum per entry (upstream: the reflections one after the other), back substitution on `R`
    /// (upstream's `|diag|` on the diagonal: one fused numerator and one correctly rounded division
    /// per component), then the inverse column permutation (moves). Panics on overflow. Upstream:
    /// `ColPivQR::solve_mut`.
    fn solve_mut<B, impl P: PermuteRows<Perm4, B>, impl K: SolveKernel<Matrix4<T>, B>, +Drop<B>>(
        self: ColPivQr4<T>, ref b: B,
    ) -> bool {
        if !Self::is_invertible(self) {
            return false;
        }
        b = K::upper(Self::r(self), K::tr_mul_rhs(Self::q(self), b));
        P::inv_permute_rows(self.p, ref b);
        true
    }

    /// The solution of `A x = b` for any `b` with 4 rows, or `None` when `R` has an exactly
    /// zero diagonal entry: `solve_mut` on a copy. Upstream: `ColPivQR::solve`.
    fn solve<B, impl P: PermuteRows<Perm4, B>, impl K: SolveKernel<Matrix4<T>, B>, +Drop<B>>(
        self: ColPivQr4<T>, b: B,
    ) -> Option<B> {
        let mut x = b;
        if Self::solve_mut(self, ref x) {
            Some(x)
        } else {
            None
        }
    }

    /// The inverse `P R⁻¹ Qᵀ`, or `None` when `R` has an exactly zero diagonal entry: the back
    /// substitution of `Qᵀ` (moves: upstream multiplies the identity by `Qᵀ`), then the inverse
    /// row permutation. Panics on overflow. Upstream: `ColPivQR::try_inverse`.
    fn try_inverse(self: ColPivQr4<T>) -> Option<Matrix4<T>> {
        if !Self::is_invertible(self) {
            return None;
        }
        let q = Self::q(self);
        let mut x = SolveKernel::<
            Matrix4<T>, Matrix4<T>,
        >::upper(
            Self::r(self),
            Matrix4 {
                m11: q.m11,
                m21: q.m12,
                m31: q.m13,
                m41: q.m14,
                m12: q.m21,
                m22: q.m22,
                m32: q.m23,
                m42: q.m24,
                m13: q.m31,
                m23: q.m32,
                m33: q.m33,
                m43: q.m34,
                m14: q.m41,
                m24: q.m42,
                m34: q.m43,
                m44: q.m44,
            },
        );
        PermuteRows::inv_permute_rows(self.p, ref x);
        Some(x)
    }
}

/// `Matrix4` methods that go through the column-pivot QR factorisation. Import
/// `Matrix4ColPivQrTrait`.
#[generate_trait]
pub impl Matrix4ColPivQrImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix4ColPivQrTrait<T> {
    /// The QR factorisation with column pivoting. Upstream: `Matrix::col_piv_qr`.
    #[inline(always)]
    fn col_piv_qr(self: Matrix4<T>) -> ColPivQr4<T> {
        ColPivQr4Trait::new(self)
    }
}
