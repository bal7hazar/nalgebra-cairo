            a44 = if neg {
                R::mul_add(nw, a43, a44)
            } else {
                R::mul_add(w, a43, -a44)
            };
            a54 = if neg {
                R::mul_add(nw, a53, a54)
            } else {
                R::mul_add(w, a53, -a54)
