            };
            a34 = if neg {
                R::mul_add(nw, a32, a34)
            } else {
                R::mul_add(w, a32, -a34)
            };
            a44 = if neg {
                R::mul_add(nw, a42, a44)
            } else {
                R::mul_add(w, a42, -a44)
            };
            a54 = if neg {
                R::mul_add(nw, a52, a54)
            } else {
