            let signed = if neg {
                -nrm
            } else {
                nrm
            };
            let y0 = a22 + signed;
            let dd = R::norm4(y0, a32, a42, a52);
            let (u2, u3, u4, u5) = R::div4(y0, a32, a42, a52, dd);
            a22 = u2;
            a32 = u3;
            a42 = u4;
            a52 = u5;
            d2 = -signed;
            let h = R::sum_prod4(a22, a23, a32, a33, a42, a43, a52, a53);
            let w = h + h;
            let nw = -w;
