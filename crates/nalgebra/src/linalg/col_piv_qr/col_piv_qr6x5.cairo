    /// The upper trapezoidal factor `R` (5x5): the strict upper triangle as stored and
    /// `|diag|` on the diagonal. Exact: moves and absolute values. Upstream: `ColPivQR::r`.
    #[inline(always)]
    fn r(self: ColPivQr6x5<T>) -> Matrix5<T> {
        Matrix5 {
            m11: R::abs(self.diag.x),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: self.col_piv_qr.m12,
            m22: R::abs(self.diag.y),
            m32: R::zero(),
            m42: R::zero(),
            m52: R::zero(),
            m13: self.col_piv_qr.m13,
            m23: self.col_piv_qr.m23,
            m33: R::abs(self.diag.z),
            m43: R::zero(),
            m53: R::zero(),
            m14: self.col_piv_qr.m14,
            m24: self.col_piv_qr.m24,
            m34: self.col_piv_qr.m34,
            m44: R::abs(self.diag.w),
            m54: R::zero(),
            m15: self.col_piv_qr.m15,
            m25: self.col_piv_qr.m25,
            m35: self.col_piv_qr.m35,
            m45: self.col_piv_qr.m45,
            m55: R::abs(self.diag.a),
        }
    }

    /// `R`, consuming the factorisation: `r()`. Upstream: `ColPivQR::unpack_r`.
    #[inline(always)]
    fn unpack_r(self: ColPivQr6x5<T>) -> Matrix5<T> {
        Self::r(self)
    }

    /// The orthonormal factor `Q` (6x5): upstream's loop, the 5 signed reflections applied in
