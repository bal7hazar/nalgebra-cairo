                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), a11, a13), a21, a23),
                            a31,
                            a33,
                        ),
                        a41,
                        a43,
                    ),
                    a51,
                    a53,
                ),
            );
            let w = h + h;
            let nw = -w;
            a13 = if neg {
                R::mul_add(nw, a11, a13)
            } else {
                R::mul_add(w, a11, -a13)
            };
            a23 = if neg {
                R::mul_add(nw, a21, a23)
            } else {
                R::mul_add(w, a21, -a23)
            };
            a33 = if neg {
                R::mul_add(nw, a31, a33)
            } else {
                R::mul_add(w, a31, -a33)
            };
            a43 = if neg {
                R::mul_add(nw, a41, a43)
            } else {
                R::mul_add(w, a41, -a43)
            };
            a53 = if neg {
                R::mul_add(nw, a51, a53)
            } else {
                R::mul_add(w, a51, -a53)
            };
            let h = R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_add_prod(R::wide_zero(), a11, a14), a21, a24),
                            a31,
                            a34,
                        ),
                        a41,
                        a44,
                    ),
                    a51,
                    a54,
                ),
            );
            let w = h + h;
            let nw = -w;
            a14 = if neg {
                R::mul_add(nw, a11, a14)
            } else {
                R::mul_add(w, a11, -a14)
            };
            a24 = if neg {
                R::mul_add(nw, a21, a24)
            } else {
                R::mul_add(w, a21, -a24)
            };
            a34 = if neg {
                R::mul_add(nw, a31, a34)
            } else {
                R::mul_add(w, a31, -a34)
            };
            a44 = if neg {
                R::mul_add(nw, a41, a44)
            } else {
                R::mul_add(w, a41, -a44)
            };
            a54 = if neg {
                R::mul_add(nw, a51, a54)
            } else {
                R::mul_add(w, a51, -a54)
