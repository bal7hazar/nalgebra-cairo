        let nrm = R::norm2(a44, a54);
        let mut d4 = R::zero();
        if nrm != R::zero() {
            let neg = a44 < R::zero();
            let signed = if neg {
                -nrm
            } else {
                nrm
            };
            let y0 = a44 + signed;
            let dd = R::norm2(y0, a54);
            let (u4, u5) = (R::div(y0, dd), R::div(a54, dd));
            a44 = u4;
            a54 = u5;
            d4 = -signed;
        }
        ColPivQr6x5 {
            col_piv_qr: Matrix6x5 {
                m11: a00,
                m21: a10,
                m31: a20,
                m41: a30,
                m51: a40,
                m61: a50,
