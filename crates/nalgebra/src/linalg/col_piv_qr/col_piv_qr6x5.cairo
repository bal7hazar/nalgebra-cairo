        }
        // step 3
        let mut piv = R::abs(a22);
        let mut cp2 = 3_u8;
        let x = R::abs(a32);
        if x > piv {
            piv = x;
        }
        let x = R::abs(a42);
        if x > piv {
            piv = x;
        }
        let x = R::abs(a52);
        if x > piv {
            piv = x;
        }
        let x = R::abs(a23);
        if x > piv {
            piv = x;
            cp2 = 4;
        }
        let x = R::abs(a33);
        if x > piv {
            piv = x;
            cp2 = 4;
        }
        let x = R::abs(a43);
        if x > piv {
            piv = x;
            cp2 = 4;
        }
        let x = R::abs(a53);
        if x > piv {
            piv = x;
            cp2 = 4;
        }
        let x = R::abs(a24);
        if x > piv {
            piv = x;
            cp2 = 5;
        }
        let x = R::abs(a34);
        if x > piv {
            piv = x;
            cp2 = 5;
        }
        let x = R::abs(a44);
        if x > piv {
            piv = x;
            cp2 = 5;
        }
        let x = R::abs(a54);
        if x > piv {
            piv = x;
            cp2 = 5;
        }
        if cp2 == 4 {
            let t = a02;
            a02 = a03;
            a03 = t;
            let t = a12;
            a12 = a13;
            a13 = t;
            let t = a22;
            a22 = a23;
            a23 = t;
            let t = a32;
            a32 = a33;
            a33 = t;
            let t = a42;
            a42 = a43;
            a43 = t;
            let t = a52;
            a52 = a53;
            a53 = t;
        } else if cp2 == 5 {
            let t = a02;
            a02 = a04;
            a04 = t;
            let t = a12;
            a12 = a14;
            a14 = t;
            let t = a22;
            a22 = a24;
            a24 = t;
            let t = a32;
            a32 = a34;
            a34 = t;
            let t = a42;
            a42 = a44;
            a44 = t;
            let t = a52;
            a52 = a54;
