        // `d2 = clear_row_unchecked(matrix, axis_packed, work, 2, 0)`
        let (d2, nz_d2, ur2_0, ur2_1, ur2_2, ur2_3) = HouseholderKernelTrait::<
            T,
        >::axis4(a22, a23, a24, a25);
        if nz_d2 {
            let neg = d2 < R::zero();
            let h = R::sum_prod4(a32, ur2_0, a33, ur2_1, a34, ur2_2, a35, ur2_3);
            let w = h + h;
            let nw = -w;
            a32 = if neg {
                R::mul_add(w, ur2_0, -a32)
            } else {
                R::mul_add(nw, ur2_0, a32)
            };
            a33 = if neg {
                R::mul_add(w, ur2_1, -a33)
            } else {
                R::mul_add(nw, ur2_1, a33)
            };
            a34 = if neg {
                R::mul_add(w, ur2_2, -a34)
            } else {
                R::mul_add(nw, ur2_2, a34)
            };
            a35 = if neg {
                R::mul_add(w, ur2_3, -a35)
            } else {
                R::mul_add(nw, ur2_3, a35)
            };
            let h = R::sum_prod4(a42, ur2_0, a43, ur2_1, a44, ur2_2, a45, ur2_3);
            let w = h + h;
            let nw = -w;
            a42 = if neg {
                R::mul_add(w, ur2_0, -a42)
            } else {
                R::mul_add(nw, ur2_0, a42)
            };
            a43 = if neg {
                R::mul_add(w, ur2_1, -a43)
            } else {
                R::mul_add(nw, ur2_1, a43)
            };
            a44 = if neg {
                R::mul_add(w, ur2_2, -a44)
            } else {
                R::mul_add(nw, ur2_2, a44)
            };
            a45 = if neg {
                R::mul_add(w, ur2_3, -a45)
            } else {
                R::mul_add(nw, ur2_3, a45)
            };
            a22 = ur2_0;
            a23 = ur2_1;
            a24 = ur2_2;
            a25 = ur2_3;
        }
        // `e2 = clear_column_unchecked(matrix, 2, 1, None)`
        let (e2, nz_e2, uc2_0, uc2_1) = HouseholderKernelTrait::<T>::axis2(a32, a42);
        if nz_e2 {
            let neg = e2 < R::zero();
            let h = R::sum_prod2(uc2_0, a33, uc2_1, a43);
            let w = h + h;
            let nw = -w;
            a33 = if neg {
                R::mul_add(w, uc2_0, -a33)
            } else {
                R::mul_add(nw, uc2_0, a33)
            };
            a43 = if neg {
                R::mul_add(w, uc2_1, -a43)
            } else {
                R::mul_add(nw, uc2_1, a43)
            };
            let h = R::sum_prod2(uc2_0, a34, uc2_1, a44);
            let w = h + h;
            let nw = -w;
            a34 = if neg {
                R::mul_add(w, uc2_0, -a34)
            } else {
                R::mul_add(nw, uc2_0, a34)
            };
            a44 = if neg {
                R::mul_add(w, uc2_1, -a44)
            } else {
                R::mul_add(nw, uc2_1, a44)
            };
            let h = R::sum_prod2(uc2_0, a35, uc2_1, a45);
            let w = h + h;
            let nw = -w;
            a35 = if neg {
                R::mul_add(w, uc2_0, -a35)
            } else {
                R::mul_add(nw, uc2_0, a35)
            };
            a45 = if neg {
                R::mul_add(w, uc2_1, -a45)
            } else {
                R::mul_add(nw, uc2_1, a45)
            };
            a32 = uc2_0;
            a42 = uc2_1;
        }
        // `d3 = clear_row_unchecked(matrix, axis_packed, work, 3, 0)`
        let (d3, nz_d3, ur3_0, ur3_1, ur3_2) = HouseholderKernelTrait::<T>::axis3(a33, a34, a35);
        if nz_d3 {
            let neg = d3 < R::zero();
            let h = R::sum_prod3(a43, ur3_0, a44, ur3_1, a45, ur3_2);
            let w = h + h;
            let nw = -w;
            a43 = if neg {
                R::mul_add(w, ur3_0, -a43)
            } else {
                R::mul_add(nw, ur3_0, a43)
            };
            a44 = if neg {
                R::mul_add(w, ur3_1, -a44)
            } else {
                R::mul_add(nw, ur3_1, a44)
            };
            a45 = if neg {
                R::mul_add(w, ur3_2, -a45)
            } else {
                R::mul_add(nw, ur3_2, a45)
            };
            a33 = ur3_0;
            a34 = ur3_1;
            a35 = ur3_2;
        }
        // `e3 = clear_column_unchecked(matrix, 3, 1, None)`
        let (e3, nz_e3, uc3_0) = HouseholderKernelTrait::<T>::axis1(a43);
        if nz_e3 {
            let neg = e3 < R::zero();
            let h = uc3_0 * a44;
            let w = h + h;
            let nw = -w;
            a44 = if neg {
                R::mul_add(w, uc3_0, -a44)
            } else {
                R::mul_add(nw, uc3_0, a44)
            };
            let h = uc3_0 * a45;
            let w = h + h;
            let nw = -w;
            a45 = if neg {
                R::mul_add(w, uc3_0, -a45)
            } else {
                R::mul_add(nw, uc3_0, a45)
            };
            a43 = uc3_0;
        }
        // `d4 = clear_row_unchecked(matrix, axis_packed, work, 4, 0)`
        let (d4, nz_d4, ur4_0, ur4_1) = HouseholderKernelTrait::<T>::axis2(a44, a45);
        if nz_d4 {
            a44 = ur4_0;
            a45 = ur4_1;
        }
        Bidiagonal5x6 {
            uv: Matrix5x6 {
                m11: a00,
                m21: a10,
                m31: a20,
                m41: a30,
                m51: a40,
                m12: a01,
                m22: a11,
                m32: a21,
                m42: a31,
                m52: a41,
                m13: a02,
                m23: a12,
                m33: a22,
                m43: a32,
                m53: a42,
                m14: a03,
                m24: a13,
                m34: a23,
                m44: a33,
                m54: a43,
                m15: a04,
                m25: a14,
                m35: a24,
                m45: a34,
                m55: a44,
                m16: a05,
                m26: a15,
                m36: a25,
                m46: a35,
                m56: a45,
            },
            diagonal: Vector5 { x: d0, y: d1, z: d2, w: d3, a: d4 },
            off_diagonal: Vector4 { x: e0, y: e1, z: e2, w: e3 },
            upper_diagonal: false,
        }
    }

    /// Whether `D` is upper bidiagonal (rows >= columns). Upstream:
    /// `Bidiagonal::is_upper_diagonal`.
    #[inline(always)]
    fn is_upper_diagonal(self: Bidiagonal5x6<T>) -> bool {
        self.upper_diagonal
    }

    /// `(U, D, Vᵀ)`: `(u(), d(), v_t())`, with `A = U D Vᵀ`. Upstream: `Bidiagonal::unpack`.
    #[inline(always)]
    fn unpack(self: Bidiagonal5x6<T>) -> (Matrix5<T>, Matrix5<T>, Matrix5x6<T>) {
        (Self::u(self), Self::d(self), Self::v_t(self))
    }

    /// The bidiagonal factor `D` (5x5): `|diagonal|` on the diagonal, `|off_diagonal|` on the
    /// subdiagonal. Exact. Upstream: `Bidiagonal::d`.
    #[inline(always)]
    fn d(self: Bidiagonal5x6<T>) -> Matrix5<T> {
        Matrix5 {
            m11: R::abs(self.diagonal.x),
            m21: R::abs(self.off_diagonal.x),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: R::zero(),
            m22: R::abs(self.diagonal.y),
            m32: R::abs(self.off_diagonal.y),
            m42: R::zero(),
            m52: R::zero(),
            m13: R::zero(),
            m23: R::zero(),
            m33: R::abs(self.diagonal.z),
            m43: R::abs(self.off_diagonal.z),
            m53: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: R::abs(self.diagonal.w),
            m54: R::abs(self.off_diagonal.w),
            m15: R::zero(),
            m25: R::zero(),
            m35: R::zero(),
            m45: R::zero(),
            m55: R::abs(self.diagonal.a),
        }
    }

    /// The left factor `U` (5x5): upstream's loop, the signed left reflections applied in
    /// reverse order to the first 5 columns of the identity, on symbolic entries (its static zeros
    /// and ones cost nothing): one fused dot product per column and reflection (doubled exactly),
    /// one `Real::mul_add` per entry. A zero axis is a no-op, as upstream's `continue`. Upstream:
    /// `Bidiagonal::u`.
    fn u(self: Bidiagonal5x6<T>) -> Matrix5<T> {
        revoke_ap_tracking();
        let su3 = self.off_diagonal.w < R::zero();
        let h = self.uv.m54;
        let w = h + h;
        let nw = -w;
        let u3_44 = if su3 {
            R::mul_add(w, self.uv.m54, -R::one())
        } else {
            R::mul_add(nw, self.uv.m54, R::one())
        };
        let su2 = self.off_diagonal.z < R::zero();
        let h = self.uv.m43;
        let w = h + h;
        let nw = -w;
        let u2_33 = if su2 {
            R::mul_add(w, self.uv.m43, -R::one())
        } else {
            R::mul_add(nw, self.uv.m43, R::one())
        };
        let u2_43 = if su2 {
            w * self.uv.m53
        } else {
            nw * self.uv.m53
        };
        let h = self.uv.m53 * u3_44;
        let w = h + h;
        let nw = -w;
        let u2_34 = if su2 {
            w * self.uv.m43
        } else {
            nw * self.uv.m43
        };
        let u2_44 = if su2 {
            R::mul_add(w, self.uv.m53, -u3_44)
        } else {
            R::mul_add(nw, self.uv.m53, u3_44)
        };
        let su1 = self.off_diagonal.y < R::zero();
        let h = self.uv.m32;
        let w = h + h;
        let nw = -w;
        let u1_22 = if su1 {
            R::mul_add(w, self.uv.m32, -R::one())
        } else {
            R::mul_add(nw, self.uv.m32, R::one())
        };
        let u1_32 = if su1 {
            w * self.uv.m42
        } else {
            nw * self.uv.m42
        };
        let u1_42 = if su1 {
            w * self.uv.m52
        } else {
            nw * self.uv.m52
        };
        let h = R::sum_prod2(self.uv.m42, u2_33, self.uv.m52, u2_43);
        let w = h + h;
        let nw = -w;
        let u1_23 = if su1 {
            w * self.uv.m32
        } else {
            nw * self.uv.m32
        };
        let u1_33 = if su1 {
            R::mul_add(w, self.uv.m42, -u2_33)
        } else {
            R::mul_add(nw, self.uv.m42, u2_33)
        };
        let u1_43 = if su1 {
            R::mul_add(w, self.uv.m52, -u2_43)
        } else {
            R::mul_add(nw, self.uv.m52, u2_43)
        };
        let h = R::sum_prod2(self.uv.m42, u2_34, self.uv.m52, u2_44);
        let w = h + h;
        let nw = -w;
        let u1_24 = if su1 {
            w * self.uv.m32
        } else {
            nw * self.uv.m32
        };
        let u1_34 = if su1 {
            R::mul_add(w, self.uv.m42, -u2_34)
        } else {
            R::mul_add(nw, self.uv.m42, u2_34)
        };
        let u1_44 = if su1 {
            R::mul_add(w, self.uv.m52, -u2_44)
        } else {
            R::mul_add(nw, self.uv.m52, u2_44)
        };
        let su0 = self.off_diagonal.x < R::zero();
        let h = self.uv.m21;
        let w = h + h;
        let nw = -w;
        let u0_11 = if su0 {
            R::mul_add(w, self.uv.m21, -R::one())
        } else {
            R::mul_add(nw, self.uv.m21, R::one())
        };
        let u0_21 = if su0 {
            w * self.uv.m31
        } else {
            nw * self.uv.m31
        };
        let u0_31 = if su0 {
            w * self.uv.m41
        } else {
            nw * self.uv.m41
        };
        let u0_41 = if su0 {
            w * self.uv.m51
        } else {
            nw * self.uv.m51
        };
        let h = R::sum_prod3(self.uv.m31, u1_22, self.uv.m41, u1_32, self.uv.m51, u1_42);
        let w = h + h;
        let nw = -w;
        let u0_12 = if su0 {
            w * self.uv.m21
        } else {
            nw * self.uv.m21
        };
        let u0_22 = if su0 {
            R::mul_add(w, self.uv.m31, -u1_22)
        } else {
            R::mul_add(nw, self.uv.m31, u1_22)
        };
        let u0_32 = if su0 {
            R::mul_add(w, self.uv.m41, -u1_32)
        } else {
            R::mul_add(nw, self.uv.m41, u1_32)
        };
        let u0_42 = if su0 {
            R::mul_add(w, self.uv.m51, -u1_42)
        } else {
            R::mul_add(nw, self.uv.m51, u1_42)
        };
        let h = R::sum_prod3(self.uv.m31, u1_23, self.uv.m41, u1_33, self.uv.m51, u1_43);
        let w = h + h;
        let nw = -w;
        let u0_13 = if su0 {
            w * self.uv.m21
        } else {
            nw * self.uv.m21
        };
        let u0_23 = if su0 {
            R::mul_add(w, self.uv.m31, -u1_23)
        } else {
            R::mul_add(nw, self.uv.m31, u1_23)
        };
        let u0_33 = if su0 {
            R::mul_add(w, self.uv.m41, -u1_33)
        } else {
            R::mul_add(nw, self.uv.m41, u1_33)
        };
        let u0_43 = if su0 {
            R::mul_add(w, self.uv.m51, -u1_43)
        } else {
            R::mul_add(nw, self.uv.m51, u1_43)
        };
        let h = R::sum_prod3(self.uv.m31, u1_24, self.uv.m41, u1_34, self.uv.m51, u1_44);
        let w = h + h;
        let nw = -w;
        let u0_14 = if su0 {
            w * self.uv.m21
        } else {
            nw * self.uv.m21
        };
        let u0_24 = if su0 {
            R::mul_add(w, self.uv.m31, -u1_24)
        } else {
            R::mul_add(nw, self.uv.m31, u1_24)
        };
        let u0_34 = if su0 {
            R::mul_add(w, self.uv.m41, -u1_34)
        } else {
            R::mul_add(nw, self.uv.m41, u1_34)
        };
        let u0_44 = if su0 {
            R::mul_add(w, self.uv.m51, -u1_44)
        } else {
            R::mul_add(nw, self.uv.m51, u1_44)
        };
        Matrix5 {
            m11: R::one(),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: R::zero(),
            m22: u0_11,
            m32: u0_21,
            m42: u0_31,
            m52: u0_41,
            m13: R::zero(),
            m23: u0_12,
            m33: u0_22,
            m43: u0_32,
            m53: u0_42,
            m14: R::zero(),
            m24: u0_13,
            m34: u0_23,
            m44: u0_33,
            m54: u0_43,
            m15: R::zero(),
            m25: u0_14,
            m35: u0_24,
            m45: u0_34,
            m55: u0_44,
        }
    }

    /// The right factor `Vᵀ` (5x6): the signed right reflections applied in reverse order to
    /// the first 5 rows of the identity (same rounding as `u`). Upstream: `Bidiagonal::v_t`.
    fn v_t(self: Bidiagonal5x6<T>) -> Matrix5x6<T> {
        revoke_ap_tracking();
        let sv4 = self.diagonal.a < R::zero();
        let h = self.uv.m55;
        let w = h + h;
        let nw = -w;
        let v4_44 = if sv4 {
            R::mul_add(w, self.uv.m55, -R::one())
        } else {
            R::mul_add(nw, self.uv.m55, R::one())
        };
        let v4_45 = if sv4 {
            w * self.uv.m56
        } else {
            nw * self.uv.m56
        };
        let sv3 = self.diagonal.w < R::zero();
        let h = self.uv.m44;
        let w = h + h;
        let nw = -w;
        let v3_33 = if sv3 {
            R::mul_add(w, self.uv.m44, -R::one())
        } else {
            R::mul_add(nw, self.uv.m44, R::one())
        };
        let v3_34 = if sv3 {
            w * self.uv.m45
        } else {
            nw * self.uv.m45
        };
        let v3_35 = if sv3 {
            w * self.uv.m46
        } else {
            nw * self.uv.m46
        };
        let h = R::sum_prod2(v4_44, self.uv.m45, v4_45, self.uv.m46);
        let w = h + h;
        let nw = -w;
        let v3_43 = if sv3 {
            w * self.uv.m44
        } else {
            nw * self.uv.m44
        };
        let v3_44 = if sv3 {
            R::mul_add(w, self.uv.m45, -v4_44)
        } else {
            R::mul_add(nw, self.uv.m45, v4_44)
        };
        let v3_45 = if sv3 {
            R::mul_add(w, self.uv.m46, -v4_45)
        } else {
            R::mul_add(nw, self.uv.m46, v4_45)
        };
        let sv2 = self.diagonal.z < R::zero();
        let h = self.uv.m33;
        let w = h + h;
        let nw = -w;
        let v2_22 = if sv2 {
            R::mul_add(w, self.uv.m33, -R::one())
        } else {
            R::mul_add(nw, self.uv.m33, R::one())
        };
        let v2_23 = if sv2 {
            w * self.uv.m34
        } else {
            nw * self.uv.m34
        };
        let v2_24 = if sv2 {
            w * self.uv.m35
        } else {
            nw * self.uv.m35
        };
        let v2_25 = if sv2 {
            w * self.uv.m36
        } else {
            nw * self.uv.m36
        };
        let h = R::sum_prod3(v3_33, self.uv.m34, v3_34, self.uv.m35, v3_35, self.uv.m36);
        let w = h + h;
        let nw = -w;
        let v2_32 = if sv2 {
            w * self.uv.m33
        } else {
            nw * self.uv.m33
        };
        let v2_33 = if sv2 {
            R::mul_add(w, self.uv.m34, -v3_33)
        } else {
            R::mul_add(nw, self.uv.m34, v3_33)
        };
        let v2_34 = if sv2 {
            R::mul_add(w, self.uv.m35, -v3_34)
        } else {
            R::mul_add(nw, self.uv.m35, v3_34)
        };
        let v2_35 = if sv2 {
            R::mul_add(w, self.uv.m36, -v3_35)
        } else {
            R::mul_add(nw, self.uv.m36, v3_35)
        };
        let h = R::sum_prod3(v3_43, self.uv.m34, v3_44, self.uv.m35, v3_45, self.uv.m36);
        let w = h + h;
        let nw = -w;
        let v2_42 = if sv2 {
            w * self.uv.m33
        } else {
            nw * self.uv.m33
        };
        let v2_43 = if sv2 {
            R::mul_add(w, self.uv.m34, -v3_43)
        } else {
            R::mul_add(nw, self.uv.m34, v3_43)
        };
        let v2_44 = if sv2 {
            R::mul_add(w, self.uv.m35, -v3_44)
        } else {
            R::mul_add(nw, self.uv.m35, v3_44)
        };
        let v2_45 = if sv2 {
            R::mul_add(w, self.uv.m36, -v3_45)
        } else {
            R::mul_add(nw, self.uv.m36, v3_45)
        };
        let sv1 = self.diagonal.y < R::zero();
        let h = self.uv.m22;
        let w = h + h;
        let nw = -w;
        let v1_11 = if sv1 {
            R::mul_add(w, self.uv.m22, -R::one())
        } else {
            R::mul_add(nw, self.uv.m22, R::one())
        };
        let v1_12 = if sv1 {
            w * self.uv.m23
        } else {
            nw * self.uv.m23
        };
        let v1_13 = if sv1 {
            w * self.uv.m24
        } else {
            nw * self.uv.m24
        };
        let v1_14 = if sv1 {
            w * self.uv.m25
        } else {
            nw * self.uv.m25
        };
        let v1_15 = if sv1 {
            w * self.uv.m26
        } else {
            nw * self.uv.m26
        };
        let h = R::sum_prod4(
            v2_22, self.uv.m23, v2_23, self.uv.m24, v2_24, self.uv.m25, v2_25, self.uv.m26,
        );
        let w = h + h;
        let nw = -w;
        let v1_21 = if sv1 {
            w * self.uv.m22
        } else {
            nw * self.uv.m22
        };
        let v1_22 = if sv1 {
            R::mul_add(w, self.uv.m23, -v2_22)
        } else {
            R::mul_add(nw, self.uv.m23, v2_22)
        };
        let v1_23 = if sv1 {
            R::mul_add(w, self.uv.m24, -v2_23)
        } else {
            R::mul_add(nw, self.uv.m24, v2_23)
        };
        let v1_24 = if sv1 {
            R::mul_add(w, self.uv.m25, -v2_24)
        } else {
            R::mul_add(nw, self.uv.m25, v2_24)
