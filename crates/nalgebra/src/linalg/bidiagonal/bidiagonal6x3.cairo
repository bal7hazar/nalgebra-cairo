        Matrix6x3 {
            m11: u0_00,
            m21: u0_10,
            m31: u0_20,
            m41: u0_30,
            m51: u0_40,
            m61: u0_50,
            m12: u0_01,
            m22: u0_11,
            m32: u0_21,
            m42: u0_31,
            m52: u0_41,
            m62: u0_51,
            m13: u0_02,
            m23: u0_12,
            m33: u0_22,
            m43: u0_32,
            m53: u0_42,
            m63: u0_52,
        }
    }

    /// The right factor `Vᵀ` (3x3): the signed right reflections applied in reverse order to
    /// the first 3 rows of the identity (same rounding as `u`). Upstream: `Bidiagonal::v_t`.
    fn v_t(self: Bidiagonal6x3<T>) -> Matrix3<T> {
        revoke_ap_tracking();
        let sv1 = self.off_diagonal.y < R::zero();
        let h = self.uv.m23;
        let w = h + h;
        let nw = -w;
        let v1_22 = if sv1 {
            R::mul_add(w, self.uv.m23, -R::one())
        } else {
            R::mul_add(nw, self.uv.m23, R::one())
        };
        let sv0 = self.off_diagonal.x < R::zero();
        let h = self.uv.m12;
        let w = h + h;
        let nw = -w;
        let v0_11 = if sv0 {
            R::mul_add(w, self.uv.m12, -R::one())
        } else {
            R::mul_add(nw, self.uv.m12, R::one())
        };
        let v0_12 = if sv0 {
            w * self.uv.m13
        } else {
            nw * self.uv.m13
        };
        let h = v1_22 * self.uv.m13;
        let w = h + h;
        let nw = -w;
        let v0_21 = if sv0 {
            w * self.uv.m12
        } else {
            nw * self.uv.m12
        };
        let v0_22 = if sv0 {
            R::mul_add(w, self.uv.m13, -v1_22)
        } else {
            R::mul_add(nw, self.uv.m13, v1_22)
        };
        Matrix3 {
            m11: R::one(),
            m21: R::zero(),
            m31: R::zero(),
            m12: R::zero(),
            m22: v0_11,
            m32: v0_21,
            m13: R::zero(),
            m23: v0_12,
            m33: v0_22,
        }
    }

    /// The diagonal of `D` (`|diagonal|`). Exact. Upstream: `Bidiagonal::diagonal`.
    #[inline(always)]
    fn diagonal(self: Bidiagonal6x3<T>) -> Vector3<T> {
        Vector3 {
            x: R::abs(self.diagonal.x), y: R::abs(self.diagonal.y), z: R::abs(self.diagonal.z),
        }
    }

    /// The off-diagonal of `D` (`|off_diagonal|`). Exact. Upstream:
    /// `Bidiagonal::off_diagonal`.
    #[inline(always)]
    fn off_diagonal(self: Bidiagonal6x3<T>) -> Vector2<T> {
        Vector2 { x: R::abs(self.off_diagonal.x), y: R::abs(self.off_diagonal.y) }
    }

    /// The packed storage (the Householder axes). Exact. Upstream: `Bidiagonal::uv_internal`
    /// (`#[doc(hidden)]`).
    #[inline(always)]
    fn uv_internal(self: Bidiagonal6x3<T>) -> Matrix6x3<T> {
        self.uv
    }
}

/// `Matrix6x3` methods that go through the bidiagonalisation. Import `Matrix6x3BidiagonalTrait`.
#[generate_trait]
pub impl Matrix6x3BidiagonalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix6x3BidiagonalTrait<T> {
    /// The bidiagonalisation. Upstream: `Matrix::bidiagonalize`.
    #[inline(always)]
    fn bidiagonalize(self: Matrix6x3<T>) -> Bidiagonal6x3<T> {
        Bidiagonal6x3Trait::new(self)
    }
}
