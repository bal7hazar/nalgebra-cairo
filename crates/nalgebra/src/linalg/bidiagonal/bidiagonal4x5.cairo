            m31: R::zero(),
            m41: R::zero(),
            m12: R::zero(),
            m22: u0_11,
            m32: u0_21,
            m42: u0_31,
            m13: R::zero(),
            m23: u0_12,
            m33: u0_22,
            m43: u0_32,
            m14: R::zero(),
            m24: u0_13,
            m34: u0_23,
            m44: u0_33,
        }
    }

    /// The right factor `Vᵀ` (4x5): the signed right reflections applied in reverse order to
    /// the first 4 rows of the identity (same rounding as `u`). Upstream: `Bidiagonal::v_t`.
    fn v_t(self: Bidiagonal4x5<T>) -> Matrix4x5<T> {
        revoke_ap_tracking();
        let sv3 = self.diagonal.w < R::zero();
        let h = self.uv.m44;
        let w = h + h;
        let nw = -w;
        let v3_33 = if sv3 {
            R::mul_add(w, self.uv.m44, -R::one())
        } else {
            R::mul_add(nw, self.uv.m44, R::one())
        };
        let v3_34 = if sv3 {
            w * self.uv.m45
        } else {
            nw * self.uv.m45
        };
        let sv2 = self.diagonal.z < R::zero();
        let h = self.uv.m33;
        let w = h + h;
        let nw = -w;
        let v2_22 = if sv2 {
            R::mul_add(w, self.uv.m33, -R::one())
        } else {
            R::mul_add(nw, self.uv.m33, R::one())
        };
        let v2_23 = if sv2 {
            w * self.uv.m34
        } else {
            nw * self.uv.m34
        };
        let v2_24 = if sv2 {
            w * self.uv.m35
        } else {
            nw * self.uv.m35
        };
        let h = R::sum_prod2(v3_33, self.uv.m34, v3_34, self.uv.m35);
        let w = h + h;
        let nw = -w;
        let v2_32 = if sv2 {
            w * self.uv.m33
        } else {
            nw * self.uv.m33
        };
        let v2_33 = if sv2 {
            R::mul_add(w, self.uv.m34, -v3_33)
        } else {
            R::mul_add(nw, self.uv.m34, v3_33)
        };
        let v2_34 = if sv2 {
            R::mul_add(w, self.uv.m35, -v3_34)
        } else {
            R::mul_add(nw, self.uv.m35, v3_34)
        };
        let sv1 = self.diagonal.y < R::zero();
        let h = self.uv.m22;
        let w = h + h;
        let nw = -w;
        let v1_11 = if sv1 {
            R::mul_add(w, self.uv.m22, -R::one())
        } else {
            R::mul_add(nw, self.uv.m22, R::one())
        };
        let v1_12 = if sv1 {
            w * self.uv.m23
        } else {
            nw * self.uv.m23
        };
        let v1_13 = if sv1 {
            w * self.uv.m24
        } else {
            nw * self.uv.m24
        };
        let v1_14 = if sv1 {
            w * self.uv.m25
        } else {
            nw * self.uv.m25
        };
        let h = R::sum_prod3(v2_22, self.uv.m23, v2_23, self.uv.m24, v2_24, self.uv.m25);
        let w = h + h;
        let nw = -w;
        let v1_21 = if sv1 {
            w * self.uv.m22
        } else {
            nw * self.uv.m22
        };
        let v1_22 = if sv1 {
            R::mul_add(w, self.uv.m23, -v2_22)
        } else {
            R::mul_add(nw, self.uv.m23, v2_22)
        };
        let v1_23 = if sv1 {
            R::mul_add(w, self.uv.m24, -v2_23)
        } else {
            R::mul_add(nw, self.uv.m24, v2_23)
        };
        let v1_24 = if sv1 {
            R::mul_add(w, self.uv.m25, -v2_24)
        } else {
            R::mul_add(nw, self.uv.m25, v2_24)
        };
        let h = R::sum_prod3(v2_32, self.uv.m23, v2_33, self.uv.m24, v2_34, self.uv.m25);
        let w = h + h;
        let nw = -w;
        let v1_31 = if sv1 {
            w * self.uv.m22
        } else {
            nw * self.uv.m22
        };
        let v1_32 = if sv1 {
            R::mul_add(w, self.uv.m23, -v2_32)
        } else {
            R::mul_add(nw, self.uv.m23, v2_32)
        };
        let v1_33 = if sv1 {
            R::mul_add(w, self.uv.m24, -v2_33)
        } else {
            R::mul_add(nw, self.uv.m24, v2_33)
        };
        let v1_34 = if sv1 {
            R::mul_add(w, self.uv.m25, -v2_34)
        } else {
            R::mul_add(nw, self.uv.m25, v2_34)
        };
        let sv0 = self.diagonal.x < R::zero();
        let h = self.uv.m11;
        let w = h + h;
        let nw = -w;
        let v0_00 = if sv0 {
            R::mul_add(w, self.uv.m11, -R::one())
        } else {
            R::mul_add(nw, self.uv.m11, R::one())
        };
        let v0_01 = if sv0 {
            w * self.uv.m12
        } else {
            nw * self.uv.m12
        };
        let v0_02 = if sv0 {
            w * self.uv.m13
        } else {
            nw * self.uv.m13
        };
        let v0_03 = if sv0 {
            w * self.uv.m14
        } else {
            nw * self.uv.m14
        };
        let v0_04 = if sv0 {
            w * self.uv.m15
        } else {
            nw * self.uv.m15
        };
        let h = R::sum_prod4(
            v1_11, self.uv.m12, v1_12, self.uv.m13, v1_13, self.uv.m14, v1_14, self.uv.m15,
        );
        let w = h + h;
        let nw = -w;
        let v0_10 = if sv0 {
            w * self.uv.m11
        } else {
            nw * self.uv.m11
        };
        let v0_11 = if sv0 {
            R::mul_add(w, self.uv.m12, -v1_11)
        } else {
            R::mul_add(nw, self.uv.m12, v1_11)
        };
        let v0_12 = if sv0 {
            R::mul_add(w, self.uv.m13, -v1_12)
        } else {
            R::mul_add(nw, self.uv.m13, v1_12)
        };
        let v0_13 = if sv0 {
            R::mul_add(w, self.uv.m14, -v1_13)
        } else {
            R::mul_add(nw, self.uv.m14, v1_13)
        };
        let v0_14 = if sv0 {
            R::mul_add(w, self.uv.m15, -v1_14)
        } else {
            R::mul_add(nw, self.uv.m15, v1_14)
        };
        let h = R::sum_prod4(
            v1_21, self.uv.m12, v1_22, self.uv.m13, v1_23, self.uv.m14, v1_24, self.uv.m15,
        );
        let w = h + h;
        let nw = -w;
        let v0_20 = if sv0 {
            w * self.uv.m11
        } else {
            nw * self.uv.m11
        };
        let v0_21 = if sv0 {
            R::mul_add(w, self.uv.m12, -v1_21)
        } else {
            R::mul_add(nw, self.uv.m12, v1_21)
        };
        let v0_22 = if sv0 {
            R::mul_add(w, self.uv.m13, -v1_22)
        } else {
            R::mul_add(nw, self.uv.m13, v1_22)
        };
        let v0_23 = if sv0 {
            R::mul_add(w, self.uv.m14, -v1_23)
        } else {
            R::mul_add(nw, self.uv.m14, v1_23)
        };
        let v0_24 = if sv0 {
            R::mul_add(w, self.uv.m15, -v1_24)
        } else {
            R::mul_add(nw, self.uv.m15, v1_24)
        };
        let h = R::sum_prod4(
            v1_31, self.uv.m12, v1_32, self.uv.m13, v1_33, self.uv.m14, v1_34, self.uv.m15,
        );
        let w = h + h;
        let nw = -w;
        let v0_30 = if sv0 {
            w * self.uv.m11
        } else {
            nw * self.uv.m11
        };
        let v0_31 = if sv0 {
            R::mul_add(w, self.uv.m12, -v1_31)
        } else {
            R::mul_add(nw, self.uv.m12, v1_31)
        };
        let v0_32 = if sv0 {
            R::mul_add(w, self.uv.m13, -v1_32)
        } else {
            R::mul_add(nw, self.uv.m13, v1_32)
        };
        let v0_33 = if sv0 {
            R::mul_add(w, self.uv.m14, -v1_33)
        } else {
            R::mul_add(nw, self.uv.m14, v1_33)
        };
        let v0_34 = if sv0 {
            R::mul_add(w, self.uv.m15, -v1_34)
        } else {
            R::mul_add(nw, self.uv.m15, v1_34)
        };
        Matrix4x5 {
            m11: v0_00,
            m21: v0_10,
            m31: v0_20,
            m41: v0_30,
            m12: v0_01,
            m22: v0_11,
            m32: v0_21,
            m42: v0_31,
            m13: v0_02,
            m23: v0_12,
            m33: v0_22,
            m43: v0_32,
            m14: v0_03,
            m24: v0_13,
            m34: v0_23,
            m44: v0_33,
            m15: v0_04,
            m25: v0_14,
            m35: v0_24,
            m45: v0_34,
        }
    }

    /// The diagonal of `D` (`|diagonal|`). Exact. Upstream: `Bidiagonal::diagonal`.
    #[inline(always)]
    fn diagonal(self: Bidiagonal4x5<T>) -> Vector4<T> {
        Vector4 {
            x: R::abs(self.diagonal.x),
            y: R::abs(self.diagonal.y),
            z: R::abs(self.diagonal.z),
            w: R::abs(self.diagonal.w),
        }
    }

    /// The off-diagonal of `D` (`|off_diagonal|`). Exact. Upstream:
    /// `Bidiagonal::off_diagonal`.
    #[inline(always)]
    fn off_diagonal(self: Bidiagonal4x5<T>) -> Vector3<T> {
        Vector3 {
            x: R::abs(self.off_diagonal.x),
            y: R::abs(self.off_diagonal.y),
            z: R::abs(self.off_diagonal.z),
        }
    }

    /// The packed storage (the Householder axes). Exact. Upstream: `Bidiagonal::uv_internal`
    /// (`#[doc(hidden)]`).
    #[inline(always)]
    fn uv_internal(self: Bidiagonal4x5<T>) -> Matrix4x5<T> {
        self.uv
    }
}

/// `Matrix4x5` methods that go through the bidiagonalisation. Import `Matrix4x5BidiagonalTrait`.
#[generate_trait]
pub impl Matrix4x5BidiagonalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix4x5BidiagonalTrait<T> {
    /// The bidiagonalisation. Upstream: `Matrix::bidiagonalize`.
    #[inline(always)]
    fn bidiagonalize(self: Matrix4x5<T>) -> Bidiagonal4x5<T> {
        Bidiagonal4x5Trait::new(self)
    }
}
