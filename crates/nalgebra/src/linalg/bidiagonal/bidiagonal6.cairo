            m11: R::one(),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m61: R::zero(),
            m12: R::zero(),
            m22: v0_11,
            m32: v0_21,
            m42: v0_31,
            m52: v0_41,
            m62: v0_51,
            m13: R::zero(),
            m23: v0_12,
            m33: v0_22,
            m43: v0_32,
            m53: v0_42,
            m63: v0_52,
            m14: R::zero(),
            m24: v0_13,
            m34: v0_23,
            m44: v0_33,
            m54: v0_43,
            m64: v0_53,
            m15: R::zero(),
            m25: v0_14,
            m35: v0_24,
            m45: v0_34,
            m55: v0_44,
            m65: v0_54,
            m16: R::zero(),
            m26: v0_15,
            m36: v0_25,
            m46: v0_35,
            m56: v0_45,
            m66: v0_55,
