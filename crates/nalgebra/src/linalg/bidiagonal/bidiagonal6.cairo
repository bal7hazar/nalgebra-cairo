    /// The diagonal of `D` (`|diagonal|`). Exact. Upstream: `Bidiagonal::diagonal`.
    #[inline(always)]
    fn diagonal(self: Bidiagonal6<T>) -> Vector6<T> {
        Vector6 {
            x: R::abs(self.diagonal.x),
            y: R::abs(self.diagonal.y),
            z: R::abs(self.diagonal.z),
            w: R::abs(self.diagonal.w),
            a: R::abs(self.diagonal.a),
            b: R::abs(self.diagonal.b),
        }
    }

    /// The off-diagonal of `D` (`|off_diagonal|`). Exact. Upstream:
    /// `Bidiagonal::off_diagonal`.
    #[inline(always)]
    fn off_diagonal(self: Bidiagonal6<T>) -> Vector5<T> {
        Vector5 {
            x: R::abs(self.off_diagonal.x),
            y: R::abs(self.off_diagonal.y),
            z: R::abs(self.off_diagonal.z),
            w: R::abs(self.off_diagonal.w),
            a: R::abs(self.off_diagonal.a),
        }
    }

    /// The packed storage (the Householder axes). Exact. Upstream: `Bidiagonal::uv_internal`
    /// (`#[doc(hidden)]`).
    #[inline(always)]
    fn uv_internal(self: Bidiagonal6<T>) -> Matrix6<T> {
        self.uv
    }
}

/// `Matrix6` methods that go through the bidiagonalisation. Import `Matrix6BidiagonalTrait`.
#[generate_trait]
pub impl Matrix6BidiagonalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix6BidiagonalTrait<T> {
    /// The bidiagonalisation. Upstream: `Matrix::bidiagonalize`.
    #[inline(always)]
    fn bidiagonalize(self: Matrix6<T>) -> Bidiagonal6<T> {
        Bidiagonal6Trait::new(self)
    }
}
