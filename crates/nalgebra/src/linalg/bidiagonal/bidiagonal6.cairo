        };
        let v0_54 = if sv0 {
            R::mul_add(h, v0_v3, -v1_54)
        } else {
            R::mul_add(h, v0_nv3, v1_54)
        };
        let v0_55 = if sv0 {
            R::mul_add(h, v0_v4, -v1_55)
        } else {
            R::mul_add(h, v0_nv4, v1_55)
        };
