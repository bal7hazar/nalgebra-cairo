            m43: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::abs(self.off_diagonal.z),
            m44: R::abs(self.diagonal.w),
        }
    }

    /// The left factor `U` (6x4): upstream's loop, the signed left reflections applied in
    /// reverse order to the first 4 columns of the identity, on symbolic entries (its static zeros
    /// and ones cost nothing): one fused dot product per column and reflection (doubled exactly),
    /// one `Real::mul_add` per entry. A zero axis is a no-op, as upstream's `continue`. Upstream:
    /// `Bidiagonal::u`.
    fn u(self: Bidiagonal6x4<T>) -> Matrix6x4<T> {
        revoke_ap_tracking();
        let su3 = self.diagonal.w < R::zero();
        let h = self.uv.m44;
        let w = h + h;
        let nw = -w;
        let u3_33 = if su3 {
            R::mul_add(w, self.uv.m44, -R::one())
        } else {
            R::mul_add(nw, self.uv.m44, R::one())
        };
        let u3_43 = if su3 {
            w * self.uv.m54
        } else {
            nw * self.uv.m54
        };
        let u3_53 = if su3 {
            w * self.uv.m64
        } else {
            nw * self.uv.m64
        };
        let su2 = self.diagonal.z < R::zero();
        let h = self.uv.m33;
        let w = h + h;
        let nw = -w;
        let u2_22 = if su2 {
            R::mul_add(w, self.uv.m33, -R::one())
        } else {
            R::mul_add(nw, self.uv.m33, R::one())
        };
        let u2_32 = if su2 {
            w * self.uv.m43
        } else {
            nw * self.uv.m43
        };
        let u2_42 = if su2 {
            w * self.uv.m53
        } else {
            nw * self.uv.m53
        };
        let u2_52 = if su2 {
            w * self.uv.m63
        } else {
            nw * self.uv.m63
        };
        let h = R::sum_prod3(self.uv.m43, u3_33, self.uv.m53, u3_43, self.uv.m63, u3_53);
        let w = h + h;
        let nw = -w;
        let u2_23 = if su2 {
            w * self.uv.m33
        } else {
            nw * self.uv.m33
        };
        let u2_33 = if su2 {
            R::mul_add(w, self.uv.m43, -u3_33)
        } else {
            R::mul_add(nw, self.uv.m43, u3_33)
        };
        let u2_43 = if su2 {
            R::mul_add(w, self.uv.m53, -u3_43)
        } else {
            R::mul_add(nw, self.uv.m53, u3_43)
        };
        let u2_53 = if su2 {
            R::mul_add(w, self.uv.m63, -u3_53)
        } else {
            R::mul_add(nw, self.uv.m63, u3_53)
        };
        let su1 = self.diagonal.y < R::zero();
        let h = self.uv.m22;
        let w = h + h;
        let nw = -w;
        let u1_11 = if su1 {
            R::mul_add(w, self.uv.m22, -R::one())
        } else {
            R::mul_add(nw, self.uv.m22, R::one())
        };
        let u1_21 = if su1 {
            w * self.uv.m32
        } else {
            nw * self.uv.m32
        };
        let u1_31 = if su1 {
            w * self.uv.m42
        } else {
            nw * self.uv.m42
        };
        let u1_41 = if su1 {
            w * self.uv.m52
        } else {
            nw * self.uv.m52
        };
        let u1_51 = if su1 {
            w * self.uv.m62
        } else {
            nw * self.uv.m62
        };
        let h = R::sum_prod4(
            self.uv.m32, u2_22, self.uv.m42, u2_32, self.uv.m52, u2_42, self.uv.m62, u2_52,
        );
        let w = h + h;
        let nw = -w;
        let u1_12 = if su1 {
            w * self.uv.m22
        } else {
            nw * self.uv.m22
        };
        let u1_22 = if su1 {
            R::mul_add(w, self.uv.m32, -u2_22)
        } else {
            R::mul_add(nw, self.uv.m32, u2_22)
        };
        let u1_32 = if su1 {
            R::mul_add(w, self.uv.m42, -u2_32)
        } else {
            R::mul_add(nw, self.uv.m42, u2_32)
        };
        let u1_42 = if su1 {
            R::mul_add(w, self.uv.m52, -u2_42)
        } else {
            R::mul_add(nw, self.uv.m52, u2_42)
        };
        let u1_52 = if su1 {
            R::mul_add(w, self.uv.m62, -u2_52)
        } else {
            R::mul_add(nw, self.uv.m62, u2_52)
        };
        let h = R::sum_prod4(
            self.uv.m32, u2_23, self.uv.m42, u2_33, self.uv.m52, u2_43, self.uv.m62, u2_53,
        );
        let w = h + h;
        let nw = -w;
        let u1_13 = if su1 {
            w * self.uv.m22
        } else {
            nw * self.uv.m22
        };
        let u1_23 = if su1 {
            R::mul_add(w, self.uv.m32, -u2_23)
        } else {
            R::mul_add(nw, self.uv.m32, u2_23)
        };
        let u1_33 = if su1 {
            R::mul_add(w, self.uv.m42, -u2_33)
        } else {
            R::mul_add(nw, self.uv.m42, u2_33)
        };
        let u1_43 = if su1 {
            R::mul_add(w, self.uv.m52, -u2_43)
        } else {
            R::mul_add(nw, self.uv.m52, u2_43)
        };
        let u1_53 = if su1 {
            R::mul_add(w, self.uv.m62, -u2_53)
        } else {
            R::mul_add(nw, self.uv.m62, u2_53)
        };
        let su0 = self.diagonal.x < R::zero();
        let h = self.uv.m11;
        let w = h + h;
        let nw = -w;
        let u0_00 = if su0 {
            R::mul_add(w, self.uv.m11, -R::one())
        } else {
            R::mul_add(nw, self.uv.m11, R::one())
        };
        let u0_10 = if su0 {
            w * self.uv.m21
        } else {
            nw * self.uv.m21
        };
        let u0_20 = if su0 {
            w * self.uv.m31
        } else {
            nw * self.uv.m31
        };
        let u0_30 = if su0 {
            w * self.uv.m41
        } else {
            nw * self.uv.m41
        };
        let u0_40 = if su0 {
            w * self.uv.m51
        } else {
            nw * self.uv.m51
        };
        let u0_50 = if su0 {
            w * self.uv.m61
        } else {
            nw * self.uv.m61
        };
        let h = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.uv.m21, u1_11),
                            self.uv.m31,
                            u1_21,
                        ),
                        self.uv.m41,
                        u1_31,
                    ),
                    self.uv.m51,
                    u1_41,
                ),
                self.uv.m61,
                u1_51,
            ),
        );
        let w = h + h;
        let nw = -w;
        let u0_01 = if su0 {
            w * self.uv.m11
        } else {
            nw * self.uv.m11
        };
        let u0_11 = if su0 {
            R::mul_add(w, self.uv.m21, -u1_11)
        } else {
            R::mul_add(nw, self.uv.m21, u1_11)
        };
        let u0_21 = if su0 {
            R::mul_add(w, self.uv.m31, -u1_21)
        } else {
            R::mul_add(nw, self.uv.m31, u1_21)
        };
        let u0_31 = if su0 {
            R::mul_add(w, self.uv.m41, -u1_31)
        } else {
            R::mul_add(nw, self.uv.m41, u1_31)
        };
        let u0_41 = if su0 {
            R::mul_add(w, self.uv.m51, -u1_41)
        } else {
            R::mul_add(nw, self.uv.m51, u1_41)
        };
        let u0_51 = if su0 {
            R::mul_add(w, self.uv.m61, -u1_51)
        } else {
            R::mul_add(nw, self.uv.m61, u1_51)
        };
        let h = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.uv.m21, u1_12),
                            self.uv.m31,
                            u1_22,
                        ),
                        self.uv.m41,
                        u1_32,
                    ),
                    self.uv.m51,
                    u1_42,
                ),
                self.uv.m61,
                u1_52,
            ),
        );
        let w = h + h;
        let nw = -w;
        let u0_02 = if su0 {
            w * self.uv.m11
        } else {
            nw * self.uv.m11
        };
        let u0_12 = if su0 {
            R::mul_add(w, self.uv.m21, -u1_12)
        } else {
            R::mul_add(nw, self.uv.m21, u1_12)
        };
        let u0_22 = if su0 {
            R::mul_add(w, self.uv.m31, -u1_22)
        } else {
            R::mul_add(nw, self.uv.m31, u1_22)
        };
        let u0_32 = if su0 {
            R::mul_add(w, self.uv.m41, -u1_32)
        } else {
            R::mul_add(nw, self.uv.m41, u1_32)
        };
        let u0_42 = if su0 {
            R::mul_add(w, self.uv.m51, -u1_42)
        } else {
            R::mul_add(nw, self.uv.m51, u1_42)
        };
        let u0_52 = if su0 {
            R::mul_add(w, self.uv.m61, -u1_52)
        } else {
            R::mul_add(nw, self.uv.m61, u1_52)
        };
        let h = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(R::wide_zero(), self.uv.m21, u1_13),
                            self.uv.m31,
                            u1_23,
                        ),
                        self.uv.m41,
                        u1_33,
                    ),
                    self.uv.m51,
                    u1_43,
                ),
                self.uv.m61,
                u1_53,
            ),
        );
        let w = h + h;
        let nw = -w;
        let u0_03 = if su0 {
            w * self.uv.m11
        } else {
            nw * self.uv.m11
        };
        let u0_13 = if su0 {
            R::mul_add(w, self.uv.m21, -u1_13)
        } else {
            R::mul_add(nw, self.uv.m21, u1_13)
        };
        let u0_23 = if su0 {
            R::mul_add(w, self.uv.m31, -u1_23)
        } else {
            R::mul_add(nw, self.uv.m31, u1_23)
        };
        let u0_33 = if su0 {
            R::mul_add(w, self.uv.m41, -u1_33)
        } else {
            R::mul_add(nw, self.uv.m41, u1_33)
        };
        let u0_43 = if su0 {
            R::mul_add(w, self.uv.m51, -u1_43)
        } else {
            R::mul_add(nw, self.uv.m51, u1_43)
        };
        let u0_53 = if su0 {
            R::mul_add(w, self.uv.m61, -u1_53)
        } else {
            R::mul_add(nw, self.uv.m61, u1_53)
        };
        Matrix6x4 {
            m11: u0_00,
            m21: u0_10,
            m31: u0_20,
            m41: u0_30,
            m51: u0_40,
            m61: u0_50,
            m12: u0_01,
            m22: u0_11,
            m32: u0_21,
            m42: u0_31,
            m52: u0_41,
            m62: u0_51,
            m13: u0_02,
            m23: u0_12,
            m33: u0_22,
            m43: u0_32,
            m53: u0_42,
            m63: u0_52,
            m14: u0_03,
            m24: u0_13,
            m34: u0_23,
            m44: u0_33,
            m54: u0_43,
            m64: u0_53,
        }
    }

    /// The right factor `Vᵀ` (4x4): the signed right reflections applied in reverse order to
    /// the first 4 rows of the identity (same rounding as `u`). Upstream: `Bidiagonal::v_t`.
    fn v_t(self: Bidiagonal6x4<T>) -> Matrix4<T> {
        revoke_ap_tracking();
        let sv2 = self.off_diagonal.z < R::zero();
        let h = self.uv.m34;
        let w = h + h;
        let nw = -w;
        let v2_33 = if sv2 {
            R::mul_add(w, self.uv.m34, -R::one())
        } else {
            R::mul_add(nw, self.uv.m34, R::one())
        };
        let sv1 = self.off_diagonal.y < R::zero();
        let h = self.uv.m23;
        let w = h + h;
        let nw = -w;
        let v1_22 = if sv1 {
            R::mul_add(w, self.uv.m23, -R::one())
        } else {
            R::mul_add(nw, self.uv.m23, R::one())
        };
        let v1_23 = if sv1 {
            w * self.uv.m24
        } else {
            nw * self.uv.m24
        };
        let h = v2_33 * self.uv.m24;
        let w = h + h;
        let nw = -w;
        let v1_32 = if sv1 {
            w * self.uv.m23
        } else {
            nw * self.uv.m23
        };
        let v1_33 = if sv1 {
            R::mul_add(w, self.uv.m24, -v2_33)
        } else {
            R::mul_add(nw, self.uv.m24, v2_33)
        };
        let sv0 = self.off_diagonal.x < R::zero();
        let h = self.uv.m12;
        let w = h + h;
        let nw = -w;
        let v0_11 = if sv0 {
            R::mul_add(w, self.uv.m12, -R::one())
        } else {
            R::mul_add(nw, self.uv.m12, R::one())
        };
        let v0_12 = if sv0 {
            w * self.uv.m13
        } else {
            nw * self.uv.m13
        };
        let v0_13 = if sv0 {
            w * self.uv.m14
        } else {
            nw * self.uv.m14
        };
        let h = R::sum_prod2(v1_22, self.uv.m13, v1_23, self.uv.m14);
        let w = h + h;
        let nw = -w;
        let v0_21 = if sv0 {
            w * self.uv.m12
        } else {
            nw * self.uv.m12
        };
        let v0_22 = if sv0 {
            R::mul_add(w, self.uv.m13, -v1_22)
        } else {
            R::mul_add(nw, self.uv.m13, v1_22)
        };
        let v0_23 = if sv0 {
            R::mul_add(w, self.uv.m14, -v1_23)
        } else {
            R::mul_add(nw, self.uv.m14, v1_23)
        };
        let h = R::sum_prod2(v1_32, self.uv.m13, v1_33, self.uv.m14);
        let w = h + h;
        let nw = -w;
        let v0_31 = if sv0 {
            w * self.uv.m12
        } else {
            nw * self.uv.m12
        };
        let v0_32 = if sv0 {
            R::mul_add(w, self.uv.m13, -v1_32)
        } else {
            R::mul_add(nw, self.uv.m13, v1_32)
        };
        let v0_33 = if sv0 {
            R::mul_add(w, self.uv.m14, -v1_33)
        } else {
            R::mul_add(nw, self.uv.m14, v1_33)
        };
        Matrix4 {
            m11: R::one(),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m12: R::zero(),
            m22: v0_11,
            m32: v0_21,
            m42: v0_31,
            m13: R::zero(),
            m23: v0_12,
            m33: v0_22,
            m43: v0_32,
            m14: R::zero(),
            m24: v0_13,
            m34: v0_23,
            m44: v0_33,
        }
    }

    /// The diagonal of `D` (`|diagonal|`). Exact. Upstream: `Bidiagonal::diagonal`.
    #[inline(always)]
    fn diagonal(self: Bidiagonal6x4<T>) -> Vector4<T> {
        Vector4 {
            x: R::abs(self.diagonal.x),
            y: R::abs(self.diagonal.y),
            z: R::abs(self.diagonal.z),
            w: R::abs(self.diagonal.w),
        }
    }

    /// The off-diagonal of `D` (`|off_diagonal|`). Exact. Upstream:
    /// `Bidiagonal::off_diagonal`.
    #[inline(always)]
    fn off_diagonal(self: Bidiagonal6x4<T>) -> Vector3<T> {
        Vector3 {
            x: R::abs(self.off_diagonal.x),
            y: R::abs(self.off_diagonal.y),
            z: R::abs(self.off_diagonal.z),
        }
    }

    /// The packed storage (the Householder axes). Exact. Upstream: `Bidiagonal::uv_internal`
    /// (`#[doc(hidden)]`).
    #[inline(always)]
    fn uv_internal(self: Bidiagonal6x4<T>) -> Matrix6x4<T> {
        self.uv
    }
}

/// `Matrix6x4` methods that go through the bidiagonalisation. Import `Matrix6x4BidiagonalTrait`.
#[generate_trait]
pub impl Matrix6x4BidiagonalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix6x4BidiagonalTrait<T> {
    /// The bidiagonalisation. Upstream: `Matrix::bidiagonalize`.
    #[inline(always)]
    fn bidiagonalize(self: Matrix6x4<T>) -> Bidiagonal6x4<T> {
        Bidiagonal6x4Trait::new(self)
    }
}
