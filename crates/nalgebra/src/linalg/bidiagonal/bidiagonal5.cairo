                R::mul_add(h, v_ur2_0, -a33)
            } else {
                R::mul_add(h, nv_ur2_0, a33)
            };
            a34 = if neg {
                R::mul_add(h, v_ur2_1, -a34)
            } else {
                R::mul_add(h, nv_ur2_1, a34)
            };
            let h = R::sum_prod2(a43, ur2_0, a44, ur2_1);
            a43 = if neg {
                R::mul_add(h, v_ur2_0, -a43)
            } else {
                R::mul_add(h, nv_ur2_0, a43)
            };
            a44 = if neg {
                R::mul_add(h, v_ur2_1, -a44)
            } else {
                R::mul_add(h, nv_ur2_1, a44)
            };
            a23 = ur2_0;
            a24 = ur2_1;
        }
        // `d3 = clear_column_unchecked(matrix, 3, 0, None)`
        let (d3, nz_d3, uc3_0, uc3_1) = HouseholderKernelTrait::<T>::axis2(a33, a43);
        if nz_d3 {
            let neg = d3 < R::zero();
            let v_uc3_0 = uc3_0 + uc3_0;
            let nv_uc3_0 = -v_uc3_0;
            let v_uc3_1 = uc3_1 + uc3_1;
            let nv_uc3_1 = -v_uc3_1;
            let h = R::sum_prod2(uc3_0, a34, uc3_1, a44);
            a34 = if neg {
                R::mul_add(h, v_uc3_0, -a34)
            } else {
                R::mul_add(h, nv_uc3_0, a34)
            };
            a44 = if neg {
                R::mul_add(h, v_uc3_1, -a44)
            } else {
                R::mul_add(h, nv_uc3_1, a44)
            };
            a33 = uc3_0;
            a43 = uc3_1;
        }
        // `e3 = clear_row_unchecked(matrix, axis_packed, work, 3, 1)`
        let (e3, nz_e3, ur3_0) = HouseholderKernelTrait::<T>::axis1(a34);
        if nz_e3 {
            let neg = e3 < R::zero();
            let v_ur3_0 = ur3_0 + ur3_0;
            let nv_ur3_0 = -v_ur3_0;
            let h = a44 * ur3_0;
            a44 = if neg {
                R::mul_add(h, v_ur3_0, -a44)
            } else {
                R::mul_add(h, nv_ur3_0, a44)
            };
            a34 = ur3_0;
        }
        // `d4 = clear_column_unchecked(matrix, 4, 0, None)`
        let (d4, nz_d4, uc4_0) = HouseholderKernelTrait::<T>::axis1(a44);
        if nz_d4 {
            a44 = uc4_0;
        }
        Bidiagonal5 {
            uv: Matrix5 {
                m11: a00,
                m21: a10,
                m31: a20,
                m41: a30,
                m51: a40,
                m12: a01,
                m22: a11,
                m32: a21,
                m42: a31,
                m52: a41,
                m13: a02,
                m23: a12,
                m33: a22,
                m43: a32,
                m53: a42,
                m14: a03,
                m24: a13,
                m34: a23,
                m44: a33,
                m54: a43,
                m15: a04,
                m25: a14,
                m35: a24,
                m45: a34,
                m55: a44,
            },
            diagonal: Vector5 { x: d0, y: d1, z: d2, w: d3, a: d4 },
            off_diagonal: Vector4 { x: e0, y: e1, z: e2, w: e3 },
            upper_diagonal: true,
        }
    }

    /// Whether `D` is upper bidiagonal (rows >= columns). Upstream:
    /// `Bidiagonal::is_upper_diagonal`.
    #[inline(always)]
    fn is_upper_diagonal(self: Bidiagonal5<T>) -> bool {
        self.upper_diagonal
    }

    /// `(U, D, Vᵀ)`: `(u(), d(), v_t())`, with `A = U D Vᵀ`. Upstream: `Bidiagonal::unpack`.
    #[inline(always)]
    fn unpack(self: Bidiagonal5<T>) -> (Matrix5<T>, Matrix5<T>, Matrix5<T>) {
        (Self::u(self), Self::d(self), Self::v_t(self))
    }

    /// The bidiagonal factor `D` (5x5): `|diagonal|` on the diagonal, `|off_diagonal|` on the
    /// superdiagonal. Exact. Upstream: `Bidiagonal::d`.
    #[inline(always)]
    fn d(self: Bidiagonal5<T>) -> Matrix5<T> {
        Matrix5 {
            m11: R::abs(self.diagonal.x),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: R::abs(self.off_diagonal.x),
            m22: R::abs(self.diagonal.y),
            m32: R::zero(),
            m42: R::zero(),
            m52: R::zero(),
            m13: R::zero(),
            m23: R::abs(self.off_diagonal.y),
            m33: R::abs(self.diagonal.z),
            m43: R::zero(),
            m53: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: R::abs(self.off_diagonal.z),
            m44: R::abs(self.diagonal.w),
            m54: R::zero(),
            m15: R::zero(),
            m25: R::zero(),
            m35: R::zero(),
            m45: R::abs(self.off_diagonal.w),
            m55: R::abs(self.diagonal.a),
        }
    }

    /// The left factor `U` (5x5): upstream's loop, the signed left reflections applied in
    /// reverse order to the first 5 columns of the identity, on symbolic entries (its static zeros
    /// and ones cost nothing): one fused dot product per column and reflection (doubled exactly),
    /// one `Real::mul_add` per entry. A zero axis is a no-op, as upstream's `continue`. Upstream:
    /// `Bidiagonal::u`.
    fn u(self: Bidiagonal5<T>) -> Matrix5<T> {
        revoke_ap_tracking();
        let su4 = self.diagonal.a < R::zero();
        let u4_v0 = self.uv.m55 + self.uv.m55;
        let u4_nv0 = -u4_v0;
        let h = self.uv.m55;
        let u4_44 = if su4 {
            R::mul_add(h, u4_v0, -R::one())
        } else {
            R::mul_add(h, u4_nv0, R::one())
        };
        let su3 = self.diagonal.w < R::zero();
        let u3_v0 = self.uv.m44 + self.uv.m44;
        let u3_nv0 = -u3_v0;
        let u3_v1 = self.uv.m54 + self.uv.m54;
        let u3_nv1 = -u3_v1;
        let h = self.uv.m44;
        let u3_33 = if su3 {
            R::mul_add(h, u3_v0, -R::one())
        } else {
            R::mul_add(h, u3_nv0, R::one())
        };
        let u3_43 = if su3 {
            h * u3_v1
        } else {
            h * u3_nv1
        };
        let h = self.uv.m54 * u4_44;
        let u3_34 = if su3 {
            h * u3_v0
        } else {
            h * u3_nv0
        };
        let u3_44 = if su3 {
            R::mul_add(h, u3_v1, -u4_44)
        } else {
            R::mul_add(h, u3_nv1, u4_44)
        };
        let su2 = self.diagonal.z < R::zero();
        let u2_v0 = self.uv.m33 + self.uv.m33;
        let u2_nv0 = -u2_v0;
        let u2_v1 = self.uv.m43 + self.uv.m43;
        let u2_nv1 = -u2_v1;
        let u2_v2 = self.uv.m53 + self.uv.m53;
        let u2_nv2 = -u2_v2;
        let h = self.uv.m33;
        let u2_22 = if su2 {
            R::mul_add(h, u2_v0, -R::one())
        } else {
            R::mul_add(h, u2_nv0, R::one())
        };
        let u2_32 = if su2 {
            h * u2_v1
        } else {
            h * u2_nv1
        };
        let u2_42 = if su2 {
            h * u2_v2
        } else {
            h * u2_nv2
        };
        let h = R::sum_prod2(self.uv.m43, u3_33, self.uv.m53, u3_43);
        let u2_23 = if su2 {
            h * u2_v0
        } else {
            h * u2_nv0
        };
        let u2_33 = if su2 {
            R::mul_add(h, u2_v1, -u3_33)
        } else {
            R::mul_add(h, u2_nv1, u3_33)
        };
        let u2_43 = if su2 {
            R::mul_add(h, u2_v2, -u3_43)
        } else {
            R::mul_add(h, u2_nv2, u3_43)
        };
        let h = R::sum_prod2(self.uv.m43, u3_34, self.uv.m53, u3_44);
        let u2_24 = if su2 {
            h * u2_v0
        } else {
            h * u2_nv0
        };
        let u2_34 = if su2 {
            R::mul_add(h, u2_v1, -u3_34)
        } else {
            R::mul_add(h, u2_nv1, u3_34)
        };
        let u2_44 = if su2 {
            R::mul_add(h, u2_v2, -u3_44)
        } else {
            R::mul_add(h, u2_nv2, u3_44)
        };
        let su1 = self.diagonal.y < R::zero();
        let u1_v0 = self.uv.m22 + self.uv.m22;
        let u1_nv0 = -u1_v0;
        let u1_v1 = self.uv.m32 + self.uv.m32;
        let u1_nv1 = -u1_v1;
        let u1_v2 = self.uv.m42 + self.uv.m42;
        let u1_nv2 = -u1_v2;
        let u1_v3 = self.uv.m52 + self.uv.m52;
        let u1_nv3 = -u1_v3;
        let h = self.uv.m22;
        let u1_11 = if su1 {
            R::mul_add(h, u1_v0, -R::one())
        } else {
            R::mul_add(h, u1_nv0, R::one())
        };
        let u1_21 = if su1 {
            h * u1_v1
        } else {
            h * u1_nv1
        };
        let u1_31 = if su1 {
            h * u1_v2
        } else {
            h * u1_nv2
        };
        let u1_41 = if su1 {
            h * u1_v3
        } else {
            h * u1_nv3
        };
        let h = R::sum_prod3(self.uv.m32, u2_22, self.uv.m42, u2_32, self.uv.m52, u2_42);
        let u1_12 = if su1 {
            h * u1_v0
        } else {
            h * u1_nv0
        };
        let u1_22 = if su1 {
            R::mul_add(h, u1_v1, -u2_22)
        } else {
            R::mul_add(h, u1_nv1, u2_22)
        };
        let u1_32 = if su1 {
            R::mul_add(h, u1_v2, -u2_32)
        } else {
            R::mul_add(h, u1_nv2, u2_32)
        };
        let u1_42 = if su1 {
            R::mul_add(h, u1_v3, -u2_42)
        } else {
            R::mul_add(h, u1_nv3, u2_42)
        };
        let h = R::sum_prod3(self.uv.m32, u2_23, self.uv.m42, u2_33, self.uv.m52, u2_43);
        let u1_13 = if su1 {
            h * u1_v0
        } else {
            h * u1_nv0
        };
        let u1_23 = if su1 {
            R::mul_add(h, u1_v1, -u2_23)
        } else {
            R::mul_add(h, u1_nv1, u2_23)
        };
        let u1_33 = if su1 {
            R::mul_add(h, u1_v2, -u2_33)
        } else {
            R::mul_add(h, u1_nv2, u2_33)
        };
        let u1_43 = if su1 {
            R::mul_add(h, u1_v3, -u2_43)
        } else {
            R::mul_add(h, u1_nv3, u2_43)
        };
        let h = R::sum_prod3(self.uv.m32, u2_24, self.uv.m42, u2_34, self.uv.m52, u2_44);
        let u1_14 = if su1 {
            h * u1_v0
        } else {
            h * u1_nv0
        };
        let u1_24 = if su1 {
            R::mul_add(h, u1_v1, -u2_24)
        } else {
            R::mul_add(h, u1_nv1, u2_24)
        };
        let u1_34 = if su1 {
            R::mul_add(h, u1_v2, -u2_34)
        } else {
            R::mul_add(h, u1_nv2, u2_34)
        };
        let u1_44 = if su1 {
            R::mul_add(h, u1_v3, -u2_44)
        } else {
            R::mul_add(h, u1_nv3, u2_44)
        };
        let su0 = self.diagonal.x < R::zero();
        let u0_v0 = self.uv.m11 + self.uv.m11;
        let u0_nv0 = -u0_v0;
        let u0_v1 = self.uv.m21 + self.uv.m21;
        let u0_nv1 = -u0_v1;
        let u0_v2 = self.uv.m31 + self.uv.m31;
        let u0_nv2 = -u0_v2;
        let u0_v3 = self.uv.m41 + self.uv.m41;
        let u0_nv3 = -u0_v3;
        let u0_v4 = self.uv.m51 + self.uv.m51;
        let u0_nv4 = -u0_v4;
        let h = self.uv.m11;
        let u0_00 = if su0 {
            R::mul_add(h, u0_v0, -R::one())
        } else {
            R::mul_add(h, u0_nv0, R::one())
        };
        let u0_10 = if su0 {
            h * u0_v1
        } else {
            h * u0_nv1
        };
        let u0_20 = if su0 {
            h * u0_v2
        } else {
            h * u0_nv2
        };
        let u0_30 = if su0 {
            h * u0_v3
        } else {
            h * u0_nv3
        };
        let u0_40 = if su0 {
            h * u0_v4
        } else {
            h * u0_nv4
        };
        let h = R::sum_prod4(
            self.uv.m21, u1_11, self.uv.m31, u1_21, self.uv.m41, u1_31, self.uv.m51, u1_41,
        );
        let u0_01 = if su0 {
            h * u0_v0
        } else {
            h * u0_nv0
        };
        let u0_11 = if su0 {
            R::mul_add(h, u0_v1, -u1_11)
        } else {
            R::mul_add(h, u0_nv1, u1_11)
        };
        let u0_21 = if su0 {
            R::mul_add(h, u0_v2, -u1_21)
        } else {
            R::mul_add(h, u0_nv2, u1_21)
        };
        let u0_31 = if su0 {
            R::mul_add(h, u0_v3, -u1_31)
        } else {
            R::mul_add(h, u0_nv3, u1_31)
        };
        let u0_41 = if su0 {
            R::mul_add(h, u0_v4, -u1_41)
        } else {
            R::mul_add(h, u0_nv4, u1_41)
        };
        let h = R::sum_prod4(
            self.uv.m21, u1_12, self.uv.m31, u1_22, self.uv.m41, u1_32, self.uv.m51, u1_42,
        );
        let u0_02 = if su0 {
            h * u0_v0
        } else {
            h * u0_nv0
        };
        let u0_12 = if su0 {
            R::mul_add(h, u0_v1, -u1_12)
        } else {
            R::mul_add(h, u0_nv1, u1_12)
        };
        let u0_22 = if su0 {
            R::mul_add(h, u0_v2, -u1_22)
        } else {
            R::mul_add(h, u0_nv2, u1_22)
        };
        let u0_32 = if su0 {
            R::mul_add(h, u0_v3, -u1_32)
        } else {
            R::mul_add(h, u0_nv3, u1_32)
        };
        let u0_42 = if su0 {
            R::mul_add(h, u0_v4, -u1_42)
        } else {
            R::mul_add(h, u0_nv4, u1_42)
        };
        let h = R::sum_prod4(
            self.uv.m21, u1_13, self.uv.m31, u1_23, self.uv.m41, u1_33, self.uv.m51, u1_43,
        );
        let u0_03 = if su0 {
            h * u0_v0
        } else {
            h * u0_nv0
        };
        let u0_13 = if su0 {
            R::mul_add(h, u0_v1, -u1_13)
        } else {
            R::mul_add(h, u0_nv1, u1_13)
        };
        let u0_23 = if su0 {
            R::mul_add(h, u0_v2, -u1_23)
        } else {
            R::mul_add(h, u0_nv2, u1_23)
        };
        let u0_33 = if su0 {
            R::mul_add(h, u0_v3, -u1_33)
        } else {
            R::mul_add(h, u0_nv3, u1_33)
        };
        let u0_43 = if su0 {
            R::mul_add(h, u0_v4, -u1_43)
        } else {
            R::mul_add(h, u0_nv4, u1_43)
        };
        let h = R::sum_prod4(
            self.uv.m21, u1_14, self.uv.m31, u1_24, self.uv.m41, u1_34, self.uv.m51, u1_44,
        );
        let u0_04 = if su0 {
            h * u0_v0
        } else {
            h * u0_nv0
        };
        let u0_14 = if su0 {
            R::mul_add(h, u0_v1, -u1_14)
        } else {
            R::mul_add(h, u0_nv1, u1_14)
        };
        let u0_24 = if su0 {
            R::mul_add(h, u0_v2, -u1_24)
        } else {
            R::mul_add(h, u0_nv2, u1_24)
        };
        let u0_34 = if su0 {
            R::mul_add(h, u0_v3, -u1_34)
        } else {
            R::mul_add(h, u0_nv3, u1_34)
        };
        let u0_44 = if su0 {
            R::mul_add(h, u0_v4, -u1_44)
        } else {
            R::mul_add(h, u0_nv4, u1_44)
        };
        Matrix5 {
            m11: u0_00,
            m21: u0_10,
            m31: u0_20,
            m41: u0_30,
            m51: u0_40,
            m12: u0_01,
            m22: u0_11,
            m32: u0_21,
            m42: u0_31,
            m52: u0_41,
            m13: u0_02,
            m23: u0_12,
            m33: u0_22,
            m43: u0_32,
            m53: u0_42,
            m14: u0_03,
            m24: u0_13,
            m34: u0_23,
            m44: u0_33,
            m54: u0_43,
            m15: u0_04,
            m25: u0_14,
            m35: u0_24,
            m45: u0_34,
            m55: u0_44,
        }
    }

    /// The right factor `Vᵀ` (5x5): the signed right reflections applied in reverse order to
    /// the first 5 rows of the identity (same rounding as `u`). Upstream: `Bidiagonal::v_t`.
    fn v_t(self: Bidiagonal5<T>) -> Matrix5<T> {
        revoke_ap_tracking();
        let sv3 = self.off_diagonal.w < R::zero();
        let v3_v0 = self.uv.m45 + self.uv.m45;
        let v3_nv0 = -v3_v0;
        let h = self.uv.m45;
        let v3_44 = if sv3 {
            R::mul_add(h, v3_v0, -R::one())
        } else {
            R::mul_add(h, v3_nv0, R::one())
        };
        let sv2 = self.off_diagonal.z < R::zero();
        let v2_v0 = self.uv.m34 + self.uv.m34;
        let v2_nv0 = -v2_v0;
        let v2_v1 = self.uv.m35 + self.uv.m35;
        let v2_nv1 = -v2_v1;
        let h = self.uv.m34;
        let v2_33 = if sv2 {
            R::mul_add(h, v2_v0, -R::one())
        } else {
            R::mul_add(h, v2_nv0, R::one())
        };
        let v2_34 = if sv2 {
            h * v2_v1
        } else {
            h * v2_nv1
        };
        let h = v3_44 * self.uv.m35;
        let v2_43 = if sv2 {
            h * v2_v0
        } else {
            h * v2_nv0
        };
        let v2_44 = if sv2 {
            R::mul_add(h, v2_v1, -v3_44)
        } else {
            R::mul_add(h, v2_nv1, v3_44)
        };
        let sv1 = self.off_diagonal.y < R::zero();
        let v1_v0 = self.uv.m23 + self.uv.m23;
        let v1_nv0 = -v1_v0;
        let v1_v1 = self.uv.m24 + self.uv.m24;
        let v1_nv1 = -v1_v1;
        let v1_v2 = self.uv.m25 + self.uv.m25;
        let v1_nv2 = -v1_v2;
        let h = self.uv.m23;
        let v1_22 = if sv1 {
            R::mul_add(h, v1_v0, -R::one())
        } else {
            R::mul_add(h, v1_nv0, R::one())
        };
        let v1_23 = if sv1 {
            h * v1_v1
        } else {
            h * v1_nv1
        };
        let v1_24 = if sv1 {
            h * v1_v2
        } else {
            h * v1_nv2
        };
        let h = R::sum_prod2(v2_33, self.uv.m24, v2_34, self.uv.m25);
        let v1_32 = if sv1 {
            h * v1_v0
        } else {
            h * v1_nv0
        };
        let v1_33 = if sv1 {
            R::mul_add(h, v1_v1, -v2_33)
        } else {
            R::mul_add(h, v1_nv1, v2_33)
        };
        let v1_34 = if sv1 {
            R::mul_add(h, v1_v2, -v2_34)
        } else {
            R::mul_add(h, v1_nv2, v2_34)
        };
        let h = R::sum_prod2(v2_43, self.uv.m24, v2_44, self.uv.m25);
        let v1_42 = if sv1 {
            h * v1_v0
        } else {
            h * v1_nv0
        };
        let v1_43 = if sv1 {
            R::mul_add(h, v1_v1, -v2_43)
        } else {
            R::mul_add(h, v1_nv1, v2_43)
        };
        let v1_44 = if sv1 {
            R::mul_add(h, v1_v2, -v2_44)
        } else {
            R::mul_add(h, v1_nv2, v2_44)
        };
        let sv0 = self.off_diagonal.x < R::zero();
        let v0_v0 = self.uv.m12 + self.uv.m12;
        let v0_nv0 = -v0_v0;
        let v0_v1 = self.uv.m13 + self.uv.m13;
        let v0_nv1 = -v0_v1;
        let v0_v2 = self.uv.m14 + self.uv.m14;
        let v0_nv2 = -v0_v2;
        let v0_v3 = self.uv.m15 + self.uv.m15;
        let v0_nv3 = -v0_v3;
        let h = self.uv.m12;
        let v0_11 = if sv0 {
            R::mul_add(h, v0_v0, -R::one())
        } else {
            R::mul_add(h, v0_nv0, R::one())
        };
        let v0_12 = if sv0 {
            h * v0_v1
        } else {
            h * v0_nv1
        };
        let v0_13 = if sv0 {
            h * v0_v2
        } else {
            h * v0_nv2
        };
        let v0_14 = if sv0 {
            h * v0_v3
        } else {
            h * v0_nv3
        };
        let h = R::sum_prod3(v1_22, self.uv.m13, v1_23, self.uv.m14, v1_24, self.uv.m15);
        let v0_21 = if sv0 {
            h * v0_v0
        } else {
            h * v0_nv0
        };
        let v0_22 = if sv0 {
            R::mul_add(h, v0_v1, -v1_22)
        } else {
            R::mul_add(h, v0_nv1, v1_22)
        };
        let v0_23 = if sv0 {
            R::mul_add(h, v0_v2, -v1_23)
        } else {
            R::mul_add(h, v0_nv2, v1_23)
        };
        let v0_24 = if sv0 {
            R::mul_add(h, v0_v3, -v1_24)
        } else {
            R::mul_add(h, v0_nv3, v1_24)
        };
        let h = R::sum_prod3(v1_32, self.uv.m13, v1_33, self.uv.m14, v1_34, self.uv.m15);
        let v0_31 = if sv0 {
            h * v0_v0
        } else {
            h * v0_nv0
        };
        let v0_32 = if sv0 {
            R::mul_add(h, v0_v1, -v1_32)
        } else {
            R::mul_add(h, v0_nv1, v1_32)
        };
        let v0_33 = if sv0 {
            R::mul_add(h, v0_v2, -v1_33)
        } else {
            R::mul_add(h, v0_nv2, v1_33)
        };
        let v0_34 = if sv0 {
            R::mul_add(h, v0_v3, -v1_34)
        } else {
            R::mul_add(h, v0_nv3, v1_34)
        };
        let h = R::sum_prod3(v1_42, self.uv.m13, v1_43, self.uv.m14, v1_44, self.uv.m15);
        let v0_41 = if sv0 {
            h * v0_v0
        } else {
            h * v0_nv0
        };
        let v0_42 = if sv0 {
            R::mul_add(h, v0_v1, -v1_42)
        } else {
            R::mul_add(h, v0_nv1, v1_42)
        };
        let v0_43 = if sv0 {
            R::mul_add(h, v0_v2, -v1_43)
        } else {
            R::mul_add(h, v0_nv2, v1_43)
        };
        let v0_44 = if sv0 {
            R::mul_add(h, v0_v3, -v1_44)
        } else {
            R::mul_add(h, v0_nv3, v1_44)
        };
        Matrix5 {
            m11: R::one(),
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: R::zero(),
            m22: v0_11,
            m32: v0_21,
            m42: v0_31,
            m52: v0_41,
            m13: R::zero(),
            m23: v0_12,
            m33: v0_22,
            m43: v0_32,
            m53: v0_42,
            m14: R::zero(),
            m24: v0_13,
            m34: v0_23,
            m44: v0_33,
            m54: v0_43,
            m15: R::zero(),
            m25: v0_14,
            m35: v0_24,
            m45: v0_34,
            m55: v0_44,
        }
    }

    /// The diagonal of `D` (`|diagonal|`). Exact. Upstream: `Bidiagonal::diagonal`.
    #[inline(always)]
    fn diagonal(self: Bidiagonal5<T>) -> Vector5<T> {
        Vector5 {
            x: R::abs(self.diagonal.x),
            y: R::abs(self.diagonal.y),
            z: R::abs(self.diagonal.z),
            w: R::abs(self.diagonal.w),
            a: R::abs(self.diagonal.a),
        }
    }

    /// The off-diagonal of `D` (`|off_diagonal|`). Exact. Upstream:
    /// `Bidiagonal::off_diagonal`.
    #[inline(always)]
    fn off_diagonal(self: Bidiagonal5<T>) -> Vector4<T> {
        Vector4 {
            x: R::abs(self.off_diagonal.x),
            y: R::abs(self.off_diagonal.y),
            z: R::abs(self.off_diagonal.z),
            w: R::abs(self.off_diagonal.w),
        }
    }

    /// The packed storage (the Householder axes). Exact. Upstream: `Bidiagonal::uv_internal`
    /// (`#[doc(hidden)]`).
    #[inline(always)]
    fn uv_internal(self: Bidiagonal5<T>) -> Matrix5<T> {
        self.uv
    }
}

/// `Matrix5` methods that go through the bidiagonalisation. Import `Matrix5BidiagonalTrait`.
#[generate_trait]
pub impl Matrix5BidiagonalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5BidiagonalTrait<T> {
    /// The bidiagonalisation. Upstream: `Matrix::bidiagonalize`.
    #[inline(always)]
    fn bidiagonalize(self: Matrix5<T>) -> Bidiagonal5<T> {
        Bidiagonal5Trait::new(self)
    }
}
