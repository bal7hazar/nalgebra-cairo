                        let t = a51;
                        a51 = a52;
                        a52 = t;
                        let t = a11;
                        a11 = a22;
                        a22 = t;
                    } else if piv == 3 {
                        let t = a41;
                        a41 = a43;
                        a43 = t;
                        let t = a51;
                        a51 = a53;
                        a53 = t;
                        let t = a21;
                        a21 = a32;
                        a32 = t;
                        let t = a11;
                        a11 = a33;
                        a33 = t;
                    } else if piv == 4 {
                        let t = a51;
                        a51 = a54;
                        a54 = t;
                        let t = a21;
                        a21 = a42;
                        a42 = t;
                        let t = a31;
                        a31 = a43;
                        a43 = t;
                        let t = a11;
                        a11 = a44;
                        a44 = t;
                    } else if piv == 5 {
                        let t = a21;
                        a21 = a52;
                        a52 = t;
                        let t = a31;
                        a31 = a53;
                        a53 = t;
                        let t = a41;
                        a41 = a54;
                        a54 = t;
                        let t = a11;
                        a11 = a55;
                        a55 = t;
                    }
                    let (l2, l3, l4, l5, s22, s32, s42, s52, s33) = R::div9(
                        a21,
                        a31,
                        a41,
                        a51,
                        R::diff_prod(a22, a11, a21, a21),
                        R::diff_prod(a32, a11, a31, a21),
                        R::diff_prod(a42, a11, a41, a21),
                        R::diff_prod(a52, a11, a51, a21),
                        R::diff_prod(a33, a11, a31, a31),
                        a11,
                    );
                    let (s43, s53, s44, s54, s55) = R::div5(
                        R::diff_prod(a43, a11, a41, a31),
                        R::diff_prod(a53, a11, a51, a31),
                        R::diff_prod(a44, a11, a41, a41),
                        R::diff_prod(a54, a11, a51, a41),
                        R::diff_prod(a55, a11, a51, a51),
                        a11,
                    );
                    a22 = s22;
                    a32 = s32;
                    a42 = s42;
                    a52 = s52;
                    a33 = s33;
                    a43 = s43;
                    a53 = s53;
                    a44 = s44;
                    a54 = s54;
                    a55 = s55;
                    a21 = l2;
                    a31 = l3;
                    a41 = l4;
                    a51 = l5;
                    pi1 = piv;
                    ps1 = 1;
                }
            }
        }
        // position 3
        if skip {
            skip = false;
        } else {
            let dabs = R::abs(a22);
            let mut imax = 3_u8;
            let mut colmax = R::abs(a32);
            let x = R::abs(a42);
            if x > colmax {
                colmax = x;
                imax = 4;
            }
            let x = R::abs(a52);
            if x > colmax {
                colmax = x;
                imax = 5;
            }
            if dabs == R::zero() && colmax == R::zero() {
                if zero_pivot.is_none() {
                    zero_pivot = Some(2);
                }
            } else {
                let mut piv = 2_u8;
                let mut two = false;
                let ac = alpha * colmax;
                if dabs < ac {
                    let (rowmax, dimax) = if imax == 3 {
                        (R::max(R::max(R::abs(a32), R::abs(a43)), R::abs(a53)), R::abs(a33))
                    } else if imax == 4 {
                        (R::max(R::max(R::abs(a42), R::abs(a43)), R::abs(a54)), R::abs(a44))
                    } else {
                        (R::max(R::max(R::abs(a52), R::abs(a53)), R::abs(a54)), R::abs(a55))
                    };
                    let bound = R::wide_mul_scalar(
                        R::wide_add_prod(R::wide_zero(), alpha, colmax), R::div(colmax, rowmax),
                    );
                    if dabs < bound {
                        piv = imax;
                        if dimax < alpha * rowmax {
                            two = true;
                        }
                    }
                }
                if two {
                    if piv == 4 {
                        let t = a53;
                        a53 = a54;
                        a54 = t;
                        let t = a33;
                        a33 = a44;
                        a44 = t;
                        let t = a32;
                        a32 = a42;
                        a42 = t;
                    } else if piv == 5 {
                        let t = a43;
                        a43 = a54;
                        a54 = t;
                        let t = a33;
                        a33 = a55;
                        a55 = t;
                        let t = a32;
                        a32 = a52;
                        a52 = t;
                    }
                    let det = R::diff_prod(a22, a33, a32, a32);
                    let (w1_4, w2_4, w1_5, w2_5) = R::div4(
                        R::diff_prod(a42, a33, a43, a32),
                        R::diff_prod(a43, a22, a42, a32),
                        R::diff_prod(a52, a33, a53, a32),
                        R::diff_prod(a53, a22, a52, a32),
                        det,
                    );
                    let (p2, g4, h4, g5, h5, t44) = R::div6(
                        R::diff_prod(a32, a32, a22, a33),
                        R::diff_prod(a32, a42, a22, a43),
                        R::diff_prod(a32, a43, a33, a42),
                        R::diff_prod(a32, a52, a22, a53),
                        R::diff_prod(a32, a53, a33, a52),
                        R::diff_prod(a32, a44, a42, a43),
                        a32,
                    );
                    let t54 = R::div(R::diff_prod(a32, a54, a52, a43), a32);
                    let t55 = R::div(R::diff_prod(a32, a55, a52, a53), a32);
                    let (s44, s54, s55) = R::div3(
                        R::diff_prod(t44, p2, h4, g4),
                        R::diff_prod(t54, p2, h5, g4),
                        R::diff_prod(t55, p2, h5, g5),
                        p2,
                    );
                    a44 = s44;
                    a54 = s54;
                    a55 = s55;
                    a42 = w1_4;
                    a43 = w2_4;
                    a52 = w1_5;
                    a53 = w2_5;
                    pi2 = piv;
                    ps2 = 2;
                    pi3 = piv;
                    ps3 = 2;
                    skip = true;
                } else {
                    if piv == 3 {
                        let t = a42;
                        a42 = a43;
                        a43 = t;
                        let t = a52;
                        a52 = a53;
                        a53 = t;
                        let t = a22;
                        a22 = a33;
                        a33 = t;
                    } else if piv == 4 {
                        let t = a52;
                        a52 = a54;
                        a54 = t;
                        let t = a32;
                        a32 = a43;
                        a43 = t;
                        let t = a22;
                        a22 = a44;
                        a44 = t;
                    } else if piv == 5 {
                        let t = a32;
                        a32 = a53;
                        a53 = t;
                        let t = a42;
                        a42 = a54;
                        a54 = t;
                        let t = a22;
                        a22 = a55;
                        a55 = t;
                    }
                    let (l3, l4, l5, s33, s43, s53, s44, s54, s55) = R::div9(
                        a32,
                        a42,
                        a52,
                        R::diff_prod(a33, a22, a32, a32),
                        R::diff_prod(a43, a22, a42, a32),
                        R::diff_prod(a53, a22, a52, a32),
                        R::diff_prod(a44, a22, a42, a42),
                        R::diff_prod(a54, a22, a52, a42),
                        R::diff_prod(a55, a22, a52, a52),
                        a22,
                    );
                    a33 = s33;
                    a43 = s43;
                    a53 = s53;
                    a44 = s44;
                    a54 = s54;
                    a55 = s55;
                    a32 = l3;
                    a42 = l4;
                    a52 = l5;
                    pi2 = piv;
                    ps2 = 1;
                }
            }
        }
        // position 4
        if skip {
            skip = false;
        } else {
            let dabs = R::abs(a33);
            let mut imax = 4_u8;
            let mut colmax = R::abs(a43);
            let x = R::abs(a53);
            if x > colmax {
                colmax = x;
                imax = 5;
            }
            if dabs == R::zero() && colmax == R::zero() {
                if zero_pivot.is_none() {
                    zero_pivot = Some(3);
                }
            } else {
                let mut piv = 3_u8;
                let mut two = false;
                let ac = alpha * colmax;
                if dabs < ac {
                    let (rowmax, dimax) = if imax == 4 {
                        (R::max(R::abs(a43), R::abs(a54)), R::abs(a44))
                    } else {
                        (R::max(R::abs(a53), R::abs(a54)), R::abs(a55))
                    };
                    let bound = R::wide_mul_scalar(
                        R::wide_add_prod(R::wide_zero(), alpha, colmax), R::div(colmax, rowmax),
                    );
                    if dabs < bound {
                        piv = imax;
                        if dimax < alpha * rowmax {
                            two = true;
                        }
                    }
                }
                if two {
                    if piv == 5 {
                        let t = a44;
                        a44 = a55;
                        a55 = t;
                        let t = a43;
                        a43 = a53;
                        a53 = t;
                    }
                    let det = R::diff_prod(a33, a44, a43, a43);
                    let w1_5 = R::div(R::diff_prod(a53, a44, a54, a43), det);
                    let w2_5 = R::div(R::diff_prod(a54, a33, a53, a43), det);
                    let (p2, g5, h5, t55) = R::div4(
                        R::diff_prod(a43, a43, a33, a44),
                        R::diff_prod(a43, a53, a33, a54),
                        R::diff_prod(a43, a54, a44, a53),
                        R::diff_prod(a43, a55, a53, a54),
                        a43,
                    );
                    let s55 = R::div(R::diff_prod(t55, p2, h5, g5), p2);
                    a55 = s55;
                    a53 = w1_5;
                    a54 = w2_5;
                    pi3 = piv;
                    ps3 = 2;
                    pi4 = piv;
                    ps4 = 2;
                    skip = true;
                } else {
                    if piv == 4 {
                        let t = a53;
                        a53 = a54;
                        a54 = t;
                        let t = a33;
                        a33 = a44;
                        a44 = t;
                    } else if piv == 5 {
                        let t = a43;
                        a43 = a54;
                        a54 = t;
                        let t = a33;
                        a33 = a55;
                        a55 = t;
                    }
                    let (l4, l5, s44, s54, s55) = R::div5(
                        a43,
                        a53,
                        R::diff_prod(a44, a33, a43, a43),
                        R::diff_prod(a54, a33, a53, a43),
                        R::diff_prod(a55, a33, a53, a53),
                        a33,
                    );
                    a44 = s44;
                    a54 = s54;
                    a55 = s55;
                    a43 = l4;
                    a53 = l5;
                    pi3 = piv;
                    ps3 = 1;
                }
            }
        }
        // position 5
        if skip {
            skip = false;
        } else {
            let dabs = R::abs(a44);
            let mut imax = 5_u8;
            let mut colmax = R::abs(a54);
            if dabs == R::zero() && colmax == R::zero() {
                if zero_pivot.is_none() {
                    zero_pivot = Some(4);
                }
            } else {
                let mut piv = 4_u8;
                let mut two = false;
                let ac = alpha * colmax;
                if dabs < ac {
                    let (rowmax, dimax) = (R::abs(a54), R::abs(a55));
                    let bound = R::wide_mul_scalar(
                        R::wide_add_prod(R::wide_zero(), alpha, colmax), R::div(colmax, rowmax),
                    );
                    if dabs < bound {
                        piv = imax;
                        if dimax < alpha * rowmax {
                            two = true;
                        }
                    }
                }
                if two {
                    pi4 = piv;
                    ps4 = 2;
                    pi5 = piv;
                    ps5 = 2;
                    skip = true;
                } else {
                    if piv == 5 {
                        let t = a44;
                        a44 = a55;
                        a55 = t;
                    }
                    let l5 = R::div(a54, a44);
                    let s55 = R::div(R::diff_prod(a55, a44, a54, a54), a44);
                    a55 = s55;
                    a54 = l5;
                    pi4 = piv;
                    ps4 = 1;
                }
            }
        }
        // position 6
        if !skip && a55 == R::zero() && zero_pivot.is_none() {
            zero_pivot = Some(5);
        }
        Lblt6 {
            matrix: Matrix6 {
                m11: a00,
                m21: a10,
                m31: a20,
                m41: a30,
                m51: a40,
                m61: a50,
                m12: matrix.m12,
                m22: a11,
                m32: a21,
                m42: a31,
                m52: a41,
                m62: a51,
                m13: matrix.m13,
                m23: matrix.m23,
                m33: a22,
                m43: a32,
                m53: a42,
                m63: a52,
                m14: matrix.m14,
                m24: matrix.m24,
                m34: matrix.m34,
                m44: a33,
                m54: a43,
                m64: a53,
                m15: matrix.m15,
                m25: matrix.m25,
                m35: matrix.m35,
                m45: matrix.m45,
                m55: a44,
                m65: a54,
                m16: matrix.m16,
                m26: matrix.m26,
                m36: matrix.m36,
                m46: matrix.m46,
                m56: matrix.m56,
                m66: a55,
            },
            p1: (pi0, ps0),
            p2: (pi1, ps1),
            p3: (pi2, ps2),
            p4: (pi3, ps3),
            p5: (pi4, ps4),
            p6: (pi5, ps5),
            zero_pivot,
        }
    }

    /// The block diagonal matrix `B`. Exact: moves. Upstream: `LBLT::d`.
    fn d(self: Lblt6<T>) -> Matrix6<T> {
        let (_, s0) = self.p1;
        let two0 = s0 == 2;
        let (_, s1) = self.p2;
        let two1 = s1 == 2;
        let (_, s2) = self.p3;
        let two2 = s2 == 2;
        let (_, s3) = self.p4;
        let two3 = s3 == 2;
        let (_, s4) = self.p5;
        let two4 = s4 == 2;
        let st0 = true;
        let st1 = !(st0 && two0);
        let st2 = !(st1 && two1);
        let st3 = !(st2 && two2);
        let st4 = !(st3 && two3);
        let o0 = if st0 && two0 {
            self.matrix.m21
        } else {
            R::zero()
        };
        let o1 = if st1 && two1 {
            self.matrix.m32
        } else {
            R::zero()
        };
        let o2 = if st2 && two2 {
            self.matrix.m43
        } else {
            R::zero()
        };
        let o3 = if st3 && two3 {
            self.matrix.m54
        } else {
            R::zero()
        };
        let o4 = if st4 && two4 {
            self.matrix.m65
        } else {
            R::zero()
        };
        Matrix6 {
            m11: self.matrix.m11,
            m21: o0,
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m61: R::zero(),
            m12: o0,
            m22: self.matrix.m22,
            m32: o1,
            m42: R::zero(),
            m52: R::zero(),
            m62: R::zero(),
            m13: R::zero(),
            m23: o1,
            m33: self.matrix.m33,
            m43: o2,
            m53: R::zero(),
            m63: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: o2,
            m44: self.matrix.m44,
            m54: o3,
            m64: R::zero(),
            m15: R::zero(),
            m25: R::zero(),
            m35: R::zero(),
            m45: o3,
            m55: self.matrix.m55,
            m65: o4,
            m16: R::zero(),
            m26: R::zero(),
            m36: R::zero(),
            m46: R::zero(),
            m56: o4,
            m66: self.matrix.m66,
        }
    }

    /// The permutation-aware factor `Pᵀ L` (`A = (Pᵀ L) B (Pᵀ L)ᵀ`; not lower triangular in
    /// general). Exact: every entry is a stored multiplier, `1` or `0` (upstream's products are
    /// by `0` and `1` too), placed by the recorded interchanges. Upstream: `LBLT::l_permuted`.
    fn l_permuted(self: Lblt6<T>) -> Matrix6<T> {
        let (p, l) = Lblt6InternalTrait::factors(self);
        let mut m = l;
        PermuteRows::inv_permute_rows(p, ref m);
        m
    }

    /// Overwrites `b` (any shape with 6 rows) with the solution of `A x = b` and returns `true`,
    /// or returns `false` (and leaves `b` unchanged) when a column was exactly zero
    /// (`zero_pivot`). `x = Pᵀ L⁻ᵀ B⁻¹ L⁻¹ P b`: permutation (moves), unit lower solve,
    /// `B⁻¹ y`
    /// as upstream's per-block formula (`y_k / b_kk`, or `(c y_k - b y_k1) / det` and `(a y_k1 - b
    /// y_k) / det`: one exact numerator and one correctly rounded quotient per entry), the unit
    /// upper solve as a unit lower one on the reversed order (moves), the inverse permutation.
    /// Upstream interleaves the same steps (`LBLT::solve_mut`); the sums are fused here. Panics on
    /// overflow.
    fn solve_mut<B, impl P: PermuteRows<Perm6, B>, impl K: SolveKernel<Matrix6<T>, B>, +Drop<B>>(
        self: Lblt6<T>, ref b: B,
    ) -> bool {
        if self.zero_pivot.is_some() {
            return false;
        }
        let (p, l) = Lblt6InternalTrait::factors(self);
        let j = Perm6 { p1: 6, p2: 5, p3: 4, p4: 4, p5: 5 };
        P::permute_rows(p, ref b);
        b = K::lower_unit(l, b);
        let (adj, g) = Lblt6InternalTrait::d_parts(self);
        b = K::upper(g, K::tr_mul_rhs(adj, b));
        P::permute_rows(j, ref b);
        b =
            K::lower_unit(
                Matrix6 {
                    m11: R::one(),
                    m21: l.m65,
                    m31: l.m64,
                    m41: l.m63,
                    m51: l.m62,
                    m61: l.m61,
                    m12: R::zero(),
                    m22: R::one(),
                    m32: l.m54,
                    m42: l.m53,
                    m52: l.m52,
                    m62: l.m51,
                    m13: R::zero(),
                    m23: R::zero(),
                    m33: R::one(),
                    m43: l.m43,
                    m53: l.m42,
                    m63: l.m41,
                    m14: R::zero(),
                    m24: R::zero(),
                    m34: R::zero(),
                    m44: R::one(),
                    m54: l.m32,
                    m64: l.m31,
                    m15: R::zero(),
                    m25: R::zero(),
                    m35: R::zero(),
                    m45: R::zero(),
                    m55: R::one(),
                    m65: l.m21,
                    m16: R::zero(),
                    m26: R::zero(),
                    m36: R::zero(),
                    m46: R::zero(),
                    m56: R::zero(),
                    m66: R::one(),
                },
                b,
            );
        P::permute_rows(j, ref b);
        P::inv_permute_rows(p, ref b);
        true
    }

    /// The solution of `A x = b` for any `b` with 6 rows, or `None` when a column was exactly
    /// zero: `solve_mut` on a copy. Upstream: `LBLT::solve`.
    fn solve<B, impl P: PermuteRows<Perm6, B>, impl K: SolveKernel<Matrix6<T>, B>, +Drop<B>>(
        self: Lblt6<T>, b: B,
    ) -> Option<B> {
        let mut x = b;
        if Self::solve_mut(self, ref x) {
            Some(x)
        } else {
            None
        }
    }

    /// The determinant: the product of the 1x1 pivots and of the 2x2 block determinants (`a c -
    /// b²`, one fused floor each), in position order, one floor per product. Panics on overflow of
    /// a partial product. Upstream: `LBLT::determinant`.
    fn determinant(self: Lblt6<T>) -> T {
        let (_, s0) = self.p1;
        let two0 = s0 == 2;
        let (_, s1) = self.p2;
        let two1 = s1 == 2;
        let (_, s2) = self.p3;
        let two2 = s2 == 2;
        let (_, s3) = self.p4;
        let two3 = s3 == 2;
        let (_, s4) = self.p5;
        let two4 = s4 == 2;
        let st0 = true;
        let st1 = !(st0 && two0);
        let st2 = !(st1 && two1);
        let st3 = !(st2 && two2);
        let st4 = !(st3 && two3);
        let st5 = !(st4 && two4);
        let mut det = if two0 {
            R::diff_prod(self.matrix.m11, self.matrix.m22, self.matrix.m21, self.matrix.m21)
        } else {
            self.matrix.m11
        };
        if st1 {
            det = det
                * (if two1 {
                    R::diff_prod(self.matrix.m22, self.matrix.m33, self.matrix.m32, self.matrix.m32)
                } else {
                    self.matrix.m22
                });
        }
        if st2 {
            det = det
                * (if two2 {
                    R::diff_prod(self.matrix.m33, self.matrix.m44, self.matrix.m43, self.matrix.m43)
                } else {
                    self.matrix.m33
                });
        }
        if st3 {
            det = det
                * (if two3 {
                    R::diff_prod(self.matrix.m44, self.matrix.m55, self.matrix.m54, self.matrix.m54)
                } else {
                    self.matrix.m44
                });
        }
        if st4 {
            det = det
                * (if two4 {
                    R::diff_prod(self.matrix.m55, self.matrix.m66, self.matrix.m65, self.matrix.m65)
                } else {
                    self.matrix.m55
                });
        }
        if st5 {
            det = det * (self.matrix.m66);
        }
        det
    }
}

/// Crate-internal kernels of `Lblt6<T>`: the factors in the permuted basis.
#[generate_trait]
pub(crate) impl Lblt6InternalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Lblt6InternalTrait<T> {
    /// `(P, L)`: the recorded interchanges as one `Perm6` (a 1x1 block at `k` swaps `k`, a 2x2
    /// block swaps `k + 1`, in increasing order) and the unit lower `L` of `P A Pᵀ = L B Lᵀ`
    /// (each column's multipliers, permuted by the later interchanges). Moves only.
    fn factors(self: Lblt6<T>) -> (Perm6, Matrix6<T>) {
        revoke_ap_tracking();
        let (i0, s0) = self.p1;
        let two0 = s0 == 2;
        let (i1, s1) = self.p2;
        let two1 = s1 == 2;
        let (i2, s2) = self.p3;
        let two2 = s2 == 2;
        let (i3, s3) = self.p4;
        let two3 = s3 == 2;
        let (i4, s4) = self.p5;
        let two4 = s4 == 2;
        let st0 = true;
        let st1 = !(st0 && two0);
        let st2 = !(st1 && two1);
        let st3 = !(st2 && two2);
        let st4 = !(st3 && two3);
        let st5 = !(st4 && two4);
        let mut l10 = R::zero();
        let mut l20 = R::zero();
        let mut l30 = R::zero();
        let mut l40 = R::zero();
        let mut l50 = R::zero();
        let mut l21 = R::zero();
        let mut l31 = R::zero();
        let mut l41 = R::zero();
        let mut l51 = R::zero();
        let mut l32 = R::zero();
        let mut l42 = R::zero();
        let mut l52 = R::zero();
        let mut l43 = R::zero();
        let mut l53 = R::zero();
        let mut l54 = R::zero();
        let mut q1 = 1_u8;
        let mut q2 = 2_u8;
        let mut q3 = 3_u8;
        let mut q4 = 4_u8;
        let mut q5 = 5_u8;
        if st0 {
            if two0 {
                if i0 == 2 {} else if i0 == 3 {} else if i0 == 4 {} else if i0 == 5 {}
                q2 = i0 + 1;
                l20 = self.matrix.m31;
                l21 = self.matrix.m32;
                l30 = self.matrix.m41;
                l31 = self.matrix.m42;
                l40 = self.matrix.m51;
                l41 = self.matrix.m52;
                l50 = self.matrix.m61;
                l51 = self.matrix.m62;
            } else {
                if i0 == 1 {} else if i0 == 2 {} else if i0 == 3 {} else if i0 == 4 {} else if i0 == 5 {}
                q1 = i0 + 1;
                l10 = self.matrix.m21;
                l20 = self.matrix.m31;
                l30 = self.matrix.m41;
                l40 = self.matrix.m51;
                l50 = self.matrix.m61;
            }
        }
        if st1 {
            if two1 {
                if i1 == 3 {
                    let t = l20;
                    l20 = l30;
                    l30 = t;
                } else if i1 == 4 {
                    let t = l20;
                    l20 = l40;
                    l40 = t;
                } else if i1 == 5 {
                    let t = l20;
                    l20 = l50;
                    l50 = t;
                }
                q3 = i1 + 1;
                l31 = self.matrix.m42;
                l32 = self.matrix.m43;
                l41 = self.matrix.m52;
                l42 = self.matrix.m53;
                l51 = self.matrix.m62;
                l52 = self.matrix.m63;
            } else {
                if i1 == 2 {
                    let t = l10;
                    l10 = l20;
                    l20 = t;
                } else if i1 == 3 {
                    let t = l10;
                    l10 = l30;
                    l30 = t;
                } else if i1 == 4 {
                    let t = l10;
                    l10 = l40;
                    l40 = t;
                } else if i1 == 5 {
                    let t = l10;
                    l10 = l50;
                    l50 = t;
                }
                q2 = i1 + 1;
                l21 = self.matrix.m32;
                l31 = self.matrix.m42;
                l41 = self.matrix.m52;
                l51 = self.matrix.m62;
            }
        }
        if st2 {
            if two2 {
                if i2 == 4 {
                    let t = l30;
                    l30 = l40;
                    l40 = t;
                    let t = l31;
                    l31 = l41;
                    l41 = t;
                } else if i2 == 5 {
                    let t = l30;
                    l30 = l50;
                    l50 = t;
                    let t = l31;
                    l31 = l51;
                    l51 = t;
                }
                q4 = i2 + 1;
                l42 = self.matrix.m53;
                l43 = self.matrix.m54;
                l52 = self.matrix.m63;
                l53 = self.matrix.m64;
            } else {
                if i2 == 3 {
                    let t = l20;
                    l20 = l30;
                    l30 = t;
                    let t = l21;
                    l21 = l31;
                    l31 = t;
                } else if i2 == 4 {
                    let t = l20;
                    l20 = l40;
                    l40 = t;
                    let t = l21;
                    l21 = l41;
                    l41 = t;
                } else if i2 == 5 {
                    let t = l20;
                    l20 = l50;
                    l50 = t;
                    let t = l21;
                    l21 = l51;
                    l51 = t;
