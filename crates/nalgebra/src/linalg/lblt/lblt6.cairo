    /// `B⁻¹ = G⁻¹ adj(B)` as the pair `(adj(B), G)`: the adjugate of each block (`1` for a
    /// 1x1 block, `[[c, -b], [-b, a]]` for a 2x2 one) and the diagonal `G` of the divisors (`b_kk`,
    /// or the block determinant `a c - b²`, one fused floor): upstream's `(b_k d22 - b_k1 d21) /
    /// det`
    /// with an exact numerator. Moves and one fused sum per 2x2 block.
    fn d_parts(self: Lblt6<T>) -> (Matrix6<T>, Matrix6<T>) {
        let (_, s0) = self.p1;
        let two0 = s0 == 2;
        let (_, s1) = self.p2;
        let two1 = s1 == 2;
        let (_, s2) = self.p3;
        let two2 = s2 == 2;
        let (_, s3) = self.p4;
        let two3 = s3 == 2;
        let (_, s4) = self.p5;
        let two4 = s4 == 2;
        let st0 = true;
        let st1 = !(st0 && two0);
        let st2 = !(st1 && two1);
        let st3 = !(st2 && two2);
        let st4 = !(st3 && two3);
        let st5 = !(st4 && two4);
        let mut e00 = R::zero();
        let mut e10 = R::zero();
        let mut e20 = R::zero();
        let mut e30 = R::zero();
        let mut e40 = R::zero();
        let mut e50 = R::zero();
        let mut e11 = R::zero();
        let mut e21 = R::zero();
        let mut e31 = R::zero();
        let mut e41 = R::zero();
        let mut e51 = R::zero();
        let mut e22 = R::zero();
        let mut e32 = R::zero();
        let mut e42 = R::zero();
        let mut e52 = R::zero();
        let mut e33 = R::zero();
        let mut e43 = R::zero();
        let mut e53 = R::zero();
        let mut e44 = R::zero();
        let mut e54 = R::zero();
        let mut e55 = R::zero();
        let mut g0 = self.matrix.m11;
        let mut g1 = self.matrix.m22;
        let mut g2 = self.matrix.m33;
        let mut g3 = self.matrix.m44;
        let mut g4 = self.matrix.m55;
        let mut g5 = self.matrix.m66;
        if st0 {
            if two0 {
                let det = R::diff_prod(
                    self.matrix.m11, self.matrix.m22, self.matrix.m21, self.matrix.m21,
                );
                e00 = self.matrix.m22;
                e11 = self.matrix.m11;
                e10 = -self.matrix.m21;
                g0 = det;
                g1 = det;
            } else {
                e00 = R::one();
            }
        }
        if st1 {
            if two1 {
                let det = R::diff_prod(
                    self.matrix.m22, self.matrix.m33, self.matrix.m32, self.matrix.m32,
                );
                e11 = self.matrix.m33;
                e22 = self.matrix.m22;
                e21 = -self.matrix.m32;
                g1 = det;
                g2 = det;
            } else {
                e11 = R::one();
            }
        }
        if st2 {
            if two2 {
                let det = R::diff_prod(
                    self.matrix.m33, self.matrix.m44, self.matrix.m43, self.matrix.m43,
                );
                e22 = self.matrix.m44;
                e33 = self.matrix.m33;
                e32 = -self.matrix.m43;
                g2 = det;
                g3 = det;
            } else {
                e22 = R::one();
            }
        }
        if st3 {
            if two3 {
                let det = R::diff_prod(
                    self.matrix.m44, self.matrix.m55, self.matrix.m54, self.matrix.m54,
                );
                e33 = self.matrix.m55;
                e44 = self.matrix.m44;
                e43 = -self.matrix.m54;
                g3 = det;
                g4 = det;
            } else {
                e33 = R::one();
            }
        }
        if st4 {
            if two4 {
                let det = R::diff_prod(
                    self.matrix.m55, self.matrix.m66, self.matrix.m65, self.matrix.m65,
                );
                e44 = self.matrix.m66;
                e55 = self.matrix.m55;
                e54 = -self.matrix.m65;
                g4 = det;
                g5 = det;
            } else {
                e44 = R::one();
            }
        }
        if st5 {
            e55 = R::one();
        }
        (
            Matrix6 {
                m11: e00,
                m21: e10,
                m31: e20,
                m41: e30,
                m51: e40,
                m61: e50,
                m12: e10,
                m22: e11,
                m32: e21,
                m42: e31,
                m52: e41,
                m62: e51,
                m13: e20,
                m23: e21,
                m33: e22,
                m43: e32,
                m53: e42,
                m63: e52,
                m14: e30,
                m24: e31,
                m34: e32,
                m44: e33,
                m54: e43,
                m64: e53,
                m15: e40,
                m25: e41,
                m35: e42,
                m45: e43,
                m55: e44,
                m65: e54,
                m16: e50,
                m26: e51,
                m36: e52,
                m46: e53,
                m56: e54,
                m66: e55,
            },
            Matrix6 {
                m11: g0,
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m51: R::zero(),
                m61: R::zero(),
                m12: R::zero(),
                m22: g1,
                m32: R::zero(),
                m42: R::zero(),
                m52: R::zero(),
                m62: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: g2,
                m43: R::zero(),
                m53: R::zero(),
                m63: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
                m44: g3,
                m54: R::zero(),
                m64: R::zero(),
                m15: R::zero(),
                m25: R::zero(),
                m35: R::zero(),
                m45: R::zero(),
                m55: g4,
                m65: R::zero(),
                m16: R::zero(),
                m26: R::zero(),
                m36: R::zero(),
                m46: R::zero(),
                m56: R::zero(),
                m66: g5,
            },
        )
    }
}

/// `Matrix6` methods that go through the `LBLᵀ` factorisation. Import `Matrix6LbltTrait`.
#[generate_trait]
pub impl Matrix6LbltImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix6LbltTrait<T> {
    /// The Bunch-Kaufman `LBLᵀ` factorisation (lower triangle read). Upstream:
    /// `SquareMatrix::lblt`.
    #[inline(always)]
    fn lblt(self: Matrix6<T>) -> Lblt6<T> {
        Lblt6Trait::new(self)
    }
}
