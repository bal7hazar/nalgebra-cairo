        if st5 {}
        (
            Perm6 { p1: q1, p2: q2, p3: q3, p4: q4, p5: q5 },
            Matrix6 {
                m11: R::one(),
                m21: l10,
                m31: l20,
                m41: l30,
                m51: l40,
                m61: l50,
                m12: R::zero(),
                m22: R::one(),
                m32: l21,
                m42: l31,
                m52: l41,
                m62: l51,
