                    l30 = t;
                }
                q3 = i1 + 1;
                l31 = self.matrix.m42;
                l32 = self.matrix.m43;
            } else {
                if i1 == 2 {
                    let t = l10;
                    l10 = l20;
                    l20 = t;
                } else if i1 == 3 {
                    let t = l10;
                    l10 = l30;
                    l30 = t;
                }
                q2 = i1 + 1;
                l21 = self.matrix.m32;
                l31 = self.matrix.m42;
            }
        }
        if st2 {
            if two2 {} else {
                if i2 == 3 {
                    let t = l20;
                    l20 = l30;
                    l30 = t;
                    let t = l21;
                    l21 = l31;
                    l31 = t;
                }
                q3 = i2 + 1;
                l32 = self.matrix.m43;
            }
        }
        if st3 {}
        (
            Perm4 { p1: q1, p2: q2, p3: q3 },
            Matrix4 {
                m11: R::one(),
                m21: l10,
                m31: l20,
                m41: l30,
                m12: R::zero(),
                m22: R::one(),
                m32: l21,
                m42: l31,
                m13: R::zero(),
                m23: R::zero(),
                m33: R::one(),
                m43: l32,
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
                m44: R::one(),
            },
        )
    }

    /// `B⁻¹`: `1 / b_kk` on the 1x1 blocks, upstream's scaled inverse `[[d11, -s], [-s, d22]] /
    /// e`
    /// on the 2x2 ones (`d = |b|`, `s = sign(b)`, `e = d (d11 d22 - 1)`: no product of two entries
    /// is ever formed). Correctly rounded quotients.
    fn d_inv(self: Lblt4<T>) -> Matrix4<T> {
        let (_, s0) = self.p1;
        let two0 = s0 == 2;
        let (_, s1) = self.p2;
        let two1 = s1 == 2;
        let (_, s2) = self.p3;
        let two2 = s2 == 2;
        let st0 = true;
        let st1 = !(st0 && two0);
        let st2 = !(st1 && two1);
        let st3 = !(st2 && two2);
        let mut e00 = R::zero();
        let mut e10 = R::zero();
        let mut e20 = R::zero();
        let mut e30 = R::zero();
        let mut e11 = R::zero();
        let mut e21 = R::zero();
        let mut e31 = R::zero();
        let mut e22 = R::zero();
        let mut e32 = R::zero();
        let mut e33 = R::zero();
        if st0 {
            if two0 {
                let d = R::abs(self.matrix.m21);
                let d11 = R::div(self.matrix.m22, d);
                let d22 = R::div(self.matrix.m11, d);
                let e = d * R::mul_add(d11, d22, -R::one());
                let ms = if self.matrix.m21 < R::zero() {
                    R::one()
                } else {
                    -R::one()
                };
                let (x0, x1, x2) = R::div3(d11, d22, ms, e);
                e00 = x0;
                e11 = x1;
                e10 = x2;
            } else {
                e00 = R::recip(self.matrix.m11);
            }
        }
        if st1 {
            if two1 {
                let d = R::abs(self.matrix.m32);
                let d11 = R::div(self.matrix.m33, d);
                let d22 = R::div(self.matrix.m22, d);
                let e = d * R::mul_add(d11, d22, -R::one());
                let ms = if self.matrix.m32 < R::zero() {
                    R::one()
                } else {
                    -R::one()
                };
                let (x0, x1, x2) = R::div3(d11, d22, ms, e);
                e11 = x0;
                e22 = x1;
                e21 = x2;
            } else {
                e11 = R::recip(self.matrix.m22);
            }
        }
        if st2 {
            if two2 {
                let d = R::abs(self.matrix.m43);
                let d11 = R::div(self.matrix.m44, d);
                let d22 = R::div(self.matrix.m33, d);
                let e = d * R::mul_add(d11, d22, -R::one());
                let ms = if self.matrix.m43 < R::zero() {
                    R::one()
                } else {
                    -R::one()
                };
                let (x0, x1, x2) = R::div3(d11, d22, ms, e);
                e22 = x0;
                e33 = x1;
                e32 = x2;
            } else {
                e22 = R::recip(self.matrix.m33);
            }
        }
        if st3 {
            e33 = R::recip(self.matrix.m44);
        }
        Matrix4 {
            m11: e00,
            m21: e10,
            m31: e20,
            m41: e30,
            m12: e10,
            m22: e11,
            m32: e21,
            m42: e31,
            m13: e20,
            m23: e21,
            m33: e22,
            m43: e32,
            m14: e30,
            m24: e31,
            m34: e32,
            m44: e33,
        }
    }
}

/// `Matrix4` methods that go through the `LBLᵀ` factorisation. Import `Matrix4LbltTrait`.
#[generate_trait]
pub impl Matrix4LbltImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix4LbltTrait<T> {
    /// The Bunch-Kaufman `LBLᵀ` factorisation (lower triangle read). Upstream:
    /// `SquareMatrix::lblt`.
    #[inline(always)]
    fn lblt(self: Matrix4<T>) -> Lblt4<T> {
        Lblt4Trait::new(self)
    }
}
