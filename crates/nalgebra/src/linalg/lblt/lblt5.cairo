            }
        }
        let _ = skip;
        let _ = alpha;
        Lblt5 {
            matrix: Matrix5 {
                m11: a00,
                m21: a10,
                m31: a20,
                m41: a30,
                m51: a40,
                m12: matrix.m12,
                m22: a11,
                m32: a21,
                m42: a31,
                m52: a41,
                m13: matrix.m13,
                m23: matrix.m23,
                m33: a22,
                m43: a32,
                m53: a42,
                m14: matrix.m14,
                m24: matrix.m24,
                m34: matrix.m34,
                m44: a33,
                m54: a43,
                m15: matrix.m15,
                m25: matrix.m25,
                m35: matrix.m35,
                m45: matrix.m45,
                m55: a44,
            },
            p1: (pi0, ps0),
            p2: (pi1, ps1),
            p3: (pi2, ps2),
            p4: (pi3, ps3),
            p5: (pi4, ps4),
            zero_pivot,
        }
    }

    /// The block diagonal matrix `B`. Exact: moves. Upstream: `LBLT::d`.
    fn d(self: Lblt5<T>) -> Matrix5<T> {
        let (_, s0) = self.p1;
        let two0 = s0 == 2;
        let (_, s1) = self.p2;
        let two1 = s1 == 2;
        let (_, s2) = self.p3;
        let two2 = s2 == 2;
        let (_, s3) = self.p4;
        let two3 = s3 == 2;
        let st0 = true;
        let st1 = !(st0 && two0);
        let st2 = !(st1 && two1);
        let st3 = !(st2 && two2);
        let o0 = if st0 && two0 {
            self.matrix.m21
        } else {
            R::zero()
        };
        let o1 = if st1 && two1 {
            self.matrix.m32
        } else {
            R::zero()
        };
        let o2 = if st2 && two2 {
            self.matrix.m43
        } else {
            R::zero()
        };
        let o3 = if st3 && two3 {
            self.matrix.m54
        } else {
            R::zero()
        };
        Matrix5 {
            m11: self.matrix.m11,
            m21: o0,
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: o0,
            m22: self.matrix.m22,
            m32: o1,
            m42: R::zero(),
            m52: R::zero(),
            m13: R::zero(),
            m23: o1,
            m33: self.matrix.m33,
            m43: o2,
            m53: R::zero(),
            m14: R::zero(),
            m24: R::zero(),
            m34: o2,
            m44: self.matrix.m44,
            m54: o3,
            m15: R::zero(),
            m25: R::zero(),
            m35: R::zero(),
            m45: o3,
            m55: self.matrix.m55,
        }
    }

    /// The permutation-aware factor `Pᵀ L` (`A = (Pᵀ L) B (Pᵀ L)ᵀ`; not lower triangular in
    /// general). Exact: every entry is a stored multiplier, `1` or `0` (upstream's products are
    /// by `0` and `1` too), placed by the recorded interchanges. Upstream: `LBLT::l_permuted`.
    fn l_permuted(self: Lblt5<T>) -> Matrix5<T> {
        let (p, l) = Lblt5InternalTrait::factors(self);
        let mut m = l;
        PermuteRows::inv_permute_rows(p, ref m);
        m
    }

    /// Overwrites `b` (any shape with 5 rows) with the solution of `A x = b` and returns `true`,
    /// or returns `false` (and leaves `b` unchanged) when a column was exactly zero
    /// (`zero_pivot`). `x = Pᵀ L⁻ᵀ B⁻¹ L⁻¹ P b`: permutation (moves), unit lower solve,
    /// `B⁻¹ y`
    /// as upstream's per-block formula (`y_k / b_kk`, or `(c y_k - b y_k1) / det` and `(a y_k1 - b
    /// y_k) / det`: one exact numerator and one correctly rounded quotient per entry), the unit
    /// upper solve as a unit lower one on the reversed order (moves), the inverse permutation.
    /// Upstream interleaves the same steps (`LBLT::solve_mut`); the sums are fused here. Panics on
    /// overflow.
    fn solve_mut<B, impl P: PermuteRows<Perm5, B>, impl K: SolveKernel<Matrix5<T>, B>, +Drop<B>>(
        self: Lblt5<T>, ref b: B,
    ) -> bool {
        if self.zero_pivot.is_some() {
            return false;
        }
        let (p, l) = Lblt5InternalTrait::factors(self);
        let j = Perm5 { p1: 5, p2: 4, p3: 3, p4: 4 };
        P::permute_rows(p, ref b);
        b = K::lower_unit(l, b);
        let (adj, g) = Lblt5InternalTrait::d_parts(self);
        b = K::upper(g, K::tr_mul_rhs(adj, b));
        P::permute_rows(j, ref b);
        b =
            K::lower_unit(
                Matrix5 {
                    m11: R::one(),
                    m21: l.m54,
                    m31: l.m53,
                    m41: l.m52,
                    m51: l.m51,
                    m12: R::zero(),
                    m22: R::one(),
                    m32: l.m43,
                    m42: l.m42,
                    m52: l.m41,
                    m13: R::zero(),
                    m23: R::zero(),
                    m33: R::one(),
                    m43: l.m32,
                    m53: l.m31,
                    m14: R::zero(),
                    m24: R::zero(),
                    m34: R::zero(),
                    m44: R::one(),
                    m54: l.m21,
                    m15: R::zero(),
                    m25: R::zero(),
                    m35: R::zero(),
                    m45: R::zero(),
                    m55: R::one(),
                },
                b,
            );
        P::permute_rows(j, ref b);
        P::inv_permute_rows(p, ref b);
        true
    }

    /// The solution of `A x = b` for any `b` with 5 rows, or `None` when a column was exactly
    /// zero: `solve_mut` on a copy. Upstream: `LBLT::solve`.
    fn solve<B, impl P: PermuteRows<Perm5, B>, impl K: SolveKernel<Matrix5<T>, B>, +Drop<B>>(
        self: Lblt5<T>, b: B,
    ) -> Option<B> {
        let mut x = b;
        if Self::solve_mut(self, ref x) {
            Some(x)
        } else {
            None
        }
    }

    /// The determinant: the product of the 1x1 pivots and of the 2x2 block determinants (`a c -
    /// b²`, one fused floor each), in position order, one floor per product. Panics on overflow of
    /// a partial product. Upstream: `LBLT::determinant`.
    fn determinant(self: Lblt5<T>) -> T {
        let (_, s0) = self.p1;
        let two0 = s0 == 2;
        let (_, s1) = self.p2;
        let two1 = s1 == 2;
        let (_, s2) = self.p3;
        let two2 = s2 == 2;
        let (_, s3) = self.p4;
        let two3 = s3 == 2;
        let st0 = true;
        let st1 = !(st0 && two0);
        let st2 = !(st1 && two1);
        let st3 = !(st2 && two2);
        let st4 = !(st3 && two3);
        let mut det = if two0 {
            R::diff_prod(self.matrix.m11, self.matrix.m22, self.matrix.m21, self.matrix.m21)
        } else {
            self.matrix.m11
        };
        if st1 {
            det = det
                * (if two1 {
                    R::diff_prod(self.matrix.m22, self.matrix.m33, self.matrix.m32, self.matrix.m32)
                } else {
                    self.matrix.m22
                });
        }
        if st2 {
            det = det
                * (if two2 {
                    R::diff_prod(self.matrix.m33, self.matrix.m44, self.matrix.m43, self.matrix.m43)
                } else {
                    self.matrix.m33
                });
        }
        if st3 {
            det = det
                * (if two3 {
                    R::diff_prod(self.matrix.m44, self.matrix.m55, self.matrix.m54, self.matrix.m54)
                } else {
                    self.matrix.m44
                });
        }
        if st4 {
            det = det * (self.matrix.m55);
        }
        det
    }
}

/// Crate-internal kernels of `Lblt5<T>`: the factors in the permuted basis.
#[generate_trait]
pub(crate) impl Lblt5InternalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Lblt5InternalTrait<T> {
    /// `(P, L)`: the recorded interchanges as one `Perm5` (a 1x1 block at `k` swaps `k`, a 2x2
    /// block swaps `k + 1`, in increasing order) and the unit lower `L` of `P A Pᵀ = L B Lᵀ`
    /// (each column's multipliers, permuted by the later interchanges). Moves only.
    fn factors(self: Lblt5<T>) -> (Perm5, Matrix5<T>) {
        revoke_ap_tracking();
        let (i0, s0) = self.p1;
        let two0 = s0 == 2;
        let (i1, s1) = self.p2;
        let two1 = s1 == 2;
        let (i2, s2) = self.p3;
        let two2 = s2 == 2;
        let (i3, s3) = self.p4;
        let two3 = s3 == 2;
        let st0 = true;
        let st1 = !(st0 && two0);
        let st2 = !(st1 && two1);
        let st3 = !(st2 && two2);
        let st4 = !(st3 && two3);
        let mut l10 = R::zero();
        let mut l20 = R::zero();
        let mut l30 = R::zero();
        let mut l40 = R::zero();
        let mut l21 = R::zero();
        let mut l31 = R::zero();
        let mut l41 = R::zero();
        let mut l32 = R::zero();
        let mut l42 = R::zero();
        let mut l43 = R::zero();
        let mut q1 = 1_u8;
        let mut q2 = 2_u8;
        let mut q3 = 3_u8;
        let mut q4 = 4_u8;
        if st0 {
            if two0 {
                if i0 == 2 {} else if i0 == 3 {} else if i0 == 4 {}
                q2 = i0 + 1;
                l20 = self.matrix.m31;
                l21 = self.matrix.m32;
                l30 = self.matrix.m41;
                l31 = self.matrix.m42;
                l40 = self.matrix.m51;
                l41 = self.matrix.m52;
            } else {
                if i0 == 1 {} else if i0 == 2 {} else if i0 == 3 {} else if i0 == 4 {}
                q1 = i0 + 1;
                l10 = self.matrix.m21;
                l20 = self.matrix.m31;
                l30 = self.matrix.m41;
                l40 = self.matrix.m51;
            }
        }
        if st1 {
            if two1 {
                if i1 == 3 {
                    let t = l20;
                    l20 = l30;
                    l30 = t;
                } else if i1 == 4 {
                    let t = l20;
                    l20 = l40;
                    l40 = t;
                }
                q3 = i1 + 1;
                l31 = self.matrix.m42;
                l32 = self.matrix.m43;
                l41 = self.matrix.m52;
                l42 = self.matrix.m53;
            } else {
                if i1 == 2 {
                    let t = l10;
                    l10 = l20;
                    l20 = t;
                } else if i1 == 3 {
                    let t = l10;
                    l10 = l30;
                    l30 = t;
                } else if i1 == 4 {
                    let t = l10;
                    l10 = l40;
                    l40 = t;
                }
                q2 = i1 + 1;
                l21 = self.matrix.m32;
                l31 = self.matrix.m42;
                l41 = self.matrix.m52;
            }
        }
        if st2 {
            if two2 {
                if i2 == 4 {
                    let t = l30;
                    l30 = l40;
                    l40 = t;
                    let t = l31;
                    l31 = l41;
                    l41 = t;
                }
                q4 = i2 + 1;
                l42 = self.matrix.m53;
                l43 = self.matrix.m54;
            } else {
                if i2 == 3 {
                    let t = l20;
                    l20 = l30;
                    l30 = t;
                    let t = l21;
                    l21 = l31;
                    l31 = t;
                } else if i2 == 4 {
                    let t = l20;
                    l20 = l40;
                    l40 = t;
                    let t = l21;
                    l21 = l41;
                    l41 = t;
                }
                q3 = i2 + 1;
                l32 = self.matrix.m43;
                l42 = self.matrix.m53;
            }
        }
        if st3 {
            if two3 {} else {
                if i3 == 4 {
                    let t = l30;
                    l30 = l40;
                    l40 = t;
                    let t = l31;
                    l31 = l41;
                    l41 = t;
                    let t = l32;
                    l32 = l42;
                    l42 = t;
                }
                q4 = i3 + 1;
                l43 = self.matrix.m54;
            }
        }
        if st4 {}
        (
            Perm5 { p1: q1, p2: q2, p3: q3, p4: q4 },
            Matrix5 {
                m11: R::one(),
                m21: l10,
                m31: l20,
                m41: l30,
                m51: l40,
                m12: R::zero(),
                m22: R::one(),
                m32: l21,
                m42: l31,
                m52: l41,
                m13: R::zero(),
                m23: R::zero(),
                m33: R::one(),
                m43: l32,
                m53: l42,
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
                m44: R::one(),
                m54: l43,
                m15: R::zero(),
                m25: R::zero(),
                m35: R::zero(),
                m45: R::zero(),
                m55: R::one(),
            },
        )
    }

    /// `B⁻¹ = G⁻¹ adj(B)` as the pair `(adj(B), G)`: the adjugate of each block (`1` for a
    /// 1x1 block, `[[c, -b], [-b, a]]` for a 2x2 one) and the diagonal `G` of the divisors (`b_kk`,
    /// or the block determinant `a c - b²`, one fused floor): upstream's `(b_k d22 - b_k1 d21) /
    /// det`
    /// with an exact numerator. Moves and one fused sum per 2x2 block.
    fn d_parts(self: Lblt5<T>) -> (Matrix5<T>, Matrix5<T>) {
        let (_, s0) = self.p1;
        let two0 = s0 == 2;
        let (_, s1) = self.p2;
        let two1 = s1 == 2;
        let (_, s2) = self.p3;
        let two2 = s2 == 2;
        let (_, s3) = self.p4;
        let two3 = s3 == 2;
        let st0 = true;
        let st1 = !(st0 && two0);
        let st2 = !(st1 && two1);
        let st3 = !(st2 && two2);
        let st4 = !(st3 && two3);
        let mut e00 = R::zero();
        let mut e10 = R::zero();
        let mut e20 = R::zero();
        let mut e30 = R::zero();
        let mut e40 = R::zero();
        let mut e11 = R::zero();
        let mut e21 = R::zero();
        let mut e31 = R::zero();
        let mut e41 = R::zero();
        let mut e22 = R::zero();
        let mut e32 = R::zero();
        let mut e42 = R::zero();
        let mut e33 = R::zero();
        let mut e43 = R::zero();
        let mut e44 = R::zero();
        let mut g0 = self.matrix.m11;
        let mut g1 = self.matrix.m22;
        let mut g2 = self.matrix.m33;
        let mut g3 = self.matrix.m44;
        let mut g4 = self.matrix.m55;
        if st0 {
            if two0 {
                let det = R::diff_prod(
                    self.matrix.m11, self.matrix.m22, self.matrix.m21, self.matrix.m21,
                );
                e00 = self.matrix.m22;
                e11 = self.matrix.m11;
                e10 = -self.matrix.m21;
                g0 = det;
                g1 = det;
            } else {
                e00 = R::one();
            }
        }
        if st1 {
            if two1 {
                let det = R::diff_prod(
                    self.matrix.m22, self.matrix.m33, self.matrix.m32, self.matrix.m32,
                );
                e11 = self.matrix.m33;
                e22 = self.matrix.m22;
                e21 = -self.matrix.m32;
                g1 = det;
                g2 = det;
            } else {
                e11 = R::one();
            }
        }
        if st2 {
            if two2 {
                let det = R::diff_prod(
                    self.matrix.m33, self.matrix.m44, self.matrix.m43, self.matrix.m43,
                );
                e22 = self.matrix.m44;
                e33 = self.matrix.m33;
                e32 = -self.matrix.m43;
                g2 = det;
                g3 = det;
            } else {
                e22 = R::one();
            }
        }
        if st3 {
            if two3 {
                let det = R::diff_prod(
                    self.matrix.m44, self.matrix.m55, self.matrix.m54, self.matrix.m54,
                );
                e33 = self.matrix.m55;
                e44 = self.matrix.m44;
                e43 = -self.matrix.m54;
                g3 = det;
                g4 = det;
            } else {
                e33 = R::one();
            }
        }
        if st4 {
            e44 = R::one();
        }
        (
            Matrix5 {
                m11: e00,
                m21: e10,
                m31: e20,
                m41: e30,
                m51: e40,
                m12: e10,
                m22: e11,
                m32: e21,
                m42: e31,
                m52: e41,
                m13: e20,
                m23: e21,
                m33: e22,
                m43: e32,
                m53: e42,
                m14: e30,
                m24: e31,
                m34: e32,
                m44: e33,
                m54: e43,
                m15: e40,
                m25: e41,
                m35: e42,
                m45: e43,
                m55: e44,
            },
            Matrix5 {
                m11: g0,
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m51: R::zero(),
                m12: R::zero(),
                m22: g1,
                m32: R::zero(),
                m42: R::zero(),
                m52: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: g2,
                m43: R::zero(),
                m53: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
                m44: g3,
                m54: R::zero(),
                m15: R::zero(),
                m25: R::zero(),
                m35: R::zero(),
                m45: R::zero(),
                m55: g4,
            },
        )
    }
}

/// `Matrix5` methods that go through the `LBLᵀ` factorisation. Import `Matrix5LbltTrait`.
#[generate_trait]
pub impl Matrix5LbltImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5LbltTrait<T> {
    /// The Bunch-Kaufman `LBLᵀ` factorisation (lower triangle read). Upstream:
    /// `SquareMatrix::lblt`.
    #[inline(always)]
    fn lblt(self: Matrix5<T>) -> Lblt5<T> {
        Lblt5Trait::new(self)
    }
}
