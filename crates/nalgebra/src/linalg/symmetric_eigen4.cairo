            l2 = l3;
            c2 = c3;
            l3 = tmp0;
            c3 = tmp1;
        }
        if l2 < l1 {
            let tmp0 = l1;
            let tmp1 = c1;
            l1 = l2;
            c1 = c2;
            l2 = tmp0;
            c2 = tmp1;
        }
        if l1 < l0 {
            let tmp0 = l0;
            let tmp1 = c0;
            l0 = l1;
            c0 = c1;
            l1 = tmp0;
            c1 = tmp1;
        }
        if l3 < l2 {
            let tmp0 = l2;
            let tmp1 = c2;
            l2 = l3;
            c2 = c3;
            l3 = tmp0;
            c3 = tmp1;
        }
        if l2 < l1 {
            let tmp0 = l1;
            let tmp1 = c1;
            l1 = l2;
            c1 = c2;
            l2 = tmp0;
            c2 = tmp1;
        }
        let c0 = Self::canonical_sign(
            {
                let (q0, q1, q2, q3) = R::div4(
                    c0.x, c0.y, c0.z, c0.w, R::norm4(c0.x, c0.y, c0.z, c0.w),
                );
                Vector4 { x: q0, y: q1, z: q2, w: q3 }
            },
        );
        let c1 = Self::canonical_sign(
            {
                let (q0, q1, q2, q3) = R::div4(
                    c1.x, c1.y, c1.z, c1.w, R::norm4(c1.x, c1.y, c1.z, c1.w),
                );
                Vector4 { x: q0, y: q1, z: q2, w: q3 }
            },
        );
        let c2 = Self::canonical_sign(
            {
                let (q0, q1, q2, q3) = R::div4(
                    c2.x, c2.y, c2.z, c2.w, R::norm4(c2.x, c2.y, c2.z, c2.w),
                );
                Vector4 { x: q0, y: q1, z: q2, w: q3 }
            },
        );
        let c3 = Self::canonical_sign(
            {
                let (q0, q1, q2, q3) = R::div4(
                    c3.x, c3.y, c3.z, c3.w, R::norm4(c3.x, c3.y, c3.z, c3.w),
                );
                Vector4 { x: q0, y: q1, z: q2, w: q3 }
            },
        );
        SymmetricEigen4 {
            eigenvalues: Vector4 { x: l0, y: l1, z: l2, w: l3 },
            eigenvectors: Matrix4 {
                m11: c0.x,
                m21: c0.y,
                m31: c0.z,
                m41: c0.w,
                m12: c1.x,
                m22: c1.y,
                m32: c1.z,
                m42: c1.w,
                m13: c2.x,
                m23: c2.y,
                m33: c2.z,
                m43: c2.w,
                m14: c3.x,
                m24: c3.y,
                m34: c3.z,
                m44: c3.w,
            },
        }
    }
}

/// Methods of `SymmetricEigen4<T>` for any `Real` scalar.
#[generate_trait]
pub impl SymmetricEigen4Impl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of SymmetricEigen4Trait<T> {
    /// The eigendecomposition of the symmetric `m` by **5** cyclic Jacobi sweeps (30
    /// plane rotations), unrolled per sweep. Cost: constant; there is no convergence test, no
    /// tolerance and no iteration count (DESIGN D6). Like upstream, only the LOWER triangle of
    /// `m` is read and its symmetry is not checked. Panics on overflow (a rotation never grows a
    /// component by more than `sqrt(2)`). Upstream: `SymmetricEigen::new` (iterative QR,
    /// different algorithm and eigenvalue order).
    #[inline(always)]
    fn new(m: Matrix4<T>) -> SymmetricEigen4<T> {
        SymmetricEigen4InternalTrait::new_sym(
            Sym4 {
                m11: m.m11,
                m12: m.m21,
                m13: m.m31,
                m14: m.m41,
                m22: m.m22,
                m23: m.m32,
                m24: m.m42,
                m33: m.m33,
                m34: m.m43,
                m44: m.m44,
            },
        )
    }

    /// `new`, or `None` when the fixed sweep budget did not reach upstream's convergence
    /// criterion `|s_ij| <= eps * (|s_ii| + |s_jj|)` on every off-diagonal entry of the final
    /// state. `max_niter` is accepted for signature parity and ignored: the iteration count is
    /// the constant budget of the type (upstream's `0 = unlimited` maps onto it too), so the
    /// only way to "exceed" it is not to converge within it. The criterion is floored: with
    /// `eps = 0` any leftover off-diagonal raw unit returns `None`. Upstream:
    /// `SymmetricEigen::try_new`.
    fn try_new(m: Matrix4<T>, eps: T, max_niter: usize) -> Option<SymmetricEigen4<T>> {
        SymmetricEigen4InternalTrait::try_new_sym(
            Sym4 {
                m11: m.m11,
                m12: m.m21,
                m13: m.m31,
                m14: m.m41,
                m22: m.m22,
                m23: m.m32,
                m24: m.m42,
                m33: m.m33,
                m34: m.m43,
                m44: m.m44,
            },
            eps,
        )
    }

    /// `V * diag(eigenvalues) * Vᵀ`: `v_jk λ_k` floored, then one fused sum per entry of the
    /// upper triangle, mirrored (exactly symmetric). Panics on overflow. Upstream:
    /// `SymmetricEigen::recompose`.
    fn recompose(self: SymmetricEigen4<T>) -> Matrix4<T> {
        let s = SymmetricEigen4InternalTrait::recompose_sym(self);
        Matrix4 {
            m11: s.m11,
            m21: s.m12,
            m31: s.m13,
            m41: s.m14,
            m12: s.m12,
            m22: s.m22,
            m32: s.m23,
            m42: s.m24,
            m13: s.m13,
            m23: s.m23,
            m33: s.m33,
            m43: s.m34,
            m14: s.m14,
            m24: s.m24,
            m34: s.m34,
            m44: s.m44,
        }
    }
}

/// Crate-internal kernels of `SymmetricEigen4<T>`, on the 10 independent components.
#[generate_trait]
pub(crate) impl SymmetricEigen4InternalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of SymmetricEigen4InternalTrait<T> {
    /// The kernel of `new`.
    fn new_sym(s: Sym4<T>) -> SymmetricEigen4<T> {
        Jacobi4Impl::<T>::run(s).finish()
    }
    /// The kernel of `try_new`.
    fn try_new_sym(s: Sym4<T>, eps: T) -> Option<SymmetricEigen4<T>> {
        let j = Jacobi4Impl::<T>::run(s);
        if Jacobi4Impl::<T>::converged(j.s, eps) {
            Some(j.finish())
        } else {
            None
        }
    }
    /// The eigenvalues alone, ascending: the same 5 sweeps with the rotation dropped,
    /// bit-identical to `new_sym(s).eigenvalues`.
    fn eigenvalues(s: Sym4<T>) -> Vector4<T> {
        revoke_ap_tracking();
        let s = Jacobi4Impl::<T>::sweep_s(s);
        let s = Jacobi4Impl::<T>::sweep_s(s);
        let s = Jacobi4Impl::<T>::sweep_s(s);
        let s = Jacobi4Impl::<T>::sweep_s(s);
        let s = Jacobi4Impl::<T>::sweep_s(s);
        let mut l0 = s.m11;
        let mut l1 = s.m22;
        let mut l2 = s.m33;
        let mut l3 = s.m44;
        if l1 < l0 {
            let tmp0 = l0;
            l0 = l1;
            l1 = tmp0;
        }
        if l3 < l2 {
            let tmp0 = l2;
            l2 = l3;
            l3 = tmp0;
        }
        if l2 < l1 {
            let tmp0 = l1;
            l1 = l2;
            l2 = tmp0;
        }
        if l1 < l0 {
            let tmp0 = l0;
            l0 = l1;
            l1 = tmp0;
        }
        if l3 < l2 {
            let tmp0 = l2;
            l2 = l3;
            l3 = tmp0;
        }
        if l2 < l1 {
            let tmp0 = l1;
            l1 = l2;
            l2 = tmp0;
        }
        Vector4 { x: l0, y: l1, z: l2, w: l3 }
    }
    /// The upper triangle of `V * diag(eigenvalues) * Vᵀ`.
    fn recompose_sym(self: SymmetricEigen4<T>) -> Sym4<T> {
        let e = self;
        let w00 = e.eigenvectors.m11 * e.eigenvalues.x;
        let w01 = e.eigenvectors.m12 * e.eigenvalues.y;
        let w02 = e.eigenvectors.m13 * e.eigenvalues.z;
        let w03 = e.eigenvectors.m14 * e.eigenvalues.w;
        let w10 = e.eigenvectors.m21 * e.eigenvalues.x;
        let w11 = e.eigenvectors.m22 * e.eigenvalues.y;
        let w12 = e.eigenvectors.m23 * e.eigenvalues.z;
        let w13 = e.eigenvectors.m24 * e.eigenvalues.w;
        let w20 = e.eigenvectors.m31 * e.eigenvalues.x;
        let w21 = e.eigenvectors.m32 * e.eigenvalues.y;
        let w22 = e.eigenvectors.m33 * e.eigenvalues.z;
        let w23 = e.eigenvectors.m34 * e.eigenvalues.w;
        let w30 = e.eigenvectors.m41 * e.eigenvalues.x;
        let w31 = e.eigenvectors.m42 * e.eigenvalues.y;
        let w32 = e.eigenvectors.m43 * e.eigenvalues.z;
        let w33 = e.eigenvectors.m44 * e.eigenvalues.w;
        Sym4 {
            m11: R::sum_prod4(
                e.eigenvectors.m11,
                w00,
                e.eigenvectors.m12,
                w01,
                e.eigenvectors.m13,
                w02,
                e.eigenvectors.m14,
                w03,
            ),
            m12: R::sum_prod4(
                e.eigenvectors.m11,
                w10,
                e.eigenvectors.m12,
                w11,
                e.eigenvectors.m13,
                w12,
                e.eigenvectors.m14,
                w13,
            ),
            m13: R::sum_prod4(
                e.eigenvectors.m11,
                w20,
                e.eigenvectors.m12,
                w21,
                e.eigenvectors.m13,
                w22,
                e.eigenvectors.m14,
                w23,
            ),
            m14: R::sum_prod4(
                e.eigenvectors.m11,
                w30,
                e.eigenvectors.m12,
                w31,
                e.eigenvectors.m13,
                w32,
                e.eigenvectors.m14,
                w33,
            ),
            m22: R::sum_prod4(
                e.eigenvectors.m21,
                w10,
                e.eigenvectors.m22,
                w11,
                e.eigenvectors.m23,
                w12,
                e.eigenvectors.m24,
                w13,
            ),
            m23: R::sum_prod4(
                e.eigenvectors.m21,
                w20,
                e.eigenvectors.m22,
                w21,
                e.eigenvectors.m23,
                w22,
                e.eigenvectors.m24,
                w23,
            ),
            m24: R::sum_prod4(
                e.eigenvectors.m21,
                w30,
                e.eigenvectors.m22,
                w31,
                e.eigenvectors.m23,
                w32,
                e.eigenvectors.m24,
                w33,
            ),
            m33: R::sum_prod4(
                e.eigenvectors.m31,
                w20,
                e.eigenvectors.m32,
                w21,
                e.eigenvectors.m33,
                w22,
                e.eigenvectors.m34,
                w23,
            ),
            m34: R::sum_prod4(
                e.eigenvectors.m31,
                w30,
                e.eigenvectors.m32,
                w31,
                e.eigenvectors.m33,
                w32,
                e.eigenvectors.m34,
                w33,
            ),
            m44: R::sum_prod4(
                e.eigenvectors.m41,
                w30,
                e.eigenvectors.m42,
                w31,
                e.eigenvectors.m43,
                w32,
                e.eigenvectors.m44,
                w33,
            ),
        }
    }
}

/// Upstream's `SquareMatrix` methods that go through the symmetric eigen decomposition, on
/// `Matrix4`. Import `Matrix4SymmetricEigenTrait` to use them.
#[generate_trait]
pub impl Matrix4SymmetricEigenImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix4SymmetricEigenTrait<T> {
    /// The eigendecomposition of the symmetric `self` (lower triangle read), see
    /// `SymmetricEigen4Trait::new`. Upstream: `Matrix::symmetric_eigen`.
    #[inline(always)]
    fn symmetric_eigen(self: Matrix4<T>) -> SymmetricEigen4<T> {
        SymmetricEigen4Trait::new(self)
    }

    /// See `SymmetricEigen4Trait::try_new`. Upstream: `Matrix::try_symmetric_eigen`.
    #[inline(always)]
    fn try_symmetric_eigen(
        self: Matrix4<T>, eps: T, max_niter: usize,
    ) -> Option<SymmetricEigen4<T>> {
        SymmetricEigen4Trait::try_new(self, eps, max_niter)
    }

    /// The eigenvalues alone (lower triangle read), ascending: the same sweeps without the
    /// accumulation of the rotation, bit-identical to `symmetric_eigen().eigenvalues`. Upstream:
    /// `Matrix::symmetric_eigenvalues`.
    fn symmetric_eigenvalues(self: Matrix4<T>) -> Vector4<T> {
        let m = self;
        SymmetricEigen4InternalTrait::eigenvalues(
            Sym4 {
                m11: m.m11,
                m12: m.m21,
                m13: m.m31,
                m14: m.m41,
                m22: m.m22,
                m23: m.m32,
                m24: m.m42,
                m33: m.m33,
                m34: m.m43,
                m44: m.m44,
            },
        )
    }
}
