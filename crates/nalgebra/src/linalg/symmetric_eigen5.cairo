    /// `v` with the sign that makes its component of largest absolute value positive (ties go to
    /// the earlier component); `v` unchanged when it is zero.
    #[inline(always)]
    fn canonical_sign(v: Vector5<T>) -> Vector5<T> {
        {
            let mut dom = v.x;
            let mut big = v.x.abs();
            if v.y.abs() > big {
                big = v.y.abs();
                dom = v.y;
            }
            if v.z.abs() > big {
                big = v.z.abs();
                dom = v.z;
            }
            if v.w.abs() > big {
                big = v.w.abs();
                dom = v.w;
            }
            if v.a.abs() > big {
                big = v.a.abs();
                dom = v.a;
            }
            if dom.is_sign_negative() {
                Vector5 { x: -v.x, y: -v.y, z: -v.z, w: -v.w, a: -v.a }
            } else {
                v
            }
        }
    }

    /// The 6 sweeps from `(s, I)`.
    fn run(s: Sym5<T>) -> Jacobi5<T> {
        // The unrolled sweeps push more than 2^15 cells: with a KNOWN ap change that large, a
        // caller cannot address its live values across the call (Sierra -> CASM "Offset
        // overflow"). Revoking the ap tracking makes the change unknown, so callers spill their
        // live values to locals first (a few steps).
        revoke_ap_tracking();
        let mut j = Jacobi5 {
            s,
            v: Matrix5 {
                m11: R::one(),
                m21: R::zero(),
                m31: R::zero(),
                m41: R::zero(),
                m51: R::zero(),
                m12: R::zero(),
                m22: R::one(),
                m32: R::zero(),
                m42: R::zero(),
                m52: R::zero(),
                m13: R::zero(),
                m23: R::zero(),
                m33: R::one(),
                m43: R::zero(),
                m53: R::zero(),
                m14: R::zero(),
                m24: R::zero(),
                m34: R::zero(),
                m44: R::one(),
                m54: R::zero(),
                m15: R::zero(),
                m25: R::zero(),
                m35: R::zero(),
                m45: R::zero(),
                m55: R::one(),
            },
        };
        j = j.sweep();
        j = j.sweep();
        j = j.sweep();
        j = j.sweep();
        j = j.sweep();
        j = j.sweep();
        j
    }

    /// Upstream's convergence test on the final state: every off-diagonal entry within
    /// `eps * (|s_ii| + |s_jj|)` (one fused product pair, floored). The `None` of the `try_*`
    /// forms.
    fn converged(s: Sym5<T>, eps: T) -> bool {
        s.m12.abs() <= R::sum_prod2(eps, s.m11.abs(), eps, s.m22.abs())
            && s.m13.abs() <= R::sum_prod2(eps, s.m11.abs(), eps, s.m33.abs())
            && s.m14.abs() <= R::sum_prod2(eps, s.m11.abs(), eps, s.m44.abs())
            && s.m15.abs() <= R::sum_prod2(eps, s.m11.abs(), eps, s.m55.abs())
            && s.m23.abs() <= R::sum_prod2(eps, s.m22.abs(), eps, s.m33.abs())
            && s.m24.abs() <= R::sum_prod2(eps, s.m22.abs(), eps, s.m44.abs())
            && s.m25.abs() <= R::sum_prod2(eps, s.m22.abs(), eps, s.m55.abs())
            && s.m34.abs() <= R::sum_prod2(eps, s.m33.abs(), eps, s.m44.abs())
            && s.m35.abs() <= R::sum_prod2(eps, s.m33.abs(), eps, s.m55.abs())
            && s.m45.abs() <= R::sum_prod2(eps, s.m44.abs(), eps, s.m55.abs())
    }

    /// The diagonal sorted ascending (stable odd-even transposition network, strict comparison:
    /// equal eigenvalues keep their order, so a diagonal input keeps its axes), the matching
    /// columns renormalised (each accumulates the rounding of its rotations) and signed.
    fn finish(self: Jacobi5<T>) -> SymmetricEigen5<T> {
        let v = self.v;
        let mut c0 = Vector5 { x: v.m11, y: v.m21, z: v.m31, w: v.m41, a: v.m51 };
        let mut c1 = Vector5 { x: v.m12, y: v.m22, z: v.m32, w: v.m42, a: v.m52 };
        let mut c2 = Vector5 { x: v.m13, y: v.m23, z: v.m33, w: v.m43, a: v.m53 };
        let mut c3 = Vector5 { x: v.m14, y: v.m24, z: v.m34, w: v.m44, a: v.m54 };
        let mut c4 = Vector5 { x: v.m15, y: v.m25, z: v.m35, w: v.m45, a: v.m55 };
        let mut l0 = self.s.m11;
        let mut l1 = self.s.m22;
        let mut l2 = self.s.m33;
        let mut l3 = self.s.m44;
        let mut l4 = self.s.m55;
        if l1 < l0 {
            let tmp0 = l0;
            let tmp1 = c0;
            l0 = l1;
            c0 = c1;
            l1 = tmp0;
            c1 = tmp1;
        }
        if l3 < l2 {
            let tmp0 = l2;
            let tmp1 = c2;
            l2 = l3;
            c2 = c3;
            l3 = tmp0;
            c3 = tmp1;
        }
        if l2 < l1 {
            let tmp0 = l1;
            let tmp1 = c1;
            l1 = l2;
            c1 = c2;
            l2 = tmp0;
            c2 = tmp1;
        }
        if l4 < l3 {
            let tmp0 = l3;
            let tmp1 = c3;
            l3 = l4;
            c3 = c4;
            l4 = tmp0;
            c4 = tmp1;
        }
        if l1 < l0 {
            let tmp0 = l0;
            let tmp1 = c0;
            l0 = l1;
            c0 = c1;
            l1 = tmp0;
            c1 = tmp1;
        }
        if l3 < l2 {
            let tmp0 = l2;
            let tmp1 = c2;
            l2 = l3;
            c2 = c3;
            l3 = tmp0;
            c3 = tmp1;
        }
        if l2 < l1 {
            let tmp0 = l1;
            let tmp1 = c1;
            l1 = l2;
            c1 = c2;
            l2 = tmp0;
            c2 = tmp1;
        }
        if l4 < l3 {
            let tmp0 = l3;
            let tmp1 = c3;
            l3 = l4;
            c3 = c4;
            l4 = tmp0;
            c4 = tmp1;
        }
        if l1 < l0 {
            let tmp0 = l0;
            let tmp1 = c0;
            l0 = l1;
            c0 = c1;
            l1 = tmp0;
            c1 = tmp1;
        }
        if l3 < l2 {
            let tmp0 = l2;
            let tmp1 = c2;
            l2 = l3;
            c2 = c3;
            l3 = tmp0;
            c3 = tmp1;
        }
        let c0 = Self::canonical_sign(
            {
                let (q0, q1, q2, q3, q4) = R::div5(
                    c0.x,
                    c0.y,
                    c0.z,
                    c0.w,
                    c0.a,
                    R::wide_sqrt(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(R::wide_zero(), c0.x, c0.x), c0.y, c0.y,
                                    ),
                                    c0.z,
                                    c0.z,
                                ),
                                c0.w,
                                c0.w,
                            ),
                            c0.a,
                            c0.a,
                        ),
                    ),
                );
                Vector5 { x: q0, y: q1, z: q2, w: q3, a: q4 }
            },
        );
        let c1 = Self::canonical_sign(
            {
                let (q0, q1, q2, q3, q4) = R::div5(
                    c1.x,
                    c1.y,
                    c1.z,
                    c1.w,
                    c1.a,
                    R::wide_sqrt(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(R::wide_zero(), c1.x, c1.x), c1.y, c1.y,
                                    ),
                                    c1.z,
                                    c1.z,
                                ),
                                c1.w,
                                c1.w,
                            ),
                            c1.a,
                            c1.a,
                        ),
                    ),
                );
                Vector5 { x: q0, y: q1, z: q2, w: q3, a: q4 }
            },
        );
        let c2 = Self::canonical_sign(
            {
                let (q0, q1, q2, q3, q4) = R::div5(
                    c2.x,
                    c2.y,
                    c2.z,
                    c2.w,
                    c2.a,
                    R::wide_sqrt(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(R::wide_zero(), c2.x, c2.x), c2.y, c2.y,
                                    ),
                                    c2.z,
                                    c2.z,
                                ),
                                c2.w,
                                c2.w,
                            ),
                            c2.a,
                            c2.a,
                        ),
                    ),
                );
                Vector5 { x: q0, y: q1, z: q2, w: q3, a: q4 }
            },
        );
        let c3 = Self::canonical_sign(
            {
                let (q0, q1, q2, q3, q4) = R::div5(
                    c3.x,
                    c3.y,
                    c3.z,
                    c3.w,
                    c3.a,
                    R::wide_sqrt(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(R::wide_zero(), c3.x, c3.x), c3.y, c3.y,
                                    ),
                                    c3.z,
                                    c3.z,
                                ),
                                c3.w,
                                c3.w,
                            ),
                            c3.a,
                            c3.a,
                        ),
                    ),
                );
                Vector5 { x: q0, y: q1, z: q2, w: q3, a: q4 }
            },
        );
        let c4 = Self::canonical_sign(
            {
                let (q0, q1, q2, q3, q4) = R::div5(
                    c4.x,
                    c4.y,
                    c4.z,
                    c4.w,
                    c4.a,
                    R::wide_sqrt(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(R::wide_zero(), c4.x, c4.x), c4.y, c4.y,
                                    ),
                                    c4.z,
                                    c4.z,
                                ),
                                c4.w,
                                c4.w,
                            ),
                            c4.a,
                            c4.a,
                        ),
                    ),
                );
                Vector5 { x: q0, y: q1, z: q2, w: q3, a: q4 }
            },
        );
        SymmetricEigen5 {
            eigenvalues: Vector5 { x: l0, y: l1, z: l2, w: l3, a: l4 },
            eigenvectors: Matrix5 {
                m11: c0.x,
                m21: c0.y,
                m31: c0.z,
                m41: c0.w,
                m51: c0.a,
                m12: c1.x,
                m22: c1.y,
                m32: c1.z,
                m42: c1.w,
                m52: c1.a,
                m13: c2.x,
                m23: c2.y,
                m33: c2.z,
                m43: c2.w,
                m53: c2.a,
                m14: c3.x,
                m24: c3.y,
                m34: c3.z,
                m44: c3.w,
                m54: c3.a,
                m15: c4.x,
                m25: c4.y,
                m35: c4.z,
                m45: c4.w,
                m55: c4.a,
            },
        }
    }
}

/// Methods of `SymmetricEigen5<T>` for any `Real` scalar.
#[generate_trait]
pub impl SymmetricEigen5Impl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of SymmetricEigen5Trait<T> {
    /// The eigendecomposition of the symmetric `m` by **6** cyclic Jacobi sweeps (60
    /// plane rotations), unrolled per sweep. Cost: constant; there is no convergence test, no
    /// tolerance and no iteration count (DESIGN D6). Like upstream, only the LOWER triangle of
    /// `m` is read and its symmetry is not checked. Panics on overflow (a rotation never grows a
    /// component by more than `sqrt(2)`). Upstream: `SymmetricEigen::new` (iterative QR,
    /// different algorithm and eigenvalue order).
    #[inline(always)]
    fn new(m: Matrix5<T>) -> SymmetricEigen5<T> {
        SymmetricEigen5InternalTrait::new_sym(
            Sym5 {
                m11: m.m11,
                m12: m.m21,
                m13: m.m31,
                m14: m.m41,
                m15: m.m51,
                m22: m.m22,
                m23: m.m32,
                m24: m.m42,
                m25: m.m52,
                m33: m.m33,
                m34: m.m43,
                m35: m.m53,
                m44: m.m44,
                m45: m.m54,
                m55: m.m55,
            },
        )
    }

    /// `new`, or `None` when the fixed sweep budget did not reach upstream's convergence
    /// criterion `|s_ij| <= eps * (|s_ii| + |s_jj|)` on every off-diagonal entry of the final
    /// state. `max_niter` is accepted for signature parity and ignored: the iteration count is
    /// the constant budget of the type (upstream's `0 = unlimited` maps onto it too), so the
    /// only way to "exceed" it is not to converge within it. The criterion is floored: with
    /// `eps = 0` any leftover off-diagonal raw unit returns `None`. Upstream:
    /// `SymmetricEigen::try_new`.
    fn try_new(m: Matrix5<T>, eps: T, max_niter: usize) -> Option<SymmetricEigen5<T>> {
        SymmetricEigen5InternalTrait::try_new_sym(
            Sym5 {
                m11: m.m11,
                m12: m.m21,
                m13: m.m31,
                m14: m.m41,
                m15: m.m51,
                m22: m.m22,
                m23: m.m32,
                m24: m.m42,
                m25: m.m52,
                m33: m.m33,
                m34: m.m43,
                m35: m.m53,
                m44: m.m44,
                m45: m.m54,
                m55: m.m55,
            },
            eps,
        )
    }

    /// `V * diag(eigenvalues) * Vᵀ`: `v_jk λ_k` floored, then one fused sum per entry of the
    /// upper triangle, mirrored (exactly symmetric). Panics on overflow. Upstream:
    /// `SymmetricEigen::recompose`.
    fn recompose(self: SymmetricEigen5<T>) -> Matrix5<T> {
        let s = SymmetricEigen5InternalTrait::recompose_sym(self);
        Matrix5 {
            m11: s.m11,
            m21: s.m12,
            m31: s.m13,
            m41: s.m14,
            m51: s.m15,
            m12: s.m12,
            m22: s.m22,
            m32: s.m23,
            m42: s.m24,
            m52: s.m25,
            m13: s.m13,
            m23: s.m23,
            m33: s.m33,
            m43: s.m34,
            m53: s.m35,
            m14: s.m14,
            m24: s.m24,
            m34: s.m34,
            m44: s.m44,
            m54: s.m45,
            m15: s.m15,
            m25: s.m25,
            m35: s.m35,
            m45: s.m45,
            m55: s.m55,
        }
    }
}

/// Crate-internal kernels of `SymmetricEigen5<T>`, on the 15 independent components.
#[generate_trait]
pub(crate) impl SymmetricEigen5InternalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of SymmetricEigen5InternalTrait<T> {
    /// The kernel of `new`.
    fn new_sym(s: Sym5<T>) -> SymmetricEigen5<T> {
        Jacobi5Impl::<T>::run(s).finish()
    }
    /// The kernel of `try_new`.
    fn try_new_sym(s: Sym5<T>, eps: T) -> Option<SymmetricEigen5<T>> {
        let j = Jacobi5Impl::<T>::run(s);
        if Jacobi5Impl::<T>::converged(j.s, eps) {
            Some(j.finish())
        } else {
            None
        }
    }
    /// The eigenvalues alone, ascending: the same 6 sweeps with the rotation dropped,
    /// bit-identical to `new_sym(s).eigenvalues`.
    fn eigenvalues(s: Sym5<T>) -> Vector5<T> {
        revoke_ap_tracking();
        let s = Jacobi5Impl::<T>::sweep_s(s);
        let s = Jacobi5Impl::<T>::sweep_s(s);
        let s = Jacobi5Impl::<T>::sweep_s(s);
        let s = Jacobi5Impl::<T>::sweep_s(s);
        let s = Jacobi5Impl::<T>::sweep_s(s);
        let s = Jacobi5Impl::<T>::sweep_s(s);
        let mut l0 = s.m11;
        let mut l1 = s.m22;
        let mut l2 = s.m33;
        let mut l3 = s.m44;
        let mut l4 = s.m55;
        if l1 < l0 {
            let tmp0 = l0;
            l0 = l1;
            l1 = tmp0;
        }
        if l3 < l2 {
            let tmp0 = l2;
            l2 = l3;
            l3 = tmp0;
        }
        if l2 < l1 {
            let tmp0 = l1;
            l1 = l2;
            l2 = tmp0;
        }
        if l4 < l3 {
            let tmp0 = l3;
            l3 = l4;
            l4 = tmp0;
        }
        if l1 < l0 {
            let tmp0 = l0;
            l0 = l1;
            l1 = tmp0;
        }
        if l3 < l2 {
            let tmp0 = l2;
            l2 = l3;
            l3 = tmp0;
        }
        if l2 < l1 {
            let tmp0 = l1;
            l1 = l2;
            l2 = tmp0;
        }
        if l4 < l3 {
            let tmp0 = l3;
            l3 = l4;
            l4 = tmp0;
        }
        if l1 < l0 {
            let tmp0 = l0;
            l0 = l1;
            l1 = tmp0;
        }
        if l3 < l2 {
            let tmp0 = l2;
            l2 = l3;
            l3 = tmp0;
        }
        Vector5 { x: l0, y: l1, z: l2, w: l3, a: l4 }
    }
