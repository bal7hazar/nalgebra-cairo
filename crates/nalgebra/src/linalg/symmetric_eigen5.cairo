/// Upstream's `SquareMatrix` methods that go through the symmetric eigen decomposition, on
/// `Matrix5`. Import `Matrix5SymmetricEigenTrait` to use them.
#[generate_trait]
pub impl Matrix5SymmetricEigenImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5SymmetricEigenTrait<T> {
    /// The eigendecomposition of the symmetric `self` (lower triangle read), see
    /// `SymmetricEigen5Trait::new`. Upstream: `Matrix::symmetric_eigen`.
    #[inline(always)]
    fn symmetric_eigen(self: Matrix5<T>) -> SymmetricEigen5<T> {
        SymmetricEigen5Trait::new(self)
    }

    /// See `SymmetricEigen5Trait::try_new`. Upstream: `Matrix::try_symmetric_eigen`.
    #[inline(always)]
    fn try_symmetric_eigen(
        self: Matrix5<T>, eps: T, max_niter: usize,
    ) -> Option<SymmetricEigen5<T>> {
        SymmetricEigen5Trait::try_new(self, eps, max_niter)
    }

    /// The eigenvalues alone (lower triangle read), ascending: the same sweeps without the
    /// accumulation of the rotation, bit-identical to `symmetric_eigen().eigenvalues`. Upstream:
    /// `Matrix::symmetric_eigenvalues`.
    fn symmetric_eigenvalues(self: Matrix5<T>) -> Vector5<T> {
        let m = self;
        SymmetricEigen5InternalTrait::eigenvalues(
            Sym5 {
                m11: m.m11,
                m12: m.m21,
                m13: m.m31,
                m14: m.m41,
                m15: m.m51,
                m22: m.m22,
                m23: m.m32,
                m24: m.m42,
                m25: m.m52,
                m33: m.m33,
                m34: m.m43,
                m35: m.m53,
                m44: m.m44,
                m45: m.m54,
                m55: m.m55,
            },
        )
    }
}
