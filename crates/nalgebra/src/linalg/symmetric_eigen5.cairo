        }
        if s.m15 != R::zero() {
            let (t, c, sn) = Self::rotation(s.m11, s.m15, s.m55);
            let g = s.m15;
            s =
                Sym5 {
                    m11: R::mul_add(-t, g, s.m11),
                    m12: R::diff_prod(c, s.m12, sn, s.m25),
                    m13: R::diff_prod(c, s.m13, sn, s.m35),
                    m14: R::diff_prod(c, s.m14, sn, s.m45),
