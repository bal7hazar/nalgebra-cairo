        }
        if s.m13 != R::zero() {
            let (t, c, sn) = Self::rotation(s.m11, s.m13, s.m33);
            let g = s.m13;
            s =
                Sym5 {
                    m11: R::mul_add(-t, g, s.m11),
                    m12: R::diff_prod(c, s.m12, sn, s.m23),
