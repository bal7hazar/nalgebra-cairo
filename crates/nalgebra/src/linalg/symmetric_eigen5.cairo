            let g = s.m14;
            s =
                Sym5 {
                    m11: R::mul_add(-t, g, s.m11),
                    m12: R::diff_prod(c, s.m12, sn, s.m24),
                    m13: R::diff_prod(c, s.m13, sn, s.m34),
                    m14: R::zero(),
                    m15: R::diff_prod(c, s.m15, sn, s.m45),
                    m22: s.m22,
