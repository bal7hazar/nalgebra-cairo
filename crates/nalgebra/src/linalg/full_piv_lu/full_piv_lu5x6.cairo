                let t = a02;
                a02 = a05;
                a05 = t;
                let t = a12;
                a12 = a15;
                a15 = t;
                let t = a22;
                a22 = a25;
                a25 = t;
                let t = a32;
                a32 = a35;
                a35 = t;
                let t = a42;
                a42 = a45;
                a45 = t;
            }
            if rp2 == 4 {
                let t = a20;
                a20 = a30;
                a30 = t;
                let t = a21;
                a21 = a31;
                a31 = t;
                let t = a22;
                a22 = a32;
                a32 = t;
                let t = a23;
                a23 = a33;
                a33 = t;
                let t = a24;
                a24 = a34;
                a34 = t;
                let t = a25;
                a25 = a35;
                a35 = t;
            } else if rp2 == 5 {
                let t = a20;
                a20 = a40;
                a40 = t;
                let t = a21;
                a21 = a41;
                a41 = t;
                let t = a22;
                a22 = a42;
                a42 = t;
                let t = a23;
                a23 = a43;
                a43 = t;
                let t = a24;
                a24 = a44;
                a44 = t;
                let t = a25;
                a25 = a45;
                a45 = t;
            }
            let (l3, l4) = (R::div(a32, a22), R::div(a42, a22));
            let nl = -l3;
            a33 = R::mul_add(nl, a23, a33);
            a34 = R::mul_add(nl, a24, a34);
            a35 = R::mul_add(nl, a25, a35);
            a32 = l3;
            let nl = -l4;
            a43 = R::mul_add(nl, a23, a43);
            a44 = R::mul_add(nl, a24, a44);
            a45 = R::mul_add(nl, a25, a45);
            a42 = l4;
        }
        // step 4: the first largest |a_ij| of rows 4..5, columns 4..6 (column-major scan)
        let mut piv = R::abs(a33);
        let mut rp3 = 4_u8;
        let mut cp3 = 4_u8;
        let x = R::abs(a43);
        if x > piv {
            piv = x;
            rp3 = 5;
            cp3 = 4;
        }
        let x = R::abs(a34);
        if x > piv {
            piv = x;
            rp3 = 4;
            cp3 = 5;
        }
        let x = R::abs(a44);
        if x > piv {
            piv = x;
            rp3 = 5;
            cp3 = 5;
        }
        let x = R::abs(a35);
        if x > piv {
            piv = x;
            rp3 = 4;
            cp3 = 6;
        }
        let x = R::abs(a45);
        if x > piv {
            piv = x;
            rp3 = 5;
            cp3 = 6;
        }
        if piv != R::zero() {
            if cp3 == 5 {
                let t = a03;
                a03 = a04;
                a04 = t;
                let t = a13;
                a13 = a14;
                a14 = t;
                let t = a23;
                a23 = a24;
                a24 = t;
                let t = a33;
                a33 = a34;
                a34 = t;
                let t = a43;
                a43 = a44;
                a44 = t;
            } else if cp3 == 6 {
                let t = a03;
                a03 = a05;
                a05 = t;
                let t = a13;
                a13 = a15;
                a15 = t;
                let t = a23;
                a23 = a25;
                a25 = t;
                let t = a33;
                a33 = a35;
                a35 = t;
                let t = a43;
                a43 = a45;
                a45 = t;
            }
            if rp3 == 5 {
                let t = a30;
                a30 = a40;
                a40 = t;
                let t = a31;
                a31 = a41;
                a41 = t;
                let t = a32;
                a32 = a42;
                a42 = t;
                let t = a33;
                a33 = a43;
                a43 = t;
                let t = a34;
                a34 = a44;
                a44 = t;
                let t = a35;
                a35 = a45;
                a45 = t;
            }
            let l4 = R::div(a43, a33);
            let nl = -l4;
            a44 = R::mul_add(nl, a34, a44);
            a45 = R::mul_add(nl, a35, a45);
            a43 = l4;
        }
        // step 5: the first largest |a_ij| of rows 5..5, columns 5..6 (column-major scan)
        let mut piv = R::abs(a44);
        let mut cp4 = 5_u8;
        let x = R::abs(a45);
        if x > piv {
            piv = x;
            cp4 = 6;
        }
        if cp4 == 6 {
            let t = a04;
            a04 = a05;
            a05 = t;
            let t = a14;
            a14 = a15;
            a15 = t;
            let t = a24;
            a24 = a25;
            a25 = t;
            let t = a34;
            a34 = a35;
            a35 = t;
            let t = a44;
            a44 = a45;
            a45 = t;
        }
        FullPivLu5x6 {
            lu: Matrix5x6 {
                m11: a00,
                m21: a10,
                m31: a20,
                m41: a30,
                m51: a40,
                m12: a01,
                m22: a11,
                m32: a21,
                m42: a31,
                m52: a41,
                m13: a02,
                m23: a12,
                m33: a22,
                m43: a32,
                m53: a42,
                m14: a03,
                m24: a13,
                m34: a23,
                m44: a33,
                m54: a43,
                m15: a04,
                m25: a14,
                m35: a24,
                m45: a34,
                m55: a44,
                m16: a05,
                m26: a15,
                m36: a25,
                m46: a35,
                m56: a45,
            },
            p: Perm5 { p1: rp0, p2: rp1, p3: rp2, p4: rp3 },
            q: Perm6 { p1: cp0, p2: cp1, p3: cp2, p4: cp3, p5: cp4 },
        }
    }

    /// The packed factors as stored (strict lower triangle = `L`, upper triangle = `U`). Exact.
    /// Upstream: `FullPivLU::lu_internal` (`#[doc(hidden)]`).
    #[inline(always)]
    fn lu_internal(self: FullPivLu5x6<T>) -> Matrix5x6<T> {
        self.lu
    }

    /// The unit lower triangular factor `L` (5x5). Exact: moves. Upstream: `FullPivLU::l`.
    #[inline(always)]
    fn l(self: FullPivLu5x6<T>) -> Matrix5<T> {
        Matrix5 {
            m11: R::one(),
            m21: self.lu.m21,
            m31: self.lu.m31,
            m41: self.lu.m41,
            m51: self.lu.m51,
            m12: R::zero(),
            m22: R::one(),
            m32: self.lu.m32,
            m42: self.lu.m42,
            m52: self.lu.m52,
            m13: R::zero(),
            m23: R::zero(),
            m33: R::one(),
            m43: self.lu.m43,
            m53: self.lu.m53,
            m14: R::zero(),
            m24: R::zero(),
            m34: R::zero(),
            m44: R::one(),
            m54: self.lu.m54,
            m15: R::zero(),
            m25: R::zero(),
            m35: R::zero(),
            m45: R::zero(),
            m55: R::one(),
        }
    }

    /// The upper triangular factor `U` (5x6). Exact: moves. Upstream: `FullPivLU::u`.
    #[inline(always)]
    fn u(self: FullPivLu5x6<T>) -> Matrix5x6<T> {
        Matrix5x6 {
            m11: self.lu.m11,
            m21: R::zero(),
            m31: R::zero(),
            m41: R::zero(),
            m51: R::zero(),
            m12: self.lu.m12,
            m22: self.lu.m22,
            m32: R::zero(),
            m42: R::zero(),
            m52: R::zero(),
            m13: self.lu.m13,
            m23: self.lu.m23,
            m33: self.lu.m33,
            m43: R::zero(),
            m53: R::zero(),
            m14: self.lu.m14,
            m24: self.lu.m24,
            m34: self.lu.m34,
            m44: self.lu.m44,
            m54: R::zero(),
            m15: self.lu.m15,
            m25: self.lu.m25,
            m35: self.lu.m35,
            m45: self.lu.m45,
            m55: self.lu.m55,
            m16: self.lu.m16,
            m26: self.lu.m26,
            m36: self.lu.m36,
            m46: self.lu.m46,
            m56: self.lu.m56,
        }
    }

    /// The row permutation `P`. Upstream: `FullPivLU::p`.
    #[inline(always)]
    fn p(self: FullPivLu5x6<T>) -> Perm5 {
        self.p
    }

    /// The column permutation `Q`. Upstream: `FullPivLU::q`.
    #[inline(always)]
    fn q(self: FullPivLu5x6<T>) -> Perm6 {
        self.q
    }

    /// `(P, L, U, Q)`: `(p(), l(), u(), q())`, exact. Upstream: `FullPivLU::unpack`.
    #[inline(always)]
    fn unpack(self: FullPivLu5x6<T>) -> (Perm5, Matrix5<T>, Matrix5x6<T>, Perm6) {
        (self.p, Self::l(self), Self::u(self), self.q)
    }
}

/// `Matrix5x6` methods that go through the full-pivot LU factorisation. Import
/// `Matrix5x6FullPivLuTrait`.
#[generate_trait]
pub impl Matrix5x6FullPivLuImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5x6FullPivLuTrait<T> {
    /// The LU factorisation with full pivoting. Upstream: `Matrix::full_piv_lu`.
    #[inline(always)]
    fn full_piv_lu(self: Matrix5x6<T>) -> FullPivLu5x6<T> {
        FullPivLu5x6Trait::new(self)
    }
}
