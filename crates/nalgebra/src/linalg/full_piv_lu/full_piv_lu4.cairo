            m11: x00,
            m21: x10,
            m31: x20,
            m41: x30,
            m12: x01,
            m22: x11,
            m32: x21,
            m42: x31,
            m13: x02,
            m23: x12,
            m33: x22,
            m43: x32,
            m14: x03,
            m24: x13,
            m34: x23,
            m44: x33,
        };
        PermuteColumns::inv_permute_columns(self.p, ref x);
        PermuteRows::inv_permute_rows(self.q, ref x);
        Some(x)
    }
}

/// `Matrix4` methods that go through the full-pivot LU factorisation. Import
/// `Matrix4FullPivLuTrait`.
#[generate_trait]
pub impl Matrix4FullPivLuImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix4FullPivLuTrait<T> {
    /// The LU factorisation with full pivoting. Upstream: `Matrix::full_piv_lu`.
    #[inline(always)]
    fn full_piv_lu(self: Matrix4<T>) -> FullPivLu4<T> {
        FullPivLu4Trait::new(self)
    }
}
