        self: Matrix3x6<T>, eps: T, max_niter: usize,
    ) -> Option<(Matrix3<T>, Matrix3x6<T>)> {
        match Svd3x6Trait::try_new(self, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
