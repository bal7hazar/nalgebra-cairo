    /// The singular values alone, DESCENDING: the decomposition without the left vectors
    /// (bit-identical to `svd(false, false).singular_values` and to the full decomposition's, and
    /// no dearer than the former: `bench_svd3x6_singular_values__*`). Upstream:
    /// `Matrix::singular_values`.
    fn singular_values(self: Matrix3x6<T>) -> Vector3<T> {
        {
            let t = Matrix6x3 {
                m11: self.m11,
                m21: self.m12,
                m31: self.m13,
                m41: self.m14,
                m51: self.m15,
                m61: self.m16,
                m12: self.m21,
                m22: self.m22,
                m32: self.m23,
                m42: self.m24,
                m52: self.m25,
                m62: self.m26,
                m13: self.m31,
                m23: self.m32,
                m33: self.m33,
                m43: self.m34,
                m53: self.m35,
                m63: self.m36,
            };
            Svd6x3InternalTrait::values_from_right(t, Svd6x3InternalTrait::right(t))
        }
    }

    /// `singular_values` (sorted; see `Svd3x6Trait::new_unordered`). Upstream:
    /// `Matrix::singular_values_unordered`.
    #[inline(always)]
    fn singular_values_unordered(self: Matrix3x6<T>) -> Vector3<T> {
        Self::singular_values(self)
    }

    /// The number of singular values strictly greater than `eps`, from `singular_values`.
    /// Upstream: `Matrix::rank` (which asserts `eps >= 0`; a negative `eps` counts every value
    /// here).
    fn rank(self: Matrix3x6<T>, eps: T) -> usize {
        let s = Self::singular_values(self);
        let mut n: usize = 0;
        if s.x > eps {
            n += 1;
        }
        if s.y > eps {
            n += 1;
        }
        if s.z > eps {
            n += 1;
        }
        n
    }

    /// The Moore-Penrose pseudo-inverse, see `Svd3x6Trait::pseudo_inverse`. Upstream:
    /// `Matrix::pseudo_inverse` (`Err` on a negative `eps`; `None` here).
    #[inline(always)]
    fn pseudo_inverse(self: Matrix3x6<T>, eps: T) -> Option<Matrix6x3<T>> {
        Svd3x6Trait::new(self, true, true).pseudo_inverse(eps)
    }

    /// The left polar decomposition `M = P · U`, see `Svd3x6Trait::to_polar`. Upstream:
    /// `Matrix::polar`.
    fn polar(self: Matrix3x6<T>) -> (Matrix3<T>, Matrix3x6<T>) {
        Svd3x6Trait::new(self, true, true).to_polar().unwrap()
    }

    /// `polar`, or `None` when the decomposition did not converge within `eps`, see
    /// `Svd3x6Trait::try_new`. Upstream: `Matrix::try_polar`.
    fn try_polar(
        self: Matrix3x6<T>, eps: T, max_niter: usize,
    ) -> Option<(Matrix3<T>, Matrix3x6<T>)> {
        match Svd3x6Trait::try_new(self, true, true, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
