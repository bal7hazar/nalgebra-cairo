                                            R::wide_add_prod(R::wide_zero(), h.x, h.x), h.y, h.y,
                                        ),
                                        h.z,
                                        h.z,
                                    ),
                                    h.w,
                                    h.w,
                                ),
                                h.a,
                                h.a,
                            ),
                        ),
                    );
                    Vector5 { x: q0, y: q1, z: q2, w: q3, a: q4 }
                }
            }
        };
        Svd5x4 {
            u: Matrix5x4 {
                m11: u0.x,
                m21: u0.y,
                m31: u0.z,
                m41: u0.w,
                m51: u0.a,
                m12: u1.x,
                m22: u1.y,
                m32: u1.z,
                m42: u1.w,
                m52: u1.a,
                m13: u2.x,
                m23: u2.y,
                m33: u2.z,
                m43: u2.w,
                m53: u2.a,
                m14: u3.x,
                m24: u3.y,
                m34: u3.z,
                m44: u3.w,
                m54: u3.a,
            },
            singular_values: Vector4 { x: s0, y: s1, z: s2, w: s3 },
            v_t: Matrix4 {
                m11: v0.x,
                m21: v1.x,
                m31: v2.x,
                m41: v3.x,
                m12: v0.y,
                m22: v1.y,
                m32: v2.y,
                m42: v3.y,
                m13: v0.z,
                m23: v1.z,
                m33: v2.z,
                m43: v3.z,
                m14: v0.w,
                m24: v1.w,
                m34: v2.w,
                m44: v3.w,
            },
        }
    }

    /// The singular values alone: `from_right` without the left vectors.
    fn values_from_right(m: Matrix5x4<T>, v: Matrix4<T>) -> Vector4<T> {
        revoke_ap_tracking();
        let v0 = Vector4 { x: v.m11, y: v.m21, z: v.m31, w: v.m41 };
        let v1 = Vector4 { x: v.m12, y: v.m22, z: v.m32, w: v.m42 };
        let v2 = Vector4 { x: v.m13, y: v.m23, z: v.m33, w: v.m43 };
        let v3 = Vector4 { x: v.m14, y: v.m24, z: v.m34, w: v.m44 };
        let w0 = Vector5 {
            x: R::sum_prod4(m.m11, v0.x, m.m12, v0.y, m.m13, v0.z, m.m14, v0.w),
            y: R::sum_prod4(m.m21, v0.x, m.m22, v0.y, m.m23, v0.z, m.m24, v0.w),
            z: R::sum_prod4(m.m31, v0.x, m.m32, v0.y, m.m33, v0.z, m.m34, v0.w),
            w: R::sum_prod4(m.m41, v0.x, m.m42, v0.y, m.m43, v0.z, m.m44, v0.w),
            a: R::sum_prod4(m.m51, v0.x, m.m52, v0.y, m.m53, v0.z, m.m54, v0.w),
        };
        let w1 = Vector5 {
            x: R::sum_prod4(m.m11, v1.x, m.m12, v1.y, m.m13, v1.z, m.m14, v1.w),
            y: R::sum_prod4(m.m21, v1.x, m.m22, v1.y, m.m23, v1.z, m.m24, v1.w),
            z: R::sum_prod4(m.m31, v1.x, m.m32, v1.y, m.m33, v1.z, m.m34, v1.w),
            w: R::sum_prod4(m.m41, v1.x, m.m42, v1.y, m.m43, v1.z, m.m44, v1.w),
            a: R::sum_prod4(m.m51, v1.x, m.m52, v1.y, m.m53, v1.z, m.m54, v1.w),
        };
        let w2 = Vector5 {
            x: R::sum_prod4(m.m11, v2.x, m.m12, v2.y, m.m13, v2.z, m.m14, v2.w),
            y: R::sum_prod4(m.m21, v2.x, m.m22, v2.y, m.m23, v2.z, m.m24, v2.w),
            z: R::sum_prod4(m.m31, v2.x, m.m32, v2.y, m.m33, v2.z, m.m34, v2.w),
            w: R::sum_prod4(m.m41, v2.x, m.m42, v2.y, m.m43, v2.z, m.m44, v2.w),
            a: R::sum_prod4(m.m51, v2.x, m.m52, v2.y, m.m53, v2.z, m.m54, v2.w),
        };
        let w3 = Vector5 {
            x: R::sum_prod4(m.m11, v3.x, m.m12, v3.y, m.m13, v3.z, m.m14, v3.w),
            y: R::sum_prod4(m.m21, v3.x, m.m22, v3.y, m.m23, v3.z, m.m24, v3.w),
            z: R::sum_prod4(m.m31, v3.x, m.m32, v3.y, m.m33, v3.z, m.m34, v3.w),
            w: R::sum_prod4(m.m41, v3.x, m.m42, v3.y, m.m43, v3.z, m.m44, v3.w),
            a: R::sum_prod4(m.m51, v3.x, m.m52, v3.y, m.m53, v3.z, m.m54, v3.w),
        };
        let s0 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w0.x, w0.x), w0.y, w0.y),
                        w0.z,
                        w0.z,
                    ),
                    w0.w,
                    w0.w,
                ),
                w0.a,
                w0.a,
            ),
        );
        let s1 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w1.x, w1.x), w1.y, w1.y),
                        w1.z,
                        w1.z,
                    ),
                    w1.w,
                    w1.w,
                ),
                w1.a,
                w1.a,
            ),
        );
        let s2 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w2.x, w2.x), w2.y, w2.y),
                        w2.z,
                        w2.z,
                    ),
                    w2.w,
                    w2.w,
                ),
                w2.a,
                w2.a,
            ),
        );
        let s3 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w3.x, w3.x), w3.y, w3.y),
                        w3.z,
                        w3.z,
                    ),
                    w3.w,
                    w3.w,
                ),
                w3.a,
                w3.a,
            ),
        );
        let mut s0 = s0;
        let mut s1 = s1;
        let mut s2 = s2;
        let mut s3 = s3;
        if s1 > s0 {
            let tmp0 = s0;
            s0 = s1;
            s1 = tmp0;
        }
        if s3 > s2 {
            let tmp0 = s2;
            s2 = s3;
            s3 = tmp0;
        }
        if s2 > s1 {
            let tmp0 = s1;
            s1 = s2;
            s2 = tmp0;
        }
        if s1 > s0 {
            let tmp0 = s0;
            s0 = s1;
            s1 = tmp0;
        }
        if s3 > s2 {
            let tmp0 = s2;
            s2 = s3;
            s3 = tmp0;
        }
        if s2 > s1 {
            let tmp0 = s1;
            s1 = s2;
            s2 = tmp0;
        }
        Vector4 { x: s0, y: s1, z: s2, w: s3 }
    }
}

/// Upstream's `Matrix` methods that go through the SVD, on `Matrix5x4`. Import `Matrix5x4SvdTrait`
/// to use them.
#[generate_trait]
pub impl Matrix5x4SvdImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5x4SvdTrait<T> {
    /// The singular value decomposition, see `Svd5x4Trait::new`. Upstream: `Matrix::svd(true,
    /// true)`.
    #[inline(always)]
    fn svd(self: Matrix5x4<T>) -> Svd5x4<T> {
        Svd5x4Trait::new(self)
    }

    /// `svd` (already sorted, see `Svd5x4Trait::new_unordered`). Upstream: `Matrix::svd_unordered`.
    #[inline(always)]
    fn svd_unordered(self: Matrix5x4<T>) -> Svd5x4<T> {
        Svd5x4Trait::new(self)
    }

    /// See `Svd5x4Trait::try_new`. Upstream: `Matrix::try_svd(true, true, eps, max_niter)`.
    #[inline(always)]
    fn try_svd(self: Matrix5x4<T>, eps: T, max_niter: usize) -> Option<Svd5x4<T>> {
        Svd5x4Trait::try_new(self, eps, max_niter)
    }

    /// See `Svd5x4Trait::try_new_unordered`. Upstream: `Matrix::try_svd_unordered`.
    #[inline(always)]
    fn try_svd_unordered(self: Matrix5x4<T>, eps: T, max_niter: usize) -> Option<Svd5x4<T>> {
        Svd5x4Trait::try_new(self, eps, max_niter)
    }

    /// The singular values alone, DESCENDING: the decomposition without the left vectors
    /// (cheaper than `svd().singular_values`, bit-identical to it). Upstream:
    /// `Matrix::singular_values`.
    fn singular_values(self: Matrix5x4<T>) -> Vector4<T> {
        Svd5x4InternalTrait::values_from_right(self, Svd5x4InternalTrait::right(self))
    }

    /// `singular_values` (sorted; see `Svd5x4Trait::new_unordered`). Upstream:
    /// `Matrix::singular_values_unordered`.
    #[inline(always)]
    fn singular_values_unordered(self: Matrix5x4<T>) -> Vector4<T> {
        Self::singular_values(self)
    }

    /// The number of singular values strictly greater than `eps`, from `singular_values`.
    /// Upstream: `Matrix::rank` (which asserts `eps >= 0`; a negative `eps` counts every value
    /// here).
    fn rank(self: Matrix5x4<T>, eps: T) -> usize {
        let s = Self::singular_values(self);
        let mut n: usize = 0;
        if s.x > eps {
            n += 1;
        }
        if s.y > eps {
            n += 1;
        }
        if s.z > eps {
            n += 1;
        }
        if s.w > eps {
            n += 1;
        }
        n
    }

    /// The Moore-Penrose pseudo-inverse, see `Svd5x4Trait::pseudo_inverse`. Upstream:
    /// `Matrix::pseudo_inverse` (`Err` on a negative `eps`; `None` here).
    #[inline(always)]
    fn pseudo_inverse(self: Matrix5x4<T>, eps: T) -> Option<Matrix4x5<T>> {
        Svd5x4Trait::new(self).pseudo_inverse(eps)
    }

    /// The left polar decomposition `M = P · U`, see `Svd5x4Trait::to_polar`. Upstream:
    /// `Matrix::polar`.
    fn polar(self: Matrix5x4<T>) -> (Matrix5<T>, Matrix5x4<T>) {
        Svd5x4Trait::new(self).to_polar().unwrap()
    }

    /// `polar`, or `None` when the decomposition did not converge within `eps`, see
    /// `Svd5x4Trait::try_new`. Upstream: `Matrix::try_polar`.
    fn try_polar(
        self: Matrix5x4<T>, eps: T, max_niter: usize,
    ) -> Option<(Matrix5<T>, Matrix5x4<T>)> {
        match Svd5x4Trait::try_new(self, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
