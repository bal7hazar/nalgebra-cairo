    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Svd5x4InternalTrait<T> {
    /// `m / max |m_ij|` (one prepared divisor per 6 entries), or `m` when it is zero: the input
    /// of the Gram matrix. The right singular vectors do not depend on the scale, but their
    /// fixed-point PRECISION does: the Gram matrix of a small matrix has tiny entries, whose
    /// absolute rounding is a large relative error on the eigenvectors (measured on `Svd4`:
    /// `pseudo_inverse` 1 749 ulp over the oracle tolerance on `small` inputs without it), and
    /// the Gram matrix of a large one overflows. Normalised, `MᵀM` has entries in `[0, 5]`.
    fn normalised(m: Matrix5x4<T>) -> Matrix5x4<T> {
        let mut a = m.m11.abs();
        if m.m21.abs() > a {
            a = m.m21.abs();
        }
        if m.m31.abs() > a {
            a = m.m31.abs();
        }
        if m.m41.abs() > a {
            a = m.m41.abs();
        }
        if m.m51.abs() > a {
            a = m.m51.abs();
        }
        if m.m12.abs() > a {
            a = m.m12.abs();
        }
        if m.m22.abs() > a {
            a = m.m22.abs();
        }
        if m.m32.abs() > a {
            a = m.m32.abs();
        }
        if m.m42.abs() > a {
            a = m.m42.abs();
        }
        if m.m52.abs() > a {
            a = m.m52.abs();
        }
        if m.m13.abs() > a {
            a = m.m13.abs();
        }
        if m.m23.abs() > a {
            a = m.m23.abs();
        }
        if m.m33.abs() > a {
            a = m.m33.abs();
        }
        if m.m43.abs() > a {
            a = m.m43.abs();
        }
        if m.m53.abs() > a {
            a = m.m53.abs();
        }
        if m.m14.abs() > a {
            a = m.m14.abs();
        }
        if m.m24.abs() > a {
            a = m.m24.abs();
        }
        if m.m34.abs() > a {
            a = m.m34.abs();
        }
        if m.m44.abs() > a {
            a = m.m44.abs();
        }
        if m.m54.abs() > a {
            a = m.m54.abs();
        }
        if a == R::zero() {
            return m;
        }
        let (q0, q1, q2, q3, q4, q5) = R::div6(m.m11, m.m21, m.m31, m.m41, m.m51, m.m12, a);
        let (q6, q7, q8, q9, q10, q11) = R::div6(m.m22, m.m32, m.m42, m.m52, m.m13, m.m23, a);
        let (q12, q13, q14, q15, q16, q17) = R::div6(m.m33, m.m43, m.m53, m.m14, m.m24, m.m34, a);
        let (q18, q19) = (R::div(m.m44, a), R::div(m.m54, a));
        Matrix5x4 {
            m11: q0,
            m21: q1,
            m31: q2,
            m41: q3,
            m51: q4,
            m12: q5,
            m22: q6,
            m32: q7,
            m42: q8,
            m52: q9,
            m13: q10,
            m23: q11,
            m33: q12,
            m43: q13,
            m53: q14,
            m14: q15,
            m24: q16,
            m34: q17,
            m44: q18,
            m54: q19,
        }
    }

    /// `MᵀM` (10 fused sums of 5 products, one rounding each).
    #[inline(always)]
    fn gram(m: Matrix5x4<T>) -> Sym4<T> {
        Sym4 {
            m11: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m11, m.m11), m.m21, m.m21,
                            ),
                            m.m31,
                            m.m31,
                        ),
                        m.m41,
                        m.m41,
                    ),
                    m.m51,
                    m.m51,
                ),
            ),
            m12: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m11, m.m12), m.m21, m.m22,
                            ),
                            m.m31,
                            m.m32,
                        ),
                        m.m41,
                        m.m42,
                    ),
                    m.m51,
                    m.m52,
                ),
            ),
            m13: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m11, m.m13), m.m21, m.m23,
                            ),
                            m.m31,
                            m.m33,
                        ),
                        m.m41,
                        m.m43,
                    ),
                    m.m51,
                    m.m53,
                ),
            ),
            m14: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m11, m.m14), m.m21, m.m24,
                            ),
                            m.m31,
                            m.m34,
                        ),
                        m.m41,
                        m.m44,
                    ),
                    m.m51,
                    m.m54,
                ),
            ),
            m22: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m12, m.m12), m.m22, m.m22,
                            ),
                            m.m32,
                            m.m32,
                        ),
                        m.m42,
                        m.m42,
                    ),
                    m.m52,
                    m.m52,
                ),
            ),
            m23: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m12, m.m13), m.m22, m.m23,
                            ),
                            m.m32,
                            m.m33,
                        ),
                        m.m42,
                        m.m43,
                    ),
                    m.m52,
                    m.m53,
                ),
            ),
            m24: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m12, m.m14), m.m22, m.m24,
                            ),
                            m.m32,
                            m.m34,
                        ),
                        m.m42,
                        m.m44,
                    ),
                    m.m52,
                    m.m54,
                ),
            ),
            m33: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m13, m.m13), m.m23, m.m23,
                            ),
                            m.m33,
                            m.m33,
                        ),
                        m.m43,
                        m.m43,
                    ),
                    m.m53,
                    m.m53,
                ),
            ),
            m34: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m13, m.m14), m.m23, m.m24,
                            ),
                            m.m33,
                            m.m34,
                        ),
                        m.m43,
                        m.m44,
                    ),
                    m.m53,
                    m.m54,
                ),
            ),
            m44: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m14, m.m14), m.m24, m.m24,
                            ),
                            m.m34,
                            m.m34,
                        ),
                        m.m44,
                        m.m44,
                    ),
                    m.m54,
                    m.m54,
                ),
            ),
        }
    }

    /// The right singular vectors (the columns of `v`, ascending eigenvalue order of `MᵀM`).
    #[inline(always)]
    fn right(m: Matrix5x4<T>) -> Matrix4<T> {
        SvdRightImpl::<T>::right4(Self::gram(Self::normalised(m)))
    }

    /// `right`, or `None` when the eigen decomposition of `MᵀM` did not converge within `eps`.
    #[inline(always)]
    fn try_right(m: Matrix5x4<T>, eps: T) -> Option<Matrix4<T>> {
        SvdRightImpl::<T>::try_right4(Self::gram(Self::normalised(m)), eps)
    }

    /// `w_i = M v_i` (`MatrixMul::mul_mat`: one fused sum per component) and `σ_i = |w_i|`
    /// (floored norm of the exact
    /// sum of squares) for the right vectors `v` (columns), the triples sorted DESCENDING by `σ`
    /// (stable odd-even transposition network, strict comparison: ties keep their order). The
    /// singular values alone stop here.
    fn sorted(m: Matrix5x4<T>, v: Matrix4<T>) -> SortedSvd5x4<T> {
        revoke_ap_tracking();
        let v0 = Vector4 { x: v.m11, y: v.m21, z: v.m31, w: v.m41 };
        let v1 = Vector4 { x: v.m12, y: v.m22, z: v.m32, w: v.m42 };
        let v2 = Vector4 { x: v.m13, y: v.m23, z: v.m33, w: v.m43 };
        let v3 = Vector4 { x: v.m14, y: v.m24, z: v.m34, w: v.m44 };
        let mv = m.mul_mat(v);
        let w0 = Vector5 { x: mv.m11, y: mv.m21, z: mv.m31, w: mv.m41, a: mv.m51 };
        let w1 = Vector5 { x: mv.m12, y: mv.m22, z: mv.m32, w: mv.m42, a: mv.m52 };
        let w2 = Vector5 { x: mv.m13, y: mv.m23, z: mv.m33, w: mv.m43, a: mv.m53 };
        let w3 = Vector5 { x: mv.m14, y: mv.m24, z: mv.m34, w: mv.m44, a: mv.m54 };
        let s0 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w0.x, w0.x), w0.y, w0.y),
                        w0.z,
                        w0.z,
                    ),
                    w0.w,
                    w0.w,
                ),
                w0.a,
                w0.a,
            ),
        );
        let s1 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w1.x, w1.x), w1.y, w1.y),
                        w1.z,
                        w1.z,
                    ),
                    w1.w,
                    w1.w,
                ),
                w1.a,
                w1.a,
            ),
        );
        let s2 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w2.x, w2.x), w2.y, w2.y),
                        w2.z,
                        w2.z,
                    ),
                    w2.w,
                    w2.w,
                ),
                w2.a,
                w2.a,
            ),
        );
        let s3 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w3.x, w3.x), w3.y, w3.y),
                        w3.z,
                        w3.z,
                    ),
                    w3.w,
                    w3.w,
                ),
                w3.a,
                w3.a,
            ),
        );
        let (mut s0, mut w0, mut v0) = (s0, w0, v0);
        let (mut s1, mut w1, mut v1) = (s1, w1, v1);
        let (mut s2, mut w2, mut v2) = (s2, w2, v2);
        let (mut s3, mut w3, mut v3) = (s3, w3, v3);
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = w2;
            let tmp2 = v2;
            s2 = s3;
            w2 = w3;
            v2 = v3;
            s3 = tmp0;
            w3 = tmp1;
            v3 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = w1;
            let tmp2 = v1;
            s1 = s2;
            w1 = w2;
            v1 = v2;
            s2 = tmp0;
            w2 = tmp1;
            v2 = tmp2;
        }
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = w2;
            let tmp2 = v2;
            s2 = s3;
            w2 = w3;
            v2 = v3;
            s3 = tmp0;
            w3 = tmp1;
            v3 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = w1;
            let tmp2 = v1;
            s1 = s2;
            w1 = w2;
            v1 = v2;
            s2 = tmp0;
            w2 = tmp1;
            v2 = tmp2;
        }
        SortedSvd5x4 { s0, s1, s2, s3, w0, w1, w2, w3, v0, v1, v2, v3 }
    }

    /// The decomposition from the right singular vectors `v` (columns): `sorted`, then the left
    /// vectors by classical Gram-Schmidt run TWICE ("twice is enough", `SvdComplete5::gs*`):
    /// the second pass costs about as much as the first and keeps `U` orthonormal to the
    /// rounding of the residual even when `σ_k` is tiny (rank deficiency), where one pass leaves
    /// `u_k` as far from the others as `rounding / σ_k`. A column that vanishes EXACTLY (or `σ_1
    /// = 0`) is completed by the axis least represented in the span of the previous ones.
    fn from_right(m: Matrix5x4<T>, v: Matrix4<T>) -> Svd5x4<T> {
        let t = Self::sorted(m, v);
        let (s0, w0, v0) = (t.s0, t.w0, t.v0);
        let (s1, w1, v1) = (t.s1, t.w1, t.v1);
        let (s2, w2, v2) = (t.s2, t.w2, t.v2);
        let (s3, w3, v3) = (t.s3, t.w3, t.v3);
        let u0 = SvdComplete5Impl::<T>::first(w0, s0);
        let u1 = SvdComplete5Impl::<T>::gs1(u0, w1);
        let u2 = SvdComplete5Impl::<T>::gs2(u0, u1, w2);
        let u3 = SvdComplete5Impl::<T>::gs3(u0, u1, u2, w3);
        Svd5x4 {
            u: Matrix5x4 {
                m11: u0.x,
                m21: u0.y,
                m31: u0.z,
                m41: u0.w,
                m51: u0.a,
                m12: u1.x,
                m22: u1.y,
                m32: u1.z,
                m42: u1.w,
                m52: u1.a,
                m13: u2.x,
                m23: u2.y,
                m33: u2.z,
                m43: u2.w,
                m53: u2.a,
                m14: u3.x,
                m24: u3.y,
                m34: u3.z,
                m44: u3.w,
                m54: u3.a,
            },
            singular_values: Vector4 { x: s0, y: s1, z: s2, w: s3 },
            v_t: Matrix4 {
                m11: v0.x,
                m21: v1.x,
                m31: v2.x,
                m41: v3.x,
                m12: v0.y,
                m22: v1.y,
                m32: v2.y,
                m42: v3.y,
                m13: v0.z,
                m23: v1.z,
                m33: v2.z,
                m43: v3.z,
                m14: v0.w,
                m24: v1.w,
                m34: v2.w,
                m44: v3.w,
            },
        }
    }

    /// The singular values alone: `sorted`, without the left vectors.
    fn values_from_right(m: Matrix5x4<T>, v: Matrix4<T>) -> Vector4<T> {
        let t = Self::sorted(m, v);
        Vector4 { x: t.s0, y: t.s1, z: t.s2, w: t.s3 }
    }
}

/// Upstream's `Matrix` methods that go through the SVD, on `Matrix5x4`. Import `Matrix5x4SvdTrait`
/// to use them.
#[generate_trait]
pub impl Matrix5x4SvdImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5x4SvdTrait<T> {
    /// The singular value decomposition, see `Svd5x4Trait::new`. Upstream: `Matrix::svd(true,
    /// true)`.
    #[inline(always)]
    fn svd(self: Matrix5x4<T>) -> Svd5x4<T> {
        Svd5x4Trait::new(self)
    }

    /// `svd` (already sorted, see `Svd5x4Trait::new_unordered`). Upstream: `Matrix::svd_unordered`.
    #[inline(always)]
    fn svd_unordered(self: Matrix5x4<T>) -> Svd5x4<T> {
        Svd5x4Trait::new(self)
    }

    /// See `Svd5x4Trait::try_new`. Upstream: `Matrix::try_svd(true, true, eps, max_niter)`.
    #[inline(always)]
    fn try_svd(self: Matrix5x4<T>, eps: T, max_niter: usize) -> Option<Svd5x4<T>> {
        Svd5x4Trait::try_new(self, eps, max_niter)
    }

    /// See `Svd5x4Trait::try_new_unordered`. Upstream: `Matrix::try_svd_unordered`.
    #[inline(always)]
    fn try_svd_unordered(self: Matrix5x4<T>, eps: T, max_niter: usize) -> Option<Svd5x4<T>> {
        Svd5x4Trait::try_new(self, eps, max_niter)
    }

    /// The singular values alone, DESCENDING: the decomposition without the left vectors
    /// (cheaper than `svd().singular_values`, bit-identical to it). Upstream:
    /// `Matrix::singular_values`.
    fn singular_values(self: Matrix5x4<T>) -> Vector4<T> {
        Svd5x4InternalTrait::values_from_right(self, Svd5x4InternalTrait::right(self))
    }

    /// `singular_values` (sorted; see `Svd5x4Trait::new_unordered`). Upstream:
    /// `Matrix::singular_values_unordered`.
    #[inline(always)]
    fn singular_values_unordered(self: Matrix5x4<T>) -> Vector4<T> {
        Self::singular_values(self)
    }

    /// The number of singular values strictly greater than `eps`, from `singular_values`.
    /// Upstream: `Matrix::rank` (which asserts `eps >= 0`; a negative `eps` counts every value
    /// here).
    fn rank(self: Matrix5x4<T>, eps: T) -> usize {
        let s = Self::singular_values(self);
        let mut n: usize = 0;
        if s.x > eps {
            n += 1;
        }
        if s.y > eps {
            n += 1;
        }
        if s.z > eps {
            n += 1;
        }
        if s.w > eps {
            n += 1;
        }
        n
    }

    /// The Moore-Penrose pseudo-inverse, see `Svd5x4Trait::pseudo_inverse`. Upstream:
    /// `Matrix::pseudo_inverse` (`Err` on a negative `eps`; `None` here).
    #[inline(always)]
    fn pseudo_inverse(self: Matrix5x4<T>, eps: T) -> Option<Matrix4x5<T>> {
        Svd5x4Trait::new(self).pseudo_inverse(eps)
    }

    /// The left polar decomposition `M = P · U`, see `Svd5x4Trait::to_polar`. Upstream:
    /// `Matrix::polar`.
    fn polar(self: Matrix5x4<T>) -> (Matrix5<T>, Matrix5x4<T>) {
        Svd5x4Trait::new(self).to_polar().unwrap()
    }

    /// `polar`, or `None` when the decomposition did not converge within `eps`, see
    /// `Svd5x4Trait::try_new`. Upstream: `Matrix::try_polar`.
    fn try_polar(
        self: Matrix5x4<T>, eps: T, max_niter: usize,
    ) -> Option<(Matrix5<T>, Matrix5x4<T>)> {
        match Svd5x4Trait::try_new(self, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
