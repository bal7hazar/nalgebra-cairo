    /// Sorts the singular values DESCENDING, permuting the columns of `u` and the rows of `v_t`
    /// with them (stable odd-even transposition network, strict comparison: equal values keep
    /// their order). `new` already returns them sorted, so this only matters after the fields
    /// were edited. Upstream: `SVD::sort_by_singular_values`.
    fn sort_by_singular_values(ref self: Svd5x4<T>) {
        let mut s0 = self.singular_values.x;
        let mut s1 = self.singular_values.y;
        let mut s2 = self.singular_values.z;
        let mut s3 = self.singular_values.w;
        let mut uc0 = Vector5 {
            x: self.u.m11, y: self.u.m21, z: self.u.m31, w: self.u.m41, a: self.u.m51,
        };
        let mut uc1 = Vector5 {
            x: self.u.m12, y: self.u.m22, z: self.u.m32, w: self.u.m42, a: self.u.m52,
        };
        let mut uc2 = Vector5 {
            x: self.u.m13, y: self.u.m23, z: self.u.m33, w: self.u.m43, a: self.u.m53,
        };
        let mut uc3 = Vector5 {
            x: self.u.m14, y: self.u.m24, z: self.u.m34, w: self.u.m44, a: self.u.m54,
        };
        let mut vr0 = Vector4 {
            x: self.v_t.m11, y: self.v_t.m12, z: self.v_t.m13, w: self.v_t.m14,
        };
        let mut vr1 = Vector4 {
            x: self.v_t.m21, y: self.v_t.m22, z: self.v_t.m23, w: self.v_t.m24,
        };
        let mut vr2 = Vector4 {
            x: self.v_t.m31, y: self.v_t.m32, z: self.v_t.m33, w: self.v_t.m34,
        };
        let mut vr3 = Vector4 {
            x: self.v_t.m41, y: self.v_t.m42, z: self.v_t.m43, w: self.v_t.m44,
        };
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = uc0;
            let tmp2 = vr0;
            s0 = s1;
            uc0 = uc1;
            vr0 = vr1;
            s1 = tmp0;
            uc1 = tmp1;
            vr1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = uc2;
            let tmp2 = vr2;
            s2 = s3;
            uc2 = uc3;
            vr2 = vr3;
            s3 = tmp0;
            uc3 = tmp1;
            vr3 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = uc1;
            let tmp2 = vr1;
            s1 = s2;
            uc1 = uc2;
            vr1 = vr2;
            s2 = tmp0;
            uc2 = tmp1;
            vr2 = tmp2;
        }
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = uc0;
            let tmp2 = vr0;
            s0 = s1;
            uc0 = uc1;
            vr0 = vr1;
            s1 = tmp0;
            uc1 = tmp1;
            vr1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = uc2;
            let tmp2 = vr2;
            s2 = s3;
            uc2 = uc3;
            vr2 = vr3;
            s3 = tmp0;
            uc3 = tmp1;
            vr3 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = uc1;
            let tmp2 = vr1;
            s1 = s2;
            uc1 = uc2;
            vr1 = vr2;
            s2 = tmp0;
            uc2 = tmp1;
            vr2 = tmp2;
        }
        self =
            Svd5x4 {
                u: Matrix5x4 {
                    m11: uc0.x,
                    m21: uc0.y,
                    m31: uc0.z,
                    m41: uc0.w,
                    m51: uc0.a,
                    m12: uc1.x,
                    m22: uc1.y,
                    m32: uc1.z,
                    m42: uc1.w,
                    m52: uc1.a,
                    m13: uc2.x,
                    m23: uc2.y,
                    m33: uc2.z,
                    m43: uc2.w,
                    m53: uc2.a,
                    m14: uc3.x,
                    m24: uc3.y,
                    m34: uc3.z,
                    m44: uc3.w,
                    m54: uc3.a,
                },
                singular_values: Vector4 { x: s0, y: s1, z: s2, w: s3 },
                v_t: Matrix4 {
                    m11: vr0.x,
                    m21: vr1.x,
                    m31: vr2.x,
                    m41: vr3.x,
                    m12: vr0.y,
                    m22: vr1.y,
                    m32: vr2.y,
                    m42: vr3.y,
                    m13: vr0.z,
                    m23: vr1.z,
                    m33: vr2.z,
                    m43: vr3.z,
                    m14: vr0.w,
                    m24: vr1.w,
                    m34: vr2.w,
                    m44: vr3.w,
                },
            };
    }
}

/// Crate-internal kernels of `Svd5x4<T>`: the Gram matrix, the decomposition from the right
/// singular vectors, the singular values alone.
#[generate_trait]
pub(crate) impl Svd5x4InternalImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Svd5x4InternalTrait<T> {
    /// `MᵀM` (10 fused sums of 5 products, one rounding each). Panics on overflow.
    #[inline(always)]
    fn gram(m: Matrix5x4<T>) -> Sym4<T> {
        Sym4 {
            m11: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m11, m.m11), m.m21, m.m21,
                            ),
                            m.m31,
                            m.m31,
                        ),
                        m.m41,
                        m.m41,
                    ),
                    m.m51,
                    m.m51,
                ),
            ),
            m12: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m11, m.m12), m.m21, m.m22,
                            ),
                            m.m31,
                            m.m32,
                        ),
                        m.m41,
                        m.m42,
                    ),
                    m.m51,
                    m.m52,
                ),
            ),
            m13: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m11, m.m13), m.m21, m.m23,
                            ),
                            m.m31,
                            m.m33,
                        ),
                        m.m41,
                        m.m43,
                    ),
                    m.m51,
                    m.m53,
                ),
            ),
            m14: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m11, m.m14), m.m21, m.m24,
                            ),
                            m.m31,
                            m.m34,
                        ),
                        m.m41,
                        m.m44,
                    ),
                    m.m51,
                    m.m54,
                ),
            ),
            m22: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m12, m.m12), m.m22, m.m22,
                            ),
                            m.m32,
                            m.m32,
                        ),
                        m.m42,
                        m.m42,
                    ),
                    m.m52,
                    m.m52,
                ),
            ),
            m23: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m12, m.m13), m.m22, m.m23,
                            ),
                            m.m32,
                            m.m33,
                        ),
                        m.m42,
                        m.m43,
                    ),
                    m.m52,
                    m.m53,
                ),
            ),
            m24: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m12, m.m14), m.m22, m.m24,
                            ),
                            m.m32,
                            m.m34,
                        ),
                        m.m42,
                        m.m44,
                    ),
                    m.m52,
                    m.m54,
                ),
            ),
            m33: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m13, m.m13), m.m23, m.m23,
                            ),
                            m.m33,
                            m.m33,
                        ),
                        m.m43,
                        m.m43,
                    ),
                    m.m53,
                    m.m53,
                ),
            ),
            m34: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m13, m.m14), m.m23, m.m24,
                            ),
                            m.m33,
                            m.m34,
                        ),
                        m.m43,
                        m.m44,
                    ),
                    m.m53,
                    m.m54,
