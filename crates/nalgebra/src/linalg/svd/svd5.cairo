            ),
            m25: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m12, m.m15), m.m22, m.m25,
                            ),
                            m.m32,
