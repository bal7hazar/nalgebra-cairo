            m23: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m12, m.m13), m.m22, m.m23,
                            ),
                            m.m32,
                            m.m33,
                        ),
                        m.m42,
                        m.m43,
                    ),
                    m.m52,
                    m.m53,
