            ),
            m24: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m12, m.m14), m.m22, m.m24,
                            ),
                            m.m32,
                            m.m34,
                        ),
                        m.m42,
                        m.m44,
