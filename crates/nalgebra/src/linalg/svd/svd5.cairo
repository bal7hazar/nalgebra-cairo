    /// The right singular vectors (the columns of `v`, ascending eigenvalue order of `MᵀM`).
    #[inline(always)]
    fn right(m: Matrix5<T>) -> Matrix5<T> {
        SvdRightImpl::<T>::right5(Self::gram(Self::normalised(m)))
    }

    /// `right`, or `None` when the eigen decomposition of `MᵀM` did not converge within `eps`.
    #[inline(always)]
    fn try_right(m: Matrix5<T>, eps: T) -> Option<Matrix5<T>> {
        SvdRightImpl::<T>::try_right5(Self::gram(Self::normalised(m)), eps)
    }

    /// `w_i = M v_i` (`MatrixMul::mul_mat`: one fused sum per component) and `σ_i = |w_i|`
    /// (floored norm of the exact
    /// sum of squares) for the right vectors `v` (columns), the triples sorted DESCENDING by `σ`
    /// (stable odd-even transposition network, strict comparison: ties keep their order). The
    /// singular values alone stop here.
    fn sorted(m: Matrix5<T>, v: Matrix5<T>) -> SortedSvd5<T> {
        revoke_ap_tracking();
        let v0 = Vector5 { x: v.m11, y: v.m21, z: v.m31, w: v.m41, a: v.m51 };
        let v1 = Vector5 { x: v.m12, y: v.m22, z: v.m32, w: v.m42, a: v.m52 };
        let v2 = Vector5 { x: v.m13, y: v.m23, z: v.m33, w: v.m43, a: v.m53 };
        let v3 = Vector5 { x: v.m14, y: v.m24, z: v.m34, w: v.m44, a: v.m54 };
        let v4 = Vector5 { x: v.m15, y: v.m25, z: v.m35, w: v.m45, a: v.m55 };
        let mv = m.mul_mat(v);
        let w0 = Vector5 { x: mv.m11, y: mv.m21, z: mv.m31, w: mv.m41, a: mv.m51 };
        let w1 = Vector5 { x: mv.m12, y: mv.m22, z: mv.m32, w: mv.m42, a: mv.m52 };
        let w2 = Vector5 { x: mv.m13, y: mv.m23, z: mv.m33, w: mv.m43, a: mv.m53 };
        let w3 = Vector5 { x: mv.m14, y: mv.m24, z: mv.m34, w: mv.m44, a: mv.m54 };
        let w4 = Vector5 { x: mv.m15, y: mv.m25, z: mv.m35, w: mv.m45, a: mv.m55 };
        let s0 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w0.x, w0.x), w0.y, w0.y),
                        w0.z,
                        w0.z,
                    ),
                    w0.w,
                    w0.w,
                ),
                w0.a,
                w0.a,
            ),
        );
        let s1 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w1.x, w1.x), w1.y, w1.y),
                        w1.z,
                        w1.z,
                    ),
                    w1.w,
                    w1.w,
                ),
                w1.a,
                w1.a,
            ),
        );
        let s2 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w2.x, w2.x), w2.y, w2.y),
                        w2.z,
                        w2.z,
                    ),
                    w2.w,
                    w2.w,
                ),
                w2.a,
                w2.a,
            ),
        );
        let s3 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w3.x, w3.x), w3.y, w3.y),
                        w3.z,
                        w3.z,
                    ),
                    w3.w,
                    w3.w,
                ),
                w3.a,
                w3.a,
            ),
        );
        let s4 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), w4.x, w4.x), w4.y, w4.y),
                        w4.z,
                        w4.z,
                    ),
                    w4.w,
                    w4.w,
                ),
                w4.a,
                w4.a,
            ),
        );
        let (mut s0, mut w0, mut v0) = (s0, w0, v0);
        let (mut s1, mut w1, mut v1) = (s1, w1, v1);
        let (mut s2, mut w2, mut v2) = (s2, w2, v2);
        let (mut s3, mut w3, mut v3) = (s3, w3, v3);
        let (mut s4, mut w4, mut v4) = (s4, w4, v4);
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = w2;
            let tmp2 = v2;
            s2 = s3;
            w2 = w3;
            v2 = v3;
            s3 = tmp0;
            w3 = tmp1;
            v3 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = w1;
            let tmp2 = v1;
            s1 = s2;
            w1 = w2;
            v1 = v2;
            s2 = tmp0;
            w2 = tmp1;
            v2 = tmp2;
        }
        if s4 > s3 {
            let tmp0 = s3;
            let tmp1 = w3;
            let tmp2 = v3;
            s3 = s4;
            w3 = w4;
            v3 = v4;
            s4 = tmp0;
            w4 = tmp1;
            v4 = tmp2;
        }
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = w2;
            let tmp2 = v2;
            s2 = s3;
            w2 = w3;
            v2 = v3;
            s3 = tmp0;
            w3 = tmp1;
            v3 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = w1;
            let tmp2 = v1;
            s1 = s2;
            w1 = w2;
            v1 = v2;
            s2 = tmp0;
            w2 = tmp1;
            v2 = tmp2;
        }
        if s4 > s3 {
            let tmp0 = s3;
            let tmp1 = w3;
            let tmp2 = v3;
            s3 = s4;
            w3 = w4;
            v3 = v4;
            s4 = tmp0;
            w4 = tmp1;
            v4 = tmp2;
        }
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = w2;
            let tmp2 = v2;
            s2 = s3;
            w2 = w3;
            v2 = v3;
            s3 = tmp0;
            w3 = tmp1;
            v3 = tmp2;
        }
        SortedSvd5 { s0, s1, s2, s3, s4, w0, w1, w2, w3, w4, v0, v1, v2, v3, v4 }
    }

    /// The decomposition from the right singular vectors `v` (columns): `sorted`, then the left
    /// vectors by classical Gram-Schmidt run TWICE ("twice is enough", `SvdComplete5::gs*`):
    /// the second pass costs about as much as the first and keeps `U` orthonormal to the
    /// rounding of the residual even when `σ_k` is tiny (rank deficiency), where one pass leaves
    /// `u_k` as far from the others as `rounding / σ_k`. A column that vanishes EXACTLY (or `σ_1
    /// = 0`) is completed by the axis least represented in the span of the previous ones.
    fn from_right(m: Matrix5<T>, v: Matrix5<T>) -> Svd5<T> {
        let t = Self::sorted(m, v);
        let (s0, w0, v0) = (t.s0, t.w0, t.v0);
        let (s1, w1, v1) = (t.s1, t.w1, t.v1);
        let (s2, w2, v2) = (t.s2, t.w2, t.v2);
        let (s3, w3, v3) = (t.s3, t.w3, t.v3);
        let (s4, w4, v4) = (t.s4, t.w4, t.v4);
        let u0 = SvdComplete5Impl::<T>::first(w0, s0);
        let u1 = SvdComplete5Impl::<T>::gs1(u0, w1);
        let u2 = SvdComplete5Impl::<T>::gs2(u0, u1, w2);
        let u3 = SvdComplete5Impl::<T>::gs3(u0, u1, u2, w3);
        let u4 = SvdComplete5Impl::<T>::gs4(u0, u1, u2, u3, w4);
        Svd5 {
            u: Matrix5 {
                m11: u0.x,
                m21: u0.y,
                m31: u0.z,
                m41: u0.w,
                m51: u0.a,
                m12: u1.x,
                m22: u1.y,
                m32: u1.z,
                m42: u1.w,
                m52: u1.a,
                m13: u2.x,
                m23: u2.y,
                m33: u2.z,
                m43: u2.w,
                m53: u2.a,
                m14: u3.x,
                m24: u3.y,
                m34: u3.z,
                m44: u3.w,
                m54: u3.a,
                m15: u4.x,
                m25: u4.y,
                m35: u4.z,
                m45: u4.w,
                m55: u4.a,
            },
            singular_values: Vector5 { x: s0, y: s1, z: s2, w: s3, a: s4 },
            v_t: Matrix5 {
                m11: v0.x,
                m21: v1.x,
                m31: v2.x,
                m41: v3.x,
                m51: v4.x,
                m12: v0.y,
                m22: v1.y,
                m32: v2.y,
                m42: v3.y,
                m52: v4.y,
                m13: v0.z,
                m23: v1.z,
                m33: v2.z,
                m43: v3.z,
                m53: v4.z,
                m14: v0.w,
                m24: v1.w,
                m34: v2.w,
                m44: v3.w,
                m54: v4.w,
                m15: v0.a,
                m25: v1.a,
                m35: v2.a,
                m45: v3.a,
                m55: v4.a,
            },
        }
    }

    /// The singular values alone: `sorted`, without the left vectors.
    fn values_from_right(m: Matrix5<T>, v: Matrix5<T>) -> Vector5<T> {
        let t = Self::sorted(m, v);
        Vector5 { x: t.s0, y: t.s1, z: t.s2, w: t.s3, a: t.s4 }
    }
}

/// Upstream's `Matrix` methods that go through the SVD, on `Matrix5`. Import `Matrix5SvdTrait` to
/// use them.
#[generate_trait]
pub impl Matrix5SvdImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix5SvdTrait<T> {
    /// The singular value decomposition, see `Svd5Trait::new`. Upstream: `Matrix::svd(true, true)`.
    #[inline(always)]
    fn svd(self: Matrix5<T>) -> Svd5<T> {
        Svd5Trait::new(self)
    }

    /// `svd` (already sorted, see `Svd5Trait::new_unordered`). Upstream: `Matrix::svd_unordered`.
    #[inline(always)]
    fn svd_unordered(self: Matrix5<T>) -> Svd5<T> {
        Svd5Trait::new(self)
    }

    /// See `Svd5Trait::try_new`. Upstream: `Matrix::try_svd(true, true, eps, max_niter)`.
    #[inline(always)]
    fn try_svd(self: Matrix5<T>, eps: T, max_niter: usize) -> Option<Svd5<T>> {
        Svd5Trait::try_new(self, eps, max_niter)
    }

    /// See `Svd5Trait::try_new_unordered`. Upstream: `Matrix::try_svd_unordered`.
    #[inline(always)]
    fn try_svd_unordered(self: Matrix5<T>, eps: T, max_niter: usize) -> Option<Svd5<T>> {
        Svd5Trait::try_new(self, eps, max_niter)
    }

    /// The singular values alone, DESCENDING: the decomposition without the left vectors
    /// (cheaper than `svd().singular_values`, bit-identical to it). Upstream:
    /// `Matrix::singular_values`.
    fn singular_values(self: Matrix5<T>) -> Vector5<T> {
        Svd5InternalTrait::values_from_right(self, Svd5InternalTrait::right(self))
    }

    /// `singular_values` (sorted; see `Svd5Trait::new_unordered`). Upstream:
    /// `Matrix::singular_values_unordered`.
    #[inline(always)]
    fn singular_values_unordered(self: Matrix5<T>) -> Vector5<T> {
        Self::singular_values(self)
    }

    /// The number of singular values strictly greater than `eps`, from `singular_values`.
    /// Upstream: `Matrix::rank` (which asserts `eps >= 0`; a negative `eps` counts every value
    /// here).
    fn rank(self: Matrix5<T>, eps: T) -> usize {
        let s = Self::singular_values(self);
        let mut n: usize = 0;
        if s.x > eps {
            n += 1;
        }
        if s.y > eps {
            n += 1;
        }
        if s.z > eps {
            n += 1;
        }
        if s.w > eps {
            n += 1;
        }
        if s.a > eps {
            n += 1;
        }
        n
    }

    /// The Moore-Penrose pseudo-inverse, see `Svd5Trait::pseudo_inverse`. Upstream:
    /// `Matrix::pseudo_inverse` (`Err` on a negative `eps`; `None` here).
    #[inline(always)]
    fn pseudo_inverse(self: Matrix5<T>, eps: T) -> Option<Matrix5<T>> {
        Svd5Trait::new(self).pseudo_inverse(eps)
    }

    /// The left polar decomposition `M = P · U`, see `Svd5Trait::to_polar`. Upstream:
    /// `Matrix::polar`.
    fn polar(self: Matrix5<T>) -> (Matrix5<T>, Matrix5<T>) {
        Svd5Trait::new(self).to_polar().unwrap()
    }

    /// `polar`, or `None` when the decomposition did not converge within `eps`, see
    /// `Svd5Trait::try_new`. Upstream: `Matrix::try_polar`.
    fn try_polar(self: Matrix5<T>, eps: T, max_niter: usize) -> Option<(Matrix5<T>, Matrix5<T>)> {
        match Svd5Trait::try_new(self, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
