                        m.m41,
                        m.m43,
                    ),
                    m.m51,
                    m.m53,
                ),
            ),
            m14: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), m.m11, m.m14), m.m21, m.m24,
                            ),
                            m.m31,
                            m.m34,
                        ),
                        m.m41,
                        m.m44,
                    ),
                    m.m51,
                    m.m54,
