        }
        if m.m53.abs() > a {
            a = m.m53.abs();
        }
        if m.m63.abs() > a {
            a = m.m63.abs();
        }
        if a == R::zero() {
            return m;
        }
        let (q0, q1, q2, q3, q4, q5) = R::div6(m.m11, m.m21, m.m31, m.m41, m.m51, m.m61, a);
        let (q6, q7, q8, q9, q10, q11) = R::div6(m.m12, m.m22, m.m32, m.m42, m.m52, m.m62, a);
        let (q12, q13, q14, q15, q16, q17) = R::div6(m.m13, m.m23, m.m33, m.m43, m.m53, m.m63, a);
        Matrix6x3 {
            m11: q0,
            m21: q1,
            m31: q2,
            m41: q3,
            m51: q4,
            m61: q5,
            m12: q6,
            m22: q7,
            m32: q8,
            m42: q9,
            m52: q10,
            m62: q11,
            m13: q12,
            m23: q13,
            m33: q14,
            m43: q15,
            m53: q16,
            m63: q17,
        }
    }

    /// `MᵀM` (6 fused sums of 6 products, one rounding each).
    #[inline(always)]
    fn gram(m: Matrix6x3<T>) -> SymMatrix3<T> {
        SymMatrix3 {
            m11: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), m.m11, m.m11), m.m21, m.m21,
                                ),
                                m.m31,
                                m.m31,
                            ),
                            m.m41,
                            m.m41,
                        ),
                        m.m51,
                        m.m51,
                    ),
                    m.m61,
                    m.m61,
                ),
            ),
            m12: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), m.m11, m.m12), m.m21, m.m22,
                                ),
                                m.m31,
                                m.m32,
                            ),
                            m.m41,
                            m.m42,
                        ),
                        m.m51,
                        m.m52,
                    ),
                    m.m61,
                    m.m62,
                ),
            ),
            m13: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), m.m11, m.m13), m.m21, m.m23,
                                ),
                                m.m31,
                                m.m33,
                            ),
                            m.m41,
                            m.m43,
                        ),
                        m.m51,
                        m.m53,
                    ),
                    m.m61,
                    m.m63,
                ),
            ),
            m22: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), m.m12, m.m12), m.m22, m.m22,
                                ),
                                m.m32,
                                m.m32,
                            ),
                            m.m42,
                            m.m42,
                        ),
                        m.m52,
                        m.m52,
                    ),
                    m.m62,
                    m.m62,
                ),
            ),
            m23: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), m.m12, m.m13), m.m22, m.m23,
                                ),
                                m.m32,
                                m.m33,
                            ),
                            m.m42,
                            m.m43,
                        ),
                        m.m52,
                        m.m53,
                    ),
                    m.m62,
                    m.m63,
                ),
            ),
            m33: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), m.m13, m.m13), m.m23, m.m23,
                                ),
                                m.m33,
                                m.m33,
                            ),
                            m.m43,
                            m.m43,
                        ),
                        m.m53,
                        m.m53,
                    ),
                    m.m63,
                    m.m63,
                ),
            ),
        }
    }

    /// The right singular vectors (the columns of `v`, ascending eigenvalue order of `MᵀM`).
    #[inline(always)]
    fn right(m: Matrix6x3<T>) -> Matrix3<T> {
        SvdRightImpl::<T>::right3(Self::gram(Self::normalised(m)))
    }

    /// `right`, or `None` when the eigen decomposition of `MᵀM` did not converge within `eps`.
    #[inline(always)]
    fn try_right(m: Matrix6x3<T>, eps: T) -> Option<Matrix3<T>> {
        SvdRightImpl::<T>::try_right3(Self::gram(Self::normalised(m)), eps)
    }

    /// `w_i = M v_i` (`MatrixMul::mul_mat`: one fused sum per component) and `σ_i = |w_i|`
    /// (floored norm of the exact
    /// sum of squares) for the right vectors `v` (columns), the triples sorted DESCENDING by `σ`
    /// (stable odd-even transposition network, strict comparison: ties keep their order). The
    /// singular values alone stop here.
    fn sorted(m: Matrix6x3<T>, v: Matrix3<T>) -> SortedSvd6x3<T> {
        revoke_ap_tracking();
        let v0 = Vector3 { x: v.m11, y: v.m21, z: v.m31 };
        let v1 = Vector3 { x: v.m12, y: v.m22, z: v.m32 };
        let v2 = Vector3 { x: v.m13, y: v.m23, z: v.m33 };
        let mv = m.mul_mat(v);
        let w0 = Vector6 { x: mv.m11, y: mv.m21, z: mv.m31, w: mv.m41, a: mv.m51, b: mv.m61 };
        let w1 = Vector6 { x: mv.m12, y: mv.m22, z: mv.m32, w: mv.m42, a: mv.m52, b: mv.m62 };
        let w2 = Vector6 { x: mv.m13, y: mv.m23, z: mv.m33, w: mv.m43, a: mv.m53, b: mv.m63 };
        let s0 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), w0.x, w0.x), w0.y, w0.y,
                            ),
                            w0.z,
                            w0.z,
                        ),
                        w0.w,
                        w0.w,
                    ),
                    w0.a,
                    w0.a,
                ),
                w0.b,
                w0.b,
            ),
        );
        let s1 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), w1.x, w1.x), w1.y, w1.y,
                            ),
                            w1.z,
                            w1.z,
                        ),
                        w1.w,
                        w1.w,
                    ),
                    w1.a,
                    w1.a,
                ),
                w1.b,
                w1.b,
            ),
        );
        let s2 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), w2.x, w2.x), w2.y, w2.y,
                            ),
                            w2.z,
                            w2.z,
                        ),
                        w2.w,
                        w2.w,
                    ),
                    w2.a,
                    w2.a,
                ),
                w2.b,
                w2.b,
            ),
        );
        let (mut s0, mut w0, mut v0) = (s0, w0, v0);
        let (mut s1, mut w1, mut v1) = (s1, w1, v1);
        let (mut s2, mut w2, mut v2) = (s2, w2, v2);
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = w1;
            let tmp2 = v1;
            s1 = s2;
            w1 = w2;
            v1 = v2;
            s2 = tmp0;
            w2 = tmp1;
            v2 = tmp2;
        }
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        SortedSvd6x3 { s0, s1, s2, w0, w1, w2, v0, v1, v2 }
    }

    /// The decomposition from the right singular vectors `v` (columns): `sorted`, then the left
    /// vectors by classical Gram-Schmidt run TWICE ("twice is enough", `SvdComplete6::gs*`):
    /// the second pass costs about as much as the first and keeps `U` orthonormal to the
    /// rounding of the residual even when `σ_k` is tiny (rank deficiency), where one pass leaves
    /// `u_k` as far from the others as `rounding / σ_k`. A column that vanishes EXACTLY (or `σ_1
    /// = 0`) is completed by the axis least represented in the span of the previous ones.
    fn from_right(m: Matrix6x3<T>, v: Matrix3<T>) -> Svd6x3<T> {
        let t = Self::sorted(m, v);
        let (s0, w0, v0) = (t.s0, t.w0, t.v0);
        let (s1, w1, v1) = (t.s1, t.w1, t.v1);
        let (s2, w2, v2) = (t.s2, t.w2, t.v2);
        let u0 = SvdComplete6Impl::<T>::first(w0, s0);
        let u1 = SvdComplete6Impl::<T>::gs1(u0, w1);
        let u2 = SvdComplete6Impl::<T>::gs2(u0, u1, w2);
        Svd6x3 {
            u: Matrix6x3 {
                m11: u0.x,
                m21: u0.y,
                m31: u0.z,
                m41: u0.w,
                m51: u0.a,
                m61: u0.b,
                m12: u1.x,
                m22: u1.y,
                m32: u1.z,
                m42: u1.w,
                m52: u1.a,
                m62: u1.b,
                m13: u2.x,
                m23: u2.y,
                m33: u2.z,
                m43: u2.w,
                m53: u2.a,
                m63: u2.b,
            },
            singular_values: Vector3 { x: s0, y: s1, z: s2 },
            v_t: Matrix3 {
                m11: v0.x,
                m21: v1.x,
                m31: v2.x,
                m12: v0.y,
                m22: v1.y,
                m32: v2.y,
                m13: v0.z,
                m23: v1.z,
                m33: v2.z,
            },
        }
    }

    /// The singular values alone: `sorted`, without the left vectors.
    fn values_from_right(m: Matrix6x3<T>, v: Matrix3<T>) -> Vector3<T> {
        let t = Self::sorted(m, v);
        Vector3 { x: t.s0, y: t.s1, z: t.s2 }
    }
}

/// Upstream's `Matrix` methods that go through the SVD, on `Matrix6x3`. Import `Matrix6x3SvdTrait`
/// to use them.
#[generate_trait]
pub impl Matrix6x3SvdImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix6x3SvdTrait<T> {
    /// The singular value decomposition, see `Svd6x3Trait::new`. Upstream: `Matrix::svd(true,
    /// true)`.
    #[inline(always)]
    fn svd(self: Matrix6x3<T>) -> Svd6x3<T> {
        Svd6x3Trait::new(self)
    }

    /// `svd` (already sorted, see `Svd6x3Trait::new_unordered`). Upstream: `Matrix::svd_unordered`.
    #[inline(always)]
    fn svd_unordered(self: Matrix6x3<T>) -> Svd6x3<T> {
        Svd6x3Trait::new(self)
    }

    /// See `Svd6x3Trait::try_new`. Upstream: `Matrix::try_svd(true, true, eps, max_niter)`.
    #[inline(always)]
    fn try_svd(self: Matrix6x3<T>, eps: T, max_niter: usize) -> Option<Svd6x3<T>> {
        Svd6x3Trait::try_new(self, eps, max_niter)
    }

    /// See `Svd6x3Trait::try_new_unordered`. Upstream: `Matrix::try_svd_unordered`.
    #[inline(always)]
    fn try_svd_unordered(self: Matrix6x3<T>, eps: T, max_niter: usize) -> Option<Svd6x3<T>> {
        Svd6x3Trait::try_new(self, eps, max_niter)
    }

    /// The singular values alone, DESCENDING: the decomposition without the left vectors
    /// (cheaper than `svd().singular_values`, bit-identical to it). Upstream:
    /// `Matrix::singular_values`.
    fn singular_values(self: Matrix6x3<T>) -> Vector3<T> {
        Svd6x3InternalTrait::values_from_right(self, Svd6x3InternalTrait::right(self))
    }

    /// `singular_values` (sorted; see `Svd6x3Trait::new_unordered`). Upstream:
    /// `Matrix::singular_values_unordered`.
    #[inline(always)]
    fn singular_values_unordered(self: Matrix6x3<T>) -> Vector3<T> {
        Self::singular_values(self)
    }

    /// The number of singular values strictly greater than `eps`, from `singular_values`.
    /// Upstream: `Matrix::rank` (which asserts `eps >= 0`; a negative `eps` counts every value
    /// here).
    fn rank(self: Matrix6x3<T>, eps: T) -> usize {
        let s = Self::singular_values(self);
        let mut n: usize = 0;
        if s.x > eps {
            n += 1;
        }
        if s.y > eps {
            n += 1;
        }
        if s.z > eps {
            n += 1;
        }
        n
    }

    /// The Moore-Penrose pseudo-inverse, see `Svd6x3Trait::pseudo_inverse`. Upstream:
    /// `Matrix::pseudo_inverse` (`Err` on a negative `eps`; `None` here).
    #[inline(always)]
    fn pseudo_inverse(self: Matrix6x3<T>, eps: T) -> Option<Matrix3x6<T>> {
        Svd6x3Trait::new(self).pseudo_inverse(eps)
    }

    /// The left polar decomposition `M = P · U`, see `Svd6x3Trait::to_polar`. Upstream:
    /// `Matrix::polar`.
    fn polar(self: Matrix6x3<T>) -> (Matrix6<T>, Matrix6x3<T>) {
        Svd6x3Trait::new(self).to_polar().unwrap()
    }

    /// `polar`, or `None` when the decomposition did not converge within `eps`, see
    /// `Svd6x3Trait::try_new`. Upstream: `Matrix::try_polar`.
    fn try_polar(
        self: Matrix6x3<T>, eps: T, max_niter: usize,
    ) -> Option<(Matrix6<T>, Matrix6x3<T>)> {
        match Svd6x3Trait::try_new(self, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
