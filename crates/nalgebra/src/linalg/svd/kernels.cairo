                        u2.z,
                        q.z,
                    ),
                    u2.w,
                    q.w,
                ),
                u2.a,
                q.a,
            ),
        );
        let p3 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), u3.x, q.x), u3.y, q.y),
                        u3.z,
                        q.z,
                    ),
                    u3.w,
                    q.w,
                ),
                u3.a,
                q.a,
            ),
        );
        let h = Vector5 {
            x: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(R::wide_add(R::wide_zero(), q.x), p0, u0.x), p1, u1.x,
                        ),
                        p2,
                        u2.x,
                    ),
                    p3,
                    u3.x,
                ),
            ),
            y: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(R::wide_add(R::wide_zero(), q.y), p0, u0.y), p1, u1.y,
