    }
    /// A unit 5-vector orthogonal to the 1 orthonormal `u*`: the axis `e_i` whose squared
    /// projection `Σ u_l[i]²` onto their span is the SMALLEST (ties to the earlier axis; it is at
    /// most 1/5, so the residual has a squared norm of at least 4/5), stripped of that
    /// projection in one fused sum per component and normalised.
    #[inline(never)]
    fn complete1(u0: Vector5<T>) -> Vector5<T> {
        revoke_ap_tracking();
        let c0 = u0.x * u0.x;
        let c1 = u0.y * u0.y;
        let c2 = u0.z * u0.z;
        let c3 = u0.w * u0.w;
        let c4 = u0.a * u0.a;
        let mut best: usize = 0;
        let mut cb = c0;
        if c1 < cb {
            best = 1;
            cb = c1;
        }
        if c2 < cb {
            best = 2;
            cb = c2;
        }
        if c3 < cb {
            best = 3;
            cb = c3;
        }
        if c4 < cb {
            best = 4;
            cb = c4;
        }
        let _ = cb;
        let a0 = if best == 0 {
            u0.x
        } else if best == 1 {
            u0.y
        } else if best == 2 {
            u0.z
        } else if best == 3 {
            u0.w
        } else {
            u0.a
        };
        let r = Vector5 {
            x: R::mul_add(-a0, u0.x, if best == 0 {
                R::one()
            } else {
                R::zero()
            }),
            y: R::mul_add(-a0, u0.y, if best == 1 {
                R::one()
            } else {
                R::zero()
            }),
            z: R::mul_add(-a0, u0.z, if best == 2 {
                R::one()
            } else {
                R::zero()
            }),
            w: R::mul_add(-a0, u0.w, if best == 3 {
                R::one()
            } else {
                R::zero()
            }),
            a: R::mul_add(-a0, u0.a, if best == 4 {
                R::one()
            } else {
                R::zero()
            }),
        };
        {
            let (q0, q1, q2, q3, q4) = R::div5(
                r.x,
                r.y,
                r.z,
                r.w,
                r.a,
                R::wide_sqrt(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), r.x, r.x), r.y, r.y,
                                ),
                                r.z,
                                r.z,
                            ),
                            r.w,
                            r.w,
                        ),
                        r.a,
                        r.a,
                    ),
                ),
            );
            Vector5 { x: q0, y: q1, z: q2, w: q3, a: q4 }
        }
    }
    /// A unit 5-vector orthogonal to the 2 orthonormal `u*`: the axis `e_i` whose squared
