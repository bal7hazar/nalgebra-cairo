            ),
            y: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_add(R::wide_zero(), if best == 1 {
                            R::one()
                        } else {
                            R::zero()
                        }),
                        a0,
                        u0.y,
                    ),
                    a1,
                    u1.y,
                ),
            ),
            z: R::wide_rescale(
                R::wide_sub_prod(
