        } else {
            u0.a
        };
        let a1 = if best == 0 {
            u1.x
        } else if best == 1 {
            u1.y
        } else if best == 2 {
            u1.z
        } else if best == 3 {
            u1.w
        } else {
            u1.a
        };
        let r = Vector5 {
