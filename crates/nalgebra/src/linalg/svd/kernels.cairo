    /// A unit 6-vector orthogonal to the 5 orthonormal `u*`: the axis `e_i` whose squared
    /// projection `Σ u_l[i]²` onto their span is the SMALLEST (ties to the earlier axis; it is at
    /// most 5/6, so the residual has a squared norm of at least 1/6), stripped of that
    /// projection in one fused sum per component and normalised.
    #[inline(never)]
    fn complete5(
        u0: Vector6<T>, u1: Vector6<T>, u2: Vector6<T>, u3: Vector6<T>, u4: Vector6<T>,
    ) -> Vector6<T> {
        revoke_ap_tracking();
        let c0 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), u0.x, u0.x), u1.x, u1.x),
                        u2.x,
                        u2.x,
                    ),
                    u3.x,
                    u3.x,
                ),
                u4.x,
                u4.x,
            ),
        );
        let c1 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), u0.y, u0.y), u1.y, u1.y),
                        u2.y,
                        u2.y,
                    ),
                    u3.y,
                    u3.y,
                ),
                u4.y,
                u4.y,
            ),
        );
        let c2 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), u0.z, u0.z), u1.z, u1.z),
                        u2.z,
                        u2.z,
                    ),
                    u3.z,
                    u3.z,
                ),
                u4.z,
                u4.z,
            ),
        );
        let c3 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), u0.w, u0.w), u1.w, u1.w),
                        u2.w,
                        u2.w,
                    ),
                    u3.w,
                    u3.w,
                ),
                u4.w,
                u4.w,
            ),
        );
        let c4 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), u0.a, u0.a), u1.a, u1.a),
                        u2.a,
                        u2.a,
                    ),
                    u3.a,
                    u3.a,
                ),
                u4.a,
                u4.a,
            ),
        );
        let c5 = R::wide_rescale(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(R::wide_add_prod(R::wide_zero(), u0.b, u0.b), u1.b, u1.b),
                        u2.b,
                        u2.b,
                    ),
                    u3.b,
                    u3.b,
                ),
                u4.b,
                u4.b,
            ),
        );
        let mut best: usize = 0;
        let mut cb = c0;
        if c1 < cb {
            best = 1;
            cb = c1;
        }
        if c2 < cb {
            best = 2;
            cb = c2;
        }
        if c3 < cb {
            best = 3;
            cb = c3;
        }
        if c4 < cb {
            best = 4;
            cb = c4;
        }
        if c5 < cb {
            best = 5;
            cb = c5;
        }
        let _ = cb;
        let a0 = if best == 0 {
            u0.x
        } else if best == 1 {
            u0.y
        } else if best == 2 {
            u0.z
        } else if best == 3 {
            u0.w
        } else if best == 4 {
            u0.a
        } else {
            u0.b
        };
        let a1 = if best == 0 {
            u1.x
        } else if best == 1 {
            u1.y
        } else if best == 2 {
            u1.z
        } else if best == 3 {
            u1.w
        } else if best == 4 {
            u1.a
        } else {
            u1.b
        };
        let a2 = if best == 0 {
            u2.x
        } else if best == 1 {
            u2.y
        } else if best == 2 {
            u2.z
        } else if best == 3 {
            u2.w
        } else if best == 4 {
            u2.a
        } else {
            u2.b
        };
        let a3 = if best == 0 {
            u3.x
        } else if best == 1 {
            u3.y
        } else if best == 2 {
            u3.z
        } else if best == 3 {
            u3.w
        } else if best == 4 {
            u3.a
        } else {
            u3.b
        };
        let a4 = if best == 0 {
            u4.x
        } else if best == 1 {
            u4.y
        } else if best == 2 {
            u4.z
        } else if best == 3 {
            u4.w
        } else if best == 4 {
            u4.a
        } else {
            u4.b
        };
        let r = Vector6 {
            x: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(
                                    R::wide_add(
                                        R::wide_zero(),
                                        if best == 0 {
                                            R::one()
                                        } else {
                                            R::zero()
                                        },
                                    ),
                                    a0,
                                    u0.x,
                                ),
                                a1,
                                u1.x,
                            ),
                            a2,
                            u2.x,
                        ),
                        a3,
                        u3.x,
                    ),
                    a4,
                    u4.x,
                ),
            ),
            y: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(
                                    R::wide_add(
                                        R::wide_zero(),
                                        if best == 1 {
                                            R::one()
                                        } else {
                                            R::zero()
                                        },
                                    ),
                                    a0,
                                    u0.y,
                                ),
                                a1,
                                u1.y,
                            ),
                            a2,
                            u2.y,
                        ),
                        a3,
                        u3.y,
                    ),
                    a4,
                    u4.y,
                ),
            ),
            z: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(
                                    R::wide_add(
                                        R::wide_zero(),
                                        if best == 2 {
                                            R::one()
                                        } else {
                                            R::zero()
                                        },
                                    ),
                                    a0,
                                    u0.z,
                                ),
                                a1,
                                u1.z,
                            ),
                            a2,
                            u2.z,
                        ),
                        a3,
                        u3.z,
                    ),
                    a4,
                    u4.z,
                ),
            ),
            w: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(
                                    R::wide_add(
                                        R::wide_zero(),
                                        if best == 3 {
                                            R::one()
                                        } else {
                                            R::zero()
                                        },
                                    ),
                                    a0,
                                    u0.w,
                                ),
                                a1,
                                u1.w,
                            ),
                            a2,
                            u2.w,
                        ),
                        a3,
                        u3.w,
                    ),
                    a4,
                    u4.w,
                ),
            ),
            a: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(
                                    R::wide_add(
                                        R::wide_zero(),
                                        if best == 4 {
                                            R::one()
                                        } else {
                                            R::zero()
                                        },
                                    ),
                                    a0,
                                    u0.a,
                                ),
                                a1,
                                u1.a,
                            ),
                            a2,
                            u2.a,
                        ),
                        a3,
                        u3.a,
                    ),
                    a4,
                    u4.a,
                ),
            ),
            b: R::wide_rescale(
                R::wide_sub_prod(
                    R::wide_sub_prod(
                        R::wide_sub_prod(
                            R::wide_sub_prod(
                                R::wide_sub_prod(
                                    R::wide_add(
                                        R::wide_zero(),
                                        if best == 5 {
                                            R::one()
                                        } else {
                                            R::zero()
                                        },
                                    ),
                                    a0,
                                    u0.b,
                                ),
                                a1,
                                u1.b,
                            ),
                            a2,
                            u2.b,
                        ),
                        a3,
                        u3.b,
                    ),
                    a4,
                    u4.b,
                ),
            ),
        };
        {
            let (q0, q1, q2, q3, q4, q5) = R::div6(
                r.x,
                r.y,
                r.z,
                r.w,
                r.a,
                r.b,
                R::wide_sqrt(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(
                                        R::wide_add_prod(R::wide_zero(), r.x, r.x), r.y, r.y,
                                    ),
                                    r.z,
                                    r.z,
                                ),
                                r.w,
                                r.w,
                            ),
                            r.a,
                            r.a,
                        ),
                        r.b,
                        r.b,
                    ),
                ),
            );
            Vector6 { x: q0, y: q1, z: q2, w: q3, a: q4, b: q5 }
        }
    }
}
