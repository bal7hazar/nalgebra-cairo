        let s4 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), w4.x, w4.x), w4.y, w4.y,
                            ),
                            w4.z,
                            w4.z,
                        ),
                        w4.w,
                        w4.w,
                    ),
                    w4.a,
                    w4.a,
                ),
                w4.b,
                w4.b,
            ),
        );
        let s5 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), w5.x, w5.x), w5.y, w5.y,
                            ),
                            w5.z,
                            w5.z,
                        ),
                        w5.w,
                        w5.w,
                    ),
                    w5.a,
                    w5.a,
                ),
                w5.b,
                w5.b,
            ),
        );
        let (mut s0, mut w0, mut v0) = (s0, w0, v0);
        let (mut s1, mut w1, mut v1) = (s1, w1, v1);
        let (mut s2, mut w2, mut v2) = (s2, w2, v2);
        let (mut s3, mut w3, mut v3) = (s3, w3, v3);
        let (mut s4, mut w4, mut v4) = (s4, w4, v4);
        let (mut s5, mut w5, mut v5) = (s5, w5, v5);
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = w2;
            let tmp2 = v2;
            s2 = s3;
            w2 = w3;
            v2 = v3;
            s3 = tmp0;
            w3 = tmp1;
            v3 = tmp2;
        }
        if s5 > s4 {
            let tmp0 = s4;
            let tmp1 = w4;
            let tmp2 = v4;
            s4 = s5;
            w4 = w5;
            v4 = v5;
            s5 = tmp0;
            w5 = tmp1;
            v5 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = w1;
            let tmp2 = v1;
            s1 = s2;
            w1 = w2;
            v1 = v2;
            s2 = tmp0;
            w2 = tmp1;
            v2 = tmp2;
        }
        if s4 > s3 {
            let tmp0 = s3;
            let tmp1 = w3;
            let tmp2 = v3;
            s3 = s4;
            w3 = w4;
            v3 = v4;
            s4 = tmp0;
            w4 = tmp1;
            v4 = tmp2;
        }
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = w2;
            let tmp2 = v2;
            s2 = s3;
            w2 = w3;
            v2 = v3;
            s3 = tmp0;
            w3 = tmp1;
            v3 = tmp2;
        }
        if s5 > s4 {
            let tmp0 = s4;
            let tmp1 = w4;
            let tmp2 = v4;
            s4 = s5;
            w4 = w5;
            v4 = v5;
            s5 = tmp0;
            w5 = tmp1;
            v5 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = w1;
            let tmp2 = v1;
            s1 = s2;
            w1 = w2;
            v1 = v2;
            s2 = tmp0;
            w2 = tmp1;
            v2 = tmp2;
        }
        if s4 > s3 {
            let tmp0 = s3;
            let tmp1 = w3;
            let tmp2 = v3;
            s3 = s4;
            w3 = w4;
            v3 = v4;
            s4 = tmp0;
            w4 = tmp1;
            v4 = tmp2;
        }
        if s1 > s0 {
            let tmp0 = s0;
            let tmp1 = w0;
            let tmp2 = v0;
            s0 = s1;
            w0 = w1;
            v0 = v1;
            s1 = tmp0;
            w1 = tmp1;
            v1 = tmp2;
        }
        if s3 > s2 {
            let tmp0 = s2;
            let tmp1 = w2;
            let tmp2 = v2;
            s2 = s3;
            w2 = w3;
            v2 = v3;
            s3 = tmp0;
            w3 = tmp1;
            v3 = tmp2;
        }
        if s5 > s4 {
            let tmp0 = s4;
            let tmp1 = w4;
            let tmp2 = v4;
            s4 = s5;
            w4 = w5;
            v4 = v5;
            s5 = tmp0;
            w5 = tmp1;
            v5 = tmp2;
        }
        if s2 > s1 {
            let tmp0 = s1;
            let tmp1 = w1;
            let tmp2 = v1;
            s1 = s2;
            w1 = w2;
            v1 = v2;
            s2 = tmp0;
            w2 = tmp1;
            v2 = tmp2;
        }
        if s4 > s3 {
            let tmp0 = s3;
            let tmp1 = w3;
            let tmp2 = v3;
            s3 = s4;
            w3 = w4;
            v3 = v4;
            s4 = tmp0;
            w4 = tmp1;
            v4 = tmp2;
        }
        SortedSvd6 { s0, s1, s2, s3, s4, s5, w0, w1, w2, w3, w4, w5, v0, v1, v2, v3, v4, v5 }
    }

    /// The decomposition from the right singular vectors `v` (columns): `sorted`, then the left
    /// vectors by classical Gram-Schmidt run TWICE ("twice is enough", `SvdComplete6::gs*`):
    /// the second pass costs about as much as the first and keeps `U` orthonormal to the
    /// rounding of the residual even when `σ_k` is tiny (rank deficiency), where one pass leaves
    /// `u_k` as far from the others as `rounding / σ_k`. A column that vanishes EXACTLY (or `σ_1
    /// = 0`) is completed by the axis least represented in the span of the previous ones.
    fn from_right(m: Matrix6<T>, v: Matrix6<T>) -> Svd6<T> {
        let t = Self::sorted(m, v);
        let (s0, w0, v0) = (t.s0, t.w0, t.v0);
        let (s1, w1, v1) = (t.s1, t.w1, t.v1);
        let (s2, w2, v2) = (t.s2, t.w2, t.v2);
        let (s3, w3, v3) = (t.s3, t.w3, t.v3);
        let (s4, w4, v4) = (t.s4, t.w4, t.v4);
        let (s5, w5, v5) = (t.s5, t.w5, t.v5);
        let u0 = SvdComplete6Impl::<T>::first(w0, s0);
        let u1 = SvdComplete6Impl::<T>::gs1(u0, w1);
        let u2 = SvdComplete6Impl::<T>::gs2(u0, u1, w2);
        let u3 = SvdComplete6Impl::<T>::gs3(u0, u1, u2, w3);
        let u4 = SvdComplete6Impl::<T>::gs4(u0, u1, u2, u3, w4);
        let u5 = SvdComplete6Impl::<T>::gs5(u0, u1, u2, u3, u4, w5);
        Svd6 {
            u: Matrix6 {
                m11: u0.x,
                m21: u0.y,
                m31: u0.z,
                m41: u0.w,
                m51: u0.a,
                m61: u0.b,
                m12: u1.x,
                m22: u1.y,
                m32: u1.z,
                m42: u1.w,
                m52: u1.a,
                m62: u1.b,
                m13: u2.x,
                m23: u2.y,
                m33: u2.z,
                m43: u2.w,
                m53: u2.a,
                m63: u2.b,
                m14: u3.x,
                m24: u3.y,
                m34: u3.z,
                m44: u3.w,
                m54: u3.a,
                m64: u3.b,
                m15: u4.x,
                m25: u4.y,
                m35: u4.z,
                m45: u4.w,
                m55: u4.a,
                m65: u4.b,
                m16: u5.x,
                m26: u5.y,
                m36: u5.z,
                m46: u5.w,
                m56: u5.a,
                m66: u5.b,
            },
            singular_values: Vector6 { x: s0, y: s1, z: s2, w: s3, a: s4, b: s5 },
            v_t: Matrix6 {
                m11: v0.x,
                m21: v1.x,
                m31: v2.x,
                m41: v3.x,
                m51: v4.x,
                m61: v5.x,
                m12: v0.y,
                m22: v1.y,
                m32: v2.y,
                m42: v3.y,
                m52: v4.y,
                m62: v5.y,
                m13: v0.z,
                m23: v1.z,
                m33: v2.z,
                m43: v3.z,
                m53: v4.z,
                m63: v5.z,
                m14: v0.w,
                m24: v1.w,
                m34: v2.w,
                m44: v3.w,
                m54: v4.w,
                m64: v5.w,
                m15: v0.a,
                m25: v1.a,
                m35: v2.a,
                m45: v3.a,
                m55: v4.a,
                m65: v5.a,
                m16: v0.b,
                m26: v1.b,
                m36: v2.b,
                m46: v3.b,
                m56: v4.b,
                m66: v5.b,
            },
        }
    }

    /// The singular values alone: `sorted`, without the left vectors.
    fn values_from_right(m: Matrix6<T>, v: Matrix6<T>) -> Vector6<T> {
        let t = Self::sorted(m, v);
        Vector6 { x: t.s0, y: t.s1, z: t.s2, w: t.s3, a: t.s4, b: t.s5 }
    }
}

/// Upstream's `Matrix` methods that go through the SVD, on `Matrix6`. Import `Matrix6SvdTrait` to
/// use them.
#[generate_trait]
pub impl Matrix6SvdImpl<
    T,
    impl R: Real<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix6SvdTrait<T> {
    /// The singular value decomposition, see `Svd6Trait::new`. Upstream: `Matrix::svd(true, true)`.
    #[inline(always)]
    fn svd(self: Matrix6<T>) -> Svd6<T> {
        Svd6Trait::new(self)
    }

    /// `svd` (already sorted, see `Svd6Trait::new_unordered`). Upstream: `Matrix::svd_unordered`.
    #[inline(always)]
    fn svd_unordered(self: Matrix6<T>) -> Svd6<T> {
        Svd6Trait::new(self)
    }

    /// See `Svd6Trait::try_new`. Upstream: `Matrix::try_svd(true, true, eps, max_niter)`.
    #[inline(always)]
    fn try_svd(self: Matrix6<T>, eps: T, max_niter: usize) -> Option<Svd6<T>> {
        Svd6Trait::try_new(self, eps, max_niter)
    }

    /// See `Svd6Trait::try_new_unordered`. Upstream: `Matrix::try_svd_unordered`.
    #[inline(always)]
    fn try_svd_unordered(self: Matrix6<T>, eps: T, max_niter: usize) -> Option<Svd6<T>> {
        Svd6Trait::try_new(self, eps, max_niter)
    }

    /// The singular values alone, DESCENDING: the decomposition without the left vectors
    /// (cheaper than `svd().singular_values`, bit-identical to it). Upstream:
    /// `Matrix::singular_values`.
    fn singular_values(self: Matrix6<T>) -> Vector6<T> {
        Svd6InternalTrait::values_from_right(self, Svd6InternalTrait::right(self))
    }

    /// `singular_values` (sorted; see `Svd6Trait::new_unordered`). Upstream:
    /// `Matrix::singular_values_unordered`.
    #[inline(always)]
    fn singular_values_unordered(self: Matrix6<T>) -> Vector6<T> {
        Self::singular_values(self)
    }

    /// The number of singular values strictly greater than `eps`, from `singular_values`.
    /// Upstream: `Matrix::rank` (which asserts `eps >= 0`; a negative `eps` counts every value
    /// here).
    fn rank(self: Matrix6<T>, eps: T) -> usize {
        let s = Self::singular_values(self);
        let mut n: usize = 0;
        if s.x > eps {
            n += 1;
        }
        if s.y > eps {
            n += 1;
        }
        if s.z > eps {
            n += 1;
        }
        if s.w > eps {
            n += 1;
        }
        if s.a > eps {
            n += 1;
        }
        if s.b > eps {
            n += 1;
        }
        n
    }

    /// The Moore-Penrose pseudo-inverse, see `Svd6Trait::pseudo_inverse`. Upstream:
    /// `Matrix::pseudo_inverse` (`Err` on a negative `eps`; `None` here).
    #[inline(always)]
    fn pseudo_inverse(self: Matrix6<T>, eps: T) -> Option<Matrix6<T>> {
        Svd6Trait::new(self).pseudo_inverse(eps)
    }

    /// The left polar decomposition `M = P · U`, see `Svd6Trait::to_polar`. Upstream:
    /// `Matrix::polar`.
    fn polar(self: Matrix6<T>) -> (Matrix6<T>, Matrix6<T>) {
        Svd6Trait::new(self).to_polar().unwrap()
    }

    /// `polar`, or `None` when the decomposition did not converge within `eps`, see
    /// `Svd6Trait::try_new`. Upstream: `Matrix::try_polar`.
    fn try_polar(self: Matrix6<T>, eps: T, max_niter: usize) -> Option<(Matrix6<T>, Matrix6<T>)> {
        match Svd6Trait::try_new(self, eps, max_niter) {
            Some(d) => d.to_polar(),
            None => None,
        }
    }
}
