    /// The right singular vectors (the columns of `v`, ascending eigenvalue order of `MᵀM`).
    #[inline(always)]
    fn right(m: Matrix6<T>) -> Matrix6<T> {
        SvdRightImpl::<T>::right6(Self::gram(Self::normalised(m)))
    }

    /// `right`, or `None` when the eigen decomposition of `MᵀM` did not converge within `eps`.
    #[inline(always)]
    fn try_right(m: Matrix6<T>, eps: T) -> Option<Matrix6<T>> {
        SvdRightImpl::<T>::try_right6(Self::gram(Self::normalised(m)), eps)
    }

    /// `w_i = M v_i` (`MatrixMul::mul_mat`: one fused sum per component) and `σ_i = |w_i|`
    /// (floored norm of the exact
    /// sum of squares) for the right vectors `v` (columns), the triples sorted DESCENDING by `σ`
    /// (stable odd-even transposition network, strict comparison: ties keep their order). The
    /// singular values alone stop here.
    fn sorted(m: Matrix6<T>, v: Matrix6<T>) -> SortedSvd6<T> {
        revoke_ap_tracking();
        let v0 = Vector6 { x: v.m11, y: v.m21, z: v.m31, w: v.m41, a: v.m51, b: v.m61 };
        let v1 = Vector6 { x: v.m12, y: v.m22, z: v.m32, w: v.m42, a: v.m52, b: v.m62 };
        let v2 = Vector6 { x: v.m13, y: v.m23, z: v.m33, w: v.m43, a: v.m53, b: v.m63 };
        let v3 = Vector6 { x: v.m14, y: v.m24, z: v.m34, w: v.m44, a: v.m54, b: v.m64 };
        let v4 = Vector6 { x: v.m15, y: v.m25, z: v.m35, w: v.m45, a: v.m55, b: v.m65 };
        let v5 = Vector6 { x: v.m16, y: v.m26, z: v.m36, w: v.m46, a: v.m56, b: v.m66 };
        let mv = m.mul_mat(v);
        let w0 = Vector6 { x: mv.m11, y: mv.m21, z: mv.m31, w: mv.m41, a: mv.m51, b: mv.m61 };
        let w1 = Vector6 { x: mv.m12, y: mv.m22, z: mv.m32, w: mv.m42, a: mv.m52, b: mv.m62 };
        let w2 = Vector6 { x: mv.m13, y: mv.m23, z: mv.m33, w: mv.m43, a: mv.m53, b: mv.m63 };
        let w3 = Vector6 { x: mv.m14, y: mv.m24, z: mv.m34, w: mv.m44, a: mv.m54, b: mv.m64 };
        let w4 = Vector6 { x: mv.m15, y: mv.m25, z: mv.m35, w: mv.m45, a: mv.m55, b: mv.m65 };
        let w5 = Vector6 { x: mv.m16, y: mv.m26, z: mv.m36, w: mv.m46, a: mv.m56, b: mv.m66 };
        let s0 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), w0.x, w0.x), w0.y, w0.y,
                            ),
                            w0.z,
                            w0.z,
                        ),
                        w0.w,
                        w0.w,
                    ),
                    w0.a,
                    w0.a,
                ),
                w0.b,
                w0.b,
            ),
        );
        let s1 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), w1.x, w1.x), w1.y, w1.y,
                            ),
                            w1.z,
                            w1.z,
                        ),
                        w1.w,
                        w1.w,
                    ),
                    w1.a,
                    w1.a,
                ),
                w1.b,
                w1.b,
            ),
        );
        let s2 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), w2.x, w2.x), w2.y, w2.y,
                            ),
                            w2.z,
                            w2.z,
                        ),
                        w2.w,
                        w2.w,
                    ),
                    w2.a,
                    w2.a,
                ),
                w2.b,
                w2.b,
            ),
        );
        let s3 = R::wide_sqrt(
            R::wide_add_prod(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(R::wide_zero(), w3.x, w3.x), w3.y, w3.y,
                            ),
                            w3.z,
                            w3.z,
                        ),
                        w3.w,
                        w3.w,
                    ),
                    w3.a,
                    w3.a,
