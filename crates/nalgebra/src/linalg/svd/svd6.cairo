        let w0 = Vector6 {
            x: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), m.m11, v0.x), m.m12, v0.y,
                                ),
                                m.m13,
                                v0.z,
                            ),
                            m.m14,
                            v0.w,
                        ),
                        m.m15,
                        v0.a,
                    ),
                    m.m16,
                    v0.b,
                ),
            ),
            y: R::wide_rescale(
                R::wide_add_prod(
                    R::wide_add_prod(
                        R::wide_add_prod(
                            R::wide_add_prod(
                                R::wide_add_prod(
                                    R::wide_add_prod(R::wide_zero(), m.m21, v0.x), m.m22, v0.y,
                                ),
                                m.m23,
                                v0.z,
                            ),
                            m.m24,
                            v0.w,
                        ),
                        m.m25,
                        v0.a,
                    ),
                    m.m26,
                    v0.b,
                ),
            ),
            z: R::wide_rescale(
                R::wide_add_prod(
