            y: self.u.m22,
            z: self.u.m32,
            w: self.u.m42,
            a: self.u.m52,
            b: self.u.m62,
        };
        let mut uc2 = Vector6 {
            x: self.u.m13,
            y: self.u.m23,
            z: self.u.m33,
            w: self.u.m43,
            a: self.u.m53,
            b: self.u.m63,
        };
        let mut uc3 = Vector6 {
            x: self.u.m14,
            y: self.u.m24,
            z: self.u.m34,
            w: self.u.m44,
            a: self.u.m54,
            b: self.u.m64,
        };
        let mut uc4 = Vector6 {
            x: self.u.m15,
            y: self.u.m25,
            z: self.u.m35,
            w: self.u.m45,
            a: self.u.m55,
            b: self.u.m65,
        };
        let mut uc5 = Vector6 {
            x: self.u.m16,
            y: self.u.m26,
            z: self.u.m36,
            w: self.u.m46,
            a: self.u.m56,
            b: self.u.m66,
        };
        let mut vr0 = Vector6 {
            x: self.v_t.m11,
            y: self.v_t.m12,
            z: self.v_t.m13,
            w: self.v_t.m14,
            a: self.v_t.m15,
            b: self.v_t.m16,
