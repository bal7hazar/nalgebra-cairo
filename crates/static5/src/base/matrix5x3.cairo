    /// `self = self.scale(k)`, each component floored once. Panics on overflow. Upstream:
    /// `scale_mut`.
    #[inline(always)]
    fn scale_mut(ref self: Matrix5x3<T>, k: T) {
        self = Self::scale(self, k);
