    /// `DivRem` (no bounds check, like upstream). Upstream: `vector_to_matrix_index`.
    #[inline(always)]
    fn vector_to_matrix_index(self: Matrix5x3<T>, i: usize) -> (usize, usize) {
        let (j, i) = DivRem::div_rem(i, 5);
