    /// Replaces the first `min(diag.len(), 3)` diagonal components by the values of `diag` (the
    /// extra values are ignored, like upstream's `take`), the others unchanged. Upstream:
    /// `set_partial_diagonal` (an iterator; a `Span` here).
    #[inline(always)]
    fn set_partial_diagonal(ref self: Matrix5x3<T>, diag: Span<T>) {
        let len = diag.len();
        self =
            Matrix5x3 {
                m11: if len > 0 {
                    *diag[0]
                } else {
                    self.m11
                },
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m51: self.m51,
                m12: self.m12,
                m22: if len > 1 {
                    *diag[1]
                } else {
                    self.m22
                },
                m32: self.m32,
                m42: self.m42,
                m52: self.m52,
                m13: self.m13,
                m23: self.m23,
                m33: if len > 2 {
                    *diag[2]
                } else {
                    self.m33
                },
                m43: self.m43,
                m53: self.m53,
            };
    }

