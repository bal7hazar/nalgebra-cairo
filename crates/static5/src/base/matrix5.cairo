    }

    /// Alias of `component_div_assign` (deprecated upstream). Upstream: `component_div_mut`.
    #[inline(always)]
    fn component_div_mut(ref self: Matrix5<T>, rhs: Matrix5<T>) {
        Self::component_div_assign(ref self, rhs);
    }

    /// Conjugates every component in place: nothing changes for a real scalar. Upstream:
    /// `conjugate_mut`.
    #[inline(always)]
    fn conjugate_mut(ref self: Matrix5<T>) {
        self = Self::conjugate(self);
    }

    /// `self = self.transpose()`. Exact. Upstream: `transpose_mut`.
    #[inline(always)]
    fn transpose_mut(ref self: Matrix5<T>) {
        self = Self::transpose(self);
    }

    /// `self = self.adjoint()`: the transpose for a real scalar. Exact. Upstream: `adjoint_mut`.
    #[inline(always)]
    fn adjoint_mut(ref self: Matrix5<T>) {
        self = Self::transpose(self);
    }

    /// `adjoint_mut` (upstream's alias, kept for complex matrices). Exact. Upstream:
    /// `conjugate_transform_mut`.
    #[inline(always)]
    fn conjugate_transform_mut(ref self: Matrix5<T>) {
        self = Self::transpose(self);
    }

    /// Writes the transpose of `self` into `out`, a `Matrix5`. Exact. Upstream: `transpose_to`.
    #[inline(always)]
    fn transpose_to(self: Matrix5<T>, ref out: Matrix5<T>) {
        out = Self::transpose(self);
    }

    /// Writes the adjoint of `self` (its transpose for a real scalar) into `out`, a `Matrix5`.
    /// Exact. Upstream: `adjoint_to`.
    #[inline(always)]
    fn adjoint_to(self: Matrix5<T>, ref out: Matrix5<T>) {
        out = Self::transpose(self);
    }

    /// Writes the adjoint of `self` (deprecated upstream alias of `adjoint_to`) into `out`, a
    /// `Matrix5`. Exact. Upstream: `conjugate_transpose_to`.
    #[inline(always)]
    fn conjugate_transpose_to(self: Matrix5<T>, ref out: Matrix5<T>) {
        out = Self::transpose(self);
    }

    /// Writes the sum `self + rhs` into `out`. Exact; panics on overflow. Upstream: `add_to`.
    #[inline(always)]
    fn add_to(self: Matrix5<T>, rhs: Matrix5<T>, ref out: Matrix5<T>) {
        out = self + rhs;
    }

    /// Writes the difference `self - rhs` into `out`. Exact; panics on overflow. Upstream:
    /// `sub_to`.
    #[inline(always)]
    fn sub_to(self: Matrix5<T>, rhs: Matrix5<T>, ref out: Matrix5<T>) {
