                m13: self.m13,
                m23: self.m23,
                m33: diag.z,
                m43: self.m43,
                m53: self.m53,
                m14: self.m14,
                m24: self.m24,
                m34: self.m34,
                m44: diag.w,
                m54: self.m54,
                m15: self.m15,
                m25: self.m25,
                m35: self.m35,
                m45: self.m45,
                m55: diag.a,
