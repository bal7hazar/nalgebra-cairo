    /// Replaces the first `min(diag.len(), 5)` diagonal components by the values of `diag` (the
    /// extra values are ignored, like upstream's `take`), the others unchanged. Upstream:
    /// `set_partial_diagonal` (an iterator; a `Span` here).
    fn set_partial_diagonal(ref self: Matrix5<T>, diag: Span<T>) {
        let len = diag.len();
        self =
            Matrix5 {
                m11: if len > 0 {
                    *diag[0]
                } else {
                    self.m11
                },
                m21: self.m21,
                m31: self.m31,
                m41: self.m41,
                m51: self.m51,
                m12: self.m12,
                m22: if len > 1 {
                    *diag[1]
                } else {
                    self.m22
                },
                m32: self.m32,
                m42: self.m42,
                m52: self.m52,
                m13: self.m13,
                m23: self.m23,
                m33: if len > 2 {
                    *diag[2]
                } else {
                    self.m33
                },
                m43: self.m43,
                m53: self.m53,
                m14: self.m14,
                m24: self.m24,
                m34: self.m34,
                m44: if len > 3 {
                    *diag[3]
                } else {
                    self.m44
                },
                m54: self.m54,
                m15: self.m15,
                m25: self.m25,
                m35: self.m35,
                m45: self.m45,
                m55: if len > 4 {
                    *diag[4]
                } else {
                    self.m55
                },
            };
    }

    /// Sets `self` to `other` (a `Matrix5`: upstream requires the same shape). Upstream:
    /// `copy_from`.
    #[inline(always)]
    fn copy_from(ref self: Matrix5<T>, other: Matrix5<T>) {
        self = other;
    }

    /// Sets `self` to the 25 values of `slice` in column-major order (`from_column_slice`). Panics
    /// with `nalgebra: wrong slice length` unless `slice.len() == 25`. Upstream: `copy_from_slice`
    /// (`&[T]`).
    #[inline(always)]
    fn copy_from_slice(ref self: Matrix5<T>, slice: Span<T>) {
        self = Self::from_column_slice(slice);
    }

    /// Sets `self` to the transpose of `other`, a `Matrix5`. Exact. Upstream: `tr_copy_from`.
    fn tr_copy_from(ref self: Matrix5<T>, other: Matrix5<T>) {
        self =
            Matrix5 {
                m11: other.m11,
                m21: other.m12,
                m31: other.m13,
                m41: other.m14,
                m51: other.m15,
                m12: other.m21,
                m22: other.m22,
                m32: other.m23,
                m42: other.m24,
                m52: other.m25,
                m13: other.m31,
                m23: other.m32,
                m33: other.m33,
                m43: other.m34,
                m53: other.m35,
                m14: other.m41,
                m24: other.m42,
                m34: other.m43,
                m44: other.m44,
                m54: other.m45,
                m15: other.m51,
                m25: other.m52,
                m35: other.m53,
                m45: other.m54,
