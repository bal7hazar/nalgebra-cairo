    /// Sets every component to `f()` (one call per component, column-major). The closure's output
    /// converts `Into<T>`. Upstream: `fill_with` (`impl Fn() -> T`).
    #[cfg(feature: 'closures')]
    #[inline]
    fn fill_with<F, +Drop<F>, impl Func: core::ops::Fn<F, ()>, +Into<Func::Output, T>>(
        ref self: Matrix5<T>, f: F,
    ) {
        self =
            Matrix5 {
                m11: f().into(),
                m21: f().into(),
                m31: f().into(),
                m41: f().into(),
                m51: f().into(),
                m12: f().into(),
                m22: f().into(),
                m32: f().into(),
                m42: f().into(),
                m52: f().into(),
                m13: f().into(),
                m23: f().into(),
                m33: f().into(),
                m43: f().into(),
                m53: f().into(),
                m14: f().into(),
                m24: f().into(),
                m34: f().into(),
                m44: f().into(),
                m54: f().into(),
                m15: f().into(),
                m25: f().into(),
                m35: f().into(),
