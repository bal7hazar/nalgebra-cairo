            -9223372036854775808, -9223372036854775808, -9223372036854775808, -9223372036854775808,
            -9223372036854775808, -9223372036854775808, -9223372036854775808, -9223372036854775808,
        ]
            .span(),
    );
    let e = array![
        37399146632, -4107641929, -56639647119, -3285999110, 26486524072, -54718961954, -2850447471,
        24761018486, -30182483639, -13705882262, -48349674264, 63653615353, -56010209873,
        -62144775238, 62694479009, 35812794466, -4759033379, -58555274656, -14985931574,
        50411717930, -49769280725, 298565659, -10453347641, -20690133445, 9904003904, -25507460460,
        -58658568163, 34589380770, -58517352656, 59998218783, 1074878057, -1798875625, -36172946635,
        -51500783635, -57841126495, 52743448473,
    ]
        .span();
    let mut k: usize = 0;
    while k < 36 {
        let v = fx(*e[k]);
        assert!(a[k] == v);
        assert!(MatrixIndex::index(a, k) == v);
        assert!(a.get(k) == Option::Some(v));
        let (i, j) = (k % 6, k / 6);
        assert!(a[(i, j)] == v);
        assert!(MatrixIndex::index(a, (i, j)) == v);
        assert!(a.get((i, j)) == Option::Some(v));
        k += 1;
    }
    assert!(a.get(36).is_none());
    assert!(a.get((6, 0)).is_none());
    assert!(a.get((0, 6)).is_none());
    let w: Vector6<Fixed> = load(
        array![52471925880, 65981749209, 59058065559, -28814529527, 49018433755, -54545779127]
            .span(),
    );
    assert_raws(
        a.ad_mul(w),
        array![
            634242015532, -1337715669894, -327833930912, 48471821034, -2739336705391,
            -1496365144836,
        ]
            .span(),
    );
}

