#[test]
fn test_vector4_structure() {
    let a: Vector4<Fixed> = load(
        array![44870256225, -26097089192, 20769015188, 13521315912].span(),
    );
    assert_raws(a.adjoint(), array![44870256225, -26097089192, 20769015188, 13521315912].span());
    assert_raws(
        a.conjugate_transpose(), array![44870256225, -26097089192, 20769015188, 13521315912].span(),
    );
    assert_raws(a.conjugate(), array![44870256225, -26097089192, 20769015188, 13521315912].span());
    assert_raws(
        a.push(fx(-41259444771)),
        array![44870256225, -26097089192, 20769015188, 13521315912, -41259444771].span(),
    );
    assert_raws(
        a.to_homogeneous(), array![44870256225, -26097089192, 20769015188, 13521315912, 0].span(),
    );
    let hv: Vector5<Fixed> = load(
        array![44870256225, -26097089192, 20769015188, 13521315912, 0].span(),
    );
    let hp: Vector5<Fixed> = load(
        array![44870256225, -26097089192, 20769015188, 13521315912, 4294967296].span(),
    );
    assert_raws(
        Vector4Trait::from_homogeneous(hv).unwrap(),
        array![44870256225, -26097089192, 20769015188, 13521315912].span(),
    );
    assert!(Vector4Trait::from_homogeneous(hp).is_none());
    let near: Vector4<Fixed> = load(
        array![44870256222, -26097089192, 20769015188, 13521315914].span(),
    );
    let a2: Vector4<Fixed> = load(
        array![44870256225, -26097089192, 20769015188, 23941727283].span(),
    );
    let far: Vector4<Fixed> = load(
        array![44870256225, -26097089192, 20769015188, 23941728283].span(),
    );
    assert!(a.relative_eq(near, 3, fx(0)));
    assert!(!a.relative_eq(near, 2, fx(0)));
    assert!(!a2.relative_eq(far, 3, fx(0)));
    assert!(a2.relative_eq(far, 3, fx(4096)));
    assert!(a.ulps_eq(near, 3, 0));
    assert!(!a2.ulps_eq(far, 3, 999));
    assert!(a2.ulps_eq(far, 3, 1000));
    assert!(a == a);
    let lo: Vector4<Fixed> = load(
        array![44870256224, -26097089193, 20769015187, 13521315911].span(),
    );
    assert!(a != lo);
    assert!(lo < a);
    assert!(lo <= a);
    assert!(a > lo);
    assert!(a >= lo);
    assert!(a <= a);
    assert!(!(a < a));
    let mixed: Vector4<Fixed> = load(
        array![44870256224, -26097089193, 20769015187, 13521315913].span(),
    );
    assert!(!(mixed < a) && !(mixed >= a));
    assert!(!(mixed > a) && !(mixed <= a));
    let c: Vector4<Fixed> = a.cast();
    assert_raws(c, array![44870256225, -26097089192, 20769015188, 13521315912].span());
    let tc: Vector4<Fixed> = a.try_cast().unwrap();
    assert_raws(tc, array![44870256225, -26097089192, 20769015188, 13521315912].span());
    let m: Vector4<Fixed> = [[fx(44870256225), fx(-26097089192), fx(20769015188), fx(13521315912)]]
        .into();
    assert_raws(m, array![44870256225, -26097089192, 20769015188, 13521315912].span());
    let nested: [[Fixed; 4]; 1] = a.into();
    let back: Vector4<Fixed> = nested.into();
    assert_raws(back, array![44870256225, -26097089192, 20769015188, 13521315912].span());
    let mx: Vector4<i64> = Bounded::MAX;
    assert_raws(
        mx,
        array![9223372036854775807, 9223372036854775807, 9223372036854775807, 9223372036854775807]
            .span(),
    );
    let mn: Vector4<i64> = Bounded::MIN;
    assert_raws(
        mn,
        array![
            -9223372036854775808, -9223372036854775808, -9223372036854775808, -9223372036854775808,
        ]
            .span(),
    );
    let e = array![44870256225, -26097089192, 20769015188, 13521315912].span();
    let mut k: usize = 0;
    while k < 4 {
        let v = fx(*e[k]);
        assert!(a[k] == v);
        assert!(MatrixIndex::index(a, k) == v);
        assert!(a.get(k) == Option::Some(v));
        let (i, j) = (k % 4, k / 4);
        assert!(a[(i, j)] == v);
        assert!(MatrixIndex::index(a, (i, j)) == v);
        assert!(a.get((i, j)) == Option::Some(v));
        k += 1;
    }
    assert!(a.get(4).is_none());
    assert!(a.get((4, 0)).is_none());
    assert!(a.get((0, 1)).is_none());
    let w: Vector4<Fixed> = load(
        array![-25390712112, 25819063953, 11471321110, -24737654008].span(),
    );
    assert_raws(a.ad_mul(w), array![-444550012574].span());
    let u: UnitVector4<Fixed> = Unit { value: a };
    let uc: UnitVector4<Fixed> = u.cast();
    assert_raws(uc.value, array![44870256225, -26097089192, 20769015188, 13521315912].span());
    let un: UnitVector4<Fixed> = Unit { value: near };
    assert!(u.relative_eq(un, 3, fx(0)));
    assert!(!u.relative_eq(un, 2, fx(0)));
    assert!(u.ulps_eq(un, 3, 0));
}

