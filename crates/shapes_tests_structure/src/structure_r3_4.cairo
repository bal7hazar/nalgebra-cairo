        -60574961278, 44272748924, -11353482839, -36913099885,
    ]
        .span();
    let mut k: usize = 0;
    while k < 24 {
        let v = fx(*e[k]);
        assert!(a[k] == v);
        assert!(MatrixIndex::index(a, k) == v);
        assert!(a.get(k) == Option::Some(v));
        let (i, j) = (k % 4, k / 4);
        assert!(a[(i, j)] == v);
        assert!(MatrixIndex::index(a, (i, j)) == v);
        assert!(a.get((i, j)) == Option::Some(v));
        k += 1;
    }
    assert!(a.get(24).is_none());
    assert!(a.get((4, 0)).is_none());
    assert!(a.get((0, 6)).is_none());
    let w: Vector4<Fixed> = load(
        array![34267197660, 59317896203, -15958542930, 23333244038].span(),
