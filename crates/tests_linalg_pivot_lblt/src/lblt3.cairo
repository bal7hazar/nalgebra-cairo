/// Upstream's `zero_matrix` test: identity `l_permuted`, zero `d`, `zero_pivot == Some(0)`, pivots
/// `(k, 1)`, zero determinant, no solution.
#[test]
fn test_lblt3_zero_matrix() {
    let f = black_box(mat3x3([[0, 0, 0], [0, 0, 0], [0, 0, 0]])).lblt();
    assert!(f.l_permuted() == Matrix3Trait::identity());
    assert!(f.d() == Matrix3Trait::zeros());
    assert!(f.zero_pivot == Some(0));
    assert!(f.p1 == (0, 1) && f.p2 == (1, 1) && f.p3 == (2, 1));
    assert!(f.determinant() == fx(0));
    assert!(f.solve(vec3((0 * ONE, 1 * ONE, 2 * ONE))).is_none());
}

