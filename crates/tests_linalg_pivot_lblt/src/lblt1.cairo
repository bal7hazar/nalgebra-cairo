/// `lblt1` (oracle): `d()` and `l_permuted()` within the oracle tolerance (same pivots and
/// blocks as upstream), `A = (Pᵀ L) B (Pᵀ L)ᵀ` within the measured bound.
#[test]
fn test_oracle_lblt1() {
    let mut cases = oracle::lblt1_cases();
    let (mut ex, mut rec) = (0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, ed, el, tol) = *case;
        let a = black_box(mat1x1(a));
        let f = a.lblt();
        let (d, l) = (f.d(), f.l_permuted());
        let (ed, el) = (mat1x1(ed), mat1x1(el));
        ex = max(ex, excess(ulp_diff(d.x, ed.x), oracle_tol(abs_raw(ed.x), tol)));
        ex = max(ex, excess(ulp_diff(l.x, el.x), oracle_tol(abs_raw(el.x), tol)));
        assert!(f.zero_pivot.is_none());
        rec = max(rec, max_ulp_1x1(l.mul_mat(d).mul_mat(l.transpose()), a) / amax_1x1(a));
    }
    assert!(ex == 0, "oracle tolerance exceeded by {}", ex);
    assert!(rec <= 0, "measured {}", rec);
}

