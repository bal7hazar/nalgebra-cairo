/// `col_piv_qr2x6_rank` (oracle): on EXACTLY rank-deficient matrices of rank `k`, the first `k`
/// diagonal entries of `R` are the large ones and the others are rounding noise, `A P = Q R`.
#[test]
fn test_oracle_col_piv_qr2x6_rank() {
    let mut cases = oracle::col_piv_qr2x6_rank_cases();
    let (mut lo, mut hi, mut rec) = (0xffffffffffffffff_u128, 0_u128, 0);
    while let Some(case) = cases.pop_front() {
        let (a, k, _) = *case;
        let a = black_box(mat2x6(a));
        let f = a.col_piv_qr();
        let rr = f.r();
        let d = array![abs_raw(rr.m11), abs_raw(rr.m22)];
        let k: u32 = (k / ONE).try_into().unwrap();
        let mut i: u32 = 0;
        let mut ds = d.span();
        while let Some(x) = ds.pop_front() {
            if i < k {
                lo = min(lo, *x);
            } else {
                hi = max(hi, *x);
            }
            i += 1;
        }
        let mut ap = a;
        f.p.permute_columns(ref ap);
        rec = max(rec, max_ulp_2x6(f.q().mul_mat(rr), ap));
    }
    assert!(hi <= 2 && lo >= 19207677669 && rec <= 16, "measured {} {} {}", hi, lo, rec);
}

