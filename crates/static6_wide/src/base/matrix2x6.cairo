                m11: self.m11,
                m21: self.m21,
                m12: self.m12,
                m22: self.m22,
                m13: column.x,
                m23: column.y,
                m14: self.m14,
                m24: self.m24,
                m15: self.m15,
                m25: self.m25,
                m16: self.m16,
                m26: self.m26,
            },
            3 => Matrix2x6 {
                m11: self.m11,
                m21: self.m21,
                m12: self.m12,
                m22: self.m22,
                m13: self.m13,
                m23: self.m23,
                m14: column.x,
                m24: column.y,
                m15: self.m15,
                m25: self.m25,
                m16: self.m16,
                m26: self.m26,
            },
            4 => Matrix2x6 {
                m11: self.m11,
                m21: self.m21,
                m12: self.m12,
                m22: self.m22,
                m13: self.m13,
                m23: self.m23,
                m14: self.m14,
                m24: self.m24,
                m15: column.x,
                m25: column.y,
