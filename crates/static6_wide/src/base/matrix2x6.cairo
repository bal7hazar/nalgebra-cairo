            0 => Matrix2x6 {
                m11: column.x,
                m21: column.y,
                m12: self.m12,
                m22: self.m22,
                m13: self.m13,
                m23: self.m23,
                m14: self.m14,
                m24: self.m24,
                m15: self.m15,
                m25: self.m25,
