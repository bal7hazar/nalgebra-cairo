    fn amin(self: Matrix2x6<T>) -> T {
        R::min(
            R::min(
                R::min(
                    R::min(
                        R::min(
                            R::min(
                                R::min(
                                    R::min(
                                        R::min(
                                            R::min(
                                                R::min(R::abs(self.m11), R::abs(self.m21)),
                                                R::abs(self.m12),
                                            ),
                                            R::abs(self.m22),
                                        ),
                                        R::abs(self.m13),
                                    ),
                                    R::abs(self.m23),
                                ),
                                R::abs(self.m14),
                            ),
                            R::abs(self.m24),
