                m21: self.m21,
                m31: val,
                m12: self.m12,
                m22: self.m22,
                m32: val,
                m13: self.m13,
                m23: self.m23,
                m33: val,
                m14: self.m14,
                m24: self.m24,
                m34: val,
                m15: self.m15,
                m25: self.m25,
                m35: val,
                m16: self.m16,
                m26: self.m26,
                m36: val,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// `self` without its row `i`, a `RowVector6`. Panics with `nalgebra: index out of bounds` for
    /// `i >= 2`. Upstream: `remove_row`.
    #[inline(always)]
    fn remove_row(self: Matrix2x6<T>, i: usize) -> RowVector6<T> {
        match i {
            0 => RowVector6 {
                x: self.m21, y: self.m22, z: self.m23, w: self.m24, a: self.m25, b: self.m26,
            },
            1 => RowVector6 {
                x: self.m11, y: self.m12, z: self.m13, w: self.m14, a: self.m15, b: self.m16,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }

    /// `self` without its column `i`, a `Matrix2x5`. Panics with `nalgebra: index out of bounds`
    /// for `i >= 6`. Upstream: `remove_column`.
    #[inline(always)]
    fn remove_column(self: Matrix2x6<T>, i: usize) -> Matrix2x5<T> {
        match i {
            0 => Matrix2x5 {
                m11: self.m12,
                m21: self.m22,
                m12: self.m13,
                m22: self.m23,
                m13: self.m14,
                m23: self.m24,
                m14: self.m15,
                m24: self.m25,
                m15: self.m16,
                m25: self.m26,
            },
            1 => Matrix2x5 {
                m11: self.m11,
                m21: self.m21,
                m12: self.m13,
                m22: self.m23,
                m13: self.m14,
                m23: self.m24,
                m14: self.m15,
                m24: self.m25,
                m15: self.m16,
                m25: self.m26,
            },
            2 => Matrix2x5 {
                m11: self.m11,
                m21: self.m21,
                m12: self.m12,
                m22: self.m22,
                m13: self.m14,
                m23: self.m24,
                m14: self.m15,
                m24: self.m25,
                m15: self.m16,
                m25: self.m26,
            },
            3 => Matrix2x5 {
                m11: self.m11,
                m21: self.m21,
                m12: self.m12,
                m22: self.m22,
                m13: self.m13,
                m23: self.m23,
                m14: self.m15,
                m24: self.m25,
                m15: self.m16,
                m25: self.m26,
            },
            4 => Matrix2x5 {
                m11: self.m11,
                m21: self.m21,
                m12: self.m12,
                m22: self.m22,
                m13: self.m13,
                m23: self.m23,
                m14: self.m14,
                m24: self.m24,
                m15: self.m16,
                m25: self.m26,
            },
            5 => Matrix2x5 {
                m11: self.m11,
                m21: self.m21,
                m12: self.m12,
                m22: self.m22,
                m13: self.m13,
                m23: self.m23,
                m14: self.m14,
                m24: self.m24,
                m15: self.m15,
                m25: self.m25,
            },
            _ => core::panic_with_felt252(errors::INDEX_OUT_OF_BOUNDS),
        }
    }
}

/// The operations of `Matrix2x6<T>` that need `Transcendental` (inverse trigonometry, `exp`, `ln`):
/// a scalar may implement `Real` only.
#[generate_trait]
pub impl Matrix2x6AngleImpl<
    T,
    impl R: Real<T>,
    impl Tr: Transcendental<T>,
    +Copy<T>,
    +Drop<T>,
    +Drop<R::Wide>,
    +Add<T>,
    +Sub<T>,
    +Mul<T>,
    +Neg<T>,
    +PartialEq<T>,
    +PartialOrd<T>,
> of Matrix2x6AngleTrait<T> {
    /// The angle between `self` and `other` seen as vectors of the Frobenius inner product, in `[0,
    /// π]` (up to the rounding of `atan2`); `0` when one of them is zero. Computed as `2 *
    /// atan2(|u - v|, |u + v|)` on the normalized `u`, `v` (Kahan): unlike upstream's `acos(dot /
    /// (|a| *
    /// |b|))` it cannot overflow on long inputs and stays accurate for nearly parallel ones. Panics
    /// when a norm does not fit. Upstream: `angle`.
    fn angle(self: Matrix2x6<T>, other: Matrix2x6<T>) -> T {
        let n1 = Matrix2x6Trait::norm(self);
        let n2 = Matrix2x6Trait::norm(other);
        if n1 == R::zero() || n2 == R::zero() {
            return R::zero();
        }
        let u = Matrix2x6Trait::unscale(self, n1);
        let v = Matrix2x6Trait::unscale(other, n2);
        let half = Tr::atan2(Matrix2x6Trait::metric_distance(u, v), Matrix2x6Trait::norm(u + v));
        half + half
    }

    /// The entrywise Lp norm `(Σ |a|^p)^(1/p)`. `p = 1` is the exact sum of the absolute values
    /// and `p = 2` the fused `norm` (both exact up to their one rounding); above, the components
    /// are first divided by the largest absolute value `m` (so no power can overflow), `Σ (|a| /
    /// m)^p`
    /// is summed (`p` floored products each), and the root is `m * exp(ln(Σ) / p)`: a few ulp
    /// relative to the result, the rounding of `exp` / `ln`. Panics with `nalgebra: lp_norm needs p
    /// >= 1` for `p < 1` (upstream returns meaningless values: an infinite root for `p = 0`).
    /// Upstream: `lp_norm`.
    fn lp_norm(self: Matrix2x6<T>, p: i32) -> T {
        if p < 1 {
            core::panic_with_felt252(errors::LP_NORM_P);
        }
        if p == 1 {
            return R::abs(self.m11)
                + R::abs(self.m21)
                + R::abs(self.m12)
                + R::abs(self.m22)
                + R::abs(self.m13)
                + R::abs(self.m23)
                + R::abs(self.m14)
                + R::abs(self.m24)
                + R::abs(self.m15)
                + R::abs(self.m25)
                + R::abs(self.m16)
                + R::abs(self.m26);
        }
        if p == 2 {
            return Matrix2x6Trait::norm(self);
        }
        let m = Matrix2x6Trait::amax(self);
        if m == R::zero() {
            return R::zero();
        }
        let r = Matrix2x6Trait::unscale(Matrix2x6Trait::abs(self), m);
        let q: u32 = p.try_into().unwrap();
        let s = Powi::powi(r.m11, q)
            + Powi::powi(r.m21, q)
            + Powi::powi(r.m12, q)
            + Powi::powi(r.m22, q)
            + Powi::powi(r.m13, q)
            + Powi::powi(r.m23, q)
            + Powi::powi(r.m14, q)
            + Powi::powi(r.m24, q)
            + Powi::powi(r.m15, q)
            + Powi::powi(r.m25, q)
            + Powi::powi(r.m16, q)
            + Powi::powi(r.m26, q);
        m * Tr::exp(R::div(Tr::ln(s), R::from_int(p)))
    }
}
