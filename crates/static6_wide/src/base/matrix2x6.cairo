                m25: self.m15,
                m35: self.m25,
                m16: val,
                m26: self.m16,
                m36: self.m26,
            },
            1 => Matrix3x6 {
                m11: self.m11,
                m21: val,
                m31: self.m21,
                m12: self.m12,
                m22: val,
                m32: self.m22,
                m13: self.m13,
                m23: val,
                m33: self.m23,
                m14: self.m14,
                m24: val,
                m34: self.m24,
                m15: self.m15,
                m25: val,
                m35: self.m25,
                m16: self.m16,
