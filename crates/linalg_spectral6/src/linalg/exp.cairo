            m15: R::sum_prod3(c6, a6.m15, c4, a4.m15, c2, a2.m15),
            m25: R::sum_prod3(c6, a6.m25, c4, a4.m25, c2, a2.m25),
            m35: R::sum_prod3(c6, a6.m35, c4, a4.m35, c2, a2.m35),
            m45: R::sum_prod3(c6, a6.m45, c4, a4.m45, c2, a2.m45),
            m55: R::sum_prod3(c6, a6.m55, c4, a4.m55, c2, a2.m55) + c0,
            m65: R::sum_prod3(c6, a6.m65, c4, a4.m65, c2, a2.m65),
            m16: R::sum_prod3(c6, a6.m16, c4, a4.m16, c2, a2.m16),
            m26: R::sum_prod3(c6, a6.m26, c4, a4.m26, c2, a2.m26),
            m36: R::sum_prod3(c6, a6.m36, c4, a4.m36, c2, a2.m36),
            m46: R::sum_prod3(c6, a6.m46, c4, a4.m46, c2, a2.m46),
            m56: R::sum_prod3(c6, a6.m56, c4, a4.m56, c2, a2.m56),
            m66: R::sum_prod3(c6, a6.m66, c4, a4.m66, c2, a2.m66) + c0,
        };
        let u = a.mul_mat(w);
        (v + u, v - u)
    }

    /// `Q⁻¹ P`, upstream's `solve_p_q` (`q.lu().solve(&p).unwrap()`): the LU factorisation of
    /// `Q` with partial pivoting and the solve of the 6 columns of `P`. `Q` is the Padé
    /// denominator of a matrix within the threshold of its degree, well conditioned; panics with
    /// `nalgebra: singular Pade denom` (upstream's `unwrap` panic) if a pivot is exactly zero.
    fn solve_pq(p: Matrix6<T>, q: Matrix6<T>) -> Matrix6<T> {
        let mut x = p;
        assert!(Lu6Trait::new(q).solve_mut(ref x), "{}", SINGULAR_PADE);
        x
    }
}
