#[test]
fn test_matrix3x6_construction() {
    assert_raws(
        Matrix3x6Trait::repeat(fx(56134322277)),
        array![
            56134322277, 56134322277, 56134322277, 56134322277, 56134322277, 56134322277,
            56134322277, 56134322277, 56134322277, 56134322277, 56134322277, 56134322277,
            56134322277, 56134322277, 56134322277, 56134322277, 56134322277, 56134322277,
        ]
            .span(),
    );
    assert_raws(
        Matrix3x6Trait::from_element(fx(56134322277)),
        array![
            56134322277, 56134322277, 56134322277, 56134322277, 56134322277, 56134322277,
            56134322277, 56134322277, 56134322277, 56134322277, 56134322277, 56134322277,
            56134322277, 56134322277, 56134322277, 56134322277, 56134322277, 56134322277,
        ]
            .span(),
    );
    let g: Matrix3x6<Fixed> = Matrix3x6Trait::from_fn(
        |i: usize, j: usize| fx((i * 7 + j * 3 + 1).into()),
    );
    assert_raws(
        g, array![1, 8, 15, 4, 11, 18, 7, 14, 21, 10, 17, 24, 13, 20, 27, 16, 23, 30].span(),
    );
    assert_raws(
        Matrix3x6Trait::from_row_slice(
            array![
                fx(-13148622436), fx(50198257349), fx(14640242960), fx(-4737636819),
                fx(-2822853641), fx(-63619457235), fx(63120044999), fx(-7184507609),
                fx(-65689727319), fx(-61299851130), fx(28922800578), fx(19287193945),
                fx(-43733477106), fx(-32873036131), fx(50514718126), fx(-44991251206),
                fx(-54510608665), fx(-1648633591),
            ]
                .span(),
        ),
        array![
            -13148622436, 63120044999, -43733477106, 50198257349, -7184507609, -32873036131,
            14640242960, -65689727319, 50514718126, -4737636819, -61299851130, -44991251206,
            -2822853641, 28922800578, -54510608665, -63619457235, 19287193945, -1648633591,
        ]
