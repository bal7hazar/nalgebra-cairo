#[test]
fn test_matrix2x5_construction() {
    assert_raws(
        Matrix2x5Trait::repeat(fx(-44043885411)),
        array![
            -44043885411, -44043885411, -44043885411, -44043885411, -44043885411, -44043885411,
            -44043885411, -44043885411, -44043885411, -44043885411,
        ]
            .span(),
    );
    assert_raws(
        Matrix2x5Trait::from_element(fx(-44043885411)),
        array![
            -44043885411, -44043885411, -44043885411, -44043885411, -44043885411, -44043885411,
            -44043885411, -44043885411, -44043885411, -44043885411,
        ]
            .span(),
    );
    let g: Matrix2x5<Fixed> = Matrix2x5Trait::from_fn(
        |i: usize, j: usize| fx((i * 7 + j * 3 + 1).into()),
    );
    assert_raws(g, array![1, 8, 4, 11, 7, 14, 10, 17, 13, 20].span());
    assert_raws(
        Matrix2x5Trait::from_row_slice(
            array![
                fx(-59264657446), fx(-37954148666), fx(40578133295), fx(12857640613),
                fx(10056650844), fx(42299993218), fx(37770896947), fx(34727726547), fx(28340008223),
                fx(11255322264),
            ]
                .span(),
        ),
        array![
            -59264657446, 42299993218, -37954148666, 37770896947, 40578133295, 34727726547,
            12857640613, 28340008223, 10056650844, 11255322264,
        ]
            .span(),
    );
    assert_raws(
        Matrix2x5Trait::from_column_slice(
            array![
                fx(-59264657446), fx(42299993218), fx(-37954148666), fx(37770896947),
                fx(40578133295), fx(34727726547), fx(12857640613), fx(28340008223), fx(10056650844),
                fx(11255322264),
            ]
                .span(),
        ),
        array![
            -59264657446, 42299993218, -37954148666, 37770896947, 40578133295, 34727726547,
            12857640613, 28340008223, 10056650844, 11255322264,
        ]
            .span(),
    );
    assert_raws(
        Matrix2x5Trait::from_partial_diagonal(array![fx(8704712532), fx(28722806893)].span()),
        array![8704712532, 0, 0, 28722806893, 0, 0, 0, 0, 0, 0].span(),
    );
    assert_raws(
        Matrix2x5Trait::from_partial_diagonal(array![fx(8704712532)].span()),
        array![8704712532, 0, 0, 0, 0, 0, 0, 0, 0, 0].span(),
    );
    let z: Matrix2x5<Fixed> = Matrix2x5Trait::zeros();
    assert!(z.is_zero());
    let a: Matrix2x5<Fixed> = load(
        array![
            -59264657446, 42299993218, -37954148666, 37770896947, 40578133295, 34727726547,
            12857640613, 28340008223, 10056650844, 11255322264,
        ]
            .span(),
    );
    assert!(!a.is_zero());
}

