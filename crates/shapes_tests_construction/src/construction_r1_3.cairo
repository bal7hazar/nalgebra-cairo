    );
    assert_raws(
        Matrix3x6Trait::from_column_slice(
            array![
                fx(-13148622436), fx(63120044999), fx(-43733477106), fx(50198257349),
                fx(-7184507609), fx(-32873036131), fx(14640242960), fx(-65689727319),
                fx(50514718126), fx(-4737636819), fx(-61299851130), fx(-44991251206),
