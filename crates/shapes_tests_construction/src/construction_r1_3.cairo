#[test]
fn test_vector3_construction() {
    assert_raws(
        Vector3Trait::repeat(fx(31569276310)), array![31569276310, 31569276310, 31569276310].span(),
    );
    assert_raws(
        Vector3Trait::from_element(fx(31569276310)),
        array![31569276310, 31569276310, 31569276310].span(),
    );
    let g: Vector3<Fixed> = Vector3Trait::from_fn(
        |i: usize, j: usize| fx((i * 7 + j * 3 + 1).into()),
    );
    assert_raws(g, array![1, 8, 15].span());
    assert_raws(
        Vector3Trait::from_row_slice(
            array![fx(-66775837872), fx(-56125486477), fx(31784368661)].span(),
        ),
        array![-66775837872, -56125486477, 31784368661].span(),
    );
    assert_raws(
        Vector3Trait::from_column_slice(
            array![fx(-66775837872), fx(-56125486477), fx(31784368661)].span(),
        ),
        array![-66775837872, -56125486477, 31784368661].span(),
    );
    assert_raws(
        Vector3Trait::from_partial_diagonal(array![fx(58006668463)].span()),
        array![58006668463, 0, 0].span(),
    );
    assert_raws(
        Vector3Trait::from_partial_diagonal(ArrayTrait::<Fixed>::new().span()),
        array![0, 0, 0].span(),
    );
    let z: Vector3<Fixed> = Vector3Trait::zeros();
    assert!(z.is_zero());
    let a: Vector3<Fixed> = load(array![-66775837872, -56125486477, 31784368661].span());
    assert!(!a.is_zero());
    let ax: Vector3<Fixed> = Vector3Trait::x();
    assert_raws(ax, array![4294967296, 0, 0].span());
    let ax: Vector3<Fixed> = Vector3Trait::y();
    assert_raws(ax, array![0, 4294967296, 0].span());
    let ax: Vector3<Fixed> = Vector3Trait::z();
    assert_raws(ax, array![0, 0, 4294967296].span());
    assert_raws(Vector3Trait::ith(1, fx(31569276310)), array![0, 31569276310, 0].span());
    let axis: Unit<Vector3<Fixed>> = Vector3Trait::ith_axis(1);
    assert_raws(axis.value, array![0, 4294967296, 0].span());
}

