#[test]
fn test_vector6_construction() {
    assert_raws(
        Vector6Trait::repeat(fx(53768888552)),
        array![53768888552, 53768888552, 53768888552, 53768888552, 53768888552, 53768888552].span(),
    );
    assert_raws(
        Vector6Trait::from_element(fx(53768888552)),
        array![53768888552, 53768888552, 53768888552, 53768888552, 53768888552, 53768888552].span(),
    );
    let g: Vector6<Fixed> = Vector6Trait::from_fn(
        |i: usize, j: usize| fx((i * 7 + j * 3 + 1).into()),
    );
    assert_raws(g, array![1, 8, 15, 22, 29, 36].span());
    assert_raws(
        Vector6Trait::from_row_slice(
            array![
                fx(33129598941), fx(-10166926547), fx(-62510375527), fx(42776111422),
                fx(-59379605021), fx(-23719607271),
            ]
                .span(),
        ),
        array![33129598941, -10166926547, -62510375527, 42776111422, -59379605021, -23719607271]
            .span(),
    );
    assert_raws(
        Vector6Trait::from_column_slice(
            array![
                fx(33129598941), fx(-10166926547), fx(-62510375527), fx(42776111422),
                fx(-59379605021), fx(-23719607271),
            ]
                .span(),
        ),
        array![33129598941, -10166926547, -62510375527, 42776111422, -59379605021, -23719607271]
            .span(),
    );
    assert_raws(
        Vector6Trait::from_partial_diagonal(array![fx(9753459551)].span()),
        array![9753459551, 0, 0, 0, 0, 0].span(),
    );
    assert_raws(
        Vector6Trait::from_partial_diagonal(ArrayTrait::<Fixed>::new().span()),
        array![0, 0, 0, 0, 0, 0].span(),
    );
    let z: Vector6<Fixed> = Vector6Trait::zeros();
    assert!(z.is_zero());
    let a: Vector6<Fixed> = load(
        array![33129598941, -10166926547, -62510375527, 42776111422, -59379605021, -23719607271]
            .span(),
    );
    assert!(!a.is_zero());
    let ax: Vector6<Fixed> = Vector6Trait::x();
    assert_raws(ax, array![4294967296, 0, 0, 0, 0, 0].span());
    let ax: Vector6<Fixed> = Vector6Trait::y();
    assert_raws(ax, array![0, 4294967296, 0, 0, 0, 0].span());
    let ax: Vector6<Fixed> = Vector6Trait::z();
    assert_raws(ax, array![0, 0, 4294967296, 0, 0, 0].span());
    let ax: Vector6<Fixed> = Vector6Trait::w();
    assert_raws(ax, array![0, 0, 0, 4294967296, 0, 0].span());
    let ax: Vector6<Fixed> = Vector6Trait::a();
    assert_raws(ax, array![0, 0, 0, 0, 4294967296, 0].span());
    let ax: Vector6<Fixed> = Vector6Trait::b();
    assert_raws(ax, array![0, 0, 0, 0, 0, 4294967296].span());
    assert_raws(Vector6Trait::ith(5, fx(53768888552)), array![0, 0, 0, 0, 0, 53768888552].span());
    let axis: Unit<Vector6<Fixed>> = Vector6Trait::ith_axis(5);
    assert_raws(axis.value, array![0, 0, 0, 0, 0, 4294967296].span());
}

