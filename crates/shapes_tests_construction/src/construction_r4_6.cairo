#[test]
fn test_vector5_construction() {
    assert_raws(
        Vector5Trait::repeat(fx(-1333253297)),
        array![-1333253297, -1333253297, -1333253297, -1333253297, -1333253297].span(),
    );
    assert_raws(
        Vector5Trait::from_element(fx(-1333253297)),
        array![-1333253297, -1333253297, -1333253297, -1333253297, -1333253297].span(),
    );
    let g: Vector5<Fixed> = Vector5Trait::from_fn(
        |i: usize, j: usize| fx((i * 7 + j * 3 + 1).into()),
    );
    assert_raws(g, array![1, 8, 15, 22, 29].span());
    assert_raws(
        Vector5Trait::from_row_slice(
            array![
                fx(-31204258118), fx(-63800455407), fx(-67957153539), fx(51376100840),
                fx(57765256109),
            ]
                .span(),
        ),
        array![-31204258118, -63800455407, -67957153539, 51376100840, 57765256109].span(),
    );
    assert_raws(
        Vector5Trait::from_column_slice(
            array![
                fx(-31204258118), fx(-63800455407), fx(-67957153539), fx(51376100840),
                fx(57765256109),
            ]
                .span(),
        ),
        array![-31204258118, -63800455407, -67957153539, 51376100840, 57765256109].span(),
    );
    assert_raws(
        Vector5Trait::from_partial_diagonal(array![fx(-47841055660)].span()),
        array![-47841055660, 0, 0, 0, 0].span(),
    );
    assert_raws(
        Vector5Trait::from_partial_diagonal(ArrayTrait::<Fixed>::new().span()),
        array![0, 0, 0, 0, 0].span(),
    );
    let z: Vector5<Fixed> = Vector5Trait::zeros();
    assert!(z.is_zero());
    let a: Vector5<Fixed> = load(
        array![-31204258118, -63800455407, -67957153539, 51376100840, 57765256109].span(),
    );
    assert!(!a.is_zero());
    let ax: Vector5<Fixed> = Vector5Trait::x();
    assert_raws(ax, array![4294967296, 0, 0, 0, 0].span());
    let ax: Vector5<Fixed> = Vector5Trait::y();
    assert_raws(ax, array![0, 4294967296, 0, 0, 0].span());
    let ax: Vector5<Fixed> = Vector5Trait::z();
    assert_raws(ax, array![0, 0, 4294967296, 0, 0].span());
    let ax: Vector5<Fixed> = Vector5Trait::w();
    assert_raws(ax, array![0, 0, 0, 4294967296, 0].span());
    let ax: Vector5<Fixed> = Vector5Trait::a();
    assert_raws(ax, array![0, 0, 0, 0, 4294967296].span());
    assert_raws(Vector5Trait::ith(4, fx(-1333253297)), array![0, 0, 0, 0, -1333253297].span());
    let axis: Unit<Vector5<Fixed>> = Vector5Trait::ith_axis(4);
    assert_raws(axis.value, array![0, 0, 0, 0, 4294967296].span());
}

