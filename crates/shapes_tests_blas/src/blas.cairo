    let mut m = a;
    m.hegerc(alpha, x, x, beta);
    assert_raws(
        m,
        array![
            123521165060, 285062965678, -302685577444, -29719251080, 75320996887, 211538669325,
            23152175179, 673673998714, -652239173402, -97705171588, 181756121761, 713830942394,
