        array![33562096104, -16496238324, -27458065336, 1139669954, -21293881720, 23162253096]
            .span(),
    );
    let alpha = fx(14979017949);
    let beta = fx(8618940303);
    assert!(a.dotc(b) == fx(-51997958019));
    assert!(a.dotc(b) == a.dot(b));
    assert!(a.tr_dot(t) == fx(110314600812));
    let mut m = a;
    m.ger(alpha, x, y, beta);
    assert_raws(
        m,
        array![
