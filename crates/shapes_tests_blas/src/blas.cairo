            -4588824950, -32121422789, 24693022785, 29839495249, -26693373493, 21674127437,
        ]
            .span(),
    );
    let b: Matrix6<Fixed> = load(
        array![
            25425437094, -32814086600, -17363530235, -6396894777, -32845248901, -30272362338,
            -1038698670, 30854232291, -3340732446, -32094007359, 25212891604, 17512673980,
            16201045052, -16012670774, 20115799513, 29211265990, -8944929330, -33054591711,
            -11821790429, -23218919722, -7256311145, -8010941912, 26365074290, -17762595818,
            31325059072, 14952216790, -11426800892, -12203247973, -13465124049, 1343456130,
            23190874930, 16167617944, -7992462480, -11856644378, 34099371114, 20716084208,
        ]
            .span(),
    );
    let t: Matrix6<Fixed> = load(
        array![
            -18698351930, 16026848008, -30578147513, -19053808645, 21772536705, -17278823094,
            261096116, -22151785189, -22867834293, 3567253954, -7336810731, 23180943967,
            -9356901304, -7211953588, -16812021886, -28202437909, -26344608755, -10746818813,
