    b1: Fixed,
    a2: Fixed,
    b2: Fixed,
    a3: Fixed,
    b3: Fixed,
    a4: Fixed,
    b4: Fixed,
    a5: Fixed,
    b5: Fixed,
    beta: Fixed,
    c: Fixed,
) -> Fixed {
