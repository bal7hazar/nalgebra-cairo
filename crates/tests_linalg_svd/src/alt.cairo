    let (mut ex2, mut rec2, mut orth2) = (0, 0, 0);
    while let Some(case) = cases.pop_front() {
        let (a, e, tol) = *case;
        let (a, e) = (mat4x4(a), vec4(e));
        let (u, s, vt) = one_sided4(a);
        ex = max(ex, excess(ulp_diff(s.x, e.x), oracle_tol(abs_raw(e.x), tol)));
        ex = max(ex, excess(ulp_diff(s.y, e.y), oracle_tol(abs_raw(e.y), tol)));
        ex = max(ex, excess(ulp_diff(s.z, e.z), oracle_tol(abs_raw(e.z), tol)));
        ex = max(ex, excess(ulp_diff(s.w, e.w), oracle_tol(abs_raw(e.w), tol)));
        let us = Matrix4 {
            m11: u.m11 * s.x,
            m21: u.m21 * s.x,
            m31: u.m31 * s.x,
            m41: u.m41 * s.x,
            m12: u.m12 * s.y,
            m22: u.m22 * s.y,
            m32: u.m32 * s.y,
            m42: u.m42 * s.y,
            m13: u.m13 * s.z,
            m23: u.m23 * s.z,
            m33: u.m33 * s.z,
            m43: u.m43 * s.z,
            m14: u.m14 * s.w,
            m24: u.m24 * s.w,
            m34: u.m34 * s.w,
            m44: u.m44 * s.w,
        };
        rec = max(rec, max_ulp_4x4(us.mul_mat(vt), a) / amax_4x4(a));
        orth = max(orth, orth_4x4(u));
        let d = Svd4Trait::new(a);
        ex2 = max(ex2, excess(ulp_diff(d.singular_values.x, e.x), oracle_tol(abs_raw(e.x), tol)));
        ex2 = max(ex2, excess(ulp_diff(d.singular_values.y, e.y), oracle_tol(abs_raw(e.y), tol)));
        ex2 = max(ex2, excess(ulp_diff(d.singular_values.z, e.z), oracle_tol(abs_raw(e.z), tol)));
        ex2 = max(ex2, excess(ulp_diff(d.singular_values.w, e.w), oracle_tol(abs_raw(e.w), tol)));
        rec2 = max(rec2, max_ulp_4x4(d.recompose(), a) / amax_4x4(a));
        orth2 = max(orth2, orth_4x4(d.u));
    }
    assert!(
        (ex, rec, orth, ex2, rec2, orth2) == (0, 20, 627, 0, 4, 24),
        "measured {} {} {} / {} {} {}",
        ex,
        rec,
        orth,
        ex2,
        rec2,
        orth2,
    );
}

/// The one-sided candidate on the benchmark input of `bench_svd4_new__eigen_of_gram`.
#[test]
#[inline(never)]
fn bench_svd4_new__alt_one_sided_jacobi() {
    let (a, _, _) = *oracle::svd4_singular_values_cases().at(3);
    let a = black_box(mat4x4(a));
    let e = black_box(true);
    let (_, s, _) = one_sided4(a);
    assert!((s.x >= s.w) == e);
}
