/// `Matrix1` from a raw component tuple.
pub fn vec1(t: (i64,)) -> Matrix1<Fixed> {
    let (a0,) = t;
    Matrix1 { x: fx(a0) }
}

/// `Vector2` from a raw component tuple.
pub fn vec2(t: (i64, i64)) -> Vector2<Fixed> {
    let (a0, a1) = t;
    Vector2 { x: fx(a0), y: fx(a1) }
}

/// `Vector3` from a raw component tuple.
pub fn vec3(t: (i64, i64, i64)) -> Vector3<Fixed> {
    let (a0, a1, a2) = t;
    Vector3 { x: fx(a0), y: fx(a1), z: fx(a2) }
}

/// `Vector4` from a raw component tuple.
pub fn vec4(t: (i64, i64, i64, i64)) -> Vector4<Fixed> {
    let (a0, a1, a2, a3) = t;
    Vector4 { x: fx(a0), y: fx(a1), z: fx(a2), w: fx(a3) }
}

/// `Vector5` from a raw component tuple.
pub fn vec5(t: (i64, i64, i64, i64, i64)) -> Vector5<Fixed> {
    let (a0, a1, a2, a3, a4) = t;
    Vector5 { x: fx(a0), y: fx(a1), z: fx(a2), w: fx(a3), a: fx(a4) }
}

/// The raw value, widened.
fn w(a: Fixed) -> i128 {
    a.raw.into()
}

/// `|floor(p / 2^32) - target|` for an exact wide sum of raw products `p`.
fn dev(p: i128, target: i128) -> u128 {
    let q = if p >= 0 {
        p / 0x100000000
    } else {
        -((-p + 0xffffffff) / 0x100000000)
    };
    let d = q - target;
    let d = if d < 0 {
        -d
    } else {
        d
    };
    d.try_into().unwrap()
}
