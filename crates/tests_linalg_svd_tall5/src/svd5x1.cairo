#[test]
fn test_svd5x1_diagonal_and_zero_are_exact() {
    // A rectangular diagonal: the singular values are its entries, sorted, and every factor is
    // exact.
    let a = black_box(mat5x1([[12884901888], [0], [0], [0], [0]]));
    let d = a.svd();
    assert!(d.singular_values == Matrix1 { x: fx(3 * ONE) });
    assert!(d.recompose() == a);
    assert!(orth_5x1(d.u) == 0 && orth_1x1(d.v_t) == 0);
    // The zero matrix: nothing divides by zero, `U` is completed to an orthonormal basis.
    let z = black_box(mat5x1([[0], [0], [0], [0], [0]]));
    let d = z.svd();
    assert!(d.rank(fx(0)) == 0);
    assert!(d.recompose() == z);
    assert!(orth_5x1(d.u) == 0 && orth_1x1(d.v_t) == 0);
}

#[test]
fn test_svd5x1_api() {
    let (a, _, _) = *oracle::svd5x1_singular_values_cases().at(0);
    let a = black_box(mat5x1(a));
    let d = Svd5x1Trait::new(a);
    // The unordered and `try` forms, `sort_by_singular_values` on a sorted decomposition.
    assert!(Svd5x1Trait::new_unordered(a) == d);
    assert!(a.svd_unordered() == d);
    assert!(Svd5x1Trait::try_new(a, fx(ONE), 0).unwrap() == d);
    assert!(a.try_svd(fx(ONE), 100).unwrap() == d);
    assert!(a.try_svd_unordered(fx(ONE), 100).unwrap() == d);
    assert!(a.singular_values_unordered() == d.singular_values);
    let mut e = d;
    e.sort_by_singular_values();
    assert!(e == d);
    let (p, u) = a.polar();
    let (p2, u2) = a.try_polar(fx(ONE), 0).unwrap();
    assert!(p2 == p && u2 == u);
    let (p3, u3) = d.to_polar().unwrap();
    assert!(p3 == p && u3 == u);
    assert!(d.pseudo_inverse(fx(-1)).is_none());
    assert!(
        d
            .solve(Vector5 { x: fx(ONE), y: fx(ONE), z: fx(ONE), w: fx(ONE), a: fx(ONE) }, fx(-1))
            .is_none(),
    );
    assert!(
        d
            .solve(Vector5 { x: fx(ONE), y: fx(ONE), z: fx(ONE), w: fx(ONE), a: fx(ONE) }, fx(EPS))
            .is_some(),
    );
}
